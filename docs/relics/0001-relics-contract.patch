+--!strict
+-- Relic rows (RelicTypes, systems/Relics; docs/design/endgame-power.md section 2, a
+-- proposal). Every number is a PLACEHOLDER for Rhodri. Rows are checked by
+-- tests/systems/RelicRows.spec (stats, growth, a power budget at rank 10).
+local RelicTypes = require("../RelicTypes")
+
+-- One row per relic, `rows.<Name> = { ... }` keyed by its name, added above the return.
+local rows: { [string]: RelicTypes.RelicDef } = {}
+
+return table.freeze(rows)
diff --git a/tests/systems/RelicRows.spec.luau b/tests/systems/RelicRows.spec.luau
new file mode 100644
index 00000000..7cc9fb1c
--- /dev/null
+++ b/tests/systems/RelicRows.spec.luau
@@ -0,0 +1,172 @@
+--!strict
+-- data/Relics: each row is a well-formed relic whose effects are real stats that grow
+-- with rank, build-wide rather than one skill's (endgame-power.md 2.3: a relic seldom
+-- names a skill tag), inside a power budget at rank 10. The budget is a PLACEHOLDER for
+-- Rhodri's power table; it keeps a draft from shipping a relic worth a whole build.
+local RelicTypes = require("../../src/shared/RelicTypes")
+local Relics = require("../../src/shared/data/Relics")
+local TestApi = require("../TestApi")
+
+-- Stats a relic may touch: build-wide ones. Not costs, not added-damage ranges (an
+-- item's job), not skill levels or cooldown charges (a support's).
+local STATS: { [string]: boolean } = {}
+for _, s in
+	{
+		"CastSpeed",
+		"AttackSpeed",
+		"ProjectileSpeed",
+		"AreaOfEffect",
+		"CritChance",
+		"CritMultiplier",
+		"Damage",
+		"SpellDamage",
+		"AttackDamage",
+		"AreaDamage",
+		"ProjectileDamage",
+		"PhysicalDamage",
+		"FireDamage",
+		"ColdDamage",
+		"LightningDamage",
+		"ElementalDamage",
+		"CooldownRecovery",
+		"StunBuildup",
+		"StunDuration",
+		"MaxMana",
+		"ManaRegen",
+		"MaxLife",
+		"LifeRegen",
+		"LifeLeech",
+		"Armour",
+		"EvasionRating",
+		"FireResistance",
+		"ColdResistance",
+		"LightningResistance",
+		"Accuracy",
+		"MovementSpeed",
+		"DamageTaken",
+		"DebuffDuration",
+	}
+do
+	STATS[s] = true
+end
+
+local CONDITIONS: { [string]: boolean } = {
+	TargetHasStatus = true,
+	TargetHasAnyStatus = true,
+	SelfHasStatus = true,
+	SelfLifeBelow = true,
+	EnemiesWithin = true,
+	Moving = true,
+	Stationary = true,
+	StacksAtLeast = true,
+}
+local PLAYSTYLES = { close = true, ranged = true, spell = true, defence = true, mobility = true, sustain = true }
+
+-- The most one relic may give at rank 10, by modifier kind, summed over its effects that
+-- point the player's way. `flat` is by stat: ratings are big numbers, the rest small.
+local BUDGET = { increased = 0.6, more = 0.25 }
+local FLAT: { [string]: number } =
+	{ Armour = 300, EvasionRating = 300, Accuracy = 300, MaxLife = 120, MaxMana = 80, LifeRegen = 12, ManaRegen = 8 }
+local FLAT_DEFAULT = 0.3 -- fractions: crit chance, resistances, leech
+
+local function valueAt(e: RelicTypes.RelicEffect, rank: number, awakened: boolean): number
+	return e.base + e.perRank * (rank - (if awakened then RelicTypes.AWAKEN_RANK else 1))
+end
+
+return function(api: TestApi.Api)
+	local describe, it, expect = api.describe, api.it, api.expect
+
+	describe("data/Relics", function()
+		it("keys each row by its name and fills every field", function()
+			for key, row in Relics do
+				expect({ key, row.name }).toEqual({ key, key })
+				expect({ key, "title", #row.title > 0 }).toEqual({ key, "title", true })
+				expect({ key, "about", #row.about > 0 }).toEqual({ key, "about", true })
+				expect({ key, "playstyle", PLAYSTYLES[row.playstyle] == true }).toEqual({ key, "playstyle", true })
+				expect({ key, "effects 1-3", #row.effects >= 1 and #row.effects <= 3 }).toEqual({
+					key,
+					"effects 1-3",
+					true,
+				})
+				expect({ key, "awakened 1-2", #row.awakened >= 1 and #row.awakened <= 2 }).toEqual({
+					key,
+					"awakened 1-2",
+					true,
+				})
+			end
+		end)
+
+		it("uses build-wide stats and known conditions, at most one effect scoped by tags", function()
+			for key, row in Relics do
+				local tagged = 0
+				for _, list in { row.effects, row.awakened } do
+					for _, e in list do
+						expect({ key, e.stat, STATS[e.stat] == true }).toEqual({ key, e.stat, true })
+						expect({ key, e.stat, e.kind == "flat" or e.kind == "increased" or e.kind == "more" }).toEqual({
+							key,
+							e.stat,
+							true,
+						})
+						for _, cond in e.conditions or {} do
+							expect({ key, cond.kind, CONDITIONS[cond.kind] == true }).toEqual({ key, cond.kind, true })
+						end
+						if e.tags and #e.tags > 0 then
+							tagged += 1
+						end
+					end
+				end
+				expect({ key, "tagged effects", tagged <= 1 }).toEqual({ key, "tagged effects", true })
+			end
+		end)
+
+		it("grows every effect with rank, the same way it starts", function()
+			for key, row in Relics do
+				for _, list in { row.effects, row.awakened } do
+					for _, e in list do
+						expect({ key, e.stat, "grows", e.perRank ~= 0 }).toEqual({ key, e.stat, "grows", true })
+						expect({ key, e.stat, "same sign", e.base * e.perRank >= 0 }).toEqual({
+							key,
+							e.stat,
+							"same sign",
+							true,
+						})
+					end
+				end
+			end
+		end)
+
+		it("stays inside the power budget at rank 10", function()
+			for key, row in Relics do
+				local sums = { increased = 0, more = 0 }
+				for _, pair in { { row.effects, false }, { row.awakened, true } } do
+					for _, e in pair[1] :: { RelicTypes.RelicEffect } do
+						local v = valueAt(e, 10, pair[2] :: boolean)
+						-- DamageTaken and DebuffDuration help when negative.
+						local good = if e.stat == "DamageTaken" or e.stat == "DebuffDuration" then -v else v
+						if e.kind == "flat" then
+							local cap = FLAT[e.stat] or FLAT_DEFAULT
+							expect({ key, e.stat, "flat at rank 10", good, good <= cap }).toEqual({
+								key,
+								e.stat,
+								"flat at rank 10",
+								good,
+								true,
+							})
+						elseif good > 0 then
+							sums[e.kind] += good
+						end
+					end
+				end
+				for kind, cap in BUDGET do
+					expect({ key, kind, "at rank 10", sums[kind], sums[kind] <= cap + 1e-9 }).toEqual({
+						key,
+						kind,
+						"at rank 10",
+						sums[kind],
+						true,
+					})
+				end
+			end
+		end)
+	end)
+end
diff --git a/tests/systems/Relics.spec.luau b/tests/systems/Relics.spec.luau
new file mode 100644
index 00000000..75312c2a
--- /dev/null
+++ b/tests/systems/Relics.spec.luau
@@ -0,0 +1,147 @@
+--!strict
+-- systems/Relics against its contract (RelicTypes): grades, copies and ranks, dust,
+-- slots, a relic's modifiers by rank, and the synergy over the four slotted.
+local RelicTypes = require("../../src/shared/RelicTypes")
+local Relics = require("../../src/shared/systems/Relics")
+local TestApi = require("../TestApi")
+
+-- An rng that returns the given numbers in turn.
+local function rngOf(...: number): Random
+	local values = { ... }
+	local i = 0
+	return {
+		NextNumber = function(_self: any, lo: number?, hi: number?): number
+			i += 1
+			local v = values[(i - 1) % #values + 1]
+			return if lo and hi then lo + (hi - lo) * v else v
+		end,
+	} :: any
+end
+
+local SIGIL: RelicTypes.RelicDef = {
+	name = "TestSigil",
+	title = "Test Sigil",
+	about = "A relic for the spec.",
+	playstyle = "defence",
+	effects = {
+		{ stat = "Armour", kind = "increased", base = 0.1, perRank = 0.02 },
+		{
+			stat = "DamageTaken",
+			kind = "more",
+			base = -0.04,
+			perRank = -0.005,
+			conditions = { { kind = "Stationary" } },
+		},
+	},
+	awakened = { { stat = "LifeRegen", kind = "flat", base = 2, perRank = 1 } },
+}
+
+return function(api: TestApi.Api)
+	local describe, it, expect = api.describe, api.it, api.expect
+
+	describe("Relics.rollGrade", function()
+		it("walks the grades lowest first by weight", function()
+			local w = { Lesser = 80, Greater = 18, Exalted = 2 }
+			expect(Relics.rollGrade(w, rngOf(0))).toBe("Lesser")
+			expect(Relics.rollGrade(w, rngOf(0.5))).toBe("Lesser")
+			expect(Relics.rollGrade(w, rngOf(0.9))).toBe("Greater")
+			expect(Relics.rollGrade(w, rngOf(0.99))).toBe("Exalted")
+		end)
+	end)
+
+	describe("Relics.addCopy", function()
+		it("adds a new relic at rank 1 with its grade", function()
+			local c = Relics.newCollection()
+			local r = Relics.addCopy(c, "TestSigil", "Greater")
+			expect(r.kind).toBe("new")
+			expect(c.relics.TestSigil).toEqual({ grade = "Greater", rank = 1, spare = 0 })
+		end)
+
+		it("ranks up after COPIES[rank + 1] copies", function()
+			local c = Relics.newCollection()
+			Relics.addCopy(c, "TestSigil", "Lesser")
+			expect(Relics.addCopy(c, "TestSigil", "Lesser").kind).toBe("rank") -- COPIES[2] = 1
+			expect(c.relics.TestSigil.rank).toBe(2)
+			expect(Relics.addCopy(c, "TestSigil", "Lesser").kind).toBe("progress") -- 1 of COPIES[3] = 2
+			expect(Relics.addCopy(c, "TestSigil", "Lesser").kind).toBe("rank")
+			expect(c.relics.TestSigil).toEqual({ grade = "Lesser", rank = 3, spare = 0 })
+		end)
+
+		it("turns a copy past the grade's cap into dust", function()
+			local c = Relics.newCollection()
+			c.relics.TestSigil = { grade = "Lesser", rank = 5, spare = 0 }
+			local r = Relics.addCopy(c, "TestSigil", "Lesser")
+			expect(r.kind).toBe("dust")
+			expect(r.dust).toBe(RelicTypes.DUST_PER_SPARE)
+			expect(c.dust).toBe(RelicTypes.DUST_PER_SPARE)
+			expect(c.relics.TestSigil.rank).toBe(5)
+		end)
+
+		it("upgrades the grade on a higher copy and keeps the rank", function()
+			local c = Relics.newCollection()
+			c.relics.TestSigil = { grade = "Lesser", rank = 3, spare = 1 }
+			local r = Relics.addCopy(c, "TestSigil", "Exalted")
+			expect(r.upgraded).toBe(true)
+			expect(c.relics.TestSigil.grade).toBe("Exalted")
+			expect(c.relics.TestSigil.rank >= 3).toBe(true)
+		end)
+	end)
+
+	describe("Relics.modifiers", function()
+		it("scales each effect with rank and sources it by title", function()
+			local mods = Relics.modifiers(SIGIL, 3)
+			expect(#mods).toBe(2)
+			expect(mods[1].stat).toBe("Armour")
+			expect(math.abs(mods[1].value - 0.14) < 1e-9).toBe(true)
+			expect(mods[1].source).toBe("Relic: Test Sigil")
+			expect(mods[2].conditions).toEqual({ { kind = "Stationary" } })
+		end)
+
+		it("adds the awakened effects from AWAKEN_RANK", function()
+			expect(#Relics.modifiers(SIGIL, RelicTypes.AWAKEN_RANK - 1)).toBe(2)
+			local mods = Relics.modifiers(SIGIL, RelicTypes.AWAKEN_RANK)
+			expect(#mods).toBe(3)
+			expect(mods[3].value).toBe(2)
+		end)
+	end)
+
+	describe("Relics.slot", function()
+		it("slots owned relics into free slots, once each", function()
+			local c = Relics.newCollection()
+			Relics.addCopy(c, "TestSigil", "Lesser")
+			local slots: RelicTypes.Slots = {}
+			expect((Relics.slot(slots, 1, "TestSigil", c))).toBe(true)
+			expect((Relics.slot(slots, 2, "TestSigil", c))).toBe(false)
+			expect((Relics.slot(slots, 2, "Unowned", c))).toBe(false)
+			expect((Relics.slot(slots, RelicTypes.SLOTS + 1, "TestSigil", c))).toBe(false)
+			expect(slots).toEqual({ [1] = "TestSigil" })
+		end)
+	end)
+
+	describe("Relics.synergy", function()
+		it("gives a step per SYNERGY_RANKS ranks, and bends past SYNERGY_BEND", function()
+			expect(Relics.synergy(0)).toBe(0)
+			expect(math.abs(Relics.synergy(8) - 0.02) < 1e-9).toBe(true)
+			expect(math.abs(Relics.synergy(20) - 0.05) < 1e-9).toBe(true)
+			expect(Relics.synergy(28) < 0.07).toBe(true)
+		end)
+	end)
+
+	describe("Relics.loadout", function()
+		it("gathers the slotted relics' modifiers and the synergy", function()
+			local c = Relics.newCollection()
+			c.relics.TestSigil = { grade = "Exalted", rank = 8, spare = 0 }
+			local mods = Relics.loadout({ [1] = "TestSigil" }, c, { TestSigil = SIGIL })
+			local synergy = 0
+			for _, m in mods do
+				if m.source == RelicTypes.SYNERGY_SOURCE then
+					synergy += 1
+					expect(m.kind).toBe("increased")
+					expect(math.abs(m.value - 0.02) < 1e-9).toBe(true)
+				end
+			end
+			expect(synergy).toBe(2) -- Damage and MaxLife
+			expect(#mods).toBe(5)
+		end)
+	end)
+end
