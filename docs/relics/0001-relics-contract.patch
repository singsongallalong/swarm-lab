diff --git a/src/shared/RelicTypes.luau b/src/shared/RelicTypes.luau
new file mode 100644
index 00000000..93eeff98
--- /dev/null
+++ b/src/shared/RelicTypes.luau
@@ -0,0 +1,119 @@
+--!strict
+-- Relics (docs/design/endgame-power.md section 2, a proposal on claude/endgame-power-layer):
+-- the contract for the pure core, systems/Relics. Every number is the proposal's
+-- PLACEHOLDER for Rhodri. A trial (swarm-lab's relics job), not on main.
+--
+-- A relic joins an account's collection; it never sits in a bag. It has a grade, rolled
+-- when it drops, which caps its rank; copies of the same relic raise its rank; a copy past
+-- the cap turns to dust; dust buys a copy of a relic already owned. A character slots up
+-- to four, and their ranks summed give a small bonus that bends (synergy). A relic's
+-- power is ordinary stat modifiers (rule 3) that grow with rank, the "awakened" ones only
+-- from AWAKEN_RANK.
+local SkillTypes = require("./SkillTypes")
+
+export type Grade = "Lesser" | "Greater" | "Exalted"
+export type Playstyle = "close" | "ranged" | "spell" | "defence" | "mobility" | "sustain"
+
+-- One effect: its value at rank r is `base + perRank * (r - 1)`. An awakened effect
+-- counts from AWAKEN_RANK instead: `base + perRank * (r - AWAKEN_RANK)`, and is absent
+-- below it. Tags and conditions pass straight to the modifier (SkillTypes.Modifier).
+export type RelicEffect = {
+	stat: SkillTypes.StatId,
+	kind: SkillTypes.ModifierKind,
+	base: number,
+	perRank: number,
+	tags: { SkillTypes.Tag }?,
+	conditions: { SkillTypes.Condition }?,
+}
+
+export type RelicDef = {
+	name: string, -- its key in data/Relics, PascalCase
+	title: string, -- how it reads in the panel ("Warden's Sigil")
+	about: string, -- one sentence
+	playstyle: Playstyle,
+	effects: { RelicEffect }, -- from rank 1
+	awakened: { RelicEffect }, -- from AWAKEN_RANK
+}
+
+-- What the account holds of one relic.
+export type Owned = {
+	grade: Grade,
+	rank: number, -- 1..MAX_RANK[grade]
+	spare: number, -- copies fed toward the next rank, under COPIES[rank + 1]
+}
+
+export type Collection = {
+	relics: { [string]: Owned },
+	dust: number,
+}
+
+-- What adding a copy did. `kind`: "new" (first of it), "progress" (a copy toward the next
+-- rank), "rank" (it ranked up), "dust" (it was at its cap: the copy became dust).
+-- `upgraded`: the copy's grade was higher and replaced the held one's (keeping its rank).
+export type AddResult = {
+	kind: "new" | "progress" | "rank" | "dust",
+	upgraded: boolean,
+	rank: number, -- the relic's rank after
+	dust: number, -- dust gained by this copy
+}
+
+-- A character's slots: slot index (1..SLOTS) to relic name.
+export type Slots = { [number]: string }
+
+-- systems/Relics, pure (no Roblox API, randomness only from the rng it is given), must
+-- export exactly these; tests/systems/Relics.spec checks them:
+--
+--   Relics.rollGrade(weights: { [Grade]: number }, rng: Random): Grade
+--     One rng:NextNumber() in [0, 1) times the total weight, walked through GRADES lowest
+--     first; a grade with no weight (missing or 0) is never rolled.
+--   Relics.newCollection(): Collection                    -- empty, 0 dust
+--   Relics.addCopy(c: Collection, name: string, grade: Grade): AddResult
+--     Changes `c` in place. Not owned: it joins at rank 1, spare 0, with `grade` ("new").
+--     Owned: first, a copy of a higher grade replaces the held grade (`upgraded`), keeping
+--     rank and spare. Then, if the relic is at MAX_RANK of its (possibly new) grade, the
+--     copy becomes DUST_PER_SPARE dust ("dust"). Otherwise it adds one spare, and when
+--     spare reaches COPIES[rank + 1] the relic ranks up and spare goes back to 0 ("rank");
+--     else "progress". A copy never raises more than one rank.
+--   Relics.copiesToMax(o: Owned): number
+--     Copies still needed to reach MAX_RANK of its grade (0 at the cap).
+--   Relics.buyCopy(c: Collection, name: string): (boolean, AddResult?)
+--     Spends DUST_COST dust on a Lesser copy of an owned relic. Refused (false, nil, and
+--     nothing changes) when it isn't owned, is at its cap, or the dust isn't enough.
+--   Relics.modifiers(def: RelicDef, rank: number): { SkillTypes.Modifier }
+--     Rank under 1 gives none; rank is capped at 10. `effects` in order, then `awakened`
+--     in order from AWAKEN_RANK; values by the formulas above; source "Relic: <title>";
+--     tags and conditions copied (nil stays nil). New tables: the def is never changed.
+--   Relics.slot(slots: Slots, index: number, name: string, c: Collection): (boolean, string?)
+--     Puts `name` in slot `index` (1..SLOTS, a whole number), replacing what was there.
+--     Refused with a reason when the index is out of range, the relic isn't owned, or it
+--     sits in another slot already (slotting it into the slot it is in is fine).
+--   Relics.unslot(slots: Slots, index: number)
+--   Relics.synergy(totalRanks: number): number
+--     SYNERGY_STEP per whole SYNERGY_RANKS ranks up to SYNERGY_BEND, then half of
+--     SYNERGY_STEP per whole SYNERGY_RANKS past it: synergy(20) = 0.05, synergy(24) = 0.055.
+--   Relics.loadout(slots: Slots, c: Collection, defs: { [string]: RelicDef }): { SkillTypes.Modifier }
+--     Each slotted relic that is owned and has a def, in slot order (1 to SLOTS), at its
+--     rank; then, if the synergy over those relics' ranks is above 0, an `increased`
+--     Damage and an `increased` MaxLife modifier of that value, source SYNERGY_SOURCE.
+
+local RelicTypes = {}
+
+-- Lowest to highest.
+local GRADES: { Grade } = { "Lesser", "Greater", "Exalted" }
+RelicTypes.GRADES = table.freeze(GRADES)
+RelicTypes.MAX_RANK = table.freeze({ Lesser = 5, Greater = 8, Exalted = 10 })
+-- COPIES[1] is the find itself; COPIES[r] (r >= 2) is how many copies take a relic from
+-- rank r - 1 to rank r. 42 in all from nothing to rank 10.
+RelicTypes.COPIES = table.freeze({ 1, 1, 2, 2, 3, 4, 5, 6, 8, 10 })
+RelicTypes.AWAKEN_RANK = 5
+RelicTypes.SLOTS = 4
+RelicTypes.DUST_PER_SPARE = 1
+RelicTypes.DUST_COST = 10 -- dust for one copy of an owned relic, bought at Lesser grade
+-- Synergy: +SYNERGY_STEP per SYNERGY_RANKS slotted ranks up to SYNERGY_BEND ranks, then
+-- half that per SYNERGY_RANKS past it. As `increased` Damage and MaxLife.
+RelicTypes.SYNERGY_STEP = 0.01
+RelicTypes.SYNERGY_RANKS = 4
+RelicTypes.SYNERGY_BEND = 20
+RelicTypes.SYNERGY_SOURCE = "Relics: synergy"
+
+return table.freeze(RelicTypes)
