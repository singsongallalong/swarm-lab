+	words = "blue-grey snow over dark frozen earth, black pines rimed pale, grey granite, a pale ice-blue with a touch of green as the one accent, warm amber hill-fires, desaturated, matte, no highlights",
+	walk = { material = "Snow", color = { 78, 83, 89 } },
+	road = { material = "Cobblestone", color = { 56, 60, 68 } },
+	earth = { material = "Ground", color = { 44, 46, 52 } },
+	rock = { material = "Basalt", color = { 50, 54, 62 } },
+	far = { material = "Glacier", color = { 64, 72, 78 } },
+	bed = { material = "Ice", color = { 60, 72, 74 } },
+	abyss = { material = "Slate", color = { 18, 20, 22 } },
+	rockTint = { 60, 64, 72 },
+	trim = { wood = { 40, 38, 40 }, metal = { 52, 54, 58 }, foliage = { 30, 34, 36 } },
+	accent = {
