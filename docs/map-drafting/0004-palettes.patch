diff --git a/scripts/palettepreview.luau b/scripts/palettepreview.luau
new file mode 100644
index 00000000..09a673c3
--- /dev/null
+++ b/scripts/palettepreview.luau
@@ -0,0 +1,86 @@
+--!strict
+-- Draws an area palette (data/Palettes, systems/Palette) as labelled swatches, each
+-- with its HSV against the art bible's limit for its role, so a palette is read at a
+-- glance before its stand-in look is dressed (dresspreview whole <out> 1 1
+-- tileset=palette:<Name>):
+--   lune run scripts/palettepreview <Name> <out.png>
+local fs = require("@lune/fs")
+local process = require("@lune/process")
+local serde = require("@lune/serde")
+
+local Canvas = require("./motionlab/Canvas")
+local Label = require("./render/Label")
+local Palette = require("../src/shared/systems/Palette")
+local Palettes = require("../src/shared/data/Palettes")
+
+local name = process.args[1]
+local outPath = process.args[2] or "palettepreview.png"
+local p = name and Palettes[name]
+if not p then
+	local names = {}
+	for n in Palettes do
+		table.insert(names, n)
+	end
+	table.sort(names)
+	error(`no palette {name}; registered: {table.concat(names, ", ")}`)
+end
+
+type Swatch = { label: string, color: { number } }
+local rows: { { Swatch } } = {
+	{
+		{ label = `walk {p.walk.material}`, color = p.walk.color },
+		{ label = `road {p.road.material}`, color = p.road.color },
+		{ label = `earth {p.earth.material}`, color = p.earth.color },
+		{ label = `rock {p.rock.material}`, color = p.rock.color },
+	},
+	{
+		{ label = `far {p.far.material}`, color = p.far.color },
+		{ label = `bed {p.bed.material}`, color = p.bed.color },
+		{ label = `abyss {p.abyss.material}`, color = p.abyss.color },
+		{ label = "rock meshes", color = p.rockTint },
+	},
+	{
+		{ label = "trim wood", color = p.trim.wood },
+		{ label = "trim metal", color = p.trim.metal },
+		{ label = "trim foliage", color = p.trim.foliage },
+		{ label = "ACCENT", color = p.accent.color },
+	},
+	{
+		{ label = "lamp light", color = p.lamp },
+		{ label = "ground mist", color = p.mist },
+	},
+}
+
+local SW, SH, PAD, HEAD = 260, 150, 16, 70
+local canvas = Canvas.new(4 * (SW + PAD) + PAD, HEAD + #rows * (SH + PAD) + 60, { 26, 28, 34 })
+Label.draw(canvas, PAD, 14, `PALETTE {string.upper(p.name)}  LIGHTING {string.upper(p.lighting)}`, 2)
+for r, row in rows do
+	for c, sw in row do
+		local x, y = PAD + (c - 1) * (SW + PAD), HEAD + (r - 1) * (SH + PAD)
+		Canvas.rect(canvas, x, y, SW, SH - 34, sw.color)
+		local hi = math.max(sw.color[1], sw.color[2], sw.color[3]) / 255
+		local lo = math.min(sw.color[1], sw.color[2], sw.color[3]) / 255
+		local s = if hi > 0 then (hi - lo) / hi else 0
+		Label.draw(canvas, x, y + SH - 30, string.upper(sw.label))
+		Label.draw(
+			canvas,
+			x,
+			y + SH - 16,
+			string.format("%d %d %d  S%.2f V%.2f", sw.color[1], sw.color[2], sw.color[3], s, hi)
+		)
+	end
+end
+local problems = Palette.problems(p)
+Label.draw(
+	canvas,
+	PAD,
+	canvas.height - 40,
+	if #problems == 0 then "INSIDE THE BIBLE'S LIMITS" else string.upper(problems[1])
+)
+fs.writeFile(
+	outPath,
+	Canvas.png(canvas, function(s: string): string
+		return serde.compress("zlib", s)
+	end)
+)
+print(`wrote {outPath}`)
