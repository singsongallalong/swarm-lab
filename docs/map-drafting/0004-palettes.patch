diff --git a/src/shared/systems/Palette.luau b/src/shared/systems/Palette.luau
new file mode 100644
index 00000000..e6698c3b
--- /dev/null
+++ b/src/shared/systems/Palette.luau
@@ -0,0 +1,191 @@
+--!strict
+-- Area palettes, made ahead of the areas (swarm-lab's palettes job, fafwa 2026-10-30:
+-- "palettes ahead of time ... so we can decouple things"): the colours a future area's
+-- ground, trim, accent and light are drawn from, checked against the art bible, so its
+-- features, props and monsters can be made in parallel against one named palette before
+-- the area itself is designed. `Palette.tileset` derives a stand-in look (the moor's
+-- dressing repainted) for judging a palette offline; a real area still gets its own
+-- tileset (docs/guides/adding-areas.md).
+local LightingPresets = require("../data/LightingPresets")
+local Moor = require("../data/outdoorTilesets/Moor")
+local OutdoorTypes = require("../OutdoorTypes")
+
+type GroundLook = OutdoorTypes.GroundLook
+
+local Palette = {}
+
+export type Palette = {
+	name: string,
+	about: string, -- one sentence: the place it is for
+	words: string, -- the prompt line, like a tileset's `palette`
+	-- Ground, each a Terrain material and colour (one colour per material per palette).
+	walk: GroundLook, -- the walkable ground
+	road: GroundLook,
+	earth: GroundLook, -- under ruins and thickets, trodden ground
+	rock: GroundLook, -- cliffs, outcrops, terrace faces
+	far: GroundLook, -- the land rising past the rim
+	bed: GroundLook, -- under water or ice
+	abyss: GroundLook, -- the drop's floor, near black
+	rockTint: { number }, -- paint for rock meshes
+	trim: { wood: { number }, metal: { number }, foliage: { number } },
+	accent: { color: { number }, carriers: string }, -- the one muted accent (B8) and what wears it
+	lamp: { number }, -- the warm light's colour (B2-B3: amber unless the place says otherwise)
+	mist: { number }, -- ground mist
+	lighting: string, -- a LightingPresets name
+	-- Living ground may run to the field's saturation (bible, 2026-10-24: 0.35); else 0.2.
+	lived: boolean?,
+}
+
+-- The art bible's starting limits (section 2), HSV.
+Palette.LIMITS = table.freeze({
+	ground = { saturation = 0.2, value = 0.35 },
+	lived = { saturation = 0.35, value = 0.35 },
+	trim = { saturation = 0.4, value = 0.4 },
+	accent = { saturation = 0.5, value = 0.4 },
+	-- The abyss and the bed sit under everything; they only need to be dark.
+	under = { saturation = 0.3, value = 0.3 },
+})
+
+Palette.GROUNDS = table.freeze({ "walk", "road", "earth", "rock", "far", "bed", "abyss" })
+
+local function hsv(c: { number }): (number, number)
+	local r, g, b = c[1] / 255, c[2] / 255, c[3] / 255
+	local hi, lo = math.max(r, g, b), math.min(r, g, b)
+	return if hi > 0 then (hi - lo) / hi else 0, hi
+end
+
+-- Every way `p` breaks the bible's colour limits or Terrain's one colour per material,
+-- in plain words, with the numbers; empty when it is sound.
+function Palette.problems(p: Palette): { string }
+	local out: { string } = {}
+	local function color(where: string, c: any, limit: { saturation: number, value: number })
+		if type(c) ~= "table" or #c ~= 3 then
+			table.insert(out, `{where}: needs a colour \{r, g, b\}`)
+			return
+		end
+		for _, v in c do
+			if type(v) ~= "number" or v < 0 or v > 255 then
+				table.insert(out, `{where}: channels are 0-255`)
+				return
+			end
+		end
+		local s, v = hsv(c)
+		if s > limit.saturation + 1e-9 or v > limit.value + 1e-9 then
+			table.insert(
+				out,
+				string.format(
+					"%s: {%d, %d, %d} is saturation %.2f, value %.2f; at most %.2f and %.2f",
+					where,
+					c[1],
+					c[2],
+					c[3],
+					s,
+					v,
+					limit.saturation,
+					limit.value
+				)
+			)
+		end
+	end
+	local byMaterial: { [string]: { name: string, color: { number } } } = {}
+	local ground = if p.lived then Palette.LIMITS.lived else Palette.LIMITS.ground
+	for _, key in Palette.GROUNDS do
+		local look = (p :: any)[key] :: GroundLook?
+		if type(look) ~= "table" or type(look.material) ~= "string" then
+			table.insert(out, `{key}: needs \{ material = "<Terrain material>", color = \{r, g, b\} \}`)
+			continue
+		end
+		local limit = if key == "abyss" or key == "bed" then Palette.LIMITS.under else ground
+		color(key, look.color, limit)
+		local seen = byMaterial[look.material]
+		if seen and #look.color == 3 then
+			local a, b = seen.color, look.color
+			if a[1] ~= b[1] or a[2] ~= b[2] or a[3] ~= b[3] then
+				table.insert(
+					out,
+					`{key} and {seen.name} are both {look.material} in different colours; Terrain keeps one colour per material, so share it or pick another material`
+				)
+			end
+		else
+			byMaterial[look.material] = { name = key, color = look.color }
+		end
+	end
+	color("rockTint", p.rockTint, ground)
+	if type(p.trim) == "table" then
+		for _, key in { "wood", "metal", "foliage" } do
+			color(`trim.{key}`, (p.trim :: any)[key], Palette.LIMITS.trim)
+		end
+	else
+		table.insert(out, "trim: needs wood, metal and foliage colours")
+	end
+	if type(p.accent) == "table" then
+		color("accent.color", p.accent.color, Palette.LIMITS.accent)
+		if type(p.accent.carriers) ~= "string" or #p.accent.carriers == 0 then
+			table.insert(out, "accent.carriers: say what wears the accent (cloth, runes, moss...)")
+		end
+	else
+		table.insert(out, "accent: needs a colour and its carriers")
+	end
+	for _, key in { "lamp", "mist" } do
+		local c = (p :: any)[key]
+		if type(c) ~= "table" or #c ~= 3 then
+			table.insert(out, `{key}: needs a colour \{r, g, b\}`)
+		end
+	end
+	if not LightingPresets[p.lighting] then
+		table.insert(out, `lighting: no LightingPresets named {p.lighting}`)
+	end
+	for _, key in { "name", "about", "words" } do
+		local v = (p :: any)[key]
+		if type(v) ~= "string" or #v == 0 then
+			table.insert(out, `{key}: needs words`)
+		end
+	end
+	return out
+end
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- The moor's dressing repainted in `p`: its ground, rock and mist, for judging a
+-- palette on the moor's own layouts (dresspreview tileset=palette:<Name>). Props
+-- keep the moor's sculpts and colours: a stand-in, never a shipped look.
+function Palette.tileset(p: Palette): OutdoorTypes.OutdoorTileset
+	local moor: any = Moor
+	local function rock(pieces: { OutdoorTypes.PieceLook }): { OutdoorTypes.PieceLook }
+		local out = {}
+		for i, piece in pieces do
+			out[i] = if piece.mesh then with(piece, { color = p.rockTint }) else piece
+		end
+		return out
+	end
+	local edges = table.clone(moor.edges)
+	edges.cliff = with(moor.edges.cliff, { pieces = rock(moor.edges.cliff.pieces), ground = p.rock })
+	edges.thicket = with(moor.edges.thicket, { ground = p.earth })
+	edges.ruin_wall = with(moor.edges.ruin_wall, { ground = p.earth })
+	local hills = moor.beyond.hills
+	return with(moor, {
+		name = `palette:{p.name}`,
+		lighting = p.lighting,
+		palette = p.words,
+		ground = { heath = p.walk, road = p.road, ruin = p.earth },
+		edges = table.freeze(edges),
+		outcrop = with(moor.outcrop, { pieces = rock(moor.outcrop.pieces), ground = p.rock }),
+		pools = with(moor.pools, { bed = p.bed }),
+		groundMist = with(moor.groundMist, { color = p.mist }),
+		bluff = with(moor.bluff, { backing = p.rock, rock = p.rock }),
+		beyond = with(moor.beyond, {
+			ground = p.far,
+			rock = p.rock,
+			abyss = p.abyss,
+			hills = if hills then with(hills, { laneGround = p.road }) else nil,
+		}),
+	}) :: any
+end
+
+return Palette
diff --git a/tests/systems/Palettes.spec.luau b/tests/systems/Palettes.spec.luau
new file mode 100644
index 00000000..86784c82
--- /dev/null
+++ b/tests/systems/Palettes.spec.luau
@@ -0,0 +1,35 @@
+--!strict
+-- Area palettes (systems/Palette): every registered one sits inside the art bible's
+-- colour limits, keeps one colour per Terrain material, and dresses the moor.
+local Palette = require("../../src/shared/systems/Palette")
+local Palettes = require("../../src/shared/data/Palettes")
+local TestApi = require("../TestApi")
+
+return function(api: TestApi.Api)
+	local describe, it, expect = api.describe, api.it, api.expect
+
+	describe("Palettes", function()
+		it("are named by their key and inside the bible's limits", function()
+			for key, p in Palettes do
+				expect({ key, p.name }).toEqual({ key, key })
+				expect({ key, Palette.problems(p) }).toEqual({ key, {} })
+			end
+		end)
+
+		it("derive a stand-in tileset on the moor's dressing", function()
+			for key, p in Palettes do
+				local t = Palette.tileset(p)
+				expect({ key, t.ground.heath }).toEqual({ key, p.walk })
+				expect({ key, t.beyond.abyss }).toEqual({ key, p.abyss })
+			end
+		end)
+
+		it("catches an over-bright ground and a material in two colours", function()
+			local p = table.clone(Palettes.Rimeholt) :: any
+			p.walk = { material = "Snow", color = { 230, 235, 240 } }
+			p.far = { material = "Snow", color = { 60, 60, 60 } }
+			local problems = Palette.problems(p)
+			expect(#problems >= 2).toEqual(true)
+		end)
+	end)
+end
