diff --git a/src/shared/systems/MapFeature.luau b/src/shared/systems/MapFeature.luau
new file mode 100644
index 00000000..285dc91f
--- /dev/null
+++ b/src/shared/systems/MapFeature.luau
@@ -0,0 +1,371 @@
+--!strict
+-- Map features (swarm-lab's features job, docs/feature-library.md): one structure of a
+-- map, made and judged on its own and assembled into maps later. A frozen fall, a
+-- pressure ridge, a spire grove, a crater rim. A feature is a seeded footprint of
+-- walkable and wall cells, with:
+--   - its own cell kinds and per-cell lifts (DraftedMap.CellLook);
+--   - heights;
+--   - landmarks and effects;
+--   - anchors: where a road runs through it, and where its photographs are taken from.
+-- `asDraft` stands a feature alone on a pad of plain ground, so the drafted-map tools
+-- (dresspreview layout=, MapTrial.drafted) draw it. `stamp` puts it into a map that
+-- is being assembled.
+local DraftedMap = require("./DraftedMap")
+local Grid = require("./Grid")
+local Heath = require("./Heath")
+local Terrain = require("../data/Terrain")
+
+local MapFeature = {}
+
+type Landmark = DraftedMap.Landmark
+type Effect = DraftedMap.Effect
+type Shot = DraftedMap.Shot
+
+export type Scale = "small" | "medium" | "centrepiece"
+export type Role = "centrepiece" | "crossing" | "filler" | "boundary" | "hazard"
+
+-- What `generate` returns. Everything is in the footprint's own cells, 1..width by
+-- 1..depth, fractional where a point is (a landmark, an anchor): cell (x, z) spans
+-- x - 0.5 .. x + 0.5.
+export type Footprint = {
+	width: number,
+	depth: number,
+	walk: { boolean }, -- per cell: walkable ground or a wall
+	heights: { number }, -- per cell, studs; walkable neighbours at most a step apart
+	kinds: { [number]: string }, -- painted cells: the feature's own cell kinds
+	lifts: { [number]: number }?, -- per painted cell, a lift that replaces its kind's
+	marks: { Landmark }?, -- sculpts it stands itself
+	effects: { Effect }?, -- set pieces it places
+	-- The road through it: points on walkable ground, the first and last on its border
+	-- (where a map's road joins it), the rest the way it runs inside.
+	road: { { x: number, z: number } },
+	-- One or two cameras for its photograph, chosen like a photographer's.
+	cameras: { Shot },
+}
+
+export type Feature = {
+	name: string,
+	about: string, -- one sentence: what it is
+	palette: string, -- data/Palettes: the colours it is made for
+	scale: Scale,
+	role: Role,
+	mood: { string }, -- a few words, for a map builder searching the shelf
+	cells: { [string]: DraftedMap.CellLook }?,
+	generate: (rng: Random) -> Footprint,
+}
+
+-- Cells a side, at most, by scale.
+MapFeature.SIZES = table.freeze({ small = 16, medium = 32, centrepiece = 56 })
+MapFeature.MAX_EFFECTS = 6
+MapFeature.MAX_CAMERAS = 2
+-- Plain ground the pad leaves round a feature, cells each side.
+MapFeature.PAD = 10
+-- The pad's own cell kind: no look of its own, only the tileset's props kept off.
+local PAD_KIND = "feature_pad"
+
+-- Every way `fp` breaks the contract, in plain words; empty when it is sound.
+function MapFeature.problems(feature: Feature, fp: Footprint): { string }
+	local out: { string } = {}
+	local function add(msg: string)
+		if #out < 12 then
+			table.insert(out, msg)
+		end
+	end
+	local w, d = fp.width, fp.depth
+	local most = MapFeature.SIZES[feature.scale]
+	if not most then
+		add(`scale {feature.scale} is not small, medium or centrepiece`)
+		return out
+	end
+	if w < 4 or d < 4 or w > most or d > most then
+		add(`footprint is {w} x {d}; a {feature.scale} feature is 4 to {most} cells a side`)
+	end
+	local n = w * d
+	if #fp.walk ~= n or #fp.heights ~= n then
+		add(`walk and heights must each have width*depth = {n} entries (have {#fp.walk}, {#fp.heights})`)
+		return out
+	end
+	local g = Grid.new(w, d, Grid.WALL)
+	for i, ok in fp.walk do
+		g.cells[i] = if ok then Grid.FLOOR else Grid.WALL
+	end
+	local regions = Grid.regions(g)
+	if #regions ~= 1 then
+		add(`{#regions} separate walkable regions; a feature's walkable ground must join up`)
+	end
+	local step = Terrain.terraces.maxStep
+	for i, ok in fp.walk do
+		local x, z = Grid.coords(g, i)
+		if ok then
+			if (x == 1 or z == 1 or x == w or z == d) and math.abs(fp.heights[i]) > step then
+				add(
+					`walkable border cell {x},{z} is {fp.heights[i]} studs high; the ground round a feature is 0, so its border's walkable cells are within {step}`
+				)
+			end
+			for _, nb in Grid.NEIGHBOURS do
+				local nx, nz = x + nb[1], z + nb[2]
+				if Grid.get(g, nx, nz) == Grid.FLOOR then
+					local diff = math.abs(fp.heights[i] - fp.heights[Grid.index(g, nx, nz)])
+					if diff > step then
+						add(
+							`cells {x},{z} and {nx},{nz} are walkable but {diff} studs apart; at most {step}, or a wall between`
+						)
+						break
+					end
+				end
+			end
+		end
+	end
+	local cells = feature.cells or {}
+	for i, kind in fp.kinds do
+		if i < 1 or i > n then
+			add(`kinds names cell {i}, off the footprint`)
+			break
+		elseif not cells[kind] then
+			add(`kinds names cell kind {kind}, which feature.cells lacks`)
+			break
+		end
+	end
+	if #fp.road < 2 then
+		add("road needs at least two points, in at the border and out at the border")
+	else
+		for k, p in fp.road do
+			local cx, cz = math.floor(p.x + 0.5), math.floor(p.z + 0.5)
+			if not Grid.inBounds(g, cx, cz) or not fp.walk[Grid.index(g, cx, cz)] then
+				add(`road point {k} at {p.x},{p.z} is not on walkable ground`)
+			end
+		end
+		for _, k in { 1, #fp.road } do
+			local p = fp.road[k]
+			local cx, cz = math.floor(p.x + 0.5), math.floor(p.z + 0.5)
+			if not (cx == 1 or cz == 1 or cx == w or cz == d) then
+				add(`road point {k} at {p.x},{p.z} must be on the footprint's border, where a map's road joins it`)
+			end
+		end
+	end
+	if #fp.cameras < 1 or #fp.cameras > MapFeature.MAX_CAMERAS then
+		add(`{#fp.cameras} cameras; one or two`)
+	end
+	if fp.effects and #fp.effects > MapFeature.MAX_EFFECTS then
+		add(`{#fp.effects} effects; at most {MapFeature.MAX_EFFECTS}`)
+	end
+	return out
+end
+
+-- Puts `fp` into `map` (a map being assembled) with its west-north corner at map cell
+-- (ox, oz), unrotated. Returns its painted cells, lifts, landmarks, effects and
+-- cameras in the map's cells, for the map's draft to hand on; its road points come
+-- back too, for the map's road to run through.
+export type Stamped = {
+	painted: { [number]: string },
+	lifts: { [number]: number },
+	marks: { Landmark },
+	effects: { Effect },
+	cameras: { Shot },
+	road: { { x: number, z: number } },
+}
+
+function MapFeature.stamp(map: Heath.Map, fp: Footprint, ox: number, oz: number): Stamped
+	local g = map.grid
+	local out: Stamped = { painted = {}, lifts = {}, marks = {}, effects = {}, cameras = {}, road = {} }
+	local dx, dz = ox - 1, oz - 1
+	for z = 1, fp.depth do
+		for x = 1, fp.width do
+			local fi = (z - 1) * fp.width + x
+			local mx, mz = x + dx, z + dz
+			if Grid.inBounds(g, mx, mz) then
+				local mi = Grid.index(g, mx, mz)
+				local walk = fp.walk[fi]
+				g.cells[mi] = if walk then Grid.FLOOR else Grid.WALL
+				map.kinds[mi] = if walk then "heath" else "outcrop"
+				map.edges[mi] = nil
+				map.heights[mi] = fp.heights[fi]
+				local kind = fp.kinds[fi]
+				if kind then
+					out.painted[mi] = kind
+					local lift = if fp.lifts then fp.lifts[fi] else nil
+					if lift then
+						out.lifts[mi] = lift
+					end
+				end
+			end
+		end
+	end
+	for _, m in fp.marks or {} do
+		local c = table.clone(m)
+		c.x += dx
+		c.z += dz
+		table.insert(out.marks, c)
+	end
+	for _, e in fp.effects or {} do
+		local c = table.clone(e)
+		c.x += dx
+		c.z += dz
+		table.insert(out.effects, c)
+	end
+	for _, s in fp.cameras do
+		table.insert(out.cameras, {
+			name = s.name,
+			from = { x = s.from.x + dx, z = s.from.z + dz, lift = s.from.lift },
+			to = { x = s.to.x + dx, z = s.to.z + dz, lift = s.to.lift },
+			fov = s.fov,
+		})
+	end
+	for _, p in fp.road do
+		table.insert(out.road, { x = p.x + dx, z = p.z + dz })
+	end
+	return out
+end
+
+-- Marks road cells along a polyline (fractional cells), on walkable ground only.
+local function layRoad(map: Heath.Map, points: { { x: number, z: number } })
+	local g = map.grid
+	for k = 2, #points do
+		local a, b = points[k - 1], points[k]
+		local len = math.max(math.abs(b.x - a.x), math.abs(b.z - a.z), 1)
+		for s = 0, math.ceil(len * 2) do
+			local t = s / math.ceil(len * 2)
+			local px, pz = a.x + (b.x - a.x) * t, a.z + (b.z - a.z) * t
+			for oz = -1, 1 do
+				for ox = -1, 1 do
+					local cx, cz = math.floor(px + 0.5) + ox, math.floor(pz + 0.5) + oz
+					if Grid.get(g, cx, cz) == Grid.FLOOR and math.abs(ox) + math.abs(oz) <= 1 then
+						map.kinds[Grid.index(g, cx, cz)] = "road"
+					end
+				end
+			end
+		end
+	end
+end
+
+-- The point on the pad's edge, inside its wall ring, straight out from border point p.
+local function outward(
+	p: { x: number, z: number },
+	w: number,
+	d: number,
+	W: number,
+	D: number
+): { x: number, z: number }
+	local pad = MapFeature.PAD
+	local x, z = p.x + pad + 1, p.z + pad + 1
+	local toW, toE, toN, toS = p.x - 1, w - p.x, p.z - 1, d - p.z
+	local least = math.min(toW, toE, toN, toS)
+	if least == toW then
+		return { x = 2, z = z }
+	elseif least == toE then
+		return { x = W - 1, z = z }
+	elseif least == toN then
+		return { x = x, z = 2 }
+	end
+	return { x = x, z = D - 1 }
+end
+
+-- The feature alone on a pad of plain walkable ground, a cliff rim round it: a
+-- DraftedMap.Draft, so dresspreview (`layout=` through `feature=`) and
+-- MapTrial.drafted draw it like any map. Its shots are the feature's own cameras
+-- and the game camera over its middle.
+function MapFeature.asDraft(feature: Feature): DraftedMap.Draft
+	local pad = MapFeature.PAD
+	local stamped: { [any]: Stamped } = setmetatable({}, { __mode = "k" }) :: any
+	local function generate(rng: Random): Heath.Map
+		local fp = feature.generate(rng)
+		local W, D = fp.width + 2 * pad + 2, fp.depth + 2 * pad + 2
+		local g = Grid.new(W, D, Grid.FLOOR)
+		local map: Heath.Map = {
+			grid = g,
+			kinds = table.create(W * D, "heath" :: Heath.CellKind),
+			edges = {},
+			road = {},
+			start = { x = 2, z = 2 },
+			exit = { x = 2, z = 2 },
+			sites = {},
+			heights = table.create(W * D, 0),
+			terraces = {},
+		}
+		for i = 1, W * D do
+			local x, z = Grid.coords(g, i)
+			if x == 1 or z == 1 or x == W or z == D then
+				g.cells[i] = Grid.WALL
+				map.kinds[i] = "rim"
+				map.edges[i] = "cliff"
+			end
+		end
+		local s = MapFeature.stamp(map, fp, pad + 2, pad + 2)
+		-- The pad is plain ground: the tileset's props and pools keep off it, so the
+		-- feature is judged on its own.
+		for i, cell in g.cells do
+			local x, z = Grid.coords(g, i)
+			local inside = x >= pad + 2 and x < pad + 2 + fp.width and z >= pad + 2 and z < pad + 2 + fp.depth
+			if cell == Grid.FLOOR and not inside then
+				s.painted[i] = PAD_KIND
+			end
+		end
+		local first, last = fp.road[1], fp.road[#fp.road]
+		local road = { outward(first, fp.width, fp.depth, W, D) }
+		for _, p in s.road do
+			table.insert(road, p)
+		end
+		table.insert(road, outward(last, fp.width, fp.depth, W, D))
+		map.road = road
+		layRoad(map, road)
+		map.start = { x = math.floor(road[1].x + 0.5), z = math.floor(road[1].z + 0.5) }
+		map.exit = { x = math.floor(road[#road].x + 0.5), z = math.floor(road[#road].z + 0.5) }
+		-- A rim cell must touch walkable ground; the pad's corners touch only rim.
+		for i, kind in map.kinds do
+			if kind == "rim" then
+				local x, z = Grid.coords(g, i)
+				local touches = false
+				for _, nb in Grid.NEIGHBOURS do
+					touches = touches or Grid.get(g, x + nb[1], z + nb[2]) == Grid.FLOOR
+				end
+				if not touches then
+					map.kinds[i] = "void"
+					map.edges[i] = nil
+				end
+			end
+		end
+		-- The game's own camera over the feature's middle (pitch 50, 35 studs back,
+		-- CameraTuning), which always sees it; an eye-level shot from the road's end
+		-- came back blocked or empty too often (rimeholt-features, 2026-10-30).
+		local centre = { x = fp.width / 2 + pad + 1.5, z = fp.depth / 2 + pad + 1.5 }
+		local back = 35 * math.cos(math.rad(50)) / Terrain.cellSize
+		table.insert(s.cameras, {
+			name = "the game camera over it",
+			from = { x = centre.x, z = centre.z + back, lift = 35 * math.sin(math.rad(50)) },
+			to = { x = centre.x, z = centre.z, lift = 0 },
+		})
+		stamped[map] = s
+		return map
+	end
+	local function of(map: Heath.Map): Stamped
+		return stamped[map] or { painted = {}, lifts = {}, marks = {}, effects = {}, cameras = {}, road = {} }
+	end
+	return {
+		name = feature.name,
+		about = feature.about,
+		tileset = string.lower(feature.palette),
+		generate = generate,
+		landmarks = function(map: Heath.Map, _rng: Random): { Landmark }
+			return of(map).marks
+		end,
+		cells = (function(): { [string]: DraftedMap.CellLook }
+			local cells = table.clone(feature.cells or {})
+			cells[PAD_KIND] = { clear = true }
+			return cells
+		end)(),
+		paint = function(map: Heath.Map, _rng: Random): { [number]: string }
+			return of(map).painted
+		end,
+		lifts = function(map: Heath.Map, _rng: Random): { [number]: number }
+			return of(map).lifts
+		end,
+		effects = function(map: Heath.Map, _rng: Random): { Effect }
+			return of(map).effects
+		end,
+		shots = function(map: Heath.Map): { Shot }
+			return of(map).cameras
+		end,
+	}
+end
+
+return MapFeature
diff --git a/src/shared/systems/MapVariety.luau b/src/shared/systems/MapVariety.luau
new file mode 100644
index 00000000..dbd22b22
--- /dev/null
+++ b/src/shared/systems/MapVariety.luau
@@ -0,0 +1,176 @@
+--!strict
+-- How different a generator's seeds are, measured (swarm-lab: features and drafted maps
+-- kept repeating one layout per seed). fafwa (2026-10-30) ranks the axes:
+--   1. topology: different layouts, branching paths, several obstructions;
+--   2. look: does each seed read as visually distinct.
+-- Pure: a footprint or map in, a signature out; two signatures in, distances out.
+local Grid = require("./Grid")
+
+local MapVariety = {}
+
+-- What a generator's seeds must reach (MapFeatures and DraftedMaps specs): the mean
+-- topology distance over six seeds, and the closest two seeds' (no near-copies).
+-- Calibrated on rimeholt-features (2026-10-30), where the critic called the features
+-- under these "one layout repeated" (0.00 to 0.18) and the ones over them varied.
+MapVariety.MIN_TOPOLOGY = 0.3
+MapVariety.MIN_CLOSEST = 0.12
+MapVariety.MIN_LOOK = 0.05
+
+-- The coarse grid layouts are compared on, cells a side: fine enough for a shape,
+-- coarse enough that a wall moved one cell isn't a new layout.
+MapVariety.COARSE = 12
+-- Wall islands (walls not touching the border) smaller than this many cells are clutter,
+-- not obstructions.
+MapVariety.MIN_OBSTRUCTION = 6
+
+export type Signature = {
+	occupancy: { number }, -- COARSE x COARSE shares of walkable ground, 0..1
+	obstructions: number, -- wall islands inside the walkable ground
+	kinds: { [string]: number }, -- share of cells by painted kind ("plain" for none)
+	lifts: { number }, -- share of cells in lift bands: 0, (0, 4], (4, 12], (12, 30], > 30
+	levels: number, -- distinct walkable heights
+}
+
+-- `walk[i]` true where walkable; `kinds[i]` a painted kind or nil; `lifts[i]` studs;
+-- `heights[i]` studs. Index = (z - 1) * width + x.
+function MapVariety.signature(
+	width: number,
+	depth: number,
+	walk: { boolean },
+	kinds: { [number]: string },
+	lifts: { [number]: number },
+	heights: { number }
+): Signature
+	local n = MapVariety.COARSE
+	local sums, counts = table.create(n * n, 0), table.create(n * n, 0)
+	for i = 1, width * depth do
+		local x, z = (i - 1) % width + 1, (i - 1) // width + 1
+		local cx = math.min(n, math.floor((x - 1) / width * n) + 1)
+		local cz = math.min(n, math.floor((z - 1) / depth * n) + 1)
+		local c = (cz - 1) * n + cx
+		counts[c] += 1
+		if walk[i] then
+			sums[c] += 1
+		end
+	end
+	local occupancy = table.create(n * n, 0)
+	for c = 1, n * n do
+		occupancy[c] = if counts[c] > 0 then sums[c] / counts[c] else 0
+	end
+	-- Obstructions: wall regions that don't touch the border.
+	local g = Grid.new(width, depth, Grid.WALL)
+	for i, w in walk do
+		-- Flip: walls become floor, so Grid.regions finds wall islands.
+		g.cells[i] = if w then Grid.WALL else Grid.FLOOR
+	end
+	local obstructions = 0
+	for _, region in Grid.regions(g) do
+		if #region >= MapVariety.MIN_OBSTRUCTION then
+			local border = false
+			for _, i in region do
+				local x, z = Grid.coords(g, i)
+				if x == 1 or z == 1 or x == width or z == depth then
+					border = true
+					break
+				end
+			end
+			if not border then
+				obstructions += 1
+			end
+		end
+	end
+	local total = width * depth
+	local kindShares: { [string]: number } = {}
+	local bands = { 0, 0, 0, 0, 0 }
+	local seen: { [number]: boolean } = {}
+	local levels = 0
+	for i = 1, total do
+		local k = kinds[i] or "plain"
+		kindShares[k] = (kindShares[k] or 0) + 1 / total
+		local l = lifts[i] or 0
+		local b = if l <= 0 then 1 elseif l <= 4 then 2 elseif l <= 12 then 3 elseif l <= 30 then 4 else 5
+		bands[b] += 1 / total
+		if walk[i] then
+			local h = math.floor(heights[i] + 0.5)
+			if not seen[h] then
+				seen[h] = true
+				levels += 1
+			end
+		end
+	end
+	return {
+		occupancy = occupancy,
+		obstructions = obstructions,
+		kinds = kindShares,
+		lifts = bands,
+		levels = levels,
+	}
+end
+
+-- Topology distance, 0 (same layout) to 1: how much of the coarse layout differs, plus
+-- a share for a different count of obstructions or of walkable levels.
+function MapVariety.topology(a: Signature, b: Signature): number
+	local diff, n = 0, #a.occupancy
+	for c = 1, n do
+		diff += math.abs(a.occupancy[c] - b.occupancy[c])
+	end
+	local layout = diff / n
+	local counts = 0
+	if a.obstructions ~= b.obstructions then
+		counts += 1
+	end
+	if a.levels ~= b.levels then
+		counts += 1
+	end
+	return math.min(1, layout * 2 + counts * 0.1)
+end
+
+-- Look distance, 0 to 1: how differently the cells divide among kinds and lift bands.
+function MapVariety.look(a: Signature, b: Signature): number
+	local kinds = 0
+	local all: { [string]: boolean } = {}
+	for k in a.kinds do
+		all[k] = true
+	end
+	for k in b.kinds do
+		all[k] = true
+	end
+	for k in all do
+		kinds += math.abs((a.kinds[k] or 0) - (b.kinds[k] or 0))
+	end
+	local lifts = 0
+	for i = 1, 5 do
+		lifts += math.abs(a.lifts[i] - b.lifts[i])
+	end
+	return math.min(1, (kinds + lifts) / 2)
+end
+
+export type Spread = {
+	topology: number, -- mean pairwise topology distance
+	look: number, -- mean pairwise look distance
+	closest: { a: number, b: number, topology: number }, -- the most alike pair, by topology
+}
+
+-- The spread over a set of seeds' signatures (index = seed).
+function MapVariety.spread(sigs: { Signature }): Spread
+	local t, l, pairs = 0, 0, 0
+	local closest = { a = 1, b = 2, topology = math.huge }
+	for i = 1, #sigs do
+		for j = i + 1, #sigs do
+			local d = MapVariety.topology(sigs[i], sigs[j])
+			t += d
+			l += MapVariety.look(sigs[i], sigs[j])
+			pairs += 1
+			if d < closest.topology then
+				closest = { a = i, b = j, topology = d }
+			end
+		end
+	end
+	return {
+		topology = if pairs > 0 then t / pairs else 0,
+		look = if pairs > 0 then l / pairs else 0,
+		closest = closest,
+	}
+end
+
+return MapVariety
diff --git a/src/shared/systems/features/RimeholtFrozenFall.luau b/src/shared/systems/features/RimeholtFrozenFall.luau
new file mode 100644
index 00000000..93a88f83
--- /dev/null
+++ b/src/shared/systems/features/RimeholtFrozenFall.luau
@@ -0,0 +1,199 @@
+--!strict
+-- The worked example for the features job: frozen waterfalls in Rimeholt's colours. A
+-- wall of dark granite crosses the footprint; through notches in it falls hang frozen
+-- mid-drop, their columns highest at the lip and stepping down to sheets of pale ice at
+-- their feet, where a cold glow breathes. The road climbs through a gap beside them.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first, then
+-- look). The first draws choose the structure, the rest only dress it:
+--   1. the wall's shape: a straight wall, a bend (an L from the top edge), or a straight
+--      wall with twin falls;
+--   2. its size and where the wall and the road's gap stand;
+--   3. how many granite outcrops (0 to 3) block the snow below;
+--   4. per fall: its width, height and how many steps it takes down.
+local DraftedMap = require("../DraftedMap")
+local MapFeature = require("../MapFeature")
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local SHAPES = { "straight", "bend", "twin" }
+
+local feature: MapFeature.Feature = {
+	name = "RimeholtFrozenFall",
+	about = "Waterfalls frozen mid-drop through a granite wall, over sheets of glowing ice.",
+	palette = "Rimeholt",
+	scale = "medium",
+	role = "centrepiece",
+	mood = { "frozen", "tall", "glowing", "still" },
+	cells = {
+		-- Columns of fall ice, lifted per cell (a draft's own lifts). Marble, which the
+		-- tileset leaves free, so the falls can be paler than its glacier.
+		fall = {
+			ground = { material = "Marble", color = { 82, 98, 100 } },
+			clear = true,
+			glow = { color = { 120, 200, 200 }, range = 10, brightness = 0.8, every = 6, height = 2 },
+		},
+		-- The granite wall the falls break through, and the outcrops below it.
+		wall = { ground = { material = "Basalt", color = { 50, 54, 62 } }, clear = true, lift = 14 },
+		-- Frozen pools at their feet: walkable, a hair over the snow.
+		pool = {
+			ground = { material = "Ice", color = { 60, 72, 74 } },
+			lift = 0.3,
+			clear = true,
+			glow = { color = { 110, 190, 190 }, range = 8, brightness = 0.6, every = 18 },
+		},
+	} :: { [string]: DraftedMap.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-2: the structure, first.
+		local shape = SHAPES[whole(rng, 1, #SHAPES)]
+		local w, d = whole(rng, 22, 30), whole(rng, 20, 28)
+		local walk, heights, kinds, lifts = table.create(w * d, true), table.create(w * d, 0), {}, {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		local function inside(x: number, z: number): boolean
+			return x >= 1 and z >= 1 and x <= w and z <= d
+		end
+		local wallZ = whole(rng, 6, math.floor(d / 2) - 2)
+		local gapX = whole(rng, 3, w - 6)
+		-- A bend's second arm runs up from the wall to the top edge, right of the gap.
+		local bendX = if shape == "bend" then whole(rng, math.min(gapX + 6, w - 4), w - 4) else w + 1
+		local function wallAt(x: number, z: number, lift: number)
+			local i = at(x, z)
+			walk[i] = false
+			kinds[i] = "wall"
+			lifts[i] = lift
+		end
+		for x = 1, math.min(bendX, w) do
+			if x < gapX or x > gapX + 2 then
+				for z = wallZ, wallZ + 1 do
+					wallAt(x, z, whole(rng, 12, 16))
+				end
+			end
+		end
+		if shape == "bend" then
+			for z = 1, wallZ + 1 do
+				for x = bendX, math.min(bendX + 1, w) do
+					wallAt(x, z, whole(rng, 12, 16))
+				end
+			end
+		end
+
+		-- The falls: one, or two for a twin wall, each in the wall away from the gap.
+		local spans: { { x0: number, x1: number } } = {}
+		if gapX > 8 then
+			table.insert(spans, { x0 = 2, x1 = gapX - 2 })
+		end
+		if math.min(bendX, w) - (gapX + 3) > 6 then
+			table.insert(spans, { x0 = gapX + 4, x1 = math.min(bendX, w) - 2 })
+		end
+		local count = if shape == "twin" then math.min(2, #spans) else math.min(1, #spans)
+		local pools: { { cx: number, cz: number } } = {}
+		for k = 1, count do
+			local span = spans[k]
+			local fw = math.min(whole(rng, 3, 6), span.x1 - span.x0 + 1)
+			local fx = whole(rng, span.x0, span.x1 - fw + 1)
+			local lip = between(rng, 16, 26)
+			local steps = whole(rng, 1, 4)
+			for x = fx, fx + fw - 1 do
+				for z = wallZ, wallZ + 1 do
+					kinds[at(x, z)] = "fall"
+					lifts[at(x, z)] = lip
+				end
+				for s = 1, steps do
+					local z = wallZ + 1 + s
+					if inside(x, z) then
+						walk[at(x, z)] = false
+						kinds[at(x, z)] = "fall"
+						lifts[at(x, z)] = math.max(lip - s * between(rng, 4, 7), 3)
+					end
+				end
+			end
+			table.insert(pools, { cx = fx + fw / 2, cz = wallZ + steps + 4 })
+		end
+		for _, p in pools do
+			local rx, rz = between(rng, 3, 5), between(rng, 2, 3.5)
+			for z = 1, d do
+				for x = 1, w do
+					local i = at(x, z)
+					if walk[i] and ((x - p.cx) / rx) ^ 2 + ((z - p.cz) / rz) ^ 2 <= 1 then
+						kinds[i] = "pool"
+					end
+				end
+			end
+		end
+
+		-- 3: outcrops in the snow below the wall, clear of the road, the pools and each other.
+		local road = gapX + 1
+		local outcrops = whole(rng, 0, 3)
+		local placed = 0
+		for _ = 1, 40 do
+			if placed >= outcrops then
+				break
+			end
+			local ox, oz = whole(rng, 3, w - 2), whole(rng, wallZ + 6, d - 3)
+			local r = between(rng, 1.4, 2.4)
+			local clear = math.abs(ox - road) > r + 2
+			for z = math.floor(oz - r - 2), math.ceil(oz + r + 2) do
+				for x = math.floor(ox - r - 2), math.ceil(ox + r + 2) do
+					if inside(x, z) and (not walk[at(x, z)] or kinds[at(x, z)] == "pool") then
+						clear = false
+					end
+				end
+			end
+			if clear then
+				placed += 1
+				for z = math.floor(oz - r), math.ceil(oz + r) do
+					for x = math.floor(ox - r), math.ceil(ox + r) do
+						if inside(x, z) and (x - ox) ^ 2 + (z - oz) ^ 2 <= r * r then
+							wallAt(x, z, whole(rng, 4, 9))
+						end
+					end
+				end
+			end
+		end
+
+		local first = pools[1] or { cx = road, cz = wallZ + 6 }
+		local marks: { DraftedMap.Landmark } = {
+			{ sculpt = "rimeholt_hillfire", x = road + 1, z = wallZ + 3 },
+		}
+		if first.cx + 7 <= w - 1 then
+			table.insert(marks, { sculpt = "rimeholt_runestones", x = first.cx + 6, z = first.cz + 1, scale = 0.7 })
+		end
+		local effects: { DraftedMap.Effect } = {}
+		for _, p in pools do
+			table.insert(effects, { recipe = "rimeholt_underice", x = p.cx, z = p.cz, lift = 0.4 })
+		end
+		return {
+			width = w,
+			depth = d,
+			walk = walk,
+			heights = heights,
+			kinds = kinds,
+			lifts = lifts,
+			marks = marks,
+			effects = effects,
+			road = {
+				{ x = road, z = d },
+				{ x = road, z = wallZ + 3 },
+				{ x = road, z = 1 },
+			},
+			cameras = {
+				{
+					name = "up the fall",
+					from = { x = first.cx - 1, z = math.min(first.cz + 6, d - 1), lift = 3 },
+					to = { x = first.cx, z = wallZ, lift = 12 },
+					fov = 60,
+				},
+			},
+		}
+	end,
+}
+
+return feature
