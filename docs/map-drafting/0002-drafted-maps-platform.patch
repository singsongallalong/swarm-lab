+--!strict
+-- Every drafted map by name (systems/DraftedMap; swarm-lab's maps job). Each is one
+-- pure, seeded layout module in systems/draftedmaps, judged offline with
+-- `lune run scripts/dresspreview whole out.png 3 1 layout=<Name>` before anything
+-- builds it.
+local DraftedMap = require("../systems/DraftedMap")
+
+local DraftedMaps: { [string]: DraftedMap.Draft } = {
+	-- One line per draft, `Name = Name,`, with its require above.
+}
+
+return table.freeze(DraftedMaps)
diff --git a/src/shared/systems/DraftedMap.luau b/src/shared/systems/DraftedMap.luau
