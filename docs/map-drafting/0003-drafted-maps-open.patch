+--!strict
+-- Every drafted map by name (systems/DraftedMap; swarm-lab's maps job). Each is one
+-- pure, seeded layout module in systems/draftedmaps, judged offline with
+-- `lune run scripts/dresspreview whole out.png 3 1 layout=<Name>` before anything
+-- builds it.
+local DraftedMap = require("../systems/DraftedMap")
+
+local DraftedMaps: { [string]: DraftedMap.Draft } = {
+	-- One line per draft, `Name = Name,`, with its require above.
+}
+
+return table.freeze(DraftedMaps)
diff --git a/src/shared/systems/DraftedMap.luau b/src/shared/systems/DraftedMap.luau
new file mode 100644
index 00000000..5962a21f
--- /dev/null
+++ b/src/shared/systems/DraftedMap.luau
@@ -0,0 +1,488 @@
+--!strict
+-- Drafted maps (swarm-lab's maps job): a whole outdoor layout written as one pure,
+-- seeded module, with the landmarks it places itself, dressed by the same MapDress
+-- every map uses. A draft is judged offline (dresspreview layout=<Name>) before any
+-- builder, place or seam knows about it; making one a real map is planned work
+-- (docs/guides/adding-areas.md, "A new kind of map").
+local DistanceField = require("./DistanceField")
+local Grid = require("./Grid")
+local Heath = require("./Heath")
+local MapDress = require("./MapDress")
+local OutdoorTypes = require("../OutdoorTypes")
+local Sculpts = require("../data/Sculpts")
+local SetPieces = require("../data/SetPieces")
+local Terrain = require("../data/Terrain")
+
+local DraftedMap = {}
+
+-- A landmark the layout places itself, in fractional cells like the road; drawn as
+-- the named sculpt, standing on the ground.
+export type Landmark = {
+	sculpt: string,
+	x: number,
+	z: number,
+	yaw: number?, -- degrees
+	scale: number?,
+	sink: number?, -- studs into the ground
+}
+
+-- A kind of ground the draft makes itself, laid over the cells `paint` gives it:
+-- its own surface, lifted or not, its own scatter of sculpts, and the tileset's
+-- props kept off it if `clear`. Whether a cell is walkable is still the grid's.
+export type CellProp = {
+	sculpt: string, -- data/Sculpts
+	every: number, -- one per this many painted cells, on average (>= 1)
+	scale: { number }?, -- { min, max }; 1 when nil
+	sink: number?, -- studs into the ground; negative stands it up off it
+}
+
+export type CellLook = {
+	ground: OutdoorTypes.GroundLook?, -- { material = Enum.Material name, color = { r, g, b } }
+	-- Studs its surface stands over the cell's height: a sheet of ice 0.4, a
+	-- frozen wave or a pillar on a wall cell 20. Walkable cells at most WALK_LIFT.
+	lift: number?,
+	clear: boolean?,
+	props: { CellProp }?,
+}
+
+-- A camera the draft chooses for its own photographs (dresspreview `shots`):
+-- `from` and `to` in fractional cells, with `lift` studs over the ground there.
+export type Shot = {
+	name: string,
+	from: { x: number, z: number, lift: number },
+	to: { x: number, z: number, lift: number },
+	fov: number?, -- degrees; 70 like Roblox's camera
+}
+
+-- An environment set piece (data/SetPieces) the draft stands on its map, in
+-- fractional cells, `lift` studs over the ground there.
+export type Effect = { recipe: string, x: number, z: number, lift: number?, seed: number? }
+
+export type Draft = {
+	name: string,
+	about: string, -- one sentence: what the map is
+	tileset: string, -- the outdoor tileset it is drawn in (data/OutdoorTilesets)
+	generate: (rng: Random) -> Heath.Map,
+	landmarks: ((map: Heath.Map, rng: Random) -> { Landmark })?,
+	-- Its own kinds of ground, and which cells get each (cell index -> kind).
+	cells: { [string]: CellLook }?,
+	paint: ((map: Heath.Map, rng: Random) -> { [number]: string })?,
+	effects: ((map: Heath.Map, rng: Random) -> { Effect })?,
+	shots: ((map: Heath.Map) -> { Shot })?,
+}
+
+-- Bounds on a draft's size: up to about two moor reaches.
+DraftedMap.MAX_CELLS = 240 * 200
+DraftedMap.MIN_FLOOR = 1500
+-- The most a walkable cell's own ground may lift its surface, and any cell's.
+DraftedMap.WALK_LIFT = 1
+DraftedMap.MAX_LIFT = 60
+DraftedMap.MAX_SHOTS = 3
+-- Set pieces are emitters and lights; a map's own stay within this many.
+DraftedMap.MAX_EFFECTS = 8
+-- Terrain materials a cell look might take, offered when it picks a taken one.
+local FREE_MATERIALS = {
+	"Ice",
+	"Glacier",
+	"Snow",
+	"Slate",
+	"Basalt",
+	"Rock",
+	"Pavement",
+	"Salt",
+	"Limestone",
+	"Marble",
+	"CrackedLava",
+	"Sandstone",
+	"Asphalt",
+	"Mud",
+	"Ground",
+	"Grass",
+	"LeafyGrass",
+	"Sand",
+	"Cobblestone",
+	"Concrete",
+}
+
+-- Every way `map` breaks what MapDress and the game assume of a layout, in plain words;
+-- empty when it is sound. Mirrors tests/systems/Heath.spec.
+function DraftedMap.problems(map: Heath.Map): { string }
+	local out: { string } = {}
+	local function add(msg: string)
+		if #out < 12 then
+			table.insert(out, msg)
+		end
+	end
+	local g = map.grid
+	local n = g.width * g.depth
+	if n > DraftedMap.MAX_CELLS then
+		add(`grid is {g.width}x{g.depth}: more than {DraftedMap.MAX_CELLS} cells`)
+	end
+	if #g.cells ~= n or #map.kinds ~= n or #map.heights ~= n then
+		add(
+			`grid.cells, kinds and heights must each have width*depth = {n} entries (have {#g.cells}, {#map.kinds}, {#map.heights})`
+		)
+		return out
+	end
+	-- The outermost ring is never walkable: MapDress hangs the border's walls there.
+	for i, cell in g.cells do
+		local x, z = Grid.coords(g, i)
+		if (x == 1 or z == 1 or x == g.width or z == g.depth) and cell ~= Grid.WALL then
+			add(`cell {x},{z} on the map's outer edge is walkable; keep a wall ring round the map`)
+			break
+		end
+	end
+	local floor = 0
+	for i, kind in map.kinds do
+		local walkable = kind == "heath" or kind == "road"
+		if (g.cells[i] == Grid.FLOOR) ~= walkable then
+			local x, z = Grid.coords(g, i)
+			add(
+				`cell {x},{z}: kind {kind} but grid says {if g.cells[i] == Grid.FLOOR then "floor" else "wall"} (heath and road are floor, the rest wall)`
+			)
+			break
+		end
+		if walkable then
+			floor += 1
+		end
+	end
+	if floor < DraftedMap.MIN_FLOOR then
+		add(`only {floor} walkable cells; a map needs at least {DraftedMap.MIN_FLOOR}`)
+	end
+	local regions = #Grid.regions(g)
+	if regions ~= 1 then
+		add(`{regions} separate walkable regions; everything walkable must join up (Grid.keepLargestRegion)`)
+	end
+	local ends: { [string]: Grid.CellCoord } = { start = map.start, exit = map.exit }
+	for label, c in ends do
+		if not Grid.inBounds(g, c.x, c.z) or map.kinds[Grid.index(g, c.x, c.z)] ~= "road" then
+			add(`{label} at {c.x},{c.z} is not on a road cell`)
+		end
+	end
+	if #out == 0 then
+		local field = DistanceField.fromCells(g, { map.start })
+		if not (DistanceField.at(field, map.exit.x, map.exit.z) < math.huge) then
+			add("no walkable way from start to exit")
+		end
+	end
+	if #map.road < 2 then
+		add("road needs at least two centreline points, start to exit")
+	end
+	for _, p in map.road do
+		if p.x < 1 or p.z < 1 or p.x > g.width or p.z > g.depth then
+			add(`road point {p.x},{p.z} is off the grid`)
+			break
+		end
+	end
+	for i, kind in map.kinds do
+		local x, z = Grid.coords(g, i)
+		if (map.edges[i] ~= nil) ~= (kind == "rim") then
+			add(
+				`cell {x},{z}: {if kind == "rim"
+					then "a rim cell needs an edge kind"
+					else "only rim cells get an edge kind"}`
+			)
+			break
+		end
+		if kind == "rim" then
+			local touches = false
+			for _, d in Grid.NEIGHBOURS do
+				touches = touches or Grid.get(g, x + d[1], z + d[2]) == Grid.FLOOR
+			end
+			if not touches then
+				add(`rim cell {x},{z} touches no walkable cell; rims line the walkable ground`)
+				break
+			end
+		end
+	end
+	-- Walkable neighbours more than a step apart need a bluff (a wall cell) between.
+	for i, cell in g.cells do
+		if cell == Grid.FLOOR then
+			local x, z = Grid.coords(g, i)
+			for _, d in Grid.NEIGHBOURS do
+				local nx, nz = x + d[1], z + d[2]
+				if Grid.get(g, nx, nz) == Grid.FLOOR then
+					local step = math.abs(map.heights[i] - map.heights[Grid.index(g, nx, nz)])
+					if step > Terrain.terraces.maxStep then
+						add(
+							`cells {x},{z} and {nx},{nz} are walkable but {step} studs apart; at most {Terrain.terraces.maxStep}, or make the higher a bluff (wall) cell, or ramp between`
+						)
+						break
+					end
+				end
+			end
+		end
+	end
+	local seen: { [number]: boolean } = {}
+	for _, site in map.sites do
+		local where = `{site.kind} site at {site.x0},{site.z0}`
+		if (site.x1 - site.x0 + 1) % 2 ~= 0 or (site.z1 - site.z0 + 1) % 2 ~= 0 then
+			add(`{where}: width and depth must be even numbers of cells (buildings are 2 cells a unit)`)
+		elseif not Heath.onFloor(g, site) then
+			add(`{where}: not wholly on walkable ground`)
+		else
+			for z = site.z0, site.z1 do
+				for x = site.x0, site.x1 do
+					local i = Grid.index(g, x, z)
+					if seen[i] then
+						add(`{where}: overlaps another site`)
+					end
+					seen[i] = true
+				end
+			end
+		end
+	end
+	return out
+end
+
+-- Problems with a draft's landmarks on `map`.
+function DraftedMap.landmarkProblems(map: Heath.Map, marks: { Landmark }): { string }
+	local out: { string } = {}
+	for i, m in marks do
+		if not Sculpts[m.sculpt] then
+			table.insert(out, `landmark {i}: no sculpt named {m.sculpt}`)
+		elseif not Grid.inBounds(map.grid, math.floor(m.x), math.floor(m.z)) then
+			table.insert(out, `landmark {i} ({m.sculpt}) at {m.x},{m.z} is off the grid`)
+		end
+	end
+	return out
+end
+
+-- Problems with what a draft adds over its map: its own cells, effects and shots.
+-- `used`: every terrain material the draft's tileset already colours, by name.
+-- Roblox colours a terrain material once for the whole place, so a cell look
+-- may use one of those only in the same colour.
+function DraftedMap.materialsOf(tileset: any): { [string]: { number } }
+	local used: { [string]: { number } } = {}
+	local seen: { [any]: boolean } = {}
+	local function walk(t: any)
+		if type(t) ~= "table" or seen[t] then
+			return
+		end
+		seen[t] = true
+		if type(t.material) == "string" and type(t.color) == "table" and t.mesh == nil and t.size == nil then
+			used[t.material] = used[t.material] or t.color
+		end
+		for _, v in t do
+			walk(v)
+		end
+	end
+	walk(tileset)
+	return used
+end
+
+function DraftedMap.draftProblems(draft: Draft, map: Heath.Map, rng: Random, tileset: any?): { string }
+	local out: { string } = {}
+	local g = map.grid
+	local used = if tileset then DraftedMap.materialsOf(tileset) else {}
+	local cells: { [string]: CellLook } = draft.cells or {}
+	for kind, look in cells do
+		local lift = look.lift or 0
+		if lift < 0 or lift > DraftedMap.MAX_LIFT then
+			table.insert(out, `cell kind {kind}: lift {lift} outside 0..{DraftedMap.MAX_LIFT}`)
+		end
+		if look.ground and (typeof(look.ground.material) ~= "string" or #look.ground.color ~= 3) then
+			table.insert(out, `cell kind {kind}: ground needs a material name and a 3-number colour`)
+		elseif look.ground then
+			local c, have = look.ground.color, used[look.ground.material]
+			if have and (have[1] ~= c[1] or have[2] ~= c[2] or have[3] ~= c[3]) then
+				local free = {}
+				for _, name in FREE_MATERIALS do
+					if not used[name] then
+						table.insert(free, name)
+					end
+				end
+				table.insert(
+					out,
+					`cell kind {kind}: the tileset already colours {look.ground.material} \{{have[1]}, {have[2]}, {have[3]}\} (Roblox colours a material once for the whole map); use that colour or a material it leaves free: {table.concat(
+						free,
+						", "
+					)}`
+				)
+			end
+		end
+		local props: { CellProp } = look.props or {}
+		for _, prop in props do
+			if not Sculpts[prop.sculpt] then
+				table.insert(out, `cell kind {kind}: no sculpt named {prop.sculpt}`)
+			elseif prop.every < 1 then
+				table.insert(out, `cell kind {kind}: prop {prop.sculpt} every {prop.every}, at least 1`)
+			end
+		end
+	end
+	if draft.paint then
+		local painted = draft.paint(map, rng)
+		for i, kind in painted do
+			local look = cells[kind]
+			if not look then
+				table.insert(out, `paint names cell kind {kind}, which draft.cells lacks`)
+				break
+			elseif i < 1 or i > #g.cells then
+				table.insert(out, `paint names cell {i}, off the grid`)
+				break
+			elseif g.cells[i] == Grid.FLOOR and (look.lift or 0) > DraftedMap.WALK_LIFT then
+				local x, z = Grid.coords(g, i)
+				table.insert(
+					out,
+					`cell {x},{z} is walkable but kind {kind} lifts it {look.lift} (at most {DraftedMap.WALK_LIFT})`
+				)
+				break
+			end
+		end
+	end
+	if draft.effects then
+		local effects = draft.effects(map, rng)
+		if #effects > DraftedMap.MAX_EFFECTS then
+			table.insert(out, `{#effects} effects; at most {DraftedMap.MAX_EFFECTS}`)
+		end
+		for k, e in effects do
+			if not SetPieces[e.recipe] then
+				table.insert(out, `effect {k}: no set piece named {e.recipe}`)
+			elseif not Grid.inBounds(g, math.floor(e.x), math.floor(e.z)) then
+				table.insert(out, `effect {k} ({e.recipe}) at {e.x},{e.z} is off the grid`)
+			end
+		end
+	end
+	if draft.shots then
+		local shots = draft.shots(map)
+		if #shots > DraftedMap.MAX_SHOTS then
+			table.insert(out, `{#shots} shots; at most {DraftedMap.MAX_SHOTS}`)
+		end
+		for _, shot in shots do
+			for _, p in { shot.from, shot.to } do
+				if not Grid.inBounds(g, math.floor(p.x), math.floor(p.z)) then
+					table.insert(out, `shot {shot.name}: {p.x},{p.z} is off the grid`)
+				end
+			end
+		end
+	end
+	return out
+end
+
+-- Rows of same-kind, same-height painted cells, as rectangles one cell deep.
+local function paintedRuns(
+	map: Heath.Map,
+	painted: { [number]: string }
+): { { kind: string, rect: Grid.Rect, h: number } }
+	local g = map.grid
+	local out = {}
+	for z = 1, g.depth do
+		local x = 1
+		while x <= g.width do
+			local i = Grid.index(g, x, z)
+			local kind = painted[i]
+			if kind then
+				local h = map.heights[i]
+				local x1 = x
+				while x1 < g.width do
+					local j = Grid.index(g, x1 + 1, z)
+					if painted[j] ~= kind or map.heights[j] ~= h then
+						break
+					end
+					x1 += 1
+				end
+				table.insert(out, { kind = kind, rect = { x0 = x, z0 = z, x1 = x1, z1 = z }, h = h })
+				x = x1 + 1
+			else
+				x += 1
+			end
+		end
+	end
+	return out
+end
+
+-- The draft's map dressed in `tileset`, its own landmarks added to the pieces.
+function DraftedMap.dress(
+	draft: Draft,
+	map: Heath.Map,
+	tileset: OutdoorTypes.OutdoorTileset,
+	cellSize: number,
+	rng: Random
+): MapDress.Dressing
+	-- Landmarks first, so the dressing's quiet props keep clear of them.
+	local marks: { Landmark } = if draft.landmarks then draft.landmarks(map, rng) else {}
+	local keepOut: { MapDress.KeepOut } = {}
+	for _, m in marks do
+		local recipe = Sculpts[m.sculpt]
+		if recipe then
+			local reach = math.max(recipe.size[1], recipe.size[3]) * (m.scale or 1) / 2
+			table.insert(keepOut, { x = m.x, z = m.z, radius = reach / cellSize + 1 })
+		end
+	end
+	local dressing = MapDress.dress(map, tileset, cellSize, rng, nil, keepOut)
+	-- Its own cells: their surface over the dressing's ground, the tileset's
+	-- props cleared off them if asked, and their own scatter.
+	local cells: { [string]: CellLook } = draft.cells or {}
+	local painted: { [number]: string } = if draft.paint then draft.paint(map, rng) else {}
+	for _, run in paintedRuns(map, painted) do
+		local look = cells[run.kind]
+		if look and look.ground then
+			table.insert(dressing.ground, {
+				look = look.ground,
+				rect = run.rect,
+				top = run.h + (look.lift or 0),
+				bottom = run.h - 4,
+			})
+		end
+	end
+	local kept: { MapDress.PiecePlacement } = {}
+	for _, piece in dressing.pieces do
+		local quiet = string.sub(piece.group, 1, 5) == "prop:" or piece.group == "outcrop"
+		local cx, cz = Grid.toCell(piece.x, piece.z, cellSize)
+		local i = if Grid.inBounds(map.grid, cx, cz) then Grid.index(map.grid, cx, cz) else nil
+		local look = if i and painted[i] then cells[painted[i]] else nil
+		if not (quiet and look and look.clear) then
+			table.insert(kept, piece)
+		end
+	end
+	dressing.pieces = kept
+	for i, kind in painted do
+		local look = cells[kind]
+		local props: { CellProp } = (if look then look.props else nil) or {}
+		for _, prop in props do
+			local recipe = Sculpts[prop.sculpt]
+			if recipe and rng:NextNumber() < 1 / math.max(prop.every, 1) then
+				local x, z = Grid.coords(map.grid, i)
+				local wx, wz = Grid.toWorld(x - 0.5 + rng:NextNumber(), z - 0.5 + rng:NextNumber(), cellSize)
+				local range = prop.scale or { 1, 1 }
+				table.insert(dressing.pieces, {
+					look = { name = prop.sculpt, size = recipe.size, sculpt = prop.sculpt },
+					x = wx,
+					z = wz,
+					yaw = rng:NextNumber() * 360,
+					scale = range[1] + (range[2] - range[1]) * rng:NextNumber(),
+					sink = (prop.sink or 0) - ((look :: CellLook).lift or 0),
+					group = `cell:{kind}`,
+				})
+			end
+		end
+	end
+	if draft.effects then
+		local spots = dressing.setPieces or {}
+		for k, e in draft.effects(map, rng) do
+			local x, z = Grid.toWorld(e.x, e.z, cellSize)
+			table.insert(spots, { recipe = e.recipe, seed = e.seed or k, x = x, z = z, lift = e.lift or 0 })
+		end
+		dressing.setPieces = spots
+	end
+	do
+		for _, m in marks do
+			local recipe = Sculpts[m.sculpt]
+			if recipe then
+				local x, z = Grid.toWorld(m.x, m.z, cellSize)
+				table.insert(dressing.pieces, {
+					look = { name = m.sculpt, size = recipe.size, sculpt = m.sculpt },
+					x = x,
+					z = z,
+					yaw = m.yaw or 0,
+					scale = m.scale or 1,
+					sink = m.sink or 0,
+					group = "landmark",
+				})
+			end
+		end
+	end
+	return dressing
+end
+
+return DraftedMap
