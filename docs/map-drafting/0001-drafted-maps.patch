+++ b/tests/systems/DraftedMaps.spec.luau
@@ -0,0 +1,105 @@
+--!strict
+-- Drafted maps (systems/DraftedMap, swarm-lab's maps job): every one is a sound
+-- layout over many seeds, the same for a seed, inside the phone budget once dressed,
+-- and its landmarks are sculpts on its grid. `lune run .swarm/tools/explain
+-- DraftedMaps` (in a swarm worktree) prints which rule a draft breaks.
+local DraftedMap = require("../../src/shared/systems/DraftedMap")
+local DraftedMaps = require("../../src/shared/data/DraftedMaps")
+local MapCost = require("../../src/shared/systems/MapCost")
+local OutdoorTilesets = require("../../src/shared/data/OutdoorTilesets")
+local PerfBudget = require("../../src/shared/data/PerfBudget")
+local Terrain = require("../../src/shared/data/Terrain")
+local TestApi = require("../TestApi")
+local TestRng = require("./TestRng")
+
+local SEEDS = 6
+
+local function rngFor(seed: number): Random
+	return TestRng.seeded(seed) :: any
+end
+
+return function(api: TestApi.Api)
+	local describe, it, expect = api.describe, api.it, api.expect
+
+	describe("DraftedMaps", function()
+		it("names a registered tileset and says what it is", function()
+			for key, draft in DraftedMaps do
+				expect({ key, draft.name }).toEqual({ key, key })
+				expect({ key, OutdoorTilesets[draft.tileset] ~= nil }).toEqual({ key, true })
+				expect({ key, #draft.about > 0 }).toEqual({ key, true })
+			end
+		end)
+
+		it("is the same map for the same seed", function()
+			for key, draft in DraftedMaps do
+				local a, b = draft.generate(rngFor(3)), draft.generate(rngFor(3))
+				expect({ key, a.kinds }).toEqual({ key, b.kinds })
+				expect({ key, a.sites }).toEqual({ key, b.sites })
+			end
+		end)
+
+		it("lays a sound map on every seed", function()
+			for key, draft in DraftedMaps do
+				for seed = 1, SEEDS do
+					local map = draft.generate(rngFor(seed))
+					expect({ key, seed, DraftedMap.problems(map) }).toEqual({ key, seed, {} })
+					if draft.landmarks then
+						local marks = draft.landmarks(map, rngFor(seed))
+						expect({ key, seed, DraftedMap.landmarkProblems(map, marks) }).toEqual({ key, seed, {} })
+					end
+				end
+			end
+		end)
+
+		it("varies with the seed", function()
+			for key, draft in DraftedMaps do
+				local a, b = draft.generate(rngFor(1)), draft.generate(rngFor(2))
+				expect({
+					key,
+					"two seeds give the same map",
+					a.kinds == b.kinds or table.concat(a.kinds :: any) == table.concat(b.kinds :: any),
+				}).toEqual({ key, "two seeds give the same map", false })
+			end
+		end)
+
+		-- A failure here means the map is too heavy for phones once dressed: thin
+		-- what grew rather than raise the budget.
+		it("keeps every seed within the phone budget", function()
+			local budget = PerfBudget.map
+			for key, draft in DraftedMaps do
+				local tileset = OutdoorTilesets[draft.tileset]
+				for seed = 1, SEEDS do
+					local rng = rngFor(seed)
+					local map = draft.generate(rng)
+					local c =
+						MapCost.count(DraftedMap.dress(draft, map, tileset, Terrain.cellSize, rng), tileset, rngFor)
+					local where = `{key} seed {seed}`
+					expect({ where, "parts", c.parts, "of", budget.parts, c.parts <= budget.parts }).toEqual({
+						where,
+						"parts",
+						c.parts,
+						"of",
+						budget.parts,
+						true,
+					})
+					expect({ where, "lights", c.lights, "of", budget.lights, c.lights <= budget.lights }).toEqual({
+						where,
+						"lights",
+						c.lights,
+						"of",
+						budget.lights,
+						true,
+					})
+					expect({ where, "emitters", c.emitters, "of", budget.emitters, c.emitters <= budget.emitters }).toEqual({
+						where,
+						"emitters",
+						c.emitters,
+						"of",
+						budget.emitters,
+						true,
+					})
+				end
