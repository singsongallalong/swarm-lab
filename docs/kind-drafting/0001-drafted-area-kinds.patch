index 0000000..64e1aac
--- /dev/null
+++ b/src/shared/DraftedTypes.luau
@@ -0,0 +1,57 @@
+--!strict
+-- Drafted area kinds: an area look (DrawnEffects.area, kind "Drafted") whose
+-- drawing is a small pure Luau module in systems/drafted, named by the row's
+-- `layout`, instead of a kind hand-wired into the client and the preview.
+-- The game (primitives/AreaFx) and the offline preview (scripts/areapreview)
+-- both draw any such module the same generic way, so a new kind is one module,
+-- one registry line (systems/DraftedKinds) and one row, with no drawing code.
+-- Types live here because data may not require systems.
+--
+-- The contract (enforced by tests/systems/DraftedKinds.spec):
+--   * `plan(look, shape, rng)` rolls everything random once per cast; `pose`
+--     never rolls, so the client can call it every frame and get the same cast.
+--   * `pose(look, shape, plan, age, color)` returns exactly `count(look)`
+--     pieces, the same shapes in the same order at every age and every power,
+--     because the client lends that many parts once and re-poses them by index.
+--   * A piece that isn't showing yet, or any more, has `transparency` 1. At
+--     `lasts(look, shape)` and after, every piece has.
+--   * `count(look)` is the look's whole part cost and stays within
+--     PerfBudget.castEffects.parts, the same at every power (SE3).
+--   * Pieces stay near the area (within its radius plus 2 studs across, and
+--     between 4 studs under the ground, for pieces rising out of it, and 12
+--     studs above it).
+--   * Pure (CLAUDE.md rule 4): no game, no Instances, no task, no yielding.
+--
+-- The frame: studs from the area's origin (where it's centred: the caster for
+-- an area at the caster), as CFrame.lookAt(origin, origin + aim) faces a part:
+-- +X is the aim's right, +Y is up, -Z is ahead along the aim. So an area point
+-- { f, r } (AreaLayout.Point) at height y is the position { r, y, -f }.
+local SculptTypes = require("./SculptTypes")
+local SkillTypes = require("./SkillTypes")
+
+export type Piece = {
+	shape: SculptTypes.Shape,
+	size: { number }, -- x, y, z in studs
+	position: { number }, -- centre, in the frame above
+	rotation: SculptTypes.Rotation, -- 3x3 row-major, CFrame order
+	color: { number }, -- 0-255 RGB
+	material: string, -- an Enum.Material name: "Neon" glows, "SmoothPlastic" doesn't
+	transparency: number, -- 0 solid to 1 gone
+}
+
+-- Where and when the look bursts its `emitter` (as AreaBursts.Burst): `f`, `r`
+-- an area point, `y` its height, `at` seconds after the look starts, `scale`
+-- the burst's scale. Without a `bursts` function, one burst at the origin at
+-- once, at scale 0.5.
+export type Burst = { at: number, f: number, r: number, y: number, scale: number }
+
+export type Layout = {
+	about: string,
+	count: (look: any) -> number,
+	lasts: (look: any, shape: SkillTypes.AreaShape) -> number,
+	plan: (look: any, shape: SkillTypes.AreaShape, rng: Random) -> any,
+	pose: (look: any, shape: SkillTypes.AreaShape, plan: any, age: number, color: { number }) -> { Piece },
+	bursts: ((look: any, shape: SkillTypes.AreaShape, plan: any) -> { Burst })?,
+}
+
+return nil
