+-- A drafted kind (DraftedTypes): its own module poses every piece; the parts
+-- are lent once, by the shapes its first pose gives (the contract keeps them
+-- the same at every age), and re-posed by index each frame until it ends, as
+-- Flames and Volley are. Nothing here knows any one drafted kind.
+local function drafted(frame: CFrame, shape: AreaShape, look: DrawnEffects.Drafted, color: Color3, rng: Random)
+	local layout = DraftedKinds[look.layout]
+	if layout == nil then
+		warn(`AreaFx: no drafted kind "{look.layout}" in DraftedKinds`)
+		return
+	end
+	local hue = { math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255) }
+	local plan = layout.plan(look, shape, rng)
+	local lasts = layout.lasts(look, shape)
+	local parts: { BasePart } = {}
+	local materials: { string } = {}
+	for _, piece in layout.pose(look, shape, plan, 0, hue) do
+		local style = Styles.neon(rgb(piece.color), 1)
+		local part = if piece.shape == "Wedge"
+			then Draw.wedge(frame, Vector3.one, style)
+			elseif piece.shape == "Ball" then Draw.ball(frame.Position, 0.5, style)
+			elseif piece.shape == "Cylinder" then Draw.beam(
+				frame.Position,
+				frame.Position + Vector3.xAxis,
+				1,
+				style
+			)
+			else Draw.panel(frame, Vector3.one, style)
+		table.insert(parts, part)
+		table.insert(materials, "Neon")
+	end
+	local start = os.clock()
+	local function step()
+		local age = os.clock() - start
+		if age >= lasts then
+			Draw.clear(parts)
+			return
+		end
+		for i, piece in layout.pose(look, shape, plan, age, hue) do
+			local part = parts[i]
+			if part == nil then
+				continue
+			end
+			if piece.transparency >= 1 then
+				part.Transparency = 1
+				continue
+			end
+			local r, q = piece.rotation, piece.position
+			part.Size = Vector3.new(piece.size[1], piece.size[2], piece.size[3])
+			part.CFrame = frame * CFrame.new(q[1], q[2], q[3], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9])
+			part.Color = rgb(piece.color)
+			part.Transparency = piece.transparency
+			-- Set only when it changes: an Enum lookup a frame per part adds up.
+			if materials[i] ~= piece.material then
+				materials[i] = piece.material
+				part.Material = (Enum.Material :: any)[piece.material] or Enum.Material.SmoothPlastic
+			end
+		end
+		task.delay(1 / 30, step)
+	end
+	step()
+end
+
 -- Draws look `name` over `shape` lying on the ground at `ground`, aimed at
 -- `toward`, grown for the skill's `power` (EffectPower). `rng` defaults to a
 -- fresh one; pass a seeded one to repeat a look.
@@ -497,6 +560,8 @@ function AreaFx.draw(
