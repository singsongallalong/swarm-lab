+--!strict
+-- A drafted area kind (DraftedTypes), and the reference for writing one:
+-- shards of the skill's colour erupting out of the ground ring by ring from
+-- the origin to the area's edge, leaning out, rising fast, holding, then
+-- sinking and fading, with a flash at the origin as it starts. Pure: `plan`
+-- rolls the scatter once, `pose` places every piece at any age.
+--
+-- Row fields (DrawnEffects.area, kind "Drafted", layout "ShardBloom"):
+--   shards  how many shards (each one part)
+--   height  studs, a shard's height at the edge (nearer ones are shorter)
+--   width   studs, a shard's footprint
+--   lean    degrees each shard leans away from the origin
+--   travel  studs/s the eruption runs outward
+--   rise    seconds a shard takes to come up
+--   hold    seconds it stands
+--   fade    seconds it takes to sink and fade
+--   glow    0-1, how far the shards' colour runs toward white
+local AreaLayout = require("../AreaLayout")
+local DraftedTypes = require("../../DraftedTypes")
+local SculptMath = require("../SculptMath")
+local SkillTypes = require("../../SkillTypes")
+
+type Piece = DraftedTypes.Piece
+type AreaShape = SkillTypes.AreaShape
+
+type Shard = { f: number, r: number, heading: number, scale: number, at: number, spin: number }
+type Plan = { shards: { Shard } }
+
+local ShardBloom = {}
+
+ShardBloom.about = "Shards erupting ring by ring from the origin to the edge, leaning out, then sinking."
+
+local function mix(a: { number }, b: { number }, t: number): { number }
+	return {
+		math.round(a[1] + (b[1] - a[1]) * t),
+		math.round(a[2] + (b[2] - a[2]) * t),
+		math.round(a[3] + (b[3] - a[3]) * t),
+	}
+end
+
+function ShardBloom.count(look: any): number
+	-- One part a shard, plus the flash.
+	return math.floor(look.shards) + 1
+end
+
+function ShardBloom.lasts(look: any, shape: AreaShape): number
+	-- The furthest shard starts as the eruption reaches the edge.
+	return shape.radius / look.travel + look.rise + look.hold + look.fade
+end
+
+function ShardBloom.plan(look: any, shape: AreaShape, rng: Random): Plan
+	local half = AreaLayout.halfAngle(shape)
+	local shards: { Shard } = {}
+	local n = math.floor(look.shards)
+	for i = 1, n do
+		-- Spread evenly round the area's width, nudged so it doesn't look ruled.
+		local heading = -half + (2 * half) * ((i - 0.5) / n) + rng:NextNumber(-0.15, 0.15)
+		-- Further out the later in the list, so the eruption runs outward.
+		local d = shape.radius * (0.25 + 0.75 * math.sqrt(rng:NextNumber(0.05, 1)))
+		local p = { f = math.cos(heading) * d, r = math.sin(heading) * d }
+		table.insert(shards, {
+			f = p.f,
+			r = p.r,
+			heading = heading,
+			scale = 0.5 + 0.5 * d / shape.radius,
+			at = d / look.travel,
+			spin = rng:NextNumber(0, 360),
+		})
+	end
+	return { shards = shards }
+end
+
+-- How far up a shard is, 0 to 1, and how solid, at `t` seconds after its start.
+local function stage(look: any, t: number): (number, number)
+	if t < 0 then
+		return 0, 0
+	end
+	if t < look.rise then
+		local k = t / look.rise
+		return 1 - (1 - k) * (1 - k), 1
+	end
+	t -= look.rise
+	if t < look.hold then
+		return 1, 1
+	end
+	t -= look.hold
+	if t < look.fade then
+		local k = t / look.fade
+		return 1 - 0.6 * k, 1 - k
+	end
+	return 0, 0
+end
+
+function ShardBloom.pose(look: any, _shape: AreaShape, plan: Plan, age: number, color: { number }): { Piece }
+	local out: { Piece } = {}
+	local bright = mix(color, { 255, 255, 255 }, look.glow)
+	for _, s in plan.shards do
+		local up, solid = stage(look, age - s.at)
+		local h = look.height * s.scale
+		-- Twist about its own axis, lean ahead (-Z), then turn ahead onto the
+		-- shard's heading, so it leans away from the origin.
+		local turn = SculptMath.mul(
+			SculptMath.rotY(-math.deg(s.heading)),
+			SculptMath.mul(SculptMath.rotX(-look.lean), SculptMath.rotY(s.spin))
+		)
+		local centreY = h * (up - 0.5)
+		table.insert(out, {
+			shape = "Wedge",
+			size = { look.width, math.max(h, 0.05), look.width },
+			position = { s.r, centreY, -s.f },
+			rotation = turn,
+			color = bright,
+			material = "SmoothPlastic",
+			transparency = if solid > 0 then 1 - 0.85 * solid else 1,
+		})
+	end
+	-- The flash at the origin: a flat disc, bright for a moment.
+	local flash = if age < 0.12 then 1 - age / 0.12 else 0
+	table.insert(out, {
+		shape = "Cylinder",
+		size = { 0.2, 3, 3 },
+		position = { 0, 0.1, 0 },
+		rotation = SculptMath.rotZ(90),
+		color = mix(color, { 255, 255, 255 }, 0.7),
+		material = "Neon",
+		transparency = if flash > 0 then 1 - 0.8 * flash else 1,
+	})
+	return out
+end
+
+function ShardBloom.bursts(_look: any, _shape: AreaShape, plan: Plan): { DraftedTypes.Burst }
+	-- A puff at every fourth shard as it breaks the ground.
+	local out: { DraftedTypes.Burst } = {}
+	for i, s in plan.shards do
+		if i % 4 == 0 then
+			table.insert(out, { at = s.at, f = s.f, r = s.r, y = 0, scale = 0.5 })
+		end
+	end
+	return out
+end
+
+return table.freeze(ShardBloom)
