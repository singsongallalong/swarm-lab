+--!strict
+-- Every drafted area kind keeps the contract in DraftedTypes, over every
+-- DrawnEffects.area row that names one, at power 0 and the top power, over a
+-- circle and a cone, from start to past its end.
+local DraftedKinds = require("../../src/shared/systems/DraftedKinds")
+local DrawnEffects = require("../../src/shared/data/DrawnEffects")
+local EffectPower = require("../../src/shared/systems/EffectPower")
+local EffectPowerRules = require("../../src/shared/data/EffectPower")
+local Emitters = require("../../src/shared/data/Emitters")
+local PerfBudget = require("../../src/shared/data/PerfBudget")
+local TestApi = require("../TestApi")
+local TestRng = require("./TestRng")
+
+local SHAPES: { any } = {
+	{ type = "Circle", radius = 8 },
+	{ type = "Cone", radius = 14, angle = 70 },
+	{ type = "Cone", radius = 14, angle = 18 },
+}
+local SEEDS = { 1, 2, 7 }
+local SHAPE_NAMES = { Block = true, Wedge = true, Cylinder = true, Ball = true }
+
+local function rows(): { { name: string, row: any } }
+	local out = {}
+	for name, row in DrawnEffects.area do
+		if row.kind == "Drafted" then
+			table.insert(out, { name = name, row = row })
+		end
+	end
+	table.sort(out, function(a, b)
+		return a.name < b.name
+	end)
+	return out
+end
+
+-- The ages to check: from the start to just past the end, fine enough to
+-- catch a piece that appears or vanishes.
+local function ages(lasts: number): { number }
+	local out = {}
+	for k = 0, 40 do
+		table.insert(out, lasts * 1.05 * k / 40)
+	end
+	return out
+end
+
+return function(api: TestApi.Api)
+	local describe, it, expect = api.describe, api.it, api.expect
+
+	describe("DraftedKinds", function()
+		it("lists only modules that keep the shape of the contract", function()
+			for name, layout in DraftedKinds do
+				expect(type(layout.about) == "string" and #layout.about > 0).toBe(true)
+				for _, fn in { "count", "lasts", "plan", "pose" } do
+					if type((layout :: any)[fn]) ~= "function" then
+						error(`{name} has no {fn} function`)
+					end
+				end
+			end
+		end)
+
+		it("gives every drafted row a listed layout, an about, and a real emitter", function()
+			for _, r in rows() do
+				if DraftedKinds[r.row.layout] == nil then
+					error(`{r.name} names layout "{r.row.layout}", which DraftedKinds doesn't list`)
+				end
+				expect(#r.row.about > 0).toBe(true)
+				if r.row.emitter ~= nil and Emitters[r.row.emitter] == nil then
+					error(`{r.name} bursts "{r.row.emitter}", which isn't an Emitters row`)
+				end
+			end
+		end)
+
+		it("keeps its count fixed, its pieces the same shapes in order, within the budget, at every power", function()
+			for _, r in rows() do
+				local layout = DraftedKinds[r.row.layout]
+				local count: number? = nil
+				for _, power in { 0, EffectPowerRules.top } do
+					local look = EffectPower.apply(r.row, r.row.perPower, power)
+					local n = layout.count(look)
+					if count == nil then
+						count = n
+					elseif n ~= count then
+						error(`{r.name}: count {count} at power 0 but {n} at power {power} (SE3: grow, never multiply)`)
+					end
+					if n > PerfBudget.castEffects.parts then
+						error(`{r.name}: {n} parts, over the cast budget of {PerfBudget.castEffects.parts}`)
+					end
+					for _, shape in SHAPES do
+						local plan = layout.plan(look, shape, TestRng.seeded(1) :: any)
+						local shapes: { string }? = nil
+						for _, age in ages(layout.lasts(look, shape)) do
+							local pieces = layout.pose(look, shape, plan, age, { 170, 225, 255 })
+							if #pieces ~= n then
+								error(`{r.name}: {#pieces} pieces at {age} s, but count says {n}`)
+							end
+							local now = {}
+							for i, p in pieces do
+								if not SHAPE_NAMES[p.shape] then
+									error(`{r.name}: piece {i} has shape "{p.shape}"`)
+								end
+								now[i] = p.shape
+							end
+							if shapes == nil then
+								shapes = now
+							else
+								for i, s in now do
+									if (shapes :: { string })[i] ~= s then
+										error(
+											`{r.name}: piece {i} changes shape from {(shapes :: { string })[i]} to {s} at {age} s`
+										)
+									end
+								end
+							end
+						end
+					end
+				end
+			end
+		end)
+
+		it("poses well-formed pieces near the area, and is gone by its end", function()
+			for _, r in rows() do
+				local layout = DraftedKinds[r.row.layout]
+				for _, power in { 0, EffectPowerRules.top } do
+					local look = EffectPower.apply(r.row, r.row.perPower, power)
+					for _, shape in SHAPES do
+						local plan = layout.plan(look, shape, TestRng.seeded(1) :: any)
+						local lasts = layout.lasts(look, shape)
+						if not (lasts > 0 and lasts <= 3) then
+							error(`{r.name}: lasts {lasts} s; a look must end within 3 s`)
+						end
+						for _, age in ages(lasts) do
+							for i, p in layout.pose(look, shape, plan, age, { 170, 225, 255 }) do
+								local where = `{r.name}, piece {i}, {age} s, power {power}, radius {shape.radius}`
+								if not (p.transparency >= 0 and p.transparency <= 1) then
+									error(`{where}: transparency {p.transparency}`)
+								end
+								if #p.size ~= 3 or #p.position ~= 3 or #p.rotation ~= 9 or #p.color ~= 3 then
+									error(`{where}: size, position, rotation or colour has the wrong length`)
+								end
+								if age >= lasts and p.transparency < 1 then
+									error(`{where}: still showing after lasts`)
+								end
+								if p.transparency < 1 then
+									local x, y, z = p.position[1], p.position[2], p.position[3]
+									if math.sqrt(x * x + z * z) > shape.radius + 2 then
+										error(`{where}: {math.sqrt(x * x + z * z)} studs out, past the area`)
+									end
+									if y < -4 or y > 12 then
+										error(`{where}: {y} studs up (SE10: keep clear of the camera)`)
+									end
+									for _, s in p.size do
+										if s < 0 or s > 2 * shape.radius + 4 then
+											error(`{where}: size {s}`)
+										end
+									end
+								end
+							end
+						end
+					end
+				end
+			end
+		end)
+
+		it("poses the same cast from the same seed, so every client draws it alike", function()
+			for _, r in rows() do
+				local layout = DraftedKinds[r.row.layout]
+				for _, seed in SEEDS do
+					local shape = SHAPES[2]
+					local a = layout.pose(
+						r.row,
+						shape,
+						layout.plan(r.row, shape, TestRng.seeded(seed) :: any),
+						0.2,
+						{ 1, 2, 3 }
+					)
+					local b = layout.pose(
+						r.row,
+						shape,
+						layout.plan(r.row, shape, TestRng.seeded(seed) :: any),
+						0.2,
+						{ 1, 2, 3 }
+					)
+					for i = 1, #a do
+						for k = 1, 3 do
+							expect(a[i].position[k]).toBeNear(b[i].position[k], 1e-9)
+						end
+					end
+				end
+			end
+		end)
+	end)
+end
