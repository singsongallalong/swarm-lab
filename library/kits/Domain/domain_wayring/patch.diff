@@ -941,4 +941,37 @@ Sculpts.parish_bell_tower = {
 	maxPrims = 34,
 }
 
+-- The Eternal Domain (roadmap areas/eternal-domain.md): the waystones that
+-- lead a run through its halls. A ring of tall marble pillars round a dais,
+-- one fallen and the rest standing at their own heights, and a gilded head
+-- stone to set in the ring's middle or to stand in a line down a hall. A
+-- person is 5 studs: the ring's stones stand five to six people tall.
+Sculpts.domain_wayring = {
+	kind = "waystones",
+	-- Wide enough for nine pillars to read as a ring from the game camera,
+	-- and for the one that has fallen to lie clear of the walk between them.
+	size = { 36, 28, 4.2 },
+	material = "Marble",
+	-- Warm ivory to pale marble, the shaded tone darkest: two or three stone
+	-- tones make the pillars read one against another.
+	colors = { { 232, 224, 208 }, { 219, 213, 199 }, { 201, 195, 183 } },
+	maxPrims = 12,
+	stones = 9,
+}
+-- The head stone of a ring, or the stones of a line: a tall marble monolith
+-- with a gilded band round it near the crown and a gold ribbon hanging from
+-- the knot, and its fallen stones heaped at the foot. Seeds lean it a little
+-- differently, set its cap and ribbon askew and move the heap.
+Sculpts.domain_waystone = {
+	kind = "marker",
+	-- Wider than the ring's stones, so the gold band reads from the high camera.
+	size = { 6.5, 30, 4.5 },
+	material = "Marble",
+	colors = { { 232, 224, 208 }, { 219, 213, 199 } },
+	-- Gold trim against the ivory: saturation 0.52, value 0.90, inside the
+	-- domain's limit (gold is trim and crown, never a whole surface).
+	accent = { 230, 190, 110 },
+	maxPrims = 9,
+}
+
 return table.freeze(Sculpts)
