+-- The Eternal Domain's sacred tree: a pale marble trunk standing perfect and
+-- upright out of the cloud, its boughs gilded in tiers (the bible's gold as
+-- crown, not surface). Three rows give the dungeon whole and broken, taller
+-- and shorter; each seed turns the boughs differently.
+Sculpts.domain_gold_tree = {
+	kind = "tree",
+	size = { 28, 32, 28 },
+	material = "Marble",
+	colors = { { 233, 226, 212 }, { 219, 212, 200 }, { 205, 198, 187 }, { 231, 190, 112 }, { 212, 172, 98 } },
+	maxPrims = 88,
+	segments = 5,
+	branches = 18,
+	bend = 6,
+}
+-- A younger tree of the same grove: shorter and narrower, its crown starting
+-- lower, so a hall's planting isn't one stamp.
+Sculpts.domain_gold_tree_low = {
+	kind = "tree",
+	size = { 20, 22, 20 },
+	material = "Marble",
+	colors = { { 233, 226, 212 }, { 219, 212, 200 }, { 205, 198, 187 }, { 231, 190, 112 }, { 212, 172, 98 } },
+	maxPrims = 60,
+	segments = 5,
+	branches = 10,
+	bend = 9,
+}
+-- A sacred tree broken off part way up: the domain's one wound, its gilt
+-- crown cut short, still standing.
+Sculpts.domain_gold_tree_broken = {
+	kind = "tree",
+	size = { 18, 24, 18 },
+	material = "Marble",
+	colors = { { 233, 226, 212 }, { 219, 212, 200 }, { 205, 198, 187 }, { 231, 190, 112 }, { 212, 172, 98 } },
+	maxPrims = 48,
+	segments = 5,
+	branches = 7,
+	bend = 13,
+	snapped = true,
+}
+
 return table.freeze(Sculpts)
