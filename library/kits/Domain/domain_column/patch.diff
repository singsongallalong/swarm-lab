--- a/src/shared/data/Sculpts.luau
+++ b/src/shared/data/Sculpts.luau
@@ -940,5 +940,45 @@ Sculpts.parish_bell_tower = {
 	accent = PARISH_MOSS,
 	maxPrims = 34,
 }
+-- The Eternal Domain (roadmap areas/eternal-domain.md), a TRIAL kit for
+-- swarm-lab's smoke test (2026-10-30): the colonnade column of the gods.
+-- Pale ivory marbles under the trial's stone cap (value 0.75-0.92, saturation
+-- 0.05-0.20): a light, a mid and a shaded tone, so the drums and the facets
+-- read against each other from the game camera (bible §2, A005: plain parts
+-- this size lose their facets and read flat in one tone).
+-- The whole column: four marble drums in a square pier, turned a little
+-- against each other so the joints catch the light as flutes, and a crown
+-- of four roughened blocks where the builder's hammer left off. `jag` keeps
+-- the drums hand-cut, never level, and the caps change with the seed, so no
+-- two columns in a colonnade are quite the same.
+Sculpts.domain_column = {
+	kind = "columns",
+	size = { 8, 50, 7 },
+	material = "Marble",
+	colors = { { 228, 219, 198 }, { 210, 201, 182 }, { 194, 187, 170 } },
+	maxPrims = 30,
+	columns = 2,
+	jag = 0.08,
+}
+-- The snapped column: the same pier broken across, the tall side standing
+-- and the rest stepped down to a stump, its fallen stones heaped at the
+-- foot. Seeds turn the break to a new side, so a run of them never breaks
+-- the same way twice (the direction's "some seeds ... snapped").
+Sculpts.domain_column_broken = {
+	kind = "tower",
+	size = { 9, 52, 4.5 },
+	material = "Marble",
+	colors = { { 228, 219, 198 }, { 210, 201, 182 }, { 194, 187, 170 } },
+	maxPrims = 24,
+}
+-- The drum that lies beside a broken one: squared marble blocks of the
+-- fallen shaft, one set down across the others, in the three stone tones.
+Sculpts.domain_column_fallen = {
+	kind = "blocks",
+	size = { 5, 2.6, 3.6 },
+	material = "Marble",
+	colors = { { 228, 219, 198 }, { 210, 201, 182 }, { 194, 187, 170 } },
+	maxPrims = 8,
+}
 
 return table.freeze(Sculpts)
