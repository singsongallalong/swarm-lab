+-- The Eternal Domain (trial): the gods' spire. Pale ivory marble in tiers,
+-- each tier ringed and crowned in gold; a pale sky-blue light in the doorway
+-- and the belfry's gold bell under the gold finial. Slender at 84 studs, many
+-- times a man's height, so it stands over a hall as the domain's landmark.
+Sculpts.domain_spire = {
+	kind = "belltower",
+	size = { 13, 84, 13 },
+	material = "Marble",
+	-- Gold trim, ivory walls, the doorway's cool light, the gold bell.
+	colors = { { 234, 182, 117 }, { 234, 226, 210 }, { 171, 193, 230 }, { 230, 172, 110 } },
+	materials = { [1] = "Metal", [2] = "Marble", [3] = "Neon", [4] = "Metal" },
+	-- A richer gold on the base and crown: the brief's accent, to 0.75.
+	accent = { 234, 150, 60 },
+	maxPrims = 36,
+}
+-- The lesser spire: the same ivory tiers and gold rings, still slender, at the
+-- height of a great hall's roof, so a tall crown and a low one stand together.
+Sculpts.domain_spire_lesser = {
+	kind = "belltower",
+	size = { 10, 58, 10 },
+	material = "Marble",
+	colors = { { 234, 182, 117 }, { 234, 226, 210 }, { 171, 193, 230 }, { 230, 172, 110 } },
+	materials = { [1] = "Metal", [2] = "Marble", [3] = "Neon", [4] = "Metal" },
+	accent = { 234, 150, 60 },
+	maxPrims = 36,
+}
+
 return table.freeze(Sculpts)
