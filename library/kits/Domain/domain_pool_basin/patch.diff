+-- The Eternal Domain (a trial, 2026-10-30): the kit's pool of light. A wide,
+-- low ring of pale marble, its broken rim stepped, with still water in it that
+-- glows gold: white stone and gold that glows, the domain's look in one prop.
+-- The tower kind is the kit's only round shell; at this height its base flare
+-- is the step up to the rim, and its seeded breaks read as ruin.
+Sculpts.domain_pool_basin = {
+	kind = "tower",
+	size = { 30, 4.2, 2.4 },
+	material = "Marble",
+	colors = { { 230, 222, 205 }, { 222, 213, 196 }, { 211, 202, 186 } },
+	maxPrims = 30,
+}
+-- Still water at the basin's foot: gold, so the pool is its own light. The
+-- darkest gold is the water's depth, the pale one its sheen.
+Sculpts.domain_pool_water = {
+	kind = "pool",
+	size = { 21, 0.1, 21 },
+	material = "Neon",
+	colors = { { 234, 202, 118 }, { 214, 178, 100 } },
+	reflectance = 0.35,
+	maxPrims = 4,
+}
+
 return table.freeze(Sculpts)
