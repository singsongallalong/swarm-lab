@@ -941,4 +941,41 @@ Sculpts.parish_bell_tower = {
 	maxPrims = 34,
 }
 
+-- The Eternal Domain (roadmap areas/eternal-domain.md): the game's opposite
+-- to the moor, pale stone and gold under holy light. A triumphal arch to
+-- span a hall: warm ivory piers in three stone tones, gilded stones through
+-- them and a gold keystone (the arch kind always crowns with the last
+-- colour). One material for the whole row is all the arch kind takes, so the
+-- gold is carried in colour on marble. The light that runs through the
+-- passage is its own set piece, domain_arch_light.
+Sculpts.domain_triumphal_arch = {
+	kind = "arch",
+	size = { 30, 32, 7 },
+	material = "Marble",
+	colors = { { 232, 221, 196 }, { 216, 208, 194 }, { 203, 193, 172 }, { 231, 190, 110 } },
+	maxPrims = 12,
+	span = 16,
+}
+-- The same order, taller and narrower, for a high vault or a doorway the
+-- procession passes through one at a time.
+Sculpts.domain_triumphal_arch_high = {
+	kind = "arch",
+	size = { 26, 35, 6.5 },
+	material = "Marble",
+	colors = { { 232, 221, 196 }, { 216, 208, 194 }, { 203, 193, 172 }, { 231, 190, 110 } },
+	maxPrims = 12,
+	span = 13.5,
+}
+-- The arch broken: one pier's crown, a lintel stone and the gold keystone
+-- thrown down beside it (the arch kind's snapped form).
+Sculpts.domain_triumphal_arch_ruined = {
+	kind = "arch",
+	size = { 30, 27, 6.5 },
+	material = "Marble",
+	colors = { { 232, 221, 196 }, { 216, 208, 194 }, { 203, 193, 172 }, { 231, 190, 110 } },
+	maxPrims = 12,
+	span = 15,
+	snapped = true,
+}
+
 return table.freeze(Sculpts)
