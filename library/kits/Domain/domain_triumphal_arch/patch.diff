+				wiggle = { amplitude = 0.3, span = 40, periods = { 4.3, 2.9 } },
+			},
+			priority = 1,
+		},
+		{
+			-- The core's bloom, spilled wide on the marble: what the high
+			-- camera reads as the path of light, where the thin core is a wire.
+			name = "spill",
+			look = { kind = "neon", width = 2.4, segment = 3, transparency = 0.5, color = "glow" },
+			motion = {
+				kind = "flow",
+				wavelength = 20,
+				speed = 8,
+				depth = 0.45,
+				wiggle = { amplitude = 0.3, span = 40, periods = { 4.3, 2.9 } },
+			},
+			priority = 2,
+		},
+		{
+			name = "motes",
+			look = {
+				kind = "stream",
+				every = 12,
+				thick = 2.5,
+				lift = 0.2,
+				toward = "up",
+				rise = 1.7,
+				life = { 2.5, 3.6 },
+				rate = 3,
+				size = 2.4,
+				tall = 1.8,
+				transparency = 0.45,
+				color = "gold",
+				texture = "wisp",
+				lean = 7,
+				vary = 0.5,
+			},
+			motion = { kind = "sway", amplitude = 0.6, tilt = 10, span = 18, periods = { 5.3, 7.9 } },
+			priority = 3,
+		},
+		{
+			name = "haze",
+			look = {
+				kind = "stream",
+				every = 24,
+				thick = 7,
+				lift = 1.6,
