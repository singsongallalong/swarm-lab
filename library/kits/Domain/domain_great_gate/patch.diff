+		{ width = 23, depth = 16, rise = 2, steps = 1 },
+	},
+}
+-- The wide gate of a great hall: the same door and crown stretched across a
+-- broad frontage, on two shallow tiers.
+Sculpts.domain_gate_broad = {
+	kind = "gate",
+	size = { 52, 38, 32 },
