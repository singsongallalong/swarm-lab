+-- The gate a lesser hall gets: lower and narrower, on three stepped tiers,
+-- so its door reads smaller under the same ivory and gold crown.
+Sculpts.domain_gate_low = {
+	kind = "gate",
+	size = { 34, 38, 26 },
+	material = "Marble",
+	colors = { { 234, 224, 198 }, { 206, 194, 170 }, { 228, 188, 104 }, { 234, 196, 108 } },
