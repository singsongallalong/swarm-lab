@@ -0,0 +1,493 @@
+--!strict
+-- The throne of the absent god (map feature, docs/guides/map-features.md): a raised
+-- terrace of ivory stone on the Eternal Domain's cloud, cut by a chasm of cloud. A
+-- bridge crosses the chasm to a throne island; on it a colossal empty throne stands on
+-- a stepped dais, flanked by kneeling statues, gold lamps and banners. The god is gone;
+-- the light is not: a pillar of gold light falls on the empty seat (domain_throne_glory).
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first,
+-- then look). The first draws choose the structure, the rest only dress it:
+--   1. the plan: a straight chasm, a crescent chasm (the island bulges into the
+--      forecourt), cloud wings that cut the island free on three sides, or a cloud bay
+--      eaten out of the island's flank;
+--   2. the crossing: one, two or three causeways over the cloud, the road on the first;
+--   3. the dais: round, square, long or two-level;
+--   4. the footprint's size, the terrace's height and the chasm's depth;
+--   5. then the setting: the court's stone, the kneeling statues (2 or 4), the banners
+--      and the lamps, and the light on the seat.
+-- Everything stands on the domain's own kit and the new domain_ sculpts of this run.
+local FeatureDress = require("../FeatureDress")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local PLANS = { "straight", "crescent", "wings", "bay" }
+local DAISES = { "round", "square", "long", "split" }
+
+-- The ground the feature paints, inside B12's stone limits and the area's own
+-- materials, so Roblox's one colour per terrain material holds: the cloud is the
+-- Domain's own bank colour (Domain.luau CLOUD), the dais its paving, the rim its
+-- flags, the curb its body — and the court a cool pale slate the area leaves free.
+local CLOUD = { material = "Snow", color = { 232, 229, 222 } }
+local COURT = { material = "Slate", color = { 200, 196, 190 } }
+local DAIS = { material = "Marble", color = { 214, 208, 194 } }
+local RIM = { material = "Limestone", color = { 202, 194, 178 } }
+local CURB = { material = "Sandstone", color = { 196, 186, 166 } }
+
+-- The throne's seat height over its ground, for the light's marker and the cameras.
+local SEAT = 10
+
+local feature: MapFeature.Feature = {
+	name = "DomainThrone",
+	about = "A raised ivory terrace on a chasm of cloud: a bridge to a throne island where a colossal empty throne stands on a stepped dais under falling gold light, flanked by kneeling statues, lamps and banners.",
+	tileset = "domain",
+	scale = "centrepiece",
+	role = "centrepiece",
+	mood = { "monumental", "holy", "empty", "cloud-wrapped" },
+	cells = {
+		-- A lift of 0.2 on every painted kind, so no painted surface is coplanar with
+		-- the tileset's ground beneath it.
+		cloud = { ground = CLOUD, lift = 0.2, clear = true },
+		court = { ground = COURT, lift = 0.2, clear = true },
+		dais = { ground = DAIS, lift = 0.2, clear = true },
+		rim = { ground = RIM, lift = 0.2, clear = true },
+		curb = { ground = CURB, lift = 0.2, clear = true },
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-3: the structure, first.
+		local plan = PLANS[whole(rng, 1, #PLANS)]
+		local daisShape = DAISES[whole(rng, 1, #DAISES)]
+		local crossings = whole(rng, 1, 3)
+		-- 4: the whole's size, the terrace's height and the chasm's depth.
+		local w = whole(rng, 40, 48)
+		local d = whole(rng, 50, 56)
+		local level = 2 * whole(rng, 4, 6)
+		local steps = level // 2
+		local chasm = -2 * whole(rng, 6, 8)
+		local moatWidth = whole(rng, 5, 7)
+		local bow = if plan == "crescent" then whole(rng, 2, 4) else 0
+		local inset = whole(rng, 4, 7)
+		local wingLeft, wingRight = inset, w - inset + 1
+		local cx = (w + 1) / 2
+		-- The game camera's own ground row over the feature's middle (FeaturePad's
+		-- shot, pitch 50, 35 studs back): the island reaches it, so the camera stands
+		-- on the throne terrace and looks at the dais, never into the cloud.
+		local camZ = math.floor(d / 2 + 5.625) + 1
+		-- The island's south edge: at the camera, leaving the forecourt and its stair
+		-- the rest of the depth.
+		local most = math.min(camZ + 2, d - steps - 6 - moatWidth)
+		local islandSouth = whole(rng, math.min(camZ, most), most)
+		local frontZ = islandSouth + moatWidth
+
+		local n = w * d
+		local walk: { boolean } = table.create(n, true)
+		local heights: { number } = table.create(n, level)
+		local kinds: { [number]: string } = {}
+		local lifts: { [number]: number } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		local function inside(x: number, z: number): boolean
+			return x >= 2 and x <= w - 1 and z >= 2 and z <= d - 1
+		end
+
+		-- The plateau's rim: a curb of stone two studs over the terrace, so the
+		-- walkable border is only ever the stairs' mouths.
+		for z = 1, d do
+			for x = 1, w do
+				if x == 1 or z == 1 or x == w or z == d then
+					walk[at(x, z)] = false
+					heights[at(x, z)] = level + 2
+				end
+			end
+		end
+
+		-- The chasm's edge at x: the crescent bows the island out into the forecourt.
+		local function moatFrontAt(x: number): number
+			if plan == "crescent" then
+				local t = (x - cx) / (w * 0.5)
+				return frontZ + math.floor(bow * (1 - t * t) + 0.5)
+			end
+			return frontZ
+		end
+		local function islandSouthAt(x: number): number
+			return moatFrontAt(x) - moatWidth
+		end
+
+		-- The island's bounds, the dais on it, and the flank the road turns around.
+		local il, ir = 2, w - 1
+		if plan == "wings" then
+			il, ir = wingLeft + 1, wingRight - 1
+		end
+		-- The throne stands on the middle line, so the game camera over the feature
+		-- looks straight up the steps at it; a cell either way keeps it from stamped.
+		local camX = math.floor(w / 2) + 1
+		local ix = math.clamp(camX + whole(rng, -1, 1), il + 3, ir - 3)
+		local isle = islandSouthAt(ix)
+		local R = math.min(whole(rng, 6, 9), math.max(5, (isle - 8) // 2))
+		-- The dais's front sits just north of the feature's middle, so the fixed game
+		-- camera looks across the court at its steps, never into its flank.
+		local iz = math.clamp(math.floor(d / 2) - 2 - R + whole(rng, -1, 1), R + 3, math.max(R + 3, isle - R - 1))
+		local top = whole(rng, 7, 10)
+		local mid = math.floor(top * 0.62 * 2 + 0.5) / 2
+		local base = math.floor(top * 0.3 * 2 + 0.5) / 2
+		local throneZ = if daisShape == "split" then iz - 1 else iz
+		local side = if rng:NextNumber() < 0.5 then 1 else -1
+
+		-- The grand stairs, cut through the rim at the front and the back. The back
+		-- one keeps clear of the dais, so the island's floor meets it all round.
+		local sx = whole(rng, 5, w - 5)
+		local exitSide = side
+		local xe = math.clamp(ix + exitSide * (R + 4) + whole(rng, -2, 2), il + 2, ir - 2)
+		if math.abs(xe - ix) <= R + 2 then
+			xe = math.clamp(ix - exitSide * (R + 4), il + 2, ir - 2)
+		end
+
+		-- A cloud bay eaten out of the island's flank, opposite the road's turn.
+		local baySide = -side
+		local bayIn = ix + baySide * (R + 2)
+		local bayZ = iz + whole(rng, -1, 1)
+		local bayHalf = whole(rng, 2, 3)
+
+		-- The crossing: the first causeway leads to the dais, the others flank it,
+		-- and one always joins the back stair to the island.
+		local causeWidth = whole(rng, 3, 5)
+		local centres: { number } = { ix }
+		local offsetSide = side
+		for k = 2, crossings do
+			local c = math.clamp(ix + offsetSide * (k - 1) * whole(rng, 8, 13), il + 2, ir - 2)
+			table.insert(centres, c)
+			offsetSide = -offsetSide
+		end
+		table.insert(centres, xe)
+
+		-- Whether a cell is cloud: the main chasm, the wings' arms, the bay.
+		local function inMoat(x: number, z: number): boolean
+			local f = moatFrontAt(x)
+			if z >= f - moatWidth + 1 and z <= f then
+				return true
+			end
+			if plan == "wings" and z < f - moatWidth + 1 and (x < wingLeft or x > wingRight) then
+				return true
+			end
+			if plan == "bay" and z >= bayZ - bayHalf and z <= bayZ + bayHalf then
+				if baySide > 0 and x > bayIn then
+					return true
+				elseif baySide < 0 and x < bayIn then
+					return true
+				end
+			end
+			return false
+		end
+
+		-- Lay the chasm, then carve the causeways across it.
+		local moat = table.create(n, false)
+		for z = 2, d - 1 do
+			for x = 2, w - 1 do
+				local i = at(x, z)
+				if inMoat(x, z) then
+					moat[i] = true
+					walk[i] = false
+					heights[i] = chasm
+				end
+			end
+		end
+		for _, c in centres do
+			local half = math.floor(causeWidth / 2)
+			for z = 2, d - 1 do
+				for x = c - half, c + (causeWidth - 1 - half) do
+					if x >= 2 and x <= w - 1 then
+						local i = at(x, z)
+						moat[i] = false
+						walk[i] = true
+						heights[i] = level
+					end
+				end
+			end
+		end
+
+		-- The dais: a stepped island of stone with the throne at its heart.
+		local function metric(x: number, z: number): number
+			local dx, dz = x - ix, z - iz
+			if daisShape == "round" then
+				return math.sqrt((dx / R) ^ 2 + (dz / (R * 0.92)) ^ 2)
+			elseif daisShape == "square" then
+				return math.max(math.abs(dx), math.abs(dz)) / R
+			elseif daisShape == "long" then
+				return math.sqrt((dx / (R * 0.7)) ^ 2 + (dz / (R * 1.15)) ^ 2)
+			end
+			return math.sqrt((dx / (R * 0.85)) ^ 2 + (dz / R) ^ 2)
+		end
+		local function tierAt(x: number, z: number): number
+			local m = metric(x, z)
+			local lift = if m <= 0.42 then top elseif m <= 0.72 then mid else base
+			if daisShape == "split" and z < iz then
+				lift += 2.5
+			end
+			return lift
+		end
+		for z = 2, d - 1 do
+			for x = 2, w - 1 do
+				local m = metric(x, z)
+				if m <= 1 then
+					local i = at(x, z)
+					walk[i] = false
+					heights[i] = level
+					kinds[i] = if m <= 0.72 then "dais" else "rim"
+					lifts[i] = tierAt(x, z) + 0.2
+				end
+			end
+		end
+		local throneSink = tierAt(ix, throneZ) + 0.2
+
+		local function stair(atX: number, front: boolean)
+			local z0 = if front then d else 1
+			local dz = if front then -1 else 1
+			for k = 0, steps - 1 do
+				local z = z0 + dz * k
+				for x = atX - 1, atX + 1 do
+					local i = at(x, z)
+					walk[i] = true
+					heights[i] = 2 * (k + 1)
+					moat[i] = false
+					kinds[i] = nil
+				end
+				for _, x in { atX - 2, atX + 2 } do
+					if x >= 1 and x <= w then
+						local i = at(x, z)
+						walk[i] = false
+						heights[i] = level + 2
+						moat[i] = false
+						kinds[i] = nil
+					end
+				end
+			end
+		end
+		stair(sx, true)
+		stair(xe, false)
+
+		-- The road: in from the front border, up the stair, over the causeway, round
+		-- the dais and out across the back border.
+		local road: { Point } = {
+			{ x = sx, z = d },
+			{ x = sx, z = d - steps + 1 },
+			{ x = sx, z = math.max(2, d - steps - 1) },
+			{ x = sx, z = moatFrontAt(sx) + 3 },
+			{ x = ix, z = moatFrontAt(ix) + 2 },
+			{ x = ix, z = isle - 2 },
+			{ x = ix + side * (R + 2), z = iz + R + 1 },
+			{ x = ix + side * (R + 2), z = iz - R - 1 },
+			{ x = xe, z = math.max(steps + 1, iz - R - 3) },
+			{ x = xe, z = steps },
+			{ x = xe, z = 1 },
+		}
+		-- Keep every road point on walkable ground (the layout is sound by
+		-- construction; this is the belt to its braces).
+		for k = 2, #road - 1 do
+			local p = road[k]
+			local cxr, czr = math.floor(p.x + 0.5), math.floor(p.z + 0.5)
+			if not walk[at(math.clamp(cxr, 1, w), math.clamp(czr, 1, d))] then
+				for radius = 1, 6 do
+					local best: Point? = nil
+					for oz = -radius, radius do
+						for ox = -radius, radius do
+							local x, z = cxr + ox, czr + oz
+							if inside(x, z) and walk[at(x, z)] then
+								best = best or { x = x, z = z }
+							end
+						end
+					end
+					if best then
+						p.x, p.z = best.x, best.z
+						break
+					end
+				end
+			end
+		end
+		-- The cells a road band covers, so no painted kind hides the way.
+		local onRoad = table.create(n, false)
+		for k = 2, #road do
+			local a, b = road[k - 1], road[k]
+			local samples = math.max(1, math.ceil(math.max(math.abs(b.x - a.x), math.abs(b.z - a.z)) * 3))
+			for s = 0, samples do
+				local t = s / samples
+				local cxr = math.floor(a.x + (b.x - a.x) * t + 0.5)
+				local czr = math.floor(a.z + (b.z - a.z) * t + 0.5)
+				for _, o in { { 0, 0 }, { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
+					local x, z = cxr + o[1], czr + o[2]
+					if x >= 1 and x <= w and z >= 1 and z <= d then
+						onRoad[at(x, z)] = true
+					end
+				end
+			end
+		end
+
+		-- Paint every cell but the road: the court over the terrace, a warm limestone
+		-- skirt round the dais, the curb over the rim and the stairs' cheeks, the cloud
+		-- in the chasm (the dais was painted above).
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				if kinds[i] == nil then
+					if walk[i] then
+						if not onRoad[i] then
+							kinds[i] = if metric(x, z) <= 1.36 then "rim" else "court"
+						end
+					elseif moat[i] then
+						kinds[i] = "cloud"
+					else
+						kinds[i] = "curb"
+					end
+				end
+			end
+		end
+
+		-- 5: the setting. The throne first, on the dais's crown.
+		local marks: { FeatureDress.Landmark } = {}
+		local effects: { FeatureDress.Effect } = {}
+		local function facing(fx: number, fz: number, tx: number, tz: number): number
+			return -math.deg(math.atan2(tz - fz, tx - fx))
+		end
+		table.insert(marks, {
+			sculpt = "domain_throne_absent",
+			x = ix,
+			z = throneZ,
+			yaw = -90,
+			sink = -throneSink,
+			solid = true,
+		})
+		table.insert(effects, { recipe = "domain_throne_glory", x = ix, z = throneZ, lift = throneSink + SEAT })
+
+		-- Kneeling gods: a pair on the dais's lower step, a second pair nearer the seat.
+		local statues = if rng:NextNumber() < 0.6 then 4 else 2
+		local function statue(offX: number, offZ: number)
+			local x, z = ix + offX, iz + offZ
+			local cxr, czr = math.floor(x + 0.5), math.floor(z + 0.5)
+			local i = at(cxr, czr)
+			if not inside(cxr, czr) or lifts[i] == nil then
+				return
+			end
+			table.insert(marks, {
+				sculpt = "domain_kneeling_god",
+				x = x,
+				z = z,
+				yaw = facing(x, z, ix, iz),
+				sink = -lifts[i],
+				scale = between(rng, 1.1, 1.3),
+				solid = true,
+			})
+		end
+		statue(-0.62 * R, 0.62 * R)
+		statue(0.62 * R, 0.62 * R)
+		if statues == 4 then
+			statue(-0.5 * R, 0.5 * R)
+			statue(0.5 * R, 0.5 * R)
+		end
+
+		-- Lamps and banners on the open stone: candidates filtered by the road.
+		local function free(x: number, z: number): boolean
+			local cxr, czr = math.floor(x + 0.5), math.floor(z + 0.5)
+			return inside(cxr, czr) and walk[at(cxr, czr)] and not onRoad[at(cxr, czr)]
+		end
+		local lampSpots: { Point } = {
+			{ x = sx - 3.2, z = d - steps - 1.5 },
+			{ x = sx + 3.2, z = d - steps - 1.5 },
+			{ x = ix - 3.6, z = isle - 2 },
+			{ x = ix + 3.6, z = isle - 2 },
+			{ x = ix - 3.6, z = moatFrontAt(ix) + 4 },
+			{ x = ix + 3.6, z = moatFrontAt(ix) + 4 },
+		}
+		local lamps = whole(rng, 3, 5)
+		local placedLamps: { Point } = {}
+		for _, p in lampSpots do
+			if #placedLamps >= lamps then
+				break
+			end
+			if free(p.x, p.z) then
+				table.insert(placedLamps, p)
+				table.insert(marks, {
+					sculpt = "domain_throne_lamp",
+					x = p.x,
+					z = p.z,
+					yaw = 0,
+					solid = true,
+				})
+			end
+		end
+		-- Fire in the first lamps, under a phone's emitter share.
+		for k = 1, math.min(3, #placedLamps) do
+			local p = placedLamps[k]
+			table.insert(effects, { recipe = "domain_brazier_fire", x = p.x, z = p.z, lift = 11.2 })
+		end
+
+		local bannerSpots: { Point } = {
+			{ x = sx - 4.8, z = d - steps - 2 },
+			{ x = sx + 4.8, z = d - steps - 2 },
+			{ x = ix - side * 5, z = isle - 2 },
+			{ x = ix - side * 5, z = moatFrontAt(ix) + 4 },
+			{ x = ix - side * 0.7 * R, z = iz - R - 3 },
+			{ x = ix + side * 0.7 * R, z = iz - R - 3 },
+			{ x = 3.5, z = frontZ + 2 },
+			{ x = w - 2.5, z = frontZ + 2 },
+		}
+		local banners = whole(rng, 4, 6)
+		local setBanners = 0
+		for _, p in bannerSpots do
+			if setBanners >= banners then
+				break
+			end
+			if free(p.x, p.z) then
+				setBanners += 1
+				table.insert(marks, {
+					sculpt = "domain_throne_banner",
+					x = p.x,
+					z = p.z,
+					yaw = facing(p.x, p.z, ix, iz),
+					scale = between(rng, 0.9, 1.05),
+				})
+			end
+		end
+
+		-- Up the cloud bridge from the forecourt's landing; and from the island's
+		-- flank, across the dais's steps to the seat.
+		local foreZ = math.max(frontZ + 2, math.min(frontZ + 4, d - steps - 1))
+		local flankX = math.clamp(ix + side * (R + 6), il + 2, ir - 2)
+		local cameras: { MapFeature.Shot } = {
+			{
+				name = "up the cloud bridge",
+				from = { x = ix, z = foreZ, lift = 9 },
+				to = { x = ix, z = throneZ, lift = throneSink + SEAT },
+				fov = 60,
+			},
+			{
+				name = "the empty seat",
+				from = { x = flankX, z = math.clamp(iz + R + 5, steps + 2, isle - 2), lift = 8 },
+				to = { x = ix, z = throneZ, lift = throneSink + SEAT - 2 },
+				fov = 64,
+			},
+		}
+
+		return {
+			width = w,
+			depth = d,
+			walk = walk,
+			heights = heights,
+			kinds = kinds,
+			lifts = lifts,
+			marks = marks,
+			effects = effects,
+			road = road,
+			cameras = cameras,
+		}
+	end,
+}
+
+return feature
