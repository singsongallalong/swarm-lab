@@ -0,0 +1,738 @@
+--!strict
+-- The crystal conservatory of the Eternal Domain: a glasshouse of pale blue glass panes
+-- on a gold frame, beds of gold-leaved exotics inside it, and a fountain of holy light at
+-- its heart. The Domain has colonnades, gold trees, gates and waystone rings out on its
+-- paving; it has no place built to keep anything alive.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30). The first draws
+-- choose the structure; the rest only dress it:
+--   1. the plan: a long nave, a cross with a transept, or twin glasshouses flanking an
+--      open court;
+--   2. the long axis: along the road or across it;
+--   3. the heart: a tiered fountain, a still mirror pool under a gold tree, or a grove of
+--      gold trees round a small fountain;
+--   4. the glass: whole, broken in a bay or two, or a fallen stretch of wall (more ways in);
+--   5. then the footprint's size, the hall's width, the beds' depth, the doors' placement
+--      and the planting.
+-- The house stands on the kit's own stone (domain_bay, domain_glass_vault,
+-- domain_crystal_fountain and domain_gold_frond are its own sculpts), and its fountain
+-- light is its own set piece, domain_crystal_spray.
+local DistanceField = require("../DistanceField")
+local FeatureDress = require("../FeatureDress")
+local Grid = require("../Grid")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local PLANS = { "nave", "cross", "twin" }
+local HEARTS = { "fountain", "mirror", "grove" }
+local STATES = { "whole", "broken", "ruined" }
+
+-- The Domain's own marble and paving, in the colours outdoorTilesets/Domain gives them
+-- (Roblox colours a terrain material once for the whole place), and the pale sky blue of
+-- its glass, kept under B12's surface limit (value 0.92).
+local FLOOR = { material = "Marble", color = { 214, 208, 194 } }
+local COURT = { material = "Pavement", color = { 226, 212, 184 } }
+local BED = { material = "Cobblestone", color = { 172, 160, 134 } }
+local GLASS = { material = "Slate", color = { 190, 198, 214 } }
+local WATER = { material = "Ice", color = { 178, 198, 226 } }
+local PLINTH = { material = "Sandstone", color = { 196, 186, 166 } }
+-- The domain theme's glow: the light the glass holds.
+local HOLY = { 255, 226, 160 }
+-- The domain theme's pale sky blue: the water's own cold light.
+local SKY = { 190, 214, 255 }
+-- The wall bays stand 23 studs over the floor; the vaults spring from their tops.
+local WALL_TOP = 23
+
+local feature: MapFeature.Feature = {
+	name = "DomainConservatory",
+	about = "A crystal conservatory: a glasshouse of pale blue glass on a gold frame, its beds of gold-leaved plants round a fountain of light.",
+	tileset = "domain",
+	scale = "medium",
+	role = "crossing",
+	mood = { "glazed", "holy", "hothouse", "gilded", "monumental" },
+	cells = {
+		paving = { ground = FLOOR, lift = 0.4, clear = true },
+		-- The open court between twin houses, the warm gold-leaning paving of the road.
+		court = { ground = COURT, lift = 0.25, clear = true },
+		-- The road's runner through the house: the area's warmer road paving, so the way
+		-- in at the door is the way on across the floor (the road through it is a promise
+		-- the inside keeps too).
+		walk = { ground = COURT, lift = 0.4, clear = true },
+		-- Planting beds: warm gravel, a little raised, with a gold-leaved exotic each.
+		-- Wide gold leaves want room: one plant every six cells, not a thicket.
+		bed = {
+			ground = BED,
+			lift = 1.2,
+			clear = true,
+			props = { { sculpt = "domain_gold_frond", every = 6, scale = { 0.62, 0.85 } } },
+		},
+		-- The glass wall's footing, and the small lamps set along it.
+		glass = {
+			ground = GLASS,
+			lift = 0.6,
+			clear = true,
+			glow = { color = HOLY, range = 11, brightness = 0.7, every = 30, height = 1.4 },
+		},
+		-- Still pale water: the fountain's basin and the mirror pool, lit from within so
+		-- a pool shows cold blue across a pale hall.
+		water = {
+			ground = WATER,
+			lift = 0.25,
+			clear = true,
+			glow = { color = SKY, range = 10, brightness = 0.7, every = 14, height = 0.5 },
+		},
+		-- The fountain's dais and the pool's rim.
+		plinth = { ground = PLINTH, lift = 1.6, clear = true },
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-4: the structure, first.
+		local plan = PLANS[whole(rng, 1, #PLANS)]
+		local crosswise = rng:NextNumber() < 0.5
+		local heart = HEARTS[whole(rng, 1, #HEARTS)]
+		local state = STATES[whole(rng, 1, #STATES)]
+		-- 5: size and dressing.
+		local W, D
+		if plan == "nave" then
+			W, D = whole(rng, 28, 32), whole(rng, 24, 30)
+		elseif plan == "twin" then
+			W, D = whole(rng, 29, 32), whole(rng, 31, 32)
+		else
+			W, D = whole(rng, 28, 32), whole(rng, 28, 32)
+		end
+		local ri = 0 -- the hall's interior half-width across, cells (nave and cross)
+		local hallDepth = 0 -- each twin house's outside depth, cells
+		if plan == "nave" then
+			ri = whole(rng, 4, 9)
+		elseif plan == "cross" then
+			ri = whole(rng, 4, 8)
+		else
+			-- Two houses make a court between them: a narrow glass alley or a broad
+			-- plaza, so two twin seeds read as different places from the air.
+			hallDepth = whole(rng, 6, 10)
+		end
+		-- The court's depth round the house: a glasshouse filling its site, or one set
+		-- back in a broad apron behind its arcades.
+		local m = if plan == "twin" then whole(rng, 2, 3) else whole(rng, 2, 4)
+		-- Beds run deep in a broad hall and shallow in a narrow one, so there is always
+		-- an open floor of at least three cells round the heart for the road to walk.
+		local bedDepth = if plan == "twin" then whole(rng, 1, 2) else math.min(whole(rng, 1, 3), ri - 3)
+		local phase = whole(rng, 0, 2)
+		local doorHalf = 1 -- a door is three cells, twelve studs, wide
+		local cx, cz = (W + 1) / 2, (D + 1) / 2
+		local xcI, zcI = math.floor(cx + 0.5), math.floor(cz + 0.5)
+		local xLo, xHi = m + 1, W - m -- the house's outer wall cells along the walk
+		local zLo, zHi = m + 1, D - m -- and across it (the cross's transept ends)
+
+		local walk = table.create(W * D, true)
+		local heights = table.create(W * D, 0)
+		local kinds: { [number]: string } = {}
+		local lifts: { [number]: number } = {}
+		local inside = table.create(W * D, false)
+
+		local function at(x: number, z: number): number
+			return (z - 1) * W + x
+		end
+		local function isIn(x: number, z: number): boolean
+			return x >= 1 and z >= 1 and x <= W and z <= D and inside[at(x, z)]
+		end
+
+		-- The house's outer footprint, walls included: a rectangle, a cross of two, or
+		-- two parallel houses with an open court between.
+		local topZ0, topZ1, botZ0, botZ1 = 0, 0, 0, 0
+		if plan == "nave" then
+			for z = 1, D do
+				for x = xLo, xHi do
+					if math.abs(z - cz) < ri + 1 then
+						inside[at(x, z)] = true
+					end
+				end
+			end
+		elseif plan == "cross" then
+			for z = 1, D do
+				for x = xLo, xHi do
+					if math.abs(z - cz) < ri + 1 then
