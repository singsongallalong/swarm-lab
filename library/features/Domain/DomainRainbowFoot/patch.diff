@@ -0,0 +1,619 @@
+--!strict
+-- A map feature for the Eternal Domain (bible B12): the rainbow bridge's foot.
+-- The end of a bridge of pale prismatic light, rising out of sight; a guarded
+-- gatehouse at its base; a watchman's horn on its stand. The gods' realm is
+-- ivory stone and gold on a sea of cloud, so here the bridge's road leaves the
+-- land itself: broad marble courts, cloud bays cut into the terrace, a stone
+-- causeway balustraded over the cloud, then the gatehouse's twin towers, and
+-- beyond them the deck of seven lights climbing away.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology
+-- first, then look). The first draws choose the structure, the rest only dress
+-- it:
+--   1. which edge of the footprint the bridge leaves by (north, east, south or
+--      west), which turns the whole plan;
+--   2. the cloud that cuts the terrace: none, a band across it behind the gate
+--      (the road crossing on a balustraded causeway), two inlets from the sides,
+--      or one great bay on a flank;
+--   3. the levels: a flat terrace; a raised gate platform (+2); a two-step
+--      acropolis whose border is a low ledge and whose gate stands at +4; or a
+--      sunken way (-2);
+--   4. the gatehouse's walls: a full curtain wall with one gate; a barbican of
+--      two walls with staggered gates (a triumphal arch at the inner one); twin
+--      stubs that leave the flanks open; or a U of walls round the bridge's
+--      landing;
+--   5. the way the road comes in (opposite or either flank), the footprint's
+--      size, how far the gate stands from the brink, and the cloud's depth;
+--   6. then the towers' scale, the bridge's pitch, the horn's post (the open
+--      court cell nearest the middle) and the scatter of waystones.
+--
+-- Its own geometry: the prismatic bridge (domain_rainbow_bridge), the gatehouse
+-- (domain_bridge_gate) and the watchman's horn (domain_watch_horn); its light:
+-- the gate's glory and the prismatic fall in a new set piece, domain_prism_fall.
+local FeatureDress = require("../FeatureDress")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local function clamp(v: number, lo: number, hi: number): number
+	return math.max(lo, math.min(hi, v))
+end
+
+-- The four edges, with the outward direction of each.
+local OUT = {
+	{ x = 0, z = -1 }, -- 1 north, z = 1
+	{ x = 1, z = 0 }, -- 2 east, x = width
+	{ x = 0, z = 1 }, -- 3 south, z = depth
+	{ x = -1, z = 0 }, -- 4 west, x = 1
+}
+
+local MOATS = { "none", "band", "inlets", "bay" }
+local TERRACES = { "flat", "raised", "acropolis", "sunk" }
+local PLANS = { "curtain", "barbican", "twin", "ring" }
+
+-- B12's ivory stone, three tones, and the gold trim (sat 0.64, under its 0.75).
+local IVORY = { material = "Cobblestone", color = { 218, 210, 194 } }
+local WAY_STONE = { material = "Concrete", color = { 226, 214, 186 } }
+local PLATFORM = { material = "Salt", color = { 230, 224, 210 } }
+local LANDING = { material = "Slate", color = { 206, 210, 226 } }
+local SUNK = { material = "Marble", color = { 214, 208, 194 } }
+local PARAPET = { material = "Basalt", color = { 206, 200, 186 } }
+local RAMPART = { material = "Rock", color = { 210, 204, 190 } }
+local CLOUD = { material = "Snow", color = { 232, 229, 222 } }
+
+-- Holy light (the domain's own warm white-gold) and the bridge's cold sky.
+local HOLY = { 255, 234, 186 }
+local SKY = { 226, 236, 255 }
+
+local CELLS: { [string]: FeatureDress.CellLook } = {
+	-- The open court: dressed marble flags, the fight ground.
+	court = { ground = IVORY, lift = 0.2, clear = true },
+	-- The processional way beside the road, with light in the stone.
+	way = {
+		ground = WAY_STONE,
+		lift = 0.3,
+		clear = true,
+		glow = { color = HOLY, range = 11, brightness = 0.55, every = 9, height = 0.4 },
+	},
+	-- The gate platform, a shade paler than the court.
+	terrace = { ground = PLATFORM, lift = 0.3, clear = true },
+	-- The bridge's landing: cool stone under the prismatic deck, lit from above.
+	landing = {
+		ground = LANDING,
+		lift = 0.4,
+		clear = true,
+		glow = { color = SKY, range = 13, brightness = 0.85, every = 6, height = 0.5 },
+	},
+	-- The sunken way: the area's own marble, lying in shadow.
+	sunk = { ground = SUNK, lift = 0.3, clear = true },
+	-- A low balustrade along the brinks and parapets, with waystones for posts.
+	parapet = {
+		ground = PARAPET,
+		lift = 2.4,
+		clear = true,
+		props = { { sculpt = "domain_waystone", every = 3, scale = { 0.14, 0.2 }, sink = 0 } },
+	},
+	-- A wall of the gatehouse's outworks: tall, ivory ashlar.
+	rampart = { ground = RAMPART, lift = 4.5, clear = true },
+	-- The gatehouse's own foot: flush paving, the towers stand here.
+	mass = { ground = IVORY, lift = 0.4, clear = true },
+	-- The watchman's plinth: the horn's cell, lit from below.
+	watch = {
+		ground = SUNK,
+		lift = 1.0,
+		clear = true,
+		glow = { color = HOLY, range = 10, brightness = 0.8, every = 1, height = 0.6 },
+	},
+	-- The sea of cloud, fallen below the terrace's brink.
+	cloud = { ground = CLOUD, lift = 0.2, clear = true },
+}
+
+-- The foot the bridge's origin stands on, cells in from the brink.
+local FOOT_IN = 4.5
+-- Cloud lies this many studs below the terrace.
+local CLOUD_DROP = -6
+
+local feature: MapFeature.Feature = {
+	name = "DomainRainbowFoot",
+	about = "The foot of the Eternal Domain's rainbow bridge: a marble court on the sea of cloud, a balustraded causeway over cloud bays, a twin-towered gatehouse, the prismatic deck climbing out of sight and the watchman's horn on its stand.",
+	tileset = "domain",
+	scale = "medium",
+	role = "crossing",
+	mood = { "holy", "colossal", "threshold", "cloud-brink", "prismatic" },
+	cells = CELLS :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-5: the structure, first.
+		local b = whole(rng, 1, 4)
+		local moat = MOATS[whole(rng, 1, #MOATS)]
+		local terrace = TERRACES[whole(rng, 1, #TERRACES)]
+		local plan = PLANS[whole(rng, 1, #PLANS)]
+		local entryPick = whole(rng, 1, 3)
+		local w, d = whole(rng, 28, 32), whole(rng, 28, 32)
+		local gd = whole(rng, 9, 12) -- the gate's distance in from the brink
+		local exitOff = whole(rng, -3, 3)
+		local moatDepth = whole(rng, 4, 6)
+		local bayDepth = whole(rng, 8, 12)
+		local baySide = if rng:NextNumber() < 0.5 then 1 else -1
+		local barbicanIn = whole(rng, 4, 5) -- the barbican's inner wall, cells in from the gate
+		local parapetCount = whole(rng, 0, 2)
+
+		local out = OUT[b]
+		local inn = { x = -out.x, z = -out.z }
+		local perp = { x = -out.z, z = out.x }
+		local exitLen = if b == 2 or b == 4 then d else w
+		local exitA = clamp(math.floor((exitLen + 1) / 2 + exitOff + 0.5), 4, exitLen - 3)
+		local exitP: Point
+		if b == 1 then
+			exitP = { x = exitA, z = 1 }
+		elseif b == 2 then
+			exitP = { x = w, z = exitA }
+		elseif b == 3 then
+			exitP = { x = exitA, z = d }
+		else
+			exitP = { x = 1, z = exitA }
+		end
+
+		-- The road comes in by the opposite edge or either flank.
+		local shift = if entryPick == 1 then 2 elseif entryPick == 2 then 1 else 3
+		local entrySide = ((b - 1 + shift) % 4) + 1
+		local entryIn = { x = -OUT[entrySide].x, z = -OUT[entrySide].z }
+		local entryLen = if entrySide == 2 or entrySide == 4 then d else w
+		local entryA = whole(rng, math.floor(entryLen * 0.3), math.ceil(entryLen * 0.7))
+		local entryP: Point
+		if entrySide == 1 then
+			entryP = { x = entryA, z = 1 }
+		elseif entrySide == 2 then
+			entryP = { x = w, z = entryA }
+		elseif entrySide == 3 then
+			entryP = { x = entryA, z = d }
+		else
+			entryP = { x = 1, z = entryA }
+		end
+
+		local function frame(x: number, z: number): (number, number)
+			local dx, dz = x - exitP.x, z - exitP.z
+			return dx * inn.x + dz * inn.z, dx * perp.x + dz * perp.z
+		end
+
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		local function isBorder(x: number, z: number): boolean
+			return x == 1 or z == 1 or x == w or z == d
+		end
+
+		local gateS = gd - 0.4
+		local gateP = { x = exitP.x + inn.x * gateS, z = exitP.z + inn.z * gateS }
+		local footP = { x = exitP.x + inn.x * FOOT_IN, z = exitP.z + inn.z * FOOT_IN }
+		local innerS = gateS + barbicanIn
+		local moatStart = gateS + (if plan == "barbican" then barbicanIn + 3.2 else 2.6)
+		local moatEnd = moatStart + moatDepth
+
+		-- 5: the way in, and the road.
+		local road: { Point } = { entryP }
+		local bend = { x = entryP.x + entryIn.x * 3.5, z = entryP.z + entryIn.z * 3.5 }
+		if bend.x > 0.5 and bend.z > 0.5 and bend.x < w + 0.5 and bend.z < d + 0.5 then
+			table.insert(road, bend)
+		end
+		local innerGate: Point? = nil
+		if plan == "barbican" then
+			local off = (if rng:NextNumber() < 0.5 then -1 else 1) * whole(rng, 3, 5)
+			innerGate = { x = exitP.x + inn.x * innerS + perp.x * off, z = exitP.z + inn.z * innerS + perp.z * off }
+			table.insert(road, innerGate)
+		end
+		table.insert(road, gateP)
+		table.insert(road, exitP)
+
+		local function distToRoad(x: number, z: number): number
+			local best = math.huge
+			for k = 2, #road do
+				local a, bb = road[k - 1], road[k]
+				local abx, abz = bb.x - a.x, bb.z - a.z
+				local len2 = abx * abx + abz * abz
+				local t = if len2 > 1e-9 then clamp(((x - a.x) * abx + (z - a.z) * abz) / len2, 0, 1) else 0
+				local px, pz = a.x + abx * t, a.z + abz * t
+				best = math.min(best, math.sqrt((x - px) ^ 2 + (z - pz) ^ 2))
+			end
+			return best
+		end
+
+		local n = w * d
+		local walk = table.create(n, true)
+		local heights = table.create(n, 0)
+		local roadCell = table.create(n, false)
+		for z = 1, d do
+			for x = 1, w do
+				roadCell[at(x, z)] = distToRoad(x, z) <= 1.7
+			end
+		end
+
+		-- 3: the levels.
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				local s, l = frame(x, z)
+				if terrace == "raised" then
+					heights[i] = if s < gd then 2 else 0
+				elseif terrace == "acropolis" then
+					-- The border ledge and the first step of the climb both stand
+					-- at 2; the gate's own platform is the high ground at 4.
+					if isBorder(x, z) or (s >= gd and s < gd + 1.2) then
+						heights[i] = 2
+					elseif s < gd then
+						heights[i] = 4
+					else
+						heights[i] = 0
+					end
+				elseif terrace == "sunk" then
+					heights[i] = if s > moatEnd + 1 and math.abs(l) <= 4 then -2 else 0
+				end
+			end
+		end
+
+		-- The walls: cloud, the plan's walls, the gate's mass and the parapets.
+		local wallKind: { [number]: string } = {}
+		local function wall(x: number, z: number, name: string, h: number?)
+			if x < 1 or z < 1 or x > w or z > d then
+				return
+			end
+			local i = at(x, z)
+			if roadCell[i] then
+				return
+			end
+			wallKind[i] = name
+			if h ~= nil then
+				heights[i] = h
+			end
+		end
+
+		-- 2: the cloud that cuts the terrace.
+		local half = if b == 2 or b == 4 then d / 2 else w / 2
+		local function inMoat(x: number, z: number): boolean
+			-- Cloud never reaches a border: a walkable margin all round keeps the
+			-- courts joined however the bay falls (a causeway is a shortcut, not
+			-- the only way).
+			if x < 3 or z < 3 or x > w - 2 or z > d - 2 then
+				return false
+			end
+			local s, l = frame(x, z)
+			if s <= moatStart or s >= moatEnd then
+				return false
+			end
+			if moat == "band" then
+				return true
+			elseif moat == "inlets" then
+				return math.abs(l) > half - moatDepth
+			elseif moat == "bay" then
+				return s > moatStart and l * baySide > half - bayDepth
+			end
+			return false
+		end
+		local isCloud = table.create(n, false)
+		for z = 1, d do
+			for x = 1, w do
+				if inMoat(x, z) then
+					isCloud[at(x, z)] = true
+					wall(x, z, "cloud", CLOUD_DROP)
+				end
+			end
+		end
+		-- Its brink: a balustrade along every edge of the cloud the walkers stand on.
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				if isCloud[i] then
+					for _, nb in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
+						local nx, nz = x + nb[1], z + nb[2]
+						if nx >= 1 and nz >= 1 and nx <= w and nz <= d then
+							local j = at(nx, nz)
+							if not isCloud[j] and walk[j] then
+								wall(x, z, "parapet", heights[j])
+								break
+							end
+						end
+					end
+				end
+			end
+		end
+
+		-- The gatehouse's foot, and 4: its walls.
+		for z = 1, d do
+			for x = 1, w do
+				local s, l = frame(x, z)
+				if math.abs(s - gateS) <= 1.6 and math.abs(l) >= 1.6 and math.abs(l) <= 6.2 then
+					wall(x, z, "mass", nil)
+				end
+			end
+		end
+		local function lineWall(s0: number, reach: number, name: string)
+			for z = 1, d do
+				for x = 1, w do
+					local s, l = frame(x, z)
+					if math.abs(s - s0) < 0.75 and math.abs(l) <= reach then
+						wall(x, z, name, nil)
+					end
+				end
+			end
+		end
+		if plan == "curtain" then
+			lineWall(gateS, 99, "rampart")
+		elseif plan == "barbican" then
+			lineWall(gateS, 99, "rampart")
+			lineWall(innerS, 99, "rampart")
+		elseif plan == "twin" then
+			lineWall(gateS, 10, "rampart")
+		else -- ring: a U of walls round the landing, open at the brink
+			lineWall(gateS, 9.5, "rampart")
+			for z = 1, d do
+				for x = 1, w do
+					local s, l = frame(x, z)
+					if math.abs(math.abs(l) - 9) <= 0.6 and s >= 2.5 and s <= gateS then
+						wall(x, z, "rampart", nil)
+					end
+				end
+			end
+		end
+
+		-- Parapets on some of the other edges.
+		local others = {}
+		for side = 1, 4 do
+			if side ~= b then
+				table.insert(others, side)
+			end
+		end
+		for _ = 1, parapetCount do
+			local pick = whole(rng, 1, #others)
+			local side = table.remove(others, pick) :: number
+			for k = 1, if side == 2 or side == 4 then d else w do
+				local x, z
+				if side == 1 then
+					x, z = k, 1
+				elseif side == 2 then
+					x, z = w, k
+				elseif side == 3 then
+					x, z = k, d
+				else
+					x, z = 1, k
+				end
+				local i = at(x, z)
+				wall(x, z, "parapet", heights[i])
+			end
+		end
+
+		for i in wallKind do
+			walk[i] = false
+		end
+
+		-- 6: paint the walkable ground.
+		local kinds: { [number]: string } = {}
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				if walk[i] then
+					wallKind[i] = nil
+					if not roadCell[i] then
+						local s = frame(x, z)
+						local dFoot = math.sqrt((x - footP.x) ^ 2 + (z - footP.z) ^ 2)
+						if dFoot <= 3.6 then
+							kinds[i] = "landing"
+						elseif s < gd + 0.6 then
+							kinds[i] = "terrace"
+						elseif heights[i] < 0 then
+							kinds[i] = "sunk"
+						elseif distToRoad(x, z) <= 2.8 then
+							kinds[i] = "way"
+						else
+							kinds[i] = "court"
+						end
+					end
+				end
+			end
+		end
+		for i, name in wallKind do
+			kinds[i] = name
+		end
+
+		local function surface(x: number, z: number): number
+			local cx = clamp(math.floor(x + 0.5), 1, w)
+			local cz = clamp(math.floor(z + 0.5), 1, d)
+			local i = at(cx, cz)
+			local look = if kinds[i] then CELLS[kinds[i]] else nil
+			return heights[i] + (if look then look.lift or 0 else 0)
+		end
+
+		-- The watchman's post: an open cell in the middle of the court, where the
+		-- horn's note carries both to the gate and to the far rim. It is chosen
+		-- near the footprint's middle and clear of the road, so the game camera
+		-- over the middle always finds it, whichever way the bridge leaves.
+		local midX, midZ = (w + 1) / 2, (d + 1) / 2
+		local hornP: Point = { x = midX, z = midZ }
+		local best = math.huge
+		for z = 4, d - 3 do
+			for x = 4, w - 3 do
+				local i = at(x, z)
+				local kind = kinds[i]
+				if walk[i] and not roadCell[i] and (kind == "court" or kind == "terrace") then
+					local clear = true
+					for _, nb in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
+						local j = at(x + nb[1], z + nb[2])
+						if not walk[j] or roadCell[j] then
+							clear = false
+							break
+						end
+					end
+					if clear then
+						local score = (x - midX) ^ 2 + (z - midZ) ^ 2
+						if score < best then
+							best = score
+							hornP = { x = x, z = z }
+						end
+					end
+				end
+			end
+		end
+		if best < math.huge then
+			local i = at(hornP.x, hornP.z)
+			wall(hornP.x, hornP.z, "watch", heights[i])
+			walk[i] = false
+			kinds[i] = "watch"
+		else
+			-- A court too tight for a post: the horn waits by the gate's flank.
+			local fx = exitP.x + inn.x * (gateS - 1.2) + perp.x * 7.2
+			local fz = exitP.z + inn.z * (gateS - 1.2) + perp.z * 7.2
+			local hx = clamp(math.floor(fx + 0.5), 1, w)
+			local hz = clamp(math.floor(fz + 0.5), 1, d)
+			if not roadCell[at(hx, hz)] then
+				wall(hx, hz, "watch", heights[at(hx, hz)])
+				walk[at(hx, hz)] = false
+				kinds[at(hx, hz)] = "watch"
+				hornP = { x = hx, z = hz }
+			end
+		end
+
+		-- Landmarks.
+		local marks: { FeatureDress.Landmark } = {}
+		local gateScale = between(rng, 0.84, 1.0)
+		table.insert(marks, {
+			sculpt = "domain_bridge_gate",
+			x = gateP.x,
+			z = gateP.z,
+			yaw = math.deg(math.atan2(-inn.z, inn.x)),
+			scale = gateScale,
+			sink = -surface(gateP.x, gateP.z),
+			solid = false,
+		})
+		local bridgeScale = between(rng, 0.92, 1.04)
+		table.insert(marks, {
+			sculpt = "domain_rainbow_bridge",
+			x = footP.x,
+			z = footP.z,
+			yaw = math.deg(math.atan2(-out.z, out.x)),
+			scale = bridgeScale,
+			sink = -surface(footP.x, footP.z) + 0.35,
+			solid = false,
+		})
+		table.insert(marks, {
+			sculpt = "domain_watch_horn",
+			x = hornP.x,
+			z = hornP.z,
+			yaw = math.deg(math.atan2(-out.z, out.x)) + between(rng, -20, 20),
+			scale = between(rng, 0.9, 1.1),
+			sink = -surface(hornP.x, hornP.z),
+			solid = false,
+		})
+		-- Two god-columns framing the bridge's landing.
+		for _, side in { -1, 1 } do
+			local px = footP.x + perp.x * 6.3 * side + inn.x * 1.1
+			local pz = footP.z + perp.z * 6.3 * side + inn.z * 1.1
+			table.insert(marks, {
+				sculpt = "domain_column",
+				x = px,
+				z = pz,
+				yaw = between(rng, 0, 360),
+				scale = between(rng, 0.46, 0.56),
+				sink = -surface(px, pz) + 0.3,
+				solid = true,
+			})
+		end
+		-- Braziers flanking the gate's inner face.
+		for _, side in { -1, 1 } do
+			local px = exitP.x + inn.x * (gateS - 1.0) + perp.x * 6.6 * side
+			local pz = exitP.z + inn.z * (gateS - 1.0) + perp.z * 6.6 * side
+			table.insert(marks, {
+				sculpt = "domain_brazier_high",
+				x = px,
+				z = pz,
+				yaw = between(rng, 0, 360),
+				scale = between(rng, 0.8, 0.95),
+				sink = -surface(px, pz) + 0.1,
+				solid = false,
+			})
+		end
+		-- An outlying waystone where the road comes in, and one by the horn.
+		local wsp = { x = hornP.x + perp.x * 2.2, z = hornP.z + perp.z * 2.2 }
+		table.insert(marks, {
+			sculpt = "domain_waystone",
+			x = wsp.x,
+			z = wsp.z,
+			yaw = between(rng, 0, 360),
+			scale = between(rng, 0.3, 0.4),
+			sink = -surface(wsp.x, wsp.z) + 0.2,
+			solid = true,
+		})
+
+		-- The barbican's inner gate: the kit's triumphal arch.
+		if innerGate then
+			local dx, dz = gateP.x - bend.x, gateP.z - bend.z
+			table.insert(marks, {
+				sculpt = "domain_triumphal_arch",
+				x = innerGate.x,
+				z = innerGate.z,
+				yaw = math.deg(math.atan2(dx, dz)),
+				scale = between(rng, 0.9, 1.05),
+				sink = -surface(innerGate.x, innerGate.z),
+				solid = false,
+			})
+		end
+
+		-- The set pieces: the gate's glory, and the bridge shedding light.
+		local effects: { FeatureDress.Effect } = {
+			{
+				recipe = "domain_gate_glory",
+				x = gateP.x,
+				z = gateP.z,
+				lift = surface(gateP.x, gateP.z) + 1.2,
+				seed = whole(rng, 1, 999),
+			},
+			{
+				recipe = "domain_prism_fall",
+				x = footP.x - inn.x * 0.8,
+				z = footP.z - inn.z * 0.8,
+				lift = surface(footP.x, footP.z) + between(rng, 1, 3),
+				seed = whole(rng, 1, 999),
+			},
+		}
+
+		-- The photographs: through the gate up the bridge, and a low
+		-- three-quarter from the court along the bridge's flank.
+		local cameras: { MapFeature.Shot } = {
+			{
+				name = "the way to the rainbow",
+				from = { x = gateP.x + inn.x * 9, z = gateP.z + inn.z * 9, lift = 10 },
+				to = { x = footP.x + out.x * 1.5, z = footP.z + out.z * 1.5, lift = 24 },
+				fov = 62,
+			},
+			{
+				name = "the watchman's view",
+				from = {
+					x = footP.x + inn.x * 6.5 + perp.x * 10,
+					z = footP.z + inn.z * 6.5 + perp.z * 10,
+					lift = 11,
+				},
+				to = { x = footP.x + out.x * 2, z = footP.z + out.z * 2, lift = 26 },
+				fov = 66,
+			},
+		}
+
+		return {
+			width = w,
+			depth = d,
+			walk = walk,
+			heights = heights,
+			kinds = kinds,
+			marks = marks,
+			effects = effects,
+			road = road,
+			cameras = cameras,
+		}
+	end,
+}
+
+return feature
