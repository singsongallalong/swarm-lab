+--!strict
+-- The Eternal Domain's hall of heroes: an avenue of colossal armoured figures of the
+-- gods' host, each on a marble plinth, spears and shields toward the processional way
+-- that runs through them. Their plinths make a colonnade of stone; gold-banded
+-- waystones frame the way where it enters and leaves; braziers with a coal of holy
+-- light between the heroes; and at each hero's foot the gods' light gathers in a
+-- narrow shower of gold motes (domain_hero_glory). One hero in the row has come down
+-- from its plinth and lies broken where it fell, the plinth standing empty over it.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first,
+-- then look). The first draws choose the structure, the rest only dress it:
+--   1. the plan: a straight avenue, a dogleg that turns twice, a four-armed crossing,
+--      or a way that forks around a shrine island (a branching way);
+--   2. the hall's edge: open to its flanks, a low kerb, or a thick terrace wall
+--      carried round the whole hall (its mass changes the ground a fight has);
+--   3. the rows: heroes facing each other across the way, a single row, or staggered;
+--   4. their stance: low daises, tall plinths, or high colossus blocks;
+--   5. the way: flush with the paving, raised on a two-stud stylobate, or sunk three
+--      studs between retaining walls with stairs down through them.
+-- Then the flanks are dressed (walled groves of gold trees, or a colonnade of piers),
+-- and the heroes' number, pose and fallen, the braziers, the waystones, the size of
+-- the whole, and the cameras. It all stands on the Domain's own marble and gold.
+local FeatureDress = require("../FeatureDress")
+local Grid = require("../Grid")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+type Rect = { x0: number, x1: number, z0: number, z1: number }
+type Hero = { x: number, z: number, yaw: number, tox: number, toz: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local PLANS = { "avenue", "dogleg", "cross", "fork" }
+local EDGES = { "open", "kerb", "terraced" }
+local ROWS = { "both", "one", "staggered" }
+local STANCES = { "dais", "plinth", "colossus" }
+local WAYS = { "flush", "raised", "sunken" }
+
+-- The heroes' two standing poses, and the one that fell.
+local HEROES = { "domain_hero_spear", "domain_hero_vigil" }
+
+local DIRS = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
+
+-- Every ground is the Domain's own stone: the paving materials in the tileset's own
+-- colours (Roblox colours a material once), and free ones (Salt, Sand) in ivory tones.
+-- B12's limits for the tileset: saturation 0.55, value 0.92.
+local CELLS: { [string]: FeatureDress.CellLook } = {
+	-- The processional way: the Domain's gold-veined paving, laid as its own kind.
+	way = { ground = { material = "Pavement", color = { 226, 212, 184 } }, lift = 0.15, clear = true },
+	-- The flanks: the Domain's marble paving, so the hall sits in the place's own ground.
+	flank = { ground = { material = "Marble", color = { 214, 208, 194 } }, lift = 0.1, clear = true },
+	-- The plinths and piers: a paler stone block, its top the hero's floor.
+	plinth = { ground = { material = "Salt", color = { 230, 224, 206 } }, lift = 6, clear = true },
+	pier = { ground = { material = "Salt", color = { 230, 224, 206 } }, lift = 12, clear = true },
+	-- Raised beds of pale gravel for the sacred grove, one young gold tree in a few.
+	planter = {
+		ground = { material = "Sand", color = { 222, 210, 186 } },
+		lift = 2.4,
+		clear = true,
+		props = { { sculpt = "domain_gold_tree_low", every = 42, scale = { 0.8, 1.05 }, sink = 0 } },
+	},
+	-- The fork's shrine island: marble under the waystone.
+	shrine = { ground = { material = "Marble", color = { 214, 208, 194 } }, lift = 3, clear = true },
+	-- The stairs down into a sunken way, and the step up at its mouth.
+	step = { ground = { material = "Limestone", color = { 202, 194, 178 } }, lift = 0.15, clear = true },
+	-- The retaining wall along a sunken way: dressed limestone under a broad coping.
+	retain = { ground = { material = "Sandstone", color = { 196, 186, 166 } }, lift = 1, clear = true },
+	-- The hall's edge: a terrace wall of dressed limestone carrying the hall's boundary.
+	terrace = {
+		ground = { material = "Limestone", color = { 202, 194, 178 } },
+		lift = 3,
+		clear = true,
+		props = { { sculpt = "domain_waystone", every = 26, scale = { 0.32, 0.42 }, sink = 0 } },
+	},
+	-- A brazier's cell: the way's paving with a coal of holy light in the bowl.
+	lamp = {
+		ground = { material = "Pavement", color = { 226, 212, 184 } },
+		lift = 0.15,
+		clear = true,
+		glow = { color = { 255, 226, 160 }, range = 15, brightness = 1.1, every = 1, height = 10.2 },
+	},
+}
+
+local feature: MapFeature.Feature = {
+	name = "DomainHallOfHeroes",
+	about = "A processional avenue of colossal haloed heroes on marble plinths, spears and shields toward the way, their feet lit by gathered holy light.",
+	tileset = "domain",
+	scale = "centrepiece",
+	role = "crossing",
+	mood = { "monumental", "processional", "holy", "watchful" },
+	cells = CELLS,
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-5: the structure first.
+		local plan = PLANS[whole(rng, 1, #PLANS)]
+		local edge = EDGES[whole(rng, 1, #EDGES)]
+		local rows = ROWS[whole(rng, 1, #ROWS)]
+		local stance = STANCES[whole(rng, 1, #STANCES)]
+		local wayMode = WAYS[whole(rng, 1, #WAYS)]
+
+		-- Dressing, drawn after the structure: beds of the sacred grove in the flanks,
+		-- and a colonnade of piers behind the heroes on some seeds.
+		local beds = whole(rng, 2, 6)
+		local bedLift = whole(rng, 2, 3)
+		local arcade = rng:NextNumber() < 0.45
+
+		-- The size of the place, the way's width, and the heroes' stance.
+		local w = whole(rng, 40, 52)
+		local d = whole(rng, 46, 56)
+		local cx, cz = math.floor((w + 1) / 2), math.floor((d + 1) / 2)
+		local hw = whole(rng, 3, 4)
+		local edgeThick = if edge == "terraced" then whole(rng, 2, 3) elseif edge == "kerb" then 1 else 0
+		local edgeLift = whole(rng, 2, 6)
+		local wayH = if wayMode == "raised" then 2 elseif wayMode == "sunken" then -3 else 0
+		local pw = 3
+		local plinthH = if stance == "dais"
+			then whole(rng, 2, 3)
+			elseif stance == "plinth" then whole(rng, 6, 9)
+			else whole(rng, 10, 14)
+
+		local walk = table.create(w * d, true)
+		local heights = table.create(w * d, 0)
+		local kinds: { [number]: string } = {}
+		local lifts: { [number]: number } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		for i = 1, w * d do
+			kinds[i] = "flank"
+		end
+
+		-- The way: one or more rectangular runs, and the road through it.
+		local ways: { Rect } = {}
+		local road: { Point } = {}
+		local island: Rect? = nil
+		local islandH = 0
+		-- How far the way reaches either side of its centreline (the fork's band is wider).
+		local bandHalf = hw
+		if plan == "avenue" then
+			table.insert(ways, { x0 = cx - hw, x1 = cx + hw, z0 = 1, z1 = d })
+			road = { { x = cx, z = 1 }, { x = cx, z = d } }
+		elseif plan == "dogleg" then
+			local sep = hw + whole(rng, 5, 9)
+			local zB = whole(rng, math.floor(d * 0.34), math.floor(d * 0.62))
+			local cx1, cx2 = cx - sep, cx + sep
+			table.insert(ways, { x0 = cx1 - hw, x1 = cx1 + hw, z0 = 1, z1 = zB + hw })
+			table.insert(ways, { x0 = cx1 - hw, x1 = cx2 + hw, z0 = zB - hw, z1 = zB + hw })
+			table.insert(ways, { x0 = cx2 - hw, x1 = cx2 + hw, z0 = zB - hw, z1 = d })
+			road = { { x = cx1, z = 1 }, { x = cx1, z = zB }, { x = cx2, z = zB }, { x = cx2, z = d } }
+		elseif plan == "cross" then
+			table.insert(ways, { x0 = cx - hw, x1 = cx + hw, z0 = 1, z1 = d })
+			table.insert(ways, { x0 = 1, x1 = w, z0 = cz - hw, z1 = cz + hw })
+			road = { { x = cx, z = 1 }, { x = cx, z = d } }
+		else
+			local iw = whole(rng, 2, 3)
+			local lw = whole(rng, 2, 3)
+			local il = whole(rng, 5, 9)
+			bandHalf = iw + lw
+			islandH = whole(rng, 2, 4)
+			table.insert(ways, { x0 = cx - bandHalf, x1 = cx + bandHalf, z0 = 1, z1 = d })
+			island = { x0 = cx - iw, x1 = cx + iw, z0 = cz - il, z1 = cz + il }
+			-- The road takes the west lane round the shrine; the east lane is its other way.
+			local lane = cx - iw - 1
+			road = {
+				{ x = cx, z = 1 },
+				{ x = cx, z = island.z0 - 2 },
+				{ x = lane, z = island.z0 - 2 },
+				{ x = lane, z = island.z1 + 2 },
+				{ x = cx, z = island.z1 + 2 },
+				{ x = cx, z = d },
+			}
+		end
+
+		local function paintRect(r: Rect, kind: string, h: number)
+			for z = math.max(1, r.z0), math.min(d, r.z1) do
+				for x = math.max(1, r.x0), math.min(w, r.x1) do
+					local i = at(x, z)
+					walk[i] = true
+					heights[i] = h
+					kinds[i] = kind
+				end
+			end
+		end
+		for _, r in ways do
+			paintRect(r, "way", wayH)
+		end
+		if island then
+			for z = island.z0, island.z1 do
+				for x = island.x0, island.x1 do
+					local i = at(x, z)
+					walk[i] = false
+					kinds[i] = "shrine"
+					lifts[i] = islandH
+				end
+			end
+		end
+		-- A sunken way steps up to the open ground in its last two cells, so its mouth is
+		-- within a step of the map's own ground at the border.
+		if wayMode == "sunken" then
+			for i, kind in kinds do
+				if kind == "way" then
+					local x, z = (i - 1) % w + 1, (i - 1) // w + 1
+					if z <= 2 or z >= d - 1 or x <= 2 or x >= w - 1 then
+						heights[i] = -1
+						kinds[i] = "step"
+					end
+				end
+			end
+		end
+
+		-- The hall's edge, carried round the footprint and cut only where the way runs
+		-- through it: no strip of ground is left walled off outside it.
+		if edgeThick > 0 then
+			for z = 1, d do
+				for x = 1, w do
+					local i = at(x, z)
+					if
+						kinds[i] == "flank"
+						and (x <= edgeThick or z <= edgeThick or x > w - edgeThick or z > d - edgeThick)
+					then
+						walk[i] = false
+						kinds[i] = "terrace"
+						lifts[i] = edgeLift
+					end
+				end
+			end
+		end
+
+		local marks: { FeatureDress.Landmark } = {}
+		local heroes: { Hero } = {}
+
+		-- A plinth is a block of wall cells raised by its kind's lift, the hero standing on it.
+		local function freeBlock(x0: number, z0: number, size: number): boolean
+			for z = z0, z0 + size - 1 do
+				for x = x0, x0 + size - 1 do
+					if x < 2 or z < 2 or x > w - 1 or z > d - 1 then
+						return false
+					end
+					local i = at(x, z)
+					if not walk[i] or kinds[i] ~= "flank" or heights[i] ~= 0 then
+						return false
+					end
+				end
+			end
+			return true
+		end
+		local function addHero(x0: number, z0: number, yaw: number, tox: number, toz: number): boolean
+			if not freeBlock(x0, z0, pw) then
+				return false
+			end
+			for z = z0, z0 + pw - 1 do
+				for x = x0, x0 + pw - 1 do
+					local i = at(x, z)
+					walk[i] = false
+					kinds[i] = "plinth"
+					lifts[i] = plinthH
+				end
+			end
+			table.insert(heroes, { x = x0 + (pw - 1) / 2, z = z0 + (pw - 1) / 2, yaw = yaw, tox = tox, toz = toz })
+			return true
+		end
+
+		-- A statue line along one side of a run: A is the west/north side, B the east/south.
+		local side = if rng:NextNumber() < 0.5 then -1 else 1
+		local function placeRow(axis: string, firstA: number, firstB: number, from: number, to: number, count: number)
+			if to < from or count < 1 then
+				return
+			end
+			for k = 1, count do
+				local t = if count == 1 then 0.5 else (k - 1) / (count - 1)
+				local p = math.floor(from + t * (to - from) + 0.5)
+				local useA = rows == "both" or (rows == "one" and side < 0) or (rows == "staggered" and k % 2 == 1)
+				local useB = rows == "both" or (rows == "one" and side > 0) or (rows == "staggered" and k % 2 == 0)
+				if axis == "z" then
+					local placed = if useA then addHero(firstA, p, 0, 1, 0) else false
+					if useB then
+						placed = addHero(firstB, p, 180, -1, 0) or placed
+					end
+					if rows == "one" and not placed then
+						-- A single row takes the side with room, whatever the draw said.
+						if side < 0 then
+							addHero(firstB, p, 180, -1, 0)
+						else
+							addHero(firstA, p, 0, 1, 0)
+						end
+					end
+				else
+					local placed = if useA then addHero(p, firstA, -90, 0, 1) else false
+					if useB then
+						placed = addHero(p, firstB, 90, 0, -1) or placed
+					end
+					if rows == "one" and not placed then
+						if side < 0 then
+							addHero(p, firstB, 90, 0, -1)
+						else
+							addHero(p, firstA, -90, 0, 1)
+						end
+					end
+				end
+			end
+		end
+		local function rowFor(r: Rect, axis: string, count: number, fromAt: number?, toAt: number?)
+			if axis == "z" then
+				local from = math.max(3, if fromAt then fromAt else r.z0 + 3)
+				local to = math.min(d - 3 - (pw - 1), if toAt then toAt else r.z1 - 3 - (pw - 1))
+				placeRow("z", r.x0 - pw, r.x1 + 1, from, to, count)
+			else
+				local from = math.max(3, if fromAt then fromAt else r.x0 + 3)
+				local to = math.min(w - 3 - (pw - 1), if toAt then toAt else r.x1 - 3 - (pw - 1))
+				placeRow("x", r.z0 - pw, r.z1 + 1, from, to, count)
+			end
+		end
+		local extra = if rows == "staggered" then 2 elseif rows == "one" then 2 else 0
+		if plan == "avenue" or plan == "fork" then
+			rowFor(ways[1], "z", whole(rng, 3, 5) + extra)
+		elseif plan == "dogleg" then
+			-- The two legs' rows stop at the cross arm, so their heroes face each other
+			-- across it rather than standing in it.
+			local armNorth = ways[2].z0 - 1 - (pw - 1)
+			local armSouth = ways[2].z1 + 2
+			rowFor(ways[1], "z", whole(rng, 2, 3) + extra, nil, armNorth)
+			rowFor(ways[2], "x", whole(rng, 0, 1))
+			rowFor(ways[3], "z", whole(rng, 2, 3) + extra, armSouth, nil)
+		elseif plan == "cross" then
+			rowFor(ways[1], "z", whole(rng, 2, 3) + extra)
+			rowFor(ways[2], "x", whole(rng, 1, 2) + extra)
+		end
+
+		-- The flanks: groves of sacred trees in raised beds.
+		if beds > 0 then
+			local function freeBed(x0: number, z0: number, bw: number, bl: number): boolean
+				for z = z0 - 1, z0 + bl do
+					for x = x0 - 1, x0 + bw do
+						if x < 2 or z < 2 or x > w - 1 or z > d - 1 then
+							return false
+						end
+						if kinds[at(x, z)] ~= "flank" or not walk[at(x, z)] then
+							return false
+						end
+					end
+				end
+				return true
+			end
+			for b = 1, beds do
+				local bw = whole(rng, 5, 8)
+				local bl = whole(rng, 10, 16)
+				for _ = 1, 40 do
+					local x0 = whole(rng, 3, w - bw - 3)
+					local z0 = whole(rng, 3, d - bl - 3)
+					if freeBed(x0, z0, bw, bl) then
+						local h = bedLift + (b % 2)
+						for z = z0, z0 + bl - 1 do
+							for x = x0, x0 + bw - 1 do
+								local i = at(x, z)
+								walk[i] = false
+								kinds[i] = "planter"
+								lifts[i] = h
+							end
+						end
+						break
+					end
+				end
+			end
+		end
+		if arcade then
+			-- Tall piers behind the heroes, one every few cells along each side of the way.
+			local pierH = whole(rng, 9, 16)
+			local every = whole(rng, 5, 7)
+			for _, r in ways do
+				for sideSign = -1, 1, 2 do
+					local x0 = if sideSign < 0 then r.x0 - pw - 3 else r.x1 + pw + 2
+					local z = math.max(3, r.z0 + 2)
+					while z + 1 <= math.min(d - 1, r.z1 - 2) do
+						if freeBlock(x0, z, 2) then
+							for zz = z, z + 1 do
+								for xx = x0, x0 + 1 do
+									local i = at(xx, zz)
+									walk[i] = false
+									kinds[i] = "pier"
+									lifts[i] = pierH
+								end
+							end
+						end
+						z += every
+					end
+				end
+			end
+		end
+
+		-- A sunken way keeps a retaining wall either side, with stairs cut down through it.
+		local function inBounds(x: number, z: number): boolean
+			return x >= 1 and z >= 1 and x <= w and z <= d
+		end
+		if wayMode == "sunken" then
+			for z = 1, d do
+				for x = 1, w do
+					local i = at(x, z)
+					if kinds[i] == "way" then
+						for _, nb in DIRS do
+							if inBounds(x + nb[1], z + nb[2]) then
+								local j = at(x + nb[1], z + nb[2])
+								if walk[j] and kinds[j] == "flank" then
+									walk[j] = false
+									kinds[j] = "retain"
+									lifts[j] = 1
+								end
+							end
+						end
+					end
+				end
+			end
+			local stairs = whole(rng, 2, 4)
+			local taken: { Point } = {}
+			for i, kind in kinds do
+				if kind == "retain" and #taken < stairs then
+					local x, z = (i - 1) % w + 1, (i - 1) // w + 1
+					local down, up = 0, 0
+					for _, nb in DIRS do
+						if inBounds(x + nb[1], z + nb[2]) then
+							local j = at(x + nb[1], z + nb[2])
+							if walk[j] and kinds[j] == "way" then
+								down += 1
+							elseif walk[j] and kinds[j] == "flank" and heights[j] == 0 then
+								up += 1
+							end
+						end
+					end
+					local near = false
+					for _, t in taken do
+						if math.abs(t.x - x) + math.abs(t.z - z) < 6 then
+							near = true
+							break
+						end
+					end
+					if down == 1 and up == 1 and not near then
+						table.insert(taken, { x = x, z = z })
+						walk[i] = true
+						kinds[i] = "step"
+						heights[i] = -1
+						lifts[i] = 0.15
+					end
+				end
+			end
+		end
+
+		-- The parapet must not cut the flanks into pieces no one can reach: every walkable
+		-- region gets a stair of its own down through it. (A cross's four quarters, or a
+		-- fork's two, can otherwise be walled off by the way's own retaining walls.)
+		if wayMode == "sunken" then
+			local g = Grid.new(w, d, Grid.WALL)
+			local roadStart =
+				at(math.clamp(math.floor(road[1].x + 0.5), 1, w), math.clamp(math.floor(road[1].z + 0.5), 1, d))
+			local function contains(region: { number }, i: number): boolean
+				for _, c in region do
+					if c == i then
+						return true
+					end
+				end
+				return false
+			end
+			for _ = 1, 10 do
+				for i, ok in walk do
+					g.cells[i] = if ok then Grid.FLOOR else Grid.WALL
+				end
+				local regions = Grid.regions(g)
+				if #regions <= 1 then
+					break
+				end
+				local main: { number }? = nil
+				for _, region in regions do
+					if contains(region, roadStart) then
+						main = region
+						break
+					end
+				end
+				local progressed = false
+				for _, region in regions do
+					if region ~= main and not progressed then
+						for _, i in region do
+							local x, z = (i - 1) % w + 1, (i - 1) // w + 1
+							for _, nb in DIRS do
+								local jx, jz = x + nb[1], z + nb[2]
+								if inBounds(jx, jz) then
+									local j = at(jx, jz)
+									if kinds[j] == "retain" then
+										local touchesWay = false
+										for _, nb2 in DIRS do
+											if inBounds(jx + nb2[1], jz + nb2[2]) then
+												local k = at(jx + nb2[1], jz + nb2[2])
+												if walk[k] and kinds[k] == "way" then
+													touchesWay = true
+													break
+												end
+											end
+										end
+										if touchesWay then
+											walk[j] = true
+											kinds[j] = "step"
+											heights[j] = -1
+											lifts[j] = 0.15
+											progressed = true
+											break
+										end
+									end
+								end
+							end
+							if progressed then
+								break
+							end
+						end
+					end
+				end
+				if not progressed then
+					break
+				end
+			end
+		end
+
+		-- What is left of the old colonnade: a few god-columns standing out in the flanks.
+		local columns = whole(rng, 0, 3)
+		for c = 1, columns do
+			for _ = 1, 30 do
+				local x0 = whole(rng, 3, w - 4)
+				local z0 = whole(rng, 3, d - 4)
+				if freeBlock(x0, z0, 2) then
+					-- Keep them out of the heroes' faces and off the way's lip.
+					local clear = true
+					for z = z0 - 2, z0 + 3 do
+						for x = x0 - 2, x0 + 3 do
+							if inBounds(x, z) and kinds[at(x, z)] ~= "flank" then
+								clear = false
+								break
+							end
+						end
+						if not clear then
+							break
+						end
+					end
+					if clear then
+						table.insert(marks, {
+							sculpt = if c % 2 == 0 then "domain_column_broken" else "domain_column",
+							x = x0 + 0.5,
+							z = z0 + 0.5,
+							yaw = between(rng, 0, 360),
+							scale = between(rng, 0.6, 0.8),
+							sink = -1,
+							solid = true,
+						})
+						-- Its cells are walls under a column, as a plinth's are.
+						for z = z0, z0 + 1 do
+							for x = x0, x0 + 1 do
+								local i = at(x, z)
+								walk[i] = false
+								kinds[i] = "pier"
+								lifts[i] = 1
+							end
+						end
+						break
+					end
+				end
+			end
+		end
+
+		-- Braziers: a coal of holy light in a bowl, lining the way between the heroes.
+		local braziers = whole(rng, 3, 5)
+		local lamps: { Point } = {}
+		local function alongRoad(t: number): (Point, Point)
+			local total, lens = 0, {}
+			for k = 2, #road do
+				local l = math.abs(road[k].x - road[k - 1].x) + math.abs(road[k].z - road[k - 1].z)
+				lens[k] = l
+				total += l
+			end
+			local want = math.clamp(t, 0, 1) * total
+			for k = 2, #road do
+				if want <= lens[k] or k == #road then
+					local a, b = road[k - 1], road[k]
+					local f = if lens[k] > 0 then math.clamp(want / lens[k], 0, 1) else 0
+					local dx, dz = b.x - a.x, b.z - a.z
+					local len = math.sqrt(dx * dx + dz * dz)
+					return { x = a.x + dx * f, z = a.z + dz * f }, {
+						x = if len > 0 then dx / len else 0,
+						z = if len > 0 then dz / len else 1,
+					}
+				end
+				want -= lens[k]
+			end
+			return road[#road], { x = 0, z = 1 }
+		end
+		for k = 1, braziers do
+			local p, dir = alongRoad((k - 0.5) / braziers)
+			local sgn = if k % 2 == 1 then -1 else 1
+			local ex, ez
+			if math.abs(dir.z) >= math.abs(dir.x) then
+				ex, ez = math.floor(p.x + sgn * (bandHalf + 1) + 0.5), math.floor(p.z + 0.5)
+			else
+				ex, ez = math.floor(p.x + 0.5), math.floor(p.z + sgn * (bandHalf + 1) + 0.5)
+			end
+			if inBounds(ex, ez) then
+				local i = at(ex, ez)
+				if kinds[i] == "flank" or kinds[i] == "retain" or kinds[i] == "terrace" then
+					local lift = if kinds[i] == "retain" then 1 elseif kinds[i] == "terrace" then lifts[i] else 0.15
+					kinds[i] = "lamp"
+					lifts[i] = lift
+					table.insert(lamps, { x = ex, z = ez })
+				end
+			end
+		end
+
+		-- Gilded waystones frame the way where it enters and leaves the hall.
+		local stones: { Point } = {}
+		for _, t in { 0.012, 0.988 } do
+			local p, dir = alongRoad(t)
+			local perp = { x = -dir.z, z = dir.x }
+			for _, sgn in { -1, 1 } do
+				local wx = math.floor(p.x + perp.x * sgn * (bandHalf + 1) + 0.5)
+				local wz = math.floor(p.z + perp.z * sgn * (bandHalf + 1) + 0.5)
+				if inBounds(wx, wz) then
+					local i = at(wx, wz)
+					if kinds[i] == "flank" or kinds[i] == "retain" or kinds[i] == "terrace" then
+						table.insert(stones, { x = wx, z = wz })
+					end
+				end
+			end
+		end
+
+		-- One or two heroes have fallen: their plinth stands empty, the colossus broken at
+		-- its foot.
+		local fallen: { [number]: boolean } = {}
+		local fallenCount = if #heroes >= 5 and rng:NextNumber() < 0.45 then whole(rng, 1, 2) else whole(rng, 0, 1)
+		for _ = 1, fallenCount do
+			local k = whole(rng, 1, #heroes)
+			for _ = 1, #heroes do
+				if fallen[k] then
+					k = k % #heroes + 1
+				end
+			end
+			fallen[k] = true
+		end
+
+		-- The heroes themselves, and the light gathering at the feet of some of them.
+		local effects: { { recipe: string, x: number, z: number, seed: number } } = {}
+		local lit = 0
+		for k, h in heroes do
+			if fallen[k] then
+				table.insert(marks, {
+					sculpt = "domain_hero_fallen",
+					x = h.x - h.tox * 1.5,
+					z = h.z - h.toz * 1.5,
+					yaw = (if h.tox ~= 0 then 90 else 0) + between(rng, -10, 10),
+					scale = between(rng, 0.72, 0.86),
+					sink = 0,
+				})
+			else
+				table.insert(marks, {
+					sculpt = HEROES[whole(rng, 1, #HEROES)],
+					x = h.x,
+					z = h.z,
+					yaw = h.yaw,
+					scale = 1,
+					sink = -plinthH,
+					solid = true,
+				})
+				if lit < 4 then
+					table.insert(effects, {
+						recipe = "domain_hero_glory",
+						x = h.x + h.tox * (pw / 2 + 0.5),
+						z = h.z + h.toz * (pw / 2 + 0.5),
+						seed = k,
+					})
+					lit += 1
+				end
+			end
+		end
+		for _, l in lamps do
+			local i = at(l.x, l.z)
+			table.insert(marks, {
+				sculpt = "domain_hall_lamp",
+				x = l.x,
+				z = l.z,
+				yaw = between(rng, 0, 360),
+				scale = between(rng, 0.95, 1.05),
+				sink = -(lifts[i] or 0),
+				solid = true,
+			})
+		end
+		for _, s in stones do
+			local i = at(s.x, s.z)
+			table.insert(marks, {
+				sculpt = "domain_waystone",
+				x = s.x,
+				z = s.z,
+				yaw = between(rng, -8, 8),
+				scale = between(rng, 1, 1.2),
+				sink = -(lifts[i] or 0),
+				solid = true,
+			})
+		end
+
+		-- The fork's shrine island carries the hall's monolith.
+		if island then
+			table.insert(marks, {
+				sculpt = "domain_waystone",
+				x = (island.x0 + island.x1) / 2,
+				z = (island.z0 + island.z1) / 2,
+				yaw = 90,
+				scale = 1.3,
+				sink = -islandH,
+				solid = true,
+			})
+			if lit < 4 then
+				table.insert(effects, {
+					recipe = "domain_hero_glory",
+					x = (island.x0 + island.x1) / 2,
+					z = (island.z0 + island.z1) / 2,
+					seed = 9,
+				})
+				lit += 1
+			end
+		end
+		-- The first brazier carries a fire.
+		if lamps[1] then
+			table.insert(effects, { recipe = "domain_brazier_fire", x = lamps[1].x, z = lamps[1].z, seed = 1 })
+		end
+
+		-- Each effect sits on the surface of its own cell: the paving, a plinth's step or
+		-- the parapet of a sunken way.
+		local effectList: { FeatureDress.Effect } = {}
+		for _, e in effects do
+			local ex = math.clamp(math.floor(e.x + 0.5), 1, w)
+			local ez = math.clamp(math.floor(e.z + 0.5), 1, d)
+			local i = at(ex, ez)
+			local kind = kinds[i]
+			local look = if kind then CELLS[kind] else nil
+			table.insert(effectList, {
