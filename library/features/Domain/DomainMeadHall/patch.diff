diff --git a/src/shared/systems/features/DomainMeadHall.luau b/src/shared/systems/features/DomainMeadHall.luau
new file mode 100644
index 00000000..7d6059da
--- /dev/null
+++ b/src/shared/systems/features/DomainMeadHall.luau
@@ -0,0 +1,535 @@
+--!strict
+-- The Eternal Domain's mead hall (roadmap areas/eternal-domain.md): the gods'
+-- feasting hall. A long paved hall on a plinth, a colonnade of shield-hung
+-- columns along both walls, long marble tables with benches and gold vessels
+-- one or two rows deep, a trench of holy fire down its middle, a golden
+-- processional way crossing it, and a high seat under a round apse at its
+-- head. The road crosses the hall between the fires, so the feature is a
+-- crossing: the fires part where the way comes through.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology
+-- first, then look). The first draws choose the structure, the rest only
+-- dress it:
+--   1. the plan: a plain long hall, or apsidal (a round wall round the high
+--      seat, so the hall's head is a half-round room);
+--   2. the walk: the hall's walls on the footprint's edge, or a processional
+--      terrace two cells wide round the hall at ground level;
+--   3. the fire: one spine trench split by the road, twin trenches flanking
+--      the central way, or three square hearth pits on the axis;
+--   4. the tables: one or two rows a side, standing whole or broken into
+--      shorter runs;
+--   5. the head: one high seat, a pair of them, or the gods' gold tree
+--      standing where the high seat would be;
+--   6. then the hall's size, the crossing's place, the parapet's height, the
+--      colonnade's spacing and the gold inlay down the paving.
+-- Built on the domain's own kit for the head and the light (the gold tree, the
+-- kneeling god's light spilling from the fire), and on four sculpts of its
+-- own: the table, the shield-hung column, the high seat and the flame.
+local FeatureDress = require("../FeatureDress")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+type Band = { z0: number, z1: number, role: string }
+type Span = { z0: number, z1: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local function pick<T>(rng: Random, list: { T }): T
+	return list[whole(rng, 1, #list)]
+end
+
+local PLANS = { "nave", "apse" }
+local FIRES = { "spine", "twin", "hearths" }
+local HEADS = { "seat", "pair", "tree" }
+local PATTERNS = { "bars", "ring", "both", "none" }
+
+local feature: MapFeature.Feature = {
+	name = "DomainMeadHall",
+	about = "The gods' mead hall: long marble tables and gold vessels between trenches of holy fire, shields on the colonnade, and a high seat at its head.",
+	tileset = "domain",
+	scale = "centrepiece",
+	role = "crossing",
+	mood = { "monumental", "feasting", "gold-lit", "colossal" },
+	cells = {
+		-- The hall's paving: dressed ivory, a shade warmer than the domain's
+		-- open marble, so the hall reads as built ground from above.
+		floor = { ground = { material = "Slate", color = { 234, 228, 214 } }, lift = 0.1, clear = true },
+		-- The processional terrace round the hall.
+		walk = { ground = { material = "Concrete", color = { 222, 214, 196 } }, lift = 0.1, clear = true },
+		-- Under the tables: a darker stone, hidden by the tabletop anyway.
+		table = { ground = { material = "Cobblestone", color = { 206, 200, 184 } }, lift = 0.05, clear = true },
+		-- The fire trench's bed, deep gold-brown, two studs under the floor.
+		-- Its flames are props of their own (domain_mead_flame), scattered a
+		-- cell and a half, so the whole channel burns and not just one point.
+		trench = {
+			ground = { material = "Basalt", color = { 106, 84, 52 } },
+			lift = 0.1,
+			clear = true,
+			props = { { sculpt = "domain_mead_flame", every = 1.8, scale = { 0.8, 1.25 }, sink = 0.15 } },
+		},
+		-- The wall ring and the apse's curved wall. Its height is drawn per
+		-- seed (lifts on these cells), a low balustrade or a tall wall.
+		parapet = { ground = { material = "Rock", color = { 210, 202, 186 } }, lift = 1.5, clear = true },
+		dais = { ground = { material = "Marble", color = { 214, 208, 194 } }, lift = 0.1, clear = true },
+		step = { ground = { material = "Limestone", color = { 202, 194, 178 } }, lift = 0.1, clear = true },
+		-- The road's own warm gold paving, the colour the domain lays on its
+		-- roads, carried through the hall as the processional way.
+		procession = { ground = { material = "Pavement", color = { 226, 212, 184 } }, lift = 0.12, clear = true },
+		-- Gold inlay in the paving: the kerb along the fires and the hall's
+		-- bands. Gold is trim here, not a surface (bible B12).
+		gold = { ground = { material = "Salt", color = { 214, 178, 100 } }, lift = 0.14, clear = true },
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-5: the structure, first.
+		local plan = pick(rng, PLANS)
+		local terrace = if rng:NextNumber() < 0.42 then 2 else 0
+		local fire = pick(rng, FIRES)
+		local rows = if rng:NextNumber() < 0.5 then 1 else 2
+		local head = pick(rng, HEADS)
+
+		-- 6: the hall's size and the crossing's place inside it.
+		local hallLen = whole(rng, 46, 50)
+		local hallWide = if rows == 1 then 21 + 2 * whole(rng, 0, 3) else 27 + 2 * whole(rng, 0, 3)
+		local w = hallLen + 2 + 2 * terrace
+		local d = hallWide + 2 + 2 * terrace
+		local wallN, wallS = terrace + 1, d - terrace
+		local wallW, wallE = terrace + 1, w - terrace
+		local hallN, hallS = wallN + 1, wallS - 1
+		local hallW, hallE = wallW + 1, wallE - 1
+		local zc = (hallN + hallS) // 2
+		local daisX = if plan == "apse" then hallE - 7 else hallE - 4
+		local xc = whole(rng, hallW + 7, daisX - 8)
+		local corridor0, corridor1 = xc - 1, xc + 1
+
+		-- 6, still: the dress the seeds vary in, drawn now so the structure
+		-- above never changes with them.
+		local tableChance = between(rng, 0.58, 0.94)
+		local colGap = whole(rng, 4, 6)
+		local parapetLift = between(rng, 1.5, 6.5)
+		local pattern = pick(rng, PATTERNS)
+		local goldGap = whole(rng, 6, 9)
+
+		local n = w * d
+		local walk = table.create(n, false)
+		local heights = table.create(n, 0)
+		local kinds: { [number]: string } = {}
+		local lifts: { [number]: number } = {}
+		local marks: { FeatureDress.Landmark } = {}
+		local effects: { FeatureDress.Effect } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		local function set(x: number, z: number, ok: boolean, h: number, kind: string?)
+			if x < 1 or z < 1 or x > w or z > d then
+				return
+			end
+			local i = at(x, z)
+			walk[i] = ok
+			heights[i] = h
+			kinds[i] = kind
+		end
+
+		-- The footprint is the hall's stone mass; the walk and the floor are
+		-- cut into it.
+		for z = 1, d do
+			for x = 1, w do
+				set(x, z, false, 4, "parapet")
+			end
+		end
+		if terrace > 0 then
+			for z = 1, d do
+				for x = 1, w do
+					if x <= terrace or z <= terrace or x > w - terrace or z > d - terrace then
+						set(x, z, true, 0, "walk")
+					end
+				end
+			end
+		end
+		for z = hallN, hallS do
+			for x = hallW, hallE do
+				set(x, z, true, 4, "floor")
+			end
+		end
+
+		-- The cross-section, north to south: outer aisle, table row(s), the
+		-- middle span (open floor and the fires), and back again.
+		local a, t, m, b = 2, 2, 1, 2
+		local middle = hallWide - 2 * a - 2 * t * rows - 2 * m * (rows - 1) - 2 * b
+		local fw, cw = 1, (if fire == "twin" then 5 else 0)
+		local open = if fire == "hearths" then middle else middle - 2 * fw - cw
+		local openL = open // 2
+		local bands: { Band } = {}
+		local z = hallN
+		local function band(role: string, count: number)
+			if count > 0 then
+				table.insert(bands, { z0 = z, z1 = z + count - 1, role = role })
+				z += count
+			end
+		end
+		band("walk", a)
+		band("table", t)
+		if rows == 2 then
+			band("walk", m)
+			band("table", t)
+		end
+		band("walk", b)
+		if fire == "hearths" then
+			band("walk", middle)
+		else
+			band("walk", openL)
+			band("fire", fw)
+			if fire == "twin" then
+				band("walk", cw)
+			end
+			band("fire", fw)
+			band("walk", open - openL)
+		end
+		band("walk", b)
+		if rows == 2 then
+			band("table", t)
+			band("walk", m)
+		end
+		band("table", t)
+		band("walk", a)
+
+		-- The fires, one span per trench (adjacent bands are one trench).
+		local fires: { Span } = {}
+		local last: Span? = nil
+		local tableBands: { Band } = {}
+		for _, bd in bands do
+			if bd.role == "fire" then
+				if last and bd.z0 == last.z1 + 1 then
+					last.z1 = bd.z1
+				else
+					local span: Span = { z0 = bd.z0, z1 = bd.z1 }
+					table.insert(fires, span)
+					last = span
+				end
+			else
+				last = nil
+				if bd.role == "table" then
+					table.insert(tableBands, bd)
+				end
+			end
+		end
+
+		-- The hall's working length: from the west aisle to the dais's steps.
+		local westStart = hallW + 2
+		local eastLimit = daisX - 4
+		local function inCorridor(x: number): boolean
+			return x >= corridor0 and x <= corridor1
+		end
+
+		-- The trench: two long runs, parted by the road at the crossing.
+		for _, span in fires do
+			for zz = span.z0, span.z1 do
+				for x = hallW + 1, eastLimit do
+					if not inCorridor(x) then
+						set(x, zz, false, 2, "trench")
+					end
+				end
+			end
+		end
+		-- Or three square hearth pits on the axis, clear of the road.
+		local pits: { number } = {}
+		if fire == "hearths" then
+			local spots: { number } = {}
+			for x = hallW + 3, daisX - 5 do
+				if math.abs(x - xc) >= 5 then
+					table.insert(spots, x)
+				end
+			end
+			if #spots >= 3 then
+				for k = 1, 3 do
+					local idx = math.floor((k - 0.5) * #spots / 3) + 1
+					table.insert(pits, spots[math.min(idx, #spots)])
+				end
+			end
+			for _, px in pits do
+				for zz = zc - 1, zc + 1 do
+					for x = px - 1, px + 1 do
+						set(x, zz, false, 2, "trench")
+					end
+				end
+			end
+		end
+
+		-- The long tables: four-cell lengths set end to end, some gone (a
+		-- broken row still leaves the floor walkable where it is missing).
+		for _, bd in tableBands do
+			local zMid = (bd.z0 + bd.z1) / 2
+			for x = westStart, eastLimit - 3, 4 do
+				if not (x <= corridor1 and x + 3 >= corridor0) then
+					if rng:NextNumber() < tableChance then
+						for zz = bd.z0, bd.z1 do
+							for xx = x, x + 3 do
+								set(xx, zz, false, 4, "table")
+							end
+						end
+						table.insert(marks, {
+							sculpt = "domain_mead_table",
+							x = x + 1.5,
+							z = zMid,
+							yaw = 0,
+							sink = 0.05,
+						})
+					end
+				end
+			end
+		end
+
+		-- The dais and the high seat, against the hall's head.
+		local halfX = 2
+		local halfZ = if head == "pair" then 3 else 2
+		for zz = zc - halfZ - 1, zc + halfZ + 1 do
+			for x = daisX - halfX - 1, daisX + halfX + 1 do
+				if math.abs(x - daisX) <= halfX and math.abs(zz - zc) <= halfZ then
+					set(x, zz, true, 7, "dais")
+				else
+					set(x, zz, true, 5.5, "step")
+				end
+			end
+		end
+		local function plinth(x0: number, z0: number, x1: number, z1: number)
+			for zz = z0, z1 do
+				for x = x0, x1 do
+					set(x, zz, false, 7, "dais")
+				end
+			end
+		end
+		if head == "pair" then
+			plinth(daisX - 1, zc - 3, daisX, zc - 2)
+			plinth(daisX - 1, zc + 2, daisX, zc + 3)
+			for _, zz in { zc - 2.5, zc + 2.5 } do
+				table.insert(marks, {
+					sculpt = "domain_high_seat",
+					x = daisX,
+					z = zz,
+					yaw = 180,
+					scale = 0.9,
+					sink = 0.2,
+					solid = true,
+				})
+			end
+		else
+			plinth(daisX - 1, zc - 1, daisX + 1, zc + 1)
+			if head == "tree" then
+				table.insert(marks, {
+					sculpt = "domain_gold_tree",
+					x = daisX,
+					z = zc,
+					yaw = between(rng, 0, 360),
+					sink = 0.3,
+					solid = true,
+				})
+			else
+				table.insert(marks, {
+					sculpt = "domain_high_seat",
+					x = daisX,
+					z = zc,
+					yaw = 180,
+					sink = 0.2,
+					solid = true,
+				})
+			end
+		end
+
+		-- The apse: the head's floor rounded off inside the circle round the
+		-- high seat; the corners outside it are the hall's stone.
+		if plan == "apse" then
+			local rap = 7
+			for zz = hallN, hallS do
+				for x = daisX, hallE do
+					local dx, dz = x - daisX, zz - zc
+					if dx * dx + dz * dz > rap * rap and kinds[at(x, zz)] == "floor" then
+						set(x, zz, false, 4, "parapet")
+					end
+				end
+			end
+		end
+
+		-- The processional way: a broad golden road through the wall, over the
+		-- terrace and across the hall, between the fires.
+		for x = corridor0, corridor1 do
+			for zz = 1, d do
+				local h = 4
+				if zz <= wallN then
+					h = if zz == wallN then 2 else 0
+				elseif zz >= wallS then
+					h = if zz == wallS then 2 else 0
+				end
+				set(x, zz, true, h, "procession")
+			end
+		end
+
+		-- Gold: the kerb along every fire, then the hall's bands.
+		local function paintGold(x: number, zz: number)
+			if x < 1 or zz < 1 or x > w or zz > d then
+				return
+			end
+			local i = at(x, zz)
+			if walk[i] and kinds[i] == "floor" then
+				kinds[i] = "gold"
+			end
+		end
+		for zz = hallN, hallS do
+			for x = hallW, hallE do
+				if kinds[at(x, zz)] == "trench" then
+					paintGold(x + 1, zz)
+					paintGold(x - 1, zz)
+					paintGold(x, zz + 1)
+					paintGold(x, zz - 1)
+				end
+			end
+		end
+		if pattern == "bars" or pattern == "both" then
+			for x = hallW + 3, daisX - 5, goldGap do
+				for zz = hallN, hallS do
+					paintGold(x, zz)
+				end
+			end
+		end
+		if pattern == "ring" or pattern == "both" then
+			for zz = zc - halfZ - 2, zc + halfZ + 2 do
+				for x = daisX - halfX - 2, daisX + halfX + 2 do
+					if math.abs(x - daisX) == halfX + 2 or math.abs(zz - zc) == halfZ + 2 then
+						paintGold(x, zz)
+					end
+				end
+			end
+		end
+
+		-- The colonnade: shield-hung columns along both walls, facing the hall.
+		-- The wall rises in a pier under each column, so the long walls read
+		-- as bays from inside and out.
+		local piers: { [number]: boolean } = {}
+		local colEnd = if plan == "apse" then daisX - 1 else hallE - 2
+		for x = hallW + 2, colEnd, colGap do
+			if math.abs(x - xc) > 5 then
+				if kinds[at(x, wallN)] == "parapet" then
+					piers[at(x, wallN)] = true
+					table.insert(marks, {
+						sculpt = "domain_mead_column",
+						x = x,
+						z = wallN,
+						yaw = -90,
+						sink = 0.1,
+						solid = true,
+					})
+				end
+				if kinds[at(x, wallS)] == "parapet" then
+					piers[at(x, wallS)] = true
+					table.insert(marks, {
+						sculpt = "domain_mead_column",
+						x = x,
+						z = wallS,
+						yaw = 90,
+						sink = 0.1,
+						solid = true,
+					})
+				end
+			end
+		end
+
+		-- The wall's height: a low balustrade or a high wall, per seed; the
+		-- piers stand above it, and the head wall behind the high seat rises
+		-- as the hall's tall gable, the backdrop of its photograph.
+		local headLift = between(rng, 14, 22)
+		for zz = 1, d do
+			for x = 1, w do
+				local i = at(x, zz)
+				if kinds[i] == "parapet" then
+					lifts[i] = parapetLift
+					if x == wallE or (plan == "apse" and x >= daisX) then
+						lifts[i] = headLift
+					elseif piers[i] then
+						lifts[i] = parapetLift + 2.5
+					end
+				end
+			end
+		end
+
+		-- The gates: a triumphal arch over each way in, its piers on the wall
+		-- either side of the road and its passage spanning the corridor.
+		for _, zz in { wallN, wallS } do
+			table.insert(marks, {
+				sculpt = "domain_triumphal_arch",
+				x = xc,
+				z = zz,
+				yaw = 0,
+				sink = 0,
+				solid = true,
+			})
+		end
+
+		-- The fires' light: one set piece per run or pit.
+		if fire == "hearths" then
+			for _, px in pits do
+				table.insert(effects, { recipe = "domain_trench_fire", x = px, z = zc, lift = 0.4 })
+			end
+		else
+			for _, span in fires do
+				local zMid = (span.z0 + span.z1) / 2
+				for _, run in { { hallW + 1, corridor0 - 1 }, { corridor1 + 1, eastLimit } } do
+					if run[2] - run[1] + 1 >= 6 then
+						table.insert(effects, {
+							recipe = "domain_trench_fire",
+							x = (run[1] + run[2]) / 2,
+							z = zMid,
+							lift = 0.4,
+						})
+					end
+				end
+			end
+		end
+
+		-- The road: in from one border, up through the gate, across the hall
+		-- between the fires, and out the far wall.
+		local road: { Point } = {
+			{ x = xc, z = 1 },
+			{ x = xc, z = wallN },
+			{ x = xc, z = zc },
+			{ x = xc, z = wallS },
+			{ x = xc, z = d },
+		}
+		-- One camera down the fire to the high seat, one along the tables
+		-- from the hall's south aisle, under the shields. The first stands
+		-- back at least sixteen cells from the dais, so the seat is framed
+		-- whatever place the road crosses at.
+		local approach = math.min(xc, daisX - 22)
+		local cameras: { MapFeature.Shot } = {
+			{
+				name = "down the fire to the high seat",
+				from = { x = approach, z = zc, lift = 7 },
+				to = { x = daisX, z = zc, lift = 9 },
+				fov = 52,
+			},
+			{
+				name = "along the tables, under the shields",
+				from = { x = hallW + 2 + colGap / 2, z = hallS - 2, lift = 7 },
+				to = { x = daisX - 3, z = zc, lift = 8 },
+				fov = 60,
+			},
+		}
+		return {
+			width = w,
+			depth = d,
+			walk = walk,
+			heights = heights,
+			kinds = kinds,
+			lifts = lifts,
+			marks = marks,
+			effects = effects,
+			road = road,
+			cameras = cameras,
+		}
+	end,
+}
+
+return feature
