+	["sculpt:domain_guardian"] = row(
+		"A tomb guardian of the Eternal Domain: a winged colossus in marble on a stepped plinth, a gold crest on its helm and both hands on a planted sword.",
+		MOOR
+	),
+	["sculpt:domain_tomb_lamp"] = row(
+		"The Eternal Domain's tomb lamp: a pale marble chalice on a stepped stem, its gold bowl a flame of holy light.",
+		MOOR
+	),
 }
 
 return table.freeze(rows)
diff --git a/src/shared/systems/features/DomainMausoleum.luau b/src/shared/systems/features/DomainMausoleum.luau
new file mode 100644
index 00000000..4836ce3e
--- /dev/null
+++ b/src/shared/systems/features/DomainMausoleum.luau
@@ -0,0 +1,600 @@
+--!strict
+-- The Mausoleum of a God, a feature for the Eternal Domain (bible B12): a colossal
+-- tomb on a stepped plinth of ivory terraces, its cella walled in white stone under a
+-- gilded pediment, its gold door standing ajar on a dark sanctum where a god's
+-- sarcophagus lies; a colonnade walks the plateau's rim, colossi guard the stair and
+-- the door, and a road crosses the plaza at its foot. The Domain has halls, gates and
+-- spires (the kit), but no place a god is buried.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first,
+-- then look). The first draws choose the structure, the rest only dress it:
+--   1. the tomb: a deep cella, a broad heroon, a round drum, or a cella within its
+--      walled precinct with a gate front and back;
+--   2. the plinth: concentric square terraces, concentric round ones, or straight
+--      bands climbing from the road to the tomb (a processional ascent);
+--   3. how many tiers and how wide their terraces (4 to 6 tiers of 4 studs, 2 to 3
+--      cells a band), which sets the plateau's height and the plinth's reach;
+--   4. the colonnade: a peristyle round the plateau, a portico across the tomb's
+--      front, two avenues down the stair's sides, or none;
+--   5. the guardians: two at the door, two at the stair's foot, both, or none;
+--   6. then the road's way out (east, west or round the plinth to the north), the
+--      wall's height, the lamps and the small turns of the dressing.
+-- Everything stands on the Domain's own stone and gold (the domain_ kit, the
+-- domain_ theme), and the new pieces are its mausoleum, its door, its sarcophagus,
+-- its guardians, its lamp, its roofs and the light sealed across its threshold.
+local FeatureDress = require("../FeatureDress")
+local Grid = require("../Grid")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local function pick(rng: Random, list: { string }): string
+	return list[whole(rng, 1, #list)]
+end
+
+-- Ivory stone for the ground, inside the Domain's own limits (B12: stone value
+-- 0.75-0.92, saturation at most 0.20): the plaza, the three terrace tones, the gold
+-- of the processional stair and the plateau's rim (gold is the Domain's crown, and
+-- here it is the way up), the marble plateau (the tileset's own Marble colour, since
+-- Roblox colours a material once), the dark sanctum floor, and the white salt stone
+-- of the tomb. The terraces step through three tones and the coping is darker still,
+-- so a colossus of steps reads from the game camera and not as one pale mass.
+local APRON = { material = "Concrete", color = { 216, 209, 194 } }
+local STEP_LIGHT = { material = "Concrete", color = { 234, 227, 211 } }
+local STEP_MID = { material = "Concrete", color = { 216, 209, 193 } }
+local STEP_DARK = { material = "Concrete", color = { 196, 189, 173 } }
+local STAIR = { material = "Concrete", color = { 226, 192, 126 } }
+local PLATEAU = { material = "Marble", color = { 214, 208, 194 } }
+local SANCTUM = { material = "Basalt", color = { 44, 42, 50 } }
+local TOMB_STONE = { material = "Salt", color = { 232, 227, 215 } }
+local COPING = { material = "Concrete", color = { 192, 184, 168 } }
+local RIM = { material = "Concrete", color = { 220, 182, 106 } }
+local LAMP_STONE = { material = "Concrete", color = { 226, 219, 202 } }
+
+-- The Domain's holy light (EnvThemes `domain`): gold on the threshold, warm white
+-- in the lamps.
+local HOLY = { 255, 226, 160 }
+
+local TOMBS = { "deep", "broad", "round", "precinct" }
+local PLINTHS = { "square", "round", "bands" }
+local COLONNADES = { "peristyle", "portico", "avenue", "none" }
+local GUARDS = { "door", "stair", "both", "none" }
+
+local feature: MapFeature.Feature = {
+	name = "DomainMausoleum",
+	about = "A god's mausoleum: a white cella under a gilded roof on a stepped ivory plinth, its gold door ajar on a colossal sarcophagus, guarded by colossi and ringed by a colonnade.",
+	tileset = "domain",
+	scale = "centrepiece",
+	role = "centrepiece",
+	mood = { "monumental", "sealed", "gilded", "processional", "awe" },
+	cells = {
+		-- The plaza at the plinth's foot, where the road crosses.
+		apron = { ground = APRON, lift = 0.15, clear = true },
+		-- The terraces, three pale tones so every tier reads from the game camera.
+		step1 = { ground = STEP_LIGHT, lift = 0.15, clear = true },
+		step2 = { ground = STEP_MID, lift = 0.15, clear = true },
+		step3 = { ground = STEP_DARK, lift = 0.15, clear = true },
+		-- The stair through a coping ring, gilded: the god's way up, half a rise a step.
+		stair = { ground = STAIR, lift = 0.15, clear = true },
+		-- The plateau court, on the tileset's own marble.
+		plateau = { ground = PLATEAU, lift = 0.2, clear = true },
+		-- The chamber's floor: dark basalt, so the white god and its gold read in the door.
+		sanctum = { ground = SANCTUM, lift = 0.2, clear = true },
+		-- The tomb's own stone: bright white salt, its cells lifted into walls.
+		tomb = { ground = TOMB_STONE, clear = true },
+		-- The flush coping of each terrace's retaining ring, and the gilded ring round
+		-- the plateau's own lip.
+		coping = { ground = COPING, lift = 4, clear = true },
+		rim = { ground = RIM, lift = 4, clear = true },
+		door = { ground = SANCTUM, lift = 0.2, clear = true },
+		-- A lamp cell: one pedestal lamp of our own (a mark, placed on the cell) and its
+		-- light in the bowl.
+		lamp = {
+			ground = LAMP_STONE,
+			lift = 0.2,
+			clear = true,
+			glow = { color = HOLY, range = 18, brightness = 1.3, every = 1, height = 9.6 },
+		},
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		local w, d = 56, 56
+		local cx, cz = (w + 1) / 2, (d + 1) / 2
+
+		-- 1-2: the tomb and the plinth, the two big structures.
+		local tomb = pick(rng, TOMBS)
+		local plinth = pick(rng, PLINTHS)
+		-- The cella's half extents (cells, from a cell boundary), and a precinct ring's
+		-- where there is one.
+		local ax, az = 8, 6
+		local ringAx, ringAz = 0, 0
+		if tomb == "broad" then
+			ax, az = 9, 6
+		elseif tomb == "round" then
+			ax, az = 8, 8
+		elseif tomb == "precinct" then
+			ax, az = 7, 5
+			ringAx, ringAz = 11.5, 9.5
+		end
+		local reach = math.max(ax, az, ringAx, ringAz)
+		local minR = math.ceil(reach + 3)
+		-- 3: the tiers, their band width and the plateau's reach.
+		local tiers = whole(rng, 4, 6)
+		local band = if tiers * 3 <= 25 - minR then whole(rng, 2, 3) else 2
+		local slack = math.max(0, math.min(2, 25 - minR - tiers * band))
+		local plateauR = minR + whole(rng, 0, slack)
+		local Rp = plateauR + tiers * band
+		local apron = 28 - Rp
+		local rise = 4
+		local plateauH = tiers * rise
+		-- The plateau's walkable half extent: the tier stops climbing one band before
+		-- the plinth's edge, and that band's outer ring is its coping.
+		local plateauHalf = plateauR + band - 1
+		-- Where the tomb stands: the plateau's middle, nearer its back than its front.
+		-- Its middle is a cell boundary (an n.5 coordinate), so the walls and the door
+		-- fall in whole cells either side of it. It is placed by its outermost walls
+		-- (a precinct ring reaches further than its cella), and kept a court in from
+		-- the plateau's lip on every side.
+		local function half(n: number): number
+			return math.floor(n) + 0.5
+		end
+		local outerZ = math.max(az, ringAz)
+		local court = whole(rng, 3, 5)
+		local tcx, tcz
+		if plinth == "bands" then
+			-- The bands climb from the front; the plateau is the back of the plinth.
+			local frontEdge = cz + Rp - (tiers - 1) * band
+			local mid = (frontEdge + (cz - Rp)) / 2 - whole(rng, 0, 1)
+			tcx = cx
+			tcz = half(math.clamp(mid, cz - Rp + outerZ + 1, frontEdge - outerZ - court))
+		else
+			tcx = cx
+			tcz = half(cz + plateauHalf - outerZ - court)
+		end
+		-- The wall's height, and how tall the door is let to be (it stands under the roof).
+		local wallHeight = whole(rng, 36, 44)
+		local precinctH = whole(rng, 8, 12)
+		-- The front face of the cella, in cells (the front wall's outer edge).
+		local frontFace = if tomb == "round" then tcz + ax else tcz + az
+
+		local walk = table.create(w * d, true)
+		local heights = table.create(w * d, 0)
+		local kinds: { [number]: string } = {}
+		local lifts: { [number]: number } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+
+		-- The plinth's plan: how far out from its middle (or its front, for bands) a cell is.
+		local function metric(x: number, z: number): number
+			if plinth == "round" then
+				return math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2)
+			elseif plinth == "bands" then
+				if math.abs(x - cx) > Rp or z > cz + Rp or z < cz - Rp then
+					return math.huge
+				end
+				return (cz + Rp) - z
+			end
+			return math.max(math.abs(x - cx), math.abs(z - cz))
+		end
+		local function tierAt(x: number, z: number): number
+			local m = metric(x, z)
+			if m == math.huge then
+				return 0
+			end
+			if plinth == "bands" then
+				return math.clamp(math.floor(m / band) + 1, 0, tiers)
+			end
+			if m > Rp then
+				return 0
+			end
+			return math.min(tiers, math.floor((Rp - m) / band) + 1)
+		end
+
+		-- 4: the terraces, each a walkable band ringed by a flush coping wall; the stair
+		-- cuts the coping at the front (and, on the ring plans, at the back too).
+		local hw = whole(rng, 3, 5)
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				local t = tierAt(x, z)
+				if t == 0 then
+					walk[i] = true
+					heights[i] = 0
+					kinds[i] = "apron"
+					continue
+				end
+				local boundary, low = false, t
+				for _, nb in Grid.NEIGHBOURS do
+					local other = tierAt(x + nb[1], z + nb[2])
+					if other < t then
+						boundary = true
+						low = math.min(low, other)
+					end
+				end
+				if boundary and low == t - 1 and math.abs(x - cx) <= hw then
+					-- A stair through the coping: half a rise, walkable either side.
+					walk[i] = true
+					heights[i] = t * rise - 2
+					kinds[i] = "stair"
+				elseif boundary then
+					walk[i] = false
+					heights[i] = (t - 1) * rise
+					kinds[i] = if t == tiers then "rim" else "coping"
+				else
+					walk[i] = true
+					heights[i] = t * rise
+					kinds[i] = if t == tiers then "plateau" else `step{t % 3 + 1}`
+				end
+			end
+		end
+
+		-- 5: the tomb. Its walls are cells of the plateau lifted into stone; the chamber
+		-- is a dark walkable room, and the door a slot through the front wall.
+		local function tombCell(x: number, z: number): string?
+			local dx, dz = x - tcx, z - tcz
+			if ringAx > 0 then
+				local inRing = math.abs(dx) <= ringAx
+					and math.abs(dz) <= ringAz
+					and not (math.abs(dx) < ringAx - 1 and math.abs(dz) < ringAz - 1)
+				if inRing then
+					-- The gates cut the ring's whole thickness, front and back.
+					if math.abs(dx) <= 1 and math.abs(dz) >= ringAz - 1 then
+						return "gate"
+					end
+					return "ring"
+				end
+			end
+			if tomb == "round" then
+				local r = math.sqrt(dx * dx + dz * dz)
+				if r > ax then
+					return nil
+				end
+				if r <= ax - 2 then
+					return "chamber"
+				end
+				if math.abs(dx) <= 1.5 and dz > 0 then
+					return "door"
+				end
+				return "wall"
+			end
+			if math.abs(dx) > ax or math.abs(dz) > az then
+				return nil
+			end
+			if math.abs(dx) <= ax - 2 and math.abs(dz) <= az - 2 then
+				return "chamber"
+			end
+			if math.abs(dx) <= 1.5 and dz > az - 2 then
+				return "door"
+			end
+			return "wall"
+		end
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				local cell = tombCell(x, z)
+				if cell == "wall" then
+					walk[i] = false
+					heights[i] = plateauH
+					kinds[i] = "tomb"
+					lifts[i] = wallHeight
+				elseif cell == "ring" then
+					walk[i] = false
+					heights[i] = plateauH
+					kinds[i] = "tomb"
+					lifts[i] = precinctH
+				elseif cell == "chamber" then
+					walk[i] = true
+					heights[i] = plateauH
+					kinds[i] = "sanctum"
+				elseif cell == "door" or cell == "gate" then
+					walk[i] = true
+					heights[i] = plateauH
+					kinds[i] = if cell == "door" then "door" else "plateau"
+				end
+			end
+		end
+
+		-- One walkable ground: a round plinth's coping can pinch a few terrace cells
+		-- off at a diagonal, so any pocket that does not join the plaza is walled.
+		do
+			local g = Grid.new(w, d, Grid.WALL)
+			for i, ok in walk do
+				g.cells[i] = if ok then Grid.FLOOR else Grid.WALL
+			end
+			local regions = Grid.regions(g)
+			if #regions > 1 then
+				local keep = nil
+				for _, region in regions do
+					for _, i in region do
+						local x, z = Grid.coords(g, i)
+						if x == 1 or z == 1 or x == w or z == d then
+							keep = region
+							break
+						end
+					end
+					if keep then
+						break
+					end
+				end
+				for _, region in regions do
+					if region ~= keep then
+						for _, i in region do
+							walk[i] = false
+							kinds[i] = "coping"
+						end
+					end
+				end
+			end
+		end
+
+		local marks: { FeatureDress.Landmark } = {}
+		local effects: { FeatureDress.Effect } = {}
+		local function standing(x: number, z: number): boolean
+			local gx, gz = math.floor(x + 0.5), math.floor(z + 0.5)
+			return gx >= 1 and gx <= w and gz >= 1 and gz <= d and walk[at(gx, gz)]
+		end
+		local function nearTomb(x: number, z: number, margin: number): boolean
+			local dx, dz = math.abs(x - tcx), math.abs(z - tcz)
+			local rx, rz = math.max(ax, ringAx), math.max(az, ringAz)
+			return dx <= rx + margin and dz <= rz + margin
+		end
+
+		-- 6: the colonnade.
+		local colonnade = pick(rng, COLONNADES)
+		local columnScale = between(rng, 0.66, 0.82)
+		local columnStep = whole(rng, 4, 6)
+		local function column(x: number, z: number, scale: number?)
+			if not standing(x, z) or nearTomb(x, z, 1.5) then
+				return
+			end
+			if math.abs(x - cx) <= hw + 1 and z > cz then
+				return
+			end
+			table.insert(marks, {
+				sculpt = "domain_column",
+				x = x,
+				z = z,
+				yaw = whole(rng, 0, 3) * 90,
+				scale = (scale or columnScale) * between(rng, 0.94, 1.06),
+				sink = 0.2,
+				solid = true,
+			})
+		end
+		if colonnade == "peristyle" then
+			local r = plateauHalf - 1.5
+			local count = whole(rng, 10, 16)
+			local first = between(rng, 0, 2 * math.pi)
+			for k = 0, count - 1 do
+				local a = first + k * 2 * math.pi / count
+				local u = if plinth == "round" then r else r / math.max(math.abs(math.cos(a)), math.abs(math.sin(a)))
+				column(cx + u * math.cos(a), cz + u * math.sin(a))
+			end
+		elseif colonnade == "portico" then
+			local count = whole(rng, 5, 7)
+			local reachX = ax + 1
+			local scale = between(rng, 0.64, 0.74)
+			for k = 0, count - 1 do
+				local x = tcx - reachX + 2 * reachX * (if count > 1 then k / (count - 1) else 0.5)
+				column(x, frontFace + 2.6, scale)
+			end
+		elseif colonnade == "avenue" then
+			local z0 = frontFace + 3
+			local z1 = if plinth == "bands" then cz + Rp - (tiers - 1) * band - 1.5 else cz + plateauHalf - 2
+			local steps = math.max(1, math.floor((z1 - z0) / columnStep))
+			for k = 0, steps do
+				local z = z0 + (z1 - z0) * k / steps
+				table.insert(marks, {
+					sculpt = "domain_column",
+					x = tcx - hw - 1.5,
+					z = z,
+					yaw = whole(rng, 0, 3) * 90,
+					scale = columnScale * between(rng, 0.94, 1.06),
+					sink = 0.2,
+					solid = true,
+				})
+				table.insert(marks, {
+					sculpt = "domain_column",
+					x = tcx + hw + 1.5,
+					z = z,
+					yaw = whole(rng, 0, 3) * 90,
+					scale = columnScale * between(rng, 0.94, 1.06),
+					sink = 0.2,
+					solid = true,
+				})
+			end
+		end
+
+		-- 7: the guardians, at the door or the stair's foot.
+		local guard = pick(rng, GUARDS)
+		local function guardian(x: number, z: number, face: number, scale: number)
+			if not standing(x, z) then
+				return
+			end
+			table.insert(marks, {
+				sculpt = "domain_guardian",
+				x = x,
+				z = z,
+				yaw = face,
+				scale = scale,
+				sink = 0.2,
+				solid = true,
+			})
+		end
+		if guard == "door" or guard == "both" then
+			local off = ax + 2.6
+			local scale = between(rng, 0.98, 1.14)
+			guardian(tcx - off, frontFace + 2.4, -90, scale)
+			guardian(tcx + off, frontFace + 2.4, -90, scale * between(rng, 0.96, 1.04))
+		end
+		if guard == "stair" or guard == "both" then
+			local off = hw + 2.6
+			local scale = between(rng, 1.02, 1.2)
+			guardian(cx - off, cz + Rp + 2, -90, scale)
+			guardian(cx + off, cz + Rp + 2, -90, scale * between(rng, 0.96, 1.04))
+		end
+
+		-- 8: the lamps: a pair at the stair's foot, and a pair at the door (if the
+		-- guardians leave the cell free).
+		local function lamp(x: number, z: number)
+			local gx, gz = math.floor(x + 0.5), math.floor(z + 0.5)
+			if not standing(gx, gz) then
+				return
+			end
+			local i = at(gx, gz)
+			if kinds[i] == "lamp" then
+				return
+			end
+			for _, m in marks do
+				if m.sculpt ~= "domain_column" and math.abs(m.x - gx) < 1.2 and math.abs(m.z - gz) < 1.2 then
+					return
+				end
+			end
+			kinds[i] = "lamp"
+			table.insert(marks, {
+				sculpt = "domain_tomb_lamp",
+				x = gx,
+				z = gz,
+				yaw = whole(rng, 0, 3) * 90,
+				scale = between(rng, 0.96, 1.08),
+				sink = 0.2,
+			})
+		end
+		lamp(cx - hw - 1, cz + Rp + 2)
+		lamp(cx + hw + 1, cz + Rp + 2)
+		if rng:NextNumber() < 0.75 then
+			lamp(tcx - ax - 4, frontFace + 2.6)
+			lamp(tcx + ax + 4, frontFace + 2.6)
+		end
+
+		-- 9: the tomb's own standing pieces.
+		local roofScale = if tomb == "precinct" then 0.82 else 1
+		local roof = if tomb == "round"
+			then "domain_mausoleum_dome"
+			elseif tomb == "broad" then "domain_mausoleum_roof_broad"
+			else "domain_mausoleum_roof"
+		table.insert(marks, {
+			sculpt = roof,
+			x = tcx,
+			z = tcz,
+			-- The roof's pediment faces the door, which looks along +Z.
+			yaw = if tomb == "round" then whole(rng, 0, 3) * 90 else -90,
+			scale = roofScale,
+			sink = -wallHeight,
+			solid = true,
+		})
+		table.insert(marks, {
+			sculpt = "domain_mausoleum_door",
+			x = tcx,
+			z = frontFace,
+			yaw = -90,
+			scale = math.min(1, (wallHeight - 1) / 40),
+			sink = 0,
+			solid = true,
+		})
+		local sarcScale = if tomb == "precinct" then 0.95 elseif tomb == "round" then 1.05 else 1.2
+		table.insert(marks, {
+			sculpt = "domain_sarcophagus",
+			x = tcx,
+			z = tcz + math.min(2.2, az - 3.4),
+			yaw = 0,
+			scale = sarcScale,
+			sink = 0,
+			solid = true,
