--- /dev/null
+++ b/src/shared/systems/features/DomainArenaOfChampions.luau
@@ -0,0 +1,560 @@
+--!strict
+-- The arena of champions, for the Eternal Domain (bible B12): an oval fighting floor
+-- sunk below rings of marble seating, with a grand processional stair down into it
+-- under a triumphal gate at either end, a canopied royal box over one long side,
+-- weapon racks on the sand and the champions' medallion at the heart of the floor.
+-- The Domain is ivory and gold under holy light; it has no place where a crowd
+-- came to watch, and no ground cut open.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first,
+-- then look). The first draws choose the structure, the rest only dress it:
+--   1. the bowl: the footprint's size, the ellipse's stretch and so the floor's;
+--   2. the stands: how many rings of seating, how deep each, and how deep the bowl
+--      is cut (four to seven rings, ten to seventeen studs down);
+--   3. the ways in: two grand stairs at the ends, or a third cut into one flank;
+--   4. the court: which long side the royal box takes, how many statue plinths
+--      stand on the floor, and which ring of the stands is gilded;
+--   5. the gates' order, then the lamps, banners, racks, columns and trees.
+-- The seating is solid stone (walls), as stands are: the road and the fight keep the
+-- floor and the apron, and the stairs are the only way between them.
+local FeatureDress = require("../FeatureDress")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+-- The Domain's stone and gold inside B12's limits (stone worth 0.75-0.92 at
+-- saturation up to 0.20, gold up to 0.55): the tileset's own paving colours where
+-- it has them, so no material is coloured twice in the place.
+local IVORY = { 228, 221, 206 } -- the stands' pale warm marble (Salt)
+local WARM = { 196, 187, 170 } -- the shaded riser stone between the rings (Slate)
+local FLAG = { 202, 194, 178 } -- the precinct's dressed limestone (Limestone)
+local SAND = { 194, 182, 156 } -- the fighting floor's warm sand (Sand)
+local WAY = { 226, 212, 184 } -- the processional gold-leaning paving (Pavement)
+local GOLD = { 228, 196, 132 } -- gilded stone: the podium ring and the stair walls
+local HOLY = { 255, 226, 160 } -- the Domain's warm light (light, not surface)
+
+local feature: MapFeature.Feature = {
+	name = "DomainArenaOfChampions",
+	about = "The arena of champions: an oval fighting floor sunk below rings of marble seating, grand stairs and gates at both ends, a canopied royal box and weapon racks.",
+	tileset = "domain",
+	scale = "centrepiece",
+	role = "crossing",
+	mood = { "monumental", "holy", "contested", "spectacle" },
+	cells = {
+		-- The precinct round the bowl: plain dressed limestone, its own props cleared.
+		apron = { ground = { material = "Limestone", color = FLAG }, clear = true },
+		-- The fighting floor: warm pale sand, a shade below the ivory of the stands.
+		floor = { ground = { material = "Sand", color = SAND }, clear = true },
+		-- The stands: pale ivory rings and the darker riser stone between them.
+		tierA = { ground = { material = "Salt", color = IVORY }, clear = true },
+		tierB = { ground = { material = "Slate", color = WARM }, clear = true },
+		-- Gilt stone: the ring wall round the floor, the stair's balustrades and one
+		-- gilded ring of the stands.
+		gilt = { ground = { material = "Concrete", color = GOLD }, clear = true },
+		-- The processional stair down into the bowl, the road's own colour.
+		way = { ground = { material = "Pavement", color = WAY }, clear = true },
+		-- The lamp's cell: the precinct's stone under a pyre, and its light.
+		lamp = {
+			ground = { material = "Limestone", color = FLAG },
+			clear = true,
+			glow = { color = HOLY, range = 16, brightness = 1.2, every = 1, height = 8.6 },
+		},
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1: the bowl's place and shape.
+		local w = whole(rng, 50, 56)
+		local d = whole(rng, 42, 50)
+		local stretch = between(rng, 1.06, 1.34)
+		local cx, cz = (w + 1) / 2, (d + 1) / 2
+		-- The rim ellipse fits the footprint with two cells of precinct round it.
+		local Rrim = math.min((w / 2 - 2) / stretch, (d / 2 - 2) * stretch)
+		local maxBand = math.floor(Rrim - 6)
+
+		-- 2: the stands, and so how deep the bowl is cut.
+		local tiers = whole(rng, 4, 7)
+		local rowW = whole(rng, 2, 3)
+		while 1 + tiers * rowW > maxBand and tiers > 4 do
+			tiers -= 1
+		end
+		while 1 + tiers * rowW > maxBand and rowW > 2 do
+			rowW -= 1
+		end
+		local band = 1 + tiers * rowW
+		local Rfloor = Rrim - band
+
+		-- 3: the ways in, and 4: the court's shape.
+		local stairs = whole(rng, 2, 3)
+		local stairW = whole(rng, 3, 4)
+		-- The rings of the stands rise two or three studs each, so the bowl is cut
+		-- deep. The flank stair is shorter than the end stairs, so a third stair is
+		-- only taken when a stair two studs a cell can still descend the bowl; and
+		-- the floor is kept above the preview's ground slab (18 studs) so it draws.
+		local rise = whole(rng, 2, 3)
+		local reach = if stairs == 3 then band / stretch else band * stretch
+		while rise > 2 and rise * tiers + 2 > 2 * (reach - 1.2) do
+			rise -= 1
+		end
+		while tiers > 4 and rise * tiers + 2 > 17 do
+			tiers -= 1
+		end
+		-- The podium wall stands four above the floor, the top ring two above the
+		-- precinct: so the floor is a rise a ring + 2 down.
+		local H = rise * tiers + 2
+		local boxSide = if rng:NextNumber() < 0.5 then -1 else 1
+		local thirdSide = -boxSide
+		local plinths = whole(rng, 0, 2)
+		local gilded = whole(rng, 1, tiers)
+		-- 5: only dressing from here.
+		local gateStyle = whole(rng, 1, 3)
+		local gateScale = between(rng, 1.3, 1.5)
+		local gateOff = between(rng, 0.7, 1.4)
+		local lampCount = whole(rng, 5, 8)
+		local rackCount = whole(rng, 2, 4)
+		local bannerCount = whole(rng, 4, 6)
+		local columnCount = whole(rng, 8, 13)
+		local treeCount = whole(rng, 1, 4)
+
+		local n = w * d
+		local walk, heights = table.create(n, true), table.create(n, 0)
+		local kinds: { [number]: string } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		local function inside(x: number, z: number): boolean
+			return x >= 1 and z >= 1 and x <= w and z <= d
+		end
+		local function uOf(x: number, z: number): number
