diff --git a/src/shared/systems/features/DomainStatueGarden.luau b/src/shared/systems/features/DomainStatueGarden.luau
new file mode 100644
index 00000000..69fc5981
--- /dev/null
+++ b/src/shared/systems/features/DomainStatueGarden.luau
@@ -0,0 +1,646 @@
+--!strict
+-- The Eternal Domain's sculpture garden: a lawn court of clipped turf laid out in a
+-- formal parterre, its beds raised and hedged, gravel and ivory walks crossed through
+-- it, a rill of still gold water running down its middle, pale statues on plinths about
+-- it and gold-leaved trees at its corners. At its heart a colossus, a fountain of light
+-- or a ring of waystones round a gilded head stone.
+--
+-- The Domain (bible B12) is ivory stone and gold in holy light, so the garden is pale:
+-- a sage turf court, ivory gravel, Marble-and-Limestone walks, gold-gravel beds, and
+-- all the gold trim of the place on its statues, lamps and water. Cloud takes the drop
+-- past the pad, not this feature.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first, then
+-- look). The first draws choose the structure, the rest only dress it:
+--   1. the plan: a bed in each quadrant (parterre), free-standing islands turned on the
+--      lawn, long strips down two opposite quadrants, or four L-shaped beds in a
+--      pinwheel round the heart;
+--   2. the levels: a flush lawn, a court sunk two studs below its stone edge, or a
+--      garden mount rising two terraces to the heart (0, 2 and 4 studs);
+--   3. the heart: a colossal statue on a dais, a fountain of gold water, or a ring of
+--      waystones round a gilded head stone, standing up at the far end of the long walk
+--      so the road and the game camera see the whole court before it;
+--   4. the walks: two crossed walks, or one long allée with a lawn crossing; the size,
+--      the walks' widths, the bed count (3 to 5), how much of the lawn its beds take,
+--      and how far up the allée the heart stands;
+--   5. then the statues' scale, the trees, the lamps and the rill's width.
+-- Everything stands on the Domain's own kit (domain_ sculpts and the domain set pieces)
+-- and the three sculpts added with this feature: the statue, the urn and the lamp.
+local FeatureDress = require("../FeatureDress")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+
+-- A raised parterre bed: its planting rectangle, centred on cx,cz (fractional cells)
+-- and turned by `turn` radians, with a hedge `ht` cells thick round it.
+type Bed = {
+	cx: number,
+	cz: number,
+	hx: number,
+	hz: number,
+	turn: number,
+	ht: number,
+	level: number, -- the walk level it stands on
+	rise: number, -- its top over that walk
+}
+
+-- One bed and the statue that stands on it. `statue` is the point on the bed top.
+type Group = { bed: Bed, statue: Point? }
+
+local PLANS = { "parterre", "islands", "strips", "pinwheel" }
+local RELIEFS = { "flush", "sunken", "mount" }
+local HEARTS = { "colossus", "fountain", "wayring" }
+
+-- The Domain's own surfaces, from outdoorTilesets/Domain.luau. Marble and Limestone are
+-- the tileset's colours exactly, since Roblox colours a terrain material once for the
+-- whole place; Grass, LeafyGrass, Cobblestone and Sand are left free to it.
+local WALK = { material = "Limestone", color = { 202, 194, 178 } }
+local PATH = { material = "Cobblestone", color = { 224, 216, 198 } }
+local LAWN = { material = "Grass", color = { 164, 182, 140 } }
+local HEDGE = { material = "LeafyGrass", color = { 116, 134, 92 } }
+-- Gold gravel for the raised beds: Sand is left free to the Domain, and a warmer
+-- gold than the road's pavement so a bed reads apart from a walk from the high camera.
+local BED = { material = "Sand", color = { 214, 196, 150 } }
+local DAIS = { material = "Marble", color = { 214, 208, 194 } }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local function roundCell(n: number): number
+	return math.floor(n + 0.5)
+end
+
+-- Degrees that turn a sculpt's +X front toward the point (toX, toZ) from (x, z).
+local function facing(x: number, z: number, toX: number, toZ: number): number
+	return -math.deg(math.atan2(toZ - z, toX - x))
+end
+
+-- The kind of bed cell at (x, z): "bed" inside the planting, "hedge" in the ring.
+local function bedCell(b: Bed, x: number, z: number): string?
+	local dx, dz = x - b.cx, z - b.cz
+	local c, s = math.cos(b.turn), math.sin(b.turn)
+	local p, q = dx * c + dz * s, -dx * s + dz * c
+	local ax, az = math.abs(p), math.abs(q)
+	if ax <= b.hx and az <= b.hz then
+		return "bed"
+	elseif ax <= b.hx + b.ht and az <= b.hz + b.ht then
+		return "hedge"
+	end
+	return nil
+end
+
+local feature: MapFeature.Feature = {
+	name = "DomainStatueGarden",
+	about = "A formal sculpture garden of the Eternal Domain: a lawn court in a parterre of raised gold beds and clipped hedges, walks and a gold rill crossed through it, pale statues and gold-leaved trees about a colossus, a fountain or a ring of waystones.",
+	tileset = "domain",
+	scale = "medium",
+	role = "crossing",
+	mood = { "formal", "holy", "monumental", "garden", "ivory" },
+	cells = {
+		-- The stone edge round the garden and the border walk.
+		walk = { ground = WALK, lift = 0.2, clear = true },
+		-- The two cross walks, gravel in a formal pattern.
+		path = { ground = PATH, lift = 0.2, clear = true },
+		-- The clipped court: pale turf, walked on, with a few gilded urns on it.
+		lawn = {
+			ground = LAWN,
+			lift = 0.2,
+			clear = true,
+			props = { { sculpt = "domain_urn", every = 34, scale = { 0.85, 1.15 }, sink = 0 } },
+		},
+		-- A clipped hedge, one step above its bed.
+		hedge = { ground = HEDGE, lift = 0.2, clear = true },
+		-- The raised gold-gravel beds of the parterre.
+		bed = { ground = BED, lift = 0.2, clear = true },
+		-- The heart's marble dais.
+		dais = { ground = DAIS, lift = 0.2, clear = true },
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-3: the structure, first.
+		local plan = PLANS[whole(rng, 1, #PLANS)]
+		local relief = RELIEFS[whole(rng, 1, #RELIEFS)]
+		local heart = HEARTS[whole(rng, 1, #HEARTS)]
+		-- 4: the size, the walks, the beds, the road's way.
+		local w = whole(rng, 27, 32)
+		local d = whole(rng, 26, 32)
+		local cx, cz = (w + 1) / 2, (d + 1) / 2
+		local kerb = whole(rng, 1, 2)
+		local cw = whole(rng, 4, 7)
+		local cw2 = math.clamp(cw + whole(rng, -1, 1), 4, 8)
+		local halfC, halfD = cw / 2, cw2 / 2
+		local heartR = whole(rng, 3, 4)
+		local ringW = whole(rng, 3, 4)
+		local bedsWanted = whole(rng, 3, 5)
+		local bedScale = between(rng, 0.7, 1.3)
+		local bedRise = between(rng, 1.8, 2.6)
+		local hedgeRise = between(rng, 0.7, 1.1)
+		local daisRise = between(rng, 1.6, 2.6)
+		-- Two crossed walks, or one long allée with a lawn crossing.
+		local crossWays = rng:NextNumber() < 0.62
+		local side = if rng:NextNumber() < 0.5 then 1 else -1
+		-- The road comes in at the south gate (the near side of the game camera's
+		-- view) and runs the length of the garden; the heart stands up at the far
+		-- (north) end, so the long walk leads to it and the game camera sees the whole
+		-- court before the god rather than the base of its plinth.
+		local R = heartR + 2
+		local offMax = math.floor((d + 1) / 2 - R - 2)
+		local hx, hz = cx, cz - (if offMax >= 2 then whole(rng, 2, offMax) else 1)
+		local rOuter = whole(rng, 5, 8)
+		local rInner = math.max(1, whole(rng, 1, 3))
+		if rInner >= rOuter then
+			rInner = rOuter - 1
+		end
+		-- How far the beds keep off the cross walks (the lawn crossing is narrower).
+		local keepD = if crossWays then halfD else halfD * 0.55
+
+		local function levelAt(x: number, z: number): number
+			if relief == "mount" then
+				local r = math.max(math.abs(x - cx), math.abs(z - cz))
+				if r > rOuter then
+					return 0
+				elseif r > rInner then
+					return 2
+				end
+				return 4
+			elseif relief == "sunken" then
+				local edge = math.min(x - 1, z - 1, w - x, d - z)
+				return if edge < kerb then 0 else -2
+			end
+			return 0
+		end
+
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		local walk, heights, kinds = table.create(w * d, true), table.create(w * d, 0), {}
+
+		-- The court: turf everywhere, a stone edge and the two cross walks over it, and
+		-- a gravel ring round the heart. Every walkable border cell stays at 0, so the
+		-- map's ground meets it.
+		local function onCross(x: number, z: number): boolean
+			return math.abs(x - cx) <= halfC or (crossWays and math.abs(z - cz) <= halfD)
+		end
+		local function onRondel(x: number, z: number, extra: number): boolean
+			local dx, dz = x - hx, z - hz
+			return math.sqrt(dx * dx + dz * dz) <= heartR + ringW + extra
+		end
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				local edge = math.min(x - 1, z - 1, w - x, d - z)
+				heights[i] = levelAt(x, z)
+				kinds[i] = if edge < kerb then "walk" else "lawn"
+				if onCross(x, z) then
+					kinds[i] = "path"
+				end
+				if onRondel(x, z, 0) then
+					kinds[i] = "path"
+				end
+			end
+		end
+
+		-- 4: the beds, in the plan's own arrangement.
+		local quads = {}
+		do
+			local xl0, xl1 = 1 + kerb, math.floor(cx - halfC) - 1
+			local xr0, xr1 = math.ceil(cx + halfC) + 1, w - kerb
+			local zn0, zn1 = 1 + kerb, math.floor(cz - halfD) - 1
+			local zs0, zs1 = math.ceil(cz + halfD) + 1, d - kerb
+			for _, xs in { { xl0, xl1 }, { xr0, xr1 } } do
+				for _, zs in { { zn0, zn1 }, { zs0, zs1 } } do
+					if xs[2] - xs[1] >= 4 and zs[2] - zs[1] >= 4 then
+						table.insert(quads, { x0 = xs[1], x1 = xs[2], z0 = zs[1], z1 = zs[2] })
+					end
+				end
+			end
+		end
+
+		local beds: { Bed } = {}
+		local groups: { Group } = {}
+
+		-- A bed stands clear of the stone edge, the cross walks and the rondel, and off
+		-- every bed already laid.
+		local function fits(b: Bed): boolean
+			-- Its middle must stand clear of the heart's rondel walk; its inner corner
+			-- may be clipped by it, so the beds bend round the heart.
+			if math.sqrt((b.cx - hx) ^ 2 + (b.cz - hz) ^ 2) < heartR + ringW then
+				return false
+			end
+			local reach = math.max(b.hx, b.hz) + b.ht + 1
+			for z = math.floor(b.cz - reach), math.ceil(b.cz + reach) do
+				for x = math.floor(b.cx - reach), math.ceil(b.cx + reach) do
+					if bedCell(b, x, z) then
+						if x < 2 or x > w - 1 or z < 2 or z > d - 1 then
+							return false
+						end
+						if math.abs(x - cx) <= halfC + 0.5 or math.abs(z - cz) <= keepD + 0.5 then
+							return false
+						end
+						for _, other in beds do
+							if bedCell(other, x, z) then
+								return false
+							end
+						end
+					end
+				end
+			end
+			return true
+		end
+
+		local function levelOf(x: number, z: number): number
+			return levelAt(roundCell(x), roundCell(z))
+		end
+
+		-- Lays a bed, shrinking it a little if the quadrant cannot hold it.
+		local function addBed(b: Bed, statue: Point?): boolean
+			for _ = 1, 3 do
+				if fits(b) then
+					table.insert(beds, b)
+					table.insert(groups, { bed = b, statue = statue })
+					return true
+				end
+				b = {
+					cx = b.cx,
+					cz = b.cz,
+					hx = b.hx * 0.82,
+					hz = b.hz * 0.82,
+					turn = b.turn,
+					ht = b.ht,
+					level = b.level,
+					rise = b.rise,
+				}
+			end
+			return false
+		end
+
+		local function rectBed(x0: number, x1: number, z0: number, z1: number, ht: number, level: number): Bed
+			return {
+				cx = (x0 + x1) / 2,
+				cz = (z0 + z1) / 2,
+				hx = (x1 - x0) / 2,
+				hz = (z1 - z0) / 2,
+				turn = 0,
+				ht = ht,
+				level = level,
+				rise = bedRise,
+			}
+		end
+
+		if plan == "parterre" then
+			local skip = if bedsWanted == 3 then whole(rng, 1, 4) else 0
+			for k, q in quads do
+				if k ~= skip and #groups < bedsWanted then
+					local qcx, qcz = (q.x0 + q.x1) / 2, (q.z0 + q.z1) / 2
+					local inset = whole(rng, 1, 2)
+					local bhx = math.max(2.2, ((q.x1 - q.x0) / 2 - inset) * bedScale)
+					local bhz = math.max(2.2, ((q.z1 - q.z0) / 2 - inset) * bedScale)
+					local b: Bed = {
+						cx = qcx,
+						cz = qcz,
+						hx = bhx,
+						hz = bhz,
+						turn = 0,
+						ht = 1,
+						level = levelOf(qcx, qcz),
+						rise = bedRise,
+					}
+					addBed(b, { x = qcx, z = qcz })
+				end
+			end
+		elseif plan == "islands" then
+			-- Free-standing beds turned at their own angles on the open lawn, set off
+			-- the quadrant middle rather than squared to the walks.
+			local tries = 0
+			while #groups < bedsWanted and tries < 60 do
+				tries += 1
+				local q = quads[whole(rng, 1, #quads)]
+				local qcx, qcz = (q.x0 + q.x1) / 2, (q.z0 + q.z1) / 2
+				local qhx, qhz = (q.x1 - q.x0) / 2, (q.z1 - q.z0) / 2
+				local b: Bed = {
+					cx = qcx + between(rng, -qhx * 0.55, qhx * 0.55),
+					cz = qcz + between(rng, -qhz * 0.55, qhz * 0.55),
+					hx = between(rng, 1.8, 3.2) * bedScale,
+					hz = between(rng, 1.6, 2.8) * bedScale,
+					turn = between(rng, -0.8, 0.8),
+					ht = 1,
+					level = levelOf(qcx, qcz),
+					rise = bedRise,
+				}
+				addBed(b, { x = b.cx, z = b.cz })
+			end
+		elseif plan == "strips" then
+			-- Two opposite quadrants get long parterre strips; the rest of the garden
+			-- stays open lawn, so this plan reads as a long allée with a court beside it.
+			local pair = whole(rng, 1, 2)
+			local use: { [number]: boolean } = {}
+			local want = math.min(bedsWanted, #quads)
+			local n = 0
+			for _, k in (if pair == 1 then { 1, 4 } else { 2, 3 }) do
+				if quads[k] then
+					use[k] = true
+					n += 1
+				end
+			end
+			for k = 1, #quads do
+				if n >= want then
+					break
+				end
+				if not use[k] then
+					use[k] = true
+					n += 1
+				end
+			end
+			for k, q in quads do
+				if use[k] then
+					local qcx, qcz = (q.x0 + q.x1) / 2, (q.z0 + q.z1) / 2
+					local inset = whole(rng, 1, 2)
+					local bhx = between(rng, 1.8, 2.4) * bedScale
+					local bhz = math.max(2.4, ((q.z1 - q.z0) / 2 - inset) * bedScale)
+					local b: Bed = {
+						cx = qcx,
+						cz = qcz,
+						hx = bhx,
+						hz = bhz,
+						turn = 0,
+						ht = 1,
+						level = levelOf(qcx, qcz),
+						rise = bedRise,
+					}
+					addBed(b, { x = qcx, z = qcz })
+				end
+			end
+		else
+			-- The pinwheel: an L-shaped bed in each quadrant, its elbow on a different
+			-- corner of the quadrant each time, so the four turn round the heart.
+			local turnOffset = whole(rng, 1, 4)
+			local inset = 2.4
+			for k, q in quads do
+				local pick = (turnOffset + k - 2) % 4 + 1
+				local corners = {
+					{ x = q.x0 + inset, z = q.z0 + inset, dx = 1, dz = 1 },
+					{ x = q.x1 - inset, z = q.z0 + inset, dx = -1, dz = 1 },
+					{ x = q.x0 + inset, z = q.z1 - inset, dx = 1, dz = -1 },
+					{ x = q.x1 - inset, z = q.z1 - inset, dx = -1, dz = -1 },
+				}
+				local c = corners[pick]
+				local maxLen = math.min(
+					math.abs(c.dx) * (if c.dx > 0 then q.x1 - inset - c.x else c.x - q.x0 - inset),
+					math.abs(c.dz) * (if c.dz > 0 then q.z1 - inset - c.z else c.z - q.z0 - inset)
+				)
+				local len = math.min(between(rng, 4.6, 7.2), maxLen)
+				local armW = between(rng, 2.2, 3.0) * bedScale
+				local level = levelOf(c.x, c.z)
+				-- the arm along x, and the arm along z; the corner square joins them
+				local ax0, ax1 = math.min(c.x, c.x + c.dx * len), math.max(c.x, c.x + c.dx * len)
+				local az0, az1 = math.min(c.z, c.z + c.dz * armW), math.max(c.z, c.z + c.dz * armW)
+				local bx0, bx1 = math.min(c.x, c.x + c.dx * armW), math.max(c.x, c.x + c.dx * armW)
+				local bz0, bz1 = math.min(c.z, c.z + c.dz * len), math.max(c.z, c.z + c.dz * len)
+				local a = rectBed(ax0, ax1, az0, az1, 1, level)
+				local b = rectBed(bx0, bx1, bz0, bz1, 1, level)
+				local elbow = { x = c.x + c.dx * armW / 2, z = c.z + c.dz * armW / 2 }
+				if fits(a) and fits(b) then
+					table.insert(beds, a)
+					table.insert(beds, b)
+					table.insert(groups, { bed = a, statue = elbow })
+				end
+			end
+		end
+
+		-- The beds' cells: walls, a hedge ring round a raised gold top.
+		for _, b in beds do
+			local reach = math.max(b.hx, b.hz) + b.ht + 1
+			for z = math.floor(b.cz - reach), math.ceil(b.cz + reach) do
+				for x = math.floor(b.cx - reach), math.ceil(b.cx + reach) do
+					local cell = bedCell(b, x, z)
+					local inRondel = math.sqrt((x - hx) ^ 2 + (z - hz) ^ 2) <= heartR + ringW
+					if cell and not inRondel and x >= 1 and x <= w and z >= 1 and z <= d then
+						local i = at(x, z)
+						walk[i] = false
+						kinds[i] = cell
+						heights[i] = b.level + b.rise + (if cell == "hedge" then hedgeRise else 0)
+					end
+				end
+			end
+		end
+
+		-- The heart's dais: a marble round, a step or two over the walks.
+		local daisLevel = levelOf(hx, hz)
+		for z = math.floor(hz - heartR - 1), math.ceil(hz + heartR + 1) do
+			for x = math.floor(hx - heartR - 1), math.ceil(hx + heartR + 1) do
+				if x >= 1 and x <= w and z >= 1 and z <= d then
+					local dx, dz = x - hx, z - hz
+					if dx * dx + dz * dz <= heartR * heartR then
+						local i = at(x, z)
+						walk[i] = false
+						kinds[i] = "dais"
+						heights[i] = daisLevel + daisRise
+					end
+				end
+			end
+		end
+
+		-- 5: the dressing, from here on.
+		local marks: { FeatureDress.Landmark } = {}
+		local effects: { FeatureDress.Effect } = {}
+
+		local function mark(x: number, z: number, sculpt: string, yaw: number?, scale: number?, solid: boolean?)
+			table.insert(marks, {
+				sculpt = sculpt,
+				x = x,
+				z = z,
+				yaw = yaw,
+				scale = scale,
+				sink = -0.24,
+				solid = solid,
+			})
+		end
+
+		-- The garden's own statues: one on each bed, facing the heart; two guardians
+		-- at the dais's foot on the side the road does not take, facing out.
+		local heartYaw = facing(hx, hz, hx, hz + 8)
+		for _, g in groups do
+			local p = g.statue
+			if p then
+				mark(
+					p.x,
+					p.z,
+					"domain_statue",
+					facing(p.x, p.z, hx, hz) + between(rng, -5, 5),
+					between(rng, 0.82, 0.98),
+					true
+				)
+			end
+		end
+		local freeA = if side > 0 then 135 else 45
+		for _, deg in { freeA, freeA + 90 } do
+			local a = math.rad(deg)
+			local gx = hx + math.cos(a) * (heartR + 1.3)
+			local gz = hz + math.sin(a) * (heartR + 1.3)
+			mark(gx, gz, "domain_statue", facing(hx, hz, gx, gz) + between(rng, -4, 4), between(rng, 0.95, 1.08), true)
+		end
+
+		-- The heart itself.
+		if heart == "colossus" then
+			mark(hx, hz, "domain_statue", heartYaw, between(rng, 1.32, 1.5), true)
+			table.insert(effects, {
+				recipe = "domain_petal_fall",
+				x = hx,
+				z = hz,
+				lift = 0,
+				seed = whole(rng, 1, 100000),
+			})
+		elseif heart == "fountain" then
+			local basin = between(rng, 0.78, 0.92)
+			mark(hx, hz, "domain_pool_basin", 0, basin, true)
+			table.insert(marks, {
+				sculpt = "domain_pool_water",
+				x = hx,
+				z = hz,
+				yaw = 0,
+				scale = basin,
+				sink = -1.1,
+			})
+			mark(hx, hz, "domain_statue", heartYaw, between(rng, 0.72, 0.86), true)
+			table.insert(effects, {
+				recipe = "domain_pool_light",
+				x = hx,
+				z = hz,
+				lift = 0.3,
+				seed = whole(rng, 1, 100000),
+			})
+		else
+			-- A ring of waystones round a gilded head stone: the gods' own marker,
+			-- set at the garden's heart.
+			mark(hx, hz, "domain_wayring", between(rng, 0, 360), between(rng, 0.86, 0.98), true)
+			mark(hx, hz, "domain_waystone", between(rng, 0, 360), between(rng, 0.9, 1.05), true)
+			table.insert(effects, {
+				recipe = "domain_petal_fall",
+				x = hx,
+				z = hz,
+				lift = 0,
+				seed = whole(rng, 1, 100000),
+			})
+		end
+
+		-- Gold-leaved trees at the garden's corners, their shed light drifting over
+		-- the court (the first of them carries the set piece).
+		local treeCount = whole(rng, 2, 4)
+		local treeStart = whole(rng, 1, 4)
+		local corners = {
+			{ x = 2.7, z = 2.7 },
+			{ x = w - 1.7, z = 2.7 },
+			{ x = 2.7, z = d - 1.7 },
+			{ x = w - 1.7, z = d - 1.7 },
+		}
+		local treeSpots: { Point } = {}
+		for k = 0, treeCount - 1 do
+			local c = corners[(treeStart + k - 1) % 4 + 1]
+			mark(c.x, c.z, "domain_gold_tree_low", between(rng, 0, 360), between(rng, 0.85, 1.05))
+			table.insert(treeSpots, c)
+		end
+		table.insert(effects, {
+			recipe = "domain_gold_leaves",
+			x = treeSpots[1].x,
+			z = treeSpots[1].z,
+			lift = 0,
+			seed = whole(rng, 1, 100000),
+		})
+
+		-- Lamps flanking the road at the garden's two gates, off the walk.
+		local lampX = halfC + 1.8
+		for _, z in { 2.5, d - 2.0 } do
+			for _, sx in { -1, 1 } do
+				mark(cx + sx * lampX, z, "domain_lamp", facing(cx + sx * lampX, z, cx, cz), between(rng, 0.95, 1.05))
+			end
+		end
+
+		-- A rill of still gold water down the main walk, from the south gate to the
+		-- heart and on to the north gate.
+		local rillScale = between(rng, 0.43, 0.52)
+		local function rill(x: number, z: number)
+			table.insert(
+				marks,
+				{ sculpt = "domain_pool_water", x = x, z = z, yaw = 0, scale = rillScale, sink = -0.34 }
+			)
+		end
+		local south = hz + (heartR + ringW) + 0.8
+		local z = d - 1.5
+		while z >= south do
+			rill(cx, z)
+			z -= 2
+		end
+		z = hz - (heartR + ringW) - 0.8
+		while z >= 2.2 do
+			rill(cx, z)
+			z -= 2
+		end
+
+		-- Petals of holy light sifting down over the court, besides the heart's own.
+		local spare = quads[whole(rng, 1, #quads)]
+		table.insert(effects, {
+			recipe = "domain_petal_fall",
+			x = (spare.x0 + spare.x1) / 2,
+			z = (spare.z0 + spare.z1) / 2,
+			lift = 0,
+			seed = whole(rng, 1, 100000),
+		})
+
+		-- The road: in at the south gate, up the long walk, round the heart and out
+		-- at the north gate.
+		local road: { Point } = {
+			{ x = cx, z = d },
+			{ x = cx, z = hz + R },
+			{ x = hx + side * R * 0.7071, z = hz + R * 0.7071 },
+			{ x = hx + side * R, z = hz },
+			{ x = hx + side * R * 0.7071, z = hz - R * 0.7071 },
+			{ x = hx, z = hz - R },
+			{ x = cx, z = 1 },
+		}
+
+		-- The photograph: up the long walk from the gate, and over the parterre
+		-- from whichever near corner the trees leave clearest.
+		local aim = if heart == "colossus" then 18 elseif heart == "wayring" then 12 else 10
+		local camSide, clearest = -1, -1
+		for _, sx in { -1, 1 } do
+			local camX = cx + sx * w * 0.46
+			local closestTree = math.huge
+			for _, t in treeSpots do
+				closestTree = math.min(closestTree, (t.x - camX) ^ 2 + (t.z - (d + 7)) ^ 2)
+			end
+			if closestTree > clearest then
+				clearest, camSide = closestTree, sx
+			end
+		end
+		return {
+			width = w,
+			depth = d,
+			walk = walk,
+			heights = heights,
+			kinds = kinds,
+			marks = marks,
+			effects = effects,
+			road = road,
+			cameras = {
+				{
+					name = "up the long walk",
+					from = { x = cx, z = d + 6.5, lift = 8 },
+					to = { x = hx, z = hz, lift = aim },
+					fov = 62,
+				},
+				{
+					name = "over the parterre",
+					from = { x = cx + camSide * w * 0.46, z = d + 7, lift = 24 },
+					to = { x = hx, z = hz, lift = aim * 0.5 },
+					fov = 55,
+				},
+			},
+		}
+	end,
+}
+
+return feature
