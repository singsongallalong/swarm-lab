+--!strict
+-- The Eternal Domain's observatory, a map feature for the domain tileset: a raised
+-- terrace of pale marble standing over a bed of cloud, climbed by long stairs, with the
+-- gods' armillary sphere at its heart, star-dials inlaid in the paving, telescopes at the
+-- rim and lamps of holy light round the balustrade. The domain is the one place the art
+-- bible lets pale (B12): ivory stone and gold in holy light, monumental and a little
+-- terrible, so the terrace stands high, the stairs are long and the cloud below is bright.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first, then
+-- look). The first draws choose the plan and the rest only dress it:
+--   1. the plan: a round drum, twin drums joined by a bridge over the cloud, a drum cut by
+--      a straight brink over the cloud, or an eight-sided terrace;
+--   2. the height it stands: 8, 10 or 12 studs, so a flight of four, five or six treads;
+--   3. the cloud: a sea round the terrace, a narrow girdle, or none at all;
+--   4. the flights: two to four stairs at a new turn each seed (the road climbs one and
+--      leaves by another);
+--   5. the balustrade: a whole ring, a ring of piers, or broken down into low rubble;
+--   then the dressing: the star-dials round the heart or out on the court, the telescopes
+--   at the rim, the lamps and the columns that frame each stair.
+--
+-- One structure, made and stamped alone: `lune run scripts/dresspreview shots out.png 4 1
+-- feature=DomainObservatory`.
+local FeatureDress = require("../FeatureDress")
+local Grid = require("../Grid")
+local MapFeature = require("../MapFeature")
+local Noise = require("../Noise")
+
+type Point = { x: number, z: number }
+type Drum = { x: number, z: number, r: number }
+type Flight = { drum: number, angle: number, ax: number, az: number, half: number, inner: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return lo + math.floor((hi - lo + 1) * rng:NextNumber())
+end
+
+local function pick(rng: Random, list: { string }): string
+	return list[whole(rng, 1, #list)]
+end
+
+-- Radians between two angles, 0..pi.
+local function apart(a: number, b: number): number
+	return math.abs((a - b + math.pi) % (2 * math.pi) - math.pi)
+end
+
+local FORMS = { "drum", "twin", "brink", "octagon" }
+local RAILS = { "ring", "piers", "broken" }
+local CLOUDS = { "sea", "girdle", "none" }
+local RISES = { 8, 10, 12 }
+
+-- The walkable terrace stops this far inside the balustrade's outer face, so the
+-- balustrade is a wall over a cell thick and no walkable cell can touch the open ground
+-- beyond it (a step of the terrace's whole height, which the contract forbids).
+local RAIL = 1.1
+-- The cloud's floor, studs under the ground round the terrace.
+local CLOUD_DEPTH = 6
+-- How far the cloud's outer bank may wander from the terrace, cells.
+local BANK = 0.7
+
+local feature: MapFeature.Feature = {
+	name = "DomainObservatory",
+	about = "The gods' observatory: a raised marble terrace over the sea of cloud, star-dials inlaid in its paving, a great armillary sphere of gilded rings at its heart and telescopes at the rim.",
+	tileset = "domain",
+	scale = "medium",
+	role = "crossing",
+	mood = { "celestial", "raised", "monumental", "starlit" },
+	cells = {
+		-- The terrace: a pale, smooth marble, a little lighter and cooler than the
+		-- domain's heath paving so the built ground reads against it.
+		terrace = {
+			ground = { material = "Sandstone", color = { 196, 186, 166 } },
+			lift = 0.22,
+			clear = true,
+		},
+		-- The ground round it and the court below the stairs, a warmer grey stone.
+		approach = {
+			ground = { material = "Marble", color = { 214, 208, 194 } },
+			lift = 0.18,
+			clear = true,
+		},
+		-- Treads, darker and lined, so the flights read from above.
+		stair = {
+			ground = { material = "Cobblestone", color = { 194, 186, 170 } },
+			lift = 0.2,
+			clear = true,
+		},
+		-- The gilded inlay ring at the terrace's lip (the domain's own warm paving
+		-- colour, so it reads as gold worked into the marble).
+		gilt = {
+			ground = { material = "Pavement", color = { 226, 212, 184 } },
+			lift = 0.24,
+			clear = true,
+		},
+		-- The dais the armillary stands on: veined marble, a step off the paving.
+		dais = {
+			ground = { material = "Marble", color = { 214, 208, 194 } },
+			lift = 0.5,
+			clear = true,
+		},
+		-- The balustrade: heavy ivory limestone, waist high on the terrace.
+		parapet = {
+			ground = { material = "Salt", color = { 230, 226, 214 } },
+			lift = 2.4,
+			clear = true,
+		},
+		-- Its piers, a head above the rail.
+		pier = {
+			ground = { material = "Salt", color = { 230, 226, 214 } },
+			lift = 4.2,
+			clear = true,
+		},
+		-- A broken stretch of it, fallen to a low kerb.
+		rubble = {
+			ground = { material = "Salt", color = { 230, 226, 214 } },
+			lift = 0.9,
+			clear = true,
+		},
+		-- The bed of cloud the terrace stands in: the domain's own cloud colour,
+		-- sunk, so from above the terrace reads as an island.
+		cloud = {
+			ground = { material = "Ice", color = { 190, 204, 234 } },
+			lift = 0.15,
+			clear = true,
+		},
+		-- Under each lamp: the terrace's own paving, with one warm light of holy gold.
+		lamp = {
+			ground = { material = "Sandstone", color = { 196, 186, 166 } },
+			lift = 0.22,
+			clear = true,
+			glow = { color = { 255, 224, 168 }, range = 14, brightness = 1.2, every = 1, height = 4.6 },
+		},
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-4: the plan, first. These draws are the structure; the rest only dress it.
+		local form = pick(rng, FORMS)
+		local rise = RISES[whole(rng, 1, #RISES)]
+		local treads = rise // 2
+		local rail = pick(rng, RAILS)
+		local cloud = pick(rng, CLOUDS)
+		local w = if form == "twin" then 32 else whole(rng, 30, 32)
+		local d = if form == "twin" then 32 else whole(rng, 30, 32)
+		local cx, cz = (w + 1) / 2, (d + 1) / 2
+		local band = if cloud == "sea"
+			then between(rng, 2.1, 2.8)
+			elseif cloud == "girdle" then between(rng, 0.9, 1.5)
+			else 0
+		-- How far a flight reaches out from the terrace's outer edge, in studs of the
+		-- platform's own measure: far enough to cross the cloud bank and land on open
+		-- ground. The treads divide that reach into rings, so neighbouring cells of a
+		-- flight are never more than a step apart.
+		local reach = math.max(treads - RAIL, band + 0.9)
+		local stairCount = if form == "twin" then whole(rng, 2, 3) else whole(rng, 2, 4)
+		local axis = between(rng, 0, 2 * math.pi)
+		local first = between(rng, 0, 2 * math.pi)
+		local perStair = 2 * math.pi / stairCount
+		local octagon = form == "octagon"
+		local brink = form == "brink"
+
+		-- Distance from (x, z) to the middle of the footprint's border along `a`, in
+		-- cells: what the stairs and the cloud bank have to fit inside.
+		local function room(x: number, z: number, a: number): number
+			local ux, uz = math.cos(a), math.sin(a)
+			local tx = if math.abs(ux) > 1e-6 then (if ux > 0 then w - x else x - 1) / math.abs(ux) else math.huge
+			local tz = if math.abs(uz) > 1e-6 then (if uz > 0 then d - z else z - 1) / math.abs(uz) else math.huge
+			return math.min(tx, tz)
+		end
+
+		local drums: { Drum } = {}
+		local flights: { Flight } = {}
+		local armX, armZ = cx, cz
+		local cutDist, cutX, cutZ = 0, 0, 0
+		local brinkMid: number? = nil
+
+		local function addFlight(drum: number, a: number, half: number, edge: number)
+			table.insert(flights, {
+				drum = drum,
+				angle = a,
+				ax = math.cos(a),
+				az = math.sin(a),
+				half = half,
+				inner = edge,
+			})
+		end
+
+		-- 5: each plan's own body, and the room its flights need.
+		local R = 0
+		if form == "twin" then
+			local gap = between(rng, 1.1, 1.7)
+			local rm, rs = between(rng, 4.8, 5.6), between(rng, 2.8, 3.4)
+			local halfD = (rm + gap + rs) / 2
+			local m1 = { x = cx - math.cos(axis) * halfD, z = cz - math.sin(axis) * halfD }
+			local m2 = { x = cx + math.cos(axis) * halfD, z = cz + math.sin(axis) * halfD }
+			-- Both drums' stairs point across the twin, so the bridge stays clear.
+			local across = axis + math.pi / 2
+			addFlight(1, across + between(rng, -0.4, 0.4), between(rng, 1.5, 1.8), rm - RAIL)
+			addFlight(2, across + math.pi + between(rng, -0.4, 0.4), between(rng, 1.3, 1.6), rs - RAIL)
+			if stairCount > 2 then
+				addFlight(1, across + math.pi + between(rng, -0.45, 0.45), between(rng, 1.3, 1.6), rm - RAIL)
+			end
+			drums = { { x = m1.x, z = m1.z, r = rm }, { x = m2.x, z = m2.z, r = rs } }
+			local roomMain, roomSat = math.huge, math.huge
+			for _, f in flights do
+				local drum = drums[f.drum]
+				local fit = room(drum.x, drum.z, f.angle) - reach - 0.6
+				if f.drum == 1 then
+					roomMain = math.min(roomMain, fit)
+				else
+					roomSat = math.min(roomSat, fit)
+				end
+			end
+			for k = 0, 7 do
+				local a = k * math.pi / 4
+				roomMain = math.min(roomMain, room(drums[1].x, drums[1].z, a) - band - 1.3)
+				roomSat = math.min(roomSat, room(drums[2].x, drums[2].z, a) - band - 1.3)
+			end
+			drums[1].r = math.max(4.2, math.min(rm, roomMain))
+			drums[2].r = math.max(2.6, math.min(rs, roomSat))
+			for _, f in flights do
+				f.inner = drums[f.drum].r - RAIL
+			end
+			armX, armZ = drums[1].x, drums[1].z
+			R = math.max(drums[1].r, drums[2].r)
+		else
+			local angles: { number } = {}
+			for k = 1, stairCount do
+				angles[k] = first + (k - 1) * perStair + between(rng, -0.16, 0.16) * perStair
+			end
+			local r = between(rng, 6.4, 7.6)
+			for _, a in angles do
+				r = math.min(r, room(cx, cz, a) - reach - 0.6)
+			end
+			for k = 0, 7 do
+				r = math.min(r, room(cx, cz, k * math.pi / 4) - band - 1.3)
+			end
+			R = math.max(5, r)
+			drums = { { x = cx, z = cz, r = R } }
+			for _, a in angles do
+				addFlight(1, a, between(rng, 1.5, 1.9), R - RAIL)
+			end
+			if brink then
+				-- The brink runs where it is furthest from every flight, so no stair
+				-- is cut off; the heart's clearance is set below, once it is measured.
+				local best, bestGap = 0, -1
+				for k = 0, 23 do
+					local a = k * math.pi / 12
+					local least = math.pi
+					for _, f in flights do
+						least = math.min(least, apart(a, f.angle))
+					end
+					if least > bestGap then
+						bestGap, best = least, a
+					end
+				end
+				brinkMid = best
+			end
+		end
+
+		local terraceEdge = drums[1].r - RAIL
+		local daisR = math.max(1.6, math.min(between(rng, 2, 2.5), terraceEdge - 2.6))
+		-- The gilded meridian and its cross, drawn through the heart: the floor is
+		-- the instrument the armillary reads, and the lines make it read from above.
+		local lineAngle = flights[1].angle + math.pi / 2
+		local lineX, lineZ = math.cos(lineAngle), math.sin(lineAngle)
+		if brink and brinkMid then
+			-- The straight lip runs across the wider gap between the flights, so the
+			-- terrace the road crosses stays whole and the heart keeps a dais' width
+			-- clear of it.
+			local n = brinkMid + between(rng, -0.35, 0.35)
+			cutX, cutZ = math.cos(n), math.sin(n)
+			cutDist = between(rng, daisR + 1.8, math.min(daisR + 3.4, R - 1.2))
+		end
+
+		local field = Noise.field(rng)
+		local walk = table.create(w * d, false)
+		local heights = table.create(w * d, 0)
+		local kinds: { [number]: string } = {}
+		local marks: { FeatureDress.Landmark } = {}
+		local effects: { FeatureDress.Effect } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		local function inFootprint(x: number, z: number): boolean
+			return x >= 1 and z >= 1 and x <= w and z <= d
+		end
+		local function cellOf(p: Point): number?
+			local ix, iz = math.floor(p.x + 0.5), math.floor(p.z + 0.5)
+			if not inFootprint(ix, iz) then
+				return nil
+			end
+			return at(ix, iz)
+		end
+
+		-- The signed distance out from the platform's edge: negative on the terrace,
+		-- then the balustrade's thickness, then the bed of cloud, then open ground.
+		local function edge(x: number, z: number): number
+			local dx, dz = x - cx, z - cz
+			if form == "twin" then
+				local e1 = math.sqrt((x - drums[1].x) ^ 2 + (z - drums[1].z) ^ 2) - drums[1].r
+				local e2 = math.sqrt((x - drums[2].x) ^ 2 + (z - drums[2].z) ^ 2) - drums[2].r
+				-- The bridge between them: a walk a balustrade's width each side, its
+				-- ends buried in the two drums.
+				local ax, az = math.cos(axis), math.sin(axis)
+				local along = dx * ax + dz * az
+				local perp = math.abs(-dx * az + dz * ax)
+				local s1 = (drums[1].x - cx) * ax + (drums[1].z - cz) * az
+				local s2 = (drums[2].x - cx) * ax + (drums[2].z - cz) * az
+				local lo, hi = math.min(s1, s2), math.max(s1, s2)
+				local bridge = math.max(perp - 2, lo - along, along - hi)
+				return math.min(e1, e2, bridge)
+			end
+			local m = if octagon
+				then math.max(math.abs(dx), math.abs(dz), (math.abs(dx) + math.abs(dz)) * 0.70710678) - R
+				else math.sqrt(dx * dx + dz * dz) - R
+			if brink then
+				return math.max(m, dx * cutX + dz * cutZ - cutDist)
+			end
+			return m
+		end
+
+		-- Which flight's tread or kerb this cell is on, if any. The ring comes from the
+		-- cell's distance out from the platform's edge, so it rises and falls evenly
+		-- round the flight's mouth however the terrace's edge curves; the kerb is a
+		-- full cell wider than the walk, so a tread can never stand beside open ground
+		-- a step away.
+		local function onFlight(x: number, z: number, e: number): (number?, number?)
+			if e <= -RAIL or e > reach then
+				return nil, nil
+			end
+			local ring = math.clamp(math.ceil((e + RAIL) * treads / (reach + RAIL)), 1, treads)
+			local tread: number? = nil
+			local kerb: number? = nil
+			for _, f in flights do
+				local drum = drums[f.drum]
+				local dx, dz = x - drum.x, z - drum.z
+				if dx * f.ax + dz * f.az > 0.3 then
+					local perp = math.abs(-dx * f.az + dz * f.ax)
+					if perp <= f.half then
+						tread = math.max(tread or 0, ring)
+					elseif perp <= f.half + 1.2 then
+						kerb = math.max(kerb or 0, ring)
+					end
+				end
+			end
+			return tread, kerb
+		end
+
+		-- Where the balustrade stands: piers round it, or broken stretches of it.
+		local pierCount = whole(rng, 6, 10)
+		local pierPhase = between(rng, 0, 2 * math.pi)
+		local broken: { number } = {}
+		if rail == "broken" then
+			table.insert(broken, between(rng, 0, 2 * math.pi))
+			table.insert(broken, between(rng, 0, 2 * math.pi))
+		end
+		local function railKind(x: number, z: number): string
+			local c = drums[1]
+			if form == "twin" then
+				local d1 = (x - drums[1].x) ^ 2 + (z - drums[1].z) ^ 2
+				local d2 = (x - drums[2].x) ^ 2 + (z - drums[2].z) ^ 2
+				c = if d1 <= d2 then drums[1] else drums[2]
+			end
+			local a = math.atan2(z - c.z, x - c.x)
+			if rail == "piers" then
+				for k = 0, pierCount - 1 do
+					if apart(a, pierPhase + k * 2 * math.pi / pierCount) < 0.26 then
+						return "pier"
+					end
+				end
+			elseif rail == "broken" then
+				for _, b in broken do
+					if apart(a, b) < 0.42 then
+						return "rubble"
+					end
+				end
+			end
+			return "parapet"
+		end
+
+		-- The paving: the dais at the heart, a gilded inlay ring at the lip, terrace
+		-- between them.
+		local function paving(x: number, z: number, e: number): string
+			local dx, dz = x - armX, z - armZ
+			if dx * dx + dz * dz <= daisR * daisR then
+				return "dais"
+			end
+			if e <= -2.2 then
+				return "gilt"
+			end
+			if math.abs(-dx * lineZ + dz * lineX) < 0.55 or math.abs(dx * lineZ + dz * lineX) < 0.55 then
+				return "gilt"
+			end
+			return "terrace"
+		end
+
+		-- 6: lay the plan out cell by cell.
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				local e = edge(x, z)
+				local tread, kerb = onFlight(x, z, e)
+				if kerb and not tread then
+					walk[i] = false
+					heights[i] = rise - 2 * kerb
+					kinds[i] = "stair"
+				elseif tread then
+					walk[i] = true
+					heights[i] = rise - 2 * tread
+					kinds[i] = "stair"
+				elseif e <= -RAIL then
+					walk[i] = true
+					heights[i] = rise
+					kinds[i] = paving(x, z, e)
+				elseif e <= 0 then
+					walk[i] = false
+					heights[i] = rise
+					kinds[i] = railKind(x, z)
+				elseif e <= band + math.max(0.3, BANK * Noise.sample(field, x * 0.34, z * 0.34)) then
+					walk[i] = false
+					heights[i] = -CLOUD_DEPTH
+					kinds[i] = "cloud"
+				else
+					walk[i] = true
+					heights[i] = 0
+					kinds[i] = "approach"
+				end
+			end
+		end
+
+		-- A wide stair's kerb can fence a scrap of open ground in between two flights;
+		-- wall any such pocket as a sink of cloud, so every walkable cell is reachable.
+		local g = Grid.new(w, d, Grid.WALL)
+		for i, ok in walk do
+			g.cells[i] = if ok then Grid.FLOOR else Grid.WALL
+		end
+		local main: { number }? = nil
+		for _, region in Grid.regions(g) do
+			for _, i in region do
+				local x, z = Grid.coords(g, i)
+				if x == 1 or z == 1 or x == w or z == d then
+					main = region
+					break
+				end
+			end
+			if main then
+				break
+			end
+		end
+		if main then
+			local kept: { [number]: boolean } = {}
+			for _, i in main do
+				kept[i] = true
+			end
+			for i, ok in walk do
+				if ok and not kept[i] then
+					walk[i] = false
+					heights[i] = -CLOUD_DEPTH
+					kinds[i] = "cloud"
+				end
+			end
+		end
+
+		-- 7: the dressing. The armillary at the heart, on its dais.
+		table.insert(marks, {
+			sculpt = "domain_armillary",
+			x = armX,
+			z = armZ,
+			yaw = between(rng, 0, 360),
+			scale = between(rng, 0.92, 1.12),
+			sink = -0.5,
+			solid = true,
+		})
+
+		-- Whether a spot is clear of the stairs and the heart (for the dials).
+		local function offTheWays(x: number, z: number): boolean
+			local i = cellOf({ x = x, z = z })
+			if not i or not walk[i] or kinds[i] == "stair" then
+				return false
+			end
+			for _, f in flights do
+				local drum = drums[f.drum]
+				local dx, dz = x - drum.x, z - drum.z
+				local along = dx * f.ax + dz * f.az
+				if along > f.inner - 1 and along < drum.r + reach + 1.5 then
+					if math.abs(-dx * f.az + dz * f.ax) < f.half + 0.9 then
+						return false
+					end
+				end
+			end
+			return true
+		end
+
+		-- Star-dials, inlaid where the seed wants them read: round the heart, out on
+		-- the court below the stairs, or both.
+		local dialMode = pick(rng, { "terrace", "court", "both" })
+		local dialCount = whole(rng, 2, 5)
+		local dials: { Point } = {}
+		for k = 1, dialCount do
+			local onTerrace = dialMode == "terrace" or (dialMode == "both" and k % 2 == 1)
+			local c = if onTerrace then drums[1] else { x = cx, z = cz }
+			local lo = if onTerrace then daisR + 1.5 else drums[1].r + reach + 2.4
+			local hi = if onTerrace then terraceEdge - 1.7 else drums[1].r + reach + 4.4
+			if hi < lo then
+				hi = lo + 0.4
+			end
+			local a = between(rng, 0, 2 * math.pi)
+			local spot: Point? = nil
+			for _ = 1, 16 do
+				local radius = between(rng, lo, hi)
+				local p = { x = c.x + math.cos(a) * radius, z = c.z + math.sin(a) * radius }
+				local clear = offTheWays(p.x, p.z)
+				local dx, dz = p.x - armX, p.z - armZ
+				clear = clear and dx * dx + dz * dz > (daisR + 1.4) ^ 2
+				for _, q in dials do
+					clear = clear and (q.x - p.x) ^ 2 + (q.z - p.z) ^ 2 > 9
+				end
+				if clear then
+					spot = p
+					break
+				end
+				a += 0.7
+			end
+			if spot then
+				table.insert(dials, spot)
+				local i = cellOf(spot) :: number
+				table.insert(marks, {
+					sculpt = "domain_star_dial",
+					x = spot.x,
+					z = spot.z,
+					yaw = between(rng, 0, 360),
+					scale = between(rng, 0.72, 0.95),
+					sink = -(if kinds[i] == "approach" then 0.18 else 0.22),
+				})
+			end
+		end
+
+		-- Telescopes at the rim, aimed away from the stairs.
+		local scopeCount = whole(rng, 1, 3)
+		local scopes: { Point } = {}
+		for _ = 1, scopeCount do
+			local a = between(rng, 0, 2 * math.pi)
+			local spot: Point? = nil
+			for _ = 1, 16 do
+				local p = { x = armX + math.cos(a) * (terraceEdge - 1.5), z = armZ + math.sin(a) * (terraceEdge - 1.5) }
+				local clear = offTheWays(p.x, p.z)
+				local i = cellOf(p)
+				clear = clear and i ~= nil and kinds[i :: number] ~= "dais"
+				for _, f in flights do
+					clear = clear and apart(a, f.angle) > 0.45
+				end
+				for _, q in scopes do
+					clear = clear and (q.x - p.x) ^ 2 + (q.z - p.z) ^ 2 > 16
+				end
+				if clear then
+					spot = p
+					break
+				end
+				a += 0.55
+			end
+			if spot then
+				table.insert(scopes, spot)
+				table.insert(marks, {
+					sculpt = "domain_telescope",
+					x = spot.x,
+					z = spot.z,
+					yaw = -math.deg(a) + between(rng, -28, 28),
+					scale = between(rng, 0.9, 1.1),
+					sink = -0.22,
+					solid = true,
+				})
+			end
+		end
+
+		-- Lamps of holy light round the balustrade; each lights its own cell.
+		local lampCount = whole(rng, 2, 6)
+		for _ = 1, lampCount do
+			local a = between(rng, 0, 2 * math.pi)
+			for _ = 1, 18 do
+				local p = { x = armX + math.cos(a) * (terraceEdge - 0.7), z = armZ + math.sin(a) * (terraceEdge - 0.7) }
+				local i = cellOf(p)
+				local clear = i ~= nil and walk[i :: number] and kinds[i :: number] ~= "dais"
+				for _, f in flights do
+					clear = clear and apart(a, f.angle) > 0.24
+				end
+				for _, q in scopes do
+					clear = clear and (q.x - p.x) ^ 2 + (q.z - p.z) ^ 2 > 4
+				end
+				if clear then
+					kinds[i :: number] = "lamp"
+					table.insert(marks, {
+						sculpt = "domain_observatory_lamp",
+						x = p.x,
+						z = p.z,
+						yaw = between(rng, 0, 360),
+						scale = between(rng, 1, 1.15),
+						sink = -0.22,
+						solid = true,
+					})
+					break
+				end
+				a += 0.5
+			end
+		end
+
+		-- 8: the light the place is for. The stars fall over the terrace, and holy
+		-- light gathers at the armillary's foot and climbs it.
+		table.insert(effects, { recipe = "domain_starfall", x = armX, z = armZ, lift = 18 })
