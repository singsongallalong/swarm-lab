diff --git a/src/shared/systems/features/RimeholtFrostCourt.luau b/src/shared/systems/features/RimeholtFrostCourt.luau
new file mode 100644
index 00000000..49f6dc6c
--- /dev/null
+++ b/src/shared/systems/features/RimeholtFrostCourt.luau
@@ -0,0 +1,263 @@
+--!strict
+-- Rimeholt's Frost Court: four colossal frost-giants of the hill-folk kneel in a
+-- ring round a frozen pool, lean hooded figures bowed toward the ice, carved
+-- half out of their blocks and sunk to the waist in low granite mounds. They
+-- sit at the inner lip of their mounds, so the court leans in over the pool.
+-- Snow falls straight down only inside their ring, where the air is still, over
+-- the cold light that breathes under the ice; the road crosses the pool between
+-- them. Its photograph is taken from the ice, across the pool, at one giant.
+local DraftedMap = require("../DraftedMap")
+local MapFeature = require("../MapFeature")
+
+-- The kneeler's recipe height, and the share of it its raw block takes up
+-- (sculpts/Colossus tops the block at 0.4 of the recipe, less the hood above).
+-- Sinking the figure by this much buries the block and leaves it kneeling; the
+-- court sinks each a little differently, as the ground has settled.
+local KNEELER_HEIGHT = 48
+local KNEELER_SINK = { 0.45, 0.5 }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function clamp(n: number, lo: number, hi: number): number
+	return math.max(lo, math.min(hi, n))
+end
+
+local feature: MapFeature.Feature = {
+	name = "RimeholtFrostCourt",
+	about = "Four colossal frost-giants of snow-crusted stone kneel in a ring round a frozen pool, a slow snowfall falling only inside their court.",
+	palette = "Rimeholt",
+	scale = "centrepiece",
+	role = "centrepiece",
+	mood = { "colossal", "kneeling", "still", "falling snow", "cold" },
+	cells = {
+		-- The frozen pool the court kneels round: pale old ice, its light
+		-- breathing under the surface (set piece rimeholt_underice).
+		pool = {
+			ground = { material = "Marble", color = { 84, 96, 102 } },
+			lift = 0.35,
+			clear = true,
+			glow = { color = { 110, 190, 190 }, range = 10, brightness = 0.7, every = 44, height = 0.5 },
+			props = { { sculpt = "rimeholt_ice_shards", every = 44, scale = { 0.7, 1.3 }, sink = 0.2 } },
+		},
+		-- The broken shelf of old snow and ice at the pool's edge.
+		rim = {
+			ground = { material = "Glacier", color = { 64, 72, 78 } },
+			lift = 0.2,
+			clear = true,
+			props = { { sculpt = "rimeholt_ice_shards", every = 14, scale = { 0.8, 1.6 }, sink = 0.2 } },
+		},
+		-- The low bank the court stands in, a step above the ice.
+		bank = {
+			ground = { material = "Glacier", color = { 64, 72, 78 } },
+			lift = 0.1,
+			clear = true,
+			props = { { sculpt = "rimeholt_fell_grass", every = 16, scale = { 0.9, 1.3 }, sink = 0.2 } },
+		},
+		-- Each giant's mound: a squat dais of grey granite, the giant kneeling
+		-- at its inner lip, a few rune slabs cut at its foot.
+		mound = {
+			ground = { material = "Basalt", color = { 50, 54, 62 } },
+			lift = 0.4,
+			clear = true,
+			props = { { sculpt = "rimeholt_rune_slab", every = 24, scale = { 0.85, 1.15 }, sink = 0.15 } },
+		},
+		-- The one warm light: a hill-fire's banked coals on the way in (B2).
+		fire = {
+			ground = { material = "Basalt", color = { 50, 54, 62 } },
+			lift = 0.2,
+			clear = true,
+			glow = { color = { 255, 168, 88 }, range = 16, brightness = 1.3, every = 1, height = 1.2 },
+		},
+	} :: { [string]: DraftedMap.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		local w, d = 36, 36
+		local cx, cz = (w + 1) / 2, (d + 1) / 2
+		local walk = table.create(w * d, true)
+		local heights = table.create(w * d, 0)
+		local kinds: { [number]: string } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+
+		-- The pool: a tarn with one bay, its outline seeded so no two courts
+		-- hold the same sheet of ice. The bay leans out along a way between
+		-- two giants, never at one.
+		local radius = between(rng, 6.4, 9)
+		local phase1 = between(rng, 0, math.pi * 2)
+		local phase2 = between(rng, 0, math.pi * 2)
+		local bayAngle = math.floor(rng:NextNumber() * 4) * (math.pi / 2) + between(rng, -0.22, 0.22)
+		local bay = between(rng, 1.2, 2.8)
+		local function poolRadius(a: number): number
+			local r = radius * (1 + 0.06 * math.sin(2 * a + phase1) + 0.04 * math.sin(3 * a + phase2))
+			local off = (a - bayAngle + math.pi) % (math.pi * 2) - math.pi
+			return r + bay * math.exp(-(off * off) / 0.18)
+		end
+
+		-- The bank: the low ring they kneel in, its outer edge broken by the
+		-- snow that has drifted over it.
+		local bankBase = between(rng, 11.6, 13.4)
+		local bankPhase = between(rng, 0, math.pi * 2)
+		local function bankRadius(a: number): number
+			return bankBase + 0.9 * math.sin(3 * a + bankPhase) + 0.4 * math.sin(2 * a + phase1)
+		end
+
+		-- The four giants, at the diagonals so the road passes between them.
+		-- One seed's court is square and wide, another's an oval drawn in
+		-- tight; each giant is its own size and has settled its own depth into
+		-- its mound. Each mound is set a little outward of its giant, so the
+		-- figure kneels at the inner lip, leaning over the pool.
+		local ringX = between(rng, 11.4, 14.2)
+		local ringZ = between(rng, 11.4, 14.2)
+		local giants: { { x: number, z: number, mx: number, mz: number, r: number, h: number, scale: number, sink: number } } =
+			{}
+		for k = 1, 4 do
+			local a = math.rad(45) + (k - 1) * (math.pi / 2) + between(rng, -0.12, 0.12)
+			local dirX, dirZ = math.cos(a), math.sin(a)
+			local scale = between(rng, 0.86, 1.18)
+			table.insert(giants, {
+				x = cx + dirX * ringX,
+				z = cz + dirZ * ringZ,
+				mx = cx + dirX * (ringX + 0.7),
+				mz = cz + dirZ * (ringZ + 0.7),
+				r = between(rng, 2.5, 3),
+				h = if rng:NextNumber() < 0.5 then 2 else 3,
+				scale = scale,
+				sink = KNEELER_HEIGHT * between(rng, KNEELER_SINK[1], KNEELER_SINK[2]) * scale,
+			})
+		end
+
+		-- The ice, its shelf, the bank, then each giant's mound over them.
+		local mound = table.create(w * d, false)
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				local dx, dz = x - cx, z - cz
+				local r = math.sqrt(dx * dx + dz * dz)
+				local a = math.atan2(dz, dx)
+				if r <= poolRadius(a) then
+					kinds[i] = "pool"
+				elseif r <= poolRadius(a) + 1.6 then
+					kinds[i] = "rim"
+				elseif r <= bankRadius(a) then
+					kinds[i] = "bank"
+					heights[i] = 1
+				end
+				for _, g in giants do
+					local gx, gz = x - g.mx, z - g.mz
+					local wobble = 1 + 0.08 * math.sin(3 * math.atan2(gz, gx) + bankPhase)
+					if math.sqrt(gx * gx + gz * gz) <= g.r * wobble then
+						kinds[i] = "mound"
+						heights[i] = g.h
+						mound[i] = true
+						break
+					end
+				end
+			end
+		end
+		-- A step of bank round every mound, so no walkable cell drops straight
+		-- from the mound's top to the snow (two studs at most between cells).
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				if mound[i] then
+					continue
+				end
+				local near = false
+				for oz = -2, 2 do
+					for ox = -2, 2 do
+						local nx, nz = x + ox, z + oz
+						if nx >= 1 and nz >= 1 and nx <= w and nz <= d and mound[at(nx, nz)] then
+							near = true
+						end
+					end
+				end
+				if near and heights[i] < 1 then
+					heights[i] = 1
+				end
+			end
+		end
+
+		-- The road in, across the ice between the giants, and out the far side.
+		local zIn = cz + between(rng, -2.2, 2.2)
+		local zOut = cz + between(rng, -2.2, 2.2)
+		local road = {
+			{ x = 1, z = zIn },
+			{ x = cx + between(rng, -1.6, 1.6), z = cz + between(rng, -1.4, 1.4) },
+			{ x = w, z = zOut },
+		}
+
+		-- The hill-fire at the way in, its coals the one warmth at the court.
+		local fireX = between(rng, 4.2, 5.6)
+		local fireZ = clamp(zIn + (if rng:NextNumber() < 0.5 then -1 else 1) * between(rng, 3, 4.2), 4, d - 4)
+		kinds[at(math.floor(fireX + 0.5), math.floor(fireZ + 0.5))] = "fire"
+
+		local marks: { DraftedMap.Landmark } = {}
+		for _, g in giants do
+			table.insert(marks, {
+				sculpt = "rimeholt_kneeler",
+				x = g.x,
+				z = g.z,
+				-- Faces the heart of the court.
+				yaw = math.deg(math.atan2(cx - g.x, cz - g.z)),
+				scale = g.scale,
+				sink = g.sink,
+			})
+		end
+		-- A marker stone at each mouth, its rag in the accent's ice-blue.
+		table.insert(marks, { sculpt = "rimeholt_marker", x = 2.3, z = zIn + 2.6, yaw = 90 })
+		table.insert(marks, { sculpt = "rimeholt_marker", x = w - 1.3, z = zOut - 2.6, yaw = -90 })
+		table.insert(marks, { sculpt = "rimeholt_hillfire", x = fireX, z = fireZ, yaw = between(rng, 0, 360) })
+
+		-- The court's weather over the heart of the ice, and the light under it,
+		-- both on the same slow beat (set pieces rimeholt_ring_snow, rimeholt_underice).
+		local effects: { DraftedMap.Effect } = {
+			{ recipe = "rimeholt_ring_snow", x = cx, z = cz, lift = 0, seed = math.floor(rng:NextNumber() * 1000) },
+			{ recipe = "rimeholt_underice", x = cx, z = cz, lift = 0.4, seed = math.floor(rng:NextNumber() * 1000) },
+		}
+
+		-- One giant is the subject, seen from across the pool with the ice for
+		-- a foreground; the second shot looks over another giant's back at the
+		-- whole court.
+		local face = giants[1]
+		local fx, fz = face.x - cx, face.z - cz
+		local flen = math.max(math.sqrt(fx * fx + fz * fz), 1e-6)
+		local near = giants[2]
+		local ox, oz = near.x - cx, near.z - cz
+		local len = math.max(math.sqrt(ox * ox + oz * oz), 1e-6)
+
+		return {
+			width = w,
+			depth = d,
+			walk = walk,
+			heights = heights,
+			kinds = kinds,
+			marks = marks,
+			effects = effects,
+			road = road,
+			cameras = {
+				{
+					name = "the giant across the pool",
+					from = { x = cx - fx / flen * 6, z = cz - fz / flen * 6, lift = 5 },
+					to = { x = face.x, z = face.z, lift = 7 },
+					fov = 64,
+				},
+				{
+					-- Behind a giant and stepped off its shoulder, high, so its
+					-- hood frames the left of the court and not the middle of it.
+					name = "the court over a giant's shoulder",
+					from = {
+						x = near.x + ox / len * 4.5 - oz / len * 5,
+						z = near.z + oz / len * 4.5 + ox / len * 5,
+						lift = 38,
+					},
+					to = { x = cx, z = cz, lift = 2 },
+					fov = 58,
+				},
+			},
+		}
+	end,
+}
+
+return feature
