diff --git a/src/shared/systems/features/RimeholtCrevasseBridge.luau b/src/shared/systems/features/RimeholtCrevasseBridge.luau
new file mode 100644
index 00000000..a358da89
--- /dev/null
+++ b/src/shared/systems/features/RimeholtCrevasseBridge.luau
@@ -0,0 +1,372 @@
+--!strict
+-- Rimeholt: a crevasse split across a frozen lake, its walls stepping down in
+-- bands from pale ice to blue dark, crossed by a bridge of ice ribs and lashed
+-- timber. The ice has buckled up along one lip and opened flat along the other,
+-- where the wind takes the snow over the edge and down into the crack. A cold
+-- light breathes deep in the crack, under a scatter of fallen ice. Its
+-- photograph is taken low along the crack, the bridge crossing the frame.
+local DraftedMap = require("../DraftedMap")
+local MapFeature = require("../MapFeature")
+local Noise = require("../Noise")
+
+type Landmark = DraftedMap.Landmark
+type Effect = DraftedMap.Effect
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+-- One of `list`, by the seeded rng (NextNumber only: the offline stand-in
+-- Random has no NextInteger).
+local function pick<T>(rng: Random, list: { T }): T
+	return list[math.min(#list, math.floor(rng:NextNumber() * #list) + 1)]
+end
+
+local function jitter(rng: Random, reach: number): number
+	return (rng:NextNumber() - 0.5) * reach
+end
+
+local feature: MapFeature.Feature = {
+	name = "RimeholtCrevasseBridge",
+	about = "A crevasse split across Rimeholt's lake ice, its walls stepping down into blue dark, crossed by a bridge of ice and lashed timber, with snow spilling over the lip.",
+	palette = "Rimeholt",
+	scale = "medium",
+	role = "crossing",
+	mood = { "frozen", "deep", "crossing", "drifting" },
+	cells = {
+		-- The lake ice that has opened flat along the lip: walkable, a hair over
+		-- the snow, its own colours so the tileset's props keep off it.
+		apron = {
+			ground = { material = "Marble", color = { 64, 78, 86 } },
+			lift = 0.2,
+			clear = true,
+		},
+		-- The far lip, buckled up as the ice closed: a low ridge along the crack.
+		heave = {
+			ground = { material = "Marble", color = { 70, 86, 94 } },
+			lift = 0.25,
+			clear = true,
+		},
+		-- The crevasse's four steps down, each darker than the one above: a pale
+		-- shelf, a blue wall, a dark wall, and a near-black floor with the cold
+		-- light breathing in it. A hair of lift keeps each painted face clear of
+		-- the tileset's own fill under it.
+		crack_lip = {
+			ground = { material = "Marble", color = { 74, 92, 100 } },
+			lift = 0.06,
+			clear = true,
+			props = { { sculpt = "rimeholt_ice_shard", every = 6, scale = { 0.6, 1.2 }, sink = 0.25 } },
+		},
+		crack_wall = {
+			ground = { material = "Marble", color = { 50, 66, 80 } },
+			lift = 0.06,
+			clear = true,
+			props = { { sculpt = "rimeholt_ice_shard", every = 9, scale = { 0.8, 1.6 }, sink = 0.4 } },
+		},
+		crack_deep = {
+			ground = { material = "Marble", color = { 30, 40, 54 } },
+			lift = 0.06,
+			clear = true,
+			glow = { color = { 110, 196, 202 }, range = 13, brightness = 1.4, every = 10, height = 2.6 },
+			props = { { sculpt = "rimeholt_ice_slab", every = 9, scale = { 0.4, 0.7 }, sink = 0.2 } },
+		},
+		crack_black = {
+			ground = { material = "Concrete", color = { 10, 13, 19 } },
+			lift = 0.06,
+			clear = true,
+			glow = { color = { 126, 214, 214 }, range = 16, brightness = 1.8, every = 12, height = 3.4 },
+			props = { { sculpt = "rimeholt_ice_slab", every = 10, scale = { 0.3, 0.55 }, sink = 0.2 } },
+		},
+		-- The bridge's deck under the planks: dark, so the gaps in the timber
+		-- read as the drop and not as snow.
+		deck = {
+			ground = { material = "Concrete", color = { 36, 33, 30 } },
+			lift = 0.15,
+			clear = true,
+		},
+	} :: { [string]: DraftedMap.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		local w, d = 30, 26
+		local count = w * d
+		local walk = table.create(count, true)
+		local heights = table.create(count, 0)
+		local kinds: { [number]: string } = {}
+
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+
+		local field = Noise.field(rng)
+		local baseZ = between(rng, 10, 16)
+		local wander = between(rng, 0.6, 1.4)
+		local slant = between(rng, -0.4, 0.4)
+		local tanS = math.tan(slant)
+		local norm = math.sqrt(1 + tanS * tanS)
+		-- Unit vector along the crack, for the road's strip and the props' offsets.
+		local alongX, alongZ = 1 / norm, tanS / norm
+		local halfWidth = between(rng, 1.5, 3.0)
+		local deepest = between(rng, 12, 17)
+		local skew = between(rng, 0.8, 1.25)
+		local heaveSide = if rng:NextNumber() < 0.5 then -1 else 1
+		-- Where the road crosses: a different place along the crack every seed.
+		local bridgeX = 9 + math.floor(rng:NextNumber() * 12)
+
+		-- The crack: a slanted, wandering centre line that pinches out toward the
+		-- map's edges, its floor dipping and rising as it runs. Its two sides
+		-- fall at different rates (`skew`), so one wall is steeper every seed.
+		local centre: { [number]: number } = {}
+		local reach: { [number]: number } = {}
+		local floorDepth: { [number]: number } = {}
+		for x = 1, w do
+			local wobble = Noise.sample(field, x * 0.11 + 1.7, 0.5)
+			centre[x] = baseZ + (x - w / 2) * tanS + wobble * wander
+			local taper = math.min(1, math.min(x, w + 1 - x) / 5)
+			reach[x] = halfWidth * (0.4 + 0.6 * taper)
+			floorDepth[x] = deepest + Noise.sample(field, x * 0.17, 7.3) * 0.8
+		end
+		local bridgeZ = math.clamp(math.floor(centre[bridgeX] + 0.5), 4, d - 4)
+
+		local lipCells: { { number } } = {}
+		local wallCells: { { number } } = {}
+		local deepCells: { { number } } = {}
+		local blackCells: { { number } } = {}
+		local apronCells: { { number } } = {}
+		local heaveCells: { { number } } = {}
+
+		for x = 1, w do
+			for z = 1, d do
+				local i = at(x, z)
+				local dz = z - centre[x]
+				if math.abs(dz) <= reach[x] then
+					walk[i] = false
+					local u = math.abs(dz) / reach[x]
+					-- One wall falls faster than the other (`skew`), so the bands
+					-- are unequal every seed.
+					if dz > 0 then
+						u *= skew
+					end
+					-- Four steps down, each darker and each near the four studs a
+					-- painted cell's face is drawn, so every step shows its band.
+					if u <= 0.34 then
+						heights[i] = -floorDepth[x]
+						kinds[i] = "crack_black"
+						table.insert(blackCells, { x, z })
+					elseif u <= 0.6 then
+						heights[i] = -floorDepth[x] * 0.76
+						kinds[i] = "crack_deep"
+						table.insert(deepCells, { x, z })
+					elseif u <= 0.82 then
+						heights[i] = -floorDepth[x] * 0.52
+						kinds[i] = "crack_wall"
+						table.insert(wallCells, { x, z })
+					else
+						heights[i] = -floorDepth[x] * 0.26
+						kinds[i] = "crack_lip"
+						table.insert(lipCells, { x, z })
+					end
+				end
+			end
+		end
+
+		-- The bridge's deck: every crack cell within a deck's width of the road's
+		-- line, walked at the bank's level. The line runs square across the
+		-- slanted crack, so the strip it takes is slanted with it.
+		local function alongOf(x: number, z: number): number
+			return (x - bridgeX) * alongX + (z - bridgeZ) * alongZ
+		end
+		local deckHalf = 1.15
+		for x = 1, w do
+			for z = 1, d do
+				local i = at(x, z)
+				if not walk[i] and math.abs(alongOf(x, z)) <= deckHalf then
+					walk[i] = true
+					heights[i] = 0
+					kinds[i] = "deck"
+				end
+			end
+		end
+
+		-- The road's line: across the crack's normal through the bridge, in off
+		-- the south edge, out the north.
+		local function roadXAt(z: number): number
+			return bridgeX - tanS * (z - bridgeZ)
+		end
+		local lip = reach[bridgeX] * 1.08 + 1.6
+
+		-- The two lips: one buckled up into a low ridge of ice, the other opened
+		-- flat, and the road's crossing left bare between them.
+		local heave = between(rng, 0.7, 1.4)
+		for x = 1, w do
+			for z = 1, d do
+				local i = at(x, z)
+				if walk[i] and kinds[i] == nil and math.abs(alongOf(x, z)) > 2.5 then
+					local dz = z - centre[x]
+					if math.abs(dz) > reach[x] and math.abs(dz) <= reach[x] + 1.02 then
+						local side = if dz > 0 then 1 else -1
+						if side == heaveSide then
+							heights[i] = heave * (0.82 + 0.09 * Noise.sample(field, x * 0.3, 3.9))
+							kinds[i] = "heave"
+							table.insert(heaveCells, { x, z })
+						else
+							kinds[i] = "apron"
+							table.insert(apronCells, { x, z })
+						end
+					end
+				end
+			end
+		end
+
+		local road = {
+			{ x = math.clamp(roadXAt(d), 3, w - 2), z = d },
+			{ x = roadXAt(bridgeZ + lip + 0.5), z = bridgeZ + lip + 0.5 },
+			{ x = bridgeX, z = bridgeZ },
+			{ x = roadXAt(bridgeZ - lip - 0.5), z = bridgeZ - lip - 0.5 },
+			{ x = math.clamp(roadXAt(1), 3, w - 2), z = 1 },
+		}
+
+		local marks: { Landmark } = {}
+		local effects: { Effect } = {}
+		local function offRoad(x: number, z: number, reachOut: number): boolean
+			return math.abs(alongOf(x, z)) > reachOut and x >= 3 and x <= w - 2
+		end
+
+		-- The crossing itself: ice ribs for a deck, lashed timber across them,
+		-- sized so its posts stand on the banks however wide the crack runs.
+		local spanScale = math.clamp((reach[bridgeX] * 8 + 8) / 30, 0.85, 1.35)
+		table.insert(marks, {
+			sculpt = "rimeholt_ice_bridge",
+			x = bridgeX,
+			z = bridgeZ,
+			yaw = 90 + math.deg(slant) + between(rng, -3, 3),
+			scale = spanScale,
+			sink = -0.25,
+		})
+
+		-- Teeth of ice standing out of the crack's walls and lips, so the edge
+		-- is broken rather than cut; a few stand lower, down on the shelves.
+		for _ = 1, 7 do
+			local from: { { number } }
+			local roll = rng:NextNumber()
+			if roll < 0.3 then
+				from = wallCells
+			elseif roll < 0.6 then
+				from = lipCells
+			elseif roll < 0.8 then
+				from = apronCells
+			else
+				from = heaveCells
+			end
+			local cell = pick(rng, from)
+			if offRoad(cell[1], cell[2], 3.5) then
+				table.insert(marks, {
+					sculpt = "rimeholt_ice_buttress",
+					x = cell[1] + jitter(rng, 0.45),
+					z = cell[2] + jitter(rng, 0.45),
+					yaw = rng:NextNumber() * 360,
+					scale = between(rng, 0.45, 0.95),
+					sink = between(rng, 0.7, 1.8),
+				})
+			end
+		end
+
+		-- Fallen ice in the crack: slabs off the walls lying on the shelves and
+		-- the black floor, a few more than the scatter already gives.
+		for n = 1, 6 do
+			local cell = pick(rng, if n % 3 == 0 then wallCells else (if n % 2 == 0 then deepCells else blackCells))
+			if cell[1] >= 3 and cell[1] <= w - 2 then
+				table.insert(marks, {
+					sculpt = "rimeholt_ice_slab",
+					x = cell[1] + jitter(rng, 0.6),
+					z = cell[2] + jitter(rng, 0.6),
+					yaw = rng:NextNumber() * 360,
+					scale = between(rng, 0.5, 0.95),
+					sink = 0.25,
+				})
+			end
+		end
+
+		-- What the hill-folk left at the crossing: balks of timber and a
+		-- brazier on the south bank, a marker stone where the way on starts
+		-- again on the north.
+		local southBank = bridgeZ + lip + 2.2
+		local northBank = bridgeZ - lip - 2.4
+		table.insert(marks, {
+			sculpt = "rimeholt_bridge_timbers",
+			x = math.clamp(roadXAt(southBank) - 1.8, 3, w - 2),
+			z = math.min(southBank, d - 2),
+			yaw = between(rng, -14, 14),
+			sink = 0.3,
+		})
+		table.insert(marks, {
+			sculpt = "rimeholt_hillfire",
+			x = math.clamp(roadXAt(southBank + 1.4) - 2.9, 3, w - 2),
+			z = math.min(southBank + 1.4, d - 2),
+		})
+		table.insert(marks, {
+			sculpt = "rimeholt_marker",
+			x = math.clamp(roadXAt(northBank) + 3.1, 3, w - 2),
+			z = math.max(northBank, 2),
+			yaw = 180,
+			scale = 0.8,
+		})
+
+		-- Snow leaving the flat lip on the wind: two spills, either side of the
+		-- bridge, their emitters set at the snow's level over the crack so the
+		-- fall goes down into it.
+		local apronSide = -heaveSide
+		for k, want in { -7, 8 } do
+			local best: { number }? = nil
+			local bestD = math.huge
+			for _, cell in lipCells do
+				local x, z = cell[1], cell[2]
