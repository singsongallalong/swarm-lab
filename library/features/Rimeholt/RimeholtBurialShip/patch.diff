diff --git a/src/shared/systems/features/RimeholtBurialShip.luau b/src/shared/systems/features/RimeholtBurialShip.luau
new file mode 100644
index 00000000..199c0e18
--- /dev/null
+++ b/src/shared/systems/features/RimeholtBurialShip.luau
@@ -0,0 +1,276 @@
+--!strict
+-- Rimeholt's burial longship: the hill-folk laid a chief in a boat and sank her
+-- in the tarn that never thaws, and the winter kept her. She lies canted in the
+-- lake ice, her bow lifted clear of it, her mast heaved over and the ribs
+-- standing where the strakes are gone; the pale water-ice has closed over her
+-- stern, and a cold light breathes up through it along the drowned hull. A band
+-- of heaved ice and pale shards marks where she broke through; the winter road
+-- crosses the snow along the shore, the way on to the next barrow.
+local DraftedMap = require("../DraftedMap")
+local Grid = require("../Grid")
+local MapFeature = require("../MapFeature")
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local feature: MapFeature.Feature = {
+	name = "RimeholtBurialShip",
+	about = "A hill-folk burial longship frozen at a tilt in the lake ice, mast and ribs standing out of the shattered ice over the light in her drowned hull.",
+	palette = "Rimeholt",
+	scale = "centrepiece",
+	role = "centrepiece",
+	mood = { "frozen", "buried", "tilted", "glowing" },
+	cells = {
+		-- The tarn's old ice: a pale sheet a hair over the lake's bed, the
+		-- cold green of light inside it showing at the edges.
+		ice = {
+			ground = { material = "Ice", color = { 60, 72, 74 } },
+			lift = 0.35,
+			clear = true,
+		},
+		-- Her stern, drowned under the ice: a hull's plan in near-black seen
+		-- through the pale surface.
+		drowned = {
+			ground = { material = "Slate", color = { 18, 20, 22 } },
+			lift = 0.45,
+			clear = true,
+		},
+		-- The cold light under the ice, laid as one long narrow strip along
+		-- her drowned hull's near gunwale, so it traces her outline beside
+		-- the ship instead of smearing over the lake.
+		seam = {
+			ground = { material = "Marble", color = { 82, 96, 98 } },
+			lift = 0.5,
+			clear = true,
+			glow = { color = { 110, 196, 204 }, range = 14, brightness = 1.2, every = 2, height = 0.4 },
+		},
+		-- The ice heaved up where she broke through: pale slabs standing out
+		-- of the lake, their faces catching the moon.
+		heave = {
+			ground = { material = "Salt", color = { 82, 96, 98 } },
+			lift = 0.35,
+			clear = true,
+		},
+	} :: { [string]: DraftedMap.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		local w, d = 46, 38
+		local walk = table.create(w * d, true)
+		local heights = table.create(w * d, 0)
+		local kinds: { [number]: string } = {}
+		local lifts: { [number]: number } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+
+		-- The tarn: a broad oval of old ice lying a step below the highland.
+		local cx = w / 2 + between(rng, -1.5, 1.5)
+		local cz = d / 2 - 3 + between(rng, -1, 1)
+		local rx = between(rng, 14, 15.5)
+		local rz = between(rng, 9, 10.5)
+		local function lake(x: number, z: number): boolean
+			return ((x - cx) / rx) ^ 2 + ((z - cz) / rz) ^ 2 <= 1
+		end
+		for z = 1, d do
+			for x = 1, w do
+				if lake(x, z) then
+					local i = at(x, z)
+					heights[i] = -1
+					kinds[i] = "ice"
+					lifts[i] = 0.35
+				end
+			end
+		end
+
+		-- Her heading: bow lifted toward the winter road, swung widely each
+		-- seed. `fx, fz` is the bow's way in cells; `px, pz` is across her
+		-- toward the open side. Seeds also pick how steeply she stands and
+		-- how deep the lake has her, so no two maps meet the same wreck.
+		local steep = rng:NextNumber() < 0.5
+		local shipSink = between(rng, 1.5, 6)
+		local shipScale = between(rng, 1, 1.2)
+		local yaw = -38 + between(rng, -20, 20)
+		local rad = math.rad(yaw)
+		local fx, fz = math.cos(rad), -math.sin(rad)
+		local px, pz = -fz, fx
+		local sx, sz = cx + between(rng, -1, 1), cz - between(rng, 0.5, 2)
+
+		-- Her drowned stern, under the ice: a hull's plan running on from the
+		-- wreck's stern, pointed at its far end, near-black under the surface.
+		local drownFrom = -4.2
+		local drownTo = drownFrom - between(rng, 5.5, 8)
+		local drownBeam = between(rng, 1.7, 2.5)
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				if kinds[i] == "ice" then
+					local dx, dz = x - sx, z - sz
+					local along = dx * fx + dz * fz
+					if along <= drownFrom and along >= drownTo then
+						local t = (along - drownTo) / (drownFrom - drownTo)
+						local across = dx * px + dz * pz
+						local beam = drownBeam * math.sqrt(t)
+						if math.abs(across) <= beam then
+							kinds[i] = "drowned"
+							lifts[i] = 0.45
+							-- The lit strip runs the near gunwale's length: a
+							-- narrow lane the cold shows through.
+							if across >= beam * 0.35 and across <= beam * 0.98 then
+								kinds[i] = "seam"
+								lifts[i] = 0.5
+							end
+						end
+					end
+				end
+			end
+		end
+
+		-- The ice heaved where she came through: broken bands of pale slab
+		-- along her stern's flanks, highest where the weight came down, open
+		-- at the bow so the lake still walks round her.
+		local sternX, sternZ = sx + fx * drownFrom, sz + fz * drownFrom
+		local phase = between(rng, 0, math.pi * 2)
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				if kinds[i] == "ice" then
+					local dx, dz = x - sx, z - sz
+					local side = math.abs(dx * px + dz * pz)
+					local along = dx * fx + dz * fz
+					local wobble = math.sin(along * 1.7 + phase) * 0.9 + math.sin(along * 3.3 - phase) * 0.5
+					if along < 1.5 and side + wobble >= 2.6 and side + wobble <= 4.0 then
+						if between(rng, 0, 1) < 0.62 then
+							walk[i] = false
+							kinds[i] = "heave"
+							heights[i] = between(rng, 0.8, 2.8) - math.max(along, -6) * 0.08
+							lifts[i] = between(rng, 0, 0.4)
+						end
+					end
+				end
+			end
+		end
+
+		-- Any pocket the slabs closed over is ice, not a trap: fill the small
+		-- walkable regions so the lake is one sheet underfoot.
+		local grid = Grid.new(w, d, Grid.WALL)
+		for i, ok in walk do
+			grid.cells[i] = if ok then Grid.FLOOR else Grid.WALL
+		end
+		local regions = Grid.regions(grid)
+		for r = 2, #regions do
+			for _, i in regions[r] do
+				walk[i] = false
+				kinds[i] = "heave"
+				heights[i] = between(rng, 0.3, 1.2)
+				lifts[i] = 0.35
+			end
+		end
+
+		-- The winter road: in off the south snow, along the tarn's shore and
+		-- out east, so the wreck is met across the ice and then walked past.
+		local road = {
+			{ x = 4, z = d },
+			{ x = 4 + between(rng, -1, 1), z = 33 },
+			{ x = 9 + between(rng, -1, 1), z = 31 },
+			{ x = 17 + between(rng, -1, 1), z = 30.5 + between(rng, -1, 1) },
+			{ x = 26 + between(rng, -1, 1), z = 30.5 + between(rng, -1, 1) },
+			{ x = 36 + between(rng, -1, 1), z = 31.5 + between(rng, -1, 1) },
+			{ x = w, z = 32 + between(rng, -1.5, 1.5) },
+		}
+
+		-- The grave-fire on the shore, halfway along the lake's south edge
+		-- between the road and the ice: the last hill-fire, left for her.
+		local fireX = cx + between(rng, 1, 4)
+		local fireZ = cz + rz + between(rng, 1.2, 2.4)
+
+		-- The longship herself, her mast and ribs, and the shards where the
+		-- ice broke under her.
+		local ribX, ribZ = sx + px * 2.6 - fx * 0.4, sz + pz * 2.6 - fz * 0.4
+		local mastX, mastZ = sx - px * 1.6 + fx * 1.2, sz - pz * 1.6 + fz * 1.2
+		-- Three great shards splayed outward where the lake stood up round
+		-- her, each leaned away from the hull along its own radius.
+		local shafts = {}
+		for k = 1, 3 do
+			local angle = math.rad(between(rng, -70, 70) + (k - 2) * 70 + 180)
+			local out = between(rng, 5.5, 8)
+			local ox, oz = math.cos(angle), math.sin(angle)
+			table.insert(shafts, {
+				sculpt = "rimeholt_ice_shards",
+				x = sternX + ox * out,
+				z = sternZ + oz * out,
+				yaw = math.deg(math.atan2(-oz, ox)),
+				scale = between(rng, 1.1, 1.6),
+				sink = 0.4,
+			})
+		end
+
+		local effects = {
+			{
+				recipe = "rimeholt_ship_breath",
+				x = ribX - px * 0.6,
+				z = ribZ - pz * 0.6,
+				lift = 1,
+			},
+		}
+		-- The light under the ice runs the strip's whole length: the area's
+		-- own under-ice glow, laid in a line along her drowned gunwale.
+		for k = 1, 3 do
+			local along = drownFrom - 1 - (k - 1) * 2.4
+			local t = math.clamp((along - drownTo) / (drownFrom - drownTo), 0, 1)
+			local beam = drownBeam * math.sqrt(t) * 0.7
+			table.insert(effects, {
+				recipe = "rimeholt_underice",
+				x = sx + fx * along + px * beam,
+				z = sz + fz * along + pz * beam,
+				lift = 0.55,
+			})
+		end
+
+		local marks = {
+			{
+				-- Two hulls: she may stand steep out of the ice or lie low in
+				-- it, and each seed takes one, with its own depth and size.
+				sculpt = if steep then "rimeholt_burial_ship_steep" else "rimeholt_burial_ship",
+				x = sx,
+				z = sz,
+				yaw = yaw,
+				sink = shipSink,
+				scale = shipScale,
+			},
+			{ sculpt = "rimeholt_ship_mast", x = mastX, z = mastZ, yaw = yaw, sink = 0.5 },
+			{ sculpt = "rimeholt_ship_ribs", x = ribX, z = ribZ, yaw = yaw, sink = 1.4 },
+			{ sculpt = "rimeholt_hillfire", x = fireX, z = fireZ },
+		}
+		for _, shard in shafts do
+			table.insert(marks, shard)
+		end
+
+		return {
+			width = w,
+			depth = d,
+			walk = walk,
+			heights = heights,
+			kinds = kinds,
+			lifts = lifts,
+			marks = marks,
+			effects = effects,
+			road = road,
+			cameras = {
+				{
+					name = "the lit hull under the ice",
+					from = { x = sx + px * 13 + fx * 2, z = sz + pz * 13 + fz * 2, lift = 26 },
+					to = { x = sx - fx * 1, z = sz - fz * 1, lift = 8 },
+					fov = 54,
+				},
+				{
+					name = "her whole length, from the bow",
+					from = { x = sx + fx * 14 + px * 6, z = sz + fz * 14 + pz * 6, lift = 30 },
+					to = { x = sx, z = sz, lift = 6 },
+					fov = 54,
+				},
+			},
+		}
+	end,
+}
+
+return feature
