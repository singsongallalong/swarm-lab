+				end
+				for _, c in cells do
+					if c.x < 2 or c.z < 2 or c.x > w - 1 or c.z > d - 1 then
+						return false
+					end
+					if distanceToRoad(road, c.x, c.z) < 2.4 then
+						return false
+					end
+				end
+			end
+			return true
+		end
+		local bestScore, bestX, bestZ, bestYaw = math.huge, nil, nil, nil
+		local function scoreOf(x: number, z: number, yaw: number): number
+			-- How far the whole wreck (hull, ribs and all) sits from the pad's
+			-- middle, so the game camera over the feature finds it.
