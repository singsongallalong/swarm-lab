+		-- The lead: the crack the ice opened round the wreck.
+		local function leadCell(x: number, z: number)
+			if not inside(x, z) then
+				return
+			end
+			local i = at(x, z)
+			if walk[i] and (kinds[i] == "ice" or kinds[i] == "wreck") then
+				kinds[i] = "lead"
+			end
+		end
+		local leadAngle = between(rng, 0, math.pi)
+		if leadKind == "ring" then
+			local rx, rz = between(rng, 5.5, 8), between(rng, 4.5, 7)
+			local phase = between(rng, 0, math.pi)
+			for z = 1, d do
+				for x = 1, w do
+					local dx, dz = (x - cx) / rx, (z - cz) / rz
+					local wobble = math.sin(math.atan2(dz, dx) * 3 + phase) * 0.16
+					local r = math.sqrt(dx * dx + dz * dz)
+					if math.abs(r - 1 - wobble) < 0.16 then
