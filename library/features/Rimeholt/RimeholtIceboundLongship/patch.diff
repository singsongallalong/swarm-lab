+				local rx = between(rng, 4, w - 4)
+				local rz = between(rng, 4, d - 4)
+				local angle = between(rng, 0, math.pi)
+				local halfLength = between(rng, 3, 7)
+				local halfWidth = between(rng, 0.6, 1.15)
+				local ax, az = math.cos(angle), math.sin(angle)
+				local cells: { Point } = {}
+				local ok = true
+				for z = math.floor(rz - halfLength - 1), math.ceil(rz + halfLength + 1) do
+					for x = math.floor(rx - halfLength - 1), math.ceil(rx + halfLength + 1) do
+						local dseg = distanceToSegment(
+							x,
+							z,
+							rx - ax * halfLength,
+							rz - az * halfLength,
+							rx + ax * halfLength,
+							rz + az * halfLength
+						)
+						if dseg <= halfWidth then
