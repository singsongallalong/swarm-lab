+								ok = false
+							else
+								for _, part in parts do
+									if nearPart(part, cx, cz, shipYaw, x, z, 1.0) then
+										ok = false
+									end
+								end
+							end
+							table.insert(cells, { x = x, z = z })
+						end
+					end
+				end
+				for _, band in bands do
+					if
+						distanceToSegment(
+							rx,
+							rz,
+							band.x - math.cos(band.angle) * band.halfLength,
+							band.z - math.sin(band.angle) * band.halfLength,
+							band.x + math.cos(band.angle) * band.halfLength,
+							band.z + math.sin(band.angle) * band.halfLength
+						) < halfWidth + band.halfWidth + 1.2
+					then
+						ok = false
+					end
+				end
