+		local parts = partsFor(wreck)
+		local lowAlong, highAlong = math.huge, -math.huge
+		for _, part in parts do
+			lowAlong = math.min(lowAlong, part.along - part.halfLength)
+			highAlong = math.max(highAlong, part.along + part.halfLength)
+		end
+		local middleAlong = (lowAlong + highAlong) / 2
+		local function partWorld(part: Part, cx: number, cz: number, yaw: number): (number, number, number)
+			local rad = math.rad(yaw)
+			local ax, az = math.cos(rad), math.sin(rad)
+			local wx = cx + ax * part.along - az * part.across
+			local wz = cz + az * part.along + ax * part.across
+			return wx, wz, yaw + part.yawOffset
+		end
+		local function partCells(part: Part, cx: number, cz: number, yaw: number): { Point }
+			local wx, wz, pyaw = partWorld(part, cx, cz, yaw)
+			local rad = math.rad(pyaw)
+			local ax, az = math.cos(rad), math.sin(rad)
+			local out: { Point } = {}
+			local reach = part.halfLength + 1
+			for z = math.floor(wz - reach), math.ceil(wz + reach) do
+				for x = math.floor(wx - reach), math.ceil(wx + reach) do
+					local dx, dz = x - wx, z - wz
+					local a = dx * ax + dz * az
+					local b = -dx * az + dz * ax
+					if (a / part.halfLength) ^ 2 + (b / part.halfWidth) ^ 2 <= 1 then
+						table.insert(out, { x = x, z = z })
+					end
+				end
+			end
+			return out
+		end
+		local function nearPart(
+			part: Part,
+			cx: number,
+			cz: number,
+			yaw: number,
+			x: number,
+			z: number,
+			grow: number
+		): boolean
+			local wx, wz, pyaw = partWorld(part, cx, cz, yaw)
+			local rad = math.rad(pyaw)
+			local ax, az = math.cos(rad), math.sin(rad)
+			local dx, dz = x - wx, z - wz
+			local a = dx * ax + dz * az
+			local b = -dx * az + dz * ax
+			return (a / (part.halfLength + grow)) ^ 2 + (b / (part.halfWidth + grow)) ^ 2 <= 1
+		end
+		local function shipFits(cx: number, cz: number, yaw: number): boolean
+			for _, part in parts do
+				local cells = partCells(part, cx, cz, yaw)
+				if #cells == 0 then
