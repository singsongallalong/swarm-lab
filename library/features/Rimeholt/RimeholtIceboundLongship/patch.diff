+					table.insert(
+						bands,
+						{ x = rx, z = rz, angle = angle, halfLength = halfLength, halfWidth = halfWidth }
+					)
+					for _, c in cells do
+						local dx, dz = c.x - rx, c.z - rz
+						local a = dx * ax + dz * az
+						local i = at(c.x, c.z)
+						walk[i] = false
