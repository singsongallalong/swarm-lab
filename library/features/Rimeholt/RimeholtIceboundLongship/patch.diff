+		-- The shore bluff: a broken wall of heaved ice along the shore's edge,
+		-- gapped where the road walks in and where the ice breaks.
+		local function paintBluff(edge: string)
+			local along = if edge == "south" or edge == "north" then w else d
+			local across = if edge == "south" or edge == "north" then d else w
+			local runStart = whole(rng, 2, math.max(3, along - 12))
+			local runEnd = math.min(along - 2, runStart + whole(rng, 5, 12))
+			for a = runStart, runEnd do
+				local boundary = nil
+				for b = 1, across - 1 do
+					local x, z
+					if edge == "south" then
+						x, z = a, b
+					elseif edge == "north" then
+						x, z = a, d - b + 1
+					elseif edge == "west" then
+						x, z = b, a
+					else
+						x, z = w - b + 1, a
+					end
+					if kinds[at(x, z)] == "snow" then
+						boundary = { x = x, z = z }
+						break
+					end
+				end
+				if boundary and rng:NextNumber() < 0.82 then
+					local bx, bz = boundary.x, boundary.z
+					if edge == "south" then
+						bz -= 1
+					elseif edge == "north" then
+						bz += 1
+					elseif edge == "west" then
+						bx += 1
+					else
+						bx -= 1
+					end
+					if bx >= 2 and bz >= 2 and bx <= w - 1 and bz <= d - 1 then
+						if distanceToRoad(road, bx, bz) > 2.6 then
+							local i = at(bx, bz)
+							walk[i] = false
+							kinds[i] = "icewall"
+							lifts[i] = between(rng, 3.5, 7.5)
+						end
+					end
+				end
+			end
+		end
+		paintBluff(shoreEdge)
