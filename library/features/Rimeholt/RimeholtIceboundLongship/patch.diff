diff --git a/src/shared/systems/features/RimeholtIceboundLongship.luau b/src/shared/systems/features/RimeholtIceboundLongship.luau
new file mode 100644
index 00000000..f3900478
--- /dev/null
+++ b/src/shared/systems/features/RimeholtIceboundLongship.luau
@@ -0,0 +1,949 @@
+--!strict
+-- Rimeholt's ice-bound longship: a hill-folk burial ship frozen into the lake
+-- at a tilt, the ribs and mast standing over it, its keel still glowing cold
+-- under the sheet. Pressure ridges heave the ice up in slabs, a lead cracks
+-- round the wreck, a pale ice collar sets the dark hull off from the lake,
+-- snow lies on one shore, and the road crosses the ice past the bow.
+--
+-- Its seeds differ in kind, not only detail (fafwa, 2026-10-30: topology
+-- first, then look). The first draws choose the structure, the rest only
+-- dress it:
+--   1. the road's crossing of the lake: south-north, west-east, south-east or
+--      north-west;
+--   2. the wreck: bow up and whole, broken in two, or sunk to the ribs;
+--   3. how the hull lies to the road: alongside, across or diagonal;
+--   4. the pressure ridges: 0 to 3, each its own angle, length and height, and
+--      a broken wall of heaved ice along part of the shore;
+--   5. the shore and leads: snow on one edge or two, a straight, bent or ring
+--      lead through the ice.
+local DraftedMap = require("../DraftedMap")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+type RoadPoint = { x: number, z: number, dirX: number, dirZ: number }
+type Band = { x: number, z: number, angle: number, halfLength: number, halfWidth: number }
+
+type Part = {
+	sculpt: string,
+	along: number,
+	across: number,
+	yawOffset: number,
+	scale: number,
+	sink: number,
+	halfLength: number,
+	halfWidth: number,
+	hidden: boolean?,
+}
+
+local CROSSINGS = { "south-north", "west-east", "south-east", "north-west" }
+local WRECKS = { "bow-up", "broken", "ribs" }
+local LIES = { "alongside", "across", "diagonal" }
+local EDGES = { "south", "north", "east", "west" }
+local LEADS = { "straight", "bent", "ring" }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local function pick(rng: Random, options: { string }): string
+	return options[whole(rng, 1, #options)]
+end
+
+local function distanceToSegment(px: number, pz: number, ax: number, az: number, bx: number, bz: number): number
+	local dx, dz = bx - ax, bz - az
+	local length = dx * dx + dz * dz
+	local t = if length == 0 then 0 else math.clamp(((px - ax) * dx + (pz - az) * dz) / length, 0, 1)
+	local qx, qz = ax + dx * t, az + dz * t
+	return math.sqrt((px - qx) ^ 2 + (pz - qz) ^ 2)
+end
+
+local function distanceToRoad(road: { Point }, x: number, z: number): number
+	local best = math.huge
+	for k = 2, #road do
+		best = math.min(best, distanceToSegment(x, z, road[k - 1].x, road[k - 1].z, road[k].x, road[k].z))
+	end
+	return best
+end
+
+-- The road across the lake: in on one border, out on another, bent once
+-- about the middle so no two seeds walk the same line.
+local function makeRoad(rng: Random, w: number, d: number, crossing: string): { Point }
+	local margin = 4
+	local a: Point
+	local b: Point
+	if crossing == "south-north" then
+		a = { x = whole(rng, margin, w - margin), z = d }
+		b = { x = whole(rng, margin, w - margin), z = 1 }
+	elseif crossing == "west-east" then
+		a = { x = 1, z = whole(rng, margin, d - margin) }
+		b = { x = w, z = whole(rng, margin, d - margin) }
+	elseif crossing == "south-east" then
+		a = { x = whole(rng, margin, w - margin), z = d }
+		b = { x = w, z = whole(rng, margin, d - margin) }
+	else
+		a = { x = whole(rng, margin, w - margin), z = 1 }
+		b = { x = 1, z = whole(rng, margin, d - margin) }
+	end
+	local bulge = between(rng, -0.2, 0.2)
+	local mx = math.clamp((a.x + b.x) / 2 + (b.z - a.z) * bulge, 2.5, w - 1.5)
+	local mz = math.clamp((a.z + b.z) / 2 - (b.x - a.x) * bulge, 2.5, d - 1.5)
+	return { a, { x = mx, z = mz }, b }
+end
+
+local function roadAt(road: { Point }, t: number): RoadPoint
+	local total = 0
+	for k = 2, #road do
+		total += math.sqrt((road[k].x - road[k - 1].x) ^ 2 + (road[k].z - road[k - 1].z) ^ 2)
+	end
+	local target = math.clamp(t, 0, 1) * total
+	for k = 2, #road do
+		local dx, dz = road[k].x - road[k - 1].x, road[k].z - road[k - 1].z
+		local len = math.sqrt(dx * dx + dz * dz)
+		if target <= len or k == #road then
+			local s = if len == 0 then 0 else math.clamp(target / len, 0, 1)
+			return {
+				x = road[k - 1].x + dx * s,
+				z = road[k - 1].z + dz * s,
+				dirX = if len == 0 then 1 else dx / len,
+				dirZ = if len == 0 then 0 else dz / len,
+			}
+		end
+		target -= len
+	end
+	return { x = road[1].x, z = road[1].z, dirX = 1, dirZ = 0 }
+end
+
+local function closestOnRoad(road: { Point }, x: number, z: number): RoadPoint
+	local best = math.huge
+	local bestPoint: RoadPoint = { x = road[1].x, z = road[1].z, dirX = 1, dirZ = 0 }
+	for k = 2, #road do
+		local ax, az, bx, bz = road[k - 1].x, road[k - 1].z, road[k].x, road[k].z
+		local dx, dz = bx - ax, bz - az
+		local length = dx * dx + dz * dz
+		local t = if length == 0 then 0 else math.clamp(((x - ax) * dx + (z - az) * dz) / length, 0, 1)
+		local px, pz = ax + dx * t, az + dz * t
+		local dist = math.sqrt((x - px) ^ 2 + (z - pz) ^ 2)
+		if dist < best then
+			best = dist
+			local len = math.sqrt(length)
+			bestPoint = {
+				x = px,
+				z = pz,
+				dirX = if len == 0 then 1 else dx / len,
+				dirZ = if len == 0 then 0 else dz / len,
+			}
+		end
+	end
+	return bestPoint
+end
+
+-- One piece of the wreck: its sculpt, where it stands along and across the
+-- keel, its own turn, scale and sink, the cells its mass occupies, and whether
+-- it lies under the ice (`hidden`: walkable, only the dark water over it shows).
+local function piece(
+	sculpt: string,
+	along: number,
+	across: number,
+	yawOffset: number,
+	scale: number,
+	sink: number,
+	halfLength: number,
+	halfWidth: number,
+	hidden: boolean?
+): Part
+	return {
+		sculpt = sculpt,
+		along = along,
+		across = across,
+		yawOffset = yawOffset,
+		scale = scale,
+		sink = sink,
+		halfLength = halfLength,
+		halfWidth = halfWidth,
+		hidden = hidden,
+	}
+end
+
+local HULL = "rimeholt_burial_hull"
+local RIBS = "rimeholt_ship_ribs"
+local MAST = "rimeholt_ship_mast"
+
+-- The wreck's pieces: the hull (whole, in two halves, or sunk under the ice),
+-- the ribs standing out of it, and the mast.
+local function partsFor(wreck: string): { Part }
+	if wreck == "broken" then
+		return {
+			piece(HULL, -4.6, 0, -11, 0.6, 3.4, 3.3, 1.5),
+			piece(HULL, 4.6, 0, 13, 0.68, 3.8, 3.6, 1.6),
+			piece(RIBS, 0, 0, 3, 0.5, 1.2, 1.9, 1.3),
+			piece(MAST, 4.4, 0.3, 90, 0.9, 0, 0.6, 0.6),
+		}
+	elseif wreck == "ribs" then
+		-- Only the ribs stand out: the hull has gone under the ice, and the
+		-- dark water frozen over it is all that shows of the ship below.
+		return {
+			piece(HULL, 0, 0, 0, 1, 0, 5.3, 1.9, true),
+			piece(RIBS, 1.2, 0, 6, 1.05, 0.8, 3.2, 1.9),
+			piece(MAST, 3.4, 0.3, 90, 1.05, 0, 0.6, 0.6),
+		}
+	end
+	-- Bow up: the whole ship frozen where it heeled, all but her keel out of
+	-- the ice, the ribcage standing beyond her bow.
+	return {
+		piece(HULL, 0, 0, 0, 1, 1.4, 5.3, 1.9),
+		piece(RIBS, 8, 0, 9, 0.7, 1, 2.4, 1.5),
+		piece(MAST, 0.6, 0.2, 90, 1, 0, 0.6, 0.6),
+	}
+end
+
+local feature: MapFeature.Feature = {
+	name = "RimeholtIceboundLongship",
+	about = "A hill-folk burial longship frozen into a lake that never thaws, its broken hull, ribs and mast standing out of the ice while its keel still glows cold under the sheet.",
+	palette = "Rimeholt",
+	scale = "medium",
+	role = "centrepiece",
+	mood = { "frozen", "buried", "glowing", "still" },
+	cells = {
+		-- The lake sheet: pale old ice, its surface a hand's width over the
+		-- ground, the tileset's props kept off it. Marble, which the tileset
+		-- leaves free, so the lake can be paler than its glacier.
+		ice = {
+			ground = { material = "Marble", color = { 74, 92, 100 } },
+			lift = 0.35,
+			clear = true,
+		},
+		-- The shore's old snow, with a few dead grass tufts, granite and black
+		-- pines: sparse, so the lake and its wreck stay the subject.
+		snow = {
+			ground = { material = "Limestone", color = { 90, 94, 96 } },
+			lift = 0.15,
+			clear = true,
+			props = {
+				{ sculpt = "rimeholt_boulder", every = 60, scale = { 0.6, 1.1 }, sink = 0.5 },
+				{ sculpt = "rimeholt_pine_snapped", every = 80, scale = { 0.8, 1.15 } },
+			},
+		},
+		-- A lead: black water frozen over thin. No light of its own: the wreck's
+		-- glow is the only light on the ice, so the surface stays calm.
+		lead = {
+			ground = { material = "Rock", color = { 26, 40, 48 } },
+			lift = 0.1,
+			clear = true,
+		},
+		-- Clean pale ice heaved up round the hull, separating it from the lake.
+		collar = {
+			ground = { material = "Concrete", color = { 92, 100, 102 } },
+			lift = 0.35,
+			clear = true,
+		},
+		-- The churned ice beyond the collar, with the wreck's timber on it.
+		wreck = {
+			ground = { material = "Sand", color = { 78, 90, 96 } },
+			lift = 0.2,
+			clear = true,
+			props = {
+				{ sculpt = "rimeholt_wreck_timber", every = 14, scale = { 0.7, 1.2 }, sink = 0.3 },
+				{ sculpt = "rimeholt_ice_slab", every = 60, scale = { 0.35, 0.6 }, sink = 0.3 },
+			},
+		},
+		-- Ice heaved up in a pressure ridge or along the shore: a wall of slabs.
+		icewall = {
+			ground = { material = "Salt", color = { 92, 100, 102 } },
+			lift = 5,
+			clear = true,
+			props = {
+				{ sculpt = "rimeholt_ice_slab", every = 1.8, scale = { 0.4, 0.6 }, sink = 0.8 },
+			},
+		},
+		-- Under the hull: the dark water the ship froze into.
+		hold = {
+			ground = { material = "Asphalt", color = { 36, 40, 48 } },
+			lift = 0.15,
+			clear = true,
+		},
+	} :: { [string]: DraftedMap.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-5: the structure, first.
+		local crossing = pick(rng, CROSSINGS)
+		local wreck = pick(rng, WRECKS)
+		local lie = pick(rng, LIES)
+		local ridgeCount = whole(rng, 0, 3)
+		local shoreEdge = pick(rng, EDGES)
+		local secondShore = rng:NextNumber() < 0.45
+		local leadKind = pick(rng, LEADS)
+
+		local w = whole(rng, 29, 32)
+		local d = whole(rng, 27, 31)
+		local n = w * d
+		local walk = table.create(n, true)
+		local heights = table.create(n, 0)
+		local kinds: { [number]: string } = {}
+		local lifts: { [number]: number } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		local function inside(x: number, z: number): boolean
+			return x >= 1 and z >= 1 and x <= w and z <= d
+		end
+
+		local road = makeRoad(rng, w, d, crossing)
+
+		-- The shore: a band of old snow along one edge (and sometimes a second),
+		-- its far side wandering so no seed has a straight strand.
+		local function paintShore(edge: string, depth: number)
+			local phase = between(rng, 0, math.pi * 2)
+			local amp = between(rng, 0.7, 1.6)
+			for z = 1, d do
+				for x = 1, w do
+					local a = if edge == "south" or edge == "north" then x else z
+					local wave = math.sin(a * 0.44 + phase) * amp + math.sin(a * 0.19 + phase * 1.7) * amp * 0.5
+					local on = if edge == "south"
+						then z >= d - depth + wave
+						elseif edge == "north" then z <= 1 + depth + wave
+						elseif edge == "west" then x <= 1 + depth + wave
+						else x >= w - depth + wave
+					if on then
+						kinds[at(x, z)] = "snow"
+					elseif kinds[at(x, z)] == nil then
+						kinds[at(x, z)] = "ice"
+					end
+				end
+			end
+		end
+		paintShore(shoreEdge, whole(rng, 3, 6))
+		if secondShore then
+			local order = { "south", "east", "north", "west" }
+			local index = 1
+			for k, edge in order do
+				if edge == shoreEdge then
+					index = k
+				end
+			end
+			local other = order[index % 4 + 1]
