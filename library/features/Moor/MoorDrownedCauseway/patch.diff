index 00000000..c5061def
--- /dev/null
+++ b/src/shared/systems/features/MoorDrownedCauseway.luau
@@ -0,0 +1,875 @@
+--!strict
+-- A drowned causeway for the moor: the old way across a mire. A raised road of pale
+-- flagstones and dark log sleepers runs on a bank over sunken black bog pools, its
+-- sunken posts and half-sunk toll gate marking the way, marsh-light hanging over
+-- the water. The moor has the Low Moor's single slate stones across its hollows; it
+-- has no place where a whole road was built over deep water and left to drown.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first,
+-- then look). The first draws choose the structure, the rest only dress it:
+--   1. the water: a channel cut across the heath, a basin hollowed in its middle,
+--      three to five separate pools in a mire, or a flood filling the whole hollow;
+--   2. the crossing: a straight causeway, a dogleg turning on a platform, two ways
+--      across (a fork), or a broken span crossed by stepping stones;
+--   3. the surface: stone flags, log sleepers, or both in stretches;
+--   4. the levels: the causeway's crown and the bog's depth, and the width of the
+--      wet shore;
+--   5. then the size, the way the road runs, and the dressing: the posts, the gate
+--      and the marsh-lights.
+-- Everything stands on the moor's own kit and three new sculpts of its stone and
+-- timber; the marsh-light is a new set piece in the barrows' grave-green.
+local DistanceField = require("../DistanceField")
+local FeatureDress = require("../FeatureDress")
+local Grid = require("../Grid")
+local MapFeature = require("../MapFeature")
+local Noise = require("../Noise")
+
+type Point = { x: number, z: number }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local function pick(rng: Random, list: { string }): string
+	return list[math.min(#list, math.floor(rng:NextNumber() * #list) + 1)]
+end
+
+local function clamp(v: number, lo: number, hi: number): number
+	return math.max(lo, math.min(hi, v))
+end
+
+-- Distance in cells from (px, pz) to the segment a-b.
+local function segDistance(px: number, pz: number, ax: number, az: number, bx: number, bz: number): number
+	local vx, vz = bx - ax, bz - az
+	local length2 = vx * vx + vz * vz
+	local t = if length2 > 1e-9 then clamp(((px - ax) * vx + (pz - az) * vz) / length2, 0, 1) else 0
+	local dx, dz = px - (ax + vx * t), pz - (az + vz * t)
+	return math.sqrt(dx * dx + dz * dz)
+end
+
+-- The cells a straight line crosses, 4-connected: a diagonal step is bridged with
+-- one of the two cells beside it, so a path one cell wide never breaks.
+local function lineCells(rng: Random, ax: number, az: number, bx: number, bz: number): { { number } }
+	local out: { { number } } = {}
+	local seen: { [string]: boolean } = {}
+	local function add(x: number, z: number)
+		local key = `{x},{z}`
+		if not seen[key] then
+			seen[key] = true
+			table.insert(out, { x, z })
+		end
+	end
+	local steps = math.max(1, math.ceil(math.max(math.abs(bx - ax), math.abs(bz - az)) * 2))
+	local prev: { number }? = nil
+	for s = 0, steps do
+		local t = s / steps
+		local x = math.floor(ax + (bx - ax) * t + 0.5)
+		local z = math.floor(az + (bz - az) * t + 0.5)
+		if prev and prev[1] ~= x and prev[2] ~= z then
+			if rng:NextNumber() < 0.5 then
+				add(prev[1], z)
+			else
+				add(x, prev[2])
+			end
+		end
+		add(x, z)
+		prev = { x, z }
+	end
+	return out
+end
+
+local WATERS = { "channel", "basin", "pools", "flood" }
+local CROSSINGS = { "straight", "dogleg", "fork", "broken" }
+local SURFACES = { "flags", "logs", "both" }
+local GATES = { "standing", "drowned", "gone" }
+
+-- The moor's own heath and trodden earth, and the free materials it leaves (Moor.luau
+-- colours Grass, Ground, Mud, Basalt and Slate itself): the bank is the heath's own
+-- Grass and colour, so the feature sits in the moor rather than beside it; Concrete,
+-- Rock, Cobblestone, Asphalt and Limestone are untouched by the tileset. One colour
+-- per material, as Roblox colours a material once for the whole place.
+local BANK = { material = "Grass", color = { 68, 62, 66 } }
+local MIRE = { material = "Concrete", color = { 42, 40, 36 } }
+local POOL = { material = "Rock", color = { 24, 28, 30 } }
+local FLAG = { material = "Cobblestone", color = { 88, 88, 90 } }
+local LOG = { material = "Asphalt", color = { 64, 56, 48 } }
+local LANDING = { material = "Limestone", color = { 88, 86, 82 } }
+-- The marsh-light is a light, not a surface: pale green under the moon (B3, B7).
+local MARSH = { 150, 210, 175 }
+
+local feature: MapFeature.Feature = {
+	name = "MoorDrownedCauseway",
+	about = "A drowned causeway: a raised way of flagstones and log sleepers across black bog pools, with sunken posts, a half-sunk toll gate and marsh-light over the water.",
+	tileset = "moor",
+	scale = "medium",
+	role = "crossing",
+	mood = { "drowned", "half-sunk", "crossing", "marsh-light" },
+	cells = {
+		bank = {
+			ground = BANK,
+			clear = true,
+			props = {
+				{ sculpt = "moor_heather", every = 12, scale = { 0.55, 0.8 } },
+				{ sculpt = "moor_boulder", every = 40, scale = { 0.5, 0.8 }, sink = 0.5 },
+			},
+		},
+		-- The wet peat at the water's edge: bents growing out of it, no heather.
+		mire = {
+			ground = MIRE,
+			clear = true,
+			props = {
+				{ sculpt = "barrows_bents", every = 14, scale = { 0.55, 0.85 }, sink = 0.25 },
+				{ sculpt = "moor_boulder", every = 40, scale = { 0.4, 0.7 }, sink = 0.6 },
+			},
+		},
+		-- The pool's black bed under its water sheet; a few marsh-lights hang over it.
+		pool = {
+			ground = POOL,
+			clear = true,
+			glow = { color = MARSH, range = 12, brightness = 0.7, every = 55, height = 0.8 },
+		},
+		flag = {
+			ground = FLAG,
+			lift = 0.2,
+			clear = true,
+			props = { { sculpt = "moor_causeway_flag", every = 4.5, scale = { 0.65, 1 }, sink = 0.06 } },
+		},
+		log = {
+			ground = LOG,
+			lift = 0.2,
+			clear = true,
+			props = { { sculpt = "moor_causeway_sleeper", every = 3.5, scale = { 0.7, 1.05 }, sink = 0.05 } },
+		},
+		step = {
+			ground = LANDING,
+			lift = 0.25,
+			clear = true,
+		},
+		landing = {
+			ground = LANDING,
+			lift = 0.3,
+			clear = true,
+			props = { { sculpt = "moor_causeway_flag", every = 5, scale = { 0.7, 1.05 }, sink = 0.05 } },
+		},
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-3: the structure, from the first draws.
+		local water = pick(rng, WATERS)
+		local crossing = pick(rng, CROSSINGS)
+		local surface = pick(rng, SURFACES)
+		local gate = pick(rng, GATES)
+		-- 4: the levels and the size.
+		local w, d = whole(rng, 27, 32), whole(rng, 27, 32)
+		local margin = 2
+		local bogLevel = -between(rng, 2.4, 3.8)
+		local shoreLevel = -between(rng, 0.4, 0.9)
+		local crown = between(rng, 1.8, 2.7)
+		local mireWidth = whole(rng, 1, 2)
+		local half = between(rng, 1.05, 1.6)
+		local g = Grid.new(w, d, Grid.FLOOR)
+		local n = w * d
+		local function at(x: number, z: number): number
+			return Grid.index(g, x, z)
+		end
+		local x0, x1 = margin + 1, w - margin
+		local z0, z1 = margin + 1, d - margin
+		local function interior(x: number, z: number): boolean
+			return x >= x0 and x <= x1 and z >= z0 and z <= z1
+		end
+		local field = Noise.field(rng)
+		local settings = { octaves = 3, frequency = 0.15, lacunarity = 2.05, gain = 0.55 }
+		local function rough(x: number, z: number): number
+			return Noise.fractal(field, x, z, settings)
+		end
+		local wet = table.create(n, false)
+		local channelAngle: number? = nil
+
+		-- 1: the water.
+		if water == "channel" then
+			channelAngle = rng:NextNumber() * math.pi
+			local ca, sa = math.cos(channelAngle), math.sin(channelAngle)
+			local cx, cz = (w + 1) / 2 + between(rng, -3, 3), (d + 1) / 2 + between(rng, -3, 3)
+			local halfW = between(rng, 2.8, 6.2)
+			local bend = between(rng, 0.9, 3.6)
+			local bendRate = between(rng, 0.16, 0.34)
+			for z = 1, d do
+				for x = 1, w do
+					if interior(x, z) then
+						local dx, dz = x - cx, z - cz
+						local along = dx * ca + dz * sa
+						local perp = -dx * sa + dz * ca
+						local width = halfW * (1 + 0.22 * rough(x * 0.8, z * 0.8))
+						local wobble = bend * math.sin(along * bendRate) + 1.3 * rough(x * 0.5 + 17, z * 0.5 - 9)
+						if math.abs(perp - wobble) < width then
+							wet[at(x, z)] = true
+						end
+					end
+				end
+			end
+		elseif water == "basin" then
+			local cx, cz = (w + 1) / 2 + between(rng, -1.5, 1.5), (d + 1) / 2 + between(rng, -1.5, 1.5)
+			local reach = between(rng, 0.28, 0.46)
+			-- Kept inside the shore: a basin that ran to the footprint's inset edge was
+			-- cut to a rectangle there, and its wet rim read as a built kerb.
+			local rx = math.min((x1 - x0) / 2 - 3.5, reach * w)
+			local rz = math.min((z1 - z0) / 2 - 3.5, reach * d)
+			local turn = rng:NextNumber() * math.pi
+			local ca, sa = math.cos(turn), math.sin(turn)
+			for z = 1, d do
+				for x = 1, w do
+					if interior(x, z) then
+						local dx, dz = x - cx, z - cz
+						local lx, lz = dx * ca + dz * sa, -dx * sa + dz * ca
+						local k = (lx / rx) ^ 2 + (lz / rz) ^ 2
+						local edge = (1 + 0.24 * rough(x, z)) ^ 2
+						if k < edge then
+							wet[at(x, z)] = true
+						end
+					end
+				end
+			end
+		elseif water == "pools" then
+			local count = whole(rng, 3, 5)
+			local placed: { { x: number, z: number, r: number } } = {}
+			for _ = 1, count do
+				local r = between(rng, 2, 3.8)
+				local px, pz = (w + 1) / 2, (d + 1) / 2
+				for _ = 1, 14 do
+					r = between(rng, 2, 3.8)
+					-- Its edge stayed inside the shore, so the pool is not cut at it.
+					px = between(rng, x0 + r * 1.35 + 0.5, x1 - r * 1.35 - 0.5)
+					pz = between(rng, z0 + r * 1.35 + 0.5, z1 - r * 1.35 - 0.5)
+					local ok = true
+					for _, p in placed do
+						if math.sqrt((px - p.x) ^ 2 + (pz - p.z) ^ 2) < r + p.r + 1.8 then
+							ok = false
+							break
+						end
+					end
+					if ok then
+						break
+					end
+				end
+				table.insert(placed, { x = px, z = pz, r = r })
+				for z = math.floor(pz - r * 1.6), math.ceil(pz + r * 1.6) do
+					for x = math.floor(px - r * 1.6), math.ceil(px + r * 1.6) do
+						if interior(x, z) then
+							local dx, dz = x - px, z - pz
+							local rr = r * (1 + 0.3 * rough(x, z))
+							if math.sqrt(dx * dx + dz * dz) < rr then
+								wet[at(x, z)] = true
+							end
+						end
+					end
+				end
+			end
+		else
+			-- flood: a broad lake filling the hollow, its corners still heath. Its
+			-- rounded edge stays inside the shore, so it never ends on a square cut.
+			local cx, cz = (w + 1) / 2 + between(rng, -1.5, 1.5), (d + 1) / 2 + between(rng, -1.5, 1.5)
+			local rx = ((x1 - x0) / 2 - 1.2) * between(rng, 0.82, 0.98)
+			local rz = ((z1 - z0) / 2 - 1.2) * between(rng, 0.82, 0.98)
+			for z = 1, d do
+				for x = 1, w do
+					if interior(x, z) then
+						local dx, dz = (x - cx) / rx, (z - cz) / rz
+						local k = dx * dx * dx * dx + dz * dz * dz * dz
+						if k < 1 + 0.22 * rough(x, z) then
+							wet[at(x, z)] = true
+						end
+					end
+				end
+			end
+		end
+		-- Never a crossing with no water under it: a small pool in the middle if the
+		-- draws left the hollow dry.
+		local wetCount = 0
+		for _, v in wet do
+			if v then
+				wetCount += 1
+			end
+		end
+		if wetCount < 12 then
+			for z = math.floor((d + 1) / 2) - 3, math.floor((d + 1) / 2) + 3 do
+				for x = math.floor((w + 1) / 2) - 3, math.floor((w + 1) / 2) + 3 do
+					if (x - (w + 1) / 2) ^ 2 + (z - (d + 1) / 2) ^ 2 < 9 then
+						wet[at(x, z)] = true
+					end
+				end
+			end
+		end
+
+		-- The pools as regions, largest first: the crossing goes through the biggest,
+		-- and its sheets and marsh-lights follow them.
+		local function regionsOf(cells: { boolean }): { { number } }
+			local grid = Grid.new(w, d, Grid.WALL)
+			for i, v in cells do
+				if v then
+					grid.cells[i] = Grid.FLOOR
+				end
+			end
+			return Grid.regions(grid)
+		end
+		local function centroid(region: { number }): (number, number)
+			local sx, sz = 0, 0
+			for _, i in region do
+				local x, z = Grid.coords(g, i)
+				sx += x
+				sz += z
+			end
+			return sx / #region, sz / #region
+		end
+		local function nearestCell(region: { number }, wantX: number, wantZ: number): { number }
+			local best, bx, bz = math.huge, 1, 1
+			for _, i in region do
+				local x, z = Grid.coords(g, i)
+				local dist = (x - wantX) ^ 2 + (z - wantZ) ^ 2
+				if dist < best then
+					best, bx, bz = dist, x, z
+				end
+			end
+			return { bx, bz }
+		end
+		local ponds = regionsOf(wet)
+		local biggest = ponds[1] or { at(math.floor((w + 1) / 2), math.floor((d + 1) / 2)) }
+		local cx, cz = centroid(biggest)
+		local mx, mz = cx + between(rng, -1.2, 1.2), cz + between(rng, -1.2, 1.2)
+		local function inWater(x: number, z: number): boolean
+			local cxr, czr = math.floor(x + 0.5), math.floor(z + 0.5)
+			return Grid.inBounds(g, cxr, czr) and wet[at(cxr, czr)]
+		end
+
+		-- 2: the line the road takes, chosen to cross as much of the water as it can.
+		local bestAngle, bestScore = 0, -1
+		for _ = 1, 5 do
+			local a = if channelAngle
+				then channelAngle + math.pi / 2 + between(rng, -0.35, 0.35)
+				else rng:NextNumber() * math.pi
+			local score = 0
+			for k = -20, 20 do
+				if inWater(mx + math.cos(a) * k * 0.5, mz + math.sin(a) * k * 0.5) then
+					score += 1
+				end
+			end
+			if score > bestScore then
+				bestScore, bestAngle = score, a
+			end
+		end
+		local angle = bestAngle
+		local ux, uz = math.cos(angle), math.sin(angle)
+		local px, pz = -uz, ux
+
+		-- The point where a ray from (sx, sz) leaves the footprint, on its border.
+		local function border(sx: number, sz: number, dx: number, dz: number): Point
+			local best = math.huge
+			local bx, bz = sx, sz
+			if dx > 1e-6 then
+				local t = (w - sx) / dx
+				if t < best then
+					best, bx, bz = t, w, sz + dz * t
+				end
+			elseif dx < -1e-6 then
+				local t = (1 - sx) / dx
+				if t < best then
+					best, bx, bz = t, 1, sz + dz * t
+				end
+			end
+			if dz > 1e-6 then
+				local t = (d - sz) / dz
+				if t < best then
+					best, bx, bz = t, sx + dx * t, d
+				end
+			elseif dz < -1e-6 then
+				local t = (1 - sz) / dz
+				if t < best then
+					best, bx, bz = t, sx + dx * t, 1
+				end
+			end
+			return { x = clamp(bx, 1, w), z = clamp(bz, 1, d) }
+		end
+
+		local route: { Point } = {}
+		local strips: { { a: Point, b: Point } } = {}
+		local platform: Point? = nil
+		local platformR = 0
+		local secondRoute: { Point }? = nil
+		local gateAngle = angle
+		if crossing == "dogleg" then
+			local bend = between(rng, 0.7, 1.15) * (if rng:NextNumber() < 0.5 then 1 else -1)
+			local a2 = angle + bend
+			local p = { x = mx, z = mz }
+			local in1 = border(p.x, p.z, -math.cos(angle), -math.sin(angle))
+			local out2 = border(p.x, p.z, math.cos(a2), math.sin(a2))
+			route = { in1, p, out2 }
+			strips = { { a = in1, b = p }, { a = p, b = out2 } }
+			platform = p
+			platformR = between(rng, 2.2, 3.0)
+			gateAngle = a2
+		elseif crossing == "fork" then
+			local sep = 2 * half + between(rng, 2.0, 3.2)
+			local c1 = {
+				x = clamp(mx - px * sep / 2, 1.6, w - 0.6),
+				z = clamp(mz - pz * sep / 2, 1.6, d - 0.6),
+			}
+			local c2 = {
+				x = clamp(mx + px * sep / 2, 1.6, w - 0.6),
+				z = clamp(mz + pz * sep / 2, 1.6, d - 0.6),
+			}
+			local a1 = border(c1.x, c1.z, -ux, -uz)
+			local b1 = border(c1.x, c1.z, ux, uz)
+			local a2 = border(c2.x, c2.z, -ux, -uz)
+			local b2 = border(c2.x, c2.z, ux, uz)
+			route = { a1, b1 }
+			secondRoute = { a2, b2 }
+			strips = { { a = a1, b = b1 }, { a = a2, b = b2 } }
+			mx, mz = c1.x, c1.z
+		else
+			local a = border(mx, mz, -ux, -uz)
+			local b = border(mx, mz, ux, uz)
+			route = { a, b }
+			strips = { { a = a, b = b } }
+		end
+
+		local cause = table.create(n, false)
+		local landing = table.create(n, false)
+		local stepping = table.create(n, false)
+		local function layStrip(a: Point, b: Point)
+			local ax0 = math.max(1, math.floor(math.min(a.x, b.x) - half - 1))
+			local ax1 = math.min(w, math.ceil(math.max(a.x, b.x) + half + 1))
+			local az0 = math.max(1, math.floor(math.min(a.z, b.z) - half - 1))
+			local az1 = math.min(d, math.ceil(math.max(a.z, b.z) + half + 1))
+			for z = az0, az1 do
+				for x = ax0, ax1 do
+					if segDistance(x, z, a.x, a.z, b.x, b.z) <= half then
+						cause[at(x, z)] = true
+					end
+				end
+			end
+		end
+		for _, s in strips do
+			layStrip(s.a, s.b)
+		end
+		if platform then
+			local r = platformR
+			for z = math.max(1, math.floor(platform.z - r)), math.min(d, math.ceil(platform.z + r)) do
+				for x = math.max(1, math.floor(platform.x - r)), math.min(w, math.ceil(platform.x + r)) do
+					if (x - platform.x) ^ 2 + (z - platform.z) ^ 2 <= r * r then
+						cause[at(x, z)] = true
+						landing[at(x, z)] = true
+					end
+				end
+			end
+		end
+
+		-- The gate's landing, and the broken span's stepping stones. A broken span
+		-- keeps its gate in the water beside it, so nothing paves over the gap.
+		local gateAt = if platform then platform else { x = mx, z = mz }
+		local gateState = if crossing == "broken" and gate == "standing" then "drowned" else gate
+		if crossing == "broken" then
+			-- The water's run along the line through (mx, mz); the break sits in it.
+			local a, b = route[1], route[#route]
+			local length = math.max(math.sqrt((b.x - a.x) ^ 2 + (b.z - a.z) ^ 2), 1e-6)
+			local alongMid = ((mx - a.x) * (b.x - a.x) + (mz - a.z) * (b.z - a.z)) / length
+			local back = alongMid
+			while back > 0 and inWater(a.x + (b.x - a.x) / length * back, a.z + (b.z - a.z) / length * back) do
+				back -= 0.5
+			end
+			local ahead = alongMid
+			while ahead < length and inWater(a.x + (b.x - a.x) / length * ahead, a.z + (b.z - a.z) / length * ahead) do
+				ahead += 0.5
+			end
+			local run = ahead - back
+			local breakHalf = math.min(2.4, run / 2 - 0.8)
+			if breakHalf >= 1.2 then
+				-- Take the full causeway away over the break, and lay a line of
+				-- stones across it.
+				for z = 1, d do
+					for x = 1, w do
+						local dirx, dirz = (b.x - a.x) / length, (b.z - a.z) / length
+						local along = (x - mx) * dirx + (z - mz) * dirz
+						local perp = math.abs(-(x - mx) * dirz + (z - mz) * dirx)
+						if cause[at(x, z)] and math.abs(along) <= breakHalf and perp <= half + 0.6 then
+							cause[at(x, z)] = false
+						end
+					end
+				end
+				local dirx, dirz = (b.x - a.x) / length, (b.z - a.z) / length
+				local stones = lineCells(
+					rng,
+					mx - dirx * breakHalf,
+					mz - dirz * breakHalf,
+					mx + dirx * breakHalf,
+					mz + dirz * breakHalf
+				)
+				for _, c in stones do
+					stepping[at(c[1], c[2])] = true
+				end
+			end
+		end
+
+		-- The gate: a landing under a standing gate wide enough for its piers.
+		if gateState == "standing" then
+			local r = math.max(platformR, between(rng, 2.1, 2.6))
+			for z = math.max(1, math.floor(gateAt.z - r)), math.min(d, math.ceil(gateAt.z + r)) do
+				for x = math.max(1, math.floor(gateAt.x - r)), math.min(w, math.ceil(gateAt.x + r)) do
+					if (x - gateAt.x) ^ 2 + (z - gateAt.z) ^ 2 <= r * r then
+						cause[at(x, z)] = true
+						landing[at(x, z)] = true
+					end
+				end
+			end
+		end
+
+		-- The shore: wet peat at the water's edge, dry bank beyond.
+		local shoreGrid = Grid.new(w, d, Grid.FLOOR)
+		for i, v in wet do
+			if v then
+				shoreGrid.cells[i] = Grid.WALL
+			end
+		end
+		local shore = DistanceField.fromWalls(shoreGrid).distances
+
+		local walk = table.create(n, true)
+		local heights = table.create(n, 0)
+		local kinds: { [number]: string } = {}
+		for i = 1, n do
+			local x, z = Grid.coords(g, i)
+			if wet[i] then
+				walk[i] = false
+				heights[i] = bogLevel
+				kinds[i] = "pool"
+			else
+				-- The wet rim wanders in and out: a shore at a fixed distance read as
+				-- a kerb drawn round the water. It is mire, not ground to stand on:
+				-- the bog takes a walker to the knee, so only the bank and the
+				-- causeway are walkable and the raised road keeps its high sides.
+				-- The outer two cells stay bank, so a mire tongue can never cut the
+				-- walkable ring in two at the footprint's edge.
+				local outer = x > margin and x < w - margin + 1 and z > margin and z < d - margin + 1
+				local near = outer and shore[i] ~= math.huge and shore[i] <= mireWidth + 0.6 + 0.8 * rough(x, z)
+				walk[i] = not near
+				heights[i] = if near then shoreLevel else 0
+				kinds[i] = if near then "mire" else "bank"
+			end
+		end
+		-- 3: the causeway's surface in stretches.
+		local stretch = between(rng, 2.2, 4.2)
+		local shift = between(rng, 0, 20)
+		local function surfaceAt(x: number, z: number): string
+			if surface == "flags" then
+				return "flag"
+			elseif surface == "logs" then
+				return "log"
+			end
+			local s = x * math.cos(angle) + z * math.sin(angle) + shift
+			return if math.floor(s / stretch) % 2 == 0 then "flag" else "log"
+		end
+		for i = 1, n do
+			if cause[i] then
+				local x, z = Grid.coords(g, i)
+				walk[i] = true
+				heights[i] = crown
+				kinds[i] = if landing[i] then "landing" else surfaceAt(x, z)
+			end
+		end
+		for i = 1, n do
+			if stepping[i] then
+				walk[i] = true
+				heights[i] = crown - 1.4
+				kinds[i] = "step"
+			end
+		end
+		-- A noisy shore can leave a single bank cell marooned in the mire. Bank is
+		-- ground to fight on, but it must join the bank round the hollow: any pocket
+		-- that is not the road's own (the causeway, its landing, the stepping stones)
+		-- is drowned into the mire.
+		local walkGrid = Grid.new(w, d, Grid.WALL)
+		for i, ok in walk do
+			if ok then
+				walkGrid.cells[i] = Grid.FLOOR
+			end
+		end
+		local pockets = Grid.regions(walkGrid)
+		for r = 2, #pockets do
+			local roads = false
+			for _, i in pockets[r] do
+				if cause[i] or stepping[i] then
+					roads = true
+					break
+				end
+			end
+			if not roads then
+				for _, i in pockets[r] do
+					walk[i] = false
+					heights[i] = shoreLevel
+					kinds[i] = "mire"
+				end
+			end
+		end
+		-- The causeway climbs out of the shore: every walkable step is at most a
+		-- stud up, so the road walks it.
+		for _ = 1, w + d do
+			local changed = false
+			for i = 1, n do
+				if walk[i] and (cause[i] or stepping[i]) then
+					local x, z = Grid.coords(g, i)
+					local lowest = heights[i]
+					for _, nb in Grid.NEIGHBOURS do
+						local nx, nz = x + nb[1], z + nb[2]
+						if Grid.inBounds(g, nx, nz) then
+							local j = at(nx, nz)
+							if walk[j] then
+								lowest = math.min(lowest, heights[j] + 1)
+							end
+						end
+					end
+					if lowest < heights[i] - 1e-9 then
+						heights[i] = lowest
+						changed = true
+					end
+				end
+			end
+			if not changed then
+				break
+			end
+		end
+		-- The ground round a feature is 0: its walkable border stays a step away.
+		for i = 1, n do
+			local x, z = Grid.coords(g, i)
+			if walk[i] and (x == 1 or z == 1 or x == w or z == d) then
+				heights[i] = clamp(heights[i], -2, 2)
+			end
+		end
+
+		-- 5: the dressing. The sunken posts along the old way.
+		local marks: { FeatureDress.Landmark } = {}
+		local bothSides = rng:NextNumber() < 0.55
+		local function addPost(x: number, z: number, tall: number)
+			if x < 1 or x > w or z < 1 or z > d then
+				return
+			end
+			table.insert(marks, {
+				sculpt = "moor_drowned_post",
+				x = x,
+				z = z,
+				yaw = rng:NextNumber() * 360,
+				scale = tall,
+				sink = between(rng, 0.1, 0.9),
+			})
+		end
+		local function postRun(a: Point, b: Point, spacing: number)
+			local length = math.sqrt((b.x - a.x) ^ 2 + (b.z - a.z) ^ 2)
+			if length < 2 then
+				return
+			end
+			local dx, dz = (b.x - a.x) / length, (b.z - a.z) / length
+			local nx, nz = -dz, dx
+			local side = if rng:NextNumber() < 0.5 then 1 else -1
+			local t = between(rng, 1.2, 2.6)
+			while t < length - 1 do
+				-- Two in three stand out in the water; now and then one on the deck's
+				-- own edge, a taller stump the road runs past.
+				local onDeck = rng:NextNumber() < 0.3
+				local out = if onDeck then half - between(rng, 0.25, 0.7) else half + between(rng, 0.6, 1.6)
+				local tall = if onDeck then between(rng, 1.05, 1.5) else between(rng, 1.1, 1.7)
+				if bothSides then
+					addPost(a.x + dx * t + nx * out, a.z + dz * t + nz * out, tall)
+					addPost(a.x + dx * t - nx * out, a.z + dz * t - nz * out, tall)
+				else
+					addPost(a.x + dx * t + nx * out * side, a.z + dz * t + nz * out * side, tall)
+				end
+				t += spacing * between(rng, 0.85, 1.2)
+			end
+		end
+		for k = 2, #route do
+			postRun(route[k - 1], route[k], between(rng, 3.4, 5.0))
+		end
+		if secondRoute then
+			postRun(secondRoute[1], secondRoute[2], between(rng, 4.0, 6.0))
+		end
+
+		-- The gate itself, or the tall posts where it stood.
+		if gateState == "standing" then
+			table.insert(marks, {
+				sculpt = "moor_drowned_gate",
+				x = gateAt.x,
+				z = gateAt.z,
+				yaw = 90 - math.deg(gateAngle),
+				scale = between(rng, 0.95, 1.1),
+				sink = 0,
+				solid = true,
+			})
+		elseif gateState == "drowned" then
+			local out = half + between(rng, 1.2, 2.4)
+			table.insert(marks, {
+				sculpt = "moor_drowned_gate",
+				x = gateAt.x + px * out,
+				z = gateAt.z + pz * out,
+				yaw = 90 - math.deg(gateAngle) + between(rng, -25, 25),
+				scale = between(rng, 0.9, 1.05),
+				sink = between(rng, 0.3, 1.0),
+				solid = true,
+			})
+		else
+			addPost(gateAt.x + px * (half + 0.3), gateAt.z + pz * (half + 0.3), 1.4)
+			addPost(gateAt.x - px * (half + 0.3), gateAt.z - pz * (half + 0.3), 1.4)
+		end
+
+		-- The water's own face: one broad sheet per stretch of pool, each a hair above
+		-- the last so overlapping sheets never fight for the same plane.
+		local pondsAfter: { boolean } = table.create(n, false)
+		for i = 1, n do
+			if wet[i] and not walk[i] then
+				pondsAfter[i] = true
+			end
+		end
+		local openWater = regionsOf(pondsAfter)
+		local sheetIndex = 0
+		for r = 1, math.min(#openWater, 5) do
+			local region = openWater[r]
+			if #region >= 6 then
+				local count = clamp(math.floor(#region / 40 + 0.5), 1, 3)
+				local chosen: { { number } } = {}
+				for _ = 1, count do
+					local best, bestSep = nearestCell(region, 0, 0), -1
+					for _ = 1, 8 do
+						local i = region[1 + math.floor(rng:NextNumber() * #region)]
+						local x, z = Grid.coords(g, i)
+						local sep = math.huge
+						for _, c in chosen do
+							sep = math.min(sep, (x - c[1]) ^ 2 + (z - c[2]) ^ 2)
+						end
+						if sep > bestSep then
+							bestSep, best = sep, { x, z }
+						end
+						if sep >= 9 then
+							break
+						end
+					end
+					table.insert(chosen, best)
+				end
+				local scale = clamp(0.32 * math.sqrt(#region / #chosen), 0.9, 1.9)
+				for _, c in chosen do
+					sheetIndex += 1
+					table.insert(marks, {
+						sculpt = "moor_bog_sheet",
+						x = c[1] + between(rng, -0.3, 0.3),
+						z = c[2] + between(rng, -0.3, 0.3),
+						yaw = rng:NextNumber() * 360,
+						scale = scale * between(rng, 0.92, 1.08),
+						sink = -(0.5 + 0.02 * sheetIndex),
+					})
+				end
+			end
+		end
+
+		-- Marsh-light over the biggest pools (effects are drawn by clients).
+		local effects: { FeatureDress.Effect } = {}
+		for r = 1, math.min(#openWater, 4) do
+			local region = openWater[r]
+			if #region >= 12 then
+				local wx, wz = centroid(region)
+				local c = nearestCell(region, wx, wz)
+				table.insert(effects, {
+					recipe = "moor_marsh_light",
+					x = c[1],
+					z = c[2],
+					lift = between(rng, 1.0, 1.8),
+				})
+			end
+		end
+
+		-- The road: in at one border, over the way, out at the other.
+		local road: { Point } = {}
+		if crossing == "broken" then
+			local stones: { { number } } = {}
+			for i = 1, n do
+				if stepping[i] then
+					local x, z = Grid.coords(g, i)
+					table.insert(stones, { x, z })
+				end
+			end
+			table.sort(stones, function(a: { number }, b: { number }): boolean
+				return (a[1] - route[1].x) ^ 2 + (a[2] - route[1].z) ^ 2
+					< (b[1] - route[1].x) ^ 2 + (b[2] - route[1].z) ^ 2
+			end)
+			table.insert(road, route[1])
+			for _, s in stones do
+				table.insert(road, { x = s[1], z = s[2] })
+			end
+			table.insert(road, route[#route])
+		else
+			table.insert(road, route[1])
+			for k = 2, #route do
+				local a, b = route[k - 1], route[k]
+				local steps = math.max(1, math.ceil(math.sqrt((b.x - a.x) ^ 2 + (b.z - a.z) ^ 2) / 2.5))
+				for s = 1, steps do
+					table.insert(road, { x = a.x + (b.x - a.x) * s / steps, z = a.z + (b.z - a.z) * s / steps })
+				end
+			end
+		end
+		-- Every road point on walkable ground; nudge any that rounds to a wall.
+		for _, p in road do
+			for _ = 1, 5 do
+				local cxr, czr = math.floor(p.x + 0.5), math.floor(p.z + 0.5)
+				if Grid.inBounds(g, cxr, czr) and walk[at(cxr, czr)] then
+					break
+				end
+				p.x = p.x + (gateAt.x - p.x) * 0.15
+				p.z = p.z + (gateAt.z - p.z) * 0.15
+			end
+		end
+
+		-- The photographs: a raised three-quarter from over the water, so the causeway
+		-- stands over its own posts and the water shows either side; and an eye-level
+		-- walk down the deck to the gate. Both stand off the gate, well inside the pad,
+		-- so no rim cliff comes between the eye and the feature.
+		local function groundAtPoint(x: number, z: number): number
+			local cxr, czr = math.floor(x + 0.5), math.floor(z + 0.5)
+			if Grid.inBounds(g, cxr, czr) then
+				return heights[at(cxr, czr)]
+			end
+			return 0
+		end
+		local side = if rng:NextNumber() < 0.5 then 1 else -1
