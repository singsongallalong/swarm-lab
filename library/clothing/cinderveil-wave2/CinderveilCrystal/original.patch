+--!strict
+-- The Cinderveil gown's body (zone armour, Aor'lan Mountain): a basalt bodice
+-- cut close and seamed with magma cracks, a wide ash collar and a sulphur clasp
+-- so the top keeps a light value in the dark, a narrow dark belt with a bow tied
+-- behind, and a bell skirt of tall angled panels hung from the thighs — front,
+-- back and outer — each flaring out and forward as it falls to just above the
+-- knee. One bold magma seam runs down the right front panel, the mountain's
+-- crack through the cloth.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local C = {
+	basalt = { 50, 48, 55 },
+	basaltDeep = { 34, 33, 40 },
+	ash = { 106, 102, 96 },
+	magma = { 140, 56, 40 },
+	sulphur = { 134, 112, 52 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice, a close basalt shell, the wide pale collar, and a
+			-- pale seam down the front like a laced bodice.
+			Kit.box("UpperTorso", { 2.06, 1.62, 1.06 }, { 0, 0, 0 }, "Fabric", C.basalt),
+			Kit.box("UpperTorso", { 1.5, 0.16, 1.08 }, { 0, 0.7, 0 }, "Fabric", C.ash),
+			Kit.box("UpperTorso", { 0.04, 0.86, 0.04 }, { 0, -0.34, -0.545 }, "Fabric", C.ash),
+			-- The magma V at the neckline, closed by the sulphur clasp.
+			Kit.box("UpperTorso", { 0.05, 0.44, 0.05 }, { 0.22, 0.42, -0.54 }, "Metal", C.magma, { 0, 0, -28 }),
+			Kit.box("UpperTorso", { 0.05, 0.44, 0.05 }, { -0.22, 0.42, -0.54 }, "Metal", C.magma, { 0, 0, 28 }),
+			Kit.box("UpperTorso", { 0.2, 0.2, 0.07 }, { 0, 0.2, -0.555 }, "Metal", C.sulphur),
+			-- The cracks: two on the front and one down the back.
+			Kit.box("UpperTorso", { 0.05, 0.62, 0.04 }, { 0.36, -0.18, -0.545 }, "Metal", C.magma, { 0, 0, -12 }),
+			Kit.box("UpperTorso", { 0.04, 0.36, 0.04 }, { -0.3, -0.3, -0.545 }, "Metal", C.magma, { 0, 0, 16 }),
+			Kit.box("UpperTorso", { 0.05, 0.5, 0.04 }, { 0.3, -0.16, 0.545 }, "Metal", C.magma, { 0, 0, 10 }),
+			-- The belt at the waist: dark basalt edged pale above and magma
+			-- below, with a pale diamond and a sulphur chip at the front.
+			Kit.box("LowerTorso", { 2.14, 0.36, 1.14 }, { 0, 0.02, 0 }, "Fabric", C.basaltDeep),
+			Kit.box("LowerTorso", { 2.16, 0.06, 1.16 }, { 0, 0.18, 0 }, "Fabric", C.ash),
+			Kit.box("LowerTorso", { 2.16, 0.05, 1.16 }, { 0, -0.14, 0 }, "Metal", C.magma),
+			Kit.box("LowerTorso", { 0.26, 0.26, 0.06 }, { 0, 0.0, -0.585 }, "Fabric", C.ash, { 0, 0, 45 }),
+			Kit.box("LowerTorso", { 0.1, 0.1, 0.07 }, { 0, 0.0, -0.59 }, "Metal", C.sulphur, { 0, 0, 45 }),
+			-- The bow tied behind, pale over the dark belt, one loop a little
+			-- lower than the other.
+			Kit.box("LowerTorso", { 0.2, 0.2, 0.16 }, { 0, 0.02, 0.6 }, "Fabric", C.ash),
+			Kit.box("LowerTorso", { 0.5, 0.28, 0.12 }, { 0.34, 0.03, 0.6 }, "Fabric", C.ash, { 0, 0, 20 }),
+			Kit.box("LowerTorso", { 0.42, 0.24, 0.12 }, { -0.3, 0.05, 0.6 }, "Fabric", C.ash, { 0, 0, -14 }),
+			-- The slim upper sleeves, no wider than the arm and a shade darker
+			-- than the bodice, with a magma ribbon at each elbow.
+			Kit.box("UpperArm", { 1.08, 1.2, 1.08 }, { 0, 0, 0 }, "Fabric", C.basaltDeep),
+			Kit.box("UpperArm", { 1.12, 0.06, 1.12 }, { 0, -0.48, 0 }, "Metal", C.magma),
+		},
+		{
+			-- The skirt's tall panels: front and back flare down and outward,
+			-- the outer panel closes the side. They stop just above the knee,
+			-- where the hem look carries the same panels on down the shin.
+			Kit.box("UpperLeg", { 2.0, 1.23, 0.1 }, { 0.32, 0.045, -0.56 }, "Fabric", C.basalt, { 10, 0, 10 }),
+			Kit.box("UpperLeg", { 2.0, 1.23, 0.1 }, { 0.32, 0.045, 0.56 }, "Fabric", C.basalt, { -10, 0, 10 }),
+			Kit.box("UpperLeg", { 0.1, 1.2, 1.4 }, { 0.88, 0.045, 0 }, "Fabric", C.basalt, { 0, 0, 14 }),
+			-- The one bold magma seam, down the right front panel only.
+			Kit.box("UpperLeg", { 0.13, 1.2, 0.07 }, { 0.3, 0.045, -0.63 }, "Metal", C.magma, { 10, 0, 10 }, "Right"),
+		},
+	}),
+}
+
+return look
