+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The cap under the crown, and the circlet round the brow with its
+		-- pale rim catching the moon.
+		Kit.box("Head", { 1.18, 0.2, 1.18 }, { 0, 0.53, 0 }, "Metal", C.basaltDeep),
+		Kit.box("Head", { 1.28, 0.18, 1.28 }, { 0, 0.38, 0 }, "Metal", C.basalt),
+		Kit.box("Head", { 1.3, 0.05, 1.3 }, { 0, 0.48, 0 }, "Metal", C.ashPale),
+		-- The magma seam set into the circlet's front.
+		Kit.box("Head", { 0.2, 0.1, 0.06 }, { 0, 0.38, -0.65 }, "Metal", C.magma),
+		-- The crown: six black crystal shards, the tallest at the centre, all
+		-- raking back and turning in toward the middle.
+		Kit.box("Head", { 0.2, 0.92, 0.2 }, { 0, 0.95, 0.03 }, "Metal", C.basalt, { 9, 0, 0 }),
+		Kit.box("Head", { 0.16, 0.7, 0.16 }, { 0.29, 0.82, 0.02 }, "Metal", C.basalt, { 8, 0, 14 }),
+		Kit.box("Head", { 0.16, 0.7, 0.16 }, { -0.29, 0.82, 0.02 }, "Metal", C.basalt, { 8, 0, -14 }),
+		Kit.box("Head", { 0.18, 0.66, 0.18 }, { 0, 0.78, 0.44 }, "Metal", C.basalt, { 26, 0, 0 }),
+		Kit.box("Head", { 0.13, 0.48, 0.13 }, { 0.5, 0.66, 0.04 }, "Metal", C.basaltDeep, { 8, 0, 24 }),
+		Kit.box("Head", { 0.13, 0.38, 0.13 }, { -0.5, 0.61, 0.04 }, "Metal", C.basaltDeep, { 8, 0, -24 }),
+		-- The centre shard's pale facet, and the sulphur chip at its tip.
+		Kit.box("Head", { 0.06, 0.78, 0.06 }, { -0.05, 0.95, -0.06 }, "Metal", C.ashPale, { 9, 0, 0 }),
+		Kit.box("Head", { 0.1, 0.14, 0.1 }, { 0.03, 1.36, 0.15 }, "Metal", C.sulphur, { 9, 0, 0 }),
+		-- The veil at the nape, and its pale hem.
+		Kit.box("Head", { 1.0, 0.86, 0.06 }, { 0, 0.02, 0.64 }, "Fabric", C.basalt),
+		Kit.box("Head", { 1.02, 0.06, 0.07 }, { 0, -0.43, 0.64 }, "Fabric", C.ash),
+	},
+}
+
+return look
