+			-- The one bold magma seam, down the right front panel only.
+			Kit.box("LowerLeg", { 0.13, 1.14, 0.07 }, { 0.32, 0.02, -0.755 }, "Metal", C.magma, { 12, 0, 12 }, "Right"),
+			-- The single hem band, pale with a sulphur edge beneath it.
+			Kit.box("LowerLeg", { 2.8, 0.14, 1.74 }, { 0.4, -0.51, 0 }, "Fabric", C.ash),
+			Kit.box("LowerLeg", { 2.82, 0.04, 1.76 }, { 0.4, -0.585, 0 }, "Metal", C.sulphur),
