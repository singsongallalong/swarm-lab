+		Kit.box("UpperTorso", { 1.32, 0.14, 1.1 }, { 0, 0.77, 0 }, "Slate", c.ashPale),
+		Kit.box("UpperTorso", { 0.14, 0.1, 0.06 }, { 0, 0.77, -0.57 }, "Metal", c.sulphur),
+		-- The ash stole down the back, its dark edge and a thin crack.
+		Kit.box("UpperTorso", { 1.46, 1.12, 0.06 }, { 0, 0.02, 0.56 }, "Fabric", c.ash),
+		Kit.box("UpperTorso", { 1.46, 0.09, 0.07 }, { 0, -0.49, 0.56 }, "Slate", c.basaltEdge),
+		Kit.box("UpperTorso", { 0.05, 0.7, 0.03 }, { 0.2, 0.02, 0.607 }, "Fabric", c.ember, { 0, 0, 6 }),
+		-- The thick glowing crack down the stomacher, with its branch.
+		Kit.box("UpperTorso", { 0.09, 1.12, 0.045 }, { 0.06, 0.05, -0.585 }, "Neon", c.magma, { 0, 0, 12 }),
+		Kit.box("UpperTorso", { 0.06, 0.42, 0.04 }, { -0.14, -0.22, -0.589 }, "Neon", c.magma, { 0, 0, -38 }),
+		-- The pale stone belt at the waist, its dark under-edge and buckle.
+		Kit.box("LowerTorso", { 2.08, 0.36, 1.08 }, { 0, 0, 0 }, "Fabric", c.ashPale),
+		Kit.box("LowerTorso", { 2.1, 0.06, 1.1 }, { 0, -0.16, 0 }, "Slate", c.basalt),
+		Kit.box("LowerTorso", { 0.16, 0.14, 0.07 }, { 0, 0.02, -0.565 }, "Metal", c.sulphur),
+		-- The upper sleeve is slim and dark; the pale part is the Sleeves look.
+		Kit.box("UpperArm", { 1.04, 1.18, 1.04 }, { 0, 0, 0 }, "Fabric", c.basalt),
+		Kit.box("UpperArm", { 0.035, 0.9, 0.05 }, { 0.52, 0, 0 }, "Slate", c.ash),
+		Kit.box("UpperArm", { 0.03, 0.45, 0.03 }, { 0.05, 0, -0.535 }, "Fabric", c.ember, { 0, 0, 10 }),
