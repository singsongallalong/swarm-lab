+		Kit.box("UpperTorso", { 2.06, 1.64, 1.06 }, { 0, 0, 0 }, "Fabric", c.basalt),
+		Kit.box("UpperTorso", { 0.9, 0.78, 0.05 }, { 0, 0.3, -0.555 }, "Fabric", c.ash),
+		Kit.box("UpperTorso", { 0.66, 0.66, 0.055 }, { 0, -0.32, -0.557 }, "Fabric", c.ash),
