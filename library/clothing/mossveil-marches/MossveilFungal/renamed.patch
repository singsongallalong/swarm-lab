+--!strict
+-- The Mossveil helm (the fungal ballgown's headpiece): a toadstool bonnet.
+-- A narrow moss circlet holds a round mushroom cap just above the head: a tan
+-- gill disc under a pale bone brim, the cap stepped up in moss rings to a
+-- sickly lichen tip. Dark moss veils fall down the sides of the head and a
+-- long moss veil with a black lining drops down the back, one pale torn
+-- corner trailing. Height and softness at the head, never width at the ears.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+type ArmourPart = ArmourLookTypes.ArmourPart
+type BodyPart = ArmourLookTypes.BodyPart
+
+-- A round piece: a cylinder standing on its own Y, size { diameter, length, diameter }.
+local function round(
+	on: BodyPart,
+	size: { number },
+	at: { number },
+	material: string,
+	color: { number },
+	turn: { number }?
+): ArmourPart
+	return { on = on, shape = "Cylinder", size = size, at = at, turn = turn, material = material, color = color }
+end
+
+local colors = {
