+	bone = { 166, 156, 126 },
+	boneShade = { 118, 110, 88 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "MossveilFungalHem",
+	slot = "Boots",
+	parts = {
+		-- The top tier, just under the knee, carrying on from the Dress.
+		round("LowerLeg", { 2.3, 0.5, 2.3 }, { 0.15, 0.52, 0 }, "Fabric", colors.moss),
+		round("LowerLeg", { 2.4, 0.08, 2.4 }, { 0.15, 0.28, 0 }, "Fabric", colors.bone),
