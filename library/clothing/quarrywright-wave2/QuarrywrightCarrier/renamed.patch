@@ -0,0 +1,36 @@
+--!strict
+-- The quarrywright's dust mask (the Quarrywright set's helm): a stone-pale
+-- linen wrap over the skull and jaw, one thick cold-slate goggle band with two
+-- pale lenses and a rusted bridge, a slate dust mask with a rusted filter, and
+-- a torn cloth tab at the back. Pale as a chip of the quarry, so the head
+-- reads from the high camera without becoming a banded box.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local dust = { 156, 160, 162 }
+local quarry = { 108, 114, 116 }
+local slate = { 54, 60, 72 }
+local lens = { 176, 188, 190 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightCarrierDustMask",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		Kit.box("Head", { 1.32, 0.62, 1.32 }, { 0, 0.33, 0 }, "Fabric", dust),
+		-- One thick slate goggle band: the helm's single dark stripe.
+		Kit.box("Head", { 1.4, 0.2, 1.4 }, { 0, -0.12, 0 }, "Fabric", slate),
+		Kit.box("Head", { 0.28, 0.2, 0.08 }, { 0.28, -0.12, -0.72 }, "SmoothPlastic", lens),
+		Kit.box("Head", { 0.28, 0.2, 0.08 }, { -0.28, -0.12, -0.72 }, "SmoothPlastic", lens),
+		Kit.box("Head", { 0.26, 0.06, 0.06 }, { 0, -0.12, -0.73 }, "Metal", c.rust),
+		Kit.box("Head", { 1.3, 0.36, 0.56 }, { 0, -0.36, -0.4 }, "Fabric", slate),
+		Kit.box("Head", { 0.3, 0.2, 0.12 }, { 0, -0.42, -0.7 }, "Metal", c.rust),
+		-- A dust cloth wrapped right round the jaw and neck, so no face shows.
+		Kit.box("Head", { 1.32, 0.64, 1.28 }, { 0, -0.3, 0.02 }, "Fabric", dust),
+		Kit.box("Head", { 0.22, 0.3, 0.1 }, { 0.46, -0.58, 0.68 }, "Fabric", quarry, { 0, 0, 10 }),
+	},
+}
+
+return look
