@@ -0,0 +1,62 @@
+--!strict
+-- The quarrywright's yoke (the Quarrywright set's chest): a stone-pale padded
+-- jacket under one broad carrying yoke, a dark timber beam laid over both
+-- shoulders and standing well out past them, bound with rusted iron hoops and
+-- hanging rope ends. One thick shoulder pad on each arm, a single wide rope
+-- strap across the chest, a stone-grey pad down the back, and a rope belt with
+-- a chalk pouch and a mallet hung on the right thigh. The beam is the outline.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local dust = { 156, 160, 162 }
+local dustDark = { 128, 133, 135 }
+local quarry = { 108, 114, 116 }
+local slate = { 54, 60, 72 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightCarrierYoke",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The split dust apron, hung from the thighs so it swings with them.
+		Kit.flaps(0.62, "Fabric", quarry),
+		{
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", dust),
+			-- One thick cold slate collar, no thin bands round it.
+			Kit.box("UpperTorso", { 1.3, 0.3, 1.3 }, { 0, 0.84, 0 }, "Fabric", slate),
+			-- The carrying yoke: a timber beam past both shoulders, iron-shod.
+			Kit.box("UpperTorso", { 5.8, 0.3, 0.5 }, { 0, 0.76, 0.1 }, "Wood", c.timberDark),
+			Kit.box("UpperTorso", { 0.14, 0.36, 0.54 }, { 2.5, 0.76, 0.1 }, "Metal", c.rust),
+			Kit.box("UpperTorso", { 0.14, 0.36, 0.54 }, { -2.5, 0.76, 0.1 }, "Metal", c.rust),
+			-- Rope ends hanging from the yoke tips.
+			Kit.box("UpperTorso", { 0.1, 0.56, 0.12 }, { 2.72, 0.44, 0.1 }, "Fabric", c.rope, { 0, 0, 4 }),
+			Kit.box("UpperTorso", { 0.1, 0.56, 0.12 }, { -2.72, 0.44, 0.1 }, "Fabric", c.rope, { 0, 0, -4 }),
+			-- One thick rope strap over the shoulder, wide enough for the high camera.
+			Kit.box("UpperTorso", { 0.28, 1.9, 0.1 }, { 0, 0, -0.58 }, "Fabric", c.rope, { 0, 0, 30 }),
+			-- The dust pad down the back.
+			Kit.box("UpperTorso", { 1.6, 1.1, 0.14 }, { 0, 0.14, 0.62 }, "Fabric", quarry),
+			-- One thick pad on each shoulder, covering the arm top cleanly.
+			Kit.box("UpperArm", { 1.36, 0.54, 1.36 }, { 0, 0.35, 0 }, "Fabric", dustDark),
+			Kit.box("UpperArm", { 1.06, 0.9, 1.06 }, { 0, -0.2, 0 }, "Fabric", dust),
+			-- The waist, rope belt, rusted buckle and chalk pouch.
+			Kit.box("LowerTorso", { 2.12, 0.44, 1.12 }, { 0, 0, 0 }, "Fabric", quarry),
+			Kit.box("LowerTorso", { 2.18, 0.2, 1.18 }, { 0, 0.05, 0 }, "Fabric", c.rope, { 0, 0, -3 }),
+			Kit.box("LowerTorso", { 0.3, 0.3, 0.14 }, { 0.2, 0.05, -0.62 }, "Metal", c.rust),
+			Kit.box("LowerTorso", { 0.42, 0.44, 0.26 }, { -0.66, -0.06, -0.5 }, "Leather", c.leatherDark),
+			-- A mallet hung on the right thigh, big enough to read from above.
+			Kit.box(
+				"UpperLeg",
+				{ 0.12, 0.72, 0.12 },
+				{ 0.14, 0.24, -0.64 },
+				"Wood",
+				c.timberDark,
+				{ 0, 0, -6 },
+				"Right"
+			),
+			Kit.box("UpperLeg", { 0.4, 0.22, 0.22 }, { 0.14, -0.19, -0.68 }, "Metal", c.iron, { 0, 0, -6 }, "Right"),
+		},
+	}),
+}
+
+return look
