+--!strict
+-- The basaltplate chest (zone armour, the BasaltplateCairnChest base): the mountain
+-- worn as a cuirass. Three raised basalt column slabs down the front with magma
+-- in the seams between them, a broad back slab with a seam across it and a red
+-- seam at the waist, a black iron belt buckled off centre, and black slab
+-- pauldrons with magma between plate and sleeve. The right shoulder carries one
+-- plate more than the left.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette, local to the four Basaltplate looks.
+local basalt = { 46, 48, 55 }
+local basaltDark = { 28, 29, 34 }
+local basaltSlab = { 62, 65, 74 }
+local magma = { 122, 45, 33 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateCairnChest",
+	slot = "Chest",
+	parts = {
+		-- The block of the mountain.
+		Kit.box("UpperTorso", { 2.12, 1.7, 1.12 }, { 0, 0, 0 }, "Basalt", basalt),
+		Kit.box("LowerTorso", { 2.12, 0.46, 1.12 }, { 0, 0, 0 }, "Basalt", basaltDark),
+		-- Three raised column slabs down the front, the middle one proud.
+		Kit.box("UpperTorso", { 0.6, 1.42, 0.1 }, { -0.72, 0.02, -0.61 }, "Basalt", basaltSlab),
+		Kit.box("UpperTorso", { 0.64, 1.46, 0.12 }, { 0.02, 0, -0.62 }, "Basalt", basaltSlab),
+		Kit.box("UpperTorso", { 0.58, 1.38, 0.1 }, { 0.74, 0.04, -0.61 }, "Basalt", basaltSlab),
+		-- Magma in the two seams between them.
+		Kit.box("UpperTorso", { 0.12, 1.32, 0.12 }, { -0.36, 0.02, -0.6 }, "SmoothPlastic", magma),
+		Kit.box("UpperTorso", { 0.12, 1.24, 0.12 }, { 0.4, 0.06, -0.6 }, "SmoothPlastic", magma),
+		-- The back: one broad slab and a seam low across it.
+		Kit.box("UpperTorso", { 1.86, 1.32, 0.12 }, { 0, 0.04, 0.61 }, "Basalt", basaltSlab),
+		Kit.box("UpperTorso", { 1.6, 0.09, 0.13 }, { 0, -0.48, 0.615 }, "SmoothPlastic", magma),
+		-- The black iron belt, buckled off centre, with red at the waist below.
+		Kit.box("LowerTorso", { 2.22, 0.22, 1.22 }, { 0, 0.02, 0 }, "Metal", c.ironDark),
+		Kit.box("LowerTorso", { 0.24, 0.2, 0.08 }, { 0.42, 0.02, -0.64 }, "Metal", c.ironWorn),
+		Kit.box("LowerTorso", { 2.16, 0.07, 1.16 }, { 0, -0.18, 0 }, "SmoothPlastic", magma),
+		-- Black sleeves under the pauldrons.
+		Kit.box("UpperArm", { 1.08, 1.24, 1.08 }, { 0, 0, 0 }, "Basalt", basaltDark),
+		-- Two black slab plates on each shoulder, and one more on the right.
+		Kit.box("UpperArm", { 1.36, 0.22, 1.32 }, { 0.1, 0.56, 0 }, "Basalt", basalt, { 0, 0, -14 }),
+		Kit.box("UpperArm", { 1.24, 0.18, 1.2 }, { 0.08, 0.34, 0 }, "Basalt", basalt, { 0, 0, -8 }),
+		Kit.box("UpperArm", { 1.1, 0.16, 1.08 }, { 0.14, 0.7, 0 }, "Basalt", basalt, { 0, 0, -18 }, "Right"),
+		-- The magma seam between the plate and the sleeve.
+		Kit.box("UpperArm", { 1.14, 0.07, 1.14 }, { 0.02, 0.22, 0 }, "SmoothPlastic", magma),
+		-- The basalt gorget, raised to meet the helm and close the neck.
+		Kit.box("UpperTorso", { 1.34, 0.28, 1.22 }, { 0, 0.88, 0 }, "Basalt", basaltDark),
+		-- Two vents at the sternum, echoing the helm.
+		Kit.box("UpperTorso", { 0.08, 0.26, 0.08 }, { -0.18, 0.58, -0.7 }, "SmoothPlastic", basaltDark),
+		Kit.box("UpperTorso", { 0.08, 0.26, 0.08 }, { 0.18, 0.58, -0.7 }, "SmoothPlastic", basaltDark),
+	},
+}
+
+return look
