+--!strict
+-- The basaltplate helm (zone armour, the BasaltplateCairnHelm base): a helm stacked
+-- from offset basalt slabs, like a cairn of the mountain's own columns. Magma
+-- shows in the seams between the slabs, and the sealed visor is cut by three
+-- breathing vents, the centre one still hot. The top slab leans off to the
+-- right, so the outline breaks the sky at the high camera instead of reading
+-- as a plain box.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's palette, local to the four Basaltplate looks: basalt black with a
+-- blue cast, a darker recess, a slightly lifted slab face, and the magma in
+-- the seams. Every top plate is basalt black, never iron grey.
+local basalt = { 46, 48, 55 }
+local basaltDark = { 28, 29, 34 }
+local basaltSlab = { 62, 65, 74 }
+local magma = { 122, 45, 33 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateCairnHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The long jaw box that seals the helm to the chin and meets the gorget.
+		Kit.box("Head", { 1.28, 0.54, 1.26 }, { 0, -0.33, 0 }, "Basalt", basaltDark),
+		-- The lower slab, the magma seam, and the mid slab above it.
+		Kit.box("Head", { 1.36, 0.36, 1.32 }, { 0.01, -0.01, 0 }, "Basalt", basalt),
+		Kit.box("Head", { 1.4, 0.08, 1.38 }, { 0.01, 0.19, 0 }, "SmoothPlastic", magma),
+		Kit.box("Head", { 1.32, 0.34, 1.28 }, { -0.02, 0.36, 0.01 }, "Basalt", basalt, { 0, 0, 3 }),
+		-- The second seam and the crown slab.
+		Kit.box("Head", { 1.44, 0.08, 1.42 }, { -0.01, 0.55, 0.01 }, "SmoothPlastic", magma),
+		Kit.box("Head", { 1.38, 0.2, 1.34 }, { 0.02, 0.64, -0.01 }, "Basalt", basalt, { 0, 0, -4 }),
+		-- The cairn stone on top, set off to the right and back.
+		Kit.box("Head", { 0.72, 0.2, 0.76 }, { 0.28, 0.83, 0.06 }, "Basalt", basaltSlab, { 0, 0, 8 }),
+		-- The sealed visor and its three vents, the centre one still hot.
+		Kit.box("Head", { 0.96, 0.58, 0.09 }, { 0, 0.02, -0.665 }, "Basalt", basaltSlab),
+		Kit.box("Head", { 0.1, 0.38, 0.08 }, { -0.24, 0.02, -0.74 }, "SmoothPlastic", basaltDark),
+		Kit.box("Head", { 0.1, 0.38, 0.08 }, { 0, 0.02, -0.74 }, "SmoothPlastic", magma),
+		Kit.box("Head", { 0.1, 0.38, 0.08 }, { 0.24, 0.02, -0.74 }, "SmoothPlastic", basaltDark),
+	},
+}
+
+return look
