+--!strict
+-- The reaver chest (the Reaver set's chest): a sleeveless smoke-cured hide
+-- tunic worn over bare arms, its shoulders under a shaggy ash-pelt mantle
+-- that broadens the outline at the high camera and hangs down the back. One
+-- shoulder carries a scavenged iron plate with a bone spike through it, the
+-- other only fur. Two wide hide belts cinch the waist, a bone plate buckles
+-- them off centre, and bone fangs on a cord and hide tails on the thighs
+-- finish the half-armoured barbarian cut.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local reaver = {
+	hide = { 60, 54, 46 },
+	hideDark = { 40, 34, 28 },
+	hideScuff = { 92, 78, 62 },
+	pelt = { 100, 98, 94 },
+	peltPale = { 126, 124, 118 },
+	bone = { 168, 158, 136 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Hide tails hung from the thighs, so they swing with the legs.
+		Kit.flaps(0.62, "Leather", reaver.hide),
+		{
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Leather", reaver.hide),
+			Kit.box("LowerTorso", { 2.1, 0.46, 1.1 }, { 0, 0, 0 }, "Leather", reaver.hide),
+			-- The pelt mantle: a pale upper ruff and a darker shag below it.
+			Kit.box("UpperTorso", { 2.3, 0.34, 1.26 }, { 0, 0.66, 0.01 }, "Fabric", reaver.peltPale),
+			Kit.box("UpperTorso", { 2.18, 0.26, 1.18 }, { 0, 0.46, 0.02 }, "Fabric", reaver.pelt, { 0, 0, 2 }),
+			-- The mantle's tail hanging down the back, off to the left.
+			Kit.box("UpperTorso", { 1.5, 0.72, 0.24 }, { 0.08, 0.18, 0.6 }, "Fabric", reaver.pelt, { 5, 0, -3 }),
+			-- Pelts over the shoulders; the left is fur only.
+			Kit.box("UpperArm", { 1.18, 0.34, 1.16 }, { 0.02, 0.56, 0 }, "Fabric", reaver.peltPale),
+			Kit.box("UpperArm", { 1.12, 0.22, 1.1 }, { 0.04, 0.36, 0 }, "Fabric", reaver.pelt),
+			-- Hide sleeves under the pelts, so the arms stay hide, not bare.
+			Kit.box("UpperArm", { 1.1, 1.14, 1.1 }, { 0, -0.02, 0 }, "Leather", reaver.hide),
+			-- A dented iron plate strapped over the right pelt, with a bone spike.
+			Kit.box("UpperArm", { 1.26, 0.18, 1.24 }, { 0.05, 0.7, 0 }, "Metal", c.iron, { 0, 0, -10 }, "Right"),
+			Kit.box("UpperArm", { 0.2, 0.6, 0.2 }, { 0.56, 0.9, 0 }, "Marble", reaver.bone, { 0, 0, -26 }, "Right"),
+			-- Two wide belts: a scuffed one across the waist, a dark one slung askew.
+			Kit.box("LowerTorso", { 2.2, 0.38, 1.2 }, { 0, 0.06, 0 }, "Leather", reaver.hideScuff),
+			Kit.box("LowerTorso", { 2.14, 0.14, 1.14 }, { 0, -0.18, 0 }, "Leather", reaver.hideDark, { 0, 0, -3 }),
+			-- A bone plate for a buckle, off centre, and a strap end on the left
+			-- thigh, so it swings with the leg instead of hanging off the waist.
+			Kit.box("LowerTorso", { 0.42, 0.3, 0.1 }, { 0.42, 0.06, -0.63 }, "Marble", reaver.bone),
+			Kit.box(
+				"UpperLeg",
+				{ 0.1, 0.48, 0.12 },
+				{ 0.55, 0.42, -0.32 },
+				"Leather",
+				reaver.hideDark,
+				{ 6, 0, 3 },
+				"Left"
+			),
+			-- A laced seam up the front, and a cord of bone fangs across the chest.
+			Kit.box("UpperTorso", { 0.1, 1.2, 0.05 }, { -0.3, -0.02, -0.56 }, "Leather", reaver.hideDark),
+			Kit.box(
+				"UpperTorso",
+				{ 0.86, 0.06, 0.04 },
+				{ 0.02, 0.3, -0.57 },
+				"Leather",
+				reaver.hideScuff,
+				{ 0, 0, -8 }
+			),
+			Kit.box("UpperTorso", { 0.14, 0.32, 0.1 }, { 0.16, 0.08, -0.59 }, "Marble", reaver.bone, { 6, 0, 4 }),
+			Kit.box("UpperTorso", { 0.12, 0.26, 0.09 }, { 0.42, 0.12, -0.59 }, "Marble", reaver.bone, { -4, 0, -6 }),
+			-- A rubbed-pale hide patch on the back, where the pelt rubs.
+			Kit.box("UpperTorso", { 0.8, 0.5, 0.04 }, { -0.42, 0.08, 0.56 }, "Leather", reaver.hideScuff, { 0, 0, 5 }),
+		},
+	}),
+}
