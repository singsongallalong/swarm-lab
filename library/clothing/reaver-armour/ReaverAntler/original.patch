+--!strict
+-- The reaver boots (the Reaver set's boots): tall smoke-cured hide boots
+-- bound with a scuffed strap at the ankle, a thick ring of ash fur at the
+-- knee, and a dark hide foot. The right shin is plated with a scavenged iron
+-- strip; the left carries a bone splinter instead, so the pair stays
+-- half-armoured. Wide and furred at the top, so the legs read heavy and
+-- shaggy under the hide tails at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local reaver = {
+	hide = { 60, 54, 46 },
+	hideDark = { 40, 34, 28 },
+	hideScuff = { 92, 78, 62 },
+	peltPale = { 126, 124, 118 },
+	bone = { 168, 158, 136 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverBoots",
+	slot = "Boots",
+	parts = {
+		Kit.box("LowerLeg", { 1.1, 0.96, 1.1 }, { 0, -0.08, 0 }, "Leather", reaver.hide),
+		-- The fur ring at the knee, and the scuffed strap low on the shin.
+		{
+			on = "LowerLeg",
+			shape = "Cylinder",
+			size = { 1.32, 0.32, 1.32 },
+			at = { 0, 0.42, 0 },
+			material = "Fabric",
+			color = reaver.peltPale,
+		},
+		Kit.box("LowerLeg", { 1.14, 0.12, 1.14 }, { 0, -0.3, 0 }, "Leather", reaver.hideScuff),
+		-- Iron on the right shin, bone on the left.
+		Kit.box("LowerLeg", { 0.66, 0.56, 0.09 }, { 0, -0.02, -0.58 }, "Metal", c.ironWorn, nil, "Right"),
+		Kit.box("LowerLeg", { 0.16, 0.46, 0.14 }, { -0.15, 0, -0.6 }, "Marble", reaver.bone, { 0, 0, 10 }, "Left"),
+		-- A dark hide foot, wrapped again at the ankle.
+		Kit.box("Foot", { 1.08, 0.36, 1.18 }, { 0, 0.02, -0.04 }, "Leather", reaver.hideDark),
+		Kit.box("Foot", { 1.12, 0.12, 1.16 }, { 0, 0.16, 0.02 }, "Leather", reaver.hideScuff),
+	},
+}
+
+return look
