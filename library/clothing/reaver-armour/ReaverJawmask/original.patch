@@ -0,0 +1,33 @@
+--!strict
+-- The Reaver's boots (the Reaver armour set): shins and feet bound in hide and
+-- rawhide, an ash band at each ankle and an ash stripe up the outside of each
+-- shin, with a bone splint strapped to the right shin only. Bound and bare
+-- rather than cased, so the set stays light at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The Reaver's own palette: a hide darker and greyer than the leather family
+-- and the ash war paint that carries the set's read.
+local hide = { 64, 56, 46 }
+local ash = { 156, 150, 136 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverBoots",
+	slot = "Boots",
+	parts = {
+		-- Hide bound round the shin, tied at the knee.
+		Kit.box("LowerLeg", { 1.1, 0.94, 1.1 }, { 0, -0.12, 0 }, "Leather", hide),
+		Kit.box("LowerLeg", { 1.16, 0.16, 1.16 }, { 0, 0.26, 0 }, "Leather", c.leatherScuff),
+		-- An ash band at the ankle and a stripe up the outside of each shin.
+		Kit.box("LowerLeg", { 1.16, 0.16, 1.16 }, { 0, -0.46, 0 }, "Fabric", ash),
+		Kit.box("LowerLeg", { 0.1, 0.5, 0.18 }, { 0.56, -0.1, 0 }, "Fabric", ash),
+		-- The foot bound across the instep, toes free.
+		Kit.box("Foot", { 1.1, 0.34, 1.2 }, { 0, 0.02, -0.04 }, "Leather", c.leatherDark),
+		-- A bone splint on the right shin only.
+		Kit.box("LowerLeg", { 0.2, 0.56, 0.12 }, { 0, -0.1, -0.6 }, "Marble", c.bone, { -3, 0, 0 }, "Right"),
+	},
+}
+
+return look
diff --git a/src/shared/data/armourLooks/ReaverChest.luau b/src/shared/data/armourLooks/ReaverChest.luau
