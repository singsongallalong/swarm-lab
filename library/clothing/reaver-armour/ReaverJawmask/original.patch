+--!strict
+-- The Reaver's helm (the Reaver armour set): a low smoke-cured hide cap with a
+-- stripe of ash war paint struck over the crown, a band of it across the eyes
+-- and a bone jaw mask over the lower face, framed by hide cheeks and a neck
+-- curtain. Two bone horns off a kill break the head's outline at the high
+-- camera; there is no iron in it at all.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The Reaver's own palette: a hide darker and greyer than the leather family,
+-- the ash war paint that carries the set's read, and bone off a kill.
+local hide = { 64, 56, 46 }
+local ash = { 156, 150, 136 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- A low cap over the crown, cut away at the brow.
+		Kit.box("Head", { 1.34, 0.36, 1.34 }, { 0, 0.44, 0 }, "Leather", hide),
+		-- The ash stripe over the crown, front to back, read from the high camera.
+		Kit.box("Head", { 0.42, 0.1, 1.05 }, { 0, 0.64, 0.03 }, "Fabric", ash),
+		-- The leather brow band.
+		Kit.box("Head", { 1.38, 0.18, 1.38 }, { 0, 0.26, 0 }, "Leather", c.leatherDark),
+		-- The bone jaw mask over the lower face, and the ash stripe over the eyes.
+		Kit.box("Head", { 1.06, 0.52, 0.16 }, { 0, -0.24, -0.62 }, "Marble", c.bone),
+		Kit.box("Head", { 1.12, 0.16, 0.08 }, { 0, 0.12, -0.64 }, "Fabric", ash),
+		-- A rawhide strap under the jaw.
+		Kit.box("Head", { 1, 0.09, 0.12 }, { 0, -0.54, -0.56 }, "Leather", c.leatherScuff),
+		-- A hide curtain down the back of the head, under the cap, and cheek
+		-- flaps that leave only the bone mask and the painted eyes showing.
+		Kit.box("Head", { 1.34, 0.8, 0.16 }, { 0, -0.22, 0.63 }, "Leather", hide),
+		Kit.box("Head", { 0.12, 0.48, 0.6 }, { 0.63, -0.14, -0.02 }, "Leather", hide, { 0, 0, -4 }),
+		Kit.box("Head", { 0.12, 0.48, 0.6 }, { -0.63, -0.14, -0.02 }, "Leather", hide, { 0, 0, 4 }),
+		-- Two horns, bone off a kill, angled out and up.
+		Kit.box("Head", { 0.22, 0.66, 0.22 }, { 0.68, 0.5, 0.02 }, "Marble", c.bone, { 0, 0, -16 }),
+		Kit.box("Head", { 0.22, 0.66, 0.22 }, { -0.68, 0.5, 0.02 }, "Marble", c.bone, { 0, 0, 16 }),
+	},
+}
+
+return look
