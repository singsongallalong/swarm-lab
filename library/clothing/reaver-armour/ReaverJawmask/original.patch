@@ -0,0 +1,63 @@
+--!strict
+-- The Reaver's chest (the Reaver armour set): a smoke-cured hide vest cut
+-- close and left dark, belted with rawhide, one grey wolf-fur pauldron on the
+-- left shoulder, and bold ash war paint: a yoke over the chest top, a band
+-- across chest and back and claw marks raked down the right side. A bone clasp
+-- holds the baldric and a band of ash rings each bare upper arm, so the set
+-- reads bare and painted at the high camera, never plated.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The Reaver's own palette: a hide darker and greyer than the leather family,
+-- the ash war paint that carries the set's read, grey wolf fur and old bone.
+local hide = { 64, 56, 46 }
+local ash = { 156, 150, 136 }
+local fur = { 92, 86, 76 }
+local oldBone = { 138, 128, 108 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Ragged hide tails on the thighs, so they swing with the legs (C81).
+		Kit.flaps(0.72, "Leather", hide),
+		{
+			-- The vest itself, cut close and left dark.
+			Kit.box("UpperTorso", { 2.08, 1.66, 1.08 }, { 0, 0, 0 }, "Leather", hide),
+			Kit.box("LowerTorso", { 2.1, 0.42, 1.1 }, { 0, 0, 0 }, "Leather", c.leatherDark),
+			-- A rawhide belt slung a little off level, its bone buckle off centre.
+			Kit.box("LowerTorso", { 2.16, 0.14, 1.16 }, { 0, 0.06, 0 }, "Leather", c.leatherScuff, { 0, 0, 3 }),
+			Kit.box("LowerTorso", { 0.26, 0.2, 0.1 }, { 0.36, 0.04, -0.62 }, "Marble", oldBone),
+			-- The rawhide baldric, right shoulder to left hip, with a bone clasp.
+			Kit.box("UpperTorso", { 0.26, 2.1, 0.1 }, { 0, 0, -0.58 }, "Leather", c.leatherScuff, { 0, 0, -30 }),
+			Kit.box("UpperTorso", { 0.3, 0.26, 0.14 }, { 0.16, 0.28, -0.63 }, "Marble", c.bone),
+			-- The ash yoke lying over the chest top, so it reads from above.
+			Kit.box("UpperTorso", { 1.9, 0.06, 0.3 }, { 0, 0.86, -0.32 }, "Fabric", ash),
+			-- An ash band across the chest and another across the back.
+			Kit.box("UpperTorso", { 1.7, 0.16, 0.07 }, { 0.02, 0.6, -0.57 }, "Fabric", ash, { 0, 0, -4 }),
+			Kit.box("UpperTorso", { 1.7, 0.16, 0.07 }, { 0.02, 0.6, 0.57 }, "Fabric", ash, { 0, 0, 4 }),
+			-- Ash claw marks raked down the right of the chest.
+			Kit.box("UpperTorso", { 0.18, 0.64, 0.07 }, { 0.52, 0.26, -0.57 }, "Fabric", ash, { 0, 0, 14 }),
+			Kit.box("UpperTorso", { 0.18, 0.64, 0.07 }, { 0.76, 0.18, -0.57 }, "Fabric", ash, { 0, 0, 14 }),
+			Kit.box("UpperTorso", { 0.16, 0.46, 0.07 }, { 0.3, 0.18, -0.57 }, "Fabric", ash, { 0, 0, 14 }),
+			-- Two long strokes across the back below the band.
+			Kit.box("UpperTorso", { 1.2, 0.12, 0.07 }, { 0.16, 0.1, 0.57 }, "Fabric", ash, { 0, 0, -8 }),
+			-- One grey wolf-fur pauldron, left shoulder only, ragged at the edge.
+			Kit.box("UpperArm", { 1.24, 0.34, 1.24 }, { 0, 0.52, 0 }, "Fabric", fur, { 0, 0, 6 }, "Left"),
+			Kit.box("UpperArm", { 1.12, 0.26, 1.12 }, { 0, 0.24, 0 }, "Fabric", fur, { 0, 0, -4 }, "Left"),
+			Kit.box("UpperArm", { 0.3, 0.32, 0.34 }, { 0.58, 0.4, 0 }, "Fabric", fur, { 0, 0, 20 }, "Left"),
+			-- A bone pin holding the pelt at the shoulder, its edge ragged below.
+			Kit.box("UpperArm", { 0.12, 0.34, 0.12 }, { 0.5, 0.56, -0.42 }, "Marble", c.bone, { 0, 0, -14 }, "Left"),
+			Kit.box("UpperArm", { 0.3, 0.28, 0.28 }, { 0.5, 0.04, 0.12 }, "Fabric", fur, { 0, 0, 14 }, "Left"),
+			-- A band of ash paint round each bare upper arm.
+			Kit.box("UpperArm", { 1.08, 0.14, 1.08 }, { 0, 0.02, 0 }, "Fabric", ash),
+			-- Two bone teeth off a kill, hung from the belt at the right hip.
+			Kit.box("LowerTorso", { 0.12, 0.28, 0.12 }, { 0.66, -0.04, -0.58 }, "Marble", c.bone, { 0, 0, 8 }),
+			Kit.box("LowerTorso", { 0.1, 0.2, 0.1 }, { 0.86, 0.0, -0.54 }, "Marble", oldBone, { 0, 0, -6 }),
+		},
+	}),
+}
+
+return look
