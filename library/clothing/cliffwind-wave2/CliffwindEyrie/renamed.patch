+		Kit.box("Head", { 0.28, 0.95, 0.13 }, { -0.22, 0.9, 0.2 }, "Fabric", c.cloud, { 38, 0, 16 }),
+		Kit.box("Head", { 0.28, 1.0, 0.13 }, { 0.23, 0.88, 0.22 }, "Fabric", c.cloud, { 34, 0, -18 }),
+		Kit.box("Head", { 0.2, 0.6, 0.11 }, { -0.34, 0.7, 0.34 }, "Fabric", c.cloud, { 48, 0, 28 }),
+		Kit.box("Head", { 0.2, 0.52, 0.11 }, { 0.32, 0.68, 0.36 }, "Fabric", c.sky, { 52, 0, -36 }),
