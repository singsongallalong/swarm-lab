+		-- The comb the feathers spring from.
+		Kit.box("Head", { 0.6, 0.12, 0.36 }, { 0, 0.68, 0.04 }, "Metal", c.steelDark),
+		-- The crest: a big cloud fan swept back over the crown, the right
+		-- longer and one small sky-blue feather bent aside.
