+		Kit.box("Head", { 0.09, 0.44, 0.38 }, { 0.68, -0.24, -0.3 }, "Metal", c.steel),
+		Kit.box("Head", { 0.09, 0.44, 0.38 }, { -0.68, -0.24, -0.3 }, "Metal", c.steel),
+		-- A dark steel guard over the nape, under the veil.
+		Kit.box("Head", { 1.06, 0.4, 0.3 }, { 0, -0.2, 0.6 }, "Metal", c.steelDark),
