+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CliffwindValkyrieDress",
+	slot = "Chest",
+	parts = {
+		-- The sky-blue gown, and the steel cuirass: a narrow plate running
+		-- down the centre of the breast, keeping the bodice's line slim.
+		Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", c.sky),
+		Kit.box("UpperTorso", { 1.08, 0.8, 0.18 }, { 0, 0.26, -0.54 }, "Metal", c.steel),
+		-- A white stomacher from the collar to the waist, over the cuirass.
+		Kit.box("UpperTorso", { 0.36, 1.28, 0.12 }, { 0, -0.06, -0.58 }, "Fabric", c.cloud),
+		-- The white neckline band across the top of the cuirass.
+		Kit.box("UpperTorso", { 1.56, 0.18, 1.14 }, { 0, 0.66, 0 }, "Fabric", c.cloud),
+		-- The waist: a dark sky-blue band that draws the eye in under the
+		-- white stomacher, and the rock-tan belt low on it, marking the hip
+		-- where the bell of the skirt begins.
+		Kit.box("LowerTorso", { 2.12, 0.44, 1.12 }, { 0, 0, 0 }, "Fabric", c.skyDeep),
+		Kit.box("LowerTorso", { 2.18, 0.16, 1.18 }, { 0, -0.06, 0 }, "Fabric", c.rockTan),
+		Kit.box("LowerTorso", { 0.26, 0.18, 0.1 }, { 0, -0.06, -0.62 }, "Metal", c.steelBright),
+		-- The short white cape: a narrow upper tier and a wider lower one,
+		-- hung below the shoulder line and falling away from the back.
+		Kit.box("UpperTorso", { 1.5, 0.55, 0.07 }, { 0, 0.47, 0.59 }, "Fabric", c.cloud, { -6, 0, 0 }),
+		Kit.box("UpperTorso", { 2.28, 0.95, 0.07 }, { 0, -0.2, 0.7 }, "Fabric", c.cloud, { -10, 0, 0 }),
+		Kit.box("UpperTorso", { 2.28, 0.12, 0.08 }, { 0, -0.63, 0.79 }, "Fabric", c.skyDeep, { -10, 0, 0 }),
+		-- Slim sky-blue sleeves on the upper arms, a shade deeper than the
+		-- bodice so they tuck into its shadow rather than blocking it out.
+		Kit.box("UpperArm", { 1.08, 1.2, 1.08 }, { 0, 0, 0 }, "Fabric", c.skyShade),
+		-- The upper skirt: five gores a leg, hung from the thigh so they swing
+		-- with it. The front gores meet at the centre; the corner and side
+		-- gores carry the width out from the hip, and the back gores stay
+		-- cloud white to carry a pale panel down the back.
+		Kit.box("UpperLeg", { 0.09, 1.3, 1.12 }, { 0, 0.12, -0.77 }, "Fabric", c.sky, { 0, 90, 16 }),
+		Kit.box("UpperLeg", { 0.09, 1.33, 0.78 }, { 0.59, 0.12, -0.59 }, "Fabric", c.sky, { 0, 45, 19 }),
+		Kit.box("UpperLeg", { 0.09, 1.33, 1.06 }, { 0.87, 0.12, 0 }, "Fabric", c.sky, { 0, 0, 20 }),
+		Kit.box("UpperLeg", { 0.09, 1.33, 0.78 }, { 0.59, 0.12, 0.59 }, "Fabric", c.sky, { 0, -45, 19 }),
+		Kit.box("UpperLeg", { 0.09, 1.3, 1.12 }, { 0, 0.12, 0.77 }, "Fabric", c.cloud, { 0, -90, 16 }),
+	},
+}
