+		Kit.box("Head", { 0.56, 1, 0.08 }, { -0.44, 0.62, 0.18 }, "Fabric", CLOUD, { 28, 35, 22 }),
+		Kit.box("Head", { 0.34, 0.5, 0.07 }, { 0.64, 1.06, 0.46 }, "Fabric", SKY, { 40, -35, -34 }),
+		Kit.box("Head", { 0.34, 0.5, 0.07 }, { -0.64, 1.06, 0.46 }, "Fabric", SKY, { 40, 35, 34 }),
