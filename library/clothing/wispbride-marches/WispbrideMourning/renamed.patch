+--!strict
+-- The wispbride's gown: a fitted pale mist-grey bodice under a black lace
+-- bertha collar and laced down the back, pinched by a narrow willow sash at
+-- the natural waist, and a full pale skirt that flares out from just under
+-- that sash and strides with the legs. Long willow strands hang from the
+-- waist over the skirt, longer at the back, and cold wisp blue sits at the
+-- throat and at the strands' tips. Black is only a thin trim, so the figure
+-- reads pale against the fen's black water.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The fen's mourning palette: black lace over pale mist grey, willow
+-- grey-green, and the wisps' cold blue kept to small drops.
+local lace = { 32, 34, 40 }
+local mist = { 150, 155, 163 }
+local mistDeep = { 118, 123, 132 }
+local pearl = { 186, 190, 198 }
+local willow = { 104, 120, 100 }
+local wisp = { 150, 208, 224 }
+
+-- How far the upper skirt runs down the thigh, from just above its top so the
+-- two legs' panels meet into one skirt standing.
+local SKIRT = 1.3
+local SKIRT_TOP = 0.72
+local SKIRT_Y = SKIRT_TOP - SKIRT / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "WispbrideMourningDress",
+	slot = "Chest",
+	parts = {
+		-- The pale bodice, and the lace bertha laid flat across the shoulders:
+		-- a collar that stays inside the shoulder line and only a little above
+		-- it, so the top stays narrow.
+		Kit.box("UpperTorso", { 2.06, 1.62, 1.06 }, { 0, 0, 0 }, "Fabric", mist),
+		Kit.box("UpperTorso", { 2.12, 0.14, 1.16 }, { 0, 0.84, 0 }, "Fabric", mist),
+		Kit.box("UpperTorso", { 2.16, 0.06, 1.2 }, { 0, 0.9, 0 }, "Fabric", lace),
+		-- The wisp brooch pinning the collar at the throat.
+		Kit.box("UpperTorso", { 0.16, 0.2, 0.1 }, { 0, 0.76, -0.58 }, "SmoothPlastic", wisp),
+		-- A pale stomacher laced in black down the front, and black lacing
+		-- down the back, where the high camera sees it.
+		Kit.box("UpperTorso", { 0.9, 1.2, 0.06 }, { 0, -0.02, -0.555 }, "Fabric", pearl),
+		Kit.box("UpperTorso", { 0.46, 1.34, 0.06 }, { 0, -0.01, 0.54 }, "Fabric", lace),
+		Kit.box("UpperTorso", { 0.42, 0.05, 0.05 }, { 0, 0.28, 0.575 }, "Fabric", pearl),
+		Kit.box("UpperTorso", { 0.42, 0.05, 0.05 }, { 0, 0.03, 0.575 }, "Fabric", pearl),
+		Kit.box("UpperTorso", { 0.42, 0.05, 0.05 }, { 0, -0.22, 0.575 }, "Fabric", pearl),
+		Kit.box("UpperTorso", { 0.5, 0.05, 0.05 }, { 0, 0.28, -0.59 }, "Fabric", lace),
+		Kit.box("UpperTorso", { 0.5, 0.05, 0.05 }, { 0, 0.03, -0.59 }, "Fabric", lace),
+		Kit.box("UpperTorso", { 0.5, 0.05, 0.05 }, { 0, -0.22, -0.59 }, "Fabric", lace),
+		-- The waist: a pale ground under a thin black piping and the narrow
+		-- willow sash, knotted off centre, that pinches the figure in.
+		Kit.box("LowerTorso", { 2.06, 0.4, 1.06 }, { 0, 0, 0 }, "Fabric", mist),
+		Kit.box("LowerTorso", { 2.14, 0.04, 1.14 }, { 0, 0.1, 0 }, "Fabric", lace),
+		Kit.box("LowerTorso", { 2.16, 0.18, 1.18 }, { 0, -0.04, 0 }, "Fabric", willow),
+		Kit.box("LowerTorso", { 0.2, 0.18, 0.16 }, { 0.44, -0.04, -0.62 }, "Fabric", willow),
+		-- The upper sleeves stay pale and close to the arm, with black only as
+		-- a thin band at the elbow; all their volume is on the gloves' cuffs.
+		Kit.box("UpperArm", { 1.04, 1.2, 1.04 }, { 0, 0, 0 }, "Fabric", mistDeep),
+		Kit.box("UpperArm", { 1.08, 0.12, 1.08 }, { 0, -0.5, 0 }, "Fabric", lace),
+		-- The upper skirt: wide panels to the front, back and outside of every
+		-- thigh, flaring out from the waist rather than the knee. Long willow
+		-- strands hang from the waist over them, the back ones longer.
+		Kit.box("UpperLeg", { 1.45, SKIRT, 0.09 }, { 0.08, SKIRT_Y, -0.575 }, "Fabric", mist, { 8, 0, 10 }),
+		Kit.box("UpperLeg", { 1.45, SKIRT, 0.09 }, { 0.08, SKIRT_Y, 0.575 }, "Fabric", mist, { -8, 0, 10 }),
+		Kit.box("UpperLeg", { 0.09, SKIRT, 1.15 }, { 0.72, SKIRT_Y, 0 }, "Fabric", mist, { 0, 0, 16 }),
+		Kit.box("UpperLeg", { 1.24, 0.5, 0.09 }, { 0.03, 0.32, 0.62 }, "Fabric", mist, { -8, 0, 4 }),
+		Kit.box("UpperLeg", { 0.14, 1.28, 0.05 }, { 0.32, 0.04, -0.633 }, "Fabric", willow, { 8, 0, 10 }),
+		Kit.box("UpperLeg", { 0.14, 1.42, 0.05 }, { 0.32, -0.03, 0.643 }, "Fabric", willow, { -8, 0, 10 }),
+		Kit.box("UpperLeg", { 0.05, 1.28, 0.14 }, { 0.776, 0.04, 0 }, "Fabric", willow, { 0, 0, 16 }),
+		-- Wisp dew at the strands' ends.
+		Kit.box("UpperLeg", { 0.14, 0.13, 0.13 }, { 0.42, -0.55, -0.71 }, "SmoothPlastic", wisp),
+		Kit.box("UpperLeg", { 0.13, 0.12, 0.12 }, { 0.44, -0.68, 0.74 }, "SmoothPlastic", wisp),
+		-- The sash's ends, hung from the right thigh so they swing with it.
+		Kit.box("UpperLeg", { 0.1, 0.8, 0.06 }, { 0.16, 0.28, -0.6 }, "Fabric", willow, { 6, 0, 3 }, "Right"),
+		Kit.box("UpperLeg", { 0.08, 0.62, 0.05 }, { 0.32, 0.34, -0.6 }, "Fabric", willow, { 6, 0, -5 }, "Right"),
+	},
+}
+
+return look
