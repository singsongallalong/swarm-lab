+		-- The brow band, and the wisp drop at its centre.
+		Kit.box("Head", { 1.3, 0.12, 0.08 }, { 0, 0.44, -0.64 }, "Fabric", mist),
+		Kit.box("Head", { 0.15, 0.17, 0.1 }, { 0, 0.44, -0.68 }, "SmoothPlastic", wisp),
+		-- The short black veil, with the pale under-veil showing beneath and
+		-- around its edge.
+		Kit.box("Head", { 1.2, 1.32, 0.06 }, { 0, -0.14, 0.8 }, "Fabric", lace, { -7, 0, 0 }),
