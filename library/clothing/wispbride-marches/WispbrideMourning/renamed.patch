+	name = "WispbrideMourningSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The light cuff turned down at the elbow, and the pale sleeve.
+		Kit.box("LowerArm", { 1.2, 0.26, 1.2 }, { 0, 0.42, 0 }, "Fabric", mist),
+		Kit.box("LowerArm", { 1.03, 1.06, 1.03 }, { 0, 0, 0 }, "Fabric", mistDeep),
+		-- The willow cord wound round the forearm.
+		Kit.box("LowerArm", { 1.06, 0.07, 1.06 }, { 0, 0.1, 0 }, "Fabric", willow),
+		-- A lace flounce falling from the wrist over the back of the hand.
+		Kit.box("LowerArm", { 0.94, 0.26, 0.05 }, { 0, -0.46, -0.53 }, "Fabric", lace, { 12, 0, 0 }),
+		-- The pale glove, and the wisp bead on its back.
+		Kit.box("Hand", { 1.06, 0.34, 1.06 }, { 0, 0, 0 }, "Fabric", mistDeep),
+		Kit.box("Hand", { 0.13, 0.12, 0.13 }, { 0, 0.03, -0.53 }, "SmoothPlastic", wisp),
+	},
+}
+
+return look
