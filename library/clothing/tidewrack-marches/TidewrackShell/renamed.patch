+--!strict
+-- The tidewrack helm (the Tidewrack set's headpiece): a tarnished brass circlet
+-- under a salt sailcloth headscarf tied at the nape, crowned with a tall comb
+-- of pale scallop shells and a brass finial. The scarf makes the crown read as
+-- a pale cap from the high camera, and the comb gives it height: from above the
+-- set has a headpiece, not a bare head. Nothing goes wide at ear level.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's pale shell, and the worn tones it is fished up in.
+local salt = { 176, 170, 154 }
+local pearl = { 198, 190, 172 }
+local teal = { 68, 112, 104 }
+
+-- The Naga's teardrop at the brow.
+local function drop(size: { number }, at: { number }, color: { number }): ArmourLookTypes.ArmourPart
+	return { on = "Head", shape = "Ball", size = size, at = at, material = "SmoothPlastic", color = color }
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackShellHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The brow circlet, a plain brass band over a finer copper wire.
+		Kit.box("Head", { 1.28, 0.12, 1.28 }, { 0, 0.22, 0 }, "Metal", c.brass),
+		Kit.box("Head", { 1.24, 0.05, 1.24 }, { 0, 0.11, 0 }, "Metal", c.copper),
+		-- The sailcloth scarf over the crown, knotted at the nape with two tails.
+		Kit.box("Head", { 1.28, 0.34, 1.28 }, { 0, 0.45, 0 }, "Fabric", salt),
+		Kit.box("Head", { 0.24, 0.2, 0.18 }, { 0, 0.44, 0.7 }, "Fabric", salt),
+		Kit.box("Head", { 0.28, 0.07, 0.2 }, { 0, 0.44, 0.71 }, "Fabric", teal),
+		Kit.box("Head", { 0.14, 0.72, 0.04 }, { -0.15, 0.04, 0.7 }, "Fabric", salt, { 6, 0, 4 }),
+		Kit.box("Head", { 0.14, 0.72, 0.04 }, { 0.15, 0.04, 0.7 }, "Fabric", salt, { 6, 0, -4 }),
+		-- The shell comb rising from the scarf: a tall fan, a pearl inner plate,
+		-- two side scallops and a brass finial on the crest.
+		Kit.wedge("Head", { 0.52, 0.8, 0.2 }, { 0, 0.78, -0.34 }, "SmoothPlastic", salt, { -8, 0, 0 }),
+		Kit.wedge("Head", { 0.3, 0.56, 0.12 }, { 0, 0.82, -0.38 }, "SmoothPlastic", pearl, { -8, 0, 0 }),
+		Kit.wedge("Head", { 0.34, 0.56, 0.16 }, { -0.38, 0.68, -0.4 }, "SmoothPlastic", salt, { -10, 24, 0 }),
+		Kit.wedge("Head", { 0.34, 0.56, 0.16 }, { 0.38, 0.68, -0.4 }, "SmoothPlastic", salt, { -10, -24, 0 }),
+		Kit.box("Head", { 0.12, 0.1, 0.12 }, { 0, 1.18, -0.29 }, "Metal", c.brass),
+		-- The Naga's teardrop on the circlet.
+		drop({ 0.15, 0.13, 0.06 }, { 0, 0.22, -0.655 }, teal),
+	},
+}
+
+return look
