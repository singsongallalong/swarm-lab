+	name = "TidewrackShellSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The bell: gathered at the elbow, falling to the wrist.
+		Kit.box("LowerArm", { 1.14, 1.2, 1.14 }, { 0, 0, 0 }, "Fabric", salt),
+		Kit.box("LowerArm", { 1.18, 0.08, 1.18 }, { 0, 0.55, 0 }, "Fabric", teal),
+		-- The pearl cuff at the wrist.
+		Kit.box("LowerArm", { 1.22, 0.16, 1.22 }, { 0, -0.52, 0 }, "SmoothPlastic", pearl),
+		-- The driftwood glove, with a brass shell button on its back.
+		Kit.box("Hand", { 1.06, 0.32, 1.06 }, { 0, 0, 0 }, "Leather", drift),
+		Kit.box("Hand", { 0.06, 0.12, 0.12 }, { 0.54, 0.06, 0 }, "Metal", c.brass),
+	},
+}
+
+return look
