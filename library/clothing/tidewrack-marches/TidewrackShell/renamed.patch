@@ -0,0 +1,69 @@
+--!strict
+-- The tidewrack dress (the Tidewrack set's chest): a fitted salt-white bodice
+-- under a scallop-shell breastplate, over a long driftwood corset roped at the
+-- waist, with a pale sailcloth panel across the back, a bustle and a teal bow,
+-- close wet-sand sleeves on the upper arms, and the gown's upper skirt hung
+-- from the thighs. The skirt's tiers lean outward as they fall and their inner
+-- edges meet on the centre line, so standing it reads as one bell from the belt
+-- down; the hem's brass and teal bands carry the detail where it can be seen.
+-- Nothing leaves the shoulder line or rises above it.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's pale shell, and the worn tones it is fished up in.
+local salt = { 176, 170, 154 }
+local pearl = { 198, 190, 172 }
+local sand = { 134, 122, 102 }
+local drift = { 100, 86, 70 }
+local teal = { 68, 112, 104 }
+local tealDark = { 48, 82, 78 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackShellDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The fitted bodice, the two shell plates over the bust, the woven
+			-- underbust band, the teal neckline and the pearl shell collar.
+			Kit.box("UpperTorso", { 2.08, 1.66, 1.08 }, { 0, 0, 0 }, "Fabric", salt),
+			Kit.box("UpperTorso", { 0.76, 0.62, 0.16 }, { -0.42, 0.26, -0.55 }, "SmoothPlastic", pearl, { 0, -6, -8 }),
+			Kit.box("UpperTorso", { 0.76, 0.62, 0.16 }, { 0.42, 0.26, -0.55 }, "SmoothPlastic", pearl, { 0, 6, 8 }),
+			Kit.box("UpperTorso", { 1.94, 0.12, 0.14 }, { 0, -0.15, -0.56 }, "Fabric", sand),
+			Kit.box("UpperTorso", { 1.6, 0.09, 1.12 }, { 0, 0.68, 0 }, "Fabric", teal),
+			Kit.box("UpperTorso", { 1.18, 0.14, 1.18 }, { 0, 0.8, 0 }, "SmoothPlastic", pearl),
+			-- The pale sailcloth panel across the back, so the back says dress
+			-- from the high camera; a teal line under it.
+			Kit.box("UpperTorso", { 1.6, 0.85, 0.06 }, { 0, 0.3, 0.565 }, "Fabric", pearl),
+			Kit.box("UpperTorso", { 1.62, 0.08, 0.07 }, { 0, -0.16, 0.575 }, "Fabric", teal),
+			-- The long corset, roped at the waist with a brass buckle.
+			Kit.box("UpperTorso", { 2.12, 0.56, 1.12 }, { 0, -0.52, 0 }, "Leather", drift),
+			Kit.box("LowerTorso", { 2.12, 0.4, 1.12 }, { 0, 0, 0 }, "Leather", drift),
+			Kit.box("LowerTorso", { 2.16, 0.1, 1.18 }, { 0, 0.06, 0 }, "Fabric", sand),
+			Kit.box("LowerTorso", { 0.18, 0.14, 0.08 }, { 0.3, 0.06, -0.63 }, "Metal", c.brass),
+			-- The bustle, and the teal bow over it.
+			Kit.box("LowerTorso", { 1.2, 0.32, 0.28 }, { 0, 0.02, 0.6 }, "Fabric", salt),
+			Kit.box("LowerTorso", { 0.34, 0.18, 0.1 }, { -0.22, 0.06, 0.78 }, "Fabric", teal, { 0, 0, 24 }),
+			Kit.box("LowerTorso", { 0.34, 0.18, 0.1 }, { 0.22, 0.06, 0.78 }, "Fabric", teal, { 0, 0, -24 }),
+			Kit.box("LowerTorso", { 0.16, 0.14, 0.12 }, { 0, 0.06, 0.79 }, "Fabric", tealDark),
+			-- Close wet-sand sleeves on the upper arm; the bell is the gloves'.
+			Kit.box("UpperArm", { 1.02, 1.2, 1.02 }, { 0, 0, 0 }, "Fabric", sand),
+			-- The skirt's first tier: sailcloth from just above the hip to the
+			-- upper thigh, its inner edge on the centre line.
+			Kit.box("UpperLeg", { 1.0, 0.8, 0.08 }, { 0, 0.35, -0.56 }, "Fabric", salt, { 2, 0, 0 }),
+			Kit.box("UpperLeg", { 1.0, 0.8, 0.08 }, { 0, 0.35, 0.56 }, "Fabric", salt, { -2, 0, 0 }),
+			Kit.box("UpperLeg", { 0.08, 0.8, 1.12 }, { 0.54, 0.35, 0 }, "Fabric", salt, { 0, 0, 3 }),
+			-- Its second tier: a shell band over the lower thigh, leaning out and
+			-- set to the outside so the two thighs' panels still meet at the centre.
+			Kit.box("UpperLeg", { 1.12, 0.51, 0.1 }, { 0.06, -0.225, -0.6 }, "SmoothPlastic", pearl, { 6, 0, 0 }),
+			Kit.box("UpperLeg", { 1.12, 0.51, 0.1 }, { 0.06, -0.225, 0.6 }, "SmoothPlastic", pearl, { -6, 0, 0 }),
+			Kit.box("UpperLeg", { 0.1, 0.51, 1.24 }, { 0.6, -0.225, 0 }, "SmoothPlastic", pearl, { 0, 0, 8 }),
+			-- The sash's ends on the right thigh, where they swing with the leg.
+			Kit.box("UpperLeg", { 0.1, 0.9, 0.05 }, { -0.1, 0.3, -0.67 }, "Fabric", teal, { 4, 0, -3 }, "Right"),
+			Kit.box("UpperLeg", { 0.08, 0.74, 0.04 }, { 0.06, 0.34, -0.68 }, "Fabric", tealDark, { 4, 0, 5 }, "Right"),
+		},
+	}),
+}
+
+return look
