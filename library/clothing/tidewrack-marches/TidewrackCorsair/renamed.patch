+--!strict
+-- The tidewrack gown (zone armour, the TidewrackCorsairDress base): the salvage
+-- bodice and the upper skirt. A wet-sand bodice narrow across the shoulder top
+-- and fuller over the bust, its upper sleeves driftwood so the arms read apart
+-- from the body, over a shadowed driftwood waist. The one teal note is the
+-- sash at the narrowest point; everything else is salt ivory, driftwood and
+-- brass. The salt sailcloth skirt flares from the thighs in two stepped tiers,
+-- the back carried as wide as the front, with a driftwood seam suggesting the
+-- tail split; a rope sash and cord hang off centre at the right hip and a
+-- gathered bustle closes the small of the back.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local colors = table.freeze({
+	salt = { 184, 176, 158 }, -- sun-bleached sailcloth, warm ivory
+	wetSand = { 124, 114, 94 }, -- the bodice, warmer than the teal it replaces
+	driftwood = { 92, 80, 66 },
+	brass = { 148, 124, 76 }, -- tarnished, not polished
+	teal = { 58, 110, 106 }, -- the Naga's scale, kept to the waist sash
+})
+
+local c = colors
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackCorsairDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice: a narrow shoulder cap over a fuller bust, so the widest
+		-- line sits below the shoulders, with the shoulders sloped down from the
+		-- collar to the arms, and a darker gathered waist beneath.
+		Kit.box("UpperTorso", { 2.06, 0.16, 1.04 }, { 0, 0.74, 0 }, "Fabric", c.wetSand),
+		Kit.wedge("UpperTorso", { 1.06, 0.12, 0.62 }, { 0.69, 0.87, 0 }, "Fabric", c.wetSand, { 0, -90, 0 }),
+		Kit.wedge("UpperTorso", { 1.06, 0.12, 0.62 }, { -0.69, 0.87, 0 }, "Fabric", c.wetSand, { 0, 90, 0 }),
+		Kit.box("UpperTorso", { 2.24, 0.72, 1.08 }, { 0, 0.32, 0 }, "Fabric", c.wetSand),
+		Kit.box("UpperTorso", { 2.06, 0.72, 1.06 }, { 0, -0.44, 0 }, "Fabric", c.driftwood),
+		-- The standing collar, just past the head's width, and its brass edge.
+		Kit.box("UpperTorso", { 1.34, 0.18, 1.34 }, { 0, 0.8, 0 }, "Fabric", c.salt),
+		Kit.box("UpperTorso", { 1.4, 0.05, 1.4 }, { 0, 0.895, 0 }, "Metal", c.brass),
+		-- Two pale shell plates sewn over the bust.
+		Kit.box("UpperTorso", { 0.46, 0.3, 0.06 }, { -0.4, 0.44, -0.56 }, "SmoothPlastic", c.salt, { 0, 0, 10 }),
+		Kit.box("UpperTorso", { 0.46, 0.3, 0.06 }, { 0.4, 0.44, -0.56 }, "SmoothPlastic", c.salt, { 0, 0, -10 }),
+		-- The corset lacing at the waist, drawing the eye in.
+		Kit.box("UpperTorso", { 0.52, 0.07, 0.05 }, { 0, -0.36, -0.55 }, "Metal", c.brass, { 0, 0, 12 }),
+		Kit.box("UpperTorso", { 0.52, 0.07, 0.05 }, { 0, -0.56, -0.55 }, "Metal", c.brass, { 0, 0, -12 }),
+		-- The back, laced with pale sailcloth cord.
+		Kit.box("UpperTorso", { 0.12, 0.9, 0.04 }, { -0.2, 0.3, 0.56 }, "Fabric", c.salt, { 0, 0, 14 }),
+		Kit.box("UpperTorso", { 0.12, 0.9, 0.04 }, { 0.2, 0.3, 0.56 }, "Fabric", c.salt, { 0, 0, -14 }),
+		-- The gathered waist, so the body never shows at the hip.
+		Kit.box("LowerTorso", { 2.08, 0.44, 1.04 }, { 0, 0, 0 }, "Fabric", c.driftwood),
+		-- The one sash of Naga teal, at the narrowest point, under a brass clasp.
+		Kit.box("LowerTorso", { 2.16, 0.2, 1.1 }, { 0, 0.04, 0 }, "Fabric", c.teal),
+		Kit.box("LowerTorso", { 0.26, 0.26, 0.08 }, { 0, 0.04, -0.57 }, "Metal", c.brass, { 0, 0, 45 }),
+		-- The gathered bustle at the small of the back.
+		Kit.box("LowerTorso", { 1.5, 0.3, 0.24 }, { 0, -0.02, 0.62 }, "Fabric", c.salt, { 6, 0, 0 }),
+		-- The upper sleeves in driftwood, with a brass band at the elbow.
+		Kit.box("UpperArm", { 1.08, 1.18, 1.08 }, { 0, 0, 0 }, "Fabric", c.driftwood),
+		Kit.box("UpperArm", { 1.12, 0.12, 1.12 }, { 0, -0.46, 0 }, "Metal", c.brass),
+		-- The skirt's upper tier, hung from the thighs and carried round the back.
+		Kit.box("UpperLeg", { 1.28, 0.8, 0.08 }, { 0.1, 0.34, -0.58 }, "Fabric", c.salt, { 2, 0, 3 }),
+		Kit.box("UpperLeg", { 1.28, 0.8, 0.08 }, { 0.1, 0.34, 0.58 }, "Fabric", c.salt, { -2, 0, 3 }),
+		Kit.box("UpperLeg", { 0.08, 0.8, 1.16 }, { 0.64, 0.34, 0 }, "Fabric", c.salt, { 0, 0, 3 }),
+		-- And the lower tier on the thigh, stepped wider again.
+		Kit.box("UpperLeg", { 1.46, 0.58, 0.07 }, { 0.18, -0.28, -0.6 }, "Fabric", c.salt, { 3, 0, 6 }),
+		Kit.box("UpperLeg", { 1.44, 0.58, 0.07 }, { 0.18, -0.28, 0.6 }, "Fabric", c.salt, { -3, 0, 6 }),
+		Kit.box("UpperLeg", { 0.07, 0.58, 1.26 }, { 0.7, -0.28, 0 }, "Fabric", c.salt, { 0, 0, 6 }),
+		-- The tail split, kept as a driftwood seam down the back of the skirt.
+		Kit.box("UpperLeg", { 0.1, 0.76, 0.04 }, { -0.22, 0.34, 0.64 }, "Fabric", c.driftwood, { 0, 0, 4 }),
+		Kit.box("UpperLeg", { 0.1, 0.56, 0.04 }, { -0.15, -0.28, 0.66 }, "Fabric", c.driftwood, { 0, 0, 8 }),
+		-- The rope sash across the front, and the cord hung at its right end.
+		Kit.box("UpperLeg", { 1.5, 0.12, 0.05 }, { 0, 0.3, -0.64 }, "Fabric", c.driftwood, { 0, 0, -16 }),
+		Kit.box("UpperLeg", { 0.1, 0.44, 0.08 }, { 0.66, 0.02, -0.66 }, "Fabric", c.driftwood, { 0, 0, -8 }, "Right"),
+	},
+}
