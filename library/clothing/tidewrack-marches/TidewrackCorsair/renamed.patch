+--!strict
+-- The tidewrack helm (zone armour, the TidewrackCorsairHelm base): a driftwood
+-- circlet bound in tarnished brass, a tall fan of warm salt shell blades swept
+-- up and back from a brass-rimmed comb, a single Naga teal scale at the brow
+-- over a brass drop and a short salt veil down the back of the neck. The fan
+-- is given height so it reads against the head at the high camera; nothing
+-- widens at ear level, so it stays a headpiece and not a helmet.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local colors = table.freeze({
+	salt = { 184, 176, 158 }, -- sun-bleached shell and sailcloth, warm ivory
+	saltShade = { 148, 140, 122 }, -- the veil's folds
+	driftwood = { 92, 80, 66 },
+	brass = { 148, 124, 76 }, -- tarnished, not polished
+	teal = { 58, 110, 106 }, -- the Naga's scale, used sparingly
+})
+
+local c = colors
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackCorsairHelm",
+	slot = "Helm",
+	parts = {
+		-- The circlet, and the brass line beneath it.
+		Kit.box("Head", { 1.3, 0.2, 1.3 }, { 0, 0.46, 0 }, "Wood", c.driftwood),
+		Kit.box("Head", { 1.34, 0.06, 1.34 }, { 0, 0.35, 0 }, "Metal", c.brass),
+		-- The tall fan of shell blades, flat to the front and swept up and back.
+		Kit.box("Head", { 0.34, 0.9, 0.1 }, { 0, 1.05, 0.45 }, "SmoothPlastic", c.salt, { 20, 0, 0 }),
+		Kit.box("Head", { 0.22, 0.7, 0.09 }, { 0.3, 0.94, 0.42 }, "SmoothPlastic", c.salt, { 22, 0, -16 }),
+		Kit.box("Head", { 0.22, 0.7, 0.09 }, { -0.3, 0.94, 0.42 }, "SmoothPlastic", c.salt, { 22, 0, 16 }),
+		-- The driftwood comb that holds them, and the brass rim bound round it.
+		Kit.box("Head", { 0.84, 0.12, 0.18 }, { 0, 0.66, 0.38 }, "Wood", c.driftwood, { 14, 0, 0 }),
+		Kit.box("Head", { 0.88, 0.08, 0.08 }, { 0, 0.72, 0.42 }, "Metal", c.brass, { 14, 0, 0 }),
+		-- The Naga's teal scale at the brow, hung over a brass drop.
+		Kit.box("Head", { 0.3, 0.3, 0.06 }, { 0, 0.24, -0.63 }, "SmoothPlastic", c.teal, { 0, 0, 45 }),
+		Kit.box("Head", { 0.18, 0.18, 0.05 }, { 0, 0.0, -0.62 }, "Metal", c.brass, { 0, 0, 45 }),
+		-- A brass scale sewn over the back of the circlet, so it is not quite even.
+		Kit.box("Head", { 0.22, 0.26, 0.05 }, { 0.4, 0.46, 0.66 }, "Metal", c.brass, { 0, 0, 10 }),
+		-- The veil, in two panes down the back of the neck.
+		Kit.box("Head", { 0.9, 0.46, 0.06 }, { 0, 0.17, 0.62 }, "Fabric", c.saltShade, { 8, 0, 0 }),
+		Kit.box("Head", { 0.7, 0.34, 0.05 }, { 0, -0.15, 0.66 }, "Fabric", c.saltShade, { 12, 0, 0 }),
+	},
+}
+
+return look
