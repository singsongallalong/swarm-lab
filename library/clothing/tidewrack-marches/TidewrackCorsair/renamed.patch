+-- The tidewrack sleeves (zone armour, the TidewrackCorsairSleeves base): the gown's
+-- forearms and hands. A warm ivory sailcloth sleeve that stays close at the
+-- elbow and bells out in two steps to a wide tarnished-brass cuff, a brass band
+-- at the elbow, a dark lace edge at the wrist and near-black wet leather
+-- gloves with a driftwood wrist wrap. The volume is all below the elbow, as the
+-- figure wants.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local colors = table.freeze({
+	salt = { 184, 176, 158 }, -- sun-bleached sailcloth, warm ivory
+	saltShade = { 148, 140, 122 }, -- the lace edge under the cuff
+	driftwood = { 92, 80, 66 },
+	brass = { 148, 124, 76 }, -- tarnished, not polished
+	driftwoodDark = { 58, 50, 40 }, -- the gloves, soaked dark as the shelf
+})
+
+local c = colors
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackCorsairSleeves",
+	slot = "Gloves",
+	parts = {
+		-- A brass band where the sleeve meets the elbow.
+		Kit.box("LowerArm", { 1.08, 0.14, 1.08 }, { 0, 0.46, 0 }, "Metal", c.brass),
+		-- The bell, stepped wider down the forearm.
+		Kit.box("LowerArm", { 1.14, 0.44, 1.14 }, { 0, 0.2, 0 }, "Fabric", c.salt),
+		Kit.box("LowerArm", { 1.34, 0.42, 1.34 }, { 0, -0.22, 0 }, "Fabric", c.salt),
+		-- The brass cuff ring and the dark lace edge below it.
+		Kit.box("LowerArm", { 1.4, 0.08, 1.4 }, { 0, -0.42, 0 }, "Metal", c.brass),
+		Kit.box("LowerArm", { 1.42, 0.07, 1.42 }, { 0, -0.48, 0 }, "Fabric", c.saltShade),
+		-- The glove, with a driftwood wrist wrap.
+		Kit.box("Hand", { 1.08, 0.36, 1.08 }, { 0, 0, 0 }, "Leather", c.driftwoodDark),
+		Kit.box("Hand", { 1.12, 0.1, 1.12 }, { 0, 0.13, 0 }, "Fabric", c.driftwood),
+	},
+}
+
+return look
