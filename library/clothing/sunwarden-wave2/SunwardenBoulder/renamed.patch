@@ -0,0 +1,53 @@
+--!strict
+-- The sunwarden helm (Sunwarden set): the mask of the ancient Grashan
+-- sentinels, carved after the Statue Colossus. A tall bronze bowl stepped to a
+-- flat crown under a sun-gold crest: a wide transverse ridge crossed by a deep
+-- fore-aft fin, so it reads as a crest from the high camera and not a stick.
+-- A blank pale-stone face with no eye slits, a sun disc at the brow, a heavy
+-- gorget, a pale stone nape plate, and a dent scraped bright above one temple.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Old green-bronze, pale ruin stone and sun gold. The bronze is yellower and
+-- darker than the fen's grey-green scale, so the set reads as its own family.
+local bronze = { 86, 92, 62 }
+local bronzeDark = { 56, 60, 42 }
+local bronzeWorn = { 128, 132, 94 } -- scraped verdigris catching the moon
+local stone = { 168, 162, 144 }
+local gold = { 160, 126, 66 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenBoulderHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl, stepped to a flat crown so the crest reads from above.
+		Kit.box("Head", { 1.36, 0.72, 1.36 }, { 0, 0.3, 0 }, "Metal", bronze),
+		Kit.box("Head", { 1.12, 0.24, 1.12 }, { 0, 0.76, 0 }, "Metal", bronzeDark),
+		-- The sun crest: a wide gold transverse ridge crossed by a deep gold
+		-- fin, so the top reads as a fan from the pitch-50 camera.
+		Kit.box("Head", { 1.14, 0.5, 0.34 }, { 0, 1.0, 0 }, "Metal", gold),
+		Kit.box("Head", { 0.28, 1.0, 0.96 }, { 0, 1.12, 0 }, "Metal", gold),
+		-- The blank stone face: no eye slits, as the Colossus has none.
+		Kit.box("Head", { 0.94, 0.7, 0.1 }, { 0, 0.02, -0.7 }, "Marble", stone),
+		Kit.box("Head", { 0.98, 0.16, 0.14 }, { 0, -0.34, -0.68 }, "Metal", bronzeWorn),
+		-- The sun disc at the brow, proud of the face.
+		{
+			on = "Head",
+			shape = "Cylinder",
+			size = { 0.34, 0.12, 0.34 },
+			at = { 0, 0.62, -0.73 },
+			turn = { 90, 0, 0 },
+			material = "Metal",
+			color = gold,
+		},
+		-- A heavy gorget rising to the bowl's rim, so no bare neck shows, and a
+		-- pale stone guard down the nape.
+		Kit.box("Head", { 1.3, 0.6, 1.3 }, { 0, -0.36, 0 }, "Metal", bronzeDark),
+		Kit.box("Head", { 1.34, 0.4, 0.3 }, { 0, -0.5, 0.56 }, "Marble", stone),
+		-- A dent knocked into the bowl above one temple, showing bright bronze.
+		Kit.box("Head", { 0.06, 0.18, 0.3 }, { -0.69, 0.4, -0.2 }, "Metal", bronzeWorn, { 0, 0, 14 }),
+	},
+}
+
+return look
