+--!strict
+-- The sunwarden plate (Sunwarden set): the broad bronze breastplate of the
+-- Grashan sentinels, carried after the Colossus. Old green-bronze over a pale
+-- ruin-stone panel, a sun disc at the heart, a gold collar and belt, pale
+-- stone lames swung from the thighs, and the set's signature: huge round
+-- pauldrons, each dome capped with pale stone and a sun-gold boss, under a
+-- wide scraped brim. The back carries a pale stone tablet and a gold spine.
+-- At the high camera the round stone-capped shoulders and the pale hips carry
+-- the silhouette; gold bosses and disc are the bright points on a dark mass.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Old green-bronze, pale ruin stone and sun gold, as the helm.
+local bronze = { 86, 92, 62 }
+local bronzeDark = { 56, 60, 42 }
+local bronzeWorn = { 128, 132, 94 }
+local stone = { 168, 162, 144 }
+local gold = { 160, 126, 66 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenBoulderChest",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- Heavy pale stone lames, hung from the thighs so they swing with a
+			-- stride: thicker and longer than a cloth tail, for a sentinel's weight.
+			Kit.box("UpperLeg", { 0.9, 0.64, 0.14 }, { 0.08, 0.43, -0.56 }, "Marble", stone, { 4, 0, 0 }),
+			Kit.box("UpperLeg", { 0.9, 0.64, 0.14 }, { 0.08, 0.43, 0.56 }, "Marble", stone, { -4, 0, 0 }),
+		},
+		{
+			-- The barrel torso.
+			Kit.box("UpperTorso", { 2.1, 1.64, 1.06 }, { 0, 0, 0 }, "Metal", bronze),
+			-- The broad breastplate: two rounds of plate framing a stone panel.
+			Kit.box("UpperTorso", { 1.94, 0.9, 0.12 }, { 0, 0.34, -0.56 }, "Metal", bronzeWorn),
+			Kit.box("UpperTorso", { 1.7, 0.55, 0.12 }, { 0, -0.24, -0.55 }, "Metal", bronzeWorn),
+			Kit.box("UpperTorso", { 0.92, 0.94, 0.08 }, { 0, 0.3, -0.63 }, "Marble", stone),
+			-- The sun disc at the heart, protruding from the stone.
+			{
+				on = "UpperTorso",
+				shape = "Cylinder",
+				size = { 0.62, 0.12, 0.62 },
+				at = { 0, 0.3, -0.7 },
+				turn = { 90, 0, 0 },
+				material = "Metal",
+				color = gold,
+			},
+			-- A gold collar, a pale stone tablet down the back and a gold spine.
+			Kit.box("UpperTorso", { 1.56, 0.18, 1.14 }, { 0, 0.76, 0 }, "Metal", gold),
+			Kit.box("UpperTorso", { 1.24, 1.06, 0.08 }, { 0, 0.24, 0.57 }, "Marble", stone),
+			Kit.box("UpperTorso", { 0.26, 1.0, 0.1 }, { 0, 0.24, 0.62 }, "Metal", gold),
+			-- The waist and the gold belt with its square buckle.
+			Kit.box("LowerTorso", { 2.12, 0.5, 1.1 }, { 0, 0, 0 }, "Metal", bronze),
+			Kit.box("LowerTorso", { 2.16, 0.2, 1.16 }, { 0, 0.04, 0 }, "Metal", bronzeDark),
+			Kit.box("LowerTorso", { 0.4, 0.34, 0.12 }, { 0, 0.04, -0.62 }, "Metal", gold),
+			-- The sleeve under the pauldron, so no bare arm shows at its edge.
+			Kit.box("UpperArm", { 1.06, 1.24, 1.06 }, { 0, 0, 0 }, "Metal", bronze),
+			-- Huge round pauldrons: a dome under a wide scraped brim, capped in
+			-- pale stone with a sun-gold boss, the crown the high camera sees.
+			{
+				on = "UpperArm",
+				shape = "Ball",
+				size = { 1.36, 1.36, 1.36 },
+				at = { 0, 0.42, 0 },
+				material = "Metal",
+				color = bronze,
+			},
+			{
+				on = "UpperArm",
+				shape = "Cylinder",
+				size = { 1.54, 0.14, 1.54 },
+				at = { 0, 0.04, 0 },
+				material = "Metal",
+				color = bronzeWorn,
+			},
+			{
+				on = "UpperArm",
+				shape = "Cylinder",
+				size = { 0.94, 0.12, 0.94 },
+				at = { 0, 0.98, 0 },
+				material = "Marble",
+				color = stone,
+			},
+			{
+				on = "UpperArm",
+				shape = "Cylinder",
+				size = { 0.46, 0.14, 0.46 },
+				at = { 0, 1.06, 0 },
+				material = "Metal",
+				color = gold,
+			},
+		},
+	}),
+}
+
+return look
