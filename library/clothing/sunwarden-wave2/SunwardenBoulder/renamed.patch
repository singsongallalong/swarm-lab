+--!strict
+-- The sunwarden greaves (Sunwarden set): tall bronze greaves with a pale
+-- ruin-stone shin plate and a gold band under the knee, on heavy bronze feet
+-- with a stone toe. One shin is scuffed bright where it has taken a blow. At
+-- the high camera the gold knee and the pale toe keep the feet from sinking
+-- into the dark, and the stone shin repeats the helm's pale face.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Old green-bronze, pale ruin stone and sun gold, as the rest of the set.
+local bronze = { 86, 92, 62 }
+local bronzeDark = { 56, 60, 42 }
+local bronzeWorn = { 128, 132, 94 }
+local stone = { 168, 162, 144 }
+local gold = { 160, 126, 66 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenBoulderBoots",
+	slot = "Boots",
+	parts = {
+		-- The greave, the stone shin plate and the gold band at the knee.
+		Kit.box("LowerLeg", { 1.1, 1.0, 1.1 }, { 0, -0.08, 0 }, "Metal", bronze),
+		Kit.box("LowerLeg", { 0.8, 0.72, 0.12 }, { 0, -0.04, -0.57 }, "Marble", stone),
+		Kit.box("LowerLeg", { 1.18, 0.14, 1.18 }, { 0, 0.44, 0 }, "Metal", gold),
+		-- The foot and its stone toe.
+		Kit.box("Foot", { 1.08, 0.4, 1.26 }, { 0, 0.03, -0.12 }, "Metal", bronzeDark),
+		Kit.box("Foot", { 0.96, 0.3, 0.18 }, { 0, 0.04, -0.72 }, "Marble", stone),
+		-- A scuff up the outside of the left shin only.
+		Kit.box("LowerLeg", { 0.06, 0.5, 0.3 }, { 0.57, -0.12, 0 }, "Metal", bronzeWorn, nil, "Left"),
+	},
+}
+
+return look
