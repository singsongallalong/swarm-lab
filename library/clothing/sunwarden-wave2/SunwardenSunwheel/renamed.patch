+--!strict
+-- The Sunwarden helm (zone armour, the Sunwarden set): the ancient Grashan
+-- sentinels' war helm, a flat-topped great helm of old bronze over a pale
+-- ruin-stone face mask cut by a black eye slit, a gold nasal and brow band,
+-- and one low transverse crest of ruin stone with a gold stripe along its
+-- top. A dent above the right brow and one sun disc at the left ear keep it
+-- from being a pair.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Old green-bronze and pale ruin stone with sun gold: the Sunwarden palette.
+local bronze = { 96, 98, 66 }
+local bronzeDark = { 62, 62, 42 }
+local stone = { 146, 142, 128 }
+local gold = { 176, 146, 90 }
+local slit = { 34, 36, 30 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenSunwheelHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- One massive flat-topped helm, and the pale stone face mask.
+		Kit.box("Head", { 1.42, 1.34, 1.48 }, { 0, 0.04, 0.02 }, "Metal", bronze),
+		Kit.box("Head", { 1.28, 0.72, 0.16 }, { 0, -0.24, -0.7 }, "Marble", stone),
+		Kit.box("Head", { 1.06, 0.1, 0.08 }, { 0, -0.08, -0.8 }, "Metal", slit),
+		-- A gold nasal divides the slit, under the gold band at the brow.
+		Kit.box("Head", { 0.13, 0.44, 0.09 }, { 0, -0.28, -0.81 }, "Metal", gold),
+		Kit.box("Head", { 1.46, 0.14, 1.52 }, { 0, 0.18, 0.02 }, "Metal", gold),
+		-- One low transverse crest across the flat top, with a gold stripe
+		-- set into it so it catches the moon from the high camera.
+		Kit.box("Head", { 1.6, 0.18, 0.56 }, { 0, 0.8, 0.02 }, "Marble", stone),
+		Kit.box("Head", { 1.4, 0.05, 0.46 }, { 0, 0.915, 0.02 }, "Metal", gold),
+		-- A flared neck guard at the back.
+		Kit.box("Head", { 1.36, 0.3, 0.32 }, { 0, -0.32, 0.78 }, "Metal", bronzeDark, { -8, 0, 0 }),
+		-- A dent above the right brow, and the sun disc at the left ear.
+		Kit.box("Head", { 0.34, 0.2, 0.1 }, { 0.36, 0.4, -0.74 }, "Metal", bronzeDark, { 0, 0, 12 }),
+		{
+			on = "Head",
+			shape = "Cylinder",
+			size = { 0.3, 0.08, 0.3 },
+			at = { -0.73, -0.02, 0.05 },
+			turn = { 0, 0, 90 },
+			material = "Metal",
+			color = gold,
+		},
+	},
+}
+
+return look
