+local stone = { 146, 142, 128 }
+local gold = { 176, 146, 90 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenSunwheelBoots",
+	slot = "Boots",
+	parts = {
+		-- The greave and the broad knee cop over it.
+		Kit.box("LowerLeg", { 1.12, 0.94, 1.12 }, { 0, -0.08, 0 }, "Metal", bronze),
+		Kit.box("LowerLeg", { 1.26, 0.22, 1.26 }, { 0, 0.4, 0 }, "Metal", bronzeDark),
+		-- The pale stone shin plate and the gold band at the ankle.
+		Kit.box("LowerLeg", { 0.9, 0.66, 0.1 }, { 0, -0.12, -0.58 }, "Marble", stone),
+		Kit.box("LowerLeg", { 1.16, 0.1, 1.16 }, { 0, -0.44, 0 }, "Metal", gold),
+		-- The sabaton and its scraped toe cap.
+		Kit.box("Foot", { 1.1, 0.36, 1.16 }, { 0, 0.02, -0.04 }, "Metal", bronze),
+		Kit.box("Foot", { 0.78, 0.22, 0.24 }, { 0, 0.05, -0.66 }, "Metal", bronzeWorn),
+		-- A scar knocked into the right shin plate.
+		Kit.box("LowerLeg", { 0.18, 0.18, 0.06 }, { 0.3, -0.24, -0.64 }, "Metal", bronzeDark, { 0, 0, 14 }, "Right"),
+	},
+}
+
+return look
