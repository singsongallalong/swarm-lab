+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The helm: a stone cap over the crown of the head, a coronet band and
+		-- a dark bronze rim at the brow, with a bronze keystone in front.
+		Kit.box("Head", { 1.34, 0.5, 1.34 }, { 0, 0.36, 0 }, "Metal", stone),
+		Kit.box("Head", { 1.4, 0.14, 1.4 }, { 0, 0.19, 0 }, "Metal", stone),
+		Kit.box("Head", { 1.42, 0.05, 1.42 }, { 0, 0.095, 0 }, "Metal", bronzeDark),
+		Kit.box("Head", { 0.3, 0.2, 0.08 }, { 0, 0.33, -0.7 }, "Metal", bronze),
+		-- Two points rising from the front of the cap.
+		Kit.box("Head", { 0.12, 0.2, 0.12 }, { 0.46, 0.62, -0.42 }, "Metal", stone),
+		Kit.box("Head", { 0.12, 0.2, 0.12 }, { -0.46, 0.62, -0.42 }, "Metal", stone),
+		-- One centred crest, swept back, with a bronze cap and a bronze ridge
+		-- down its face so it reads on the centre line from the front.
+		Kit.box("Head", { 0.3, 0.8, 0.6 }, { 0, 0.78, 0.04 }, "Metal", stone, { 10, 0, 0 }),
+		Kit.box("Head", { 0.34, 0.08, 0.62 }, { 0, 1.16, 0.11 }, "Metal", bronzeWorn, { 10, 0, 0 }),
+		Kit.box("Head", { 0.08, 0.66, 0.06 }, { 0, 0.76, -0.28 }, "Metal", bronzeWorn, { 10, 0, 0 }),
+		-- The moss veil down the back of the head.
+		Kit.box("Head", { 1.3, 0.95, 0.05 }, { 0, -0.02, 0.66 }, "Fabric", mossCloth, { -10, 0, 0 }),
+		-- Moss on the left of the band, and a chip off the stone at the right.
+		Kit.box("Head", { 0.06, 0.12, 0.26 }, { -0.72, 0.3, 0.1 }, "Fabric", moss),
+		Kit.box("Head", { 0.16, 0.1, 0.06 }, { 0.48, 0.3, -0.68 }, "Metal", stoneDark),
+	},
+}
