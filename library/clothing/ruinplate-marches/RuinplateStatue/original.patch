+			Kit.box("UpperLeg", { 1.12, 0.12, 0.1 }, { 0, -0.06, 0.58 }, "Metal", bronze, { 0, 0, 3 }),
+			Kit.box("UpperLeg", { 0.1, 0.12, 1.1 }, { 0.57, -0.06, 0 }, "Metal", bronze, { 0, 0, 4 }),
+			Kit.box("UpperLeg", { 1.3, 0.46, 0.1 }, { 0.1, -0.35, -0.6 }, "Metal", stone, { 0, 0, 7 }),
+			Kit.box("UpperLeg", { 1.3, 0.46, 0.1 }, { 0.1, -0.35, 0.6 }, "Metal", stoneLight, { 0, 0, 7 }),
