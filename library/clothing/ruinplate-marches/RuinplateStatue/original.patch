+--!strict
+-- The ruinplate dress (zone armour, RuinplateDress): the statue knight's fitted
+-- cuirass and the upper skirt. A pale ruin-stone bodice laced closed in bronze,
+-- a narrow standing collar, a belt at the waist, a small bustle, and two
+-- overlapping rings of stone lames on the thighs, bronze-banded.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local stone = { 156, 152, 138 }
+local stoneLight = { 176, 172, 156 }
+local stoneDark = { 118, 116, 106 }
