+local bronze = { 120, 98, 62 }
+local moss = { 94, 102, 70 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "RuinplateDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The cuirass, its raised breastplate and the bronze V at the neck.
+			Kit.box("UpperTorso", { 2.04, 1.64, 1.06 }, { 0, 0, 0 }, "Metal", stone),
+			Kit.box("UpperTorso", { 1.68, 0.84, 0.1 }, { 0, 0.22, -0.58 }, "Metal", stoneLight),
+			Kit.box("UpperTorso", { 0.07, 0.78, 0.05 }, { 0.25, 0.44, -0.65 }, "Metal", bronze, { 0, 0, -26 }),
+			Kit.box("UpperTorso", { 0.07, 0.78, 0.05 }, { -0.25, 0.44, -0.65 }, "Metal", bronze, { 0, 0, 26 }),
+			-- The brooch where the V closes, and a chip knocked from the left plate.
+			Kit.box("UpperTorso", { 0.16, 0.16, 0.06 }, { 0, 0.09, -0.67 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 0.2, 0.12, 0.05 }, { -0.52, 0.42, -0.63 }, "Metal", stoneDark, { 0, 0, 12 }),
+			-- A raised pale backplate, so the back reads as stone and not shadow.
+			Kit.box("UpperTorso", { 1.68, 1.12, 0.08 }, { 0, 0.06, 0.56 }, "Metal", stoneLight),
+			-- A bronze collar ring and a narrow stone collar above it.
+			Kit.box("UpperTorso", { 0.84, 0.12, 0.88 }, { 0, 0.86, 0 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 0.7, 0.16, 0.74 }, { 0, 0.97, 0.02 }, "Metal", stoneLight),
+			-- The corset band at the waist and its bronze lacing.
+			Kit.box("UpperTorso", { 2.02, 0.24, 1.08 }, { 0, -0.62, 0 }, "Metal", stoneDark),
+			Kit.box("UpperTorso", { 0.06, 0.58, 0.05 }, { 0.1, -0.44, -0.61 }, "Metal", bronze, { 0, 0, 16 }),
+			Kit.box("UpperTorso", { 0.06, 0.58, 0.05 }, { -0.1, -0.44, -0.61 }, "Metal", bronze, { 0, 0, -16 }),
+			-- Moss at the right of the corset.
+			Kit.box("UpperTorso", { 0.3, 0.26, 0.06 }, { 0.72, -0.58, -0.53 }, "Fabric", moss, { 0, 0, 10 }),
+			-- The waist, and the belt with its pale stone buckle.
+			Kit.box("LowerTorso", { 2.06, 0.38, 1.08 }, { 0, 0, 0 }, "Metal", stone),
+			Kit.box("LowerTorso", { 2.1, 0.16, 1.12 }, { 0, 0, 0 }, "Metal", bronze),
+			Kit.box("LowerTorso", { 0.28, 0.2, 0.08 }, { 0, 0, -0.61 }, "Metal", stoneLight),
+			-- The bustle at the back, in pale stone with the rest.
+			Kit.box("LowerTorso", { 1.24, 0.32, 0.24 }, { 0, 0, 0.62 }, "Metal", stone),
+			-- A fitted sleeve, narrow at the shoulder and easing wider down the
+			-- upper arm; the flare belongs to the sleeves (RuinplateSleeves).
+			Kit.box("UpperArm", { 1.02, 0.34, 1.02 }, { 0, 0.42, 0 }, "Metal", stoneShade),
+			Kit.box("UpperArm", { 1.1, 0.86, 1.1 }, { 0, -0.16, 0 }, "Metal", stoneShade),
+		},
+		-- The upper skirt: an upper ring of stone lames and a lower, wider ring,
+		-- with a bronze band where they step and a moss drape at the right hip.
+		{
+			Kit.box("UpperLeg", { 1.1, 0.76, 0.1 }, { 0, 0.32, -0.56 }, "Metal", stoneLight, { 0, 0, 3 }),
+			Kit.box("UpperLeg", { 1.1, 0.76, 0.1 }, { 0, 0.32, 0.56 }, "Metal", stoneLight, { 0, 0, 3 }),
