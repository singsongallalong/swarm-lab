+		Kit.box("Head", { 1.32, 0.08, 1.32 }, { 0, 0.68, 0 }, "Metal", c.gold),
+		-- The ziggurat's steps, each narrower than the one below.
+		Kit.box("Head", { 1.08, 0.18, 1.08 }, { 0, 0.79, 0 }, "Fabric", c.stone),
+		Kit.box("Head", { 1.1, 0.05, 1.1 }, { 0, 0.9, 0 }, "Metal", c.gold),
