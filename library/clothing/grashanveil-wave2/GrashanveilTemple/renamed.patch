+local terracotta = { 166, 112, 88 } -- faded terracotta
+local green = { 112, 124, 92 } -- plains green
+local shadow = { 60, 58, 54 } -- the eye's dark centre
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "GrashanveilTempleDress",
+	slot = "Chest",
+	parts = {
+		-- The fitted bodice, and the terracotta stomacher with its gold seams.
+		Kit.box("UpperTorso", { 2.06, 1.7, 1.06 }, { 0, -0.03, 0 }, "Fabric", stone),
+		Kit.box("UpperTorso", { 0.72, 1.2, 0.07 }, { 0, -0.12, -0.55 }, "Fabric", terracotta),
+		Kit.box("UpperTorso", { 0.06, 1.24, 0.08 }, { 0.38, -0.12, -0.555 }, "Metal", gold),
+		Kit.box("UpperTorso", { 0.06, 1.24, 0.08 }, { -0.38, -0.12, -0.555 }, "Metal", gold),
+		-- A faded mend low on the left of the bodice.
+		Kit.box("UpperTorso", { 0.3, 0.22, 0.04 }, { -0.72, -0.55, -0.535 }, "Fabric", stoneShade),
+		-- The sun-eye: a gold diamond with a dark slit, and four short rays.
+		Kit.box("UpperTorso", { 0.44, 0.44, 0.1 }, { 0, 0.12, -0.61 }, "Metal", gold, { 0, 0, 45 }),
+		Kit.box("UpperTorso", { 0.22, 0.08, 0.06 }, { 0, 0.12, -0.655 }, "Fabric", shadow),
+		Kit.box("UpperTorso", { 0.16, 0.07, 0.06 }, { 0.36, 0.12, -0.59 }, "Metal", gold),
+		Kit.box("UpperTorso", { 0.16, 0.07, 0.06 }, { -0.36, 0.12, -0.59 }, "Metal", gold),
+		Kit.box("UpperTorso", { 0.07, 0.16, 0.06 }, { 0, 0.4, -0.59 }, "Metal", gold),
+		Kit.box("UpperTorso", { 0.07, 0.16, 0.06 }, { 0, -0.16, -0.59 }, "Metal", gold),
+		-- A gold neckline, a short pale mantle at the back and its sun.
+		Kit.box("UpperTorso", { 1.34, 0.1, 0.1 }, { 0, 0.76, -0.55 }, "Metal", gold),
+		Kit.box("UpperTorso", { 1.5, 1.15, 0.1 }, { 0, 0.05, 0.57 }, "Fabric", stone, { 2, 0, 0 }),
+		Kit.box("UpperTorso", { 1.5, 0.08, 0.12 }, { 0, -0.5, 0.57 }, "Metal", gold, { 2, 0, 0 }),
+		Kit.box("UpperTorso", { 0.34, 0.34, 0.06 }, { 0, 0.25, 0.63 }, "Metal", gold, { 0, 0, 45 }),
+		-- The terracotta sash, its green ribbon, gold belt and clasp, and the
+		-- flared hip below.
+		Kit.box("LowerTorso", { 2.08, 0.4, 1.08 }, { 0, 0.02, 0 }, "Fabric", terracotta),
