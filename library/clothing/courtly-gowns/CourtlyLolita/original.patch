+--!strict
+-- The courtly cuffs: a close black lower sleeve to the wrist, a black ribbon
+-- band with a little bow on the outside, and two tiers of pale lace gathered
+-- at the wrist over a near-black glove. The sleeve's top meets the puff's
+-- lace band at the elbow; the cuff's pale ruffle is what reads at the high
+-- camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local gown = { 44, 42, 50 }
+local gownDeep = { 30, 29, 35 }
+local lace = { 138, 130, 116 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyCuffs",
+	slot = "Gloves",
+	parts = {
+		-- The fitted sleeve down the forearm.
+		Kit.box("LowerArm", { 1.08, 1, 1.08 }, { 0, 0, 0 }, "Fabric", gown),
+		-- The ribbon band and its bow, outside the wrist.
+		Kit.box("LowerArm", { 1.16, 0.12, 1.16 }, { 0, -0.22, 0 }, "Fabric", gownDeep),
+		Kit.box("LowerArm", { 0.28, 0.2, 0.14 }, { 0.64, -0.22, -0.11 }, "Fabric", gownDeep, { 20, 0, 0 }),
+		Kit.box("LowerArm", { 0.28, 0.2, 0.14 }, { 0.64, -0.22, 0.11 }, "Fabric", gownDeep, { -20, 0, 0 }),
+		Kit.box("LowerArm", { 0.14, 0.14, 0.12 }, { 0.68, -0.22, 0 }, "Fabric", gownDeep),
+		-- The banded lace cuff, two tiers.
+		Kit.box("LowerArm", { 1.36, 0.22, 1.36 }, { 0, -0.36, 0 }, "Fabric", c.bone),
+		Kit.box("LowerArm", { 1.44, 0.16, 1.44 }, { 0, -0.47, 0 }, "Fabric", lace),
+		-- The glove and its lace wrist edge.
+		Kit.box("Hand", { 1.06, 0.34, 1.06 }, { 0, 0, 0 }, "Leather", gownDeep),
+		Kit.box("Hand", { 1.12, 0.08, 1.12 }, { 0, 0.16, 0 }, "Fabric", lace),
+	},
+}
+
+return look
