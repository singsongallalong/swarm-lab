+--!strict
+-- The courtly gown: a black bodice with a pale grey stomacher crossed by
+-- ribbon lacing, a bone collar over a lace ruffle, a great black bow at the
+-- chest and a little one at the throat. The waist is cinched with a pale sash
+-- and a bow at the back, the sleeves are puffed cylinders gathered into lace
+-- at the elbow, and the skirt is a cone of six black panels round each thigh
+-- with a lifted black apron down the front, stopping above the knee so the
+-- hem's panels (CourtlyHem) carry it on down.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The gown's blacks are its own: a blue-cast near-black cloth, a deeper
+-- ribbon for the bows, a lifted fold for the layered skirt, the pale grey of
+-- its print, and a dim lace that stays under the bone trim's value.
+local gown = { 44, 42, 50 }
+local gownDeep = { 30, 29, 35 }
+local gownFold = { 60, 57, 66 }
+local print = { 106, 106, 114 }
+local lace = { 138, 130, 116 }
+
+-- The skirt is a cone round each thigh: 0.55 of radius at the top, 0.88 at
+-- the knee, the panels tipped out by 13 degrees. It runs from just inside the
+-- waist to 0.13 above the knee, where the boots' panels begin.
+local SKIRT = 1.42
+local SKIRT_Y = 0.09
+local SKIRT_R = 0.715
+local SKIRT_LEAN = 13.1
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyGown",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice and its pale stomacher, cross-laced low.
+			Kit.box("UpperTorso", { 2.06, 1.64, 1.06 }, { 0, 0, 0 }, "Fabric", gown),
+			Kit.box("UpperTorso", { 0.66, 1.2, 0.08 }, { 0, -0.02, -0.55 }, "Fabric", print),
+			Kit.box("UpperTorso", { 0.56, 0.06, 0.03 }, { 0, -0.2, -0.6 }, "Fabric", gownDeep, { 0, 0, 22 }),
+			Kit.box("UpperTorso", { 0.56, 0.06, 0.03 }, { 0, -0.44, -0.6 }, "Fabric", gownDeep, { 0, 0, -22 }),
+			-- The collar at the base of the neck, and its lace ruffle under it.
+			Kit.box("UpperTorso", { 1.3, 0.12, 1.14 }, { 0, 0.72, 0 }, "Fabric", c.bone),
+			Kit.box("UpperTorso", { 1.42, 0.16, 1.22 }, { 0, 0.62, 0 }, "Fabric", lace),
+			-- The great bow at the chest, one loop fuller, its tails to the waist.
+			Kit.box("UpperTorso", { 0.78, 0.42, 0.18 }, { 0.38, 0.08, -0.58 }, "Fabric", gownDeep, { 0, -8, 16 }),
+			Kit.box("UpperTorso", { 0.72, 0.4, 0.18 }, { -0.37, 0.08, -0.58 }, "Fabric", gownDeep, { 0, 8, -16 }),
+			Kit.box("UpperTorso", { 0.32, 0.36, 0.22 }, { 0, 0.08, -0.6 }, "Fabric", gownDeep),
+			Kit.box("UpperTorso", { 0.22, 0.76, 0.1 }, { 0.11, -0.36, -0.58 }, "Fabric", gownDeep, { 0, 0, 6 }),
+			Kit.box("UpperTorso", { 0.22, 0.68, 0.1 }, { -0.11, -0.32, -0.58 }, "Fabric", gownDeep, { 0, 0, -8 }),
+			-- The smaller bow at the throat.
+			Kit.box("UpperTorso", { 0.3, 0.18, 0.12 }, { 0.16, 0.5, -0.62 }, "Fabric", gownDeep, { 0, 0, 20 }),
+			Kit.box("UpperTorso", { 0.3, 0.18, 0.12 }, { -0.16, 0.5, -0.62 }, "Fabric", gownDeep, { 0, 0, -20 }),
+			Kit.box("UpperTorso", { 0.13, 0.13, 0.1 }, { 0, 0.5, -0.64 }, "Fabric", gownDeep),
+			-- The cinched waist: a bone sash over a black band, a bow at the
+			-- back, and a short flounce under it.
+			Kit.box("LowerTorso", { 2.02, 0.4, 1.02 }, { 0, 0, 0 }, "Fabric", gown),
+			Kit.box("LowerTorso", { 2.04, 0.12, 1.04 }, { 0, 0.08, 0 }, "Fabric", lace),
+			Kit.box("LowerTorso", { 0.5, 0.3, 0.14 }, { 0.26, 0.02, 0.56 }, "Fabric", gownDeep, { 0, 0, 14 }),
+			Kit.box("LowerTorso", { 0.5, 0.3, 0.14 }, { -0.26, 0.02, 0.56 }, "Fabric", gownDeep, { 0, 0, -14 }),
+			Kit.box("LowerTorso", { 0.18, 0.2, 0.14 }, { 0, 0.02, 0.58 }, "Fabric", gownDeep),
+			Kit.box("LowerTorso", { 2.08, 0.1, 1.08 }, { 0, -0.14, 0 }, "Fabric", gownFold),
+			-- The puffed sleeve, gathered into lace at the elbow.
+			{
+				on = "UpperArm",
+				shape = "Cylinder",
+				size = { 1.55, 1.2, 1.55 },
+				at = { 0, 0.05, 0 },
+				material = "Fabric",
+				color = gown,
+			},
+			Kit.box("UpperArm", { 1.46, 0.2, 1.46 }, { 0, -0.52, 0 }, "Fabric", lace),
+			-- The upper skirt: six black panels round each thigh, the front one
+			-- carrying the pale apron.
+			Kit.box("UpperLeg", { 1.0, SKIRT, 0.1 }, { 0, SKIRT_Y, -SKIRT_R }, "Fabric", gown, { SKIRT_LEAN, 0, 0 }),
+			Kit.box("UpperLeg", { 1.0, SKIRT, 0.1 }, { 0, SKIRT_Y, SKIRT_R }, "Fabric", gown, { -SKIRT_LEAN, 0, 0 }),
+			Kit.box("UpperLeg", { 0.1, SKIRT, 1.0 }, { SKIRT_R, SKIRT_Y, 0 }, "Fabric", gown, { 0, 0, SKIRT_LEAN }),
+			Kit.box("UpperLeg", { 0.1, SKIRT, 1.0 }, { -SKIRT_R, SKIRT_Y, 0 }, "Fabric", gown, { 0, 0, -SKIRT_LEAN }),
+			Kit.box("UpperLeg", { 1.02, SKIRT, 0.1 }, { 0.506, SKIRT_Y, -0.506 }, "Fabric", gown, { 19, -45, 0 }),
+			Kit.box("UpperLeg", { 1.02, SKIRT, 0.1 }, { 0.506, SKIRT_Y, 0.506 }, "Fabric", gown, { -19, 45, 0 }),
+			Kit.box("UpperLeg", { 0.8, 0.9, 0.07 }, { -0.1, 0.29, -0.74 }, "Fabric", gownFold, { SKIRT_LEAN, 0, 0 }),
+			-- A pale mend high on the left of the skirt, where it has worn thin.
+			Kit.box(
+				"UpperLeg",
+				{ 0.3, 0.24, 0.05 },
+				{ 0.42, 0.42, -0.7 },
+				"Fabric",
+				lace,
+				{ SKIRT_LEAN, 0, 0 },
+				"Left"
+			),
+		},
+	}),
+}
+
+return look
