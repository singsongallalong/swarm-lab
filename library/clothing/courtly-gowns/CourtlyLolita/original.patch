+--!strict
+-- The courtly hem: the gown's lower skirt, a cone of six black panels round
+-- each shin starting where the thigh's panels stop, falling into three tiers
+-- at the ankle — a black flounce, the pale grey print, and the bone petticoat
+-- edge under them. Beneath, a dark pointed shoe with a low court heel and a
+-- bone instep strap. A pale mend on the right shin, where the hem has worn
+-- thin.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local gown = { 44, 42, 50 }
+local gownDeep = { 30, 29, 35 }
+local gownFold = { 60, 57, 66 }
+local print = { 106, 106, 114 }
+local lace = { 138, 130, 116 }
+
+-- The panels start 0.13 above the knee, where the gown's thigh panels end,
+-- and run down the shin, widening a little to the ankle's tiers.
+local HEM = 1.43
+local HEM_Y = 0.165
+local HEM_R = 0.95
+local HEM_LEAN = 5.6
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyHem",
+	slot = "Boots",
+	parts = Kit.join({
+		{
+			-- The lower skirt's six panels.
+			Kit.box("LowerLeg", { 1.16, HEM, 0.1 }, { 0, HEM_Y, -HEM_R }, "Fabric", gown, { HEM_LEAN, 0, 0 }),
+			Kit.box("LowerLeg", { 1.16, HEM, 0.1 }, { 0, HEM_Y, HEM_R }, "Fabric", gown, { -HEM_LEAN, 0, 0 }),
+			Kit.box("LowerLeg", { 0.1, HEM, 1.16 }, { HEM_R, HEM_Y, 0 }, "Fabric", gown, { 0, 0, HEM_LEAN }),
+			Kit.box("LowerLeg", { 0.1, HEM, 1.16 }, { -HEM_R, HEM_Y, 0 }, "Fabric", gown, { 0, 0, -HEM_LEAN }),
+			Kit.box("LowerLeg", { 1.2, HEM, 0.1 }, { 0.672, HEM_Y, -0.672 }, "Fabric", gown, { 8, -45, 0 }),
+			Kit.box("LowerLeg", { 1.2, HEM, 0.1 }, { 0.672, HEM_Y, 0.672 }, "Fabric", gown, { -8, 45, 0 }),
+			-- The layered hem: a black flounce, the print, the petticoat edge.
+			Kit.box("LowerLeg", { 2.04, 0.2, 2.16 }, { 0, -0.52, 0 }, "Fabric", gownFold),
+			Kit.box("LowerLeg", { 2.2, 0.1, 2.32 }, { 0, -0.64, 0 }, "Fabric", print),
+			Kit.box("LowerLeg", { 2.36, 0.08, 2.48 }, { 0, -0.72, 0 }, "Fabric", lace),
+			-- A pale mend low on the right of the skirt.
+			Kit.box(
+				"LowerLeg",
+				{ 0.3, 0.24, 0.05 },
+				{ 0.42, -0.1, -1.04 },
+				"Fabric",
+				lace,
+				{ HEM_LEAN, 0, 0 },
+				"Right"
+			),
+			-- The shoe, its low heel and its bone strap.
+			Kit.box("Foot", { 1.08, 0.3, 1.28 }, { 0, 0.02, -0.16 }, "Leather", gownDeep),
+			Kit.box("Foot", { 0.74, 0.16, 0.24 }, { 0, -0.1, 0.34 }, "Leather", gownDeep),
+			Kit.box("Foot", { 1.12, 0.08, 0.12 }, { 0, 0.14, -0.4 }, "Fabric", c.bone),
+		},
+	}),
+}
+
+return look
