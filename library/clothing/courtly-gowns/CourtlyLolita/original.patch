+--!strict
+-- The courtly headdress: a black ribbon band worn high in the hair over a
+-- ring of pale lace, a great black bow set on the crown with two tails down
+-- the back, a short black veil hanging from the nape with a bone edge, and a
+-- small bone brooch at the band's front. The bow's loops tip back toward the
+-- high camera, so the head reads as a tall black bow above a pale ring.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The gown's blacks are its own: a blue-cast near-black cloth and a deeper
+-- ribbon, both inside the bible's surface limits.
+local gown = { 44, 42, 50 }
+local gownDeep = { 30, 29, 35 }
+local lace = { 138, 130, 116 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyHeaddress",
+	slot = "Helm",
+	parts = {
+		-- The ribbon band, its bone piping and the lace ring under it.
+		Kit.box("Head", { 1.4, 0.16, 1.4 }, { 0, 0.4, 0 }, "Fabric", gownDeep),
+		Kit.box("Head", { 1.42, 0.05, 1.42 }, { 0, 0.46, 0 }, "Fabric", c.bone),
+		Kit.box("Head", { 1.46, 0.14, 1.46 }, { 0, 0.29, 0 }, "Fabric", lace),
+		-- The bow on the crown: one loop a little fuller, both tipped back so
+		-- their faces catch the high camera.
+		Kit.box("Head", { 0.84, 0.56, 0.24 }, { 0.44, 0.86, 0.02 }, "Fabric", gownDeep, { 16, -10, 24 }),
+		Kit.box("Head", { 0.76, 0.5, 0.24 }, { -0.44, 0.86, 0.02 }, "Fabric", gownDeep, { 16, 10, -22 }),
+		Kit.box("Head", { 0.34, 0.36, 0.28 }, { -0.04, 0.8, 0.02 }, "Fabric", gownDeep),
+		-- Its tails, hung down the back of the head.
+		Kit.box("Head", { 0.2, 0.62, 0.1 }, { 0.2, 0.5, 0.79 }, "Fabric", gownDeep, { 8, 0, 8 }),
+		Kit.box("Head", { 0.2, 0.54, 0.1 }, { -0.22, 0.54, 0.79 }, "Fabric", gownDeep, { 8, 0, -6 }),
+		-- The veil from the nape, and its bone edge.
+		Kit.box("Head", { 1.2, 0.96, 0.1 }, { 0, 0, 0.72 }, "Fabric", gown),
+		Kit.box("Head", { 1.22, 0.1, 0.11 }, { 0, -0.44, 0.72 }, "Fabric", lace),
+		-- A small bone brooch at the centre of the band.
+		Kit.box("Head", { 0.2, 0.14, 0.06 }, { 0, 0.38, -0.72 }, "Fabric", c.bone),
+	},
+}
+
+return look
