+		Kit.box("LowerTorso", { 2.14, 0.16, 1.12 }, { 0, 0.02, 0 }, "Fabric", slate),
+		Kit.box("LowerTorso", { 1.66, 0.38, 0.68 }, { 0, 0, 0.68 }, "Fabric", black),
+		Kit.box("LowerTorso", { 1.84, 0.16, 0.66 }, { 0, -0.11, 0.66 }, "Fabric", slate),
