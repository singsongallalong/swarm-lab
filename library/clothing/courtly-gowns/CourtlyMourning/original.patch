+--!strict
+-- The courtly hem (the gown set's boots): the rest of the gown's skirt carried
+-- down the shins. The front wraps left over right like a gown's skirt, the
+-- back falls a little longer into a train, and the whole tier flares wider
+-- than the thigh panels above it, hemed in slate over a pale bone petticoat.
+-- Flat black shoes show below, with a slate ankle band and a pale rosette.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Mourning wool and black leather, the slate of its bands, the bone of the
+-- petticoat and the old lace.
+local black = { 48, 48, 55 }
+local blackDeep = { 34, 34, 40 }
+local slate = { 84, 88, 98 }
+local bone = { 150, 142, 124 }
+
+-- Where the skirt picks up the thigh's panels, and how far front and back fall.
+local TOP = 0.78
+local HEM = 1.28
+local TRAIN = 1.36
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyHem",
+	slot = "Boots",
+	parts = {
+		-- The skirt's lower tier, wide panels hung on each shin and lapped left
+		-- over right at the centre, so the two legs' panels read as one skirt.
+		Kit.box("LowerLeg", { 1.6, HEM, 0.1 }, { 0.13, TOP - HEM / 2, -0.72 }, "Fabric", black, { 10, 0, 0 }, "Right"),
+		Kit.box("LowerLeg", { 1.6, HEM, 0.1 }, { 0.13, TOP - HEM / 2, -0.78 }, "Fabric", black, { 10, 0, 0 }, "Left"),
+		Kit.box(
+			"LowerLeg",
+			{ 1.6, TRAIN, 0.1 },
+			{ 0.13, TOP - TRAIN / 2, 0.72 },
+			"Fabric",
+			black,
+			{ -10, 0, 0 },
+			"Right"
+		),
+		Kit.box(
+			"LowerLeg",
+			{ 1.6, TRAIN, 0.1 },
+			{ 0.13, TOP - TRAIN / 2, 0.78 },
+			"Fabric",
+			black,
+			{ -10, 0, 0 },
+			"Left"
+		),
+		-- The side panel, flaring out from knee to hem.
+		Kit.box("LowerLeg", { 0.1, HEM, 1.5 }, { 0.92, TOP - HEM / 2, 0 }, "Fabric", black, { 0, 0, 12 }),
+		-- A slate band across the shin, then the ruffled hem and its petticoat.
+		Kit.box("LowerLeg", { 1.56, 0.12, 1.5 }, { 0.02, -0.2, 0 }, "Fabric", slate),
+		Kit.box("LowerLeg", { 1.72, 0.14, 1.6 }, { 0.02, -0.5, 0 }, "Fabric", slate),
+		Kit.box("LowerLeg", { 1.8, 0.1, 1.68 }, { 0.02, -0.6, 0 }, "Fabric", bone),
+		-- Flat black shoes, a slate edge at the ankle and a pale rosette at the toe.
+		Kit.box("Foot", { 1.04, 0.3, 1.24 }, { 0, 0.02, -0.1 }, "Leather", blackDeep),
+		Kit.box("Foot", { 1.06, 0.08, 1.1 }, { 0, 0.17, -0.06 }, "Fabric", slate),
+		Kit.box("Foot", { 0.2, 0.14, 0.1 }, { 0.26, 0.12, -0.62 }, "Fabric", bone, { 0, 0, 12 }),
+	},
+}
+
+return look
