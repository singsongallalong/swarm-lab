+		-- A scuff worn into the bodice by a strap.
+		Kit.box("UpperTorso", { 0.3, 0.28, 0.03 }, { 0.66, -0.42, -0.555 }, "Fabric", blackDeep, { 0, 0, 10 }),
+		-- The back laced closed over a slate panel.
