+--!strict
+-- The courtly headdress (the gown set's helm): a small wide-brimmed mourning
+-- hat in near-black wool with a big black bow standing at the back, and a
+-- black veil hung all round the head from a slate band under the brim, spotted
+-- pale with the moon through the net. Jet beads on the hat band and a pale
+-- lace edge to the brim catch the light, so the headpiece reads as a disc and
+-- a bow from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- Mourning wool, the old lace that trims it, and the slate of a ribbon.
+local black = { 48, 48, 55 }
+local blackDeep = { 34, 34, 40 }
+local slate = { 84, 88, 98 }
+local bone = { 150, 142, 124 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyHeaddress",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The crown and its broad brim, a little wider than the head so the hat
+		-- reads as a disc from above.
+		Kit.box("Head", { 1.4, 0.5, 1.4 }, { 0, 0.74, 0 }, "Fabric", black),
+		Kit.box("Head", { 2.02, 0.1, 1.84 }, { 0, 0.44, -0.04 }, "Fabric", black),
+		-- The slate ribbon round the crown, and the pale lace edge of the brim.
