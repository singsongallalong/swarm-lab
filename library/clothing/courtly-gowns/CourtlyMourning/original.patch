+		Kit.box("Head", { 1.5, 0.05, 0.08 }, { 0, 0.38, -0.92 }, "Fabric", bone),
+		-- Jet beads on the band, catching the moon.
+		Kit.box("Head", { 0.09, 0.09, 0.06 }, { -0.42, 0.54, -0.74 }, "Metal", c.ironWorn),
+		Kit.box("Head", { 0.09, 0.09, 0.06 }, { 0, 0.54, -0.74 }, "Metal", c.ironWorn),
+		Kit.box("Head", { 0.09, 0.09, 0.06 }, { 0.42, 0.54, -0.74 }, "Metal", c.ironWorn),
+		-- The big bow at the back of the hat: two loops, a knot and uneven tails.
+		Kit.box("Head", { 0.54, 0.34, 0.16 }, { -0.42, 0.96, 0.8 }, "Fabric", black, { 0, 12, 16 }),
+		Kit.box("Head", { 0.54, 0.34, 0.16 }, { 0.42, 0.96, 0.8 }, "Fabric", black, { 0, -12, -16 }),
+		Kit.box("Head", { 0.26, 0.3, 0.2 }, { 0, 0.9, 0.84 }, "Fabric", blackDeep),
+		Kit.box("Head", { 0.16, 0.62, 0.08 }, { -0.14, 0.52, 0.88 }, "Fabric", black, { 0, 0, 5 }),
+		Kit.box("Head", { 0.16, 0.5, 0.08 }, { 0.16, 0.44, 0.88 }, "Fabric", black, { 0, 0, -7 }),
+		-- The veil, hung all round the head from a slate band under the brim.
+		Kit.box("Head", { 1.44, 0.1, 1.44 }, { 0, 0.36, 0 }, "Fabric", slate),
+		Kit.box("Head", { 1.34, 1.2, 1.36 }, { 0, -0.1, 0 }, "Fabric", blackDeep),
+		-- Spots on the veil, pale as the moon through net.
+		Kit.box("Head", { 0.1, 0.1, 0.03 }, { -0.26, 0.05, -0.7 }, "Fabric", slate),
+		Kit.box("Head", { 0.1, 0.1, 0.03 }, { 0.22, -0.35, -0.7 }, "Fabric", slate),
