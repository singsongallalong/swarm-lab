+		Kit.box("LowerArm", { 1.3, 0.06, 1.3 }, { 0, -0.49, 0 }, "Fabric", slate),
+		Kit.box("LowerArm", { 1.26, 0.12, 1.26 }, { 0, -0.56, 0 }, "Fabric", bone),
