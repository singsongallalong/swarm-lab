+--!strict
+-- The courtly headdress (the Courtly gown's helm): a tall plum velvet hennin
+-- tapering in four stepped tiers to a point, worn over a low velvet cap and
+-- banded in bone lace with a black velvet ribbon. Pale wimple panels frame the
+-- face and a long pale veil falls down the back, held by a big black bow at
+-- the nape. The taper and the veil's fall carry the headpiece from the high
+-- camera; the bow's black loops frame the nape. Worn at one edge, as
+-- everything in this world is.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local plum = { 78, 52, 66 }
+local plumWorn = { 98, 68, 80 }
+local black = { 36, 32, 38 }
+local ivory = { 166, 162, 154 }
+local bone = { 190, 186, 176 }
+
+-- A cylinder in the part's own Y, as ArmourPart's: { diameter, length, diameter }.
+local function cylinder(
+	on: ArmourLookTypes.BodyPart,
+	size: { number },
+	at: { number },
+	material: string,
+	color: { number },
+	turn: { number }?
+): ArmourLookTypes.ArmourPart
+	return { on = on, shape = "Cylinder", size = size, at = at, turn = turn, material = material, color = color }
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyHeaddress",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The cap under the hennin, and the hennin's stepped taper, the tip a
+		-- little off centre.
+		Kit.box("Head", { 1.22, 0.16, 1.22 }, { 0, 0.56, 0 }, "Fabric", plum),
+		cylinder("Head", { 0.78, 0.5, 0.78 }, { 0, 0.85, 0 }, "Fabric", plum),
+		cylinder("Head", { 0.58, 0.5, 0.58 }, { 0, 1.33, 0 }, "Fabric", plum),
+		cylinder("Head", { 0.42, 0.45, 0.42 }, { 0, 1.78, 0 }, "Fabric", plum),
+		cylinder("Head", { 0.26, 0.4, 0.26 }, { 0.03, 2.17, 0.02 }, "Fabric", plum),
+		-- The lace band at the brow, and its black velvet ribbon.
+		Kit.box("Head", { 0.8, 0.12, 0.8 }, { 0, 0.67, 0 }, "Fabric", bone),
+		Kit.box("Head", { 0.78, 0.06, 0.78 }, { 0, 0.76, 0 }, "Fabric", black),
+		-- A worn scuff on the cone's front left, where a hand has caught it.
+		Kit.box("Head", { 0.18, 0.3, 0.03 }, { -0.27, 0.95, -0.27 }, "Fabric", plumWorn, { 0, 0, 10 }),
+		-- The wimple: pale panels down each side of the face, meeting the collar.
+		Kit.box("Head", { 0.06, 1.2, 0.9 }, { 0.62, 0, 0.15 }, "Fabric", ivory),
+		Kit.box("Head", { 0.06, 1.2, 0.9 }, { -0.62, 0, 0.15 }, "Fabric", ivory),
+		-- The veil: a fold over the crown, then a long pale fall down the back,
+		-- edged in lace.
+		Kit.box("Head", { 0.9, 0.05, 0.24 }, { 0, 0.78, 0.55 }, "Fabric", ivory),
+		Kit.box("Head", { 1.0, 1.6, 0.06 }, { 0, -0.05, 0.66 }, "Fabric", ivory, { -4, 0, 0 }),
+		Kit.box("Head", { 1.04, 0.12, 0.08 }, { 0, -0.88, 0.72 }, "Fabric", bone, { -4, 0, 0 }),
+		-- The big black bow, pinned at the nape over the veil, a little off centre.
+		Kit.box("Head", { 0.46, 0.3, 0.16 }, { -0.33, 0.48, 0.68 }, "Fabric", black, { 0, 0, -18 }),
+		Kit.box("Head", { 0.46, 0.3, 0.16 }, { 0.25, 0.46, 0.68 }, "Fabric", black, { 0, 0, 16 }),
+		Kit.box("Head", { 0.22, 0.26, 0.18 }, { -0.04, 0.47, 0.72 }, "Fabric", black),
+		Kit.box("Head", { 0.14, 0.5, 0.08 }, { -0.12, 0.18, 0.7 }, "Fabric", black, { -6, 0, 7 }),
+		Kit.box("Head", { 0.12, 0.42, 0.08 }, { 0.04, 0.22, 0.7 }, "Fabric", black, { -4, 0, -5 }),
+	},
+}
