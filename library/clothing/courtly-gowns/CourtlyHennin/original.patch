+		Kit.box("LowerArm", { 1.26, 0.16, 1.26 }, { 0, -0.3, 0 }, "Fabric", ivory),
+		Kit.box("LowerArm", { 1.36, 0.12, 1.36 }, { 0, -0.42, 0 }, "Fabric", bone),
