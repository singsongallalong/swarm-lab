+--!strict
+-- The courtly hem (the Courtly gown's boots): the skirt's lower fall carried
+-- on each shin in five plum panels, a darker ruffled tier below it, a mottled
+-- fur band and a soft ivory petticoat edge peeking out, then black pointed
+-- shoes. The pale lower edge is the second read from the high camera after
+-- the skirt's bell; one lace point hangs long on the right and moss has taken
+-- the back hem on that side.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local plum = { 78, 52, 66 }
+local plumDark = { 55, 37, 47 }
+local furPale = { 124, 118, 108 }
+local ivory = { 166, 162, 154 }
+local black = { 36, 32, 38 }
+local moss = { 70, 76, 58 }
+local bone = { 190, 186, 176 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyHem",
+	slot = "Boots",
+	parts = {
+		-- The lower skirt: five panels round each shin, the front and back
+		-- meeting at the centre, set just outside the thigh's panels so the
+		-- two tiers read as one fall standing.
+		Kit.box("LowerLeg", { 1.2, 0.95, 0.08 }, { 0.1, 0.21, -0.67 }, "Fabric", plum, { 10, 0, 0 }),
+		Kit.box("LowerLeg", { 1.2, 0.95, 0.08 }, { 0.1, 0.21, 0.67 }, "Fabric", plum, { -10, 0, 0 }),
+		Kit.box("LowerLeg", { 0.08, 0.95, 1.1 }, { 0.65, 0.21, 0 }, "Fabric", plum, { 0, 0, 24 }),
+		Kit.box("LowerLeg", { 0.84, 0.95, 0.08 }, { 0.47, 0.21, -0.52 }, "Fabric", plum, { 10, 44, 0 }),
+		Kit.box("LowerLeg", { 0.84, 0.95, 0.08 }, { 0.47, 0.21, 0.52 }, "Fabric", plum, { -10, -44, 0 }),
+		-- The darker ruffled tier, then a mottled fur band and the pale petticoat,
+		-- each a little wider and deeper than the one above it.
+		Kit.box("LowerLeg", { 1.8, 0.32, 1.85 }, { 0.4, -0.31, 0 }, "Fabric", plumDark),
+		Kit.box("LowerLeg", { 1.9, 0.12, 1.95 }, { 0.45, -0.47, 0 }, "Fabric", furPale),
+		Kit.box("LowerLeg", { 2.0, 0.16, 2.05 }, { 0.5, -0.59, 0 }, "Fabric", ivory),
+		-- One lace point hangs longer at the right front, and moss has taken the right back hem.
+		Kit.box("LowerLeg", { 0.3, 0.22, 0.05 }, { 1.3, -0.62, -1.05 }, "Fabric", bone, { 0, 0, 6 }, "Right"),
+		Kit.box("LowerLeg", { 0.34, 0.24, 0.03 }, { 0.9, -0.33, 0.94 }, "Fabric", moss, { 0, 0, 4 }, "Right"),
+		-- Black pointed shoes, mostly hidden by the fall.
+		Kit.box("Foot", { 1.02, 0.3, 1.12 }, { 0, 0, -0.03 }, "Leather", black),
+		Kit.wedge("Foot", { 0.9, 0.16, 0.3 }, { 0, 0, -0.7 }, "Leather", black),
+	},
+}
+
+return look
