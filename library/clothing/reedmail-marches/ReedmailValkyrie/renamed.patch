+--!strict
+-- The reedmail dress: a fitted fen-green bodice under a bright bog-iron
+-- breastplate, a bone V from the shoulders to the waist point, a reed-straw
+-- stomacher and a belt that ends at the body's sides, a flat collar and a small
+-- bustle; and the gown's upper skirt, a six-gored green bell around each thigh,
+-- lamed with long reed-straw tassets. The gores stop above the knee so the legs
+-- stride free, and the two legs' bells meet into one skirt standing.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's own tones: pale reed straw over the fen's deep green, cold bog
+-- iron, and the black of the water it is worn over.
+local reed = { 110, 108, 74 }
+local reedPale = { 138, 130, 98 }
+local green = { 56, 74, 60 }
+local greenDeep = { 38, 50, 42 }
+local greenSkirt = { 66, 88, 70 }
+local iron = { 100, 104, 112 }
+local ironDark = { 56, 60, 64 }
+
+-- One gore of the skirt: a flat panel laid on the cone about the leg. `angle`
+-- runs round from the front, `radius` and `y` place its middle, `phi` leans it
+-- out and `slant` is its length down the cone. The Euler angles turn the panel
+-- square on the cone (CFrame.Angles is X, then Y, then Z).
+local function gore(
+	on: ArmourLookTypes.BodyPart,
+	angle: number,
+	radius: number,
+	y: number,
+	phi: number,
+	slant: number,
+	width: number,
+	thickness: number,
+	material: string,
+	color: { number }
+): ArmourLookTypes.ArmourPart
+	local th, ph = math.rad(angle), math.rad(phi)
+	local a = math.atan2(math.sin(ph), math.cos(th) * math.cos(ph))
+	local b = math.asin(-math.sin(th) * math.cos(ph))
+	local cc = math.atan2(math.sin(th) * math.sin(ph), math.cos(th))
+	return Kit.box(
+		on,
+		{ width, slant, thickness },
+		{ radius * math.sin(th), y, -radius * math.cos(th) },
+		material,
+		color,
+		{ math.deg(a), math.deg(b), math.deg(cc) }
+	)
+end
+
+-- The thigh bell: six gores a leg, each wide enough to overlap its neighbours,
+-- so the ring has no gap.
+local THIGH_PHI = 15.68
+local THIGH_R = 0.74
+local THIGH_Y = 0.09
+local THIGH_SLANT = 1.184
+local LAME_PHI = 15.68
+local LAME_R = 0.809
+local LAME_Y = 0.09
+local LAME_SLANT = 1.101
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailValkyrieDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice, fitted under the plate.
+		Kit.box("UpperTorso", { 2.06, 1.62, 1.06 }, { 0, 0, 0 }, "Fabric", green),
+		-- The breastplate: a bright front, a dark lower rim and a reed cord
+		-- across the neckline; the back is darker iron. A bone V runs from the
+		-- shoulders to the waist point, so the bodice reads fitted and tapers.
+		Kit.box("UpperTorso", { 1.66, 1.06, 0.14 }, { 0, 0, -0.55 }, "Metal", iron),
+		Kit.box("UpperTorso", { 0.1, 1.59, 0.1 }, { -0.46, 0.07, -0.64 }, "Fabric", c.fenBone, { 0, 0, 35.3 }),
+		Kit.box("UpperTorso", { 0.1, 1.59, 0.1 }, { 0.46, 0.07, -0.64 }, "Fabric", c.fenBone, { 0, 0, -35.3 }),
+		Kit.box("UpperTorso", { 1.7, 0.1, 0.15 }, { 0, -0.48, -0.55 }, "Metal", ironDark),
+		Kit.box("UpperTorso", { 1.3, 0.1, 0.14 }, { 0, 0.6, -0.56 }, "Fabric", reed),
+		Kit.box("UpperTorso", { 1.5, 1.0, 0.12 }, { 0, 0, 0.55 }, "Metal", ironDark),
+		-- The collar: a flat green band at the neck's foot with a reed rim.
+		Kit.box("UpperTorso", { 0.94, 0.12, 0.96 }, { 0, 0.76, 0 }, "Fabric", green),
+		Kit.box("UpperTorso", { 0.96, 0.05, 0.98 }, { 0, 0.82, 0 }, "Fabric", reed),
+		-- The waist: a deep green cincher under a reed belt that ends at the
+		-- body's sides, with a bone toggle.
+		Kit.box("LowerTorso", { 2.08, 0.42, 1.06 }, { 0, 0, 0 }, "Fabric", green),
+		Kit.box("LowerTorso", { 2.1, 0.24, 1.08 }, { 0, 0.02, 0 }, "Fabric", greenDeep),
+		Kit.box("LowerTorso", { 2.12, 0.1, 1.1 }, { 0, -0.08, 0 }, "Fabric", reed),
+		Kit.box("LowerTorso", { 0.2, 0.18, 0.12 }, { 0.46, -0.08, -0.6 }, "Fabric", reedPale),
+		Kit.box("LowerTorso", { 0.14, 0.12, 0.14 }, { 0.46, -0.06, -0.63 }, "Fabric", c.fenBone),
+		-- A reed stomacher, laced over the waist with bone cord.
+		Kit.box("LowerTorso", { 0.7, 0.38, 0.08 }, { 0, 0.02, -0.58 }, "Fabric", reed),
+		Kit.box("LowerTorso", { 0.36, 0.06, 0.05 }, { 0, 0.04, -0.63 }, "Fabric", c.fenBone, { 0, 0, 26 }),
+		Kit.box("LowerTorso", { 0.36, 0.06, 0.05 }, { 0, 0.04, -0.63 }, "Fabric", c.fenBone, { 0, 0, -26 }),
+		-- A small bustle behind, low and wide.
+		Kit.box("LowerTorso", { 1.4, 0.26, 0.18 }, { 0, 0, 0.6 }, "Fabric", greenDeep),
+		-- Sleeves close to the upper arm, so the shoulders stay narrow.
+		Kit.box("UpperArm", { 1.04, 1.2, 1.04 }, { 0, 0, 0 }, "Fabric", green),
+		-- The upper skirt: six green gores a leg, making a full bell that widens
+		-- from the hip to the knee.
+		gore("UpperLeg", 0, THIGH_R, THIGH_Y, THIGH_PHI, THIGH_SLANT, 0.98, 0.08, "Fabric", greenSkirt),
+		gore("UpperLeg", 60, THIGH_R, THIGH_Y, THIGH_PHI, THIGH_SLANT, 0.98, 0.08, "Fabric", greenSkirt),
+		gore("UpperLeg", 120, THIGH_R, THIGH_Y, THIGH_PHI, THIGH_SLANT, 0.98, 0.08, "Fabric", greenSkirt),
+		gore("UpperLeg", 180, THIGH_R, THIGH_Y, THIGH_PHI, THIGH_SLANT, 0.98, 0.08, "Fabric", greenSkirt),
+		gore("UpperLeg", 240, THIGH_R, THIGH_Y, THIGH_PHI, THIGH_SLANT, 0.98, 0.08, "Fabric", greenSkirt),
+		gore("UpperLeg", 300, THIGH_R, THIGH_Y, THIGH_PHI, THIGH_SLANT, 0.98, 0.08, "Fabric", greenSkirt),
+		-- Long reed tassets over the gores, a little proud of the cloth, carried
+		-- right round the bell: front, outside, back and the back's centre.
+		gore("UpperLeg", 0, LAME_R, LAME_Y, LAME_PHI, LAME_SLANT, 0.42, 0.1, "Fabric", reed),
+		gore("UpperLeg", 60, LAME_R, LAME_Y, LAME_PHI, LAME_SLANT, 0.42, 0.1, "Fabric", reed),
+		gore("UpperLeg", 90, LAME_R, LAME_Y, LAME_PHI, LAME_SLANT, 0.42, 0.1, "Fabric", reed),
+		gore("UpperLeg", 120, LAME_R, LAME_Y, LAME_PHI, LAME_SLANT, 0.42, 0.1, "Fabric", reed),
+		gore("UpperLeg", 180, LAME_R, LAME_Y, LAME_PHI, LAME_SLANT, 0.42, 0.1, "Fabric", reed),
+	},
+}
+
+return look
