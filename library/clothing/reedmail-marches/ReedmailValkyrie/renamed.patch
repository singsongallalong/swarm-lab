+	local th, ph = math.rad(angle), math.rad(phi)
+	local a = math.atan2(math.sin(ph), math.cos(th) * math.cos(ph))
+	local b = math.asin(-math.sin(th) * math.cos(ph))
+	local cc = math.atan2(math.sin(th) * math.sin(ph), math.cos(th))
