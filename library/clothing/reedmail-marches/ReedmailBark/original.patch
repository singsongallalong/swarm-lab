+--!strict
+-- Reedmail sleeves (zone armour, the Reedmail set): the gown's sleeves. A
+-- deep fen-green under-sleeve, a full willow-bark bell gathered at the elbow
+-- with a bone thread along its lower edge, a reed tie at the forearm and a
+-- second willow cuff at the wrist over the black-water glove. The upper arm
+-- stays close; all the volume is at the elbow and cuff.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: pale willow-bark plates over the fen's deep green, with
+-- reed and bone for the ties and one scrubbed iron edge for the light.
+local bark = {
+	willow = { 122, 110, 82 },
+	fen = { 62, 82, 70 },
+	bogIronWorn = { 128, 132, 124 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The under-sleeve, close to the forearm.
+		Kit.box("LowerArm", { 1.06, 1.07, 1.06 }, { 0, 0, 0 }, "Fabric", bark.fen),
+		-- The bell at the elbow, with a bone thread along its lower edge.
+		Kit.box("LowerArm", { 1.36, 0.32, 1.36 }, { 0, 0.37, 0 }, "Leather", bark.willow),
+		Kit.box("LowerArm", { 1.38, 0.05, 1.38 }, { 0, 0.2, 0 }, "Leather", c.fenBone),
+		-- A reed tie at the forearm, and the cuff at the wrist.
+		Kit.box("LowerArm", { 1.1, 0.06, 1.1 }, { 0, 0.02, 0 }, "Fabric", c.reed),
+		Kit.box("LowerArm", { 1.24, 0.28, 1.24 }, { 0, -0.37, 0 }, "Leather", bark.willow),
+		Kit.box("LowerArm", { 1.28, 0.07, 1.28 }, { 0, -0.48, 0 }, "Metal", bark.bogIronWorn),
+		-- The black-water glove, tied with reed at the wrist.
+		Kit.box("Hand", { 1.04, 0.34, 1.04 }, { 0, 0, 0 }, "Leather", c.bogWet),
+		Kit.box("Hand", { 1.06, 0.06, 1.06 }, { 0, 0.06, 0 }, "Fabric", c.reed),
+	},
+}
+
+return look
