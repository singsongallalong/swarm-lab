+--!strict
+-- Reedmail helm (zone armour, the Reedmail set): the fen warden's coronal. A
+-- snug fen-green coif over the head, a broad willow-bark circlet with a bone
+-- thread and a bright iron ring above it, a pale bark fan swept up and back
+-- carrying three reed points, and a dark fen veil behind. It grows tall and
+-- back, never wide at the ears, so the head reads before the shoulders do.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: pale willow-bark plates over the fen's deep green and
+-- bog iron, with reed and bone for the light.
+local bark = {
+	willow = { 122, 110, 82 },
+	fen = { 62, 82, 70 },
+	fenDeep = { 42, 56, 48 },
+	bogIronWorn = { 128, 132, 124 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The coif drawn over the head, and the crown stacked over its brow.
+		Kit.box("Head", { 1.26, 1.24, 1.0 }, { 0, 0.02, 0.16 }, "Fabric", bark.fen),
+		Kit.box("Head", { 1.32, 0.2, 1.32 }, { 0, 0.28, 0 }, "Leather", bark.willow),
+		Kit.box("Head", { 1.36, 0.06, 1.36 }, { 0, 0.4, 0 }, "Leather", c.fenBone),
+		Kit.box("Head", { 1.32, 0.1, 1.32 }, { 0, 0.49, 0 }, "Metal", bark.bogIronWorn),
+		-- The bark fan swept up and back, and the reed points rising from it.
+		Kit.box("Head", { 0.72, 0.42, 0.12 }, { 0, 0.76, 0.28 }, "Leather", bark.willow, { 22, 0, 0 }),
+		Kit.box("Head", { 0.1, 0.46, 0.08 }, { 0, 1.0, 0.38 }, "Fabric", c.reed, { 16, 0, 0 }),
+		Kit.box("Head", { 0.08, 0.36, 0.06 }, { 0.24, 0.92, 0.36 }, "Fabric", c.reed, { 14, 0, 12 }),
+		Kit.box("Head", { 0.08, 0.36, 0.06 }, { -0.24, 0.92, 0.36 }, "Fabric", c.reed, { 14, 0, -12 }),
+		-- A bone plaque at the brow, and the veil falling from the circlet's back.
+		Kit.box("Head", { 0.42, 0.14, 0.1 }, { 0, 0.3, -0.68 }, "Leather", c.fenBone),
+		Kit.box("Head", { 1.0, 1.06, 0.06 }, { 0, -0.16, 0.7 }, "Fabric", bark.fenDeep),
+		-- A bone charm on a reed cord at the right temple.
+		Kit.box("Head", { 0.045, 0.26, 0.045 }, { 0.655, 0.14, -0.2 }, "Fabric", c.reed),
+		Kit.box("Head", { 0.1, 0.18, 0.08 }, { 0.655, -0.06, -0.2 }, "Leather", c.fenBone),
+	},
+}
+
+return look
