@@ -0,0 +1,88 @@
+--!strict
+-- Reedmail dress (zone armour, the Reedmail set): the fen warden's gown. A
+-- pale willow-bark cuirass that tapers from a wide bust into a narrow dark
+-- iron belt, with a fen-green stomacher and a bone sash. Below it a lamellar
+-- skirt hangs from the thighs in three bands, each wider and set further
+-- forward than the one above, over a deep fen under-skirt; the middle band
+-- and the side plates are fen green. The waist is the narrowest point and all
+-- the width is low, in the skirt.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: pale willow-bark plates over the fen's green, with bog
+-- iron at the waist and reed and bone for the ties.
+local bark = {
+	willow = { 122, 110, 82 },
+	willowDark = { 86, 76, 58 },
+	fen = { 62, 82, 70 },
+	fenDeep = { 42, 56, 48 },
+	bogIron = { 64, 68, 64 },
+}
+
+-- The skirt hangs from just above the thigh's top to just above the knee,
+-- where the boots' panels take it on down.
+local SKIRT_TOP = 0.75
+local SKIRT_LENGTH = 1.3
+local SKIRT_Y = SKIRT_TOP - SKIRT_LENGTH / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The cuirass: a wide bust tapering into a narrower waist, with a
+			-- green stomacher down the centre.
+			Kit.box("UpperTorso", { 2.14, 0.94, 1.12 }, { 0, 0.34, 0 }, "Leather", bark.willow),
+			Kit.box("UpperTorso", { 2.03, 0.7, 1.03 }, { 0, -0.47, 0 }, "Leather", bark.willow),
+			Kit.box("UpperTorso", { 0.72, 0.92, 0.08 }, { 0, 0.02, -0.565 }, "Fabric", bark.fen),
+			-- The standing green collar, with a bone clasp under the chin.
+			Kit.box("UpperTorso", { 0.86, 0.26, 1.04 }, { 0, 0.78, 0 }, "Fabric", bark.fenDeep),
+			Kit.box("UpperTorso", { 0.15, 0.14, 0.08 }, { 0, 0.78, -0.56 }, "Leather", c.fenBone),
+			-- The waist: a dark fen corset pinched by a narrow iron belt, with
+			-- a bone sash over it and a bone toggle off centre.
+			Kit.box("LowerTorso", { 2.02, 0.4, 1.02 }, { 0, 0, 0 }, "Fabric", bark.fenDeep),
+			Kit.box("LowerTorso", { 2.04, 0.16, 1.04 }, { 0, 0, 0 }, "Metal", bark.bogIron),
+			Kit.box("LowerTorso", { 2.05, 0.1, 1.05 }, { 0, 0.12, 0 }, "Leather", c.fenBone),
+			Kit.box("LowerTorso", { 0.16, 0.14, 0.1 }, { 0.4, 0.02, -0.56 }, "Leather", c.fenBone),
+			-- A darker bark bustle behind, filling the seat above the skirt.
+			Kit.box("LowerTorso", { 1.24, 0.32, 0.22 }, { 0, -0.03, 0.57 }, "Leather", bark.willowDark),
+			-- Fitted green sleeves, no wider than the arm.
+			Kit.box("UpperArm", { 1.02, 1.2, 1.02 }, { 0, 0, 0 }, "Fabric", bark.fen),
+		},
+		{
+			-- The under-skirt: deep fen cloth panels on each thigh, front and
+			-- back, meeting at the centre line.
+			Kit.box(
+				"UpperLeg",
+				{ 1.9, SKIRT_LENGTH, 0.06 },
+				{ 0.46, SKIRT_Y, -0.58 },
+				"Fabric",
+				bark.fenDeep,
+				{ 6, 0, 0 }
+			),
+			Kit.box(
+				"UpperLeg",
+				{ 1.9, SKIRT_LENGTH, 0.06 },
+				{ 0.46, SKIRT_Y, 0.58 },
+				"Fabric",
+				bark.fenDeep,
+				{ -6, 0, 0 }
+			),
+			-- The bark lames over the front: each wider and set further forward
+			-- than the one above, so the skirt cones out to the hem. The middle
+			-- band is fen green.
+			Kit.box("UpperLeg", { 1.34, 0.4, 0.1 }, { 0.18, 0.54, -0.62 }, "Leather", bark.willow, { 4, -6, 0 }),
+			Kit.box("UpperLeg", { 1.64, 0.4, 0.1 }, { 0.33, 0.1, -0.7 }, "Leather", bark.fen, { 8, -10, 0 }),
+			Kit.box("UpperLeg", { 1.98, 0.44, 0.1 }, { 0.49, -0.35, -0.79 }, "Leather", bark.willow, { 12, -12, 0 }),
+			-- The same three bands on the back, and a fen plate down each side.
+			Kit.box("UpperLeg", { 1.38, 0.4, 0.1 }, { 0.2, 0.52, 0.64 }, "Leather", bark.willow, { -4, 6, 0 }),
+			Kit.box("UpperLeg", { 1.68, 0.4, 0.1 }, { 0.34, 0.08, 0.72 }, "Leather", bark.fen, { -8, 10, 0 }),
+			Kit.box("UpperLeg", { 1.98, 0.44, 0.1 }, { 0.49, -0.36, 0.8 }, "Leather", bark.willow, { -12, 12, 0 }),
+			Kit.box("UpperLeg", { 0.12, SKIRT_LENGTH, 1.2 }, { 1.02, SKIRT_Y, 0 }, "Leather", bark.fen, { 0, 0, 18 }),
+		},
+	}),
+}
+
+return look
