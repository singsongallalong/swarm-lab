+--!strict
+-- Reedmail hem (zone armour, the Reedmail set): the gown's lower skirt. The
+-- upper skirt's dark fen panels carry on down each shin in two broad bands,
+-- each wider than the one above, so the bell keeps opening to the hem. The
+-- lower band is fen green with a pale bone trim along its edge; behind it the
+-- deep under-skirt shows, and a bone charm hangs at each outer hem. Below,
+-- the black-water ankle wrap and a blocky shoe with a willow toe.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: pale willow-bark plates and fen-green bands over the
+-- fen's deep green, with reed, bone and the black of the water at the hem.
+local bark = {
+	willow = { 122, 110, 82 },
+	fen = { 62, 82, 70 },
+	fenDeep = { 42, 56, 48 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailHem",
+	slot = "Boots",
+	parts = {
+		-- The boot under the skirt, soaked black at the ankle.
+		Kit.box("LowerLeg", { 1.06, 1.2, 1.06 }, { 0, 0, 0 }, "Leather", bark.fenDeep),
+		Kit.box("LowerLeg", { 1.08, 0.24, 1.08 }, { 0, -0.47, 0 }, "Leather", c.bogWet),
+		-- The under-skirt's lower panels, front and back, wide enough to fill
+		-- the seams and the knee between the two tiers with dark fen cloth.
+		Kit.box("LowerLeg", { 2.4, 1.24, 0.06 }, { 0.72, 0.06, -0.58 }, "Fabric", bark.fenDeep, { 5, 0, 0 }),
+		Kit.box("LowerLeg", { 2.4, 1.24, 0.06 }, { 0.72, 0.06, 0.58 }, "Fabric", bark.fenDeep, { -5, 0, 0 }),
+		-- Two bands down the front, the lower one wider and fen green: the
+		-- skirt's bottom tier, coned out toward the hem.
+		Kit.box("LowerLeg", { 2.18, 0.52, 0.1 }, { 0.585, 0.34, -0.7 }, "Leather", bark.willow, { 8, -12, 0 }),
+		Kit.box("LowerLeg", { 2.55, 0.5, 0.1 }, { 0.755, -0.2, -0.82 }, "Leather", bark.fen, { 12, -14, 0 }),
+		-- Two bands on the back, and a fen plate down each outer side.
+		Kit.box("LowerLeg", { 2.18, 0.52, 0.1 }, { 0.585, 0.32, 0.7 }, "Leather", bark.willow, { -8, 12, 0 }),
+		Kit.box("LowerLeg", { 2.55, 0.5, 0.1 }, { 0.755, -0.22, 0.82 }, "Leather", bark.fen, { -12, 14, 0 }),
+		Kit.box("LowerLeg", { 0.12, 1.2, 1.5 }, { 1.45, 0.06, 0 }, "Leather", bark.fen, { 0, 0, 20 }),
+		-- The pale bone trim along the hem's front and back edges.
+		Kit.box("LowerLeg", { 2.5, 0.1, 0.12 }, { 0.755, -0.42, -0.94 }, "Leather", c.fenBone, { 12, -14, 0 }),
+		Kit.box("LowerLeg", { 2.5, 0.1, 0.12 }, { 0.755, -0.42, 0.94 }, "Leather", c.fenBone, { -12, 14, 0 }),
+		-- The bone charm at the outer hem, on its reed cord.
+		Kit.box("LowerLeg", { 0.05, 0.3, 0.05 }, { 0.95, -0.44, -0.84 }, "Fabric", c.reed),
+		Kit.box("LowerLeg", { 0.1, 0.16, 0.08 }, { 0.95, -0.63, -0.84 }, "Leather", c.fenBone),
+		-- The black-water shoe, with a pale willow toe.
+		Kit.box("Foot", { 1.06, 0.32, 1.18 }, { 0, 0, -0.06 }, "Leather", c.bogWet),
+		Kit.box("Foot", { 0.98, 0.12, 0.36 }, { 0, 0.08, -0.6 }, "Leather", bark.willow),
+	},
+}
+
+return look
