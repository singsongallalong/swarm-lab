@@ -0,0 +1,30 @@
+--!strict
+-- The garrison's boots (the Fortwarden set): tall brown leather boots with the
+-- town's blue cuff and a cream line below the knee, and a steel toe cap whose
+-- scraped edge catches the moon.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: a heraldic blue, bluer than the linen set's faded
+-- indigo so the garrison reads as its own family, and a pale warm cream.
+local townBlue = { 56, 72, 108 }
+local cream = { 206, 196, 170 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenSergeantBoots",
+	slot = "Boots",
+	parts = {
+		-- The shaft, tall and soft, with the town's blue at its top.
+		Kit.box("LowerLeg", { 1.12, 0.96, 1.12 }, { 0, -0.08, 0 }, "Leather", c.leather),
+		Kit.box("LowerLeg", { 1.16, 0.22, 1.16 }, { 0, 0.41, 0 }, "Fabric", townBlue),
+		Kit.box("LowerLeg", { 1.14, 0.06, 1.14 }, { 0, 0.28, 0 }, "Fabric", cream),
+		-- The foot, dark leather, with a steel cap jutting over the toe.
+		Kit.box("Foot", { 1.08, 0.38, 1.16 }, { 0, 0, -0.04 }, "Leather", c.leatherDark),
+		Kit.box("Foot", { 1.04, 0.3, 0.34 }, { 0, -0.03, -0.52 }, "Metal", c.iron),
+		Kit.box("Foot", { 1.04, 0.06, 0.36 }, { 0, 0.13, -0.52 }, "Metal", c.ironWorn),
+	},
+}
+
+return look
