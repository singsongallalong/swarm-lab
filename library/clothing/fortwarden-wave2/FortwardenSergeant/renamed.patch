+--!strict
+-- The tower sergeant's kettle hat (the Fortwarden set): a wide steel brim
+-- that reads as a disc from the high camera, a square crown painted with the
+-- town's blue and a cream cross on its lid, a brass badge at the brow and
+-- mail hanging round the sides and back of the head with the face left open.
+-- The brim's scraped edge catches the moon; a rust scuff sits off centre.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: a heraldic blue, bluer than the linen set's faded
+-- indigo so the garrison reads as its own family, a pale warm cream, and a
+-- brass kept bright enough to read as a badge at the high camera.
+local townBlue = { 56, 72, 108 }
+local cream = { 206, 196, 170 }
+local brassBadge = { 138, 120, 82 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenSergeantHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The brim: a wide disc, its edge scraped bright where it takes knocks.
+		{
+			on = "Head",
+			shape = "Cylinder",
+			size = { 1.88, 0.13, 1.88 },
+			at = { 0, 0.1, 0 },
+			material = "Metal",
+			color = c.ironDark,
+		},
+		{
+			on = "Head",
+			shape = "Cylinder",
+			size = { 1.94, 0.05, 1.94 },
+			at = { 0, 0.1, 0 },
+			material = "Metal",
+			color = c.ironWorn,
+		},
+		-- The crown, square so it covers the head's corners and tall enough
+		-- that the outline reads as a garrison cap from the front.
+		Kit.box("Head", { 1.36, 0.72, 1.36 }, { 0, 0.51, 0 }, "Metal", c.iron),
+		-- The town's blue lid, crossed in cream.
+		Kit.box("Head", { 1.3, 0.06, 1.3 }, { 0, 0.88, 0 }, "Fabric", townBlue),
+		Kit.box("Head", { 0.18, 0.05, 1.24 }, { 0, 0.92, 0 }, "Fabric", cream),
+		Kit.box("Head", { 1.24, 0.05, 0.18 }, { 0, 0.93, 0 }, "Fabric", cream),
+		-- A blue band round the crown's base, and the sergeant's tower badge
+		-- on the front, big enough to read at shoulder distance.
+		Kit.box("Head", { 1.4, 0.18, 1.4 }, { 0, 0.34, 0 }, "Fabric", townBlue),
+		Kit.box("Head", { 0.4, 0.4, 0.06 }, { 0, 0.48, -0.7 }, "Metal", brassBadge),
+		Kit.box("Head", { 0.28, 0.12, 0.06 }, { 0, 0.74, -0.7 }, "Metal", brassBadge),
+		-- Mail hanging round the sides and back of the head, the face open.
+		Kit.box("Head", { 0.12, 0.46, 1 }, { 0.64, -0.28, 0.03 }, "Metal", c.mail),
+		Kit.box("Head", { 1.28, 0.46, 0.12 }, { 0, -0.28, 0.62 }, "Metal", c.mail),
+		-- A rust scuff where the brim has been knocked, off centre.
+		Kit.box("Head", { 0.26, 0.04, 0.18 }, { -0.78, 0.17, -0.25 }, "Metal", c.rust),
+	},
+}
+
+return look
