@@ -0,0 +1,64 @@
+--!strict
+-- The garrison surcoat (the Fortwarden set): the town's blue-and-cream
+-- quartered surcoat over a mail hauberk, belted in brown leather with a brass
+-- buckle, a brass tower badge at the chest, and stepped steel pauldrons. The
+-- quartering is the family read, on front and back both, so the high camera
+-- sees blue and cream before it sees any mail or strap. Worn: a torn corner
+-- shows the mail beneath and the back has rubbed faded.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: a heraldic blue, bluer than the linen set's faded
+-- indigo so the garrison reads as its own family, a pale warm cream, and a
+-- brass kept bright enough to read as a badge at the high camera.
+local townBlue = { 56, 72, 108 }
+local townBlueDark = { 42, 56, 84 }
+local cream = { 206, 196, 170 }
+local brassBadge = { 138, 120, 82 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenSergeantChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The surcoat's tails hang from the thighs, so they swing with the legs.
+		Kit.flaps(0.52, "Fabric", townBlue),
+		{
+			-- Mail under the cloth: the body and short sleeves.
+			Kit.box("UpperTorso", { 2.14, 1.64, 1.12 }, { 0, 0, 0 }, "Metal", c.mail),
+			Kit.box("UpperArm", { 1.08, 1, 1.08 }, { 0, -0.06, 0 }, "Metal", c.mail),
+			-- The surcoat: a blue field front and back, the two opposite
+			-- quarters of each face in heraldic cream.
+			Kit.box("UpperTorso", { 2.16, 1.52, 0.06 }, { 0, 0.02, -0.57 }, "Fabric", townBlue),
+			Kit.box("UpperTorso", { 1.02, 0.72, 0.05 }, { -0.53, 0.4, -0.615 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 1.02, 0.72, 0.05 }, { 0.53, -0.34, -0.615 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 2.16, 1.52, 0.06 }, { 0, 0.02, 0.57 }, "Fabric", townBlue),
+			Kit.box("UpperTorso", { 1.02, 0.72, 0.05 }, { 0.53, 0.4, 0.615 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 1.02, 0.72, 0.05 }, { -0.53, -0.34, 0.615 }, "Fabric", cream),
+			-- The surcoat's skirt round the hips, with a cream hem.
+			Kit.box("LowerTorso", { 2.18, 0.46, 1.16 }, { 0, 0, 0 }, "Fabric", townBlue),
+			Kit.box("LowerTorso", { 2.2, 0.07, 1.18 }, { 0, -0.2, 0 }, "Fabric", cream),
+			-- Brown leather belt, a broad brass buckle set off centre.
+			Kit.box("LowerTorso", { 2.24, 0.16, 1.22 }, { 0, 0.08, 0 }, "Leather", c.leatherDark),
+			Kit.box("LowerTorso", { 0.34, 0.26, 0.07 }, { 0.32, 0.08, -0.635 }, "Metal", brassBadge),
+			-- Dark steel pauldrons, two stepped lames, narrowed so they don't
+			-- echo iron's broad grey shoulders; a thin scraped rim along the
+			-- outer edge is the only bright steel, so the heraldry leads.
+			Kit.box("UpperArm", { 1.2, 0.2, 1.2 }, { 0.08, 0.6, 0 }, "Metal", c.ironDark, { 0, 0, -12 }),
+			Kit.box("UpperArm", { 1.1, 0.16, 1.1 }, { 0.14, 0.38, 0 }, "Metal", c.ironDark, { 0, 0, -18 }),
+			Kit.box("UpperArm", { 0.16, 0.05, 1.22 }, { 0.56, 0.71, 0 }, "Metal", c.ironWorn, { 0, 0, -12 }),
+			-- A cream collar standing at the neck.
+			Kit.box("UpperTorso", { 1.36, 0.2, 1.16 }, { 0, 0.86, 0 }, "Fabric", cream),
+			-- The tower badge, brass, on the blue.
+			Kit.box("UpperTorso", { 0.3, 0.32, 0.06 }, { 0, 0.36, -0.64 }, "Metal", brassBadge),
+			Kit.box("UpperTorso", { 0.2, 0.1, 0.06 }, { 0, 0.56, -0.64 }, "Metal", brassBadge),
+			-- Worn: a torn corner of the surcoat showing the mail beneath,
+			-- and a faded patch rubbed on the back.
+			Kit.box("UpperTorso", { 0.28, 0.32, 0.03 }, { -0.78, -0.54, -0.645 }, "Metal", c.mail, { 0, 0, 14 }),
+			Kit.box("UpperTorso", { 0.42, 0.26, 0.04 }, { 0.66, -0.3, 0.64 }, "Fabric", townBlueDark, { 0, 0, -8 }),
+		},
+	}),
+}
+
+return look
