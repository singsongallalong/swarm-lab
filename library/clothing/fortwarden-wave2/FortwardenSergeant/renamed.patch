+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenSergeantGloves",
+	slot = "Gloves",
+	parts = {
+		-- The vambrace, plain steel, with a scraped rim at the wrist.
+		Kit.box("LowerArm", { 1.12, 0.88, 1.12 }, { 0, -0.08, 0 }, "Metal", c.iron),
+		Kit.box("LowerArm", { 1.16, 0.09, 1.16 }, { 0, -0.37, 0 }, "Metal", c.ironWorn),
+		-- The town's blue cuff, a cream line beneath it.
+		Kit.box("LowerArm", { 1.18, 0.24, 1.18 }, { 0, 0.45, 0 }, "Fabric", townBlue),
+		Kit.box("LowerArm", { 1.16, 0.06, 1.16 }, { 0, 0.31, 0 }, "Fabric", cream),
+		-- The gauntlet itself, with a bright knuckle ridge.
+		Kit.box("Hand", { 1.07, 0.38, 1.07 }, { 0, 0, 0 }, "Metal", c.iron),
+		Kit.box("Hand", { 1.09, 0.12, 0.3 }, { 0, 0.1, -0.52 }, "Metal", c.ironWorn),
+	},
+}
+
+return look
