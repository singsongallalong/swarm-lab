@@ -0,0 +1,69 @@
+--!strict
+-- The Fortwarden chest: a town-blue quilted jack cut short like a militia
+-- coat, a cream sash across it with a brass badge, a leather belt and pouch.
+-- Steel pauldrons striped with cream give the broad shoulder line and blue
+-- cloth skirt flaps hang from the thighs, so the set reads blue and cream
+-- from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: a faded garrison blue, its shadow, and a worn cream.
+local townBlue = { 56, 74, 100 }
+local townBlueDark = { 42, 56, 78 }
+local cream = { 134, 124, 100 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The quilted jack, its seams darker where the padding dips.
+		{
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.06 }, { 0, 0, 0 }, "Fabric", townBlue),
+			Kit.box("UpperTorso", { 1.9, 0.08, 0.06 }, { 0, 0.5, -0.55 }, "Fabric", townBlueDark),
+			Kit.box("UpperTorso", { 1.9, 0.08, 0.06 }, { 0, -0.28, -0.55 }, "Fabric", townBlueDark),
+		},
+		-- The cream sash over the right shoulder, the brass badge on its chest.
+		{
+			Kit.box("UpperTorso", { 0.4, 1.64, 1.1 }, { 0, 0, 0 }, "Fabric", cream, { 0, 0, -32 }),
+			Kit.box("UpperTorso", { 0.24, 0.24, 0.1 }, { 0.12, 0.1, -0.59 }, "Metal", c.brass),
+		},
+		-- A cream neckline band, and a leather patch where the pack rubs.
+		{
+			Kit.box("UpperTorso", { 2.12, 0.14, 1.1 }, { 0, 0.74, 0 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 0.42, 0.36, 0.06 }, { -0.35, 0.35, 0.55 }, "Leather", c.leatherScuff, { 0, 0, 6 }),
+		},
+		-- Sleeves, and a real spaulder line: a steel cap over a steel wing on
+		-- the outer arm, the cap striped with cream to read from the high camera.
+		{
+			Kit.box("UpperArm", { 1.08, 1.16, 1.08 }, { 0, -0.02, 0 }, "Fabric", townBlue),
+			Kit.box("UpperArm", { 1.24, 0.26, 1.26 }, { 0, 0.56, 0 }, "Metal", c.iron),
+			Kit.box("UpperArm", { 0.22, 0.3, 1.12 }, { 0.6, 0.38, 0 }, "Metal", c.iron),
+			Kit.box("UpperArm", { 0.18, 0.1, 1.26 }, { 0.3, 0.74, 0 }, "Fabric", cream),
+		},
+		-- The short skirt of the jack, and a cream hem on its front.
+		Kit.flaps(0.5, "Fabric", townBlueDark),
+		{
+			Kit.box("UpperLeg", { 0.74, 0.07, 0.08 }, { 0.08, 0.28, -0.58 }, "Fabric", cream, { 4, 0, 0 }),
+			-- The sash's end, hung from the left thigh so it swings with the leg.
+			Kit.box("UpperLeg", { 0.14, 0.46, 0.1 }, { 0.58, 0.42, -0.54 }, "Fabric", cream, { 6, 0, 0 }, "Left"),
+		},
+		-- The belt, its brass buckle off centre, and a pouch on the left hip.
+		{
+			Kit.box("LowerTorso", { 2.1, 0.44, 1.08 }, { 0, 0, 0 }, "Fabric", townBlueDark),
+			Kit.box("LowerTorso", { 2.14, 0.18, 1.12 }, { 0, 0, 0 }, "Leather", c.leatherDark),
+			Kit.box("LowerTorso", { 0.26, 0.24, 0.1 }, { 0.3, 0, -0.58 }, "Metal", c.brass),
+			Kit.box(
+				"LowerTorso",
+				{ 0.34, 0.3, 0.18 },
+				{ -0.76, -0.04, -0.54 },
+				"Leather",
+				c.leatherScuff,
+				{ 0, 18, 0 }
+			),
+		},
+	}),
+}
+
+return look
