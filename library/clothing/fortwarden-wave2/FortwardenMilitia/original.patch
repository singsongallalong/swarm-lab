+--!strict
+-- The Fortwarden helm: the garrison's steel kettle hat. A broad steel brim
+-- with a bright lip, a town-blue band and a brass plate at the brow, and a
+-- cream crest over the crown. The wide brim and blue band are the set's
+-- signature from the high camera; the steel nasal and blue nape cloth keep
+-- the honest soldier under it.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: a faded garrison blue and a worn cream, kept dark
+-- enough for the night. Steel and brass come from Kit.
+local townBlue = { 56, 74, 100 }
+local cream = { 134, 124, 100 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The kettle crown: a steel bowl with a stepped top, sat on the brim.
+		Kit.box("Head", { 1.34, 0.44, 1.34 }, { 0, 0.34, 0 }, "Metal", c.iron),
+		Kit.box("Head", { 1.16, 0.18, 1.16 }, { 0, 0.62, 0 }, "Metal", c.iron),
+		-- The brim, a step wider than the old cap, with a bright lip at its edge.
+		Kit.box("Head", { 2, 0.12, 2 }, { 0, 0.06, 0 }, "Metal", c.iron),
+		Kit.box("Head", { 2.06, 0.06, 2.06 }, { 0, 0, 0 }, "Metal", c.ironWorn),
+		-- The town's blue band round the crown, and the brass plate on its brow.
+		Kit.box("Head", { 1.42, 0.22, 1.42 }, { 0, 0.24, 0 }, "Fabric", townBlue),
+		Kit.box("Head", { 0.4, 0.2, 0.12 }, { 0, 0.24, -0.73 }, "Metal", c.brass),
+		-- The cream crest running front to back over the crown.
+		Kit.box("Head", { 0.16, 0.3, 1.16 }, { 0, 0.82, 0 }, "Fabric", cream),
+		-- A blue cloth at the nape, a steel nasal over the brow.
+		Kit.box("Head", { 1.06, 0.46, 0.18 }, { 0, -0.26, 0.62 }, "Fabric", townBlue, { 10, 0, 0 }),
+		Kit.box("Head", { 0.1, 0.42, 0.08 }, { 0, -0.14, -0.68 }, "Metal", c.ironWorn),
+		-- A dent knocked into the right of the brim.
+		Kit.box("Head", { 0.3, 0.1, 0.18 }, { 0.6, 0.08, -0.5 }, "Metal", c.ironDark),
+	},
+}
+
+return look
