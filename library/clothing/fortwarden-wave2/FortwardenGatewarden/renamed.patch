@@ -0,0 +1,68 @@
+--!strict
+-- The Gatewarden chest (the Fortwarden set): the town's quilted blue gambeson,
+-- creamed at the collar, under broad steel pauldrons squared across the
+-- shoulders, with a big brass tower badge on a cream roundel at the chest, a
+-- leather belt and blue skirt flaps.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: garrison blue, the cream of its badge and its brass.
+local townBlue = { 55, 72, 100 }
+local townBlueDark = { 42, 54, 76 }
+local townBluePale = { 70, 88, 118 }
+local cream = { 182, 170, 138 }
+local badgeBrass = { 154, 130, 84 }
+
+-- The badge's roundel: a flat disc with its axis along Z.
+local function disc(size: { number }, at: { number }, material: string, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "UpperTorso",
+		shape = "Cylinder",
+		size = size,
+		at = at,
+		turn = { 90, 0, 0 },
+		material = material,
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenGatewardenChest",
+	slot = "Chest",
+	parts = Kit.join({
+		Kit.flaps(0.55, "Fabric", townBlueDark),
+		{
+			-- The gambeson, quilted in ridges front and back.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", townBlue),
+			Kit.box("LowerTorso", { 2.1, 0.44, 1.08 }, { 0, 0, 0 }, "Fabric", townBlue),
+			Kit.box("UpperTorso", { 1.96, 0.12, 0.1 }, { 0, 0.5, -0.56 }, "Fabric", townBluePale),
+			Kit.box("UpperTorso", { 1.96, 0.12, 0.1 }, { 0, 0.18, -0.56 }, "Fabric", townBluePale),
+			Kit.box("UpperTorso", { 1.96, 0.12, 0.1 }, { 0, 0.5, 0.56 }, "Fabric", townBluePale),
+			-- Cream across the collar, the steel gorget above it.
+			Kit.box("UpperTorso", { 2.14, 0.14, 1.14 }, { 0, 0.74, 0 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 1.04, 0.2, 1.04 }, { 0, 0.78, 0 }, "Metal", c.iron),
+			-- The badge: a cream roundel and a brass tower with three merlons.
+			disc({ 1.0, 0.08, 1.0 }, { 0, 0.16, -0.57 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 0.56, 0.56, 0.06 }, { 0, 0.09, -0.63 }, "Metal", badgeBrass),
+			Kit.box("UpperTorso", { 0.14, 0.18, 0.06 }, { -0.19, 0.46, -0.63 }, "Metal", badgeBrass),
+			Kit.box("UpperTorso", { 0.14, 0.18, 0.06 }, { 0, 0.46, -0.63 }, "Metal", badgeBrass),
+			Kit.box("UpperTorso", { 0.14, 0.18, 0.06 }, { 0.19, 0.46, -0.63 }, "Metal", badgeBrass),
+			-- The belt and its off-centre buckle.
+			Kit.box("LowerTorso", { 2.16, 0.18, 1.14 }, { 0, 0.02, 0 }, "Leather", c.leather),
+			Kit.box("LowerTorso", { 0.24, 0.22, 0.08 }, { -0.26, 0.02, -0.6 }, "Metal", badgeBrass),
+			-- The sleeves, and the pauldrons over them with a cream painted stripe.
+			Kit.box("UpperArm", { 1.08, 1.2, 1.08 }, { 0, 0, 0 }, "Fabric", townBlue),
+			Kit.box("UpperArm", { 1.32, 0.22, 1.26 }, { 0.05, 0.6, 0 }, "Metal", c.iron, { 0, 0, -6 }),
+			Kit.box("UpperArm", { 1.24, 0.18, 1.2 }, { 0.04, 0.4, 0 }, "Metal", c.ironDark, { 0, 0, -4 }),
+			Kit.box("UpperArm", { 1.28, 0.06, 0.34 }, { 0.05, 0.73, -0.3 }, "Fabric", cream, { 0, 0, -6 }),
+			Kit.box("UpperArm", { 0.3, 0.12, 0.07 }, { 0.46, 0.56, -0.65 }, "Metal", c.rust, { 0, 0, 8 }, "Right"),
+			-- A cream stripe down the back, and a frayed patch showing padding.
+			Kit.box("UpperTorso", { 0.36, 1.3, 0.08 }, { 0, 0.1, 0.56 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 0.3, 0.22, 0.06 }, { 0.66, -0.42, -0.56 }, "Fabric", c.linen, { 0, 0, -8 }),
+		},
+	}),
+}
+
+return look
