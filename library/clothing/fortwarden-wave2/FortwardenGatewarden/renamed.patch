+--!strict
+-- The Gatewarden great helm (the Fortwarden set, the fort's garrison): a
+-- flat-topped steel bucket closed to the jaw, a brass brow over a dark eye
+-- slit crossed by a bright nasal bar, the town's blue round its base and a thin
+-- stepped crest in blue and cream running fore-and-aft over the crown, brass
+-- mounted. The crest is a stripe from the high camera and a silhouette in profile.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: garrison blue, the cream of its badge and its brass.
+local townBlue = { 55, 72, 100 }
+local cream = { 182, 170, 138 }
+local badgeBrass = { 154, 130, 84 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenGatewardenHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The barrel, the bright rim and the brass crest mount.
+		Kit.box("Head", { 1.32, 1.04, 1.32 }, { 0, 0.04, 0 }, "Metal", c.iron),
+		Kit.box("Head", { 1.4, 0.14, 1.4 }, { 0, 0.58, 0 }, "Metal", c.ironWorn),
+		Kit.box("Head", { 0.24, 0.14, 1.1 }, { 0, 0.67, 0.02 }, "Metal", badgeBrass),
+		-- The face: a dark eye slit crossed by a bright nasal bar, a brass brow above.
+		Kit.box("Head", { 1.26, 0.18, 0.1 }, { 0, 0.24, -0.68 }, "Metal", c.ironDark),
+		Kit.box("Head", { 0.16, 0.92, 0.1 }, { 0, 0.04, -0.71 }, "Metal", c.ironWorn),
+		Kit.box("Head", { 1.34, 0.12, 0.1 }, { 0, 0.48, -0.69 }, "Metal", badgeBrass),
+		-- The town's blue round the base, a little askew.
+		Kit.box("Head", { 1.4, 0.3, 1.4 }, { 0, -0.4, 0 }, "Fabric", townBlue, { 0, 0, 2 }),
+		-- The crest: thin, stepped, blue and cream, running fore-and-aft.
+		Kit.box("Head", { 0.2, 0.5, 0.7 }, { 0, 0.95, -0.02 }, "Fabric", townBlue, { 10, 0, 0 }),
+		Kit.box("Head", { 0.19, 0.5, 0.62 }, { 0, 1.28, 0.18 }, "Fabric", cream, { 28, 0, 0 }),
+		Kit.box("Head", { 0.18, 0.46, 0.55 }, { 0, 1.52, 0.46 }, "Fabric", townBlue, { 55, 0, 0 }),
+		-- A dent rusting above the left eye.
+		Kit.box("Head", { 0.24, 0.16, 0.07 }, { -0.4, 0.06, -0.67 }, "Metal", c.rust, { 0, 0, 12 }),
+	},
+}
+
+return look
