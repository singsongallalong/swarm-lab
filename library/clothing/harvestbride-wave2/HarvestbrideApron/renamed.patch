+-- widest point. The gold front shows below the knee-length linen apron (in the
+-- Dress look); a dark-gold embroidered band rings the hem and a field-green
+-- petticoat peeks out below it. Dark walnut shoes show at the toes.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The bride's cloth. The skirt takes the zone's wheat gold, a shade darker
+-- than the straw of the wreath so it reads as cloth at the high camera.
+local wheatCloth = { 146, 116, 62 }
+local wheatDim = { 122, 94, 50 }
+local field = { 86, 100, 64 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "HarvestbrideApronHem",
+	slot = "Boots",
+	parts = {
+		-- The middle tier: front, back and outer side on each shin, rising past
+		-- the knee to meet the upper skirt.
+		Kit.box("LowerLeg", { 1.75, 0.72, 0.06 }, { 0.375, 0.26, -0.60 }, "Fabric", wheatCloth, { 10, 0, 0 }),
+		Kit.box("LowerLeg", { 1.75, 0.72, 0.06 }, { 0.375, 0.26, 0.60 }, "Fabric", wheatCloth, { -10, 0, 0 }),
+		Kit.box("LowerLeg", { 0.12, 0.72, 1.60 }, { 1.20, 0.26, 0 }, "Fabric", wheatCloth, { 0, 0, 4 }),
+		-- The bottom tier, wider again, carrying the hem.
+		Kit.box("LowerLeg", { 2.00, 0.60, 0.06 }, { 0.50, -0.26, -0.63 }, "Fabric", wheatCloth, { 10, 0, 0 }),
+		Kit.box("LowerLeg", { 2.00, 0.60, 0.06 }, { 0.50, -0.26, 0.63 }, "Fabric", wheatCloth, { -10, 0, 0 }),
+		Kit.box("LowerLeg", { 0.14, 0.60, 1.75 }, { 1.44, -0.26, 0 }, "Fabric", wheatCloth, { 0, 0, 4 }),
+		-- A wheat-gold gusset inside the skirt at the knee, filling the joint
+		-- between the bodice's skirt and the middle tier.
+		Kit.box("LowerLeg", { 1.40, 0.44, 1.30 }, { 0.20, 0.68, 0 }, "Fabric", wheatCloth),
+		-- The dark-gold embroidered hem and the green petticoat below it.
+		Kit.box("LowerLeg", { 2.03, 0.05, 1.55 }, { 0.515, -0.47, 0 }, "Fabric", wheatDim),
+		Kit.box("LowerLeg", { 2.02, 0.10, 1.56 }, { 0.51, -0.55, 0 }, "Fabric", field),
+		-- Dark walnut shoes, a lighter worn toe showing under the hem.
+		Kit.box("Foot", { 1.06, 0.34, 1.24 }, { 0, 0.02, -0.06 }, "Leather", c.leatherDark),
+		Kit.box("Foot", { 0.98, 0.22, 0.36 }, { 0, 0.02, -0.50 }, "Leather", c.leather),
+		Kit.box("Foot", { 1.08, 0.07, 1.26 }, { 0, -0.16, -0.06 }, "Leather", c.leatherDark),
+	},
+}
+
+return look
