+--!strict
+-- The Harvestbride's chest: a fitted cream bodice over a paler linen
+-- stomacher, a wide hearth-red sash at the narrow waist with its ends hanging
+-- at one hip, sleeves close to the upper arm, and the wheat-gold upper skirt
+-- hung from the thighs under a pale linen apron, set wide so standing the two
+-- legs' panels meet as one tier.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The bride's cloth. The skirt takes the zone's wheat gold, a shade darker
+-- than the straw of the wreath so it reads as cloth at the high camera.
+local cream = { 182, 170, 148 }
+local wheatCloth = { 146, 116, 62 }
+local linen = { 200, 192, 174 }
+local wheat = { 168, 132, 70 }
+local hearth = { 126, 50, 44 }
+local hearthDim = { 92, 40, 38 }
+
+-- How far the upper skirt runs down the thigh from the belt line.
+local SKIRT = 1.22
+local SKIRT_Y = 0.75 - SKIRT / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "HarvestbrideApronDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice, with a pale stomacher down the front, a gold seam and a
+		-- red lace crossing it.
+		Kit.box("UpperTorso", { 2.08, 1.72, 1.08 }, { 0, 0, 0 }, "Fabric", cream),
+		Kit.box("UpperTorso", { 1.12, 0.14, 1.12 }, { 0, 0.82, 0 }, "Fabric", linen),
+		Kit.box("UpperTorso", { 1.12, 0.05, 1.12 }, { 0, 0.74, 0 }, "Fabric", hearth),
+		Kit.box("UpperTorso", { 0.72, 1.24, 0.05 }, { 0, 0.04, -0.555 }, "Fabric", linen),
+		Kit.box("UpperTorso", { 0.06, 1.10, 0.04 }, { 0, 0.06, -0.585 }, "Fabric", wheat),
+		Kit.box("UpperTorso", { 0.66, 0.05, 0.04 }, { 0, 0.30, -0.59 }, "Fabric", hearth, { 0, 0, 18 }),
+		Kit.box("UpperTorso", { 0.66, 0.05, 0.04 }, { 0, 0.30, -0.59 }, "Fabric", hearth, { 0, 0, -18 }),
+		-- A laced back.
+		Kit.box("UpperTorso", { 0.62, 0.05, 0.04 }, { 0, 0.24, 0.56 }, "Fabric", hearth, { 0, 0, 20 }),
+		Kit.box("UpperTorso", { 0.62, 0.05, 0.04 }, { 0, 0.24, 0.56 }, "Fabric", hearth, { 0, 0, -20 }),
+		-- A wide sash at the waist, its dark lower edge and a brass pin; its
+		-- ends hang from the right hip only.
+		Kit.box("LowerTorso", { 2.16, 0.26, 1.24 }, { 0, 0.02, 0 }, "Fabric", hearth),
+		Kit.box("LowerTorso", { 2.18, 0.05, 1.26 }, { 0, -0.13, 0 }, "Fabric", hearthDim),
+		Kit.box("LowerTorso", { 0.16, 0.16, 0.07 }, { 0, 0.02, -0.65 }, "Metal", c.brass, { 0, 0, 45 }),
+		Kit.box("UpperLeg", { 0.09, 0.52, 0.04 }, { 0.18, 0.46, -0.675 }, "Fabric", hearth, { 8, 0, 0 }, "Right"),
+		Kit.box("UpperLeg", { 0.09, 0.44, 0.04 }, { 0.34, 0.50, -0.675 }, "Fabric", hearthDim, { 8, 0, 6 }, "Right"),
+		-- The sleeve: close to the upper arm, the small cuff left to the Sleeves look.
+		Kit.box("UpperArm", { 1.02, 1.20, 1.02 }, { 0, 0, 0 }, "Fabric", cream),
+		-- The wheat-gold upper skirt, four panels on each thigh: front, back,
+		-- outer side and the linen apron half over the front.
+		Kit.box("UpperLeg", { 1.40, SKIRT, 0.06 }, { 0.20, SKIRT_Y, -0.58 }, "Fabric", wheatCloth, { 8, 0, 0 }),
+		Kit.box("UpperLeg", { 1.40, SKIRT, 0.06 }, { 0.20, SKIRT_Y, 0.58 }, "Fabric", wheatCloth, { -8, 0, 0 }),
+		Kit.box("UpperLeg", { 0.10, SKIRT, 1.45 }, { 0.86, SKIRT_Y, 0 }, "Fabric", wheatCloth, { 0, 0, 4 }),
+		Kit.box("UpperLeg", { 0.90, 0.97, 0.05 }, { -0.05, 0.035, -0.64 }, "Fabric", linen, { 8, 0, 0 }),
+		-- The apron ends above the knee and is finished with a red hem band,
+		-- held clear in front of the apron.
+		Kit.box("UpperLeg", { 0.90, 0.07, 0.05 }, { -0.05, -0.43, -0.735 }, "Fabric", hearth, { 8, 0, 0 }),
+	},
+}
