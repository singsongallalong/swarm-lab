+--!strict
+-- The Harvestbride's headpiece: a thick wreath of wheat straw and field
+-- leaves round the crown, full cloth flowers, two wheat ears rising above the
+-- head, a red ribbon tied at the back and a short pale linen veil. It sits
+-- high and reaches back, never wide at the ears, so the outline stays a
+-- bride's and not a helm's.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The bride's cloth, warmer and paler than the cloth caster's oatmeal, so the
+-- set reads as its own family at the high camera.
+local wheat = { 168, 132, 70 }
+local wheatDim = { 128, 98, 54 }
+local hearth = { 126, 50, 44 }
+local hearthDim = { 92, 40, 38 }
+local linen = { 200, 192, 174 }
+local field = { 86, 100, 64 }
+local fieldDim = { 62, 76, 48 }
+
+-- A cloth flower: a small ball set on the straw.
+local function bloom(x: number, y: number, z: number, size: number, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "Head",
+		shape = "Ball",
+		size = { size, size, size },
+		at = { x, y, z },
+		material = "Fabric",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "HarvestbrideApronHelm",
+	slot = "Helm",
+	parts = {
+		-- The wreath: a thick band of straw round the crown, open at the top so
+		-- the head shows through the ring.
+		Kit.box("Head", { 1.28, 0.18, 0.14 }, { 0, 0.52, -0.57 }, "Fabric", wheat),
+		Kit.box("Head", { 1.28, 0.18, 0.14 }, { 0, 0.52, 0.57 }, "Fabric", wheatDim),
+		Kit.box("Head", { 0.14, 0.18, 1.00 }, { 0.57, 0.52, 0 }, "Fabric", wheat),
+		Kit.box("Head", { 0.14, 0.18, 1.00 }, { -0.57, 0.52, 0 }, "Fabric", wheat),
+		-- Field leaves rising from the straw.
+		Kit.box("Head", { 0.32, 0.12, 0.12 }, { -0.34, 0.64, -0.58 }, "Fabric", field, { 0, 0, 24 }),
+		Kit.box("Head", { 0.32, 0.12, 0.12 }, { 0.34, 0.64, -0.58 }, "Fabric", field, { 0, 0, -24 }),
+		Kit.box("Head", { 0.12, 0.12, 0.32 }, { -0.58, 0.62, -0.10 }, "Fabric", fieldDim, { 18, 0, 0 }),
+		Kit.box("Head", { 0.12, 0.12, 0.32 }, { 0.58, 0.62, -0.10 }, "Fabric", field, { -18, 0, 0 }),
+		-- Cloth flowers, pale and red, set on the straw.
+		bloom(-0.26, 0.66, -0.62, 0.22, linen),
+		bloom(0.26, 0.66, -0.62, 0.22, linen),
+		bloom(0, 0.70, -0.64, 0.24, hearth),
+		bloom(-0.58, 0.64, -0.16, 0.20, hearth),
+		bloom(0.58, 0.64, -0.16, 0.20, linen),
+		-- Two fat wheat ears standing above the crown, for height from the high camera.
+		Kit.box("Head", { 0.09, 0.32, 0.09 }, { -0.15, 0.78, -0.36 }, "Fabric", wheatDim, { 0, 0, 12 }),
+		Kit.box("Head", { 0.20, 0.30, 0.12 }, { -0.24, 1.00, -0.36 }, "Fabric", wheat, { 0, 0, 12 }),
+		Kit.box("Head", { 0.09, 0.28, 0.09 }, { 0.16, 0.76, -0.32 }, "Fabric", wheatDim, { 0, 0, -14 }),
+		Kit.box("Head", { 0.18, 0.26, 0.11 }, { 0.26, 0.96, -0.32 }, "Fabric", wheat, { 0, 0, -14 }),
+		-- A red ribbon bow at the back, its ends falling over the veil.
+		Kit.box("Head", { 0.30, 0.16, 0.08 }, { -0.17, 0.40, 0.66 }, "Fabric", hearth, { 0, 0, 18 }),
+		Kit.box("Head", { 0.30, 0.16, 0.08 }, { 0.17, 0.40, 0.66 }, "Fabric", hearth, { 0, 0, -18 }),
+		Kit.box("Head", { 0.14, 0.14, 0.10 }, { 0, 0.40, 0.69 }, "Fabric", hearthDim),
+		Kit.box("Head", { 0.09, 0.44, 0.04 }, { -0.09, 0.13, 0.70 }, "Fabric", hearth, { -6, 0, 5 }),
+		Kit.box("Head", { 0.09, 0.36, 0.04 }, { 0.10, 0.18, 0.71 }, "Fabric", hearth, { -6, 0, -6 }),
+		-- The short veil, pale linen with a wheat hem, falling from under the wreath.
+		Kit.box("Head", { 1.10, 0.98, 0.05 }, { 0, -0.05, 0.67 }, "Fabric", linen, { -7, 0, 0 }),
+		Kit.box("Head", { 1.12, 0.07, 0.05 }, { 0, -0.50, 0.72 }, "Fabric", wheat, { -7, 0, 0 }),
