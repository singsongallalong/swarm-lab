+		Kit.box("LowerArm", { 1.27, 0.07, 1.27 }, { 0, 0.07, 0 }, "Fabric", green),
+		-- The red wrist ribbon, and the glove.
+		Kit.box("LowerArm", { 1.10, 0.10, 1.10 }, { 0, -0.55, 0 }, "Fabric", hearth),
