+--!strict
+-- The harvestbride's hem (Farmland, levels 1-3): the rest of the gown's
+-- skirt, carried down the shins so it reads as one long tiered skirt standing.
+-- A green knee tier, a wider and deeper lower tier in a lighter sunlit green,
+-- the pale apron running on down the front to a red hem, a wheat-gold band
+-- round the skirt's hem to catch the eye, and soft walnut shoes with hearth
+-- ribbons at the ankle.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local linen = { 154, 145, 126 }
+local green = { 84, 104, 68 }
+local greenLight = { 110, 126, 80 }
+local wheat = { 152, 124, 70 }
+local hearth = { 132, 62, 48 }
+local walnut = { 62, 46, 34 }
+local walnutDark = { 44, 32, 24 }
+
+-- One tier of the lower skirt on a shin: front, back and outer side panels,
+-- their inner edges on the centre line so the two legs make one skirt. `z` is
+-- how far the tier stands out front and back, so the skirt bells as well as
+-- widens.
+local function tier(w: number, y0: number, y1: number, z: number, color: { number }): { ArmourLookTypes.ArmourPart }
+	local h = y0 - y1
+	local y = (y0 + y1) / 2
+	local x = w / 2 - 0.5
+	return {
+		Kit.box("LowerLeg", { w, h, 0.08 }, { x, y, -z }, "Fabric", color),
+		Kit.box("LowerLeg", { w, h, 0.08 }, { x, y, z }, "Fabric", color),
+		Kit.box("LowerLeg", { 0.08, h, z * 2 }, { w - 0.54, y, 0 }, "Fabric", color),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "HarvestbrideHem",
+	slot = "Boots",
+	parts = Kit.join({
+		-- The knee tier, meeting the dress's gold hem above it.
+		tier(1.58, 0.70, -0.10, 0.96, green),
+		{
+			-- The apron carried on down the shin.
+			Kit.box("LowerLeg", { 0.95, 0.82, 0.05 }, { -0.025, 0.31, -1.04 }, "Fabric", linen),
+		},
+		-- The lower tier, wider, deeper and a shade lighter.
+		tier(1.90, -0.08, -0.58, 1.12, greenLight),
+		{
+			Kit.box("LowerLeg", { 1.06, 0.54, 0.05 }, { 0.03, -0.33, -1.20 }, "Fabric", linen),
+			-- The apron's red hem, hanging just past the shoe.
+			Kit.box("LowerLeg", { 1.08, 0.07, 0.04 }, { 0.04, -0.575, -1.25 }, "Fabric", hearth),
+			-- The wheat-gold band round the skirt's hem.
+			Kit.box("LowerLeg", { 1.92, 0.08, 0.04 }, { 0.46, -0.555, -1.17 }, "Fabric", wheat),
+			Kit.box("LowerLeg", { 1.92, 0.08, 0.04 }, { 0.46, -0.555, 1.17 }, "Fabric", wheat),
+			Kit.box("LowerLeg", { 0.06, 0.08, 2.38 }, { 1.39, -0.555, 0 }, "Fabric", wheat),
+		},
+		{
+			-- Soft walnut shoes, with hearth ribbons at the ankle.
+			Kit.box("Foot", { 1.08, 0.34, 1.16 }, { 0, 0.02, -0.02 }, "Leather", walnut),
+			Kit.box("Foot", { 1.12, 0.07, 1.20 }, { 0, -0.13, -0.02 }, "Leather", walnutDark),
+			Kit.box("Foot", { 1.10, 0.07, 0.92 }, { 0, 0.18, 0.02 }, "Fabric", hearth),
+		},
+	}),
+}
+
+return look
