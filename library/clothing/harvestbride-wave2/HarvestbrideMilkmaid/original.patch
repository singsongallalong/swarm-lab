@@ -0,0 +1,73 @@
+--!strict
+-- The harvestbride's dress (Farmland, levels 1-3): a milkmaid's gown for the
+-- harvest festival. A warm linen blouse under a field-green corset laced in
+-- wheat gold, a bold hearth-red sash, and a skirt that flares from the hip in
+-- tiers to above the knee, where the hem carries it on. Its panels meet on the
+-- centre line, so the two legs make one skirt standing and part as they
+-- stride; the pale apron runs down the front. The upper arm stays slim, with a
+-- short pale puff at the shoulder inside the shoulder line; the sleeve's
+-- fullness is at the forearm cuff.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local linen = { 154, 145, 126 }
+local linenShade = { 126, 117, 100 }
+local green = { 84, 104, 68 }
+local wheat = { 152, 124, 70 }
+local hearth = { 132, 62, 48 }
+
+-- One tier of the upper skirt on a thigh: front, back and outer side panels.
+-- `w` is how far the tier reaches out from the centre line, so the right and
+-- left legs' panels meet when standing and part as the legs stride. `z` is how
+-- far the tier stands out front and back, so the skirt bells as well as widens.
+local function tier(w: number, y0: number, y1: number, z: number): { ArmourLookTypes.ArmourPart }
+	local h = y0 - y1
+	local y = (y0 + y1) / 2
+	local x = w / 2 - 0.5
+	return {
+		Kit.box("UpperLeg", { w, h, 0.08 }, { x, y, -z }, "Fabric", green),
+		Kit.box("UpperLeg", { w, h, 0.08 }, { x, y, z }, "Fabric", green),
+		Kit.box("UpperLeg", { 0.08, h, z * 2 }, { w - 0.54, y, 0 }, "Fabric", green),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "HarvestbrideDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The blouse, and the field-green corset over it.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", linenShade),
+			Kit.box("UpperTorso", { 2.14, 1.36, 1.14 }, { 0, -0.12, 0 }, "Fabric", green),
+			Kit.box("UpperTorso", { 2.15, 0.06, 1.15 }, { 0, 0.565, 0 }, "Fabric", wheat),
+			-- A pale linen collar, proud of the blouse at the neck.
+			Kit.box("UpperTorso", { 1.52, 0.09, 1.16 }, { 0, 0.80, 0 }, "Fabric", linen),
+			-- Wheat-gold lacing up the corset's front.
+			Kit.box("UpperTorso", { 0.44, 0.055, 0.03 }, { 0, -0.66, -0.585 }, "Fabric", wheat, { 0, 0, 34 }),
+			Kit.box("UpperTorso", { 0.44, 0.055, 0.03 }, { 0, -0.42, -0.585 }, "Fabric", wheat, { 0, 0, -34 }),
+			Kit.box("UpperTorso", { 0.44, 0.055, 0.03 }, { 0, -0.18, -0.585 }, "Fabric", wheat, { 0, 0, 34 }),
+			Kit.box("UpperTorso", { 0.44, 0.055, 0.03 }, { 0, 0.06, -0.585 }, "Fabric", wheat, { 0, 0, -34 }),
+			Kit.box("UpperTorso", { 0.44, 0.055, 0.03 }, { 0, 0.30, -0.585 }, "Fabric", wheat, { 0, 0, 34 }),
+			-- The waist, and the bold hearth sash bow at the back.
+			Kit.box("LowerTorso", { 2.14, 0.38, 1.14 }, { 0, 0.005, 0 }, "Fabric", green),
+			Kit.box("LowerTorso", { 2.20, 0.16, 1.20 }, { 0, -0.10, 0 }, "Fabric", hearth),
+			Kit.box("LowerTorso", { 0.16, 0.14, 0.10 }, { 0, -0.09, 0.60 }, "Fabric", hearth),
+			Kit.box("LowerTorso", { 0.28, 0.12, 0.08 }, { 0.21, -0.05, 0.60 }, "Fabric", hearth, { 0, 0, 14 }),
+			Kit.box("LowerTorso", { 0.28, 0.12, 0.08 }, { -0.21, -0.05, 0.60 }, "Fabric", hearth, { 0, 0, -14 }),
+			-- The upper arm: a slim sleeve with a short pale puff at the shoulder.
+			Kit.box("UpperArm", { 1.04, 1.20, 1.04 }, { 0, 0, 0 }, "Fabric", linenShade),
+			Kit.box("UpperArm", { 1.16, 0.32, 1.16 }, { 0, 0.44, 0 }, "Fabric", linen),
+		},
+		tier(1.15, 0.60, 0.24, 0.64),
+		tier(1.28, 0.29, -0.52, 0.78),
+		{
+			-- The wheat-gold band at the knee.
+			Kit.box("UpperLeg", { 1.34, 0.08, 0.04 }, { 0.17, -0.475, -0.83 }, "Fabric", wheat),
+			Kit.box("UpperLeg", { 1.34, 0.08, 0.04 }, { 0.17, -0.475, 0.83 }, "Fabric", wheat),
+			-- The apron down the front, slanted to lie over the tiered step.
+			Kit.box("UpperLeg", { 0.74, 1.10, 0.05 }, { -0.13, 0.05, -0.80 }, "Fabric", linen, { 9, 0, 0 }),
+		},
+	}),
+}
+
+return look
