+--!strict
+-- The harvestbride's hat (Farmland, levels 1-3): a wide straw sun hat for the
+-- harvest festival, its brim shading the face, a stepped crown with a bright
+-- hearth-red ribbon band, a side bow and a ribbon end lying across the brim.
+-- The crown rises rather than widens, so the head keeps a hat's shape, not a
+-- helmet's; the red echoes the gown's waist sash.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local wheat = { 152, 124, 70 }
+local strawDark = { 112, 88, 50 }
+local hearth = { 132, 62, 48 }
+
+-- A flat disc of straw, lying along the head's own Y.
+local function disc(diameter: number, height: number, at: { number }, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "Head",
+		shape = "Cylinder",
+		size = { diameter, height, diameter },
+		at = at,
+		material = "Fabric",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "HarvestbrideHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The wide brim, with a darker woven edge under it.
+		disc(2.10, 0.10, { 0, 0.55, 0 }, wheat),
+		disc(2.18, 0.06, { 0, 0.525, 0 }, strawDark),
+		-- A stepped straw crown.
+		disc(1.08, 0.28, { 0, 0.74, 0 }, wheat),
+		disc(0.94, 0.22, { 0, 0.96, 0 }, wheat),
+		-- The red ribbon band, its side bow and the end lying on the brim.
+		disc(1.24, 0.14, { 0, 0.68, 0 }, hearth),
+		Kit.box("Head", { 0.18, 0.16, 0.14 }, { 0.57, 0.70, 0.10 }, "Fabric", hearth),
+		Kit.box("Head", { 0.30, 0.16, 0.10 }, { 0.74, 0.73, 0.24 }, "Fabric", hearth, { 0, -25, 8 }),
+		Kit.box("Head", { 0.30, 0.16, 0.10 }, { 0.74, 0.73, 0.00 }, "Fabric", hearth, { 0, 25, -8 }),
+		Kit.box("Head", { 0.14, 0.03, 0.52 }, { 0.62, 0.615, 0.50 }, "Fabric", hearth, { 0, 32, 0 }),
+	},
+}
+
+return look
