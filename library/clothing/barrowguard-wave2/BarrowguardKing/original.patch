+--!strict
+-- The barrow boots (the Barrowguard set's boots): mould-black leather boots
+-- with a tarnished-bronze shin plate, a bright bronze knee band and a bronze
+-- toe cap, and grave moss up the left shin only.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local bronze = { 112, 84, 48 }
+local bronzeWorn = { 152, 124, 78 }
+local mould = { 44, 46, 40 }
+local moss = { 86, 98, 58 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardBoots",
+	slot = "Boots",
+	parts = {
+		Kit.box("LowerLeg", { 1.08, 0.94, 1.08 }, { 0, -0.08, 0 }, "Leather", mould),
+		-- The bronze shin plate and the bright knee band above it.
+		Kit.box("LowerLeg", { 0.74, 0.60, 0.14 }, { 0, 0.02, -0.55 }, "Metal", bronze),
+		Kit.box("LowerLeg", { 1.16, 0.12, 1.16 }, { 0, 0.40, 0 }, "Metal", bronzeWorn),
+		-- The foot, with a bright bronze toe cap.
+		Kit.box("Foot", { 1.06, 0.34, 1.14 }, { 0, 0.02, -0.04 }, "Leather", mould),
+		Kit.box("Foot", { 0.86, 0.24, 0.36 }, { 0, 0.02, -0.42 }, "Metal", bronzeWorn),
+		-- Moss up the left shin only.
+		Kit.box("LowerLeg", { 0.30, 0.44, 0.10 }, { -0.24, -0.14, -0.56 }, "Fabric", moss, { 0, 0, 6 }, "Left"),
+	},
+}
+
+return look
