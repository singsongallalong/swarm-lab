+--!strict
+-- The barrow mail (the Barrowguard set's chest): a bronze-brown mail hauberk
+-- warmed to tarnished bronze, with green verdigris breaking out low on the
+-- front, under a broad bronze collar with a pale bone gorget ringed at the
+-- neck. A mouldering grave-moss cloak hangs from the left shoulder and down
+-- the back, its hem torn, and the moss spills from the shoulder across the
+-- chest. A mould-black belt with an off-centre bronze buckle closes it.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+local bronze = { 112, 84, 48 }
+local bronzeWorn = { 152, 124, 78 }
+local mail = { 96, 80, 58 }
+local mailDark = { 72, 60, 44 }
+local moss = { 86, 98, 58 }
+local mossDark = { 58, 70, 44 }
+local verdigris = { 72, 92, 84 }
+local mould = { 44, 46, 40 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The bronze-brown mail shirt, its sleeves and the skirt below the
+		-- belt, with verdigris breaking out low on the left.
+		{
+			Kit.box("UpperTorso", { 2.08, 1.62, 1.08 }, { 0, 0, 0 }, "Metal", mail),
+			Kit.box("LowerTorso", { 2.10, 0.46, 1.10 }, { 0, 0, 0 }, "Metal", mailDark),
+			Kit.box("UpperArm", { 1.08, 1.22, 1.08 }, { 0, 0, 0 }, "Metal", mail),
+			Kit.box("UpperTorso", { 0.34, 0.26, 0.10 }, { -0.40, -0.24, -0.58 }, "Metal", verdigris, { 0, 0, -8 }),
+			Kit.box("UpperTorso", { 0.18, 0.14, 0.10 }, { -0.24, -0.46, -0.58 }, "Metal", verdigris, { 0, 0, 6 }),
+		},
+		-- The bronze collar: a broad band across the shoulders, a pale bone
+		-- gorget ringed at the neck and a bone gorget plate at the throat.
+		{
+			Kit.box("UpperTorso", { 2.24, 0.26, 1.26 }, { 0, 0.68, 0 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 1.34, 0.28, 1.08 }, { 0, 0.88, 0.02 }, "Marble", c.bone),
+			Kit.box("UpperTorso", { 1.16, 0.22, 0.16 }, { 0, 0.52, -0.62 }, "Marble", c.bone),
+		},
+		-- A patinated bronze plate on the right shoulder; the left is under
+		-- the moss cloak, seated low with a fold beneath it.
+		{
+			Kit.box("UpperArm", { 1.30, 0.26, 1.30 }, { 0.04, 0.58, 0 }, "Metal", bronze, { 0, 0, -16 }, "Right"),
+			Kit.box("UpperArm", { 0.36, 0.08, 0.46 }, { 0.16, 0.72, 0.04 }, "Metal", verdigris, nil, "Right"),
+			Kit.box("UpperArm", { 1.16, 0.28, 1.18 }, { 0.04, 0.46, 0 }, "Fabric", moss, { 0, 0, -10 }, "Left"),
+			Kit.box("UpperArm", { 0.94, 0.18, 1.00 }, { 0.04, 0.30, 0 }, "Fabric", mossDark, { 0, 0, -8 }, "Left"),
+		},
+		-- The mouldering cloak: down the left chest, over the left shoulder and
+		-- down the back, with a torn hem and its lower tail below the belt. The
+		-- moss runs off the shoulder onto the chest.
+		{
+			Kit.box("UpperTorso", { 0.62, 1.00, 0.12 }, { -0.72, 0.16, -0.58 }, "Fabric", moss),
+			Kit.box("UpperTorso", { 0.44, 0.42, 0.12 }, { -0.30, 0.08, -0.58 }, "Fabric", moss, { 0, 0, -8 }),
+			Kit.box("UpperTorso", { 2.30, 1.54, 0.14 }, { 0, 0.02, 0.63 }, "Fabric", mossDark),
+			Kit.box("UpperTorso", { 0.94, 0.36, 0.16 }, { 0.58, -0.66, 0.68 }, "Fabric", moss, { 4, 0, 0 }),
+			Kit.box("UpperTorso", { 0.70, 0.24, 0.16 }, { -0.66, -0.72, 0.68 }, "Fabric", mossDark, { -4, 0, 0 }),
+			Kit.box("UpperTorso", { 0.50, 0.34, 0.12 }, { -0.55, -0.05, 0.72 }, "Fabric", moss, { 6, 0, 8 }),
+		},
+		{
+			Kit.box("LowerTorso", { 1.90, 0.42, 0.14 }, { 0, -0.02, 0.66 }, "Fabric", mossDark),
+		},
+		-- The mould-black belt and its off-centre bronze buckle.
+		{
+			Kit.box("LowerTorso", { 2.14, 0.18, 1.14 }, { 0, 0.08, 0 }, "Leather", mould),
