+--!strict
+-- The barrow crown (the Barrowguard set's helm): a tall tarnished bronze
+-- bowl with a full bronze face mask and a dark eye gap, ringed by a crown of
+-- chunky old-bone points -- the left front one snapped short -- and a
+-- mould-black leather neck guard. Moss creeps up the right temple; the pale
+-- crown is the first thing to read from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+local bronze = { 112, 84, 48 }
+local bronzeDark = { 76, 58, 36 }
+local bronzeWorn = { 152, 124, 78 }
+local mould = { 44, 46, 40 }
+local moss = { 86, 98, 58 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl, and the bright bronze band the crown is set in.
+		Kit.box("Head", { 1.32, 0.74, 1.34 }, { 0, 0.28, 0 }, "Metal", bronze),
+		Kit.box("Head", { 1.42, 0.16, 1.44 }, { 0, 0.64, 0 }, "Metal", bronzeWorn),
+		-- A full bronze face mask to the chin, cut by a dark eye gap.
+		Kit.box("Head", { 1.08, 0.90, 0.14 }, { 0, -0.12, -0.66 }, "Metal", bronzeDark),
+		Kit.box("Head", { 0.86, 0.10, 0.08 }, { 0, 0.06, -0.75 }, "Fabric", mould),
+		-- The bone crown: five tines of uneven height and width, the left front
+		-- one snapped short, so the crown reads as broken and old.
+		Kit.box("Head", { 0.27, 0.54, 0.27 }, { 0, 0.97, -0.56 }, "Marble", c.bone, { 6, 0, 0 }),
+		Kit.box("Head", { 0.22, 0.34, 0.22 }, { 0.48, 0.86, -0.44 }, "Marble", c.bone, { 0, 0, -14 }),
+		Kit.box("Head", { 0.24, 0.20, 0.24 }, { -0.46, 0.79, -0.44 }, "Marble", c.bone, { 0, 0, 12 }),
+		Kit.box("Head", { 0.21, 0.46, 0.21 }, { 0.40, 0.92, 0.48 }, "Marble", c.bone, { 0, 0, -8 }),
+		Kit.box("Head", { 0.25, 0.30, 0.25 }, { -0.42, 0.84, 0.47 }, "Marble", c.bone, { 0, 0, 11 }),
+		-- The mould-black leather neck guard at the back.
+		Kit.box("Head", { 1.36, 0.56, 0.54 }, { 0, -0.34, 0.42 }, "Leather", mould),
+		-- Moss up the right temple.
+		Kit.box("Head", { 0.26, 0.40, 0.10 }, { 0.50, 0.20, -0.62 }, "Fabric", moss, { 0, 0, 8 }),
+	},
+}
+
+return look
