+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardRoundelHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl, tall enough to hide the head's square top, and the tall
+		-- ball that rounds its crown above.
+		Kit.box("Head", { 1.36, 0.6, 1.34 }, { 0, 0.32, 0 }, "Metal", bronze),
+		{
+			on = "Head",
+			shape = "Ball",
+			size = { 1.36, 0.9, 1.34 },
+			at = { 0, 0.54, 0 },
+			material = "Metal",
+			color = bronze,
+		},
+		-- The bright brow rim, a bone inlay along it, and the scraped edge above.
+		Kit.box("Head", { 1.44, 0.13, 1.42 }, { 0, 0.1, 0 }, "Metal", bronze),
+		Kit.box("Head", { 0.44, 0.12, 0.09 }, { 0.34, 0.1, -0.73 }, "Marble", c.bone),
+		Kit.box("Head", { 1.36, 0.05, 0.08 }, { 0, 0.205, -0.68 }, "Metal", bronzeWorn),
+		-- Cheek guards hung off the rim, the nasal between them, and the
+		-- lower-face plate that leaves only the eyes bare.
+		Kit.box("Head", { 0.12, 0.56, 0.64 }, { 0.69, -0.22, -0.02 }, "Metal", bronze),
+		Kit.box("Head", { 0.12, 0.56, 0.64 }, { -0.69, -0.22, -0.02 }, "Metal", bronze),
+		Kit.box("Head", { 0.14, 0.44, 0.1 }, { 0, -0.16, -0.7 }, "Metal", bronzeWorn),
+		Kit.box("Head", { 1.3, 0.46, 0.12 }, { 0, -0.35, -0.66 }, "Metal", bronze),
+		-- A mould-black leather curtain over the nape and round the sides.
+		Kit.box("Head", { 1.32, 0.6, 0.44 }, { 0, -0.27, 0.5 }, "Leather", mould),
+		-- Moss grown into the crown, where the high camera looks first.
+		{
+			on = "Head",
+			shape = "Ball",
+			size = { 0.4, 0.3, 0.32 },
+			at = { -0.2, 0.9, 0.05 },
+			material = "Fabric",
+			color = moss,
+		},
+	},
+}
+
+return look
