+--!strict
+-- The Barrowguard boots (zone armour, the BarrowguardRoundelBoots base): mould-black
+-- leather boots plated with a bronze shin scale, a moss wrap with a bone
+-- buckle below the knee, and a bronze cap on the toe. The bronze toe and the
+-- moss wrap are what read from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local bronze = { 112, 96, 62 }
+local moss = { 76, 96, 60 }
+local mould = { 38, 36, 32 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardRoundelBoots",
+	slot = "Boots",
+	parts = {
+		-- The shaft and the bronze scale plate over the shin.
+		Kit.box("LowerLeg", { 1.08, 0.94, 1.08 }, { 0, -0.12, 0 }, "Leather", mould),
+		Kit.box("LowerLeg", { 0.88, 0.56, 0.12 }, { 0, -0.02, -0.57 }, "Metal", bronze, { 5, 0, 0 }),
+		-- The moss wrap and its bone buckle.
+		Kit.box("LowerLeg", { 1.12, 0.16, 1.12 }, { 0, 0.34, 0 }, "Fabric", moss),
+		Kit.box("LowerLeg", { 0.2, 0.14, 0.12 }, { 0.56, 0.34, -0.35 }, "Marble", c.bone),
+		-- The boot and its bronze toe cap.
+		Kit.box("Foot", { 1.08, 0.4, 1.18 }, { 0, 0.02, -0.04 }, "Leather", mould),
+		Kit.box("Foot", { 0.94, 0.26, 0.34 }, { 0, 0, -0.52 }, "Metal", bronze),
+	},
+}
+
+return look
