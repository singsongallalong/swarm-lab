+			Kit.box("UpperTorso", { 1.94, 0.4, 0.1 }, { 0, 0.5, -0.58 }, "Metal", bronze, { 8, 0, 0 }),
+			Kit.box("UpperTorso", { 1.86, 0.4, 0.1 }, { 0, 0.14, -0.58 }, "Metal", bronzeDark, { 8, 0, 0 }),
