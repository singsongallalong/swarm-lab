+--!strict
+-- The ember widow's dress (the Ashveil set's chest): an ash-grey bodice with a
+-- paler cloth face and a bone neckline, a high charcoal widow's collar behind,
+-- a charcoal under-corset at the waist crossed with bone lacing, a bone waist
+-- band and a violet gem, a small bustle, and the gown's upper skirt hung from
+-- the thighs in two tiers that step outward as they fall: ash grey above,
+-- smoky grey below, carrying on down the shins into the burnt black hem (the
+-- Boots look). The panels are set to the outside of each leg and meet at the
+-- centre, so standing they read as one wide bell, not two leg panels.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local CHARCOAL = { 40, 38, 42 }
+local CHARCOAL_DARK = { 26, 25, 28 }
+local SMOKE = { 82, 78, 88 }
+local ASH = { 104, 101, 106 }
+local ASH_PALE = { 140, 136, 142 }
+local BONE = { 198, 190, 172 }
+local VIOLET = { 152, 96, 216 }
+
+-- One cloth panel of the skirt, hung from the thigh so it swings with the leg.
+local function panel(size: { number }, at: { number }, turn: { number }, color: { number }): ArmourLookTypes.ArmourPart
+	return Kit.box("UpperLeg", size, at, "Fabric", color, turn)
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "AshveilDress",
+	slot = "Chest",
+	parts = {
+		-- The ash-grey bodice, with a paler panel down its front and a bone
+		-- neckline band.
+		Kit.box("UpperTorso", { 2.08, 1.66, 1.08 }, { 0, 0, 0 }, "Fabric", ASH),
+		Kit.box("UpperTorso", { 1.18, 1.4, 0.05 }, { 0, 0, -0.545 }, "Fabric", ASH_PALE),
+		Kit.box("UpperTorso", { 1.26, 0.1, 0.06 }, { 0, 0.66, -0.55 }, "SmoothPlastic", BONE),
+		-- The widow's high collar, standing behind the neck.
+		Kit.box("UpperTorso", { 0.9, 0.44, 0.12 }, { 0, 0.94, 0.64 }, "Fabric", CHARCOAL_DARK, { -6, 0, 0 }),
+		-- The charcoal corset at the waist, bone lacing crossed over it, a bone
+		-- waist band and one violet gem at the centre of the lacing.
+		Kit.box("LowerTorso", { 2.12, 0.44, 1.12 }, { 0, 0, 0 }, "Fabric", CHARCOAL_DARK),
+		Kit.box("LowerTorso", { 0.06, 0.44, 0.05 }, { 0, 0, -0.575 }, "SmoothPlastic", BONE, { 0, 0, 32 }),
+		Kit.box("LowerTorso", { 0.06, 0.44, 0.05 }, { 0, 0, -0.575 }, "SmoothPlastic", BONE, { 0, 0, -32 }),
+		Kit.box("LowerTorso", { 2.16, 0.09, 1.16 }, { 0, 0.16, 0 }, "SmoothPlastic", BONE),
+		Kit.box("LowerTorso", { 0.16, 0.18, 0.08 }, { 0, 0.02, -0.61 }, "Neon", VIOLET),
+		-- A bustle behind, so the gown widens low from the side too.
+		Kit.box("LowerTorso", { 1.5, 0.22, 0.3 }, { 0, -0.02, 0.62 }, "Fabric", ASH, { 12, 0, 0 }),
+		-- The upper sleeve, close to the arm and dark against the ash bodice, so
+		-- the shoulder line reads as the bodice and not as one broad block.
+		Kit.box("UpperArm", { 1.04, 1.24, 1.04 }, { 0, 0, 0 }, "Fabric", CHARCOAL),
+		-- The skirt's upper tier: five ash panels a thigh, set to the outside of
+		-- the leg, tilted out, and meeting at the centre line.
+		panel({ 1.25, 0.72, 0.08 }, { 0.125, 0.36, -0.72 }, { 16, 0, 0 }, ASH),
+		panel({ 0.08, 0.72, 1.25 }, { 0.72, 0.36, 0 }, { 0, 0, 16 }, ASH),
+		panel({ 1.25, 0.72, 0.08 }, { 0.509, 0.36, -0.509 }, { 14, -45, 0 }, ASH),
+		panel({ 1.25, 0.72, 0.08 }, { 0.125, 0.36, 0.72 }, { -16, 0, 0 }, ASH),
+		panel({ 1.25, 0.72, 0.08 }, { 0.509, 0.36, 0.509 }, { -14, 45, 0 }, ASH),
+		-- The second tier, smoky grey, stepping wider as it falls to the knee.
+		panel({ 1.35, 0.5, 0.08 }, { 0.175, -0.24, -0.9 }, { 18, 0, 0 }, SMOKE),
+		panel({ 0.08, 0.5, 1.35 }, { 0.9, -0.24, 0 }, { 0, 0, 18 }, SMOKE),
+		panel({ 1.35, 0.5, 0.08 }, { 0.636, -0.24, -0.636 }, { 16, -45, 0 }, SMOKE),
+		panel({ 1.35, 0.5, 0.08 }, { 0.175, -0.24, 0.9 }, { -18, 0, 0 }, SMOKE),
+		panel({ 1.35, 0.5, 0.08 }, { 0.636, -0.24, 0.636 }, { -16, 45, 0 }, SMOKE),
