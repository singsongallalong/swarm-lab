+--!strict
+-- The Ashveil hem (the Ashfields gown's boots): the skirt carried on down the
+-- shins as three sloped wedges a leg, stepping out under the thigh's panels and
+-- widening to a bell broad enough to pass the arms from the high camera. The
+-- hem is burnt to charcoal all round, worst on the right, with a thin glowing
+-- violet seam still running along it and one violet crack through the cloth.
+-- Dark shoes wait underneath, only their toes near the light.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local ashPale = { 160, 157, 160 }
+local charBlack = { 27, 26, 31 }
+local bone = { 194, 186, 166 }
+local violet = { 120, 92, 168 }
+local glow = { 178, 116, 255 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "AshveilHem",
+	slot = "Boots",
+	parts = {
+		-- The lower skirt: the thigh's wedges continued, wider and paler, from
+		-- the knee to the ankle.
+		Kit.wedge("LowerLeg", { 2.3, 1.26, 0.36 }, { 0.16, 0.01, -1.08 }, "Fabric", ashPale),
+		Kit.wedge("LowerLeg", { 2.3, 1.26, 0.36 }, { 0.16, 0.01, 1.08 }, "Fabric", ashPale, { 0, 180, 0 }),
+		Kit.wedge("LowerLeg", { 2.3, 1.26, 0.5 }, { 1.35, 0.01, 0.03 }, "Fabric", ashPale, { 0, -90, 0 }),
+		-- A bone line where the hem tier steps out under the knee.
+		Kit.box("LowerLeg", { 2.32, 0.06, 0.08 }, { 0.16, 0.42, -0.98 }, "Metal", bone),
+		-- The smouldering hem: a thin glowing violet seam above the burnt edge,
+		-- front and back, and a violet line down the outside.
+		Kit.box("LowerLeg", { 2.3, 0.05, 0.06 }, { 0.16, -0.42, -1.22 }, "Neon", glow),
+		Kit.box("LowerLeg", { 2.3, 0.05, 0.06 }, { 0.16, -0.42, 1.22 }, "Neon", glow),
+		Kit.box("LowerLeg", { 0.06, 0.05, 2.3 }, { 1.53, -0.42, 0.03 }, "Fabric", violet),
+		-- The burnt hem: charcoal across the front and back and down the right
+		-- side, where the gate's fire took it.
+		Kit.box("LowerLeg", { 2.32, 0.18, 0.1 }, { 0.16, -0.54, -1.24 }, "Fabric", charBlack),
+		Kit.box("LowerLeg", { 2.32, 0.18, 0.1 }, { 0.16, -0.54, 1.24 }, "Fabric", charBlack),
+		Kit.box("LowerLeg", { 0.1, 0.18, 2.32 }, { 1.62, -0.54, 0.03 }, "Fabric", charBlack, nil, "Right"),
+		-- The fire still in the cloth: one violet crack on the burnt side.
+		Kit.box("LowerLeg", { 0.06, 0.7, 0.03 }, { 0.5, -0.15, -1.14 }, "Fabric", violet, { 16, 0, 5 }, "Right"),
+		-- The shoes: dark, under the hem.
+		Kit.box("Foot", { 1.04, 0.32, 1.04 }, { 0, 0, 0 }, "Leather", charBlack),
+	},
+}
+
+return look
