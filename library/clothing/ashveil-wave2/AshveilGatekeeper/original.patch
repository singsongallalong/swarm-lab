+--!strict
+-- The Ashveil crown (the Ashfields gown's helm): a burnt iron skullcap ringed
+-- in bone at the brow, charred spires rising up and back off it, and the
+-- gate's violet set over the forehead. A short ash veil hangs at the nape. The
+-- height is all up and back; nothing goes wide at ear level, so the head keeps
+-- a woman's line from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local charcoal = { 42, 40, 46 }
+local charBlack = { 27, 26, 31 }
+local bone = { 194, 186, 166 }
+local ashMid = { 104, 102, 110 }
+local glow = { 178, 116, 255 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "AshveilHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The cap and circlet: burnt iron over the crown, a bone ring at the brow.
+		Kit.box("Head", { 1.27, 0.3, 1.27 }, { 0, 0.48, 0 }, "Metal", charcoal),
+		Kit.box("Head", { 1.31, 0.07, 1.31 }, { 0, 0.32, 0 }, "Metal", bone),
+		Kit.box("Head", { 1.29, 0.12, 1.29 }, { 0, 0.22, 0 }, "Metal", charBlack),
+		-- The brow: a bone setting holding the gate's violet.
+		Kit.box("Head", { 0.36, 0.3, 0.08 }, { 0, 0.27, -0.64 }, "Metal", bone),
+		Kit.box("Head", { 0.16, 0.22, 0.07 }, { 0, 0.28, -0.69 }, "Neon", glow),
+		-- The crown: a tall crested blade and two side spires, tips of bone; the
+		-- outer right is broken away, so the set is never quite symmetrical.
+		Kit.box("Head", { 0.08, 0.05, 1.28 }, { 0, 0.645, 0 }, "Metal", bone),
+		Kit.wedge("Head", { 0.36, 0.92, 0.42 }, { 0, 1.0, 0.16 }, "Metal", charcoal, { 18, 0, 0 }),
+		Kit.box("Head", { 0.2, 0.24, 0.2 }, { 0, 1.41, 0.49 }, "Metal", bone),
+		Kit.wedge("Head", { 0.2, 0.66, 0.26 }, { 0.33, 0.88, 0.12 }, "Metal", charcoal, { 16, 0, -12 }),
+		Kit.box("Head", { 0.12, 0.18, 0.12 }, { 0.38, 1.22, 0.32 }, "Metal", bone),
+		Kit.wedge("Head", { 0.2, 0.66, 0.26 }, { -0.33, 0.88, 0.12 }, "Metal", charcoal, { 16, 0, 12 }),
+		Kit.box("Head", { 0.12, 0.18, 0.12 }, { -0.38, 1.22, 0.32 }, "Metal", bone),
+		Kit.box("Head", { 0.13, 0.18, 0.13 }, { 0.52, 0.5, 0.14 }, "Metal", charBlack, { 0, 0, -12 }),
+		-- The ash veil at the nape, torn shorter on one side.
+		Kit.box("Head", { 1.0, 0.66, 0.05 }, { 0, -0.16, 0.65 }, "Fabric", ashMid, { -6, 0, 0 }),
+		Kit.box("Head", { 0.78, 0.5, 0.04 }, { -0.08, -0.28, 0.69 }, "Fabric", charcoal, { -8, 0, 3 }),
+	},
+}
+
+return look
