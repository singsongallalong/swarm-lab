+--!strict
+-- The Ashveil gown's bodice (the Ashfields gown's chest): a fitted ash bodice
+-- with charred side gores and a pale stomacher laced in bone, a high burnt fan
+-- collar rising behind the head, and the gate's violet at the throat and on
+-- the waist. The sleeves are kept close to the arm. The skirt starts at the
+-- waist and hangs from the thighs as three sloped wedges a leg (front, back and
+-- outside), opening from the hip into a bell that the boots carry wider still.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local ash = { 138, 136, 142 }
+local ashPale = { 160, 157, 160 }
+local ashMid = { 104, 102, 110 }
+local charcoal = { 42, 40, 46 }
+local charBlack = { 27, 26, 31 }
+local bone = { 194, 186, 166 }
+local violet = { 120, 92, 168 }
+local violetDeep = { 64, 48, 90 }
+local glow = { 178, 116, 255 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "AshveilDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice: ash cloth, soft grey gores either side of a pale
+			-- stomacher, laced in bone. The panels stop above the waist, so the
+			-- sash below reads as a cinch rather than a coat's front.
+			Kit.box("UpperTorso", { 2.08, 1.66, 1.08 }, { 0, 0.01, 0 }, "Fabric", ash),
+			Kit.box("UpperTorso", { 0.56, 1.25, 0.04 }, { 0.72, 0.12, -0.56 }, "Fabric", ashMid),
+			Kit.box("UpperTorso", { 0.56, 1.25, 0.04 }, { -0.72, 0.12, -0.56 }, "Fabric", ashMid),
+			Kit.box("UpperTorso", { 0.78, 1.15, 0.05 }, { 0, 0.06, -0.565 }, "Fabric", ashPale),
+			Kit.box("UpperTorso", { 0.06, 0.7, 0.04 }, { -0.3, 0.25, -0.57 }, "Metal", bone, { 0, 0, 32 }),
+			Kit.box("UpperTorso", { 0.06, 0.7, 0.04 }, { 0.3, 0.25, -0.57 }, "Metal", bone, { 0, 0, -32 }),
+			Kit.box("UpperTorso", { 0.05, 0.7, 0.03 }, { 0.12, -0.08, -0.605 }, "Metal", bone, { 0, 0, -24 }),
+			Kit.box("UpperTorso", { 0.05, 0.7, 0.03 }, { -0.12, -0.08, -0.605 }, "Metal", bone, { 0, 0, 24 }),
+			-- The back: a charred panel with a bone spine seam, a corset's back.
+			Kit.box("UpperTorso", { 1.66, 1.44, 0.05 }, { 0, -0.04, 0.575 }, "Fabric", charcoal),
+			Kit.box("UpperTorso", { 0.05, 1.3, 0.03 }, { 0, -0.04, 0.6 }, "Metal", bone),
+			-- The collar: a soft ash fan rising behind the neck, bone-rimmed, so
+			-- the black crown reads against it; nothing rises out at the shoulders.
+			Kit.box("UpperTorso", { 0.96, 0.1, 0.1 }, { 0, 0.74, -0.55 }, "Metal", bone),
+			Kit.box("UpperTorso", { 1.14, 0.7, 0.08 }, { 0, 1.02, 0.68 }, "Fabric", ashMid, { 25, 0, 0 }),
+			Kit.box("UpperTorso", { 1.16, 0.07, 0.1 }, { 0, 1.32, 0.87 }, "Metal", bone, { 25, 0, 0 }),
+			-- The gate's violet at the throat, in a bone setting.
+			Kit.box("UpperTorso", { 0.28, 0.26, 0.06 }, { 0, 0.6, -0.585 }, "Metal", bone),
+			Kit.box("UpperTorso", { 0.14, 0.16, 0.06 }, { 0, 0.6, -0.62 }, "Metal", violet),
+			-- The upper sleeves: slim, close to the arm and a shade darker than the
+			-- bodice so they recede from above; one burnt black down the outside.
+			Kit.box("UpperArm", { 1.02, 1.18, 1.02 }, { 0, 0, 0 }, "Fabric", ashMid),
+			Kit.box("UpperArm", { 0.06, 0.52, 0.34 }, { 0.52, 0.04, 0.1 }, "Fabric", charBlack, nil, "Right"),
+			-- The waist: a charred cincher under a deep violet sash, bone-lined
+			-- above and below so the waist is the narrowest band on the figure.
+			Kit.box("LowerTorso", { 2.08, 0.4, 1.08 }, { 0, 0, 0 }, "Fabric", charcoal),
+			Kit.box("LowerTorso", { 2.1, 0.24, 1.1 }, { 0, -0.03, 0 }, "Fabric", violetDeep),
+			Kit.box("LowerTorso", { 2.12, 0.05, 1.12 }, { 0, 0.11, 0 }, "Metal", bone),
+			Kit.box("LowerTorso", { 2.12, 0.05, 1.12 }, { 0, -0.17, 0 }, "Metal", bone),
+			Kit.box("LowerTorso", { 0.3, 0.26, 0.16 }, { 0.52, -0.02, -0.56 }, "Fabric", violetDeep),
+			-- The waist gem, the set's second glow, sitting on the sash's centre.
+			Kit.box("LowerTorso", { 0.26, 0.24, 0.05 }, { 0, -0.02, -0.575 }, "Metal", bone),
+			Kit.box("LowerTorso", { 0.13, 0.14, 0.06 }, { 0, -0.02, -0.61 }, "Neon", glow),
+			-- The sash's ends, lying on the right of the skirt so they swing with it.
+			Kit.box(
+				"UpperLeg",
+				{ 0.06, 0.9, 0.03 },
+				{ 0.02, 0.08, -0.79 },
+				"Fabric",
+				violetDeep,
+				{ 18, 0, 0 },
+				"Right"
+			),
+			Kit.box("UpperLeg", { 0.06, 0.7, 0.03 }, { 0.1, 0.2, -0.76 }, "Fabric", violetDeep, { 18, 0, 0 }, "Right"),
+			-- The upper skirt: three sloped wedges a leg, flaring from the hip to
+			-- the knee, the two legs' panels meeting at the centre.
+			Kit.wedge("UpperLeg", { 1.7, 1.34, 0.44 }, { 0.06, 0.08, -0.77 }, "Fabric", ash),
+			Kit.wedge("UpperLeg", { 1.7, 1.34, 0.44 }, { 0.06, 0.08, 0.77 }, "Fabric", ash, { 0, 180, 0 }),
+			Kit.wedge("UpperLeg", { 1.7, 1.34, 0.46 }, { 0.8, 0.08, 0.02 }, "Fabric", ash, { 0, -90, 0 }),
+			-- The bustle: a soft ash mound over a charcoal ruffle.
+			Kit.box("UpperLeg", { 1.5, 0.6, 0.22 }, { 0.04, 0.44, 0.74 }, "Fabric", ashMid),
+			Kit.box("UpperLeg", { 1.66, 0.2, 0.2 }, { 0.04, 0.16, 0.84 }, "Fabric", charcoal),
+		},
+	}),
+}
+
+return look
