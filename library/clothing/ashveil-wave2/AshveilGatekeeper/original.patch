+--!strict
+-- The Ashveil sleeves (the Ashfields gown's gloves): the forearm kept slim in
+-- ash cloth with a charred bracer plate, then the volume let out low, at the
+-- elbow and again in a wide bell cuff with a dark lining and a bone rim. The
+-- hands are dark gloves with a violet stone on the back. Nothing widens at
+-- the shoulder: all of a sleeve's weight hangs from the elbow down.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local ash = { 138, 136, 142 }
+local ashMid = { 104, 102, 110 }
+local charcoal = { 42, 40, 46 }
+local violetDeep = { 64, 48, 90 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "AshveilSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The forearm: a close shadow-grey sleeve, so the pale bell below reads.
+		Kit.box("LowerArm", { 1.02, 0.86, 1.02 }, { 0, 0.08, 0 }, "Fabric", ashMid),
+		-- The elbow: the first small flare.
+		Kit.box("LowerArm", { 1.16, 0.16, 1.16 }, { 0, 0.4, 0 }, "Fabric", ashMid),
+		-- The cuff: a small ash bell over a charcoal lining.
+		Kit.box("LowerArm", { 1.22, 0.32, 1.22 }, { 0, -0.3, 0 }, "Fabric", ash),
+		Kit.box("LowerArm", { 1.12, 0.24, 1.12 }, { 0, -0.36, 0 }, "Fabric", charcoal),
+		-- The hands: dark gloves with one violet stone on the back.
+		Kit.box("Hand", { 1.03, 0.34, 1.03 }, { 0, 0, 0 }, "Leather", charcoal),
+		Kit.box("Hand", { 0.12, 0.1, 0.05 }, { 0, 0, -0.535 }, "Metal", violetDeep),
+	},
+}
+
+return look
