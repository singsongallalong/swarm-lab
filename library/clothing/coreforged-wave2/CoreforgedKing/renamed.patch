+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		Kit.box("Head", { 1.36, 0.68, 1.36 }, { 0, 0.32, 0 }, "Metal", c.basalt),
+		Kit.box("Head", { 1.48, 0.16, 1.48 }, { 0, 0.68, 0 }, "Metal", c.goldDim),
+		Kit.box("Head", { 1.4, 0.7, 0.36 }, { 0, -0.25, -0.52 }, "Metal", c.basaltDark),
+		Kit.box("Head", { 1.3, 0.46, 0.28 }, { 0, -0.36, 0.56 }, "Metal", c.basalt, { 0, 0, 3 }),
+		Kit.box("Head", { 0.08, 0.56, 0.06 }, { 0, -0.26, -0.715 }, "Neon", c.molten),
+		-- The crown: the gilded brow point, two flanking points, and three behind.
+		Kit.box("Head", { 0.18, 0.64, 0.16 }, { 0, 1.06, -0.56 }, "Metal", c.gold),
+		Kit.box("Head", { 0.15, 0.46, 0.14 }, { 0.46, 0.94, -0.34 }, "Metal", c.basalt, { 0, 0, -16 }),
+		Kit.box("Head", { 0.15, 0.46, 0.14 }, { -0.46, 0.94, -0.34 }, "Metal", c.basalt, { 0, 0, 16 }),
+		Kit.box("Head", { 0.16, 0.56, 0.15 }, { 0, 1.0, 0.56 }, "Metal", c.basaltDark),
