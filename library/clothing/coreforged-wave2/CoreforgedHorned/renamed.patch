+--!strict
+-- The Coreforged cuirass (the Coreforged set, forged in the Aor'lan Core): a
+-- black basalt breastplate trimmed in ember gold, split by molten seams that
+-- run out from a gold-set ember core at the sternum. Broad black pauldrons
+-- carry a gold band, a gold ridge and a molten seam across the top, so both
+-- the trim and the ember read from the high camera, and one pale scorch is
+-- chipped into the breastplate. The gold lines and the hot seams carry.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 44, 40, 46 },
+	basaltDark = { 26, 25, 29 },
+	gold = { 150, 106, 44 },
+	ember = { 240, 94, 34 },
+	molten = { 200, 72, 32 },
+	ash = { 88, 82, 78 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedHornedChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Tassets hung from the thighs.
+		Kit.flaps(0.55, "Metal", c.basalt),
+		{
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Metal", c.basaltDark),
+			Kit.box("LowerTorso", { 2.1, 0.44, 1.1 }, { 0, 0, 0 }, "Metal", c.basaltDark),
+			-- The raised breastplate, its gold edges and the burning core.
+			Kit.box("UpperTorso", { 1.64, 1.22, 0.18 }, { 0, 0.1, -0.55 }, "Metal", c.basalt),
+			Kit.box("UpperTorso", { 1.68, 0.09, 0.22 }, { 0, 0.72, -0.55 }, "Metal", c.gold),
+			Kit.box("UpperTorso", { 1.68, 0.09, 0.22 }, { 0, -0.5, -0.55 }, "Metal", c.gold),
+			Kit.box("UpperTorso", { 0.5, 0.6, 0.1 }, { 0, 0.18, -0.65 }, "Metal", c.gold, { 0, 0, 45 }),
+			Kit.box("UpperTorso", { 0.36, 0.46, 0.12 }, { 0, 0.18, -0.72 }, "Neon", c.ember, { 0, 0, 45 }),
+			-- Molten seams splitting the plate, one on the back.
+			Kit.box("UpperTorso", { 0.8, 0.1, 0.06 }, { -0.42, -0.16, -0.655 }, "Metal", c.molten, { 0, 0, 32 }),
+			Kit.box("UpperTorso", { 0.76, 0.1, 0.06 }, { 0.34, 0.44, -0.655 }, "Metal", c.molten, { 0, 0, -38 }),
+			Kit.box("UpperTorso", { 1.3, 0.1, 0.06 }, { -0.06, 0.1, 0.555 }, "Metal", c.molten, { 0, 0, -24 }),
+			-- The gold belt.
+			Kit.box("LowerTorso", { 2.16, 0.14, 1.16 }, { 0, 0.03, 0 }, "Metal", c.gold),
+			Kit.box("LowerTorso", { 0.36, 0.26, 0.1 }, { 0, 0.03, -0.6 }, "Metal", c.gold),
+			-- A scorch chipped into the lower left of the breastplate.
+			Kit.box("UpperTorso", { 0.2, 0.34, 0.07 }, { -0.6, -0.22, -0.655 }, "Metal", c.ash, { 0, 0, 14 }),
+			-- Broad pauldrons: gold band and gold ridge, and a molten seam
+			-- carried over the top so the ember reads from above.
+			Kit.box("UpperArm", { 1.34, 0.56, 1.34 }, { 0, 0.46, 0 }, "Metal", c.basalt),
+			Kit.box("UpperArm", { 1.38, 0.07, 1.38 }, { 0, 0.66, 0 }, "Metal", c.gold),
+			Kit.box("UpperArm", { 0.26, 0.07, 1.24 }, { 0, 0.76, 0 }, "Metal", c.gold),
+			Kit.box("UpperArm", { 0.09, 0.06, 1.12 }, { 0.34, 0.77, 0 }, "Metal", c.molten, { 0, 20, 0 }),
+			Kit.box("UpperArm", { 0.22, 0.56, 0.22 }, { 0.3, 0.9, 0 }, "Metal", c.basalt, { 0, 0, -20 }),
+			-- Black rerebrace sleeves under the pauldrons.
+			Kit.box("UpperArm", { 1.06, 1.1, 1.06 }, { 0, -0.05, 0 }, "Metal", c.basalt),
+		},
+	}),
+}
+
+return look
