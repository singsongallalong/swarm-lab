+--!strict
+-- The Coreforged gauntlets (the Coreforged set, forged in the Aor'lan Core):
+-- black basalt vambraces under a flared gold elbow cuff, a molten seam down
+-- the outside, and black plated fists with a gold knuckle bar. The right
+-- vambrace is chipped pale; the left carries a lone elbow spur, so the pair
+-- is not quite matched. The gold cuff and knuckle bar carry at the high
+-- camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 44, 40, 46 },
+	gold = { 150, 106, 44 },
+	molten = { 200, 72, 32 },
+	ash = { 88, 82, 78 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedHornedGloves",
+	slot = "Gloves",
+	parts = {
+		-- The vambrace and its flared gold elbow cuff.
+		Kit.box("LowerArm", { 1.08, 1.0, 1.08 }, { 0, -0.04, 0 }, "Metal", c.basalt),
+		Kit.box("LowerArm", { 1.3, 0.14, 1.3 }, { 0, 0.46, 0 }, "Metal", c.gold),
+		-- A molten seam down the outside of the forearm.
+		Kit.box("LowerArm", { 0.08, 0.7, 0.08 }, { 0.55, -0.08, 0.02 }, "Metal", c.molten),
+		-- The plated fist and the gold bar across its knuckles.
+		Kit.box("Hand", { 1.08, 0.52, 1.08 }, { 0, -0.02, 0 }, "Metal", c.basalt),
+		Kit.box("Hand", { 0.98, 0.12, 0.14 }, { 0, 0.1, -0.54 }, "Metal", c.gold),
+		-- One pale chip, on the right vambrace only.
+		Kit.box("LowerArm", { 0.16, 0.28, 0.06 }, { 0.3, -0.3, -0.555 }, "Metal", c.ash, { 0, 0, -10 }, "Right"),
+		-- One elbow spur, on the left only.
+		Kit.wedge("LowerArm", { 0.3, 0.26, 0.46 }, { 0, 0.36, 0.58 }, "Metal", c.basalt, nil, "Left"),
+	},
+}
+
+return look
