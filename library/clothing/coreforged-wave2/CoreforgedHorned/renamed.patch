+--!strict
+-- The Coreforged greaves (the Coreforged set, forged in the Aor'lan Core):
+-- black basalt shins under a gold knee ring, a molten seam down the shin, and
+-- black sabatons with a broad gold toe cap. The right boot is scuffed pale on
+-- the outside, the left chipped at the shin. The gold rings and hot seam
+-- carry at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 44, 40, 46 },
+	gold = { 150, 106, 44 },
+	molten = { 200, 72, 32 },
+	ash = { 88, 82, 78 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedHornedBoots",
+	slot = "Boots",
+	parts = {
+		-- The greave, the gold knee ring and the molten seam down the shin.
+		Kit.box("LowerLeg", { 1.08, 1.04, 1.08 }, { 0, -0.03, 0 }, "Metal", c.basalt),
+		Kit.box("LowerLeg", { 1.18, 0.2, 1.18 }, { 0, 0.5, 0 }, "Metal", c.gold),
+		Kit.box("LowerLeg", { 0.08, 0.74, 0.07 }, { 0.06, -0.08, -0.56 }, "Metal", c.molten),
+		-- The sabaton and its gold toe cap.
+		Kit.box("Foot", { 1.1, 0.38, 1.16 }, { 0, 0.02, -0.03 }, "Metal", c.basalt),
+		Kit.box("Foot", { 1.02, 0.22, 0.22 }, { 0, -0.01, -0.56 }, "Metal", c.gold),
+		-- One pale scuff on the right boot, one chip on the left shin.
+		Kit.box("Foot", { 0.06, 0.18, 0.3 }, { 0.56, 0.06, -0.1 }, "Metal", c.ash, nil, "Right"),
+		Kit.box("LowerLeg", { 0.18, 0.26, 0.06 }, { 0.3, 0.16, -0.555 }, "Metal", c.ash, nil, "Left"),
+	},
+}
+
+return look
