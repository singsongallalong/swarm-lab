+--!strict
+-- The Coreforged helm (the Coreforged set, forged in the Aor'lan Core): a
+-- black basalt great helm whose face plate is split by two burning ember
+-- eyes under a gold brow and closed by a gold chin. A gold crown band rings
+-- the skull, and two long horns sweep out and up from it, the left gold-
+-- capped, the right shorter and broken. The horns are the set's whole
+-- outline; the eyes and gold the colour that carries at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 44, 40, 46 },
+	basaltDark = { 26, 25, 29 },
+	gold = { 150, 106, 44 },
+	ember = { 240, 94, 34 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedHornedHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The skull and the bevor below it close the whole head in black.
+		Kit.box("Head", { 1.38, 1.14, 1.38 }, { 0, 0.13, 0 }, "Metal", c.basaltDark),
+		Kit.box("Head", { 1.34, 0.34, 1.3 }, { 0, -0.5, 0 }, "Metal", c.basaltDark),
+		-- The face plate, its eyes, and the gold brow and chin framing them.
+		Kit.box("Head", { 1.24, 0.74, 0.18 }, { 0, -0.16, -0.63 }, "Metal", c.basalt),
+		Kit.box("Head", { 0.3, 0.1, 0.06 }, { 0.27, 0, -0.745 }, "Neon", c.ember),
+		Kit.box("Head", { 0.3, 0.1, 0.06 }, { -0.27, 0, -0.745 }, "Neon", c.ember),
+		Kit.box("Head", { 1.3, 0.12, 0.12 }, { 0, 0.15, -0.72 }, "Metal", c.gold),
+		Kit.box("Head", { 1.0, 0.09, 0.12 }, { 0, -0.62, -0.62 }, "Metal", c.gold),
+		-- The crown band, gold over the black skull.
+		Kit.box("Head", { 1.44, 0.11, 1.44 }, { 0, 0.62, 0 }, "Metal", c.gold),
+		-- The left horn sweeping long and high, gold-capped; the right one
+		-- broken shorter and blunt.
+		Kit.box("Head", { 0.24, 1.36, 0.24 }, { 0.62, 0.83, 0 }, "Metal", c.basalt, { 0, 0, -36 }),
+		Kit.box("Head", { 0.2, 0.24, 0.2 }, { 1.03, 1.4, 0 }, "Metal", c.gold, { 0, 0, -36 }),
+		Kit.box("Head", { 0.24, 1.16, 0.24 }, { -0.62, 0.76, 0 }, "Metal", c.basalt, { 0, 0, 36 }),
+	},
+}
+
+return look
