+			Kit.box("UpperArm", { 1.22, 1.2, 1.22 }, { 0, 0, 0 }, "Fabric", c.black),
+			Kit.box("UpperArm", { 0.44, 0.44, 0.05 }, { 0.18, 0.08, -0.625 }, "Fabric", c.blackWarm, nil, "Right"),
