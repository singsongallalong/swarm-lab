+--!strict
+-- The stitched doll's dress (the ClassicDress look): a black bodice laced in
+-- crimson under a bone lace collar, with a small lopsided bow at the throat
+-- and a big one at each side of the waist; the full black overskirt hangs from
+-- the thighs in mismatched panels, trimmed with a thin crimson stripe, sewn
+-- with big bone cross-stitches and patched with a bone heart.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	black = { 26, 23, 28 },
+	blackPatch = { 34, 29, 33 },
+	blackWarm = { 31, 26, 26 },
+	crimson = { 102, 38, 42 },
+	crimsonDeep = { 86, 32, 37 },
+	cream = { 188, 176, 150 },
+	creamDull = { 170, 158, 136 },
+}
+
+-- How far the overskirt runs down each thigh from just above its top. It stops
+-- a little above the knee, where the Boots look's tiers carry it on down.
+local SKIRT_TOP = 0.7
+local SKIRT_LENGTH = 1.2
+local SKIRT_MID = SKIRT_TOP - SKIRT_LENGTH / 2
+
+-- A heart's lobe: a squashed ball sewn flat against a skirt panel.
+local function ball(
+	on: ArmourLookTypes.BodyPart,
+	size: { number },
+	at: { number },
+	material: string,
+	color: { number },
+	side: ArmourLookTypes.Side?
+): ArmourLookTypes.ArmourPart
+	return { on = on, side = side, shape = "Ball", size = size, at = at, material = material, color = color }
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice, a patch sewn over the left front with bone stitches.
+			Kit.box("UpperTorso", { 2.06, 1.64, 1.06 }, { 0, 0, 0 }, "Fabric", c.black),
+			Kit.box("UpperTorso", { 0.62, 0.64, 0.05 }, { -0.52, 0.28, -0.55 }, "Fabric", c.blackPatch, { 0, 0, -3 }),
+			Kit.box("UpperTorso", { 0.06, 0.18, 0.04 }, { -0.52, 0.28, -0.585 }, "Fabric", c.cream, { 0, 0, 40 }),
+			Kit.box("UpperTorso", { 0.06, 0.18, 0.04 }, { -0.52, 0.28, -0.585 }, "Fabric", c.cream, { 0, 0, -40 }),
+			-- A bone lace collar round the neck.
+			Kit.box("UpperTorso", { 1.5, 0.14, 1.3 }, { 0, 0.78, 0 }, "Fabric", c.cream),
+			-- The small crimson bow at the throat, its left loop lower.
+			Kit.box("UpperTorso", { 0.18, 0.16, 0.14 }, { 0, 0.6, -0.66 }, "Fabric", c.crimson),
+			Kit.box("UpperTorso", { 0.3, 0.22, 0.1 }, { -0.22, 0.64, -0.66 }, "Fabric", c.crimsonDeep, { 0, 0, 16 }),
+			Kit.box("UpperTorso", { 0.34, 0.24, 0.1 }, { 0.24, 0.65, -0.66 }, "Fabric", c.crimson, { 0, 0, -12 }),
+			Kit.box("UpperTorso", { 0.12, 0.32, 0.08 }, { 0.18, 0.46, -0.6 }, "Fabric", c.crimsonDeep, { 0, 0, 6 }),
+			-- The crimson lacing: two eyelet strips and two crossed pairs.
+			Kit.box("UpperTorso", { 0.05, 1.16, 0.05 }, { -0.12, 0, -0.552 }, "Fabric", c.crimsonDeep),
+			Kit.box("UpperTorso", { 0.05, 1.16, 0.05 }, { 0.12, 0, -0.552 }, "Fabric", c.crimsonDeep),
+			Kit.box("UpperTorso", { 0.06, 0.4, 0.06 }, { 0, 0.24, -0.555 }, "Fabric", c.crimson, { 0, 0, 32 }),
+			Kit.box("UpperTorso", { 0.06, 0.4, 0.06 }, { 0, 0.24, -0.555 }, "Fabric", c.crimson, { 0, 0, -32 }),
+			Kit.box("UpperTorso", { 0.06, 0.4, 0.06 }, { 0, -0.24, -0.555 }, "Fabric", c.crimson, { 0, 0, 32 }),
+			Kit.box("UpperTorso", { 0.06, 0.4, 0.06 }, { 0, -0.24, -0.555 }, "Fabric", c.crimson, { 0, 0, -32 }),
+			-- The waist: black band, a proud crimson sash, a dipping bodice point.
+			Kit.box("LowerTorso", { 2.06, 0.4, 1.06 }, { 0, 0, 0 }, "Fabric", c.black),
+			Kit.box("LowerTorso", { 2.12, 0.2, 1.3 }, { 0, 0.04, 0 }, "Fabric", c.crimson),
