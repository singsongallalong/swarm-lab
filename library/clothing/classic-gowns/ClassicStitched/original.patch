+				{ 0.28, SKIRT_MID, -0.56 },
+				"Fabric",
+				c.black,
+				{ 4, 0, 0 }
+			),
+			Kit.box(
+				"UpperLeg",
+				{ 1.5, SKIRT_LENGTH, 0.09 },
+				{ 0.28, SKIRT_MID, 0.56 },
+				"Fabric",
+				c.blackWarm,
+				{ -4, 0, 0 }
+			),
+			Kit.box(
+				"UpperLeg",
+				{ 0.09, SKIRT_LENGTH, 1.04 },
+				{ 0.75, SKIRT_MID, 0 },
+				"Fabric",
+				c.blackPatch,
+				{ 0, 0, -4 }
+			),
+			Kit.box("UpperLeg", { 1.62, 0.1, 1.32 }, { 0.28, -0.37, 0 }, "Fabric", c.crimson),
