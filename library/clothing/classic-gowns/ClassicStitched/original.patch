+--!strict
+-- The stitched doll's headdress (the ClassicHeaddress look): a crimson lace
+-- ribbon laid across the crown and down to the hairline with bone lace at its
+-- edges, a big bow cocked to the right of the head and its two tails down the
+-- back, a tiny brass clock pinned to the band, and one bone cross-stitch where
+-- the ribbon was patched.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	crimson = { 102, 38, 42 },
+	crimsonDeep = { 86, 32, 37 },
+	cream = { 188, 176, 150 },
+	black = { 26, 23, 28 },
+	brass = { 128, 104, 68 },
+	clockFace = { 205, 196, 172 },
+}
+
+-- A round clock face, its own Y run along the head's front.
+local function disc(
+	on: ArmourLookTypes.BodyPart,
+	size: { number },
+	at: { number },
+	material: string,
+	color: { number },
+	turn: { number }
+): ArmourLookTypes.ArmourPart
+	return {
+		on = on,
+		shape = "Cylinder",
+		size = size,
+		at = at,
+		turn = turn,
+		material = material,
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicHeaddress",
+	slot = "Helm",
+	parts = {
+		-- A ribbon over the front of the crown, bone lace along both long edges.
+		Kit.box("Head", { 1.36, 0.18, 0.6 }, { 0, 0.54, -0.28 }, "Fabric", c.crimson),
+		Kit.box("Head", { 1.38, 0.06, 0.08 }, { 0, 0.45, -0.56 }, "Fabric", c.cream),
+		Kit.box("Head", { 1.38, 0.06, 0.08 }, { 0, 0.45, 0 }, "Fabric", c.cream),
+		-- The band comes down to the hairline, a bone lace edge under it.
+		Kit.box("Head", { 1.34, 0.24, 0.1 }, { 0, 0.34, -0.63 }, "Fabric", c.crimsonDeep),
+		Kit.box("Head", { 1.36, 0.06, 0.1 }, { 0, 0.2, -0.64 }, "Fabric", c.cream),
+		-- The bow, cocked to the right and lopsided: the outer loop bigger and
+		-- higher than the inner one.
+		Kit.box("Head", { 0.18, 0.2, 0.16 }, { 0.52, 0.66, 0.02 }, "Fabric", c.crimson),
+		Kit.box("Head", { 0.34, 0.26, 0.13 }, { 0.28, 0.68, 0 }, "Fabric", c.crimsonDeep, { 0, 30, 12 }),
+		Kit.box("Head", { 0.52, 0.3, 0.13 }, { 0.84, 0.74, 0 }, "Fabric", c.crimson, { 0, -32, -8 }),
+		-- Its two tails down the back of the head.
+		Kit.box("Head", { 0.12, 0.44, 0.07 }, { 0.66, 0.42, 0.65 }, "Fabric", c.crimsonDeep, { -10, 0, 8 }),
+		Kit.box("Head", { 0.1, 0.34, 0.07 }, { 0.44, 0.48, 0.66 }, "Fabric", c.crimson, { -8, 0, -10 }),
+		-- The tiny clock pinned to the front of the band.
+		disc("Head", { 0.28, 0.1, 0.28 }, { -0.28, 0.34, -0.72 }, "Metal", c.brass, { 90, 0, 0 }),
+		disc("Head", { 0.18, 0.04, 0.18 }, { -0.28, 0.34, -0.78 }, "Metal", c.clockFace, { 90, 0, 0 }),
+		Kit.box("Head", { 0.02, 0.1, 0.03 }, { -0.28, 0.36, -0.812 }, "Metal", c.black, { 0, 0, 30 }),
+		-- A bone cross-stitch where the band was pieced.
+		Kit.box("Head", { 0.06, 0.16, 0.04 }, { 0.02, 0.34, -0.69 }, "Fabric", c.cream, { 0, 0, 40 }),
+		Kit.box("Head", { 0.06, 0.16, 0.04 }, { 0.02, 0.34, -0.69 }, "Fabric", c.cream, { 0, 0, -40 }),
+	},
+}
