+			ball("UpperLeg", { 0.28, 0.24, 0.08 }, { 0.8, 0.15, -0.62 }, "Fabric", c.creamDull, "Right"),
+			Kit.box(
+				"UpperLeg",
+				{ 0.28, 0.28, 0.08 },
+				{ 0.7, 0.01, -0.62 },
+				"Fabric",
+				c.creamDull,
+				{ 0, 0, 45 },
+				"Right"
+			),
+		},
+	}),
+}
