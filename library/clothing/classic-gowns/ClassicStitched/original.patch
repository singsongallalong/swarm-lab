+		Kit.box("LowerLeg", { 1.64, 0.22, 1.14 }, { 0.33, 0.39, 0 }, "Fabric", c.crimson),
+		Kit.box("LowerLeg", { 1.78, 0.12, 1.22 }, { 0.4, 0.24, 0 }, "Fabric", c.crimsonDeep),
