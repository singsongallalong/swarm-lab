+		Kit.box("LowerLeg", { 0.06, 0.22, 0.05 }, { 0.34, 0.39, -0.665 }, "Fabric", c.cream, { 0, 0, 40 }, "Right"),
+		Kit.box("LowerLeg", { 0.06, 0.22, 0.05 }, { 0.34, 0.39, -0.665 }, "Fabric", c.cream, { 0, 0, -40 }, "Right"),
+		-- The long dark stocking, then the pale ruffles at the ankles.
