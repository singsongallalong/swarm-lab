+			Kit.box("LowerTorso", { 0.24, 0.24, 0.18 }, { 0, 0.06, -0.7 }, "Fabric", c.crimson),
+			Kit.box("LowerTorso", { 0.4, 0.28, 0.14 }, { -0.32, 0.12, -0.69 }, "Fabric", c.crimsonDeep, { 0, 0, 16 }),
+			Kit.box("LowerTorso", { 0.48, 0.32, 0.14 }, { 0.36, 0.17, -0.69 }, "Fabric", c.crimson, { 0, 0, -13 }),
+			Kit.box(
+				"UpperLeg",
+				{ 0.16, 0.8, 0.08 },
+				{ 0.2, 0.34, -0.62 },
+				"Fabric",
+				c.crimsonDeep,
+				{ 0, 0, 6 },
+				"Right"
+			),
+			Kit.box("UpperLeg", { 0.13, 0.62, 0.08 }, { 0.02, 0.42, -0.6 }, "Fabric", c.crimson, { 0, 0, -4 }, "Right"),
