@@ -0,0 +1,52 @@
+--!strict
+-- The classic gown's headdress (the ClassicHeaddress base): the crimson lace
+-- band of an old catalogue set, laid over the crown with cream lace at its
+-- edges, a big crimson bow at the right of the crown and a tiny brass clock
+-- pinned on its knot. The band lies flat and the bow goes up and back, so the
+-- high camera reads a band and a bow, never a helmet's rim at ear level.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	noir = { 38, 35, 42 },
+	crimson = { 110, 48, 48 },
+	cream = { 180, 170, 150 },
+	brass = { 124, 104, 72 },
+}
+
+-- A flat disc lying on the piece under it: the clock's rim and face.
+local function disc(at: { number }, diameter: number, thickness: number, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "Head",
+		shape = "Cylinder",
+		size = { diameter, thickness, diameter },
+		at = at,
+		material = "Metal",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicHeaddress",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The band across the crown, edged in cream lace front and back.
+		Kit.box("Head", { 1.38, 0.14, 0.8 }, { 0, 0.64, 0.16 }, "Fabric", c.crimson),
+		Kit.box("Head", { 1.4, 0.05, 0.1 }, { 0, 0.715, -0.2 }, "Fabric", c.cream),
+		Kit.box("Head", { 1.4, 0.05, 0.1 }, { 0, 0.715, 0.52 }, "Fabric", c.cream),
+		-- The bow: a knot at the right of the crown, one loop swept forward and
+		-- one back and both tilted up, so it reads as a bow from above and
+		-- from the front.
+		Kit.box("Head", { 0.26, 0.22, 0.24 }, { 0.5, 0.8, 0.22 }, "Fabric", c.crimson),
+		Kit.box("Head", { 0.52, 0.18, 0.38 }, { 0.3, 0.82, -0.12 }, "Fabric", c.crimson, { 0, -34, 20 }),
+		Kit.box("Head", { 0.52, 0.18, 0.38 }, { 0.74, 0.85, 0.54 }, "Fabric", c.crimson, { 0, 38, -20 }),
+		-- The clock, pinned on the knot: a brass rim, a bone face, two hands.
+		disc({ 0.5, 0.93, 0.22 }, 0.3, 0.07, c.brass),
+		disc({ 0.5, 0.97, 0.22 }, 0.24, 0.05, c.cream),
+		Kit.box("Head", { 0.02, 0.02, 0.1 }, { 0.5, 1.005, 0.19 }, "Metal", c.noir),
+		Kit.box("Head", { 0.07, 0.02, 0.02 }, { 0.52, 1.005, 0.22 }, "Metal", c.noir),
+	},
+}
+
+return look
