+--!strict
+-- The classic gown's sleeves and gloves (the ClassicSleeves base): the bell of
+-- the long black sleeve, gathered at the elbow and opening into a wide square
+-- bell that hangs down the forearm to a crimson lining at the mouth, and a
+-- close crimson glove below it. The sleeve's top piece runs up over the elbow
+-- so no bare arm shows at the joint. The volume is all at the elbow and cuff,
+-- never at the shoulder, so the figure keeps its narrow shoulder line.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	noir = { 38, 35, 42 },
+	crimson = { 110, 48, 48 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The sleeve's top, close at the elbow under the upper sleeve and up
+		-- over the top of the forearm so no bare arm shows at the joint.
+		Kit.box("LowerArm", { 1.14, 0.36, 1.14 }, { 0, 0.44, 0 }, "Fabric", c.noir),
+		-- The bell, stepped out in three square folds to the cuff.
+		Kit.box("LowerArm", { 1.32, 0.32, 1.32 }, { 0, 0.16, 0 }, "Fabric", c.noir),
+		Kit.box("LowerArm", { 1.46, 0.3, 1.46 }, { 0, -0.12, 0 }, "Fabric", c.noir),
+		Kit.box("LowerArm", { 1.54, 0.2, 1.54 }, { 0, -0.36, 0 }, "Fabric", c.noir),
+		-- The crimson lining at the cuff's mouth.
+		Kit.box("LowerArm", { 1.56, 0.1, 1.56 }, { 0, -0.48, 0 }, "Fabric", c.crimson),
+		-- The close crimson glove.
+		Kit.box("Hand", { 1.06, 0.42, 1.06 }, { 0, 0, 0 }, "Leather", c.crimson),
+	},
+}
+
+return look
