+--!strict
+-- The classic gown's lower skirt (the ClassicHem base): the black tiers of the
+-- overskirt carried down the shins, widening to a crimson stripe on the hem
+-- and a crimson ruffle peeking out below it, over dark stockings, a pale
+-- ruffle at the ankle and a dark strapped shoe. The tiers are written once and
+-- drawn on both legs, their inner edges on the body's centre line, so standing
+-- the two legs' panels meet into one full skirt.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+type ArmourPart = ArmourLookTypes.ArmourPart
+
+local c = {
+	noir = { 38, 35, 42 },
+	crimson = { 110, 48, 48 },
+	cream = { 180, 170, 150 },
+	stocking = { 56, 52, 58 },
+}
+
+-- One tier of the skirt on the shin, as ClassicDress.tier: the front, back and
+-- outer faces of a flared band, swung with the leg. `reach` is how far the
+-- band's outer face stands from the leg's centre; `drop` how far its front and
+-- back faces stand from it.
+local function tier(top: number, bottom: number, reach: number, drop: number, color: { number }): { ArmourPart }
+	local height = top - bottom
+	local y = (top + bottom) / 2
+	return {
+		Kit.box("LowerLeg", { reach + 0.5, height, 0.1 }, { (reach - 0.5) / 2, y, -drop }, "Fabric", color),
+		Kit.box("LowerLeg", { reach + 0.5, height, 0.1 }, { (reach - 0.5) / 2, y, drop }, "Fabric", color),
+		Kit.box("LowerLeg", { 0.1, height, 2 * drop + 0.1 }, { reach - 0.05, y, 0 }, "Fabric", color),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicHem",
+	slot = "Boots",
+	parts = Kit.join({
+		{
+			-- The stockings below the hem, the pale ruffle at the ankle, and
+			-- the dark shoe.
+			Kit.box("LowerLeg", { 1.02, 0.3, 1.02 }, { 0, -0.45, 0 }, "Fabric", c.stocking),
+			Kit.box("LowerLeg", { 1.24, 0.16, 1.24 }, { 0, -0.55, 0 }, "Fabric", c.cream),
+			Kit.box("Foot", { 1.1, 0.42, 1.16 }, { 0, 0, -0.08 }, "Leather", c.noir),
+		},
+		-- The skirt's lower tiers on the shins, each wider than the last down
+		-- to the ruffle, so the hem is the widest thing on the figure.
+		tier(0.78, 0.2, 1.28, 0.92, c.noir),
+		tier(0.2, -0.14, 1.52, 1.05, c.noir),
+		tier(-0.06, -0.14, 1.55, 1.07, c.crimson),
+		tier(-0.14, -0.34, 1.72, 1.18, c.crimson),
+	}),
+}
+
+return look
