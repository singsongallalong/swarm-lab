@@ -0,0 +1,82 @@
+--!strict
+-- The classic gown's bodice (the ClassicDress base): a fitted black bodice
+-- laced in crimson up the front, a wide flat collar edged in crimson, a small
+-- bow at the throat, a crimson ribbon belt with a big bow behind the waist,
+-- and the top of the tiered skirt hung from the thighs. The tiers run crimson
+-- at the hip, a cream lace edge, then two black tiers widening to the knee;
+-- the hem continues on the shins (ClassicHem). The sleeves stay close on the
+-- upper arm, with a crimson band at the elbow where the bell takes over.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+type ArmourPart = ArmourLookTypes.ArmourPart
+
+local c = {
+	noir = { 38, 35, 42 },
+	crimson = { 110, 48, 48 },
+	crimsonDeep = { 80, 34, 36 },
+	cream = { 180, 170, 150 },
+}
+
+-- One tier of the skirt: the front, back and outer faces of a flared band,
+-- hung from the thigh so it swings with the leg. It is written once and drawn
+-- on both legs, its inner edge on the body's centre line so the two legs'
+-- panels meet into one skirt standing. `reach` is how far the band's outer
+-- face stands from the leg's centre; `drop` how far its front and back faces
+-- stand from it.
+local function tier(top: number, bottom: number, reach: number, drop: number, color: { number }): { ArmourPart }
+	local height = top - bottom
+	local y = (top + bottom) / 2
+	return {
+		Kit.box("UpperLeg", { reach + 0.5, height, 0.1 }, { (reach - 0.5) / 2, y, -drop }, "Fabric", color),
+		Kit.box("UpperLeg", { reach + 0.5, height, 0.1 }, { (reach - 0.5) / 2, y, drop }, "Fabric", color),
+		Kit.box("UpperLeg", { 0.1, height, 2 * drop + 0.1 }, { reach - 0.05, y, 0 }, "Fabric", color),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice over the torso.
+			Kit.box("UpperTorso", { 2.08, 1.62, 1.08 }, { 0, 0, 0 }, "Fabric", c.noir),
+			-- Lacing up the front: two crossed pairs in crimson.
+			Kit.box("UpperTorso", { 0.38, 0.08, 0.05 }, { 0, 0.36, -0.56 }, "Fabric", c.crimson, { 0, 0, 26 }),
+			Kit.box("UpperTorso", { 0.38, 0.08, 0.05 }, { 0, 0.36, -0.56 }, "Fabric", c.crimson, { 0, 0, -26 }),
+			Kit.box("UpperTorso", { 0.38, 0.08, 0.05 }, { 0, -0.04, -0.56 }, "Fabric", c.crimson, { 0, 0, 26 }),
+			Kit.box("UpperTorso", { 0.38, 0.08, 0.05 }, { 0, -0.04, -0.56 }, "Fabric", c.crimson, { 0, 0, -26 }),
+			-- The flat collar over the shoulders, edged in crimson. It stays
+			-- inside the torso's width, so it never broadens the shoulder line.
+			Kit.box("UpperTorso", { 1.5, 0.14, 1.04 }, { 0, 0.84, 0 }, "Fabric", c.noir),
+			Kit.box("UpperTorso", { 1.52, 0.05, 1.06 }, { 0, 0.92, 0 }, "Fabric", c.crimson),
+			-- The bow at the throat, on the neckline.
+			Kit.box("UpperTorso", { 0.14, 0.12, 0.1 }, { 0, 0.7, -0.56 }, "Fabric", c.crimson),
+			Kit.box("UpperTorso", { 0.24, 0.1, 0.08 }, { 0.17, 0.71, -0.56 }, "Fabric", c.crimson, { 0, 0, -18 }),
+			Kit.box("UpperTorso", { 0.24, 0.1, 0.08 }, { -0.17, 0.71, -0.56 }, "Fabric", c.crimson, { 0, 0, 18 }),
+			Kit.box("UpperTorso", { 0.07, 0.18, 0.05 }, { -0.06, 0.55, -0.565 }, "Fabric", c.crimsonDeep, { 0, 0, 6 }),
+			Kit.box("UpperTorso", { 0.07, 0.18, 0.05 }, { 0.06, 0.55, -0.565 }, "Fabric", c.crimsonDeep, { 0, 0, -6 }),
+			-- The waist: black under the bodice's line, a crimson ribbon belt,
+			-- and the big bow behind. Nothing here reaches below the waist.
+			Kit.box("LowerTorso", { 2.08, 0.4, 1.06 }, { 0, 0, 0 }, "Fabric", c.noir),
+			Kit.box("LowerTorso", { 2.14, 0.1, 1.1 }, { 0, 0.06, 0 }, "Fabric", c.crimson),
+			Kit.box("LowerTorso", { 0.26, 0.24, 0.14 }, { 0, 0.14, 0.6 }, "Fabric", c.crimson),
+			Kit.box("LowerTorso", { 0.6, 0.24, 0.12 }, { 0.42, 0.16, 0.62 }, "Fabric", c.crimson, { 0, 0, -14 }),
+			Kit.box("LowerTorso", { 0.6, 0.24, 0.12 }, { -0.42, 0.12, 0.62 }, "Fabric", c.crimson, { 0, 0, 16 }),
+			-- The upper sleeves, close to the arm, with the crimson band at the
+			-- elbow where the bell sleeve (ClassicSleeves) takes over. The
+			-- sleeve rises just over the top of the arm so no bare shoulder
+			-- shows at the high camera, still inside the shoulder line.
+			Kit.box("UpperArm", { 1.14, 1.24, 1.14 }, { 0, 0, 0 }, "Fabric", c.noir),
+			Kit.box("UpperArm", { 1.16, 0.1, 1.16 }, { 0, -0.56, 0 }, "Fabric", c.crimson),
+		},
+		-- The skirt's top tiers, hung from the thighs. Each is wider than the
+		-- one above, so the hem is the widest thing on the figure.
+		tier(0.75, 0.42, 0.62, 0.57, c.crimson),
+		tier(0.42, 0.26, 0.72, 0.62, c.cream),
+		tier(0.26, -0.05, 0.88, 0.7, c.noir),
+		tier(-0.05, -0.5, 1.1, 0.82, c.noir),
+	}),
+}
+
+return look
