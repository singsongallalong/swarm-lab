+-- below the elbow, and kept close, so the shoulder line and waist stay narrow.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Black habit wool and its folds, warm bone wimple linen and the stained-glass
+-- violet lining at the cuff.
+local c = {
+	habit = { 26, 25, 30 },
+	habitFold = { 39, 38, 46 },
+	wimple = { 184, 172, 144 },
+	violet = { 100, 74, 124 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FloodchoirNunSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The sleeve gathers at the elbow under a pale band.
+		Kit.box("LowerArm", { 1.02, 0.3, 1.02 }, { 0, 0.45, 0 }, "Fabric", c.habit),
+		Kit.box("LowerArm", { 1.04, 0.06, 1.04 }, { 0, 0.58, 0 }, "Fabric", c.wimple),
+		-- Then bells out in two modest steps to the wrist.
+		Kit.box("LowerArm", { 1.1, 0.4, 1.1 }, { 0, 0.16, 0 }, "Fabric", c.habitFold),
+		Kit.box("LowerArm", { 1.22, 0.5, 1.22 }, { 0, -0.25, 0 }, "Fabric", c.habit),
+		-- A violet lining peeks below the black, above the pale lace.
+		Kit.box("LowerArm", { 1.24, 0.08, 1.24 }, { 0, -0.41, 0 }, "Fabric", c.violet),
+		Kit.box("LowerArm", { 1.26, 0.1, 1.26 }, { 0, -0.49, 0 }, "Fabric", c.wimple),
+		-- Close gloves, with a violet stone on each hand.
+		Kit.box("Hand", { 1.06, 0.38, 1.06 }, { 0, 0, 0 }, "Fabric", c.habitFold),
+		Kit.box("Hand", { 0.14, 0.14, 0.06 }, { 0, 0.02, -0.53 }, "Fabric", c.violet),
+	},
+}
+
+return look
