# Copy to .env (gitignored) and fill in the providers you use.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
# Claude Code refuses --permission-mode bypassPermissions as root unless the
# machine says it is a sandbox. Generators run in throwaway worktrees inside a
# container, so set this there, and only there.
IS_SANDBOX=1
