# Copy this file to .env (same folder) and fill in the providers you use.
# .env is gitignored; every `python3 -m swarm ...` command reads it on start.
# One NAME=value per line, no spaces around =, no quotes needed.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
# Only for the Claude control arm:
ANTHROPIC_API_KEY=
# Claude Code refuses --permission-mode bypassPermissions as root unless the
# machine says it is a sandbox. Generators run in throwaway worktrees inside a
# container, so set this there, and only there.
IS_SANDBOX=1
