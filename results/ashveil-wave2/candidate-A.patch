+local charcoalDark = { 38, 36, 43 }
+local violet = { 108, 80, 134 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "AshveilHelm",
+	slot = "Helm",
+	parts = {
+		-- The circlet: a thin band round the crown, not a plate over it.
+		Kit.box("Head", { 1.28, 0.08, 0.06 }, { 0, 0.42, -0.63 }, "Fabric", charcoal),
+		Kit.box("Head", { 1.28, 0.08, 0.06 }, { 0, 0.42, 0.63 }, "Fabric", charcoal),
+		Kit.box("Head", { 0.06, 0.08, 1.28 }, { 0.63, 0.42, 0 }, "Fabric", charcoal),
+		Kit.box("Head", { 0.06, 0.08, 1.28 }, { -0.63, 0.42, 0 }, "Fabric", charcoal),
+		-- Three narrow tines rising from the circlet, violet only on their tips.
+		Kit.box("Head", { 0.09, 0.66, 0.09 }, { 0, 0.78, -0.6 }, "Fabric", charcoalDark),
+		Kit.box("Head", { 0.08, 0.48, 0.08 }, { 0.34, 0.69, -0.6 }, "Fabric", charcoalDark),
+		Kit.box("Head", { 0.08, 0.48, 0.08 }, { -0.34, 0.69, -0.6 }, "Fabric", charcoalDark),
+		Kit.box("Head", { 0.13, 0.09, 0.13 }, { 0, 1.14, -0.6 }, "Fabric", violet),
+		Kit.box("Head", { 0.12, 0.08, 0.12 }, { 0.34, 0.96, -0.6 }, "Fabric", violet),
+		Kit.box("Head", { 0.12, 0.08, 0.12 }, { -0.34, 0.96, -0.6 }, "Fabric", violet),
+		-- A smoke-pale veil falling down the back to the shoulders.
+		Kit.box("Head", { 1.1, 1.05, 0.05 }, { 0, 0.17, 0.66 }, "Fabric", ash, { 6, 0, 0 }),
+	},
+}
+
+return look
