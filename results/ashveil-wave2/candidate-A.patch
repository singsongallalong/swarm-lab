+--!strict
+-- The Ashveil dress (Ashveil, the Ashfields' epic gown): the bodice and upper
+-- skirt. A fitted charcoal bodice over an ash stomacher laced in black, a bone
+-- belt at the waist with the one violet ember, and a big ash bow at the small
+-- of the back. The gown's skirt is ash grey, hung from each thigh and flaring
+-- from under the belt, one hip burnt through to black; it widens onto the
+-- shins below (AshveilHem), tier on tier, to the widest thing on the figure.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local ash = { 146, 140, 142 } -- the gown's own cloth, pale enough to read at the high camera
+local charcoal = { 58, 55, 62 }
+local charcoalDark = { 38, 36, 43 }
+local char = { 24, 23, 28 } -- burnt through to black
+local bone = { 188, 180, 162 } -- the one white accent, at the waist
+local ember = { 172, 104, 226 } -- Neon, the one gem
+
+-- The upper skirt is written for the right thigh and mirrored. Its inner edge
+-- sits on the body's centre line, so the two legs meet as one skirt standing.
+local SKIRT_W = 1.2
+local SKIRT_X = SKIRT_W / 2 - 0.5
+local SKIRT_Y = 0.08
+local SKIRT_H = 1.32
+local SKIRT_Z = 0.65
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "AshveilDress",
+	slot = "Chest",
+	parts = {
+		-- The fitted charcoal bodice over an ash stomacher, laced in black.
+		Kit.box("UpperTorso", { 2.08, 1.62, 1.16 }, { 0, 0, 0 }, "Fabric", charcoal),
+		Kit.box("UpperTorso", { 1.34, 1.0, 0.06 }, { 0, 0.05, -0.6 }, "Fabric", ash),
+		Kit.box("UpperTorso", { 1.44, 0.09, 0.06 }, { 0, 0.6, -0.6 }, "Fabric", ash),
+		Kit.box("UpperTorso", { 1.34, 0.12, 1.06 }, { 0, 0.78, 0 }, "Fabric", ash),
+		Kit.box("UpperTorso", { 0.36, 0.045, 0.04 }, { 0, 0.32, -0.65 }, "Fabric", charcoalDark, { 0, 0, 14 }),
+		Kit.box("UpperTorso", { 0.36, 0.045, 0.04 }, { 0, 0.16, -0.65 }, "Fabric", charcoalDark, { 0, 0, -14 }),
+		Kit.box("UpperTorso", { 0.36, 0.045, 0.04 }, { 0, 0, -0.65 }, "Fabric", charcoalDark, { 0, 0, 14 }),
+		-- The waist pulled in under a bone belt, with the one violet ember.
+		Kit.box("LowerTorso", { 2.16, 0.26, 1.18 }, { 0, 0.07, 0 }, "Fabric", bone),
+		Kit.box("LowerTorso", { 0.16, 0.14, 0.06 }, { 0, 0.07, -0.62 }, "Neon", ember),
+		-- A big ash bow at the small of the back, where the high camera looks.
+		Kit.box("UpperTorso", { 0.5, 0.34, 0.14 }, { 0.27, -0.45, 0.57 }, "Fabric", ash, { 0, 0, 18 }),
+		Kit.box("UpperTorso", { 0.5, 0.34, 0.14 }, { -0.27, -0.45, 0.57 }, "Fabric", ash, { 0, 0, -18 }),
+		Kit.box("UpperTorso", { 0.18, 0.2, 0.16 }, { 0, -0.45, 0.6 }, "Fabric", charcoalDark),
+		-- The upper sleeves sit dark and close; the volume waits at the cuff.
+		Kit.box("UpperArm", { 1.02, 1.2, 1.02 }, { 0, 0, 0 }, "Fabric", charcoalDark),
+		-- The skirt's upper tier, ash grey, flaring from under the belt.
+		Kit.box("UpperLeg", { SKIRT_W, SKIRT_H, 0.06 }, { SKIRT_X, SKIRT_Y, -SKIRT_Z }, "Fabric", ash),
+		Kit.box("UpperLeg", { SKIRT_W, SKIRT_H, 0.06 }, { SKIRT_X, SKIRT_Y, SKIRT_Z }, "Fabric", ash),
+		Kit.box("UpperLeg", { 0.06, SKIRT_H, 2 * SKIRT_Z + 0.06 }, { SKIRT_W - 0.53, SKIRT_Y, 0 }, "Fabric", ash),
+		-- The fire took the right hip through to black.
+		Kit.box(
+			"UpperLeg",
+			{ 0.44, 0.56, 0.03 },
+			{ 0.36, -0.16, -SKIRT_Z - 0.045 },
+			"Fabric",
+			char,
+			{ 0, 0, -9 },
+			"Right"
+		),
+	},
+}
+
+return look
