+--!strict
+-- The Ashveil hem (Ashveil, the Ashfields' epic gown): the lower skirt and
+-- shoes. The ash bell is carried down each shin and burnt black at the bottom,
+-- each tier clearly wider than the one above until the hem is the widest thing
+-- on the figure, gathered into one glowing violet seam. A dark stocking and
+-- slim slippers wait beneath; the fire took one shin through to black.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local ash = { 146, 140, 142 }
+local charcoal = { 58, 55, 62 }
+local charcoalDark = { 38, 36, 43 }
+local char = { 24, 23, 28 }
+local ember = { 172, 104, 226 }
+
+-- Each tier is written for the right shin and mirrored; its inner edge sits on
+-- the body's centre line, so the two legs meet as one skirt standing. W, X and
+-- Z grow with each tier so the bell flares all the way round.
+local T1_W, T1_X, T1_Y, T1_H, T1_Z = 1.5, 0.25, 0.26, 0.72, 0.775
+local T2_W, T2_X, T2_Y, T2_H, T2_Z = 1.85, 0.425, -0.27, 0.34, 0.9
+local T3_W, T3_X, T3_Y, T3_H, T3_Z = 2.25, 0.625, -0.59, 0.3, 1.025
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "AshveilHem",
+	slot = "Boots",
+	parts = {
+		-- A dark stocking under it all, so no bare shin shows through the slit.
+		Kit.box("LowerLeg", { 1.08, 1.2, 1.08 }, { 0, 0, 0 }, "Fabric", charcoalDark),
+		-- The top tier, carried on from the dress's panels above the knee.
+		Kit.box("LowerLeg", { T1_W, T1_H, 0.06 }, { T1_X, T1_Y, -T1_Z }, "Fabric", ash),
+		Kit.box("LowerLeg", { T1_W, T1_H, 0.06 }, { T1_X, T1_Y, T1_Z }, "Fabric", ash),
+		Kit.box("LowerLeg", { 0.06, T1_H, 2 * T1_Z + 0.06 }, { T1_W - 0.53, T1_Y, 0 }, "Fabric", ash),
+		-- The burnt tiers, each stepped clearly out below the last.
+		Kit.box("LowerLeg", { T2_W, T2_H, 0.06 }, { T2_X, T2_Y, -T2_Z }, "Fabric", charcoal),
+		Kit.box("LowerLeg", { T2_W, T2_H, 0.06 }, { T2_X, T2_Y, T2_Z }, "Fabric", charcoal),
+		Kit.box("LowerLeg", { 0.06, T2_H, 2 * T2_Z + 0.06 }, { T2_W - 0.53, T2_Y, 0 }, "Fabric", charcoal),
+		Kit.box("LowerLeg", { T3_W, T3_H, 0.07 }, { T3_X, T3_Y, -T3_Z }, "Fabric", charcoalDark),
+		Kit.box("LowerLeg", { T3_W, T3_H, 0.07 }, { T3_X, T3_Y, T3_Z }, "Fabric", charcoalDark),
+		Kit.box("LowerLeg", { 0.07, T3_H, 2 * T3_Z + 0.07 }, { T3_W - 0.54, T3_Y, 0 }, "Fabric", charcoalDark),
+		-- One glowing seam all round the hem, the only violet light on the gown.
+		Kit.box("LowerLeg", { T3_W + 0.02, 0.05, 0.09 }, { T3_X, -0.725, -T3_Z - 0.02 }, "Neon", ember),
+		Kit.box("LowerLeg", { T3_W + 0.02, 0.05, 0.09 }, { T3_X, -0.725, T3_Z + 0.02 }, "Neon", ember),
+		Kit.box("LowerLeg", { 0.09, 0.05, 2 * T3_Z + 0.09 }, { T3_W - 0.535, -0.725, 0 }, "Neon", ember),
+		-- The fire took one shin's hem through to black.
+		Kit.box("LowerLeg", { 0.46, 0.44, 0.03 }, { 0.55, 0.16, -T1_Z - 0.045 }, "Fabric", char, { 0, 0, -8 }, "Right"),
+		-- Slim charcoal slippers, just showing under the bell.
+		Kit.box("Foot", { 1.08, 0.34, 1.12 }, { 0, 0.02, -0.04 }, "Leather", charcoalDark),
+	},
+}
+
+return look
