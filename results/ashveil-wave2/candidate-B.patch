+		Kit.box("UpperTorso", { 0.62, 0.54, 0.14 }, { -0.42, 0.22, -0.55 }, "Fabric", ash, { 0, 0, -4 }),
+		Kit.box("UpperTorso", { 0.62, 0.54, 0.14 }, { 0.42, 0.22, -0.55 }, "Fabric", ash, { 0, 0, 4 }),
+		Kit.box("UpperTorso", { 1.12, 0.9, 1.08 }, { 0.44, -0.34, 0 }, "Fabric", charcoal, { 0, 0, -8 }),
+		-- The violet V at the collarbones, the bone stomacher and its seam,
+		-- and the bone band under the bust.
+		Kit.box("UpperTorso", { 0.72, 0.07, 0.06 }, { -0.48, 0.7, -0.56 }, "Fabric", violet, { 0, 0, -10 }),
+		Kit.box("UpperTorso", { 0.72, 0.07, 0.06 }, { 0.48, 0.7, -0.56 }, "Fabric", violet, { 0, 0, 10 }),
