diff --git a/src/shared/data/outdoorTilesets/Blightfen.luau b/src/shared/data/outdoorTilesets/Blightfen.luau
new file mode 100644
index 0000000..0d91bb3
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Blightfen.luau
@@ -0,0 +1,268 @@
+--!strict
+-- The Blightfen: a plague bog at night, farmland drowned and poisoned after a
+-- sickness emptied it. The moor's generated layouts in the bog's paint: its
+-- heath dead grey-olive grass over brown-black mud, its cliffs, outcrops and
+-- the bluff wet stained rock, its thickets dead orchard trees, its road the
+-- farms' track between drowned fields, and standing water gone sick green
+-- under a low miasma. Its heath dressing is the farmland's own: reeds in the
+-- wet hollows, rotten wells and haystacks by the way, dead orchard trees out
+-- on the open ground, and one drowned chapel tower standing clear of them
+-- all as the landmark that pulls a player across it (bible B11). Its one
+-- muted accent (B8) is the bile yellow-green the sickness left, on the
+-- reeds' tips, the pool water and the threshold stone's rag; the only warmth
+-- is the few amber lamps the living left.
+-- Deriving from Moor keeps its cliffs, drops and site layouts, so this look
+-- works over any seed the same way the moor's does.
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- The bog's ground by terrain material, as Field paints its living ground:
+-- Terrain keeps one colour per material, so every look on a material moves
+-- together (OutdoorTilesets.spec). All inside the bible's large-surface caps
+-- (20% saturation, 35% value).
+local BOG: { [string]: { number } } = {
+	Grass = { 62, 61, 53 }, -- dead grey-olive grass; Roblox's blades take it
+	Ground = { 64, 60, 52 }, -- brown mud, packed on the farms' old track
+	LeafyGrass = { 50, 52, 44 }, -- the wet margin under the rim
+	Mud = { 42, 40, 34 }, -- bare bog mud: ruins, thicket floors, pool beds
+	Basalt = { 48, 52, 46 }, -- wet stained rock: cliffs, outcrops, the bluff
+	Slate = { 18, 20, 18 }, -- the abyss
+}
+
+local function bogged(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = BOG[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- Palette paint for the pieces. Unpainted meshes sit near the top of the
+-- bible's value range as the moor's do: darker, and they lose their facets
+-- under the mood preset.
+local WET_ROCK = { 58, 63, 54 }
+local ROTTEN_BARK = { 52, 47, 41 }
+
+-- The rim's cliffs, the moor's own generated meshes in the bog's wet rock.
+local CLIFF_PIECES: { OutdoorTypes.PieceLook } = {
+	{
+		name = "BogCliff_A",
+		solid = true,
+		size = { 11.5, 14.1, 11.2 },
+		mesh = "rbxassetid://88803966022882",
+		material = "Basalt",
+		color = WET_ROCK,
+	},
+	{
+		name = "BogCliff_C",
+		solid = true,
+		size = { 11.9, 13.9, 11 },
+		mesh = "rbxassetid://107901875206013",
+		material = "Basalt",
+		color = WET_ROCK,
+	},
+	{
+		name = "BogCliff_B",
+		solid = true,
+		size = { 10.9, 13.2, 11 },
+		mesh = "rbxassetid://135099886431080",
+		material = "Basalt",
+		color = WET_ROCK,
+		weight = 0.5,
+	},
+}
+
+-- The thickets: the moor's dead trees, waterlogged, among them a few of the
+-- orchard's own bare sculpt trees.
+local TREE_PIECES: { OutdoorTypes.PieceLook } = {
+	{
+		name = "DeadTree_A",
+		size = { 7, 8.5, 6.3 },
+		mesh = "rbxassetid://135311611772489",
+		material = "Wood",
+		color = ROTTEN_BARK,
+	},
+	{
+		name = "DeadTree_B",
+		size = { 7, 10, 4.5 },
+		mesh = "rbxassetid://138056933645574",
+		material = "Wood",
+		color = ROTTEN_BARK,
+	},
+	{ name = "OrchardTree", size = Sculpts.blightfen_dead_tree.size, sculpt = "blightfen_dead_tree", weight = 0.4 },
+}
+
+local MOOR_EDGES: { [string]: OutdoorTypes.EdgeLook } = Moor.edges :: any
+local MOOR_PROPS: { [string]: OutdoorTypes.PropSet } = Moor.props :: any
+
+-- The rim, the thickets and the old field walls, their ground in the bog's
+-- mud and rock.
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(MOOR_EDGES)
+edges.cliff = with(MOOR_EDGES.cliff, { pieces = CLIFF_PIECES })
+edges.thicket = with(MOOR_EDGES.thicket, { pieces = TREE_PIECES })
+-- The farms' dry-stone walls, not the field's town wall.
+edges.ruin_wall = with(MOOR_EDGES.ruin_wall, { run = "moor_field_wall" })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = bogged(edge.ground) })
+	end
+end
+
+local props: { [string]: OutdoorTypes.PropSet } = table.clone(MOOR_PROPS)
+-- Reeds where the moor's heather stood: dead grey-olive clumps, each one
+-- union, standing over the grass blades.
+props.heather = with(MOOR_PROPS.heather, {
+	pieces = { { name = "Reeds", size = Sculpts.blightfen_reeds.size, sculpt = "blightfen_reeds" } },
+	perHundredCells = 3.5,
+	scale = { 0.85, 1.25 },
+	sink = 0.3,
+})
+-- The graveyards' stones stained by the water.
+props.headstones = with(MOOR_PROPS.headstones, {
+	pieces = {
+		{ name = "BogHeadstone", size = Sculpts.blightfen_headstone.size, sculpt = "blightfen_headstone" },
+	},
+})
+-- Fewer grave lanterns than the moor's: someone still tends the dead, barely.
+props.candles = with(MOOR_PROPS.candles, { perHundredCells = 4 })
+-- The road's lamps farther apart: an emptier land, and fewer lights.
+props.lanterns = with(MOOR_PROPS.lanterns, { perHundredCells = 1.8, spacing = 90 })
+-- The farms' well and haystack rotting by the way: the drowned farmsteads'
+-- own furniture, turned to the road (FaceRoad), one of them at least.
+local waysides: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "DrownedWell", size = Sculpts.blightfen_well.size, sculpt = "blightfen_well" },
+		{ name = "RottenHaystack", size = Sculpts.blightfen_haystack.size, sculpt = "blightfen_haystack" },
+	},
+	perHundredCells = 0,
+	count = 4,
+	on = { "roadside" :: OutdoorTypes.PropGround },
+	spacing = 110,
+	faceRoad = true,
+	quiet = true,
+	least = 1,
+	scale = { 0.95, 1.1 },
+	sink = 0.3,
+}
+props.waysides = table.freeze(waysides)
+-- The dead orchards: bare fruit trees standing where the rows were, out on
+-- the open heath, well off the road and the fights.
+local orchards: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "OrchardTree", size = Sculpts.blightfen_dead_tree.size, sculpt = "blightfen_dead_tree" },
+	},
+	perHundredCells = 0,
+	count = 8,
+	spacing = 30,
+	clearance = 2,
+	quiet = true,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.9, 1.2 },
+	sink = 0.5,
+}
+props.orchards = table.freeze(orchards)
+-- The zone's landmark: one drowned chapel tower on the open ground, clear of
+-- the way and the walls (B11), so it shows from across the whole bog.
+local chapel: OutdoorTypes.PropSet = {
+	pieces = { { name = "DrownedChapel", size = Sculpts.blightfen_chapel.size, sculpt = "blightfen_chapel" } },
+	perHundredCells = 0,
+	count = 1,
+	clearance = 5,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 1, 1.1 },
+	sink = 1,
+}
+props.chapel = table.freeze(chapel)
+props.boulders = with(MOOR_PROPS.boulders, {
+	pieces = {
+		{
+			name = "Boulder_B",
+			solid = true,
+			size = { 4.7, 4.2, 4.3 },
+			mesh = "rbxassetid://122358673773444",
+			material = "Basalt",
+			color = WET_ROCK,
+		},
+	},
+})
+-- No banked fires in the ruins: the bog's warmth is the road's lamps and the
+-- grave lanterns alone. No cave mouths either: the drowned farms' way down
+-- was their cellars.
+local looseProps: any = props
+looseProps.embers = nil
+looseProps.caves = nil
+-- The High Moor's tower and stone circles are the moor's own landmarks; the
+-- chapel stands in their place here.
+looseProps.watchtower = nil
+looseProps.stone_circles = nil
+
+local blightfen = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+blightfen.name = "blightfen"
+blightfen.palette = "brown-black bog mud, dead grey-olive reeds and grass, rotten grey-brown timber, "
+	.. "wet stained slate and basalt, sick yellow-green standing water, few amber lamps, "
+	.. "desaturated, matte, no highlights"
+blightfen.lighting = "mood"
+blightfen.ground = with(Moor.ground, {
+	heath = bogged(Moor.ground.heath),
+	road = bogged(Moor.ground.road),
+	ruin = bogged(Moor.ground.ruin),
+})
+blightfen.edges = table.freeze(edges) :: any
+blightfen.outcrop = with(Moor.outcrop, { pieces = CLIFF_PIECES, ground = bogged(Moor.outcrop.ground) })
+blightfen.props = table.freeze(props)
+-- Low and wide over the bog, green-grey off the standing water rather than
+-- the moor's blue (B9).
+blightfen.groundMist = with(Moor.groundMist, {
+	color = { 118, 126, 104 },
+	perHundredCells = 0.9,
+	spacing = 42,
+	size = 26,
+	transparency = 0.83,
+})
+-- The milestone at each cleft carries the bog's own rag, in the zone accent.
+blightfen.thresholds = with(Moor.thresholds :: any, {
+	marker = {
+		name = "BlightMarker",
+		size = Sculpts.blightfen_marker.size,
+		sculpt = "blightfen_marker",
+		solid = true,
+	},
+})
+local moorPools = Moor.pools
+if moorPools then
+	blightfen.pools = with(moorPools, {
+		sheet = { name = "SickPool", size = Sculpts.blightfen_pool.size, sculpt = "blightfen_pool" },
+		bed = bogged(moorPools.bed),
+	})
+end
+local bluff = Moor.bluff
+local bluffRock = bluff and bluff.rock
+if bluff and bluffRock then
+	blightfen.bluff = with(bluff, {
+		-- The wall's rubble core, wet green-grey behind the stones.
+		backing = { material = "Slate", color = { 66, 72, 62 } },
+		rock = bogged(bluffRock),
+	})
+end
+-- Past every edge the bog climbs away in low hills and runs on into the
+-- haze, so no edge shows sky.
+blightfen.beyond = with(Moor.beyond, {
+	ground = bogged(Moor.beyond.ground),
+	rock = bogged(Moor.beyond.rock),
