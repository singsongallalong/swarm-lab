diff --git a/src/shared/data/outdoorTilesets/Blightfen.luau b/src/shared/data/outdoorTilesets/Blightfen.luau
new file mode 100644
index 0000000..e5102b0
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Blightfen.luau
@@ -0,0 +1,290 @@
+--!strict
+-- The Blightfen (a plague bog): farmland drowned after a sickness emptied it,
+-- where the dead don't stay buried (docs design language: a plague-struck
+-- land with blighted fields, dead orchards, sick green pools and abandoned
+-- farmsteads). Derived from the moor, as the field is: the same pieces, dealt
+-- over a dead, wet palette. Brown-black mud, dead grey-olive reeds and grass,
+-- rotten timber, stained green-grey stone, and one muted accent (bible B8),
+-- a sickly bile yellow-green unlike the Ashfields' violet or the moor's
+-- mauve. Its own are the dead orchard over the heath, scattered graves, a
+-- drowned chapel on the high ground, a few amber lamps the living left, and
+-- a low miasma drifting between the trees (data/SetPieces blightfen_wisps).
+local Field = require("./Field")
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Dead ground by terrain material, as the moor paints its living ground:
+-- Terrain keeps one colour per material, so every look on a material moves
+-- together (OutdoorTilesets.spec). Every one repainted inside the bible's
+-- large-surface caps (saturation under 20%, value under 90).
+local BOG: { [string]: { number } } = {
+	Grass = { 62, 66, 54 }, -- dead grey-olive grass; Roblox's blades take it
+	Ground = { 70, 66, 58 }, -- the old farm track, pale wet clay through the mire
+	LeafyGrass = { 50, 54, 44 }, -- the drowned margin under the walls, and past the rim
+	Mud = { 38, 36, 32 }, -- brown-black bog mud, the ruin floors and the thicket beds
+	Basalt = { 50, 52, 46 }, -- stained, mossy stone: the rims, outcrops and bluffs
+	Slate = { 62, 64, 58 }, -- worked stone gone green-grey in the wet
+}
+
+local function drowned(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = BOG[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- The pieces that carry their own paint: rotten wood for the dead trees, and
+-- stained stone for the moor's meshes, which take Basalt's texture and lift it.
+local ROTTEN_BARK = { 50, 46, 38 }
+local STAINED_ROCK = { 66, 68, 60 }
+
+-- Repaint every plain piece of a list, as the rim cliffs and trees do.
+local function painted(pieces: { OutdoorTypes.PieceLook }, color: { number }): { OutdoorTypes.PieceLook }
+	local out = table.clone(pieces)
+	for i, piece in out do
+		out[i] = with(piece, { color = color })
+	end
+	return table.freeze(out)
+end
+
+local props = table.clone(Moor.props)
+
+-- Reeds in place of the moor's heather: dead grey-olive, standing in the wet
+-- ground over most of the bog. Each clump is one union, so they can be thick.
+props.reeds = with(props.heather, {
+	pieces = { { name = "BogReeds", size = Sculpts.blightfen_reeds.size, sculpt = "blightfen_reeds" } },
+	perHundredCells = 6,
+	scale = { 0.9, 1.3 },
+	sink = 0.4,
+})
+props.heather = nil
+
+-- Graveyards sunk into the mire: mostly the bog's own stained, broken stones,
+-- with a few of the moor's paler ones left standing among them.
+props.headstones = with(props.headstones, {
+	pieces = {
+		{
+			name = "BogHeadstone",
+			size = Sculpts.blightfen_headstone.size,
+			sculpt = "blightfen_headstone",
+			weight = 1.5,
+		},
+		{ name = "Headstone", size = Sculpts.moor_headstone.size, sculpt = "moor_headstone", weight = 0.7 },
+		{
+			name = "HeadstoneBroken",
+			size = Sculpts.moor_headstone_broken.size,
+			sculpt = "moor_headstone_broken",
+			weight = 0.5,
+		},
+	},
+	perHundredCells = 26,
+})
+-- Fewer grave lanterns than the moor's: nobody comes to tend these any more.
+props.candles = with(props.candles, { perHundredCells = 3 })
+-- The road is barely walked: a lamp every long stretch, the living's last warmth.
+props.lanterns = with(props.lanterns, { perHundredCells = 1.2, spacing = 150 })
+-- A rare banked fire in a ruin: someone, or something, sheltering in the bog.
+props.embers = with(props.embers, { perHundredCells = 0.8 })
+
+-- The drowned chapel: the moor's watchtower stand-in, one a map, so a broken
+-- tower stands over the dead orchard from the arrival (B11). Not scoped to a
+-- reach, so it is the bog's landmark on every seed and in every dressing.
+local chapel: OutdoorTypes.PropSet = {
+	pieces = { { name = "DrownedChapel", size = Sculpts.blightfen_chapel.size, sculpt = "blightfen_chapel" } },
+	perHundredCells = 0,
+	count = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	clearance = 6,
+	scale = { 0.95, 1.05 },
+	sink = 0.6,
+}
+props.chapel = table.freeze(chapel)
+props.watchtower = nil
+
+-- The dead orchard (the direction's centre): the moor's own tree meshes, now
+-- in rotten bark, scattered wide over the open heath so their bare crowns
+-- read as an orchard from the game camera, with now and then a sculpted tree
+-- for the gnarled ones. Meshes, so a whole orchard costs a part a tree.
+local orchard: OutdoorTypes.PropSet = {
+	pieces = {
+		with(Moor.edges.thicket.pieces[1], { name = "OrchardTree", color = ROTTEN_BARK }),
+		with(Moor.edges.thicket.pieces[2], { name = "OrchardTreeBent", color = ROTTEN_BARK }),
+		{
+			name = "OrchardTreeSculpt",
+			size = Sculpts.blightfen_orchard_tree.size,
+			sculpt = "blightfen_orchard_tree",
+			weight = 0.35,
+		},
+	},
+	perHundredCells = 1.6,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 24,
+	scale = { 1.2, 2 },
+	sink = 0.6,
+}
+props.orchard = table.freeze(orchard)
+
+-- Scattered graves out on the heath, off the road and the fights: the dead
+-- buried where they fell, not in a yard (the brief: scattered graves).
+local graves: OutdoorTypes.PropSet = {
+	pieces = { { name = "BogGrave", size = Sculpts.blightfen_headstone.size, sculpt = "blightfen_headstone" } },
+	perHundredCells = 0,
+	count = 10,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 30,
+	quiet = true,
+	scale = { 0.8, 1.15 },
+	sink = 0.5,
+}
+props.graves = table.freeze(graves)
+
+-- The drowned chapel's broken doorway, standing where its wall fell.
+local chapelArch: OutdoorTypes.PropSet = {
+	pieces = { { name = "ChapelArch", size = Sculpts.blightfen_chapel_arch.size, sculpt = "blightfen_chapel_arch" } },
+	perHundredCells = 0,
+	count = 2,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 110,
+	clearance = 4,
+	quiet = true,
+	scale = { 0.9, 1.1 },
+	sink = 0.5,
+}
+props.chapelArch = table.freeze(chapelArch)
+
+-- The waysides the field put by its road (a well, a cross) survive in the
+-- drowned farms: robbed, leaned, but still there. No haystack: its pale gold
+-- was the brightest thing on the bog, where only the lamps may be warm. And
+-- one stone shrine with its lamp, the one warm stop the living keep (B2).
+props.waysides = with(Field.props.waysides, {
+	pieces = {
+		{ name = "Well", size = Sculpts.field_well.size, sculpt = "field_well" },
+		{ name = "WaysideCross", size = Sculpts.field_cross.size, sculpt = "field_cross" },
+	},
+	count = 3,
+	spacing = 130,
+})
+props.shrine = Field.props.shrine
+
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+-- The rim thicket is the orchard's mass: the same trees, bigger and closer,
+-- in rotten bark, so the dead wood reads along every rim from above.
+local trees = table.clone(edges["thicket"].pieces)
+for i, piece in trees do
+	if piece.sculpt then
+		trees[i] = with(piece, {
+			sculpt = "blightfen_orchard_tree",
+			name = "BogTree",
+			size = Sculpts.blightfen_orchard_tree.size,
+			weight = 0.3,
+		})
+	else
+		trees[i] = with(piece, { color = ROTTEN_BARK })
+	end
+end
+edges["thicket"] = with(edges["thicket"], { pieces = table.freeze(trees), spacing = 7, scale = { 2.2, 3.4 } })
+-- The cliffs are stained stone now, not the moor's blue basalt.
+edges["cliff"] = with(edges["cliff"], { pieces = painted(edges["cliff"].pieces, STAINED_ROCK) })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = drowned(edge.ground) })
+	end
+end
+
+local blight = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+blight.name = "blightfen"
+blight.palette = "brown-black bog mud, dead grey-olive reeds and grass, rotten brown timber, "
+	.. "stained green-grey stone, one sickly bile yellow-green accent, desaturated, matte, no highlights"
+-- The moor's night, which is the game's baseline: a cold moon over a bog.
+blight.lighting = "mood"
+blight.props = table.freeze(props)
+blight.edges = table.freeze(edges) :: any
+
+-- The old paved road is a drowned farm track here: wet clay, paler than the
+-- heath so the way on still reads from above.
+blight.ground = with(Moor.ground, {
+	heath = drowned(Moor.ground.heath),
+	ruin = drowned(Moor.ground.ruin),
+	road = { material = "Ground", color = BOG.Ground },
+})
+blight.outcrop = with(Moor.outcrop, {
+	pieces = painted(Moor.outcrop.pieces, STAINED_ROCK),
+	ground = drowned(Moor.outcrop.ground :: OutdoorTypes.GroundLook),
+})
+local bluffRock = Moor.bluff and Moor.bluff.rock
+if bluffRock then
+	blight.bluff = with(Moor.bluff, {
+		backing = { material = "Slate", color = BOG.Slate },
+		rock = drowned(bluffRock),
+	})
+end
+
+-- Standing water in the bog's hollows is a sheet of sick green, not the
+-- moor's near-black mirror, on the same brown-black mud bed; the causeway
+-- stones are stained like the rest of the stone.
+if Moor.pools then
+	blight.pools = with(Moor.pools, {
+		sheet = { name = "FenPool", size = Sculpts.blightfen_pool.size, sculpt = "blightfen_pool" },
+		bed = drowned(Moor.pools.bed),
+		causeway = with(Moor.pools.causeway, {
+			stones = painted(Moor.pools.causeway.stones, BOG.Slate),
+		}),
+	})
+end
+
+-- The way on between reaches (A012 step 2b): the moor's marker in stained
+-- stone, its rag the zone's bile accent, so the bog's way on reads as its own.
+local thresholds = Moor.thresholds
+if thresholds then
+	blight.thresholds = with(thresholds, {
+		marker = {
+			name = "BogMarker",
+			size = Sculpts.blightfen_waystone.size,
+			sculpt = "blightfen_waystone",
+			solid = true,
+		},
+	})
+end
+
+-- One lit window in the manor, and only sometimes: the living are nearly gone
+-- (bible B2, B7). Door lanterns fewer than the moor's.
+blight.litWindows = with(Moor.litWindows :: any, { count = 1, chance = 0.2 })
+blight.wallLights = with(Moor.wallLights, { chance = 0.2 })
+
+-- Thicker and lower than the moor's, and greener: the bog breathes.
+blight.groundMist = with(Moor.groundMist, {
+	color = { 112, 120, 98 },
+	perHundredCells = 0.7,
+	spacing = 44,
+	size = 26,
+	transparency = 0.84,
+})
+
+-- Closed all round as the Ashfields are (fafwa 2026-10-26): rising land out
+-- to the map's own edge, hills running on past it into the haze, the road's
+-- ends running on as lanes. The abyss below takes the bog's black-green.
+blight.beyond = with(Moor.beyond, {
+	reach = 60,
+	hills = table.freeze({ reach = 80, chunk = 10, height = table.freeze({ 14, 30 }), lane = 4, laneReach = 12 }),
+	ground = drowned(Moor.beyond.ground),
+	rock = drowned(Moor.beyond.rock),
+	abyss = { material = "Slate", color = { 16, 18, 16 } },
+	mist = with(Moor.beyond.mist, { color = { 74, 80, 70 } }),
+})
+
+-- The sickness laid on the map itself: wisps hanging between the orchard
+-- trees, and foul bubbles off the reeds that stand in the bog's wet ground.
+local setPieces: { OutdoorTypes.TilesetPiece } = {
+	{ recipe = "blightfen_wisps", along = "pieces", on = "prop:orchard", every = 55, count = 6, lift = 1 },
+	{ recipe = "blightfen_fen_bubbles", along = "pieces", on = "prop:reeds", every = 80, count = 4, lift = 0.5 },
+}
+blight.setPieces = table.freeze(setPieces)
+
+return table.freeze(blight)
