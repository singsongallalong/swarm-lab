diff --git a/src/shared/data/outdoorTilesets/Blightfen.luau b/src/shared/data/outdoorTilesets/Blightfen.luau
new file mode 100644
index 0000000..8ea310e
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Blightfen.luau
@@ -0,0 +1,356 @@
+--!strict
+-- Blightfen: a plague bog at night. Farmland drowned and poisoned after a
+-- sickness emptied it, where the dead don't stay buried. The moor's bones are
+-- all here, painted brown-black mud and dead grey-olive; one muted accent, a
+-- sickly desaturated yellow-green, on the rags, the vault's door and the
+-- water; the only warmth is a few amber lamps the living left. Its landmark is
+-- the plague pit, a ring of leaning headstones round a hollow, with a drowned
+-- chapel above it and gibbets along the road in; the pit's foul light rises as
+-- a set piece (data/SetPieces blightfen_miasma).
+local LightingPresets = require("../LightingPresets")
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Bog ground by terrain material, as Field2 paints its ash: Terrain keeps one
+-- colour per material, so every look on a material moves together. All of it
+-- inside the bible's large-surface caps (saturation at most 20%, value at
+-- most 35%).
+local BOG: { [string]: { number } } = {
+	Grass = { 54, 58, 48 }, -- dead grey-olive grass; Roblox's blades take it
+	Ground = { 68, 65, 56 }, -- the churned track, paler so it reads as the way on
+	LeafyGrass = { 50, 54, 44 }, -- the drowned turf of the rising ground
+	Mud = { 40, 37, 33 }, -- brown-black earth under the thickets and walls
+	Basalt = { 58, 60, 56 }, -- stained grey-green stone
+}
+
+local function bogged(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = BOG[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- Rotten timber and stained stone for the pieces we paint rather than sculpt.
+local ROT_BARK = { 44, 38, 33 }
+local STAINED = { 62, 64, 60 }
+local STAINED_DARK = { 56, 58, 54 }
+
+local props = table.clone(Moor.props)
+-- Dead reeds in place of the moor's heather: the whole bog floor is a reedbed,
+-- denser and larger than the moor's clumps (each is one merged union).
+props.heather = with(props.heather, {
+	pieces = { { name = "Reeds", size = Sculpts.blightfen_reed.size, sculpt = "blightfen_reed" } },
+	perHundredCells = 8,
+	scale = { 1, 1.4 },
+})
+-- Stained headstones, most of them broken: the graveyards have filled up.
+props.headstones = with(props.headstones, {
+	pieces = {
+		{ name = "BogHeadstone", size = Sculpts.blightfen_headstone.size, sculpt = "blightfen_headstone" },
+		{
+			name = "BogHeadstoneBroken",
+			size = Sculpts.blightfen_headstone_broken.size,
+			sculpt = "blightfen_headstone_broken",
+			weight = 0.7,
+		},
+	},
+})
+-- The grave lanterns' stakes gone black with rot; their flames stay amber.
+props.candles = with(props.candles, {
+	pieces = { with(Moor.props.candles.pieces[1], { color = { 48, 44, 38 } }) },
+})
+-- Fewer road lamps than the moor's: the sick left in a hurry.
+props.lanterns = with(props.lanterns, { spacing = 95 })
+-- Nearly no fires in the ruins: the bog is cold.
+props.embers = with(props.embers, { perHundredCells = 1 })
+-- The broken watchtower becomes the drowned chapel above the bog: one tall
+-- silhouette to steer by, its one window lit warm (B2, B3). Built afresh
+-- rather than cloned: the moor's set is bound to the High Moor reach, and a
+-- map dressed without spans never places a reach-bound piece.
+local chapel: OutdoorTypes.PropSet = {
+	pieces = {
+		{
+			name = "DrownedChapel",
+			size = Sculpts.blightfen_chapel.size,
+			sculpt = "blightfen_chapel",
+			light = {
+				color = { 255, 168, 88 },
+				range = 30,
+				brightness = 1.4,
+				height = 24,
+				ember = 0.5,
+				pulse = { style = "flicker", depth = 0.1, period = 2.2 },
+			},
+		},
+	},
+	perHundredCells = 0,
+	count = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	clearance = 3,
+	scale = { 0.95, 1.05 },
+	sink = 0.5,
+}
+props.watchtower = table.freeze(chapel)
+-- The stone circle becomes the plague pit: one ring of leaning headstones on
+-- the open ground, the map's landmark (the miasma set piece rises from it).
+-- Afresh too, for the same reason.
+local pit: OutdoorTypes.PropSet = {
+	pieces = { { name = "PlaguePit", size = Sculpts.blightfen_pit_ring.size, sculpt = "blightfen_pit_ring" } },
+	perHundredCells = 0,
+	count = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 140,
+	clearance = 3,
+	scale = { 0.9, 1.1 },
+	sink = 0.4,
+}
+props.stone_circles = table.freeze(pit)
+-- A boarded barrow instead of a cave: where they sealed the plague dead in.
+-- Afresh, so it isn't bound to the moor's reaches.
+local barrow: OutdoorTypes.PropSet = {
+	pieces = { { name = "PlagueBarrow", size = Sculpts.blightfen_barrow.size, sculpt = "blightfen_barrow" } },
+	perHundredCells = 0,
+	count = 1,
+	on = { "cliffside" :: OutdoorTypes.PropGround },
+	backToCliff = true,
+	scale = { 1, 1.15 },
+	sink = 0.3,
+}
+props.caves = table.freeze(barrow)
+-- Boulders in the bog's stained stone, not the moor's blue-grey.
+props.boulders = with(props.boulders, {
+	pieces = { with(Moor.props.boulders.pieces[1], { color = STAINED }) },
+})
+-- Gibbets on the road in: a rotten timber arm over the way, still warning
+-- travellers off. Quiet, so none stands in a fight, and far apart.
+local gibbets: OutdoorTypes.PropSet = {
+	pieces = { { name = "Gibbet", size = Sculpts.blightfen_gibbet.size, sculpt = "blightfen_gibbet" } },
+	perHundredCells = 0,
+	count = 3,
+	on = { "roadside" :: OutdoorTypes.PropGround },
+	spacing = 130,
+	faceRoad = true,
+	quiet = true,
+	scale = { 0.9, 1.1 },
+	sink = 0.3,
+}
+props.gibbets = table.freeze(gibbets)
+-- Poisoned wells by the way: the sickness got into the water.
+local wells: OutdoorTypes.PropSet = {
+	pieces = { { name = "BogWell", size = Sculpts.blightfen_well.size, sculpt = "blightfen_well" } },
+	perHundredCells = 0,
+	count = 2,
+	on = { "roadside" :: OutdoorTypes.PropGround },
+	spacing = 150,
+	faceRoad = true,
+	quiet = true,
+	scale = { 0.95, 1.1 },
+	sink = 0.2,
+}
+props.wells = table.freeze(wells)
+-- Plague bones out on the heath, wherever the carts were tipped.
+local bones: OutdoorTypes.PropSet = {
+	pieces = { { name = "PlagueBones", size = Sculpts.blightfen_bones.size, sculpt = "blightfen_bones" } },
+	perHundredCells = 0,
+	count = 3,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 140,
+	clearance = 3,
+	quiet = true,
+	scale = { 0.9, 1.1 },
+	sink = 0.5,
+}
+props.bones = table.freeze(bones)
+-- A dead orchard: bare crooked trees out on the drowned fields.
+local orchard: OutdoorTypes.PropSet = {
+	pieces = { { name = "DeadOrchardTree", size = Sculpts.blightfen_dead_tree.size, sculpt = "blightfen_dead_tree" } },
+	perHundredCells = 0,
+	count = 5,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 100,
+	quiet = true,
+	scale = { 1, 1.3 },
+	sink = 0.4,
+}
+props.orchard = table.freeze(orchard)
+
+local bog = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+bog.name = "blightfen"
+bog.palette = "brown-black mud, dead grey-olive reeds and grass, rotten timber, stained grey-green stone, "
+	.. "a sickly desaturated yellow-green accent, amber lamplight, desaturated, matte, no highlights"
+bog.lighting = "mood"
+bog.props = table.freeze(props)
+
+-- The dead trees along the thickets in rotten wood, a few of them the bog's
+-- own crooked orchard tree.
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+local thicketTrees = table.clone(edges["thicket"].pieces)
+for i, piece in thicketTrees do
+	if piece.sculpt then
+		thicketTrees[i] = with(piece, {
+			sculpt = "blightfen_dead_tree",
+			name = "BogTree",
+			size = Sculpts.blightfen_dead_tree.size,
+		})
+	else
+		thicketTrees[i] = with(piece, { color = ROT_BARK })
+	end
+end
+edges["thicket"] = with(edges["thicket"], { pieces = thicketTrees })
+local cliffPieces = table.clone(edges["cliff"].pieces)
+for i, piece in cliffPieces do
+	cliffPieces[i] = with(piece, { color = STAINED })
+end
+edges["cliff"] = with(edges["cliff"], { pieces = cliffPieces })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = bogged(edge.ground) })
+	end
+end
+bog.edges = table.freeze(edges) :: any
+
+local outcropPieces = table.clone(Moor.outcrop.pieces)
+for i, piece in outcropPieces do
+	outcropPieces[i] = with(piece, { color = STAINED_DARK })
+end
+bog.outcrop = with(Moor.outcrop, { pieces = outcropPieces, ground = bogged(Moor.outcrop.ground) })
+
+bog.ground = with(Moor.ground, {
+	heath = bogged(Moor.ground.heath),
+	road = bogged(Moor.ground.road),
+	ruin = bogged(Moor.ground.ruin),
+})
+local bluffRock = Moor.bluff and Moor.bluff.rock
+if bluffRock then
+	bog.bluff = with(Moor.bluff, {
+		rock = bogged(bluffRock),
+		backing = { material = "Slate", color = { 58, 60, 56 } },
+	})
+end
+-- Standing water gone foul: a dark sick green on a bed of drowned earth, the
+-- causeway stones stained.
+if Moor.pools then
+	local causeway = table.clone(Moor.pools.causeway :: any)
+	local stones = table.clone(causeway.stones)
+	local stoneColors = { { 76, 78, 72 }, { 68, 70, 64 }, { 72, 74, 66 } }
+	for i, stone in stones do
+		stones[i] = with(stone, { color = stoneColors[i] })
+	end
+	causeway.stones = stones
+	bog.pools = with(Moor.pools, {
+		sheet = { name = "BilePool", size = Sculpts.blightfen_pool.size, sculpt = "blightfen_pool" },
+		bed = { material = "Mud", color = { 34, 32, 28 } },
+		causeway = causeway,
+	})
+end
+-- Rising land and rock in the bog's own colours, its mist the mood preset's
+-- haze, and hills running on into it; the drowned chapel stands far out past
+-- the east end on a low pad, the skyline landmark from the road (B11).
+bog.beyond = with(Moor.beyond, {
+	ground = bogged(Moor.beyond.ground),
+	rock = bogged(Moor.beyond.rock),
+	abyss = { material = "Slate", color = { 18, 20, 18 } },
+	mist = with(Moor.beyond.mist, { color = (LightingPresets.mood.atmosphere :: any).color }),
+	hills = table.freeze({
+		reach = 90,
+		chunk = 10,
+		height = table.freeze({ 12, 26 }),
+		lane = 4,
+		laneReach = 12,
+		laneGround = { material = "Ground", color = { 68, 65, 56 } },
+	}),
+	landmark = table.freeze({
+		piece = table.freeze({
+			name = "DrownedChapel",
+			size = Sculpts.blightfen_chapel.size,
+			sculpt = "blightfen_chapel",
+			-- A foul light in its window, so the skyline's chapel answers the
+			-- pit's own glow from across the mist (B11).
+			light = {
+				color = { 148, 168, 92 },
+				range = 50,
+				brightness = 1.6,
+				height = 42,
+				ember = 0.8,
+				pulse = { style = "breathe", depth = 0.25, period = 5 },
+			},
+		}),
+		out = 300,
+		scale = 2.6,
+		sink = 2,
+		pad = 12,
+		lift = 12,
+		ground = { material = "Mud", color = { 38, 36, 32 } },
+	}),
+})
+
+-- The map's two ends in the bog's palette: the arrival's pool a faint sick
+-- green, the way on's sheet dim until the pit is cleared and then the same
+-- foul light (it is a light source, so it may take the accent whole).
+local moorEnds = assert(Moor.ends, "the moor has ends")
+bog.ends = with(moorEnds, {
+	arrival = with(moorEnds.arrival, {
+		pool = with(moorEnds.arrival.pool, { color = { 46, 62, 46 }, transparency = 0.62 }),
+	}),
+	exit = with(moorEnds.exit, {
+		sheet = with(moorEnds.exit.sheet, {
+			dim = { 52, 58, 48 },
+			lit = { 146, 180, 112 },
+			light = { color = { 154, 188, 124 }, range = 24, brightness = 2 },
+		}),
+	}),
+})
+-- The threshold marker's rag in the zone's bile, not the moor's oxblood.
+bog.thresholds = with(Moor.thresholds :: any, {
+	marker = {
+		name = "BogMarker",
+		size = Sculpts.blightfen_marker.size,
+		sculpt = "blightfen_marker",
+		solid = true,
+	},
+})
+-- The vault at the back of every graveyard in stained stone, its iron door
+-- green with the damp.
+bog.graveyard = with(Moor.graveyard :: any, {
+	crypt = { name = "BogCrypt", size = Sculpts.blightfen_crypt.size, sculpt = "blightfen_crypt" },
+})
+-- Fewer lanterns at the ruin doors: only the ones someone still lights.
+bog.wallLights = with(Moor.wallLights, { chance = 0.35 })
+-- A thicker, lower haze than the moor's, grey-green off the water (B9).
+bog.groundMist = with(Moor.groundMist, {
+	color = { 126, 134, 118 },
+	perHundredCells = 0.9,
+	spacing = 40,
+	height = 1.2,
+	size = 26,
+	transparency = 0.84,
+})
+
+-- The pit's foul light (the zone's signature) and the reek off its wells.
+bog.setPieces = table.freeze({
+	table.freeze({
+		recipe = "blightfen_miasma",
+		along = "pieces",
+		on = "prop:stone_circles",
+		every = 120,
+		count = 1,
+		lift = 1,
+	}),
+	table.freeze({
+		recipe = "blightfen_well_mist",
