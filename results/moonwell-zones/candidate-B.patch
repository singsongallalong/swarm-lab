diff --git a/src/shared/data/outdoorTilesets/Moonwell.luau b/src/shared/data/outdoorTilesets/Moonwell.luau
new file mode 100644
index 0000000..8efb2e4
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Moonwell.luau
@@ -0,0 +1,350 @@
+--!strict
+-- The Moonwell: a drowned glade where an order of moon-priestesses kept a
+-- sacred well, long abandoned. A quieter, colder place than the Ashfields'
+-- burning violet waste: dark blue-black wood and wet earth, pale stone gone
+-- green-grey with age, still black water, and one muted accent (bible B8),
+-- the well's cold silver-teal. Its landmark (B11) is the sacred ring itself:
+-- pale stones round a pool of cold light, struck once a map off the road and
+-- the fights, so a player sees it across the glade and wants to walk to it.
+-- Amber is only the priestesses' last few lanterns. Derived from Field the
+-- way Field2 is: the same pieces, repainted cold.
+local Field = require("./Field")
+local LightingPresets = require("../LightingPresets")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- The glade's ground by terrain material, as Field paints its living ground:
+-- Terrain keeps one colour per material, so every look on a material moves
+-- together (OutdoorTilesets.spec). Dark blue-black earth under the wood; the
+-- pale stone is left to the sculpts, where the eye needs it.
+local NIGHT: { [string]: { number } } = {
+	Grass = { 62, 70, 72 }, -- the glade floor; Roblox's blades take it
+	Ground = { 52, 58, 60 },
+	LeafyGrass = { 44, 52, 54 }, -- the darker margin under the walls
+	Mud = { 36, 40, 42 }, -- wet black earth under the trees
+	Basalt = { 58, 64, 70 },
+	Cobblestone = { 82, 88, 86 }, -- the old pilgrim road, paler than the floor
+}
+
+local function night(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = NIGHT[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- The wood's bark and the cliffs' rock, painted rather than textured: the
+-- generated meshes take a plain colour (Moor's lesson, C49), kept dark so the
+-- pale stone is what catches the moon. The bark is the tree sculpts' first, so
+-- meshes and sculpts stay one colour.
+local BARK = Sculpts.moonwell_tree.colors[1]
+local ROCK = { 54, 58, 64 }
+
+-- The priestesses' last lamp: one wayside shrine a map still burning, its
+-- flame small and warm against the cold (bible B2).
+local SHRINE_LAMP: OutdoorTypes.LightLook = {
+	color = { 255, 168, 88 },
+	range = 14,
+	brightness = 1.1,
+	height = 4.1,
+	cage = 0.5,
+	pulse = { style = "flicker", depth = 0.12, period = 1.3 },
+}
+
+-- The landmark (B11): the sacred ring, once a map, pale stones round a pool
+-- of cold light. Quiet, so it stands away from the road and the fights, and
+-- `least` keeps one on every seed: a glade must have its well.
+local ring: OutdoorTypes.PropSet = {
+	pieces = {
+		{
+			name = "MoonRing",
+			size = Sculpts.moonwell_ring.size,
+			sculpt = "moonwell_ring",
+			-- The well's light in the ring's middle: the area's one cool glow,
+			-- and the thing a player crosses the glade for. A slow breath, not
+			-- a flicker: it is magic, not a fire (EF10).
+			light = {
+				-- Desaturated silver-teal, the zone's one muted accent (B8):
+				-- neon brightens it, so a stronger tint read as cyan.
+				color = { 168, 208, 204 },
+				range = 34,
+				brightness = 1.8,
+				height = 1.2,
+				ember = 4,
+				pulse = { style = "breathe", depth = 0.18, period = 6 },
+			},
+		},
+	},
+	perHundredCells = 0,
+	count = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 200,
+	clearance = 6,
+	quiet = true,
+	least = 1,
+	scale = { 0.98, 1.02 },
+	sink = 0.4,
+}
+
+-- Ancient trees standing out of the wood over the heath, a little off the
+-- road: the glade's own, straight and dark, and one old one leaning.
+local gladeTrees: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "MoonTree", size = Sculpts.moonwell_tree.size, sculpt = "moonwell_tree" },
+		{
+			name = "MoonTreeBent",
+			size = Sculpts.moonwell_tree_bent.size,
+			sculpt = "moonwell_tree_bent",
+			weight = 0.5,
+		},
+	},
+	perHundredCells = 0,
+	count = 4,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 90,
+	clearance = 2,
+	quiet = true,
+	scale = { 0.9, 1.15 },
+	sink = 0.5,
+}
+
+-- The order's scattered works: ruined shrine arches and broken columns, moss
+-- on the pale stone, out where the wood opens.
+local monuments: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "MoonArch", size = Sculpts.moonwell_arch.size, sculpt = "moonwell_arch" },
+		{ name = "MoonColumn", size = Sculpts.moonwell_column.size, sculpt = "moonwell_column" },
+	},
+	perHundredCells = 0,
+	count = 3,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 120,
+	clearance = 3,
+	quiet = true,
+	scale = { 0.9, 1.1 },
+	sink = 0.5,
+}
+
+-- Standing stones an old order raised: a head taller than a player, the
+-- glade's muted silver-teal rag tied round each (B8).
+local standing: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "MoonMarker", size = Sculpts.moonwell_marker.size, sculpt = "moonwell_marker" },
+	},
+	perHundredCells = 0,
+	count = 2,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 140,
+	clearance = 3,
+	quiet = true,
+	scale = { 0.9, 1.1 },
+	sink = 0.6,
+}
+
+-- Still black water lying in the glade's hollows, besides what the terrace
+-- rules pool (systems/Pools): a thin sheet, not solid ground.
+local stillWater: OutdoorTypes.PropSet = {
+	pieces = { { name = "MoonPool", size = Sculpts.moonwell_pool.size, sculpt = "moonwell_pool" } },
+	perHundredCells = 0,
+	count = 3,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 80,
+	clearance = 2,
+	scale = { 0.5, 0.9 },
+	sink = 0.05,
+}
+
+local props: { [string]: OutdoorTypes.PropSet } = {
+	-- Moonmoss in place of the field's gorse: low dark clumps with pale tips.
+	heather = with(Field.props.heather, {
+		pieces = { { name = "Moonmoss", size = Sculpts.moonwell_moss.size, sculpt = "moonwell_moss" } },
+		perHundredCells = 4,
+		scale = { 0.9, 1.3 },
+	}),
+	-- The dead still lie in the wood's graveyards.
+	headstones = Field.props.headstones,
+	-- Fewer grave lanterns than the moor's: the order left long ago.
+	candles = with(Field.props.candles, { perHundredCells = 5 }),
+	-- A few road lanterns, far apart: the priestesses' last few lamps between
+	-- the trees (B2–B3: warm light always means someone).
+	lanterns = with(Field.props.lanterns, { spacing = 150, perHundredCells = 1.6 }),
+	-- A brazier still banked in a ruin, rarer than the moor's.
+	embers = with(Field.props.embers, { perHundredCells = 1 }),
+	-- Pale mossy boulders out on the heath.
+	boulders = with(Field.props.boulders, {
+		pieces = {
+			{
+				name = "MoonBoulder",
+				size = Sculpts.moonwell_boulder.size,
+				sculpt = "moonwell_boulder",
+				solid = true,
+			},
+		},
+	}),
+	-- Shrines along the old road, and one still lit (below).
+	waysides = with(Field.props.waysides, {
+		pieces = { { name = "MoonShrine", size = Sculpts.moonwell_shrine.size, sculpt = "moonwell_shrine" } },
+		count = 3,
+		spacing = 120,
+	}),
+	-- One shrine a map still keeps a flame: the warm stop between lantern
+	-- pools, and the bible's "a light that means someone tends it" (B2).
+	shrine = with(Field.props.shrine, {
+		pieces = {
+			{
+				name = "MoonShrineLit",
+				size = Sculpts.moonwell_shrine.size,
+				sculpt = "moonwell_shrine",
+				light = SHRINE_LAMP,
+			},
+		},
+	}),
+	ring = table.freeze(ring),
+	trees = table.freeze(gladeTrees),
+	monuments = table.freeze(monuments),
+	standing = table.freeze(standing),
+	stillWater = table.freeze(stillWater),
+}
+
+local moonwell = table.clone(Field) :: OutdoorTypes.OutdoorTileset
+moonwell.name = "moonwell"
+moonwell.palette = "dark blue-black wood and wet earth, pale green-grey weathered stone, "
+	.. "still black water, cold silver-teal as the one muted accent, desaturated, matte, no highlights"
+moonwell.lighting = "mood"
+moonwell.props = table.freeze(props)
+-- Colder and heavier than the field's (B9): the mist pools among the trees
+-- and hangs blue-grey over the water.
+moonwell.groundMist = with(Field.groundMist, {
+	color = { 116, 136, 140 },
+	perHundredCells = 0.5,
+	spacing = 44,
+	size = 28,
+	transparency = 0.86,
+})
+
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Field.edges :: any)
+-- The wood closes in: taller and denser than the field's treeline, and its
+-- bark the glade's blue-black. One more of the order's own trees among the
+-- meshes, leaning out over the heath.
+local trees = table.clone(edges["thicket"].pieces)
+for i, piece in trees do
+	if piece.sculpt then
+		trees[i] = with(piece, {
+			name = "MoonTree",
+			sculpt = "moonwell_tree",
+			size = Sculpts.moonwell_tree.size,
+			weight = 0.5,
+		})
+	else
+		trees[i] = with(piece, { color = BARK })
+	end
+end
+table.insert(trees, {
+	name = "MoonTreeBent",
+	size = Sculpts.moonwell_tree_bent.size,
+	sculpt = "moonwell_tree_bent",
+	weight = 0.3,
+})
+edges["thicket"] = with(edges["thicket"], { pieces = trees, spacing = 6, scale = { 2.6, 4 } })
+-- Old dry-stone walls, not the town's curtain wall (Field borrowed that for
+-- its town): the order's field walls run on under the moss.
+edges["ruin_wall"] = with(edges["ruin_wall"], { run = "moor_field_wall" })
+-- The cliffs round the glade, colder than the moor's blue-grey.
+local cliffs = table.clone(edges["cliff"].pieces)
+for i, piece in cliffs do
+	cliffs[i] = with(piece, { color = ROCK })
+end
+edges["cliff"] = with(edges["cliff"], { pieces = cliffs })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = night(edge.ground) })
+	end
+end
+moonwell.edges = table.freeze(edges) :: any
+
+-- The old pilgrim road runs on, paler than the wet floor so it reads as the
+-- way (Field2's lesson: a road at the floor's own value vanishes).
+moonwell.ground = with(Field.ground, {
+	heath = night(Field.ground.heath),
+	ruin = night(Field.ground.ruin),
+	road = { material = "Cobblestone", color = NIGHT.Cobblestone },
+})
+local outcropPieces = table.clone(Field.outcrop.pieces)
+for i, piece in outcropPieces do
+	outcropPieces[i] = with(piece, { color = ROCK })
+end
+local outcropChanges: { [string]: any } = { pieces = outcropPieces }
+if Field.outcrop.ground then
+	outcropChanges.ground = night(Field.outcrop.ground)
+end
+moonwell.outcrop = with(Field.outcrop, outcropChanges)
+local bluffRock = Field.bluff and Field.bluff.rock
+if bluffRock then
+	moonwell.bluff = with(Field.bluff, {
+		rock = night(bluffRock),
+		-- The wall's rubble core, the glade's stone rather than the moor's
+		-- pale slate.
+		backing = { material = "Slate", color = { 58, 64, 62 } },
+	})
+end
+if Field.pools then
+	moonwell.pools = with(Field.pools, {
+		-- Still black water, the drowned glade's own: a thin sheet, so the
+		-- moon and the ring's light are what show in it (C34).
+		sheet = { name = "MoonPool", size = Sculpts.moonwell_pool.size, sculpt = "moonwell_pool" },
+		bed = night(Field.pools.bed),
+		-- Flat pale stones worn into the water, the old crossing.
+		causeway = {
+			stones = {
+				{ name = "CausewayStone", size = { 2.4, 0.8, 3.4 }, material = "Slate", color = { 78, 84, 82 } },
+				{ name = "CausewayStone", size = { 3.0, 0.8, 2.6 }, material = "Slate", color = { 70, 78, 76 } },
+				{ name = "CausewayStone", size = { 2.0, 0.9, 2.8 }, material = "Slate", color = { 84, 88, 84 } },
+			},
+			step = 3,
+			sink = 0.35,
+		},
+	})
+end
+-- Closed all round, as the Ashfields are (fafwa 2026-10-26: "something to
+-- occlude the boundary of the world"): rising land fills every edge out to
+-- the map's own, and hills run on past it into the haze, the road's ends
+-- running on as lanes.
+moonwell.beyond = with(Field.beyond, {
+	reach = 60,
+	hills = table.freeze({ reach = 80, chunk = 10, height = table.freeze({ 14, 30 }), lane = 4, laneReach = 12 }),
+	ground = night(Field.beyond.ground),
+	rock = night(Field.beyond.rock),
+	mist = with(Field.beyond.mist, { color = (LightingPresets.mood.atmosphere :: any).color }),
+})
+-- The glade has no town, no fort and no giant's bones: its landmark is its
+-- own ring, and its houses are the stone ruins the kit already builds.
+moonwell.town = nil
+moonwell.landmarks = nil
+moonwell.kits = nil
+-- One manor's window still lit in the wood: the same trace of people the last
+-- lanterns are (A7-D5).
+moonwell.litWindows = with(Field.litWindows :: any, { kinds = { "manor" }, count = 1, chance = 0.4 })
+-- Fewer lanterns at the ruin doors than the moor keeps.
+moonwell.wallLights = with(Field.wallLights, { chance = 0.25 })
+local thresholds = Field.thresholds
+if thresholds then
+	moonwell.thresholds = with(thresholds, {
+		-- The road's lamps are the road's own, and the marker stone wears the
+		-- glade's accent (B8), so a way on reads the same every time (A012 §2).
+		lamp = props.lanterns.pieces[1],
+		marker = {
+			name = "MoonMarker",
+			size = Sculpts.moonwell_marker.size,
+			sculpt = "moonwell_marker",
+			solid = true,
+		},
+	})
+end
+
+return table.freeze(moonwell)
