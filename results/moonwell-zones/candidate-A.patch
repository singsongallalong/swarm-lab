diff --git a/src/shared/data/outdoorTilesets/Moonwell.luau b/src/shared/data/outdoorTilesets/Moonwell.luau
new file mode 100644
index 0000000..4059604
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Moonwell.luau
@@ -0,0 +1,340 @@
+--!strict
+-- The Moonwell: a drowned glade in a dark blue-black wood, where an order of
+-- moon-priestesses kept a sacred well and left it. Still black water fills the
+-- hollows, pale green-grey stone stands in rings and broken arches, and the
+-- only cold light is the well's own silver-teal, leaving the water as wisps.
+-- Its amber is the last few lanterns on the road. Derived from the moor the
+-- way the Ashfields derive from the field: the same skeleton, repainted
+-- drowned, and its warm living ground cooled to blue-green.
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Drowned ground by terrain material, as Field paints its living ground:
+-- Terrain keeps one colour per material, so every look on a material moves
+-- together (OutdoorTilesets.spec). Dark blue-green heath, black silt and wet
+-- cold stone, all far under the bible's large-surface caps (B8).
+local DROWNED: { [string]: { number } } = {
+	Grass = { 58, 68, 66 }, -- the glade's heath, cold blue-green; Roblox's blades take it
+	Ground = { 54, 58, 62 }, -- the old paths, wet grey
+	LeafyGrass = { 40, 46, 46 }, -- the shaded margin under the trees and the banks
+	Mud = { 38, 42, 44 }, -- wet silt under the water, the ruins and the thickets
+	Basalt = { 38, 42, 46 }, -- cold wet rock, darker than the heath so the rim reads
+	Slate = { 76, 82, 78 }, -- the pale green-grey stone of the order's ruins
+}
+
+local function drowned(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = DROWNED[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- The cliffs keep their generated meshes (Moor's reasoning: sculpted columns
+-- read as boxes from the ARPG camera), painted a colder blue-grey than the
+-- moor's so the rim reads as wet rock under the moon, not ash.
+local CLIFF_ROCK = { 46, 50, 54 }
+-- The priestesses' last lanterns: the one warm light left in the glade, and
+-- rare. A small caged flame, so it reads as a lantern and never as a lamp moon.
+local LANTERN_CAGE = 0.8
+local ROAD_LIGHT: OutdoorTypes.LightLook = {
+	color = { 255, 170, 96 },
+	range = 16,
+	brightness = 1.2,
+	-- Under the post's chain, as on the moor.
+	height = (Sculpts.moonwell_lamppost.arm :: number)
+		- (Sculpts.moonwell_lamppost.drop :: number)
+		- LANTERN_CAGE * 1.3 / 2,
+	reach = Sculpts.moonwell_lamppost.reach,
+	cage = LANTERN_CAGE,
+	pulse = { style = "flicker", depth = 0.12, period = 1.3 },
+}
+local ROAD_LAMP: OutdoorTypes.PieceLook = {
+	name = "MoonLantern",
+	size = Sculpts.moonwell_lamppost.size,
+	sculpt = "moonwell_lamppost",
+	light = ROAD_LIGHT,
+}
+-- The arrival's own: dimmer, because a party lands beside it (C38's lesson).
+local ARRIVAL_LAMP: OutdoorTypes.PieceLook = with(ROAD_LAMP, {
+	name = "MoonArrivalLantern",
+	light = with(ROAD_LIGHT, { range = 14, brightness = 0.8 }),
+})
+
+local props: any = table.clone(Moor.props)
+-- Moon-fern in place of heather: low silver-green clumps with pale tips, the
+-- ground cover of the drowned glade. Merged, so the colour reaches every cell
+-- without spending the part budget (fafwa's heather lesson).
+props.heather = with(props.heather, {
+	perHundredCells = 5,
+	pieces = {
+		{ name = "MoonFern", size = Sculpts.moonwell_fern.size, sculpt = "moonwell_fern" },
+	},
+})
+-- Fewer road lanterns than anywhere else: the order's last few, far apart.
+props.lanterns = {
+	pieces = { ROAD_LAMP },
+	perHundredCells = 0.6,
+	on = { "roadside" :: OutdoorTypes.PropGround },
+	spacing = 150,
+	faceRoad = true,
+	scale = { 0.95, 1.1 },
+	sink = 0.5,
+}
+-- The order's graves, in the same pale stone: round-topped stones leaning by
+-- the water.
+props.headstones = with(props.headstones, {
+	perHundredCells = 22,
+	pieces = {
+		{ name = "MoonHeadstone", size = Sculpts.moonwell_headstone.size, sculpt = "moonwell_headstone" },
+	},
+})
+-- A few grave lanterns still burn; the rest went out long ago.
+props.candles = with(props.candles, { perHundredCells = 4 })
+-- No fires in the ruins: the glade is cold, and the well is the only light
+-- that matters.
+props.embers = nil
+-- The moor's watchtower and stone circles are replaced by the order's own.
+props.watchtower = nil
+props.stone_circles = nil
+
+-- The pale stone rings: the area's landmark, a ring of standing stones round
+-- a hollow (or, at a map's arrival, round its pool of cold light). Scattered
+-- where the heath opens, two to a map, clear of the way and the ruins.
+local stoneRings: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "MoonStoneRing", size = Sculpts.moonwell_stone_ring.size, sculpt = "moonwell_stone_ring" },
+		{
+			name = "MoonStandingStones",
+			size = Sculpts.moonwell_standing_stones.size,
+			sculpt = "moonwell_standing_stones",
+			weight = 0.8,
+		},
+	},
+	perHundredCells = 0,
+	count = 2,
+	spacing = 140,
+	clearance = 4,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.95, 1.05 },
+	sink = 0.5,
+}
+props.stone_rings = table.freeze(stoneRings)
+
+-- Ruined shrines of the order, out in the wood: a niche shrine and a broken
+-- arch, both pale stone, none of them lit any more.
+local shrines: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "MoonShrine", size = Sculpts.moonwell_shrine.size, sculpt = "moonwell_shrine" },
+		{
+			name = "BrokenShrineArch",
+			size = Sculpts.moonwell_shrine_arch.size,
+			sculpt = "moonwell_shrine_arch",
+			weight = 0.7,
+		},
+	},
+	perHundredCells = 0,
+	count = 3,
+	spacing = 110,
+	clearance = 3,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.95, 1.15 },
+	sink = 0.4,
+}
+props.shrines = table.freeze(shrines)
+
+-- One broken tower to steer by, the area's skyline landmark (bible B11): a
+-- pale stump of the order's sanctum rising out of the dark wood.
+local moonTower: OutdoorTypes.PropSet = {
+	pieces = { { name = "MoonTower", size = Sculpts.moonwell_tower.size, sculpt = "moonwell_tower" } },
+	perHundredCells = 0,
+	count = 1,
+	clearance = 4,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.95, 1.05 },
+	sink = 0.6,
+}
+props.moon_tower = table.freeze(moonTower)
+
+-- A few ancient trees out on the open ground, leaning over the water and the
