+		pool = { radius = 6, color = { 40, 74, 72 }, transparency = 0.55 },
+	},
+	exit = {
+		arch = { name = "MoonArch", size = Sculpts.moonwell_arch.size, sculpt = "moonwell_arch" },
+		sheet = {
+			width = 6,
+			height = 10,
+			dim = { 44, 54, 56 },
+			lit = { 150, 206, 196 },
+			transparency = 0.25,
+			light = { color = { 140, 196, 188 }, range = 26, brightness = 2 },
+		},
+	},
+	-- Across a road that comes in off the map: a broken shrine arch, its gap
+	-- filled by the road and the mist.
+	offMap = {
+		name = "MoonGate",
+		size = Sculpts.moonwell_shrine_arch.size,
+		sculpt = "moonwell_shrine_arch",
+		solid = true,
+	},
+}
+-- Each threshold: a lamp and a marker stone hung with the order's silver-teal
+-- rag, the zone accent (bible B8), so a way on reads the same every time.
+moonwell.thresholds = {
+	lamp = ROAD_LAMP,
+	marker = {
+		name = "MoonMarker",
+		size = Sculpts.moonwell_marker.size,
+		sculpt = "moonwell_marker",
+		solid = true,
+	},
+}
+-- Fewer lit doors than the moor: the order is long gone.
+moonwell.wallLights = with(Moor.wallLights, { chance = 0.25 })
+-- No lit windows at all: every room in the drowned glade is dark (B7).
+moonwell.litWindows = nil
+-- The order's vault at the back of its graveyard.
+local graveyard = assert(Moor.graveyard, "the moor has a graveyard")
+moonwell.graveyard = with(graveyard, {
+	crypt = { name = "MoonCrypt", size = Sculpts.moonwell_crypt.size, sculpt = "moonwell_crypt" },
