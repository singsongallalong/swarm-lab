+local heroTrees: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "MoonTree", size = Sculpts.moonwell_tree.size, sculpt = "moonwell_tree" },
+		{ name = "MoonTreeBent", size = Sculpts.moonwell_tree_bent.size, sculpt = "moonwell_tree_bent", weight = 0.8 },
+	},
+	perHundredCells = 0,
+	count = 5,
+	spacing = 70,
+	clearance = 2,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.95, 1.1 },
+	sink = 0.5,
+}
+props.hero_trees = table.freeze(heroTrees)
+
+-- Boulders in the glade's cold rock.
+local boulderPieces = table.clone(props.boulders.pieces)
+for i, piece in boulderPieces do
+	boulderPieces[i] = with(piece, { color = CLIFF_ROCK })
+end
+props.boulders = with(props.boulders, { pieces = boulderPieces })
+
+local cliffs: { OutdoorTypes.PieceLook } = {}
+for i, piece in Moor.edges.cliff.pieces do
+	cliffs[i] = with(piece, { color = CLIFF_ROCK })
+end
+
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+-- The wood round the glade: the same generated trees, painted blue-black, and
+-- grown larger, so the rim reads as old forest mass from the high camera.
+local treePieces = table.clone(edges["thicket"].pieces)
+for i, piece in treePieces do
+	if not piece.sculpt then
+		treePieces[i] = with(piece, { color = { 36, 42, 46 } })
+	end
+end
+edges["thicket"] = with(edges["thicket"], { pieces = treePieces, spacing = 5, scale = { 2, 3 } })
+edges["cliff"] = with(edges["cliff"], { pieces = cliffs })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = drowned(edge.ground) })
+	end
+end
+
+local moonwell = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+moonwell.name = "moonwell"
+moonwell.palette = "dark blue-black glade grass, black still water, pale green-grey weathered stone, "
+	.. "dark wet basalt, silver-teal light as the only cold glow, a few amber lanterns, desaturated, matte, no highlights"
+moonwell.lighting = "mood"
+moonwell.props = table.freeze(props)
+moonwell.edges = table.freeze(edges) :: any
+-- The heath and the black silt of the ruins; the road on to the well is old
+-- wet cobbles, paler than the ground so it reads as the way (the Ashfields'
+-- lesson: at 56 grey the road vanished into the ground, Field2 2026-10-25).
+moonwell.ground = with(Moor.ground, {
+	heath = drowned(Moor.ground.heath),
+	ruin = drowned(Moor.ground.ruin),
+	road = { material = "Cobblestone", color = { 64, 74, 74 } },
