diff --git a/src/shared/data/outdoorTilesets/Moonwell.luau b/src/shared/data/outdoorTilesets/Moonwell.luau
new file mode 100644
index 0000000..83ea3d2
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Moonwell.luau
@@ -0,0 +1,313 @@
+--!strict
+-- The Moonwell (Moonwell zone): a drowned glade where an order of
+-- moon-priestesses once kept a sacred well, long abandoned. The moor's cold
+-- night in a different paint: dark blue-black woods round a glade of pale
+-- stone gone green-grey with age, still black water, and barrows more than a
+-- garden. Its one muted accent (B8) is the well's cold silver-teal light, the
+-- only cool glow in the zone; what amber is left is the priestesses' last few
+-- lanterns. The moor's pieces throughout, so it costs what the moor costs.
+local LightingPresets = require("../LightingPresets")
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Glade ground by terrain material, as Field paints its living ground: Terrain
+-- keeps one colour per material, so every look on a material moves together.
+local GLADE: { [string]: { number } } = {
+	Grass = { 42, 52, 50 }, -- dark moss-green; Roblox's blades take it
+	Ground = { 66, 74, 70 },
+	LeafyGrass = { 38, 46, 42 }, -- the shaded margin under the woods
+	Mud = { 36, 42, 38 }, -- wet black earth under the trees and the barrows
+	Basalt = { 46, 50, 56 }, -- cold blue-grey rock
+}
+
+local function gladed(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = GLADE[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- Pale stone gone green-grey with age is the zone's worked stone (the well's
+-- ring, the crypts, the shrines); the cliffs stay cold dark rock, and the wood
+-- goes blue-black.
+local CLIFF_ROCK = { 52, 56, 64 }
+local WOOD = { 38, 38, 44 }
+
+local cliffs: { OutdoorTypes.PieceLook } = table.clone(Moor.edges["cliff"].pieces)
+for i, piece in cliffs do
+	cliffs[i] = with(piece, { color = CLIFF_ROCK })
+end
+local trees: { OutdoorTypes.PieceLook } = table.clone(Moor.edges["thicket"].pieces)
+for i, piece in trees do
+	if piece.mesh then
+		trees[i] = with(piece, { color = WOOD })
+	end
+end
+
+local ROAD_LAMP = Moor.props.lanterns.pieces[1]
+
+-- The landmark (B11): a ring of pale standing stones round a low pool of cold
+-- light, the well the order kept. The light is the zone's accent and the one
+-- thing a player sees across the glade from the high camera; it breathes
+-- slowly, as still water does, and its ember sits at the ground so the ring
+-- reads as a pool of light rather than a lamp.
+local SACRED_RING: OutdoorTypes.PieceLook = {
+	name = "MoonwellRing",
+	size = Sculpts.moonwell_sacred_ring.size,
+	sculpt = "moonwell_sacred_ring",
+	light = {
+		color = { 168, 214, 208 },
+		range = 32,
+		brightness = 1.8,
+		-- A low dome of Neon half sunk in the ring's floor: the well's pool of
+		-- cold light, not a lamp on a post.
+		height = 0.5,
+		ember = 7,
+		shadows = true,
+		pulse = { style = "breathe", depth = 0.18, period = 7 },
+	},
+}
+
+local props: { [string]: OutdoorTypes.PropSet } = {
+	-- Barrow grass in place of the moor's heather: dark moss with pale tips.
+	tufts = {
+		pieces = {
+			{ name = "BarrowGrass", size = Sculpts.moonwell_barrow_grass.size, sculpt = "moonwell_barrow_grass" },
+		},
+		perHundredCells = 4,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		scale = { 0.9, 1.3 },
+		sink = 0.3,
+	},
+	-- A field of graves more than a garden: denser than the moor's, and all
+	-- in the pale stone.
+	headstones = {
+		pieces = {
+			{ name = "PaleHeadstone", size = Sculpts.moonwell_headstone.size, sculpt = "moonwell_headstone" },
+			{
+				name = "PaleHeadstoneBroken",
+				size = Sculpts.moonwell_headstone_broken.size,
+				sculpt = "moonwell_headstone_broken",
+			},
+		},
+		perHundredCells = 38,
+		on = { "graveyard" :: OutdoorTypes.PropGround },
+		scale = { 0.8, 1.2 },
+		sink = 0.4,
+	},
+	-- The last few candles the priestesses left burning among the barrows.
+	candles = with(Moor.props.candles, { perHundredCells = 6 }),
+	-- Few road lanterns and far apart: the order's last few, each a pool of
+	-- amber light on the way in.
+	lanterns = with(Moor.props.lanterns, { perHundredCells = 1.2, spacing = 130 }),
+	-- The well itself, once a map, clear of the road and the fights so players
+	-- can walk to it (B11: a landmark, not a signpost).
+	sacred_ring = {
+		pieces = { SACRED_RING },
+		perHundredCells = 0,
+		count = 1,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		clearance = 4,
+		quiet = true,
+		least = 1,
+		scale = { 1, 1 },
+		sink = 0.4,
+	},
+	-- The priestesses' roadside shrines: the last warm light on the way in.
+	shrines = {
+		pieces = {
+			{
+				name = "MoonwellShrine",
+				size = Sculpts.moonwell_shrine.size,
+				sculpt = "moonwell_shrine",
+				light = {
+					color = { 255, 168, 88 },
+					range = 14,
+					brightness = 1.1,
+					height = 4.2,
+					cage = 0.5,
+					pulse = { style = "flicker", depth = 0.12, period = 1.4 },
+				},
+			},
+		},
+		perHundredCells = 0,
+		count = 2,
+		on = { "roadside" :: OutdoorTypes.PropGround },
+		spacing = 150,
+		faceRoad = true,
+		quiet = true,
+		scale = { 0.95, 1.1 },
+		sink = 0.2,
+	},
+	-- Ruined shrine arches down among the barrows and the trees.
+	arches = {
+		pieces = { { name = "RuinedArch", size = Sculpts.moonwell_arch.size, sculpt = "moonwell_arch" } },
+		perHundredCells = 0,
+		count = 3,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		spacing = 120,
+		clearance = 4,
+		quiet = true,
+		scale = { 0.9, 1.1 },
+		sink = 0.5,
+	},
+	-- Lone standing stones out on the heath, older than the order. Scattered
+	-- dressing is walk-through (only the boulders are solid); the one that
+	-- marks a threshold is the solid one.
+	standing_stones = {
+		pieces = {
+			{ name = "StandingStone", size = Sculpts.moonwell_standing_stone.size, sculpt = "moonwell_standing_stone" },
+		},
+		perHundredCells = 0,
+		count = 4,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		spacing = 140,
+		clearance = 2,
+		quiet = true,
+		scale = { 0.85, 1.15 },
+		sink = 0.5,
+	},
+	-- Ancient trees leaning over the glade, darker and taller than the woods
+	-- that ring it.
+	ancient_trees = {
+		pieces = {
+			{ name = "AncientTree", size = Sculpts.moonwell_ancient_tree.size, sculpt = "moonwell_ancient_tree" },
+		},
+		perHundredCells = 0,
+		count = 3,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		spacing = 110,
+		clearance = 3,
+		quiet = true,
+		scale = { 0.9, 1.2 },
+		sink = 0.6,
+	},
+	boulders = with(Moor.props.boulders, {
+		pieces = { with(Moor.props.boulders.pieces[1], { color = CLIFF_ROCK }) },
+	}),
+}
+
+local moonwell = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+moonwell.name = "moonwell"
+moonwell.lighting = "mood"
+moonwell.palette = "dark blue-black wood, pale green-grey weathered stone, still black water, "
+	.. "dark mossy ground, one cold silver-teal glow, a few amber lanterns, desaturated, matte, no highlights"
+moonwell.props = table.freeze(props)
+-- The old paved way in, pale green-grey stone so the walk reads from above.
+moonwell.ground = with(Moor.ground, {
+	heath = gladed(Moor.ground.heath),
+	ruin = gladed(Moor.ground.ruin),
+	road = { material = "Cobblestone", color = { 72, 80, 76 } },
+})
+
+-- The woods close in round the glade: taller and darker than the moor's, the
+-- same meshes (no more parts), a little further apart so they still part.
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+edges["cliff"] = with(edges["cliff"], { pieces = cliffs })
+edges["thicket"] = with(edges["thicket"], { pieces = trees, spacing = 6, scale = { 2.4, 3.4 } })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = gladed(edge.ground) })
+	end
+end
+moonwell.edges = table.freeze(edges) :: any
+
+local outcrop = with(Moor.outcrop, { pieces = cliffs })
+if Moor.outcrop.ground then
+	outcrop = with(outcrop, { ground = gladed(Moor.outcrop.ground) })
+end
+moonwell.outcrop = outcrop
+
+local bluffRock = Moor.bluff and Moor.bluff.rock
+if bluffRock then
+	moonwell.bluff = with(Moor.bluff, {
+		rock = gladed(bluffRock),
+		backing = { material = "Slate", color = { 62, 66, 66 } },
+	})
+end
+
+-- Standing water in the hollows: still, black, with a cold sheen, on the same
+-- wet earth as the barrows. Pale stones cross it as the moor's do.
+if Moor.pools then
+	moonwell.pools = with(Moor.pools, {
+		sheet = { name = "Pool", size = Sculpts.moonwell_pool.size, sculpt = "moonwell_pool" },
+		bed = gladed(Moor.pools.bed),
+		causeway = {
+			stones = {
+				{ name = "CausewayStone", size = { 2.4, 0.8, 3.4 }, material = "Slate", color = { 88, 96, 92 } },
+				{ name = "CausewayStone", size = { 3.0, 0.8, 2.6 }, material = "Slate", color = { 80, 88, 86 } },
+				{ name = "CausewayStone", size = { 2.0, 0.9, 2.8 }, material = "Slate", color = { 96, 100, 94 } },
+			},
+			step = 3,
+			sink = 0.35,
+		},
+	})
+end
+
+-- Closed all round: rising land out to the map's own edge and low wooded hills
+-- running on past it into the haze, the road's ends running on as lanes.
+moonwell.beyond = with(Moor.beyond, {
+	ground = gladed(Moor.beyond.ground),
+	rock = gladed(Moor.beyond.rock),
+	abyss = { material = "Slate", color = { 14, 15, 17 } },
+	reach = 18,
+	mist = with(Moor.beyond.mist, {
+		color = (LightingPresets.mood.atmosphere :: any).color,
+		transparency = 0.4,
+	}),
+	hills = table.freeze({ reach = 64, chunk = 10, height = table.freeze({ 12, 26 }), lane = 4, laneReach = 12 }),
+})
+
+-- Every graveyard keeps its low vault, its door the well's cold teal.
+moonwell.graveyard = with(assert(Moor.graveyard, "the moor has a graveyard"), {
+	crypt = { name = "Crypt", size = Sculpts.moonwell_crypt.size, sculpt = "moonwell_crypt" },
+})
+-- Fewer doors still guttering than on the moor, and one lit window at most.
+moonwell.wallLights = with(Moor.wallLights, { chance = 0.25 })
+moonwell.litWindows = with(Moor.litWindows :: any, { count = 1, chance = 0.2 })
+
+-- Low mist, cold and blue-grey, thicker than the moor's: a drowned place.
+moonwell.groundMist = with(Moor.groundMist, {
+	color = { 122, 136, 150 },
+	perHundredCells = 0.7,
+	spacing = 44,
+	size = 26,
+	transparency = 0.84,
+})
+
+-- A few of the well's motes loose over the glade, drifting as motes do; the
+-- set piece over the barrows is the effect proper.
+moonwell.mana = table.freeze({
+	color = { 150, 206, 200 },
+	perHundredCells = 0.06,
+	spacing = 80,
+	height = 2.5,
+	size = 0.7,
+	speed = 2.5,
+	rate = 3.5,
+})
+
+-- Where the way on leaves the glade: a lone standing stone with the well's
+-- teal rag, and one of the last lanterns.
+moonwell.thresholds = table.freeze({
+	lamp = ROAD_LAMP,
+	marker = {
+		name = "MoonwellStandingStone",
+		size = Sculpts.moonwell_standing_stone.size,
+		sculpt = "moonwell_standing_stone",
+		solid = true,
+	},
+})
+
+-- A glade is walked into, not opened at a device, and no one lives here now.
+moonwell.ends = nil
+moonwell.town = nil
+
+return table.freeze(moonwell)
