diff --git a/src/shared/data/outdoorTilesets/Moonwell.luau b/src/shared/data/outdoorTilesets/Moonwell.luau
new file mode 100644
index 0000000..1fd7a86
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Moonwell.luau
@@ -0,0 +1,303 @@
+--!strict
+-- The Moonwell: a drowned glade where an order of moon-priestesses kept a
+-- sacred well, long abandoned. The moor's grim pieces repainted: dark
+-- blue-black woodland, pale stone gone green-grey with age, still black water
+-- and low blue-grey mist, with one cold silver-teal accent, the well's light.
+-- The only warm light is the order's last few lanterns on the road and the
+-- manor's one window. Slender ruined towers of the order stand on the rims,
+-- each a dead lantern, the well below them (the swarm's direction).
+local LightingPresets = require("../LightingPresets")
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- The glade's ground by terrain material, as Field paints its living ground:
+-- Terrain keeps one colour per material, so every look on a material moves
+-- together (OutdoorTilesets.spec).
+local MOON: { [string]: { number } } = {
+	Grass = { 38, 46, 47 }, -- dark blue-green turf; Roblox's blades take it
+	Ground = { 46, 50, 52 }, -- the old paved way, cold grey
+	LeafyGrass = { 32, 40, 40 }, -- the banks under the wood
+	Mud = { 30, 34, 36 }, -- trodden earth at the ruins and the thickets
+	Basalt = { 56, 64, 64 }, -- wet green-grey rock
+}
+
+local function moonlit(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = MOON[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- Painted pieces sit near the top of the bible's trim range: untextured parts
+-- this dark lose their facets and read as flat black shapes (A005).
+local PALE = { 88, 96, 92 } -- pale stone gone green-grey
+local BARK = { 38, 44, 50 } -- dark blue-black wood
+
+local props = table.clone(Moor.props)
+-- Moon-fern in place of the moor's mauve heather.
+props.heather = with(props.heather, {
+	-- A little thinner than the moor: a glade floor, not a heath.
+	perHundredCells = 4,
+	pieces = { { name = "MoonFern", size = Sculpts.moonwell_ferns.size, sculpt = "moonwell_ferns" } },
+})
+-- The order's last few lanterns, far apart down the road.
+props.lanterns = with(props.lanterns, { spacing = 150 })
+-- No one has banked a fire here in a long time.
+props.embers = nil
+props.candles = with(props.candles, { perHundredCells = 4 })
+-- The moor's slate watchtower and rings give way to the order's own.
+props.watchtower = nil
+
+local boulders = table.clone(props.boulders.pieces)
+for i, piece in boulders do
+	boulders[i] = with(piece, { color = PALE })
+end
+props.boulders = with(props.boulders, { pieces = boulders })
+
+-- Smaller rings of the order's old stones, out in the wood.
+local circles: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "MoonStoneCircle", size = Sculpts.moonwell_stone_circle.size, sculpt = "moonwell_stone_circle" },
+	},
+	perHundredCells = 0,
+	count = 2,
+	spacing = 130,
+	clearance = 4,
+	quiet = true,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.9, 1.1 },
+	sink = 0.4,
+}
+props.stone_circles = table.freeze(circles)
+
+-- The order's ruined shrines and broken colonnades, off the road and the
+-- fights.
+local shrines: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "MoonShrine", size = Sculpts.moonwell_shrine.size, sculpt = "moonwell_shrine" },
+		{ name = "BrokenColonnade", size = Sculpts.moonwell_columns.size, sculpt = "moonwell_columns", weight = 0.8 },
+	},
+	perHundredCells = 0,
+	count = 4,
+	spacing = 90,
+	clearance = 2,
+	quiet = true,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.9, 1.1 },
+	sink = 0.35,
+}
+props.shrines = table.freeze(shrines)
+
+-- Ancient trees leaning over the glade, a few out on the open heath beyond the
+-- rim wood.
+local ancients: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "AncientTree", size = Sculpts.moonwell_tree.size, sculpt = "moonwell_tree" },
+		{
+			name = "LeaningAncientTree",
+			size = Sculpts.moonwell_tree_leaning.size,
+			sculpt = "moonwell_tree_leaning",
+			weight = 1.2,
+		},
+	},
+	perHundredCells = 0.35,
+	spacing = 55,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 1.1, 1.6 },
+	sink = 0.5,
+}
+props.ancients = table.freeze(ancients)
+
+-- The watch of towers: the order's ruined towers round the glade, each a dead
+-- lantern. One set stands back against the rim cliffs, where the map has a
+-- cliff foot to stand on.
+local towerPieces: { OutdoorTypes.PieceLook } = {
+	{ name = "WatchTower", size = Sculpts.moonwell_tower.size, sculpt = "moonwell_tower" },
+	{
+		name = "BrokenWatchTower",
+		size = Sculpts.moonwell_tower_broken.size,
+		sculpt = "moonwell_tower_broken",
+		weight = 1.2,
+	},
+}
+local towers: OutdoorTypes.PropSet = {
+	pieces = towerPieces,
+	perHundredCells = 0,
+	count = 7,
+	on = { "cliffside" :: OutdoorTypes.PropGround },
+	backToCliff = true,
+	spacing = 80,
+	clearance = 3,
+	quiet = true,
+	scale = { 0.9, 1.1 },
+	sink = 0.9,
+}
+props.towers = table.freeze(towers)
+-- A few more standing free on the open heath, so the ring of towers reads from
+-- the high camera even where a rim has no cliff foot.
+local openTowers: OutdoorTypes.PropSet = {
+	pieces = towerPieces,
+	perHundredCells = 0,
+	count = 3,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 140,
+	clearance = 5,
+	quiet = true,
+	scale = { 1, 1.15 },
+	sink = 0.9,
+}
+props.watchTowers = table.freeze(openTowers)
+
+-- The Moonwell itself: one ring of pale stone round a pool of cold light, the
+-- only cool glow in the glade, breathing slowly.
+local WELL_LIGHT: OutdoorTypes.LightLook = {
+	color = { 132, 186, 180 },
+	range = 28,
+	brightness = 1.6,
+	height = 1.4,
+	-- A wide bare ember at the ring's heart: the pool of cold light seen from
+	-- the high camera, not a lantern.
+	ember = 6,
+	pulse = { style = "breathe", depth = 0.18, period = 7 },
+}
+local well: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "Moonwell", size = Sculpts.moonwell_ring.size, sculpt = "moonwell_ring", light = WELL_LIGHT },
+	},
+	perHundredCells = 0,
+	count = 1,
+	spacing = 220,
+	clearance = 4,
+	quiet = true,
+	-- The area's landmark (B11): the dressing fails without the well.
+	least = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 1, 1 },
+	sink = 0.5,
+}
+props.moonwell = table.freeze(well)
+
+local moonwell = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+moonwell.name = "moonwell"
+moonwell.palette = "dark blue-black woodland, pale green-grey weathered stone, still black water, "
+	.. "one cold silver-teal glow, desaturated, matte, no highlights"
+moonwell.lighting = "mood"
+moonwell.props = table.freeze(props)
+moonwell.ground = with(Moor.ground, {
+	heath = moonlit(Moor.ground.heath),
+	road = moonlit(Moor.ground.road),
+	ruin = moonlit(Moor.ground.ruin),
+})
+
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+local cliffs = table.clone(edges["cliff"].pieces)
+for i, piece in cliffs do
+	cliffs[i] = with(piece, { color = PALE })
+end
+edges["cliff"] = with(edges["cliff"], { pieces = cliffs })
+-- The wood at the rim: the moor's trees dark as night, with the order's own
+-- tall and leaning trees among them.
+local trees = table.clone(edges["thicket"].pieces)
+for i, piece in trees do
+	if piece.sculpt then
+		trees[i] = with(piece, { name = "MoonTree", size = Sculpts.moonwell_tree.size, sculpt = "moonwell_tree" })
+	else
+		trees[i] = with(piece, { color = BARK })
+	end
+end
+table.insert(trees, {
+	name = "LeaningTree",
+	size = Sculpts.moonwell_tree_leaning.size,
+	sculpt = "moonwell_tree_leaning",
+	weight = 0.8,
+})
+edges["thicket"] = with(edges["thicket"], { pieces = trees, scale = { 2, 3.2 }, spacing = 5, sink = 0.6 })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = moonlit(edge.ground) })
+	end
+end
+moonwell.edges = table.freeze(edges) :: any
+if Moor.outcrop.ground then
