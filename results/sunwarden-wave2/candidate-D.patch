+--!strict
+-- The Sunwarden boots (Grashan Ruins, levels 16-20): green-bronze greaves with
+-- a pale stone ridge down the shin, bright bronze knee bands, and dark bronze
+-- sabatons capped in bronze. The right shin is chipped to the pale stone
+-- beneath and only the left ankle keeps its old dark strap, so the pair wears
+-- unevenly.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Old green-bronze with pale ruin stone worn over it.
+local stonePale = { 174, 167, 150 }
+local bronze = { 112, 134, 82 }
+local bronzeDark = { 78, 96, 54 }
+local bronzeEdge = { 136, 152, 92 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenBoots",
+	slot = "Boots",
+	parts = {
+		Kit.box("LowerLeg", { 1.16, 0.92, 1.16 }, { 0, -0.05, 0 }, "Metal", bronze),
+		Kit.box("LowerLeg", { 1.2, 0.2, 1.2 }, { 0, 0.4, 0 }, "Metal", bronzeEdge),
+		Kit.box("LowerLeg", { 0.16, 0.78, 0.14 }, { 0, -0.07, -0.62 }, "Marble", stonePale),
+		Kit.box("Foot", { 1.14, 0.38, 1.2 }, { 0, 0.02, -0.03 }, "Metal", bronzeDark),
+		Kit.box("Foot", { 1.08, 0.3, 0.28 }, { 0, 0.02, -0.68 }, "Metal", bronzeEdge),
+		-- The bronze knocked off the right shin, showing the pale stone beneath.
+		Kit.box("LowerLeg", { 0.3, 0.2, 0.12 }, { 0.44, 0.06, -0.6 }, "Marble", stonePale, nil, "Right"),
+		-- One dark ankle strap, kept on the left after a repair.
+		Kit.box("Foot", { 1.16, 0.1, 1.24 }, { 0, 0.16, -0.02 }, "Metal", bronzeDark, nil, "Left"),
+	},
+}
+
+return look
