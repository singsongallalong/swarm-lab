+		Kit.box("LowerArm", { 1.2, 0.22, 1.2 }, { 0, 0.4, 0 }, "Metal", bronzeEdge),
+		Kit.box("LowerArm", { 0.16, 0.7, 0.46 }, { 0.58, -0.08, 0 }, "Marble", stonePale),
+		Kit.box("Hand", { 1.12, 0.4, 1.12 }, { 0, 0, 0 }, "Metal", bronze),
+		Kit.box("Hand", { 1.02, 0.16, 0.3 }, { 0, 0.12, -0.52 }, "Marble", stonePale),
+		-- The stone knocked off the right knuckle plate, showing the bronze.
+		Kit.box("Hand", { 0.24, 0.12, 0.08 }, { 0.34, 0.14, -0.69 }, "Metal", bronzeDark, nil, "Right"),
+		-- One dark wrist binding, kept on the left after a repair.
+		Kit.box("LowerArm", { 1.18, 0.1, 1.18 }, { 0, -0.36, 0 }, "Metal", bronzeDark, nil, "Left"),
+	},
+}
+
