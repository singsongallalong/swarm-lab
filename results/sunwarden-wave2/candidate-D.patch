+--!strict
+-- The Sunwarden chest (Grashan Ruins, levels 16-20): the sentinels' stone
+-- breastplate over an old green-bronze cuirass, cut with a bronze sun in a
+-- gold ring. Massive stone pauldrons square and step the shoulders, a stone
+-- girdle and green-bronze belt hold the belt line, and stone tassets hang
+-- from the thighs. At the high camera it is a broad T of pale stone blocks.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Pale ruin stone over old green-bronze, with the sun's gold at the centre.
+local stone = { 146, 140, 125 }
+local stonePale = { 174, 167, 150 }
+local stoneDark = { 106, 101, 89 }
+local bronze = { 112, 134, 82 }
+local bronzeDark = { 78, 96, 54 }
+local bronzeEdge = { 136, 152, 92 }
+local gold = { 186, 152, 84 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Stone tassets front and back, hung from the thighs so they swing.
+		Kit.flaps(0.56, "Granite", stone),
+		{
+			-- The bronze cuirass beneath, and the hewn plates over it.
+			Kit.box("UpperTorso", { 2.04, 1.64, 1.06 }, { 0, 0, 0 }, "Metal", bronzeDark),
+			Kit.box("UpperTorso", { 1.96, 1.18, 0.18 }, { 0, 0.14, -0.55 }, "Granite", stone),
+			Kit.box("UpperTorso", { 1.9, 1.12, 0.16 }, { 0, 0.12, 0.55 }, "Granite", stone),
+			-- A green-bronze sun ringed in gold, set in the stone.
+			{
+				on = "UpperTorso",
+				shape = "Cylinder",
+				size = { 0.92, 0.1, 0.92 },
+				at = { 0, 0.18, -0.63 },
+				turn = { 90, 0, 0 },
+				material = "Metal",
+				color = gold,
+			},
+			{
+				on = "UpperTorso",
+				shape = "Cylinder",
+				size = { 0.68, 0.14, 0.68 },
+				at = { 0, 0.18, -0.66 },
+				turn = { 90, 0, 0 },
+				material = "Metal",
+				color = bronze,
+			},
+			-- A bronze collar, and a bronze sun set in the backplate, the one
+			-- face most players see from the high camera.
+			Kit.box("UpperTorso", { 1.28, 0.22, 1.12 }, { 0, 0.8, 0 }, "Metal", bronze),
+			{
+				on = "UpperTorso",
+				shape = "Cylinder",
+				size = { 0.62, 0.14, 0.62 },
+				at = { 0, 0.16, 0.66 },
+				turn = { 90, 0, 0 },
+				material = "Metal",
+				color = bronze,
+			},
+			-- One crack run across the breastplate, off centre.
+			Kit.box("UpperTorso", { 0.07, 0.62, 0.06 }, { -0.46, 0.16, -0.65 }, "Slate", stoneDark, { 0, 0, 10 }),
+			-- The girdle and its heavy belt, buckled off centre.
+			Kit.box("LowerTorso", { 2.12, 0.42, 1.12 }, { 0, 0, 0 }, "Granite", stoneDark),
+			Kit.box("LowerTorso", { 2.16, 0.18, 1.16 }, { 0, -0.02, 0 }, "Metal", bronze),
+			Kit.box("LowerTorso", { 0.36, 0.24, 0.1 }, { 0.3, -0.02, -0.62 }, "Metal", bronzeEdge),
+			-- Squared stone pauldrons, stepped up like the Colossus's shoulders,
+			-- over a bronze sleeve that closes the arm below them.
+			Kit.box("UpperArm", { 1.46, 0.48, 1.46 }, { 0.14, 0.5, 0 }, "Granite", stone),
+			Kit.box("UpperArm", { 1.12, 0.26, 1.12 }, { 0.14, 0.76, 0 }, "Marble", stonePale),
+			Kit.box("UpperArm", { 1.5, 0.1, 1.5 }, { 0.14, 0.24, 0 }, "Metal", bronze),
+			Kit.box("UpperArm", { 1.2, 0.94, 1.2 }, { 0.06, -0.21, 0 }, "Metal", bronze),
+			-- The facing stone chipped off the right shoulder, showing the bronze.
+			Kit.box("UpperArm", { 0.24, 0.14, 0.36 }, { 0.78, 0.7, -0.35 }, "Metal", bronzeDark, nil, "Right"),
+		},
+	}),
+}
+
+return look
