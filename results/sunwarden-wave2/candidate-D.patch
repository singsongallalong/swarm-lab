+--!strict
+-- The Sunwarden helm (Grashan Ruins, levels 16-20): the stone war-mask of the
+-- ancient sentinels the Statue Colossus was carved after. Two hewn shells
+-- under a flat stepped crown with a bronze crest swept up its back, a dark
+-- eye slit and a stone nose ridge, a gold brow band and its sun disc. From
+-- the high camera it reads as a pale square head crowned in gold.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- Pale ruin stone over old green-bronze; gold is only ever the brow.
+local stone = { 146, 140, 125 }
+local stonePale = { 174, 167, 150 }
+local stoneDark = { 106, 101, 89 }
+local bronze = { 112, 134, 82 }
+local bronzeDark = { 78, 96, 54 }
+local gold = { 186, 152, 84 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The skull of the mask, hewn rather than forged.
+		Kit.box("Head", { 1.42, 0.88, 1.42 }, { 0, 0.28, 0 }, "Granite", stone),
+		Kit.box("Head", { 1.34, 0.68, 1.34 }, { 0, -0.38, 0 }, "Granite", stone),
+		-- A flat crown in two steps, set a little off centre as the statues are.
+		Kit.box("Head", { 1.56, 0.18, 1.56 }, { 0.03, 0.79, 0 }, "Marble", stonePale),
+		Kit.box("Head", { 1.12, 0.16, 1.12 }, { 0.03, 0.92, 0 }, "Granite", stone),
+		-- A bronze crest swept up the back of the crown, the one line here
+		-- that is not a box.
+		{
+			on = "Head",
+			shape = "Wedge",
+			size = { 0.2, 0.36, 1.18 },
+			at = { 0.03, 1.02, 0.04 },
+			material = "Metal",
+			color = bronze,
+		},
+		-- The brow: a gold band round the mask and the sun cut in gold.
+		Kit.box("Head", { 1.5, 0.2, 1.5 }, { 0, 0.0, 0 }, "Metal", gold),
+		Kit.box("Head", { 0.96, 0.11, 0.07 }, { 0, 0.0, -0.77 }, "Slate", c.ironDark),
+		Kit.box("Head", { 0.18, 0.62, 0.12 }, { 0, -0.34, -0.7 }, "Marble", stonePale),
+		{
+			on = "Head",
+			shape = "Cylinder",
+			size = { 0.52, 0.2, 0.52 },
+			at = { 0, 0.16, -0.78 },
+			turn = { 90, 0, 0 },
+			material = "Metal",
+			color = gold,
+		},
+		-- The squared jaw and the bronze guard at the nape.
+		Kit.box("Head", { 1.4, 0.14, 1.4 }, { 0, -0.68, 0 }, "Marble", stonePale),
+		Kit.box("Head", { 1.18, 0.34, 0.3 }, { 0, -0.52, 0.64 }, "Metal", bronzeDark),
+		-- A crack run down the left cheek from the eye slit.
+		Kit.box("Head", { 0.07, 0.54, 0.06 }, { -0.38, -0.3, -0.73 }, "Slate", stoneDark, { 0, 0, 9 }),
+	},
+}
+
+return look
