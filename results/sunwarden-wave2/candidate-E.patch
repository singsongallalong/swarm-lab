+-- The Sunwarden helm (Grashan Ruins set): a heavy old-bronze sentinel bowl with
+-- a pale stone mask and brow, a thick bronze crest running front to back with a
+-- sun-gold ridge along its top, and flat cheek plates at either side. The crest
+-- and the pale brow carry the outline at the high camera, after the statue
+-- colossus; the left cheek is a little shorter, as wear.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	bronze = { 132, 140, 100 },
+	bronzeDark = { 96, 104, 74 },
+	bronzeWorn = { 168, 172, 128 },
+	stone = { 196, 190, 170 },
+	stoneDark = { 152, 148, 132 },
+	gold = { 180, 150, 84 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "SunwardenHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl's crown stands clear above the head.
+		Kit.box("Head", { 1.36, 0.8, 1.36 }, { 0, 0.28, 0 }, "Metal", c.bronze),
+		Kit.box("Head", { 1.44, 0.16, 1.44 }, { 0, -0.12, 0 }, "Metal", c.bronzeDark),
+		-- A pale stone mask and brow, with a bright bronze nasal down it.
+		Kit.box("Head", { 0.78, 0.44, 0.24 }, { 0, -0.3, -0.62 }, "Marble", c.stone),
+		Kit.box("Head", { 1.24, 0.18, 0.16 }, { 0, 0.02, -0.68 }, "Marble", c.stone),
+		Kit.box("Head", { 0.13, 0.5, 0.12 }, { 0, -0.08, -0.72 }, "Metal", c.bronzeWorn),
+		-- The crest: a broad base, a heavy fin and a sun-gold ridge along its top.
+		Kit.box("Head", { 0.56, 0.14, 1.3 }, { 0, 0.74, 0 }, "Metal", c.bronze),
+		Kit.box("Head", { 0.34, 0.32, 1.18 }, { 0, 0.93, 0 }, "Metal", c.bronze),
+		Kit.box("Head", { 0.26, 0.08, 1.18 }, { 0, 1.12, 0 }, "Metal", c.gold),
+		-- Flat, thick cheek plates.
+		Kit.box("Head", { 0.18, 0.38, 0.66 }, { 0.73, -0.11, 0.01 }, "Metal", c.bronze, { 0, 12, 0 }),
+		Kit.box("Head", { 0.18, 0.34, 0.62 }, { -0.72, -0.13, 0 }, "Metal", c.bronze, { 0, -12, 0 }),
+		-- A pale stone neck guard at the back, over the nape.
+		Kit.box("Head", { 1.14, 0.46, 0.3 }, { 0, -0.34, 0.56 }, "Marble", c.stoneDark, { -12, 0, 0 }),
+	},
+}
+
+return look
