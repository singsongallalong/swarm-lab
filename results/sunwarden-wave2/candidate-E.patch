+-- sun-gold buckle sits on the belt line and bronze tassets banded in stone hang
+-- from the backs of the thighs. One scale row is worn short off centre and a
+-- darker stone patch marks the left breast.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	bronze = { 132, 140, 100 },
+	bronzeDark = { 96, 104, 74 },
