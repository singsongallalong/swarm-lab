+--!strict
+-- The reaver's wolf-pelt hood (the Reaver set's helm): a grizzled pelt drawn
+-- over the head, pale on the crown and a pale rim framing the face, with the
+-- guard hairs swept back over the crown in a crest. One ear stands whole and
+-- one is torn off at the root, a dark tuft of underfur breaks the pale crown,
+-- the wolf's bone snout is kept above the brow, and the pelt's tail hangs down
+-- the back of the neck.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: grizzled grey-brown wolf fur over near-black hide.
+local fur = {
+	mid = { 112, 102, 86 },
+	pale = { 146, 136, 116 },
+	root = { 62, 55, 46 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The pelt over the crown, pale where the moon catches it.
+		Kit.box("Head", { 1.4, 0.7, 1.4 }, { 0, 0.3, 0 }, "Leather", fur.mid),
+		Kit.box("Head", { 1.3, 0.24, 1.3 }, { 0, 0.66, 0 }, "Leather", fur.pale),
+		-- Its pale rim, low over the brow, framing the face.
+		Kit.box("Head", { 1.48, 0.18, 1.48 }, { 0, -0.02, 0 }, "Leather", fur.pale),
+		-- The guard hairs swept back over the crown, the front lock falling.
+		Kit.wedge("Head", { 0.44, 0.7, 1.2 }, { -0.12, 0.8, 0 }, "Leather", fur.pale, { 0, 0, -4 }),
+		Kit.box("Head", { 0.26, 0.36, 0.42 }, { -0.2, 0.84, -0.58 }, "Leather", fur.mid, { 0, 0, 8 }),
+		-- A dark tuft of underfur breaking the pale crown, off to one side.
+		Kit.box("Head", { 0.52, 0.2, 0.5 }, { 0.42, 0.76, 0.18 }, "Leather", fur.root, { 0, 0, -8 }),
+		-- The right ear whole; the left torn off at the root, dark.
+		Kit.wedge("Head", { 0.44, 0.54, 0.56 }, { 0.52, 0.82, 0 }, "Leather", fur.mid, { 0, 0, -20 }),
+		Kit.box("Head", { 0.36, 0.28, 0.44 }, { -0.52, 0.74, 0.04 }, "Leather", fur.root, { 0, 0, 16 }),
+		-- Fur standing at the cheeks, clear of the face.
+		Kit.box("Head", { 0.18, 0.56, 0.46 }, { 0.74, -0.22, 0.08 }, "Leather", fur.mid, { 0, 0, 4 }),
+		-- The pelt's tail down the back of the neck, torn short on one side.
+		Kit.box("Head", { 1.28, 0.68, 0.32 }, { 0, -0.34, 0.72 }, "Leather", fur.mid),
+		Kit.box("Head", { 0.78, 0.3, 0.28 }, { -0.26, -0.72, 0.72 }, "Leather", fur.root, { 8, 0, 0 }),
+		-- The wolf's own snout, bone, kept above the right brow.
+		Kit.box("Head", { 0.36, 0.22, 0.3 }, { 0.24, 0.12, -0.72 }, "Marble", c.bone),
+	},
+}
+
+return look
