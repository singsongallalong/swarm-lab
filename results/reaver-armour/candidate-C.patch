+--!strict
+-- The reaver's pelt and harness (the Reaver set's chest): a big grizzled wolf
+-- mantle thrown over the shoulders, pale lumps of guard hair catching the moon
+-- on top and a torn dark fringe hanging in points over the chest. Under it a
+-- dark hide vest and sleeves crossed by two straps, hide flaps on the thighs, a
+-- bone tusk on one shoulder and a rusted iron scrap on the other, and the
+-- pelt's tail down the back.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: grizzled grey-brown wolf fur over near-black hide.
+local fur = {
+	mid = { 112, 102, 86 },
+	pale = { 146, 136, 116 },
+	root = { 62, 55, 46 },
+	hide = { 70, 57, 45 },
+	hideDark = { 46, 40, 34 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Hide flaps on the thighs.
+		Kit.flaps(0.56, "Leather", fur.hide),
+		{
+			-- The vest and the waist wrap under it.
+			Kit.box("UpperTorso", { 2.06, 1.62, 1.06 }, { 0, 0.01, 0 }, "Leather", fur.hide),
+			Kit.box("LowerTorso", { 2.12, 0.44, 1.12 }, { 0, 0, 0 }, "Leather", fur.hideDark),
+			-- The mantle: a broad fur mass across the shoulders, a torn darker
+			-- fringe beneath it and lumps of pale guard hair on top, uneven as
+			-- a pelt is.
+			Kit.box("UpperTorso", { 2.8, 0.5, 1.6 }, { 0, 0.64, 0 }, "Leather", fur.mid),
+			Kit.box("UpperTorso", { 3.02, 0.28, 1.78 }, { 0, 0.42, 0 }, "Leather", fur.root),
+			Kit.wedge("UpperTorso", { 1.2, 0.3, 0.9 }, { -0.7, 0.84, -0.24 }, "Leather", fur.pale, { 0, 0, -4 }),
+			Kit.wedge("UpperTorso", { 0.95, 0.26, 0.8 }, { -0.04, 0.9, -0.1 }, "Leather", fur.pale, { 0, 0, 3 }),
+			Kit.box("UpperTorso", { 0.85, 0.2, 0.75 }, { 0.62, 0.82, 0.12 }, "Leather", fur.pale, { 0, 0, -3 }),
+			-- A ruff standing at the back of the neck.
+			Kit.box("UpperTorso", { 1.9, 0.38, 0.58 }, { 0, 0.88, 0.3 }, "Leather", fur.mid),
+			-- Points torn from the front of the mantle.
+			Kit.box("UpperTorso", { 0.62, 0.52, 0.18 }, { 0.54, 0.28, -0.58 }, "Leather", fur.mid, { 6, 0, -8 }),
+			Kit.box("UpperTorso", { 0.48, 0.6, 0.18 }, { -0.52, 0.22, -0.58 }, "Leather", fur.root, { -8, 0, 6 }),
+			-- The torn point at the left edge, hanging low.
+			Kit.box("UpperTorso", { 0.38, 0.8, 0.22 }, { -1.3, 0.2, -0.28 }, "Leather", fur.mid, { 0, 0, 12 }),
+			-- Two straps crossing the chest, and a belt with a bone buckle.
+			Kit.box("UpperTorso", { 0.24, 1.7, 0.1 }, { 0, 0, -0.57 }, "Leather", fur.hideDark, { 0, 0, 26 }),
+			Kit.box("UpperTorso", { 0.22, 1.7, 0.09 }, { 0.04, -0.02, -0.58 }, "Leather", fur.hide, { 0, 0, -24 }),
+			Kit.box("LowerTorso", { 2.16, 0.16, 1.16 }, { 0, 0.1, 0 }, "Leather", fur.hideDark),
+			Kit.box("LowerTorso", { 0.3, 0.26, 0.1 }, { -0.34, 0.1, -0.6 }, "Marble", c.bone),
+			-- A rusted iron scrap riveted over the right ribs.
+			Kit.box("UpperTorso", { 0.44, 0.36, 0.1 }, { 0.66, -0.2, -0.57 }, "Metal", c.ironDark, { 0, 0, -5 }),
+			-- The pelt's tail down the back.
+			Kit.box("UpperTorso", { 0.92, 0.7, 0.16 }, { 0.18, 0.14, 0.56 }, "Leather", fur.root, { 0, 0, 4 }),
+			-- Hide sleeves, so the arms are dressed; fur spills over both
+			-- shoulders, more of it on the right with the bone tusk.
+			Kit.box("UpperArm", { 1.06, 1.18, 1.06 }, { 0, 0, 0 }, "Leather", fur.hide),
+			Kit.box("UpperArm", { 1.3, 0.5, 1.3 }, { 0.06, 0.28, 0 }, "Leather", fur.mid, { 0, 0, -8 }),
+			Kit.box("UpperArm", { 1.22, 0.2, 1.22 }, { 0.04, 0.48, 0 }, "Leather", fur.pale, { 0, 0, -6 }, "Right"),
+			Kit.wedge("UpperArm", { 0.2, 0.4, 0.24 }, { 0.24, 0.7, 0 }, "Marble", c.bone, { 0, 0, -18 }, "Right"),
+		},
+	}),
+}
+
+return look
