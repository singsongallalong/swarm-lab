+		Kit.box("LowerArm", { 1.2, 0.28, 1.2 }, { 0, 0.44, 0 }, "Leather", fur.pale),
+		-- A bone splint lashed down the right forearm, a scrap of iron banded
+		-- on the left wrist.
+		Kit.box("LowerArm", { 0.12, 0.5, 0.32 }, { 0.56, -0.26, -0.04 }, "Marble", c.bone, { 6, 0, 0 }, "Right"),
+		Kit.box("LowerArm", { 1.16, 0.1, 1.16 }, { 0, -0.42, 0 }, "Metal", c.ironDark, { 0, 0, 3 }, "Left"),
+		-- The hand wrapped tight, bone over the knuckles.
