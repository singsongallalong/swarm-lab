+--!strict
+-- The reaver's strapped boots (the Reaver set's boots): hide wound round the
+-- shins, lashed, with a shaggy pale fur cuff under each knee. A bone splint
+-- guards the right shin and a rusted iron scrap the left; the boots are dark
+-- hide strapped over the toe.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: grizzled grey-brown wolf fur over near-black hide.
+local fur = {
+	pale = { 146, 136, 116 },
+	hide = { 70, 57, 45 },
+	hideDark = { 46, 40, 34 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverBoots",
+	slot = "Boots",
+	parts = {
+		-- The shin wrap, its lacing and the fur cuff under the knee.
+		Kit.box("LowerLeg", { 1.08, 0.94, 1.08 }, { 0, -0.1, 0 }, "Leather", fur.hide),
+		Kit.box("LowerLeg", { 1.12, 0.12, 1.12 }, { 0, 0.08, 0 }, "Leather", fur.hideDark),
+		Kit.box("LowerLeg", { 1.22, 0.3, 1.22 }, { 0, 0.42, 0 }, "Leather", fur.pale),
+		-- Bone splint right, rusted iron scrap left.
+		Kit.box("LowerLeg", { 0.5, 0.44, 0.1 }, { 0.1, -0.02, -0.57 }, "Marble", c.bone, { -4, 0, 0 }, "Right"),
+		Kit.box("LowerLeg", { 0.46, 0.36, 0.1 }, { -0.06, -0.12, -0.57 }, "Metal", c.ironDark, { 0, 0, 4 }, "Left"),
+		-- The boot and the strap over the toe.
+		Kit.box("Foot", { 1.08, 0.36, 1.16 }, { 0, 0.02, -0.04 }, "Leather", fur.hideDark),
+		Kit.box("Foot", { 1.1, 0.14, 0.2 }, { 0, -0.02, -0.54 }, "Leather", fur.hide),
+	},
+}
+
+return look
