+		Kit.box("LowerArm", { 1.2, 0.24, 1.2 }, { 0, 0.38, 0 }, "Fabric", fur, { 0, 0, -4 }, "Right"),
+		Kit.box("LowerArm", { 0.12, 0.3, 0.12 }, { 0.6, 0.02, 0 }, "Marble", bone, { 0, 0, -24 }, "Right"),
+		-- The left: only a low hide wrap, rope-tied, with a bone toggle.
+		Kit.box("LowerArm", { 1.08, 0.52, 1.08 }, { 0, -0.14, 0 }, "Leather", hide, nil, "Left"),
+		Kit.box("LowerArm", { 1.12, 0.08, 1.12 }, { 0, 0.05, 0 }, "Fabric", rope, nil, "Left"),
+		Kit.box("LowerArm", { 0.14, 0.12, 0.12 }, { 0.56, 0, -0.04 }, "Marble", boneWorn, nil, "Left"),
+		-- Both hands wrapped in hide; a bone knuckle ridge on the right,
+		-- another wrap round the left.
+		Kit.box("Hand", { 1.06, 0.46, 1.06 }, { 0, 0.05, 0 }, "Leather", hide),
+		Kit.box("Hand", { 0.62, 0.12, 0.18 }, { 0, 0.06, -0.52 }, "Marble", bone, nil, "Right"),
