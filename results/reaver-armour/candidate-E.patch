+--!strict
+-- The reaver's chest (the Reaver set): a smoke-cured hide vest with a ragged
+-- hide kilt hung off the thighs, a wolf-fur collar and tail down the back,
+-- and the left shoulder left bare. The right shoulder carries the prize of a
+-- kill: a horned beast's skull lashed over a fur pad, its snout jutting past
+-- the chest. A baldric, a bone clasp and a torn pale patch finish a set worn
+-- and patched, never polished.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local hide = { 66, 57, 49 }
+local hideDark = { 44, 38, 33 }
+local hideWorn = { 112, 96, 78 }
+local strap = { 84, 70, 56 }
+local fur = { 92, 82, 68 }
+local furPale = { 122, 110, 92 }
+local bone = { 178, 168, 142 }
+local boneWorn = { 140, 130, 110 }
+local iron = Kit.colors.iron
+local rust = Kit.colors.rust
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- A ragged hide kilt off the thighs, the left side torn shorter.
+		Kit.flaps(0.66, "Leather", hide),
+		{
+			Kit.box("UpperLeg", { 0.1, 0.56, 0.7 }, { 0.48, 0.38, 0 }, "Leather", hide, { 0, 0, 3 }, "Right"),
+			Kit.box("UpperLeg", { 0.1, 0.44, 0.62 }, { 0.48, 0.44, 0.02 }, "Leather", hideWorn, nil, "Left"),
+			-- The vest itself, over torso and waist.
+			Kit.box("UpperTorso", { 2.08, 1.62, 1.06 }, { 0, 0, 0 }, "Leather", hide),
+			Kit.box("LowerTorso", { 2.12, 0.46, 1.08 }, { 0, 0, 0 }, "Leather", hide),
+			-- A wolf-fur collar over the right shoulder, and its tail down the
+			-- back; the left shoulder stays bare.
+			Kit.box("UpperTorso", { 1.4, 0.26, 1.18 }, { 0.25, 0.72, 0 }, "Fabric", fur, { 0, 0, -5 }),
+			Kit.box("UpperTorso", { 0.9, 0.7, 0.22 }, { 0.2, 0.15, 0.56 }, "Fabric", fur, { 4, 0, -3 }),
+			Kit.box("UpperTorso", { 0.34, 0.5, 0.08 }, { 0.22, 0.12, 0.69 }, "Fabric", furPale, { 4, 0, -3 }),
+			-- A torn patch, paler where the hide wore through.
+			Kit.box("UpperTorso", { 0.44, 0.38, 0.06 }, { -0.52, -0.22, -0.54 }, "Leather", hideWorn, { 0, 0, -7 }),
+			-- A baldric over the left shoulder, buckled in iron.
+			Kit.box("UpperTorso", { 0.3, 1.7, 0.1 }, { 0, 0.02, -0.55 }, "Leather", strap, { 0, 0, 27 }),
+			Kit.box("UpperTorso", { 0.18, 0.2, 0.12 }, { -0.2, 0.42, -0.6 }, "Metal", iron, { 0, 0, 27 }),
+			-- Belt and bone clasp, off centre.
+			Kit.box("LowerTorso", { 2.16, 0.2, 1.14 }, { 0, 0.08, 0 }, "Leather", strap, { 0, 0, 3 }),
+			Kit.box("LowerTorso", { 0.24, 0.16, 0.12 }, { 0.42, 0.06, -0.58 }, "Marble", boneWorn),
+			-- The right arm in a hide sleeve; the left stays bare.
+			Kit.box("UpperArm", { 1.06, 1.24, 1.06 }, { 0, 0, 0 }, "Leather", hide, nil, "Right"),
+			-- The right shoulder: a beast's skull lashed over a fur pad, with
+			-- dark eye sockets, two horns and an old stain on the brow.
+			Kit.box("UpperArm", { 1.32, 0.3, 1.3 }, { 0.04, 0.48, 0 }, "Fabric", fur, { 0, 0, -4 }, "Right"),
+			Kit.box("UpperArm", { 0.96, 0.54, 0.96 }, { 0.1, 0.72, 0 }, "Marble", bone, { 0, 0, -6 }, "Right"),
+			Kit.box("UpperArm", { 0.44, 0.32, 0.56 }, { 0.08, 0.58, -0.66 }, "Marble", bone, nil, "Right"),
+			Kit.box("UpperArm", { 0.36, 0.12, 0.44 }, { 0.08, 0.38, -0.64 }, "Marble", boneWorn, nil, "Right"),
+			Kit.box("UpperArm", { 0.16, 0.14, 0.08 }, { 0.33, 0.78, -0.49 }, "Leather", hideDark, nil, "Right"),
+			Kit.box("UpperArm", { 0.16, 0.14, 0.08 }, { -0.13, 0.78, -0.49 }, "Leather", hideDark, nil, "Right"),
+			Kit.box("UpperArm", { 0.15, 0.44, 0.15 }, { 0.6, 0.9, 0.02 }, "Marble", bone, { 0, 0, -28 }, "Right"),
