+		Kit.box("LowerArm", { 1.12, 0.86, 1.12 }, { 0, -0.14, 0 }, "Leather", hide, nil, "Right"),
+		Kit.box("LowerArm", { 1.16, 0.14, 1.16 }, { 0, -0.36, 0 }, "Metal", iron, nil, "Right"),
