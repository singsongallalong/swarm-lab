+--!strict
+-- The reaver's helm (the Reaver set): a smoke-cured hide cap banded in worn
+-- iron, a ragged wolf-fur crest running over the crown and down the neck, and
+-- one bone horn on the right brow with its broken stump on the left. The fur
+-- ridge and the horn lift the outline from the high camera; the pale rubbed
+-- edges are where the cap is handled.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local hide = { 66, 57, 49 }
+local hideWorn = { 112, 96, 78 }
+local fur = { 92, 82, 68 }
+local furPale = { 122, 110, 92 }
+local bone = { 178, 168, 142 }
+local boneWorn = { 140, 130, 110 }
+local iron = Kit.colors.ironWorn
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The cap, and the iron band worn across its brow.
+		Kit.box("Head", { 1.34, 0.64, 1.34 }, { 0, 0.3, 0 }, "Leather", hide),
+		Kit.box("Head", { 1.4, 0.15, 1.4 }, { 0, -0.02, 0 }, "Metal", iron),
+		-- The wolf-fur crest, set a little off centre and running from a pale
+		-- forelock to a ragged tuft at the crown's back.
+		Kit.box("Head", { 0.46, 0.28, 0.8 }, { 0.05, 0.65, 0.14 }, "Fabric", fur, { 0, 0, 5 }),
+		Kit.box("Head", { 0.34, 0.2, 0.44 }, { 0.07, 0.6, 0.5 }, "Fabric", fur, { 0, 0, 8 }),
+		Kit.box("Head", { 0.32, 0.16, 0.44 }, { 0.02, 0.7, -0.5 }, "Fabric", furPale, { 0, 0, -4 }),
+		-- The mane down the back of the neck.
+		Kit.box("Head", { 1.18, 0.64, 0.34 }, { 0, -0.3, 0.63 }, "Fabric", fur, { -12, 0, 0 }),
+		-- A horn off the right brow, and the stump of the one lost on the left.
+		Kit.box("Head", { 0.19, 0.44, 0.19 }, { 0.61, 0.5, -0.26 }, "Marble", bone, { 0, 0, -24 }),
+		Kit.box("Head", { 0.15, 0.32, 0.15 }, { 0.82, 0.78, -0.3 }, "Marble", boneWorn, { 0, 0, -44 }),
+		Kit.box("Head", { 0.2, 0.2, 0.2 }, { -0.6, 0.4, -0.26 }, "Marble", boneWorn, { 0, 0, 12 }),
+		-- Cheek flaps: the right whole, the left torn short.
+		Kit.box("Head", { 0.1, 0.36, 0.44 }, { 0.7, -0.16, 0 }, "Leather", hide, { 0, 0, -4 }),
+		Kit.box("Head", { 0.1, 0.22, 0.34 }, { -0.7, -0.1, 0.02 }, "Leather", hideWorn, { 0, 0, 6 }),
+	},
+}
+
+return look
