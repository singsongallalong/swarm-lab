+--!strict
+-- The reaver's boots (the Reaver set): shaggy smoke-cured hide boots with a
+-- wolf-fur cuff at the knee and a pale rubbed strap at the ankle. The right
+-- shin is plated in old bone under an iron band, and a strip of fur hangs
+-- down its outside; the left boot is tied with a bone toggle.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local hide = { 66, 57, 49 }
+local hideWorn = { 112, 96, 78 }
+local fur = { 92, 82, 68 }
+local bone = { 178, 168, 142 }
+local boneWorn = { 140, 130, 110 }
+local iron = Kit.colors.iron
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverBoots",
+	slot = "Boots",
+	parts = {
+		-- The boot shaft, fur-cuffed at the knee and strapped at the ankle.
+		Kit.box("LowerLeg", { 1.1, 0.9, 1.1 }, { 0, -0.12, 0 }, "Leather", hide),
+		Kit.box("LowerLeg", { 1.18, 0.26, 1.18 }, { 0, 0.34, 0 }, "Fabric", fur, { 0, 0, 4 }),
+		Kit.box("LowerLeg", { 1.14, 0.1, 1.14 }, { 0, -0.34, 0 }, "Leather", hideWorn, { 0, 0, -5 }),
+		Kit.box("Foot", { 1.08, 0.34, 1.14 }, { 0, 0.02, -0.03 }, "Leather", hide),
+		-- The right shin: an old bone plate under an iron band, fur down the
+		-- outside. The left boot has only a bone toggle.
+		Kit.box("LowerLeg", { 0.6, 0.46, 0.12 }, { 0, -0.06, -0.57 }, "Marble", boneWorn, { -4, 0, 0 }, "Right"),
+		Kit.box("LowerLeg", { 0.66, 0.1, 0.14 }, { 0, -0.33, -0.57 }, "Metal", iron, nil, "Right"),
+		Kit.box("LowerLeg", { 0.16, 0.5, 0.34 }, { 0.56, -0.08, 0.05 }, "Fabric", fur, nil, "Right"),
+		Kit.box("LowerLeg", { 0.14, 0.12, 0.12 }, { 0.56, -0.02, -0.06 }, "Marble", bone, nil, "Left"),
+	},
+}
+
+return look
