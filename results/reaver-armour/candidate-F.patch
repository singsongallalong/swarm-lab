+--!strict
+-- The reaver chest (Reaver set): a hide vest with scavenged iron strapped
+-- over it, never a whole harness. One big two-plate pauldron on the right
+-- and a single scrap on the left, a breastplate off centre, a smaller plate
+-- lower right, a dented back plate, rawhide lashings crossing the chest, a
+-- scuffed belt with an off-centre buckle, a bald fur ruff at the neck and
+-- hide flaps on the thighs. The grey plates and pale lashings break the
+-- brown hide into patches at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Hide flaps hung from the thighs.
+		Kit.flaps(0.52, "Leather", c.leatherDark),
+		{
+			-- The hide vest and its thin hide sleeves.
+			Kit.box("UpperTorso", { 2.04, 1.62, 1.04 }, { 0, 0, 0 }, "Leather", c.leather),
+			Kit.box("LowerTorso", { 2.08, 0.42, 1.08 }, { 0, 0, 0 }, "Leather", c.leatherDark),
+			Kit.box("UpperArm", { 1.06, 1.18, 1.06 }, { 0, 0, 0 }, "Leather", c.leatherDark),
+			-- The big right pauldron: two plates from different helms, the
+			-- upper one bright with wear.
+			Kit.box("UpperArm", { 1.26, 0.28, 1.24 }, { 0.02, 0.56, 0 }, "Metal", c.iron, { 0, 0, -12 }, "Right"),
+			Kit.box("UpperArm", { 1.18, 0.22, 1.16 }, { 0.03, 0.3, 0 }, "Metal", c.ironDark, { 0, 0, -8 }, "Right"),
+			-- Left shoulder: only a torn strip of bright iron over bare hide.
+			Kit.box("UpperArm", { 0.26, 0.16, 1.06 }, { 0, 0.54, 0 }, "Metal", c.ironWorn, { 0, 0, 7 }, "Left"),
+			-- Breastplate off centre, and a smaller plate below right.
+			Kit.box("UpperTorso", { 1.12, 0.72, 0.1 }, { -0.32, 0.14, -0.56 }, "Metal", c.iron, { 0, 0, 5 }),
+			Kit.box("UpperTorso", { 0.64, 0.44, 0.1 }, { 0.5, -0.3, -0.55 }, "Metal", c.ironDark, { 0, 0, -8 }),
+			-- Rust eating the breastplate's edge.
+			Kit.box("UpperTorso", { 0.34, 0.2, 0.06 }, { -0.36, 0.28, -0.63 }, "Metal", c.rust, { 0, 0, 6 }),
+			-- Rawhide lashings: one runs under the breastplate, one across it.
+			Kit.box("UpperTorso", { 0.16, 1.5, 0.08 }, { 0.06, 0.02, -0.57 }, "Fabric", c.rope, { 0, 0, 32 }),
+			Kit.box("UpperTorso", { 1.2, 0.11, 0.08 }, { -0.3, 0.14, -0.63 }, "Fabric", c.rope, { 0, 0, 6 }),
+			-- Dented back plate and a torn patch of pale hide below it.
+			Kit.box("UpperTorso", { 1.34, 0.82, 0.1 }, { 0.08, 0.04, 0.56 }, "Metal", c.ironDark, { 0, 0, -5 }),
+			Kit.box("UpperTorso", { 0.4, 0.3, 0.06 }, { -0.58, -0.52, 0.55 }, "Leather", c.leatherScuff, { 0, 0, 12 }),
+			-- A rawhide strap over the left shoulder, bare of iron.
+			Kit.box("UpperTorso", { 0.18, 1.2, 0.1 }, { -0.5, 0.36, -0.52 }, "Fabric", c.leatherScuff, { 0, 0, -22 }),
+			-- Scuffed belt, buckle off centre, a bone toggle.
+			Kit.box("LowerTorso", { 2.12, 0.18, 1.14 }, { 0, 0.06, 0 }, "Leather", c.leatherScuff),
+			Kit.box("LowerTorso", { 0.28, 0.24, 0.1 }, { 0.44, 0.06, -0.59 }, "Metal", c.ironWorn, { 0, 0, -4 }),
+			Kit.box("LowerTorso", { 0.16, 0.1, 0.1 }, { -0.34, 0.05, -0.61 }, "Marble", c.bone, { 0, 0, 8 }),
+			-- The fur ruff over the shoulders, its left tuft torn short.
+			Kit.box("UpperTorso", { 1.5, 0.24, 0.5 }, { 0, 0.78, 0.18 }, "Fabric", c.felt),
+			Kit.box("UpperTorso", { 0.54, 0.22, 0.5 }, { -0.68, 0.74, -0.3 }, "Fabric", c.leatherScuff, { 0, 18, 9 }),
+			Kit.box("UpperTorso", { 0.44, 0.2, 0.44 }, { 0.68, 0.74, -0.32 }, "Fabric", c.felt, { 0, -14, -8 }),
+		},
+	}),
+}
+
+return look
