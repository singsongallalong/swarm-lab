+--!strict
+-- The reaver boots (Reaver set): hide wraps up the shin, an iron shin plate
+-- lashed on, rawhide ties under the knee, dark hide foot wraps and a scraped
+-- iron toe cap. The left shin carries an extra mismatched side plate and the
+-- right carries rust, and the ties and toe caps read at the high camera.
+-- Lean and tied rather than plated all round, so they stand apart from the
+-- iron family's greaves.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverBoots",
+	slot = "Boots",
+	parts = {
+		Kit.box("LowerLeg", { 1.08, 1.14, 1.08 }, { 0, -0.02, 0 }, "Leather", c.leather),
+		-- The shin plate, a mismatched scrap on the left shin, rust on the
+		-- right.
+		Kit.box("LowerLeg", { 0.8, 0.62, 0.1 }, { 0, 0.02, -0.56 }, "Metal", c.iron, { -6, 0, 0 }),
+		Kit.box("LowerLeg", { 0.1, 0.44, 0.56 }, { 0.55, -0.12, -0.12 }, "Metal", c.ironDark, { 0, 0, 4 }, "Left"),
+		Kit.box("LowerLeg", { 0.26, 0.24, 0.06 }, { 0.14, -0.02, -0.63 }, "Metal", c.rust, { 0, 0, -6 }, "Right"),
+		-- Rawhide tie under the knee.
+		Kit.box("LowerLeg", { 1.14, 0.1, 1.14 }, { 0, 0.4, 0 }, "Fabric", c.rope, { 0, 0, -5 }),
+		Kit.box("Foot", { 1.06, 0.36, 1.18 }, { 0, 0.02, -0.06 }, "Leather", c.leatherDark),
+		-- A scraped iron cap over the toes.
+		Kit.box("Foot", { 0.9, 0.16, 0.3 }, { 0, 0.14, -0.5 }, "Metal", c.ironWorn, { 0, 0, 2 }),
+	},
+}
+
+return look
