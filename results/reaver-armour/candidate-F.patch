+--!strict
+-- The reaver helm (Reaver set): a hide coif pulled over the face with an
+-- iron slit for the eyes, a crown plate torn from another helm and a second
+-- mismatched plate laid over its left side at its own angle, a scraped brow
+-- band, one long right cheek plate and a short crooked left one, rawhide
+-- ties, a hide neck tail and a bone shard lashed above the right ear. The
+-- pale brow band and the bone catch the moon from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- Hide coif over the whole head, chin and all.
+		Kit.box("Head", { 1.32, 1.22, 1.32 }, { 0, 0.02, 0 }, "Leather", c.leather),
+		-- The crown plate, and a torn plate from another helm over the left.
+		Kit.box("Head", { 1.4, 0.46, 1.4 }, { 0, 0.44, 0 }, "Metal", c.iron),
+		Kit.box("Head", { 0.72, 0.26, 0.86 }, { -0.4, 0.62, 0.06 }, "Metal", c.ironDark, { 0, 12, -14 }),
+		-- Scraped brow band, bright where it rubs.
+		Kit.box("Head", { 1.42, 0.12, 1.42 }, { 0, 0.16, 0 }, "Metal", c.ironWorn),
+		-- The eye slit in the mask.
+		Kit.box("Head", { 0.86, 0.11, 0.06 }, { 0, -0.02, -0.68 }, "Metal", c.bogWet),
+		-- Rust eaten into the crown above the right eye.
+		Kit.box("Head", { 0.3, 0.16, 0.06 }, { 0.3, 0.42, -0.72 }, "Metal", c.rust, { 0, 0, 8 }),
+		-- Right cheek plate long, left one short and set crooked.
+		Kit.box("Head", { 0.1, 0.52, 0.46 }, { 0.68, -0.22, -0.3 }, "Metal", c.iron, { 0, 0, 4 }),
+		Kit.box("Head", { 0.1, 0.34, 0.38 }, { -0.68, -0.14, -0.32 }, "Metal", c.ironDark, { 0, 0, -7 }),
+		-- Rawhide ties round the base, and a hide tail at the back of the neck.
+		Kit.box("Head", { 1.38, 0.11, 1.38 }, { 0, -0.3, 0 }, "Fabric", c.rope),
+		Kit.box("Head", { 1.2, 0.5, 0.4 }, { 0, -0.26, 0.52 }, "Leather", c.leatherDark),
+		-- A bone shard lashed above the right ear.
+		Kit.box("Head", { 0.08, 0.26, 0.1 }, { 0.73, 0.5, -0.3 }, "Marble", c.bone, { 0, 0, 16 }),
+	},
+}
+
+return look
