+		Kit.box("LowerArm", { 0.12, 0.64, 0.5 }, { 0.56, -0.06, -0.2 }, "Metal", c.iron, { 0, 0, 3 }),
+		Kit.box("LowerArm", { 0.1, 0.36, 0.4 }, { 0.56, 0.18, -0.24 }, "Metal", c.ironDark, { 0, 0, -7 }, "Right"),
+		-- Rawhide wraps at wrist and elbow.
+		Kit.box("LowerArm", { 1.14, 0.12, 1.14 }, { 0, -0.42, 0 }, "Fabric", c.rope),
+		Kit.box("LowerArm", { 1.14, 0.1, 1.14 }, { 0, 0.44, 0 }, "Fabric", c.rope, { 0, 0, -4 }),
+		Kit.box("Hand", { 1.06, 0.34, 1.06 }, { 0, 0, 0 }, "Leather", c.leatherDark),
+		-- A bone toggle through the left wrist wrap.
+		Kit.box("LowerArm", { 0.14, 0.14, 0.14 }, { -0.4, -0.42, -0.52 }, "Marble", c.bone, { 0, 0, 10 }, "Left"),
+	},
+}
+
+return look
