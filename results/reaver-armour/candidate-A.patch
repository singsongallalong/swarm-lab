+--!strict
+-- The reaver helm (the Reaver set): the skull of a horned beast worn over the
+-- head, its brow and muzzle jutting over the face so the eyes sit in shadow
+-- beneath it. Two stepped bone horns sweep up and out past the head's width,
+-- and a wolf-grey fur mane hangs down the back of the neck. The trophy reads
+-- first at the high camera: pale bone against smoked hide.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's palette: smoked hide, wolf-grey fur and bone left to bleach,
+-- warmer and paler than any of the fen's greys.
+local c = {
+	bone = { 184, 174, 148 },
+	boneDark = { 138, 126, 102 },
+	fur = { 92, 88, 80 },
+	pit = { 28, 24, 21 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The skull case over the crown.
+		Kit.box("Head", { 1.38, 0.7, 1.36 }, { 0, 0.26, 0 }, "Marble", c.bone),
+		-- A heavy brow, and the snout sloping down over the face.
+		Kit.box("Head", { 1.44, 0.22, 0.3 }, { 0, -0.06, -0.64 }, "Marble", c.bone),
+		Kit.wedge("Head", { 0.5, 0.3, 0.6 }, { 0, -0.16, -0.74 }, "Marble", c.boneDark),
+		Kit.box("Head", { 0.78, 0.16, 0.5 }, { 0, -0.34, -0.72 }, "Marble", c.boneDark),
+		-- The lower tusks, one either side of the jaw.
+		Kit.box("Head", { 0.12, 0.3, 0.12 }, { 0.26, -0.36, -0.86 }, "Marble", c.bone, { 0, 0, -6 }),
+		-- Eye hollows set proud of the brow, so they read as two dark pits.
+		Kit.box("Head", { 0.26, 0.16, 0.1 }, { 0.3, -0.12, -0.8 }, "Metal", c.pit),
+		-- A horn in three stepped pieces, curving out and then up.
+		Kit.box("Head", { 0.4, 0.52, 0.4 }, { 0.7, 0.42, 0.04 }, "Marble", c.boneDark, { 0, 0, -40 }),
+		Kit.box("Head", { 0.3, 0.46, 0.3 }, { 1.0, 0.64, 0.03 }, "Marble", c.bone, { 0, 0, -72 }),
+		Kit.box("Head", { 0.22, 0.42, 0.22 }, { 1.16, 0.92, 0.02 }, "Marble", c.bone, { 0, 0, -22 }),
+		-- The mane, hanging to the nape below the skull.
+		Kit.box("Head", { 1.5, 0.9, 0.44 }, { 0, -0.28, 0.56 }, "Fabric", c.fur),
+		-- Cheek plates closing the sides of the head under the skull case.
+		Kit.box("Head", { 0.12, 0.5, 0.62 }, { 0.7, -0.3, -0.14 }, "Marble", c.boneDark, { 0, 0, 3 }),
+	},
+}
+
+return look
