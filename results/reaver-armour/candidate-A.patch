+--!strict
+-- The reaver chest (the Reaver set): smoked hide strapped over a chest that is
+-- only half armoured. A broad wolf-fur mantle lies across the shoulders, heavier
+-- on the right, where a beast's jawbone caps a furred sleeve; the left arm is
+-- bare hide. A skull trophy rides the belt beside a row of fangs laced on the
+-- left breast, and torn fur tails hang from the thighs. Broad at the shoulders,
+-- pale bone at the neck and waist, so it reads as its own family from above.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	hide = { 70, 62, 54 },
+	hideDark = { 46, 40, 34 },
+	hideScuff = { 98, 86, 72 },
+	fur = { 92, 88, 80 },
+	furDark = { 62, 58, 51 },
+	bone = { 184, 174, 148 },
+	boneDark = { 138, 126, 102 },
+	sinew = { 114, 96, 72 },
+	pit = { 28, 24, 21 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Fur tails on the thighs, front and back, so they swing with the legs.
+		Kit.flaps(0.75, "Leather", c.furDark),
+		{
+			-- The hide body and the hip wrap under it.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Leather", c.hide),
+			Kit.box("LowerTorso", { 2.1, 0.44, 1.1 }, { 0, 0, 0 }, "Leather", c.hideDark),
+			-- The baldric across the chest, and the belt under it.
+			Kit.box("UpperTorso", { 0.32, 1.9, 0.1 }, { 0, 0.02, -0.57 }, "Leather", c.hideDark, { 0, 0, 26 }),
+			Kit.box("UpperTorso", { 2.14, 0.24, 1.14 }, { 0, -0.5, 0 }, "Leather", c.hideDark),
+			Kit.box("UpperTorso", { 2.18, 0.1, 1.18 }, { 0, -0.34, 0 }, "Fabric", c.sinew, { 0, 0, 3 }),
+			-- The belt skull, snout and eye hollow.
+			Kit.box("UpperTorso", { 0.44, 0.36, 0.26 }, { 0.44, -0.5, -0.6 }, "Marble", c.bone),
+			Kit.box("UpperTorso", { 0.26, 0.18, 0.2 }, { 0.44, -0.62, -0.7 }, "Marble", c.boneDark),
+			Kit.box("UpperTorso", { 0.3, 0.07, 0.06 }, { 0.44, -0.46, -0.75 }, "Metal", c.pit),
+			-- The fur mantle, broad across both shoulders and heavier on the right.
+			Kit.box("UpperTorso", { 2.56, 0.38, 1.34 }, { 0, 0.62, 0 }, "Fabric", c.fur, { 0, 0, -2 }),
+			Kit.box("UpperTorso", { 1.16, 0.5, 1.3 }, { 0.7, 0.5, 0 }, "Fabric", c.fur, { 0, 0, -8 }),
+			-- The wolf pelt down the back, ragged at its lower edge, and the
+			-- scuffed patch on the left breast.
+			Kit.box("UpperTorso", { 1.6, 0.9, 0.24 }, { 0, -0.1, 0.6 }, "Fabric", c.fur),
+			Kit.box("UpperTorso", { 1.24, 0.28, 0.26 }, { 0, -0.56, 0.6 }, "Fabric", c.furDark),
+			Kit.box("UpperTorso", { 0.6, 0.4, 0.08 }, { -0.55, 0.55, -0.58 }, "Leather", c.hideScuff, { 0, 0, 8 }),
+			-- Three fangs laced on the left breast, at uneven heights.
+			Kit.box("UpperTorso", { 0.16, 0.34, 0.12 }, { -0.58, 0.3, -0.63 }, "Marble", c.bone, { 0, 0, 8 }),
+			Kit.box("UpperTorso", { 0.16, 0.34, 0.12 }, { -0.3, 0.38, -0.63 }, "Marble", c.bone, { 0, 0, -4 }),
+			Kit.box("UpperTorso", { 0.16, 0.34, 0.12 }, { -0.02, 0.32, -0.63 }, "Marble", c.bone, { 0, 0, 5 }),
+			-- The right arm furred, the left left bare: the jawbone cap and its fangs.
+			Kit.box("UpperArm", { 1.12, 1.0, 1.12 }, { 0, 0.05, 0 }, "Fabric", c.fur, nil, "Right"),
+			Kit.box("UpperArm", { 1.18, 0.2, 1.16 }, { 0.02, 0.5, 0 }, "Marble", c.boneDark, { 0, 0, -8 }, "Right"),
+			Kit.box("UpperArm", { 0.1, 0.2, 0.1 }, { 0.24, 0.34, -0.5 }, "Marble", c.bone, { 12, 0, 0 }, "Right"),
+			Kit.box("UpperArm", { 0.1, 0.2, 0.1 }, { 0.5, 0.34, -0.5 }, "Marble", c.bone, { 12, 0, 0 }, "Right"),
+		},
+	}),
+}
+
+return look
