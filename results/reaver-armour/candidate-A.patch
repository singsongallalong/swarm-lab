@@ -0,0 +1,37 @@
+--!strict
+-- The reaver boots (the Reaver set): smoked hide boots furred at the knee and
+-- bound with sinew, a split shin bone strapped over each shin and a bone toe
+-- cap on the right boot alone. A shaggy tuft hangs off the right cuff, so the
+-- pair is never quite matched; the pale bone at the shin and toe reads the
+-- set's trophy family from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	hide = { 70, 62, 54 },
+	hideDark = { 46, 40, 34 },
+	fur = { 92, 88, 80 },
+	furDark = { 62, 58, 51 },
+	bone = { 184, 174, 148 },
+	boneDark = { 138, 126, 102 },
+	sinew = { 114, 96, 72 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReaverBoots",
+	slot = "Boots",
+	parts = {
+		Kit.box("LowerLeg", { 1.1, 0.96, 1.1 }, { 0, -0.06, 0 }, "Leather", c.hide),
+		Kit.box("LowerLeg", { 1.24, 0.26, 1.24 }, { 0, 0.4, 0 }, "Fabric", c.fur),
+		-- The split shin bone, and the sinew tie below it.
+		Kit.box("LowerLeg", { 0.78, 0.6, 0.14 }, { 0, -0.08, -0.56 }, "Marble", c.boneDark, { -4, 0, 0 }),
+		Kit.box("LowerLeg", { 1.14, 0.09, 1.14 }, { 0, -0.32, 0 }, "Fabric", c.sinew, { 0, 0, 3 }),
+		-- The shaggy tuft at the right knee.
+		Kit.box("LowerLeg", { 0.22, 0.4, 0.3 }, { 0.56, 0.2, -0.22 }, "Fabric", c.furDark, nil, "Right"),
+		-- The boot and the bone cap on the right toe.
+		Kit.box("Foot", { 1.06, 0.38, 1.16 }, { 0, 0.01, -0.04 }, "Leather", c.hideDark),
+		Kit.box("Foot", { 0.9, 0.24, 0.34 }, { 0, 0.1, -0.56 }, "Marble", c.bone, nil, "Right"),
+	},
+}
+
+return look
