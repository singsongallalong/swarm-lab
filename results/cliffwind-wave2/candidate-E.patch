+--!strict
+-- The Cliffwind dress (zone armour, the CliffwindDress base): the ridge
+-- valkyrie's bodice and the top of a long gown. A slim cloud-white bodice over
+-- a warm rock-tan corset cross-laced in steel, a high white collar and a short
+-- white cape hung below the shoulder tops, edged in sky blue. A tan belt
+-- cinches the waist over a sky sash, with a white bow set off centre at the
+-- back. The skirt flares from the hip as long white panels over a sky-blue
+-- underskirt, stopped above the knee so the shins can stride.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local sky = { 128, 152, 176 }
+local cloud = { 172, 176, 180 }
+local tan = { 164, 136, 104 }
+local tanDark = { 124, 104, 80 }
+local steel = { 132, 138, 146 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CliffwindDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- A slim white bodice, with the tan corset laced in steel and edged white.
+			Kit.box("UpperTorso", { 2.04, 1.64, 1.04 }, { 0, 0, 0 }, "Fabric", cloud),
+			Kit.box("UpperTorso", { 1.16, 1.10, 0.06 }, { 0, -0.22, -0.545 }, "Leather", tan),
+			Kit.box("UpperTorso", { 1.20, 0.08, 0.05 }, { 0, 0.33, -0.575 }, "Fabric", cloud),
+			Kit.box("UpperTorso", { 0.05, 0.70, 0.04 }, { 0, -0.22, -0.59 }, "Metal", steel, { 0, 0, 30 }),
+			Kit.box("UpperTorso", { 0.05, 0.70, 0.04 }, { 0, -0.22, -0.59 }, "Metal", steel, { 0, 0, -30 }),
+			-- A high cloud collar with a sky rim and a steel brooch.
+			Kit.box("UpperTorso", { 1.06, 0.24, 1.06 }, { 0, 0.90, 0 }, "Fabric", cloud),
+			Kit.box("UpperTorso", { 1.00, 0.08, 1.00 }, { 0, 1.03, 0 }, "Fabric", sky),
+			Kit.box("UpperTorso", { 0.16, 0.14, 0.10 }, { 0.12, 0.86, -0.55 }, "Metal", steel),
+			-- The short cloud cape, edged in sky, hung below the shoulder tops.
+			Kit.box("UpperTorso", { 1.70, 1.26, 0.10 }, { 0, 0.06, 0.60 }, "Fabric", cloud),
+			Kit.box("UpperTorso", { 1.72, 0.14, 0.12 }, { 0, -0.55, 0.62 }, "Fabric", sky),
+			Kit.box("UpperTorso", { 1.34, 0.10, 0.12 }, { 0, 0.62, 0.56 }, "Leather", tan),
+			-- A sky-blue sleeve kept close to the upper arm.
+			Kit.box("UpperArm", { 1.05, 1.2, 1.05 }, { 0, 0, 0 }, "Fabric", sky),
+		},
+		{
+			-- The waist: a sky sash, a tan belt and its steel buckle, worn off centre.
+			Kit.box("LowerTorso", { 2.02, 0.36, 1.04 }, { 0, 0, 0 }, "Fabric", sky),
+			Kit.box("LowerTorso", { 2.06, 0.18, 1.08 }, { 0, 0.02, 0 }, "Leather", tan),
+			Kit.box("LowerTorso", { 0.30, 0.22, 0.10 }, { 0.04, 0.02, -0.57 }, "Metal", steel),
+			Kit.box("LowerTorso", { 0.26, 0.08, 0.06 }, { -0.50, 0.03, -0.56 }, "Leather", tanDark),
+			-- A white bow at the back, its knot off centre.
+			Kit.box("LowerTorso", { 0.18, 0.18, 0.14 }, { 0.16, 0.04, 0.56 }, "Fabric", cloud),
+			Kit.box("LowerTorso", { 0.32, 0.16, 0.10 }, { 0.38, 0.10, 0.55 }, "Fabric", cloud, { 0, 0, 18 }),
+			Kit.box("LowerTorso", { 0.30, 0.16, 0.10 }, { -0.06, 0.10, 0.55 }, "Fabric", cloud, { 0, 0, -22 }),
+		},
+		{
+			-- The skirt from the hip: a sky underskirt under long, flaring white
+			-- panels. The white overskirt parts over a blue centre panel, and its
+			-- front and back panels meet at the centre standing.
+			Kit.box("UpperLeg", { 1.06, 1.20, 1.06 }, { 0, 0.15, 0 }, "Fabric", sky),
+			Kit.box("UpperLeg", { 1.34, 1.20, 0.10 }, { 0.12, 0.15, -0.56 }, "Fabric", cloud, { 8, 0, 6 }),
+			Kit.box("UpperLeg", { 1.34, 1.20, 0.10 }, { 0.12, 0.15, 0.56 }, "Fabric", cloud, { -8, 0, 6 }),
