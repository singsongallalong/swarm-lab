+local look: ArmourLookTypes.ArmourLook = {
+	name = "CliffwindHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The hood's crown, back and cheeks, open at the face.
+		Kit.box("Head", { 1.32, 0.34, 1.32 }, { 0, 0.52, 0.02 }, "Fabric", sky),
+		Kit.box("Head", { 1.32, 0.92, 0.32 }, { 0, 0.04, 0.52 }, "Fabric", sky),
+		Kit.box("Head", { 0.28, 0.88, 1.10 }, { 0.54, 0, 0.06 }, "Fabric", sky),
+		Kit.box("Head", { 0.28, 0.88, 1.10 }, { -0.54, 0, 0.06 }, "Fabric", sky),
+		-- A white edge down each cheek, framing the face.
+		Kit.box("Head", { 0.08, 0.66, 0.10 }, { 0.54, -0.02, -0.50 }, "Fabric", cloud),
+		Kit.box("Head", { 0.08, 0.66, 0.10 }, { -0.54, -0.02, -0.50 }, "Fabric", cloud),
+		-- The brow, lifted clear of the eyes and trimmed in cloud white.
+		Kit.box("Head", { 1.30, 0.20, 0.20 }, { 0, 0.44, -0.58 }, "Fabric", sky),
+		Kit.box("Head", { 1.24, 0.07, 0.08 }, { 0, 0.33, -0.68 }, "Fabric", cloud),
+		-- A thin steel circlet across the brow, its clasp set a little off centre.
+		Kit.box("Head", { 1.26, 0.06, 1.26 }, { 0, 0.20, 0 }, "Metal", steel),
+		Kit.box("Head", { 0.13, 0.14, 0.09 }, { 0.18, 0.20, -0.68 }, "Metal", steelDark),
+		-- The crest: three cloud-white segments curving up, back and a little to
+		-- the right, like a feather caught by the ridge wind.
+		Kit.box("Head", { 0.44, 0.50, 0.34 }, { 0.02, 0.78, 0.10 }, "Fabric", cloud, { 22, 0, 4 }),
+		Kit.box("Head", { 0.34, 0.52, 0.28 }, { 0.06, 1.06, 0.38 }, "Fabric", cloud, { 44, 0, 8 }),
+		Kit.box("Head", { 0.22, 0.44, 0.18 }, { 0.11, 1.26, 0.70 }, "Fabric", cloud, { 66, 0, 12 }),
+		-- A short veil at the nape, edged in a deeper blue.
+		Kit.box("Head", { 0.92, 0.42, 0.08 }, { 0, -0.46, 0.54 }, "Fabric", cloud, { -8, 0, 0 }),
+		Kit.box("Head", { 0.96, 0.08, 0.09 }, { 0, -0.66, 0.51 }, "Fabric", skyDeep, { -8, 0, 0 }),
+	},
+}
+
+return look
