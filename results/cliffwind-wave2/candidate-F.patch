+--!strict
+-- The Cliffwind hem (the Cliffwind gown): the closed tubes carried on down each
+-- shin — front, back and outer panels meeting at their corners, a chamfer
+-- cutting each front corner — with a solid knee band joining them to the
+-- dress's flounce and a solid cap closing the lower flounce's top. Each tier
+-- steps wider than the last, down to a hem far wider than the knee, so the
+-- skirt bells from hip to ankle with no leg showing between the panels.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	sky = { 124, 150, 176 },
+	cloud = { 176, 178, 174 },
+	cloudShade = { 148, 152, 154 },
+	tan = { 158, 128, 96 },
+	tanDark = { 106, 86, 66 },
+	steel = { 138, 146, 156 },
+}
+
+-- A 45-degree chamfer cutting 0.3 off the front-outer corner of a tier.
+local CHAMFER = 0.3 * math.sqrt(2)
+
+-- The knee band, solid, bridging the dress's flounce and the shin's tube.
+local KNEE_W = 1.4
+local KNEE_D = 0.9
+local KNEE_X = (KNEE_W - 1) / 2
+-- The shin's base tier, just below the knee.
+local BASE_TOP = 0.6
+local BASE_W = 1.4
+local BASE_D = 0.9
+local BASE_H = 0.7
+local BASE_Y = BASE_TOP - BASE_H / 2
+local BASE_X = (BASE_W - 1) / 2
+-- The shin's flounce, stepped wider and deeper down to the ankle.
+local FLOUNCE_TOP = 0.165
+local FLOUNCE_W = 1.9
+local FLOUNCE_D = 1.15
+local FLOUNCE_H = 0.76
+local FLOUNCE_Y = FLOUNCE_TOP - FLOUNCE_H / 2
+local FLOUNCE_X = (FLOUNCE_W - 1) / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CliffwindHem",
+	slot = "Boots",
+	parts = {
+		-- The knee band, a solid white ring closing the joint.
+		Kit.box("LowerLeg", { KNEE_W, 0.22, 2 * KNEE_D }, { KNEE_X, 0.56, 0 }, "Fabric", c.cloud),
+		-- The base tube: front, back and outer panels meeting at their corners,
+		-- a chamfer at the front corner and a blue pennant down the front.
+		Kit.box("LowerLeg", { BASE_W, BASE_H, 0.06 }, { BASE_X, BASE_Y, -BASE_D }, "Fabric", c.cloud),
+		Kit.box("LowerLeg", { BASE_W, BASE_H, 0.06 }, { BASE_X, BASE_Y, BASE_D }, "Fabric", c.cloud),
+		Kit.box("LowerLeg", { 0.06, BASE_H, 2 * BASE_D }, { BASE_W - 0.5, BASE_Y, 0 }, "Fabric", c.cloudShade),
+		Kit.box(
+			"LowerLeg",
+			{ 0.06, BASE_H, CHAMFER },
+			{ BASE_W - 0.65, BASE_Y, -BASE_D + 0.15 },
+			"Fabric",
+			c.cloudShade,
+			{ 0, 45, 0 }
+		),
+		Kit.box("LowerLeg", { 1.18, 0.64, 0.06 }, { BASE_X, BASE_Y + 0.01, -0.93 }, "Fabric", c.sky),
+		-- The flounce tube, stepped wider and deeper, its top closed by a solid
+		-- cap so no leg shows at the ledge, down to the ankle.
+		Kit.box("LowerLeg", { FLOUNCE_W, FLOUNCE_H, 0.06 }, { FLOUNCE_X, FLOUNCE_Y, -FLOUNCE_D }, "Fabric", c.cloud),
+		Kit.box("LowerLeg", { FLOUNCE_W, FLOUNCE_H, 0.06 }, { FLOUNCE_X, FLOUNCE_Y, FLOUNCE_D }, "Fabric", c.cloud),
+		Kit.box(
+			"LowerLeg",
+			{ 0.06, FLOUNCE_H, 2 * FLOUNCE_D },
+			{ FLOUNCE_W - 0.5, FLOUNCE_Y, 0 },
+			"Fabric",
+			c.cloudShade
+		),
+		Kit.box(
+			"LowerLeg",
+			{ 0.06, FLOUNCE_H, CHAMFER },
+			{ FLOUNCE_W - 0.65, FLOUNCE_Y, -FLOUNCE_D + 0.15 },
+			"Fabric",
+			c.cloudShade,
+			{ 0, 45, 0 }
+		),
+		Kit.box("LowerLeg", { FLOUNCE_W, 0.06, 2 * FLOUNCE_D }, { FLOUNCE_X, FLOUNCE_TOP, 0 }, "Fabric", c.cloud),
+		Kit.box("LowerLeg", { 1.5, 0.68, 0.06 }, { FLOUNCE_X, FLOUNCE_Y + 0.01, -1.18 }, "Fabric", c.sky),
+		-- One tan favour down the left shin, off centre, for the wind.
+		Kit.box("LowerLeg", { 0.12, 0.9, 0.05 }, { -0.2, 0.05, -1.22 }, "Fabric", c.tan, { 12, 0, 0 }, "Left"),
+		-- The soft shoe and its steel toe cap.
+		Kit.box("Foot", { 1.02, 0.42, 1.18 }, { 0, 0, -0.06 }, "Leather", c.tanDark),
+		Kit.box("Foot", { 0.84, 0.18, 0.28 }, { 0, -0.03, -0.64 }, "Metal", c.steel),
+	},
+}
+
+return look
