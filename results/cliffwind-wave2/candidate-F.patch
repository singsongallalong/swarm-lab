+--!strict
+-- The Cliffwind helm (the Cliffwind gown): a deep cloud-white hood that frames
+-- the face, a slim steel circlet with a diamond at the brow, two swept sky-blue
+-- wings above the crown, a wide scarf streaming back and out to the right, and
+-- a pale veil down the back of the neck. The wings and scarf are the set's
+-- wind; the scarf is thrown wide and thick enough to read from the ARPG camera
+-- as well as the side, and the veil lightens the dark back below.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	sky = { 124, 150, 176 },
+	skyDeep = { 88, 112, 142 },
+	cloud = { 176, 178, 174 },
+	cloudShade = { 148, 152, 154 },
+	steel = { 138, 146, 156 },
+	steelBright = { 164, 170, 178 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CliffwindHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The hood's crown, its veil down the back of the head and the two side
+		-- veils that leave only the face showing.
+		Kit.box("Head", { 1.26, 0.62, 1.26 }, { 0, 0.36, 0.02 }, "Fabric", c.cloud),
+		Kit.box("Head", { 1.22, 0.94, 0.16 }, { 0, -0.12, 0.6 }, "Fabric", c.cloudShade),
+		Kit.box("Head", { 0.08, 0.9, 0.84 }, { 0.63, -0.14, 0.12 }, "Fabric", c.cloud),
+		Kit.box("Head", { 0.08, 0.9, 0.84 }, { -0.63, -0.14, 0.12 }, "Fabric", c.cloud),
+		-- Cheek frames closing the hood to the face.
+		Kit.box("Head", { 0.28, 0.62, 0.07 }, { 0.49, -0.28, -0.62 }, "Fabric", c.cloud),
+		Kit.box("Head", { 0.28, 0.62, 0.07 }, { -0.49, -0.28, -0.62 }, "Fabric", c.cloud),
+		-- The circlet over the hood's rim, with a pale diamond at its front.
+		Kit.box("Head", { 1.32, 0.12, 1.32 }, { 0, 0.02, 0 }, "Metal", c.steelBright),
+		Kit.box("Head", { 0.2, 0.2, 0.08 }, { 0, 0.02, -0.67 }, "Metal", c.steel, { 0, 0, 45 }),
+		-- Two sky-blue wings above the crown, a darker feather inside each.
+		Kit.box("Head", { 0.12, 0.86, 0.4 }, { 0.31, 0.97, 0.14 }, "Fabric", c.sky, { 20, 0, -14 }),
+		Kit.box("Head", { 0.12, 0.86, 0.4 }, { -0.31, 0.97, 0.14 }, "Fabric", c.sky, { 20, 0, 14 }),
+		Kit.box("Head", { 0.08, 0.54, 0.28 }, { 0.17, 0.82, 0.1 }, "Fabric", c.skyDeep, { 20, 0, -8 }),
+		Kit.box("Head", { 0.08, 0.54, 0.28 }, { -0.17, 0.82, 0.1 }, "Fabric", c.skyDeep, { 20, 0, 8 }),
+		-- The scarf's knot at the nape, then four wide pennant lengths streaming
+		-- back and out to the right, rising and thickening so they read as cloth.
+		Kit.box("Head", { 0.26, 0.24, 0.14 }, { 0, -0.06, 0.74 }, "Metal", c.steelBright),
+		Kit.box("Head", { 0.6, 0.28, 0.55 }, { 0.03, -0.05, 1.02 }, "Fabric", c.sky, { 0, 10, 0 }),
+		Kit.box("Head", { 0.55, 0.26, 0.55 }, { 0.18, 0, 1.5 }, "Fabric", c.skyDeep, { 6, 22, 0 }),
+		Kit.box("Head", { 0.5, 0.24, 0.52 }, { 0.42, 0.08, 1.95 }, "Fabric", c.sky, { 12, 34, 0 }),
+		Kit.box("Head", { 0.42, 0.22, 0.46 }, { 0.72, 0.18, 2.32 }, "Fabric", c.skyDeep, { 18, 44, 0 }),
+		-- A pale veil falling from the nape down the back.
