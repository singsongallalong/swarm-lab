+--!strict
+-- The Cliffwind dress (the Cliffwind gown): a sky-blue bodice under a light
+-- steel breastplate, its back covered by a cloud-white panel, with a warm tan
+-- sash and dark tan belt at the narrowest point. The skirt's upper two tiers
+-- are closed three-walled tubes on each thigh — front, back and outer panels
+-- meeting at their corners, with a chamfer cutting the front corner and a solid
+-- cap closing the lower tier's top — so the two legs' panels join into one
+-- skirt, no leg shows between them, and each tier steps wider than the last.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	sky = { 124, 150, 176 },
+	skyDeep = { 88, 112, 142 },
+	cloud = { 176, 178, 174 },
+	cloudShade = { 148, 152, 154 },
+	tan = { 158, 128, 96 },
+	tanDark = { 106, 86, 66 },
+	steel = { 138, 146, 156 },
+	steelBright = { 164, 170, 178 },
+}
+
+-- The upper tier: from the hip down to mid-thigh. A panel of width W spans from
+-- the centre line out to W, so its frame centre is (W - 1) / 2 and the side
+-- panel sits at W - 0.5, meeting the front and back at the corner.
+local BASE_TOP = 0.75
+local BASE_W = 1.12
+local BASE_D = 0.62
+local BASE_H = 1.0
+local BASE_Y = BASE_TOP - BASE_H / 2
+local BASE_X = (BASE_W - 1) / 2
+
+-- The lower tier: the flounce, stepped out and stopping just above the knee.
+local FLOUNCE_TOP = 0.325
+local FLOUNCE_W = 1.36
+local FLOUNCE_D = 0.85
+local FLOUNCE_H = 0.9
+local FLOUNCE_Y = FLOUNCE_TOP - FLOUNCE_H / 2
+local FLOUNCE_X = (FLOUNCE_W - 1) / 2
+
+-- A 45-degree chamfer cutting 0.3 off the front-outer corner of a tier.
+local CHAMFER = 0.3 * math.sqrt(2)
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CliffwindDress",
+	slot = "Chest",
+	parts = {
+		-- The fitted sky-blue bodice, its back covered by a cloud-white panel.
+		Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", c.sky),
+		Kit.box("UpperTorso", { 1.6, 1.5, 0.06 }, { 0, 0, 0.57 }, "Fabric", c.cloud),
+		-- The breastplate, its top rim pale and a diamond point at the sternum.
+		Kit.box("UpperTorso", { 1.62, 0.74, 0.1 }, { 0, 0.28, -0.56 }, "Metal", c.steel),
+		Kit.box("UpperTorso", { 1.66, 0.08, 0.12 }, { 0, 0.63, -0.56 }, "Metal", c.steelBright),
+		Kit.box("UpperTorso", { 0.46, 0.46, 0.1 }, { 0, -0.14, -0.57 }, "Metal", c.steelBright, { 0, 0, 45 }),
+		-- A deeper sky-blue panel down the midriff, drawing the eye to the waist.
+		Kit.box("UpperTorso", { 0.56, 0.52, 0.06 }, { 0, -0.5, -0.56 }, "Fabric", c.skyDeep),
+		-- The cloud-white neckline under the chin.
+		Kit.box("UpperTorso", { 0.86, 0.13, 0.06 }, { 0, 0.72, -0.55 }, "Fabric", c.cloud),
+		-- The waist: a warm tan sash and dark tan belt with an off-centre steel
+		-- buckle, a blue stomacher, and a cloud bustle swelling at the back.
+		Kit.box("LowerTorso", { 2.08, 0.4, 1.24 }, { 0, 0, 0 }, "Fabric", c.tan),
+		Kit.box("LowerTorso", { 2.12, 0.1, 1.28 }, { 0, -0.05, 0 }, "Fabric", c.tanDark),
+		Kit.box("LowerTorso", { 0.22, 0.16, 0.1 }, { 0.42, -0.05, -0.73 }, "Metal", c.steelBright),
+		Kit.box("LowerTorso", { 0.66, 0.36, 0.06 }, { 0, 0, -0.66 }, "Fabric", c.skyDeep),
+		Kit.box("LowerTorso", { 1.3, 0.36, 0.28 }, { 0, 0, 0.62 }, "Fabric", c.cloud),
+		-- A slim sky-blue sleeve covering the whole upper arm, close to the arm.
+		Kit.box("UpperArm", { 1.04, 1.2, 1.04 }, { 0, 0, 0 }, "Fabric", c.sky),
+		-- The skirt's upper tier: a closed tube on each thigh, front and back
+		-- panels meeting at the centre, a chamfer at each front corner, and a
+		-- blue pennant down the front.
+		Kit.box("UpperLeg", { BASE_W, BASE_H, 0.06 }, { BASE_X, BASE_Y, -BASE_D }, "Fabric", c.cloud),
+		Kit.box("UpperLeg", { BASE_W, BASE_H, 0.06 }, { BASE_X, BASE_Y, BASE_D }, "Fabric", c.cloud),
+		Kit.box("UpperLeg", { 0.06, BASE_H, 2 * BASE_D }, { BASE_W - 0.5, BASE_Y, 0 }, "Fabric", c.cloudShade),
+		Kit.box(
+			"UpperLeg",
+			{ 0.06, BASE_H, CHAMFER },
+			{ BASE_W - 0.65, BASE_Y, -BASE_D + 0.15 },
+			"Fabric",
+			c.cloudShade,
+			{ 0, 45, 0 }
+		),
+		Kit.box("UpperLeg", { 1.0, 0.9, 0.06 }, { BASE_X, BASE_Y, -0.65 }, "Fabric", c.sky),
+		-- The flounce tier, stepped wider and deeper, its top closed by a solid
+		-- cap so no leg shows at the ledge, stopping above the knee.
+		Kit.box("UpperLeg", { FLOUNCE_W, FLOUNCE_H, 0.06 }, { FLOUNCE_X, FLOUNCE_Y, -FLOUNCE_D }, "Fabric", c.cloud),
+		Kit.box("UpperLeg", { FLOUNCE_W, FLOUNCE_H, 0.06 }, { FLOUNCE_X, FLOUNCE_Y, FLOUNCE_D }, "Fabric", c.cloud),
+		Kit.box(
+			"UpperLeg",
+			{ 0.06, FLOUNCE_H, 2 * FLOUNCE_D },
+			{ FLOUNCE_W - 0.5, FLOUNCE_Y, 0 },
+			"Fabric",
+			c.cloudShade
+		),
+		Kit.box(
+			"UpperLeg",
+			{ 0.06, FLOUNCE_H, CHAMFER },
+			{ FLOUNCE_W - 0.65, FLOUNCE_Y, -FLOUNCE_D + 0.15 },
+			"Fabric",
+			c.cloudShade,
+			{ 0, 45, 0 }
+		),
+		Kit.box("UpperLeg", { FLOUNCE_W, 0.06, 2 * FLOUNCE_D }, { FLOUNCE_X, FLOUNCE_TOP, 0 }, "Fabric", c.cloud),
+		Kit.box("UpperLeg", { 1.16, 0.8, 0.06 }, { FLOUNCE_X, FLOUNCE_Y, -0.88 }, "Fabric", c.sky),
+	},
+}
+
+return look
