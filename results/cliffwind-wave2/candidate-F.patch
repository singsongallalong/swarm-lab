+--!strict
+-- The Cliffwind sleeves (the Cliffwind gown): a slim sky-blue sleeve close on
+-- the forearm, running straight on from the dress's upper sleeve, and a single
+-- cloud-white bell cuff at the wrist with a pennant ribbon trailing from the
+-- right. The volume is all at the cuff, never at the shoulder; no ruffle or
+-- trim widens the arm on the way down.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	sky = { 124, 150, 176 },
+	cloud = { 176, 178, 174 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CliffwindSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The lower sleeve, slim on the whole forearm.
+		Kit.box("LowerArm", { 1.02, 1.2, 1.02 }, { 0, 0, 0 }, "Fabric", c.sky),
+		-- The one bell cuff at the wrist.
+		Kit.box("LowerArm", { 1.16, 0.4, 1.16 }, { 0, -0.36, 0 }, "Fabric", c.cloud),
+		-- One long pennant off the right cuff, trailing with the wind.
+		Kit.box("LowerArm", { 0.12, 0.7, 0.06 }, { 0.54, -0.8, 0.08 }, "Fabric", c.sky, { 0, 0, 7 }, "Right"),
+		-- The soft glove at the hand.
+		Kit.box("Hand", { 1.04, 0.4, 1.04 }, { 0, 0, 0 }, "Fabric", c.cloud),
+	},
+}
+
+return look
