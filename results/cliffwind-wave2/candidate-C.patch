+		-- Corset lacing just above the waist.
+		Kit.box("UpperTorso", { 0.42, 0.05, 0.04 }, { 0.1, -0.2, -0.55 }, "Metal", p.steel, { 0, 0, 32 }),
+		Kit.box("UpperTorso", { 0.42, 0.05, 0.04 }, { -0.1, -0.2, -0.55 }, "Metal", p.steel, { 0, 0, -32 }),
+		-- The waist: a sky sash, a dark steel band over it, and the buckle.
+		Kit.box("LowerTorso", { 2.04, 0.44, 1.04 }, { 0, 0, 0 }, "Fabric", p.sky),
