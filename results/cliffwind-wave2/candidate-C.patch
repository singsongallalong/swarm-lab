+		Kit.box("LowerArm", { 1.44, 0.06, 1.44 }, { 0, -0.56, 0 }, "Fabric", p.skyPale),
+		-- The glove.
+		Kit.box("Hand", { 1.06, 0.36, 1.06 }, { 0, 0, 0 }, "Fabric", p.white),
