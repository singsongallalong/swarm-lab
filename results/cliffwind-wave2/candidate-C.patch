+--!strict
+-- The Cliffwind crest (zone armour, the Aor'lan Cliffs' courtly gown set):
+-- a close white coif and cloth roll under a slim steel circlet, crowned by a
+-- swept steel crest between two white wings, with a soft veil down the back
+-- edged in sky blue. It caps the crown, so it reads as a headpiece rather
+-- than a bucket, and the crest rises up and back as the figure's height.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local p = {
+	white = { 190, 196, 206 },
+	sky = { 104, 140, 172 },
+	steel = { 104, 114, 128 },
+	steelBright = { 156, 166, 180 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CliffwindHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The coif over the crown, and the rolled cloth band at the brow.
+		Kit.box("Head", { 1.28, 0.48, 1.28 }, { 0, 0.37, 0 }, "Fabric", p.white),
+		-- A swept cloth top over the coif, so it peaks to the back rather than
+		-- sitting flat like a lid.
+		Kit.wedge("Head", { 1.28, 0.3, 1.28 }, { 0, 0.75, 0 }, "Fabric", p.white),
+		Kit.box("Head", { 1.34, 0.14, 1.34 }, { 0, 0.1, 0 }, "Fabric", p.white),
+		-- The steel circlet, with a sky-blue stone at the brow.
+		Kit.box("Head", { 1.36, 0.07, 1.36 }, { 0, 0.185, 0 }, "Metal", p.steel),
+		Kit.box("Head", { 0.12, 0.14, 0.07 }, { 0, 0.185, -0.705 }, "Metal", p.sky),
+		-- A steel crest spine up the front of the coif, from circlet to crest.
+		Kit.box("Head", { 0.08, 0.42, 0.06 }, { 0, 0.4, -0.66 }, "Metal", p.steel),
+		-- The swept crest: one tall steel blade with a white plume behind it,
+		-- all set back so it reads from the high camera as height, not width.
+		Kit.box("Head", { 0.16, 0.88, 0.5 }, { 0, 0.96, 0.14 }, "Metal", p.steelBright, { 18, 0, 0 }),
+		Kit.box("Head", { 0.32, 0.66, 0.3 }, { 0, 0.86, 0.36 }, "Fabric", p.white, { 28, 0, 0 }),
+		-- A folded cloth lip at the back of the coif, so the top is not a lid.
+		Kit.box("Head", { 1.3, 0.18, 0.36 }, { 0, 0.56, 0.48 }, "Fabric", p.white, { 22, 0, 0 }),
+		-- The veil down the back of the head, edged in sky blue.
+		Kit.box("Head", { 0.94, 0.62, 0.06 }, { 0, -0.27, 0.66 }, "Fabric", p.white),
+		Kit.box("Head", { 0.96, 0.07, 0.07 }, { 0, -0.57, 0.66 }, "Fabric", p.sky),
+		-- A small sky-blue bow, tied off centre on the veil.
+		Kit.box("Head", { 0.14, 0.12, 0.1 }, { 0.36, 0.1, 0.71 }, "Fabric", p.sky),
+		Kit.box("Head", { 0.09, 0.44, 0.04 }, { 0.4, -0.14, 0.7 }, "Fabric", p.sky, { 0, 0, 6 }),
+	},
+}
+
+return look
