+		Kit.box("UpperTorso", { 1.4, 0.34, 0.26 }, { 0, -0.48, 0.62 }, "Fabric", p.sky),
+		Kit.box("UpperTorso", { 0.36, 0.24, 0.1 }, { 0.24, -0.36, 0.78 }, "Fabric", p.white, { 0, 0, 18 }),
+		Kit.box("UpperTorso", { 0.36, 0.24, 0.1 }, { -0.24, -0.36, 0.78 }, "Fabric", p.white, { 0, 0, -18 }),
