+		-- The pouf: a gathered crown, a smaller knot of cloth beside it.
+		Kit.box("Head", { 1.02, 0.44, 1.0 }, { 0.1, 0.86, 0.02 }, "Fabric", rose, { 0, 8, -10 }),
+		Kit.box("Head", { 0.5, 0.34, 0.46 }, { -0.3, 0.9, -0.14 }, "Fabric", roseDeep, { 0, -14, 12 }),
+		-- The big black bow, right of centre: two loops, a knot and two short tails.
+		Kit.box("Head", { 0.24, 0.26, 0.24 }, { 0.78, 0.64, -0.02 }, "Fabric", ink, { 0, 0, -8 }),
+		Kit.box("Head", { 0.48, 0.3, 0.16 }, { 1.05, 0.74, -0.02 }, "Fabric", ink, { 0, 0, 26 }),
