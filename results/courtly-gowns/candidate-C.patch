+		Kit.box("Head", { 0.14, 0.14, 0.08 }, { -0.44, 0.62, -0.68 }, "Fabric", c.bone, { 0, 0, 20 }),
+		Kit.box("Head", { 0.3, 0.16, 0.04 }, { 0.36, 0.68, -0.66 }, "Fabric", roseDeep, { 0, -6, -12 }),
