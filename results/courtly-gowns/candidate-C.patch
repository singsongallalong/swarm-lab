+		Kit.box("Head", { 0.13, 0.34, 0.1 }, { 0.86, 0.4, 0.2 }, "Fabric", ink, { 16, 0, -18 }),
+		Kit.box("Head", { 0.12, 0.28, 0.09 }, { 0.96, 0.4, -0.18 }, "Fabric", ink, { -14, 0, 12 }),
+		-- A pale pearl pin at the cap's front, and a thumbed bald patch where the
