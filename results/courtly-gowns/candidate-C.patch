+--!strict
+-- The courtly gown (the Courtly chest): a faded rose bodice with a pale grey
+-- stomacher laced by a ladder of small black bows, a bone lace collar and a
+-- smaller bow at the throat, a big black bow at the bust, a frilled bustle at
+-- the back, puffed sleeves gathered into a dark band, and the upper skirt.
+-- The skirt is five panels round each thigh, flared hard from the hip so the
+-- hem stands well out: standing, the two legs' panels close into one bell and
+-- only part as the legs stride. It stops above the knee, where the boots' tier
+-- tucks up inside it, so no leg shows between the two.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The gown's cloth: a dusty faded rose, a deeper rose for shadow, pale dove
+-- for the stomacher, bone and lace for the trims, near-black for every bow.
+local rose = { 126, 98, 102 }
+local roseDeep = { 94, 68, 76 }
+local dove = { 148, 142, 146 }
+local lace = { 150, 140, 122 }
+local ink = { 40, 36, 44 }
+
+-- The upper skirt's drop and the radius its panels sit at mid-thigh; a 20
+-- degree outward tilt takes the hem from the hip out to a bell.
+local SKIRT = 1.2
+local SKIRT_Y = 0.12
+local SKIRT_R = 0.72
+local SKIRT_TILT = 20
+local DIAGONAL = 0.51
+local DIAGONAL_TILT = 14
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CourtlyGown",
+	slot = "Chest",
+	parts = {
+		-- The bodice, over the whole torso and cinched by a dark band at the waist.
+		Kit.box("UpperTorso", { 2.1, 1.66, 1.08 }, { 0, 0, 0 }, "Fabric", rose),
+		Kit.box("LowerTorso", { 2.04, 0.36, 1.08 }, { 0, 0.02, 0 }, "Fabric", roseDeep),
+		-- The pale stomacher down the bodice's front.
+		Kit.box("UpperTorso", { 0.66, 1.3, 0.06 }, { 0, 0.08, -0.56 }, "Fabric", dove),
+		-- A bone lace neckline and a ruffled collar standing at the throat.
+		Kit.box("UpperTorso", { 1.7, 0.12, 1.1 }, { 0, 0.74, 0 }, "Fabric", c.bone),
+		Kit.box("UpperTorso", { 1.24, 0.16, 1.24 }, { 0, 0.82, 0 }, "Fabric", c.bone),
+		Kit.box("UpperTorso", { 1.1, 0.12, 1.1 }, { 0, 0.9, 0 }, "Fabric", lace),
+		-- The small bow at the throat.
+		Kit.box("UpperTorso", { 0.22, 0.09, 0.08 }, { 0, 0.83, -0.68 }, "Fabric", ink),
+		Kit.box("UpperTorso", { 0.09, 0.12, 0.09 }, { 0, 0.83, -0.7 }, "Fabric", ink),
+		-- The big bow at the bust: two loops and a knot.
+		Kit.box("UpperTorso", { 0.52, 0.3, 0.14 }, { 0.34, 0.44, -0.62 }, "Fabric", ink, { 0, 0, 18 }),
+		Kit.box("UpperTorso", { 0.52, 0.3, 0.14 }, { -0.34, 0.44, -0.62 }, "Fabric", ink, { 0, 0, -18 }),
+		Kit.box("UpperTorso", { 0.2, 0.24, 0.18 }, { 0, 0.44, -0.64 }, "Fabric", ink),
+		-- The ladder of small bows lacing the stomacher.
+		Kit.box("UpperTorso", { 0.3, 0.09, 0.05 }, { 0, 0.18, -0.6 }, "Fabric", ink),
+		Kit.box("UpperTorso", { 0.09, 0.12, 0.07 }, { 0, 0.18, -0.61 }, "Fabric", ink),
+		Kit.box("UpperTorso", { 0.3, 0.09, 0.05 }, { 0, -0.12, -0.6 }, "Fabric", ink),
+		Kit.box("UpperTorso", { 0.09, 0.12, 0.07 }, { 0, -0.12, -0.61 }, "Fabric", ink),
+		Kit.box("UpperTorso", { 0.3, 0.09, 0.05 }, { 0, -0.42, -0.56 }, "Fabric", ink),
+		Kit.box("UpperTorso", { 0.09, 0.12, 0.07 }, { 0, -0.42, -0.58 }, "Fabric", ink),
+		-- The bustle at the back of the waist, frilled in bone.
+		Kit.box("LowerTorso", { 1.0, 0.36, 0.5 }, { 0, 0.02, 0.62 }, "Fabric", rose),
+		Kit.box("LowerTorso", { 1.06, 0.1, 0.54 }, { 0, -0.12, 0.66 }, "Fabric", c.bone),
+		-- Puffed sleeves: a gathered body, a stepped crown and a dark band.
+		Kit.box("UpperArm", { 1.28, 1.2, 1.28 }, { 0, 0, 0 }, "Fabric", rose),
+		Kit.box("UpperArm", { 1.02, 0.66, 1.02 }, { 0, 0.52, 0 }, "Fabric", rose),
+		Kit.box("UpperArm", { 1.12, 0.16, 1.12 }, { 0, -0.52, 0 }, "Fabric", roseDeep),
+		-- The upper skirt: five panels round each thigh, flared outward.
+		Kit.box("UpperLeg", { 1.02, SKIRT, 0.07 }, { 0.02, SKIRT_Y, -SKIRT_R }, "Fabric", rose, {
+			SKIRT_TILT,
+			0,
+			0,
+		}),
+		Kit.box("UpperLeg", { 0.74, SKIRT, 0.06 }, { DIAGONAL, SKIRT_Y, -DIAGONAL }, "Fabric", rose, {
+			DIAGONAL_TILT,
+			-45,
+			DIAGONAL_TILT,
+		}),
+		Kit.box("UpperLeg", { 0.06, SKIRT, 0.96 }, { SKIRT_R, SKIRT_Y, 0 }, "Fabric", rose, { 0, 0, SKIRT_TILT }),
+		Kit.box("UpperLeg", { 0.74, SKIRT, 0.06 }, { DIAGONAL, SKIRT_Y, DIAGONAL }, "Fabric", rose, {
+			-DIAGONAL_TILT,
+			-135,
+			DIAGONAL_TILT,
+		}),
+		Kit.box("UpperLeg", { 1.02, SKIRT, 0.07 }, { 0.02, SKIRT_Y, SKIRT_R }, "Fabric", rose, {
+			-SKIRT_TILT,
+			0,
+			0,
+		}),
+		-- A darned patch in plainer linen on the bodice's left, where the silk wore.
+		Kit.box("UpperTorso", { 0.28, 0.22, 0.04 }, { -0.58, 0.2, -0.56 }, "Fabric", c.linen, { 0, 0, 6 }),
+	},
+}
+
+return look
