+--!strict
+-- The harvest bride's dress (art pass A014): a wheat-gold bodice laced
+-- hearth-red and belted at the waist, with fitted wheat sleeves against the
+-- arms. The quilted field-green overskirt is drawn aside at the front to show
+-- the pale linen apron, and hangs from the thighs in wide panels that the
+-- Hem look carries on wider still, so the skirt bells from a clear waist.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local h = {
+	wheat = { 138, 114, 64 }, -- the gown's warm straw gold
+	wheatDark = { 100, 82, 46 }, -- the fitted sleeves, a shade back from the bodice
+	linen = { 150, 140, 118 }, -- the apron and collar
+	hearth = { 112, 56, 46 }, -- sash, lacing and ties
+	hearthDark = { 84, 42, 36 }, -- the sash knot
+	field = { 82, 100, 60 }, -- the quilted overskirt
+	fieldDark = { 60, 74, 46 }, -- the fold where the overskirt is drawn aside
+	walnut = { 66, 50, 38 }, -- the belt
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "HarvestbrideDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice: wheat cloth, a square linen collar, a hearth-red stomacher
+		-- cross-laced in linen down the front.
+		Kit.box("UpperTorso", { 2.06, 1.62, 1.06 }, { 0, 0, 0 }, "Fabric", h.wheat),
+		Kit.box("UpperTorso", { 1.16, 0.2, 1.04 }, { 0, 0.76, 0 }, "Fabric", h.linen),
+		Kit.box("UpperTorso", { 0.52, 1, 0.06 }, { 0, 0.02, -0.56 }, "Fabric", h.hearth),
+		Kit.box("UpperTorso", { 0.08, 0.72, 0.05 }, { 0, 0.04, -0.6 }, "Fabric", h.linen, { 0, 0, 26 }),
+		Kit.box("UpperTorso", { 0.08, 0.72, 0.05 }, { 0, 0.04, -0.6 }, "Fabric", h.linen, { 0, 0, -26 }),
+		-- Fitted wheat sleeves kept close to the upper arm; the linen bell (the
+		-- Gloves look) carries the volume at the forearm.
+		Kit.box("UpperArm", { 1.04, 1.22, 1.04 }, { 0, 0, 0 }, "Fabric", h.wheatDark),
+		-- The waist: a hearth-red sash under a walnut belt, tied in a bow at the
+		-- back whose tails fall down the skirt behind.
+		Kit.box("LowerTorso", { 2.14, 0.24, 1.14 }, { 0, 0.07, 0 }, "Fabric", h.hearth),
+		Kit.box("LowerTorso", { 2.18, 0.1, 1.18 }, { 0, -0.09, 0 }, "Leather", h.walnut),
+		Kit.box("LowerTorso", { 0.18, 0.18, 0.12 }, { 0, 0.06, 0.6 }, "Fabric", h.hearthDark),
+		Kit.box("LowerTorso", { 0.34, 0.24, 0.09 }, { 0.22, 0.1, 0.62 }, "Fabric", h.hearth, { 0, 0, 18 }),
+		Kit.box("LowerTorso", { 0.34, 0.24, 0.09 }, { -0.22, 0.1, 0.62 }, "Fabric", h.hearth, { 0, 0, -18 }),
+		-- The skirt: a pale linen apron down the front centre with the green
+		-- overskirt drawn aside either side of it and falling round the back,
+		-- gathered into a fold and tied with hearth-red ribbon at the right hip.
+		Kit.box("UpperLeg", { 1, 1.2, 0.09 }, { 0, 0.06, -0.57 }, "Fabric", h.linen, { 5, 0, 0 }),
+		Kit.box("UpperLeg", { 0.9, 1.2, 0.09 }, { 0.95, 0.06, -0.57 }, "Fabric", h.field, { 5, 0, 0 }),
+		Kit.box("UpperLeg", { 1.9, 1.15, 0.1 }, { 0.45, 0.02, 0.64 }, "Fabric", h.field, { -6, 0, 0 }),
+		Kit.box("UpperLeg", { 0.11, 1.12, 1.2 }, { 1.4, 0.04, 0.02 }, "Fabric", h.field, { 0, 0, 8 }),
+		Kit.box("UpperLeg", { 0.3, 0.95, 0.07 }, { 0.56, 0.12, -0.66 }, "Fabric", h.fieldDark, { 5, 0, 0 }),
+		Kit.box("UpperLeg", { 0.14, 0.2, 0.12 }, { 0.58, 0.5, -0.68 }, "Fabric", h.hearth),
+		Kit.box("UpperLeg", { 0.1, 0.36, 0.05 }, { 0.6, 0.3, -0.68 }, "Fabric", h.hearth, { 0, 0, -6 }),
+		-- The sash bow's tails, fallen down the back of the green skirt.
+		Kit.box("UpperLeg", { 0.12, 0.7, 0.06 }, { 0.24, 0.25, 0.74 }, "Fabric", h.hearth, { -6, 0, 0 }),
