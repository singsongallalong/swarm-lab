+--!strict
+-- The Moonwell glade as a drowned causeway (swarm-lab's maps job). A sacred isle
+-- of standing stones stands at the heart of a black mere; the old paved way comes
+-- in from a wooded landing in the south-west and crosses the open water on a
+-- narrow causeway, bead by bead: a drowned ruin, the order's fenced graveyard,
+-- the well's isle, a grove of black trees, a second ruin, and a rocky landing in
+-- the north-east. Most of the map is water, broken only by half-drowned rocks.
+-- Flat, seeded, and made afresh every run.
+local DistanceField = require("../DistanceField")
+local DraftedMap = require("../DraftedMap")
+local Grid = require("../Grid")
+local Heath = require("../Heath")
+local Noise = require("../Noise")
+local TerrainTypes = require("../../TerrainTypes")
+
+type EdgeKind = TerrainTypes.EdgeKind
+type SiteKind = TerrainTypes.SiteKind
+type CellKind = "void" | "heath" | "road" | "outcrop" | "rim" | "bluff"
+type Point = { x: number, z: number }
+
+-- One island of the chain: a wobbled ellipse of walkable ground.
+type Isle = {
+	label: string,
+	x: number,
+	z: number,
+	rx: number,
+	rz: number,
+	phase: number, -- offsets the noise so two seeds carve different blobs
+	frequency: number,
+	wobble: number,
+	edge: EdgeKind?, -- the rim kind round this isle; nil is a drowned drop
+}
+
+type Isles = {
+	start: Isle,
+	ruinA: Isle,
+	graveyard: Isle,
+	well: Isle,
+	glade: Isle,
+	grove: Isle,
+	ruinB: Isle,
+	exit: Isle,
+	all: { Isle },
+}
+
+-- The grid: a wide mere with room for the causeway and its isles.
+local WIDTH = 160
+local DEPTH = 128
+-- Cells kept clear of the map's edge, so the outer ring is always wall.
+local INSET = 2
+-- Cells either side of the road's centreline that are paved.
+local ROAD_HALF = 1.7
+-- Half-width of a causeway before its wobble: narrow enough to be a causeway.
+local CAUSEWAY_HALF = 2.9
+local CAUSEWAY_WOBBLE = 0.5
+-- Centreline samples per cell of causeway.
+local SAMPLE_STEP = 0.5
+-- Deep water keeps this many cells from any walkable ground for an outcrop.
+local OUTCROP_GAP = 7
+-- Search radius, in cells, a site may stray from its isle's middle.
+local SITE_REACH = 5
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + rng:NextNumber() * (hi - lo)
+end
+
+local function distance(a: Point, b: Point): number
+	local dx, dz = b.x - a.x, b.z - a.z
+	return math.sqrt(dx * dx + dz * dz)
+end
+
+-- A polyline through `controls`, straight from one to the next and sampled every
+-- SAMPLE_STEP cells, then rounded at the bends by two passes of corner cutting
+-- and sampled evenly again: a causeway runs straight and turns in a sweep.
+local function lineThrough(controls: { Point }): { Point }
+	local dense: { Point } = {}
+	for i = 1, #controls - 1 do
+		local a, b = controls[i], controls[i + 1]
+		local steps = math.max(1, math.ceil(distance(a, b) / SAMPLE_STEP))
+		for s = 0, steps - 1 do
+			local t = s / steps
+			table.insert(dense, { x = a.x + (b.x - a.x) * t, z = a.z + (b.z - a.z) * t })
+		end
+	end
+	local last = controls[#controls]
+	table.insert(dense, { x = last.x, z = last.z })
+	if #dense < 3 then
+		return dense
+	end
+	for _ = 1, 2 do
+		local cut: { Point } = { dense[1] }
+		for i = 1, #dense - 1 do
+			local a, b = dense[i], dense[i + 1]
+			table.insert(cut, { x = a.x * 0.75 + b.x * 0.25, z = a.z * 0.75 + b.z * 0.25 })
+			table.insert(cut, { x = a.x * 0.25 + b.x * 0.75, z = a.z * 0.25 + b.z * 0.75 })
+		end
+		table.insert(cut, dense[#dense])
+		dense = cut
+	end
+	local out: { Point } = { dense[1] }
+	for i = 1, #dense - 1 do
+		local a, b = dense[i], dense[i + 1]
+		local steps = math.max(1, math.ceil(distance(a, b) / SAMPLE_STEP))
+		for s = 1, steps do
+			local t = s / steps
+			table.insert(out, { x = a.x + (b.x - a.x) * t, z = a.z + (b.z - a.z) * t })
+		end
+	end
+	return out
+end
+
+-- Marks a disc of cells as `kind`, never touching the map's border.
+local function stampDisc(kinds: { CellKind }, x: number, z: number, radius: number, kind: CellKind)
+	local r = math.ceil(radius)
+	local x0 = math.max(INSET + 1, math.floor(x) - r)
+	local x1 = math.min(WIDTH - INSET, math.floor(x) + r)
+	local z0 = math.max(INSET + 1, math.floor(z) - r)
+	local z1 = math.min(DEPTH - INSET, math.floor(z) + r)
+	local r2 = radius * radius
+	for cz = z0, z1 do
+		local row = (cz - 1) * WIDTH
+		for cx = x0, x1 do
+			local dx, dz = cx - x, cz - z
+			if dx * dx + dz * dz <= r2 then
+				kinds[row + cx] = kind
+			end
+		end
+	end
+end
+
+-- A wobbled ellipse: the noise swings the shore in and out round the isle, so
+-- no two seeds carve the same coastline.
+local function stampIsle(kinds: { CellKind }, field: Noise.Field, isle: Isle)
+	local reach = 1 + isle.wobble
+	local x0 = math.max(INSET + 1, math.floor(isle.x - isle.rx * reach) - 1)
+	local x1 = math.min(WIDTH - INSET, math.ceil(isle.x + isle.rx * reach) + 1)
+	local z0 = math.max(INSET + 1, math.floor(isle.z - isle.rz * reach) - 1)
+	local z1 = math.min(DEPTH - INSET, math.ceil(isle.z + isle.rz * reach) + 1)
+	for cz = z0, z1 do
+		local row = (cz - 1) * WIDTH
+		local nz = (cz - isle.z) / isle.rz
+		for cx = x0, x1 do
+			local nx = (cx - isle.x) / isle.rx
+			local shore = 1
+				+ Noise.sample(field, cx * isle.frequency + isle.phase, cz * isle.frequency + isle.phase)
+					* isle.wobble
+			if nx * nx + nz * nz <= shore * shore then
+				kinds[row + cx] = "heath"
+			end
+		end
+	end
+end
+
+-- A causeway: a wobbled ribbon of heath along a sampled path.
+local function stampCauseway(kinds: { CellKind }, field: Noise.Field, path: { Point }, phase: number)
+	for i, p in path do
+		local along = i * SAMPLE_STEP
+		local radius = CAUSEWAY_HALF + Noise.sample(field, along * 0.09 + phase, phase) * CAUSEWAY_WOBBLE
+		stampDisc(kinds, p.x, p.z, radius, "heath")
+	end
+end
+
+local function makeIsle(rng: Random, label: string, x: number, z: number, rx: number, rz: number, edge: EdgeKind?): Isle
+	return {
+		label = label,
+		x = x,
+		z = z,
+		rx = rx,
+		rz = rz,
+		phase = between(rng, 0, 100),
+		frequency = between(rng, 0.1, 0.14),
+		wobble = between(rng, 0.13, 0.2),
+		edge = edge,
+	}
+end
+
+-- The chain, south-west to north-east: landings, drowned ruins, the graveyard,
+-- the well's isle and a grove, with open water either side of it all.
+local function buildIsles(rng: Random): Isles
+	local function at(base: number, jitter: number): number
+		return base + between(rng, -jitter, jitter)
+	end
+	local function isle(label: string, x: number, z: number, rx: number, rz: number, edge: EdgeKind?): Isle
+		return makeIsle(rng, label, x, z, rx, rz, edge)
+	end
+	local start =
+		isle("start", at(16, 1.5), at(114, 2), 7.5 + between(rng, 0, 0.8), 6.8 + between(rng, 0, 0.8), "thicket")
+	local ruinA = isle("ruinA", at(42, 2), at(104, 2), 10.5 + between(rng, 0, 1), 10 + between(rng, 0, 1), nil)
+	local graveyard =
+		isle("graveyard", at(66, 2), at(90, 2), 11.5 + between(rng, 0, 1), 10.5 + between(rng, 0, 1), "ruin_wall")
+	local well = isle("well", at(88, 2), at(62, 2.5), 17 + between(rng, 0, 1), 15.5 + between(rng, 0, 1), nil)
+	-- A green opening south-east of the well's isle: open heath for the dressing's
+	-- own lesser ring (the well's look places one), and room to fight off the way.
+	local glade = isle("glade", at(112, 2), at(92, 2), 11 + between(rng, 0, 1), 10 + between(rng, 0, 1), "thicket")
+	local grove = isle("grove", at(114, 2), at(46, 2), 9 + between(rng, 0, 1), 8 + between(rng, 0, 1), "thicket")
+	local ruinB = isle("ruinB", at(134, 2), at(36, 2), 10 + between(rng, 0, 1), 8.5 + between(rng, 0, 1), "cliff")
+	local exit = isle("exit", at(147, 1), at(18, 2), 7 + between(rng, 0, 0.8), 6.5 + between(rng, 0, 0.8), "cliff")
+	return {
+		start = start,
+		ruinA = ruinA,
+		graveyard = graveyard,
+		well = well,
+		glade = glade,
+		grove = grove,
+		ruinB = ruinB,
+		exit = exit,
+		all = { start, ruinA, graveyard, well, glade, grove, ruinB, exit },
+	}
+end
+
+-- The old paved way: landing to landing, through every bead of the chain, and
+-- round the north side of the well's isle so the ring keeps its open plaza.
+local function mainControls(rng: Random, isles: Isles): { Point }
+	local w = isles.well
+	local function jig(amount: number, x: number, z: number): Point
+		return { x = x + between(rng, -amount, amount), z = z + between(rng, -amount, amount) }
+	end
+	return {
+		{ x = isles.start.x, z = isles.start.z },
+		jig(1.5, isles.ruinA.x, isles.ruinA.z + 6),
+		jig(1.5, isles.graveyard.x, isles.graveyard.z + 6),
+		jig(1, w.x - w.rx - 5, w.z + 13),
+		jig(0.75, w.x - w.rx + 3, w.z + 7),
+		jig(0.75, w.x - w.rx * 0.55, w.z - 3),
+		jig(0.75, w.x, w.z - 12),
+		jig(0.75, w.x + w.rx * 0.6, w.z - 10),
+		jig(0.75, w.x + w.rx - 1, w.z + 2),
+		jig(1, w.x + w.rx + 5, w.z + 8),
+		jig(1.5, isles.grove.x, isles.grove.z + 4),
+		jig(1.5, isles.ruinB.x, isles.ruinB.z + 6),
+		{ x = isles.exit.x, z = isles.exit.z },
+	}
+end
+
+-- A heath spur off the well's isle to the glade: the glade is reached on foot,
+-- with no paved way laid over it.
+local function buildSpurs(isles: Isles): { { Point } }
+	local w = isles.well
+	local g = isles.glade
+	return {
+		{
+			{ x = w.x + w.rx * 0.35, z = w.z + w.rz * 0.65 },
+			{ x = w.x + w.rx * 0.9, z = w.z + w.rz * 1.15 },
+			{ x = g.x - g.rx * 0.2, z = g.z - g.rz * 0.5 },
+		},
+	}
+end
+
+-- Whether every cell of the rectangle grown by `pad` is open heath nothing has
+-- claimed yet: a site keeps clear of the road, the shore and the other sites.
+local function siteFits(
+	map: Heath.Map,
+	claimed: { [number]: boolean },
+	x0: number,
+	z0: number,
+	x1: number,
+	z1: number,
+	pad: number
+): boolean
+	for z = z0 - pad, z1 + pad do
+		for x = x0 - pad, x1 + pad do
+			if not Grid.inBounds(map.grid, x, z) then
+				return false
+			end
+			local i = Grid.index(map.grid, x, z)
+			if map.kinds[i] ~= "heath" or claimed[i] then
+				return false
+			end
+		end
+	end
+	return true
+end
+
+-- The nearest spot to the isle's middle where a site of one of `sizes` stands
+-- whole, trying the sizes from a seed-picked start so two seeds differ.
+local function placeSite(
+	map: Heath.Map,
+	claimed: { [number]: boolean },
+	isle: Isle,
+	kind: SiteKind,
+	sizes: { { number } },
+	rng: Random
+): Heath.Site?
+	local cx, cz = math.floor(isle.x + 0.5), math.floor(isle.z + 0.5)
+	local first = math.floor(rng:NextNumber() * #sizes) + 1
+	for k = 0, #sizes - 1 do
+		local size = sizes[(first + k - 1) % #sizes + 1]
+		local w, d = size[1], size[2]
+		for pad = 2, 0, -1 do
+			local bestX, bestZ, bestScore = nil, nil, math.huge
+			for dz = -SITE_REACH, SITE_REACH do
+				for dx = -SITE_REACH, SITE_REACH do
+					local x0 = cx + dx - math.floor(w / 2)
+					local z0 = cz + dz - math.floor(d / 2)
+					if siteFits(map, claimed, x0, z0, x0 + w - 1, z0 + d - 1, pad) then
+						local score = dx * dx + dz * dz
+						if score < bestScore then
+							bestX, bestZ, bestScore = x0, z0, score
+						end
+					end
+				end
+			end
+			if bestX and bestZ then
+				for z = bestZ, bestZ + d - 1 do
+					for x = bestX, bestX + w - 1 do
+						claimed[Grid.index(map.grid, x, z)] = true
+					end
+				end
+				return { kind = kind, x0 = bestX, z0 = bestZ, x1 = bestX + w - 1, z1 = bestZ + d - 1 }
+			end
+		end
+	end
+	return nil
+end
+
+-- Whether a disc of `radius + gap` round (x, z) holds no walkable ground.
+local function clearOfFloor(map: Heath.Map, x: number, z: number, radius: number): boolean
+	local reach = radius + OUTCROP_GAP
+	local r = math.ceil(reach)
+	for cz = math.floor(z) - r, math.floor(z) + r do
+		for cx = math.floor(x) - r, math.floor(x) + r do
+			if Grid.inBounds(map.grid, cx, cz) then
+				local dx, dz = cx - x, cz - z
+				if dx * dx + dz * dz <= reach * reach then
+					local kind = map.kinds[Grid.index(map.grid, cx, cz)]
+					if kind == "heath" or kind == "road" then
+						return false
+					end
+				end
+			end
+		end
+	end
+	return true
+end
+
+-- Half-drowned rock stacks breaking the open water, well off every shore so
+-- nothing walkable is pinched by them.
+local function placeOutcrops(map: Heath.Map, rng: Random)
+	local centres: { Point } = {}
+	for _ = 1, 48 do
+		if #centres >= 7 then
+			break
+		end
+		local x = between(rng, INSET + 8, WIDTH - INSET - 8)
+		local z = between(rng, INSET + 8, DEPTH - INSET - 8)
+		local radius = between(rng, 1.2, 2.6)
+		local spaced = true
+		for _, c in centres do
+			if (c.x - x) ^ 2 + (c.z - z) ^ 2 < 100 then
+				spaced = false
+				break
+			end
+		end
+		if spaced and clearOfFloor(map, x, z, radius) then
+			local r = math.ceil(radius)
+			for cz = math.floor(z) - r, math.floor(z) + r do
+				for cx = math.floor(x) - r, math.floor(x) + r do
+					local dx, dz = cx - x, cz - z
+					if dx * dx + dz * dz <= radius * radius and Grid.inBounds(map.grid, cx, cz) then
+						map.kinds[Grid.index(map.grid, cx, cz)] = "outcrop"
+					end
+				end
+			end
+			table.insert(centres, { x = x, z = z })
+		end
+	end
+end
+
+-- The well stands on the open heath of its isle, as far from the paved way and
+-- the shore as the isle allows: the ring needs room round it to read.
+local function findWell(map: Heath.Map, isle: Isle): Point
+	local sources: { Grid.CellCoord } = {}
+	for i, kind in map.kinds do
+		if kind == "road" then
+			local x, z = Grid.coords(map.grid, i)
+			table.insert(sources, { x = x, z = z })
+		end
+	end
+	local toRoad = DistanceField.fromCells(map.grid, sources)
+	local toWall = DistanceField.fromWalls(map.grid)
+	local reach = 1 + isle.wobble
+	local best = { x = isle.x, z = isle.z }
+	local bestScore = -math.huge
+	for i, kind in map.kinds do
+		if kind == "heath" then
+			local x, z = Grid.coords(map.grid, i)
+			local nx = (x - isle.x) / (isle.rx * reach)
+			local nz = (z - isle.z) / (isle.rz * reach)
+			if nx * nx + nz * nz <= 0.81 then
+				local score = math.min(DistanceField.at(toRoad, x, z), DistanceField.at(toWall, x, z))
+				if score > bestScore then
+					bestScore, best = score, { x = x, z = z }
+				end
+			end
+		end
+	end
+	return best
+end
+
+-- Where the paved way crosses the well's isle: a sample a few cells out on the
+-- causeway, and the way's heading there, for the ruined arch that frames it.
+local function findEntry(route: { Point }, isle: Isle): { point: Point, yaw: number }?
+	local reach = 1 + isle.wobble
+	local index: number? = nil
+	for i, p in route do
+		local nx = (p.x - isle.x) / (isle.rx * reach)
+		local nz = (p.z - isle.z) / (isle.rz * reach)
+		if nx * nx + nz * nz <= 0.9 then
+			index = i
+			break
+		end
+	end
+	if not index then
+		return nil
+	end
+	local at = math.max(1, index - 6)
+	local a = route[math.max(1, at - 1)]
+	local b = route[math.min(#route, at + 1)]
+	local dx, dz = b.x - a.x, b.z - a.z
+	local length = math.sqrt(dx * dx + dz * dz)
+	if length < 1e-6 then
+		return nil
+	end
+	return { point = route[at], yaw = math.deg(math.atan2(dx, dz)) }
+end
+
+local function generate(rng: Random): Heath.Map
+	local field = Noise.field(rng)
+	local isles = buildIsles(rng)
+	local route = lineThrough(mainControls(rng, isles))
+	local kinds: { CellKind } = table.create(WIDTH * DEPTH, "void" :: CellKind)
+	local grid = Grid.new(WIDTH, DEPTH, Grid.WALL)
+
+	-- The causeways first as bare heath; the paved way is laid over them after.
+	stampCauseway(kinds, field, route, between(rng, 0, 100))
+	for _, spur in buildSpurs(isles) do
+		stampCauseway(kinds, field, lineThrough(spur), between(rng, 0, 100))
+	end
+	for _, isle in isles.all do
+		stampIsle(kinds, field, isle)
+	end
+	for _, p in route do
+		stampDisc(kinds, p.x, p.z, ROAD_HALF, "road")
+	end
+
+	local map: Heath.Map = {
+		grid = grid,
+		kinds = kinds,
+		edges = {},
+		road = route,
+		start = { x = 0, z = 0 },
+		exit = { x = 0, z = 0 },
+		sites = {},
+		heights = table.create(WIDTH * DEPTH, 0),
+		terraces = {},
+	}
+
+	for i, kind in kinds do
+		if kind == "heath" or kind == "road" then
+			grid.cells[i] = Grid.FLOOR
+		end
+	end
+	-- A causeway that strays into a pocket only it reached is no longer part of
+	-- the glade: the drowned ground takes it back.
+	Grid.keepLargestRegion(grid)
+	for i, kind in kinds do
+		if (kind == "heath" or kind == "road") and grid.cells[i] == Grid.WALL then
+			kinds[i] = "void"
+		end
+	end
+
+	local claimed: { [number]: boolean } = {}
+	local hosts: { { isle: Isle, kind: SiteKind, sizes: { { number } } } } = {
+		{ isle = isles.graveyard, kind = "graveyard", sizes = { { 8, 8 }, { 6, 6 }, { 6, 4 } } },
+		{ isle = isles.ruinA, kind = "ruin", sizes = { { 6, 6 }, { 6, 4 }, { 4, 4 } } },
+		{ isle = isles.ruinB, kind = "ruin", sizes = { { 6, 4 }, { 4, 4 } } },
+		{ isle = isles.grove, kind = "ruin", sizes = { { 4, 4 } } },
+	}
+	for _, host in hosts do
+		local site = placeSite(map, claimed, host.isle, host.kind, host.sizes, rng)
+		if site then
+			table.insert(map.sites, site)
+		end
+	end
+
+	placeOutcrops(map, rng)
+
+	-- The drowned ground round every shore is rim; what kind of edge it falls
+	-- away by is the isle's own (drop unless the isle names one).
+	for i, kind in kinds do
+		if kind == "void" then
+			local x, z = Grid.coords(grid, i)
+			for _, d in Grid.NEIGHBOURS do
+				if Grid.get(grid, x + d[1], z + d[2]) == Grid.FLOOR then
+					kinds[i] = "rim"
+					break
+				end
+			end
+		end
+	end
+	for i, kind in kinds do
+		if kind == "rim" then
+			local x, z = Grid.coords(grid, i)
+			local best: EdgeKind? = nil
+			local bestDistance = math.huge
+			for _, isle in isles.all do
+				if isle.edge then
+					local nx = (x - isle.x) / (isle.rx * (1 + isle.wobble))
+					local nz = (z - isle.z) / (isle.rz * (1 + isle.wobble))
+					local d = math.sqrt(nx * nx + nz * nz)
+					if d < bestDistance then
+						bestDistance, best = d, isle.edge
+					end
+				end
+			end
+			map.edges[i] = if best and bestDistance <= 1.35 then best else "drop"
+		end
+	end
+
+	local entry = findEntry(route, isles.well)
+	local first, last = route[1], route[#route]
+	map.start = { x = math.floor(first.x + 0.5), z = math.floor(first.z + 0.5) }
+	map.exit = { x = math.floor(last.x + 0.5), z = math.floor(last.z + 0.5) }
+	-- What the landmarks callback needs, carried on the map it was made from.
+	(map :: any).glade = {
+		well = findWell(map, isles.well),
+		entry = if entry then entry.point else nil,
+		entryYaw = if entry then entry.yaw else 0,
+	}
+	return map
+end
+
+-- The well itself: the sacred ring, and the still black pool held inside it.
+local function landmarks(map: Heath.Map, rng: Random): { DraftedMap.Landmark }
+	local glade = (map :: any).glade :: { well: Point, entry: Point?, entryYaw: number }?
+	if not glade then
+		return {}
+	end
+	local marks: { DraftedMap.Landmark } = {
+		{
+			sculpt = "moonwell_sacred_ring",
+			x = glade.well.x,
+			z = glade.well.z,
+			yaw = between(rng, 0, 360),
+			scale = 2.1,
+			sink = 0.6,
+		},
+		{
+			sculpt = "moonwell_pool",
+			x = glade.well.x,
+			z = glade.well.z,
+			yaw = 0,
+			scale = 1.75,
+			sink = 0.05,
+		},
+	}
+	if glade.entry then
+		table.insert(marks, {
+			sculpt = "moonwell_arch",
+			x = glade.entry.x,
+			z = glade.entry.z,
+			yaw = glade.entryYaw,
+			scale = 1.1,
+			sink = 0.2,
+		})
+	end
+	return marks
+end
+
+local GladeCauseway: DraftedMap.Draft = {
+	name = "GladeCauseway",
+	about = "A sacred isle of standing stones in a black mere, the old paved way crossing the drowned glade on narrow causeways from landing to landing.",
+	tileset = "moonwell",
+	generate = generate,
+	landmarks = landmarks,
+}
+
+return GladeCauseway
