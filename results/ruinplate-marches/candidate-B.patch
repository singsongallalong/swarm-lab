+--!strict
+-- The ruinplate hem (the Ruinplate gown's boots): the skirt carried on down
+-- the shins in two stepped tiers of pale stone plate, the last tier flaring
+-- wider than the knee, over a moss-green petticoat edge, with moss on both
+-- ledges and across the lowest band, and bronze-banded stone sabatons below.
+-- The back plates are the paler stone, and each tier's plates are shallow and
+-- set to the outside of the shin, so the two legs' plates meet at the centre
+-- standing and part as they stride.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+type ArmourPart = ArmourLookTypes.ArmourPart
+
+local stone = { 156, 152, 140 }
+local stoneLit = { 184, 180, 166 }
+local stoneShade = { 116, 114, 106 }
+local bronze = { 128, 100, 60 }
+local moss = { 92, 108, 70 }
+local mossDeep = { 64, 78, 52 }
+
+-- One tier of the plated skirt on a shin: a front plate, a back plate and an
+-- outer side plate. The back plate is the paler stone, so the skirt still
+-- reads pale from behind in the high camera's shadow. Each inner edge sits on
+-- the shin's inner face, so the two legs' plates meet at the centre standing
+-- and part as they stride.
+local function skirtTier(width: number, height: number, top: number, z: number): { ArmourPart }
+	local y = top - height / 2
+	local a = width / 2 - 0.5
+	local side = width - 0.53
+	return {
+		Kit.box("LowerLeg", { width, height, 0.12 }, { a, y, -z }, "Metal", stone),
+		Kit.box("LowerLeg", { width, height, 0.12 }, { a, y, z }, "Metal", stoneLit),
+		Kit.box("LowerLeg", { 0.1, height, z * 2 + 0.02 }, { side, y, 0 }, "Metal", stone),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "RuinplateHem",
+	slot = "Boots",
+	parts = Kit.join({
+		-- The knee tier, then the hem tier, flaring wider than the last.
+		skirtTier(1.6, 0.74, 0.78, 0.6),
+		skirtTier(2.16, 0.6, 0.08, 0.66),
+		{
+			-- Moss on both ledges, and a bronze line under the hem's ledge.
+			Kit.box("LowerLeg", { 1.6, 0.04, 1.22 }, { 0.3, 0.8, 0 }, "Fabric", moss),
+			Kit.box("LowerLeg", { 2.16, 0.04, 1.34 }, { 0.58, 0.1, 0 }, "Fabric", moss),
+			Kit.box("LowerLeg", { 2.16, 0.06, 0.06 }, { 0.58, 0.02, -0.73 }, "Metal", bronze),
+			Kit.box("LowerLeg", { 2.16, 0.06, 0.06 }, { 0.58, 0.02, 0.73 }, "Metal", bronze),
+			-- Moss swallowed the lowest band of the front and back plates.
+			Kit.box("LowerLeg", { 2.16, 0.22, 0.06 }, { 0.58, -0.4, -0.74 }, "Fabric", moss),
+			Kit.box("LowerLeg", { 2.16, 0.22, 0.06 }, { 0.58, -0.4, 0.74 }, "Fabric", moss),
+			-- Asymmetric creep: the right hem's outside, the left hem's front.
+			Kit.box("LowerLeg", { 0.14, 0.44, 0.3 }, { 1.66, -0.18, -0.3 }, "Fabric", moss, nil, "Right"),
+			Kit.box("LowerLeg", { 0.24, 0.3, 0.06 }, { 1.15, 0.0, -0.74 }, "Fabric", mossDeep, nil, "Left"),
+			-- The moss-green petticoat edge below the plates, and the sabaton.
+			Kit.box("LowerLeg", { 1.8, 0.14, 1.24 }, { 0.4, -0.57, 0 }, "Fabric", mossDeep),
+			Kit.box("Foot", { 1.06, 0.34, 1.2 }, { 0, 0.02, -0.06 }, "Metal", stoneShade),
+			Kit.box("Foot", { 1.08, 0.16, 0.22 }, { 0, 0.04, -0.55 }, "Metal", bronze),
+		},
+	}),
+}
+
+return look
