+		Kit.box("Head", { 0.22, 0.6, 0.2 }, { 0, 1.03, -0.34 }, "Metal", stoneLit),
+		Kit.box("Head", { 0.18, 0.52, 0.18 }, { 0.36, 0.99, -0.14 }, "Metal", stoneLit, { 0, 0, -7 }),
+		Kit.box("Head", { 0.18, 0.52, 0.18 }, { -0.36, 0.99, -0.14 }, "Metal", stoneLit, { 0, 0, 7 }),
+		Kit.box("Head", { 0.17, 0.46, 0.17 }, { 0.27, 0.97, 0.32 }, "Metal", stoneLit, { 0, 0, -6 }),
+		Kit.box("Head", { 0.17, 0.46, 0.17 }, { -0.27, 0.97, 0.32 }, "Metal", stoneLit, { 0, 0, 6 }),
+		-- A bronze tip on the tallest point.
+		Kit.box("Head", { 0.18, 0.12, 0.21 }, { 0, 1.28, -0.34 }, "Metal", bronzeLit),
+		-- The slim bronze nasal, and a bronze frame round the face opening.
+		Kit.box("Head", { 0.12, 0.5, 0.08 }, { 0, -0.26, -0.65 }, "Metal", bronze),
+		Kit.box("Head", { 0.12, 0.5, 0.12 }, { 0.46, -0.25, -0.63 }, "Metal", bronze),
+		Kit.box("Head", { 0.12, 0.5, 0.12 }, { -0.46, -0.25, -0.63 }, "Metal", bronze),
+		Kit.box("Head", { 0.8, 0.1, 0.12 }, { 0, -0.52, -0.63 }, "Metal", bronze),
+		-- The moss-green wimple over the sides and back of the head.
+		Kit.box("Head", { 1.2, 0.66, 0.12 }, { 0, -0.3, 0.63 }, "Fabric", mossDeep),
+		Kit.box("Head", { 0.16, 0.6, 0.82 }, { 0.58, -0.3, 0.2 }, "Fabric", mossDeep),
+		Kit.box("Head", { 0.16, 0.6, 0.82 }, { -0.58, -0.3, 0.2 }, "Fabric", mossDeep),
+		-- Moss crept over the bowl's top and down its back above the wimple.
+		Kit.box("Head", { 0.3, 0.05, 0.24 }, { -0.42, 0.63, 0.3 }, "Fabric", moss, { 0, 0, 8 }),
+		Kit.box("Head", { 0.18, 0.34, 0.05 }, { -0.42, 0.32, 0.655 }, "Fabric", mossDeep),
