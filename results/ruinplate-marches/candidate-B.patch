@@ -0,0 +1,76 @@
+--!strict
+-- The ruinplate dress (the Ruinplate gown's chest): a fitted pale ruin-stone
+-- cuirass with a bronze chevron and a laced back, pale stone sleeves close on
+-- the arm, a moss-green sash cinched by a bronze belt and diamond buckle, a
+-- small bow at the back, and the upper plates of the skirt hung from the
+-- thighs. The skirt starts close to the hip and steps wider down the leg, so
+-- from the high camera the figure reads as a narrow top over a full bell; the
+-- back plates are a paler stone so the dress reads pale from behind too.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+type ArmourPart = ArmourLookTypes.ArmourPart
+
+local stone = { 156, 152, 140 }
+local stoneLit = { 184, 180, 166 }
+local bronze = { 128, 100, 60 }
+local bronzeLit = { 164, 132, 84 }
+local moss = { 92, 108, 70 }
+local mossDeep = { 64, 78, 52 }
+
+-- One tier of the plated skirt on a leg: a front plate, a back plate and an
+-- outer side plate, all shallow so the skirt reads as a bell and not a box.
+-- The back plate is the paler stone, so the skirt still reads pale from behind
+-- in the high camera's shadow. Each inner edge sits on the leg's inner face,
+-- so the two legs' plates meet at the centre standing and part as they stride.
+local function skirtTier(width: number, height: number, top: number, z: number): { ArmourPart }
+	local y = top - height / 2
+	local a = width / 2 - 0.5
+	local side = width - 0.53
+	return {
+		Kit.box("UpperLeg", { width, height, 0.1 }, { a, y, -z }, "Metal", stone, { 4, 0, 0 }),
+		Kit.box("UpperLeg", { width, height, 0.1 }, { a, y, z }, "Metal", stoneLit, { -4, 0, 0 }),
+		Kit.box("UpperLeg", { 0.1, height, z * 2 + 0.02 }, { side, y, 0 }, "Metal", stone, { 0, 0, 4 }),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "RuinplateDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The fitted cuirass, its raised breastplate and the bronze chevron.
+			Kit.box("UpperTorso", { 2.08, 1.66, 1.06 }, { 0, 0.02, 0 }, "Metal", stone),
+			Kit.box("UpperTorso", { 1.6, 0.56, 0.12 }, { 0, 0.36, -0.54 }, "Metal", stoneLit),
+			Kit.box("UpperTorso", { 0.5, 0.075, 0.06 }, { -0.25, 0.45, -0.61 }, "Metal", bronze, { 0, 0, -24 }),
+			Kit.box("UpperTorso", { 0.5, 0.075, 0.06 }, { 0.25, 0.45, -0.61 }, "Metal", bronze, { 0, 0, 24 }),
+			Kit.box("UpperTorso", { 0.1, 0.55, 0.06 }, { 0, -0.2, -0.55 }, "Metal", bronze),
+			-- A bronze neckline band, a pale raised back panel, and bronze lacing.
+			Kit.box("UpperTorso", { 1.5, 0.11, 1.12 }, { 0, 0.74, 0 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 1.5, 0.85, 0.08 }, { 0, 0.2, 0.55 }, "Metal", stoneLit),
+			Kit.box("UpperTorso", { 0.42, 0.05, 0.05 }, { 0, 0.34, 0.6 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 0.42, 0.05, 0.05 }, { 0, 0.2, 0.6 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 0.42, 0.05, 0.05 }, { 0, 0.06, 0.6 }, "Metal", bronze),
+			-- The moss-green sash, the bronze belt and the diamond buckle.
+			Kit.box("LowerTorso", { 2.06, 0.34, 1.06 }, { 0, 0, 0 }, "Fabric", mossDeep),
+			Kit.box("LowerTorso", { 2.12, 0.11, 1.12 }, { 0, 0.035, 0 }, "Metal", bronze),
+			Kit.box("LowerTorso", { 0.28, 0.28, 0.1 }, { 0.05, 0.03, -0.575 }, "Metal", bronzeLit, { 0, 0, 45 }),
+			-- The bow at the back of the waist, and its two ribbon ends.
+			Kit.box("LowerTorso", { 0.4, 0.22, 0.1 }, { -0.28, 0.02, 0.58 }, "Fabric", mossDeep, { 0, 0, 18 }),
+			Kit.box("LowerTorso", { 0.4, 0.22, 0.1 }, { 0.28, 0.02, 0.58 }, "Fabric", mossDeep, { 0, 0, -18 }),
+			Kit.box("LowerTorso", { 0.17, 0.19, 0.13 }, { 0, 0.02, 0.61 }, "Metal", bronzeLit),
+			Kit.box("UpperLeg", { 0.09, 0.5, 0.06 }, { -0.38, 0.44, 0.665 }, "Fabric", mossDeep, { 0, 0, 4 }, "Right"),
+			Kit.box("UpperLeg", { 0.09, 0.42, 0.06 }, { -0.33, 0.48, 0.665 }, "Fabric", mossDeep, { 0, 0, -4 }, "Left"),
+			-- The sleeves' upper part: pale stone and close on the arm, with the
+			-- moss-green moved down to the elbow cuff.
+			Kit.box("UpperArm", { 1.03, 1.26, 1.03 }, { 0, 0.01, 0 }, "Metal", stone),
+			Kit.box("UpperArm", { 1.07, 0.09, 1.07 }, { 0, -0.56, 0 }, "Metal", bronze),
+			-- Moss creeping up the right front plate and the left outer plate.
+			Kit.box("UpperLeg", { 0.22, 0.66, 0.06 }, { 0.55, -0.02, -0.645 }, "Fabric", moss, { 4, 0, 0 }, "Right"),
+			Kit.box("UpperLeg", { 0.06, 0.5, 0.28 }, { 0.68, -0.16, 0.28 }, "Fabric", moss, nil, "Left"),
+		},
+		skirtTier(1.2, 1.2, 0.76, 0.56),
+	}),
+}
+
+return look
