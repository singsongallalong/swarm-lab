+		Kit.box("LowerArm", { 1.12, 0.1, 1.12 }, { 0, -0.48, 0 }, "Metal", bronze),
+		-- The gauntlet, with a bronze ridge over the knuckles.
+		Kit.box("Hand", { 1.06, 0.38, 1.06 }, { 0, 0.02, 0 }, "Metal", stoneShade),
+		Kit.box("Hand", { 1.08, 0.1, 0.16 }, { 0, 0.1, -0.5 }, "Metal", bronze),
