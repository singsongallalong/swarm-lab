+--!strict
+-- The Ruinplate crown (the Ruinplate set's helm): a fitted pale ruin-stone
+-- helm ringed with a bronze brow band, its flat top crowned with a bronze ring
+-- of six stone prongs and one bronze spire. A short moss veil hangs down the
+-- back and moss has taken the cap and the circlet. Narrow at the ears, all its
+-- height at the head, so the figure reads as a woman under a crown.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local stone = { 150, 145, 132 }
+local stonePale = { 176, 170, 154 }
+local bronze = { 136, 104, 62 }
+local moss = { 82, 102, 55 }
+local mossDark = { 58, 74, 42 }
+
+-- A crown prong rising from the helm's flat top, set around the crown ring.
+local function prong(
+	x: number,
+	z: number,
+	height: number,
+	material: string,
+	colour: { number }
+): ArmourLookTypes.ArmourPart
+	return Kit.box("Head", { 0.11, height, 0.10 }, { x, 0.58 + height / 2, z }, material, colour)
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "RuinplateCrown",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The stone helm: a cap over the crown of the head and a circlet at the brow.
+		Kit.box("Head", { 1.24, 0.46, 1.24 }, { 0, 0.39, 0 }, "Slate", stone),
+		Kit.box("Head", { 1.28, 0.16, 1.28 }, { 0, 0.14, 0 }, "Slate", stone),
+		Kit.box("Head", { 1.31, 0.06, 1.31 }, { 0, 0.04, 0 }, "Metal", bronze),
+		-- The crown's bronze ring on the helm's top, and its prongs.
+		Kit.box("Head", { 1.02, 0.05, 1.02 }, { 0, 0.635, 0 }, "Metal", bronze),
+		prong(0, -0.48, 0.50, "Metal", bronze),
+		prong(0.416, -0.24, 0.36, "Slate", stonePale),
+		prong(-0.416, -0.24, 0.36, "Slate", stonePale),
+		prong(0.416, 0.24, 0.32, "Slate", stonePale),
+		prong(-0.416, 0.24, 0.32, "Slate", stonePale),
+		prong(0, 0.48, 0.40, "Slate", stonePale),
+		-- Moss on the crown, and the bronze drop at the brow.
+		Kit.box("Head", { 0.30, 0.10, 0.34 }, { -0.28, 0.665, 0.16 }, "Fabric", moss),
+		Kit.box("Head", { 0.22, 0.10, 0.08 }, { -0.44, 0.20, -0.63 }, "Fabric", mossDark),
+		Kit.box("Head", { 0.14, 0.20, 0.06 }, { 0, -0.12, -0.65 }, "Metal", bronze),
+		-- The veil, falling from the circlet down the back.
+		Kit.box("Head", { 0.90, 0.50, 0.06 }, { 0, 0.05, 0.675 }, "Fabric", moss),
+		Kit.box("Head", { 1.00, 0.36, 0.05 }, { 0, -0.42, 0.715 }, "Fabric", mossDark),
+	},
+}
+
+return look
