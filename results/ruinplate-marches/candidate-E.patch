+--!strict
+-- The ruinplate dress (the Ruinplate gown's chest): a fitted pale stone
+-- cuirass with a shallow bust and a bold four-point bronze sun, a bronze
+-- neckline and bodice V, a dark corset pulled in under a wide bronze girdle,
+-- and a plate fauld over a pleated skirt whose back is pale stone. The skirt
+-- steps out in tiers to the floor, so it reads as one bell from the high
+-- camera; moss and a hanging tassel keep it old.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local stone = { 164, 158, 144 }
+local stoneLight = { 190, 184, 166 }
+local stoneDark = { 124, 120, 110 }
+local cloth = { 114, 116, 108 }
+local clothDark = { 90, 94, 88 }
+local bronze = { 140, 106, 60 }
+local bronzeLight = { 176, 138, 82 }
+local moss = { 82, 110, 56 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "RuinplateDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The cuirass, and a shallow bust either side of the sun.
+			Kit.box("UpperTorso", { 2.08, 1.7, 1.06 }, { 0, 0, 0 }, "Metal", stone),
+			Kit.box("UpperTorso", { 0.5, 0.36, 0.14 }, { 0.34, 0.3, -0.545 }, "Metal", stoneLight, { 0, 0, -6 }),
+			Kit.box("UpperTorso", { 0.5, 0.36, 0.14 }, { -0.34, 0.3, -0.545 }, "Metal", stoneLight, { 0, 0, 6 }),
+			-- The carved sun: a bronze boss crossed by a long vertical and
+			-- horizontal ray, so its four points read boldly.
+			{
+				on = "UpperTorso",
+				shape = "Cylinder",
+				size = { 0.44, 0.13, 0.44 },
+				at = { 0, 0.14, -0.59 },
+				turn = { 90, 0, 0 },
+				material = "Metal",
+				color = bronzeLight,
+			},
+			Kit.box("UpperTorso", { 0.1, 0.4, 0.08 }, { 0, 0.14, -0.65 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 0.4, 0.1, 0.08 }, { 0, 0.14, -0.65 }, "Metal", bronze),
+			-- The bronze neckline, and the bodice's V pointing down to the girdle.
+			Kit.box("UpperTorso", { 0.94, 0.09, 0.07 }, { 0, 0.7, -0.555 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 0.06, 0.56, 0.05 }, { 0.15, -0.7, -0.545 }, "Metal", bronze, { 0, 0, -26 }),
+			Kit.box("UpperTorso", { 0.06, 0.56, 0.05 }, { -0.15, -0.7, -0.545 }, "Metal", bronze, { 0, 0, 26 }),
+			-- Moss flat on the left shoulder.
+			Kit.box("UpperTorso", { 0.28, 0.1, 0.32 }, { -0.7, 0.87, -0.18 }, "Fabric", moss, { 0, 0, -5 }),
+			-- The close upper sleeve.
+			Kit.box("UpperArm", { 1.04, 1.2, 1.04 }, { 0, 0, 0 }, "Fabric", cloth),
+		},
+		{
+			-- The dark corset, the wide bronze girdle and its pale diamond.
+			Kit.box("LowerTorso", { 2.04, 0.4, 1.04 }, { 0, 0, 0 }, "Fabric", clothDark),
+			Kit.box("LowerTorso", { 2.06, 0.3, 1.1 }, { 0, 0.05, 0 }, "Metal", bronze),
+			Kit.box("LowerTorso", { 0.28, 0.28, 0.09 }, { 0, 0.05, -0.59 }, "Metal", stoneLight, { 0, 0, 45 }),
+		},
+		{
+			-- The plate fauld over the skirt, edged in bronze round both sides.
+			Kit.box("UpperLeg", { 1.16, 0.52, 0.09 }, { 0.08, 0.46, -0.575 }, "Metal", stone, { 3, 0, 0 }),
+			Kit.box("UpperLeg", { 1.16, 0.52, 0.09 }, { 0.08, 0.46, 0.575 }, "Metal", stoneLight, { -3, 0, 0 }),
+			Kit.box("UpperLeg", { 0.09, 0.52, 1.16 }, { 0.615, 0.46, 0 }, "Metal", stoneDark, { 0, 0, 3 }),
+			Kit.box("UpperLeg", { 1.14, 0.07, 0.1 }, { 0.08, 0.225, -0.6 }, "Metal", bronze, { 3, 0, 0 }),
+			Kit.box("UpperLeg", { 1.14, 0.07, 0.1 }, { 0.08, 0.225, 0.6 }, "Metal", bronze, { -3, 0, 0 }),
+		},
+		{
+			-- The pleated skirt: cloth at the front and sides, pale stone round
+			-- the back, so the gown carries its stone behind as well as before.
+			Kit.box("UpperLeg", { 1.34, 1.24, 0.07 }, { 0.17, 0.02, -0.56 }, "Fabric", cloth, { 8, 0, 0 }),
+			Kit.box("UpperLeg", { 1.34, 1.24, 0.07 }, { 0.17, 0.02, 0.56 }, "Metal", stoneLight, { -8, 0, 0 }),
+			Kit.box("UpperLeg", { 0.07, 1.24, 1.08 }, { 0.805, 0.02, 0 }, "Fabric", cloth, { 0, 0, 8 }),
+			Kit.box("UpperLeg", { 0.11, 1.16, 0.03 }, { 0.3, 0.02, -0.62 }, "Fabric", clothDark, { 8, 0, 0 }),
+			-- A bronze seam down the back of the stone, from the fauld's hem
+			-- to the knee.
+			Kit.box("UpperLeg", { 0.08, 0.73, 0.06 }, { 0.3, -0.185, 0.61 }, "Metal", bronze, { -8, 0, 0 }),
+			-- A mend low on the right leg.
+			Kit.box("UpperLeg", { 0.22, 0.28, 0.03 }, { 0.3, -0.3, -0.62 }, "Fabric", clothDark, { 8, 0, 0 }, "Right"),
+			-- Moss on the right hip and up the right seam, and the bronze tassel.
+			Kit.box("UpperLeg", { 0.24, 0.12, 0.14 }, { 0.5, 0.33, -0.64 }, "Fabric", moss, { 0, 0, -10 }, "Right"),
+			Kit.box("UpperLeg", { 0.12, 0.42, 0.16 }, { 0.81, -0.2, -0.42 }, "Fabric", moss, { 0, 0, -6 }, "Right"),
+			Kit.box("UpperLeg", { 0.06, 0.3, 0.05 }, { 0.45, 0.12, -0.67 }, "Metal", bronze, { 0, 0, -4 }, "Right"),
+			Kit.box(
+				"UpperLeg",
+				{ 0.12, 0.14, 0.09 },
+				{ 0.44, -0.08, -0.67 },
+				"Metal",
+				stoneLight,
+				{ 0, 0, -4 },
+				"Right"
+			),
+		},
+	}),
+}
+
+return look
