+		Kit.box("Head", { 1.28, 0.64, 0.09 }, { 0, 0, 0.62 }, "Fabric", cloth),
+		-- The pale veil behind, its dark pleat and its bronze hem.
+		Kit.box("Head", { 1.1, 1.32, 0.07 }, { 0, -0.26, 0.68 }, "Fabric", stoneLight, { -6, 0, 0 }),
+		Kit.box("Head", { 0.13, 1.28, 0.06 }, { 0, -0.26, 0.725 }, "Fabric", clothDark, { -6, 0, 0 }),
+		Kit.box("Head", { 1.16, 0.12, 0.09 }, { 0, -0.9, 0.75 }, "Metal", bronze, { -6, 0, 0 }),
+		-- The circlet and its pale brow stone.
+		Kit.box("Head", { 1.38, 0.15, 1.38 }, { 0, 0.31, 0 }, "Metal", bronze),
+		Kit.box("Head", { 0.18, 0.18, 0.06 }, { 0, 0.31, -0.705 }, "Metal", bronzeLight, { 0, 0, 45 }),
+		-- The crown front, and the tall crest over the crown with a bronze rail
+		-- along its top: the crest is what reads from the high camera.
+		Kit.box("Head", { 0.58, 0.3, 0.14 }, { 0, 0.47, -0.64 }, "Metal", stone),
+		Kit.box("Head", { 0.36, 0.16, 0.78 }, { 0, 0.67, 0.08 }, "Metal", stoneDark),
+		Kit.box("Head", { 0.26, 0.5, 0.62 }, { 0, 0.92, 0.06 }, "Metal", stoneLight),
+		Kit.box("Head", { 0.3, 0.07, 0.64 }, { 0, 1.185, 0.06 }, "Metal", bronze),
+		-- Moss at the crest's left foot.
+		Kit.box("Head", { 0.3, 0.1, 0.2 }, { -0.33, 0.67, 0.18 }, "Fabric", moss, { 0, 0, 8 }),
+	},
+}
+
+return look
