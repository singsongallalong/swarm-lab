+--!strict
+-- The quarrywright helm (zone armour, the QuarrywrightHelm base): a
+-- stonecutter's wide-brimmed mourning hat. A broad, flat dust-white brim under
+-- a cold slate crown, a linen band with a chisel tucked through it, and a
+-- dust-white veil hung from the brim over the face, with linen wound round
+-- the jaw and nape. The brim is the set's mark from the high camera; the veil
+-- is its death.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The quarry's two tones, local to the set: the dust that cakes everything
+-- and the one cold dark slate, kept to the crown alone.
+local dust = { 188, 188, 180 }
+local slate = { 56, 64, 82 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The crown, cold slate, low under the brim.
+		Kit.box("Head", { 1.28, 0.6, 1.28 }, { 0, 0.36, 0 }, "Metal", slate),
+		-- A dust-white comb over it, front to back: the bright stripe on top.
+		Kit.box("Head", { 0.36, 0.16, 1.32 }, { 0, 0.7, 0 }, "Metal", dust),
+		-- The brim, wide and flat, one pale disc: the set's whole outline.
+		Kit.box("Head", { 2.15, 0.07, 2.05 }, { 0, 0.05, 0 }, "Metal", dust),
+		-- One back corner bent down where it was dropped.
+		Kit.box("Head", { 0.7, 0.07, 0.55 }, { -0.72, 0.02, 0.85 }, "Metal", dust, { 10, 0, -6 }),
+		-- The linen band round the crown, holding the chisel.
+		Kit.box("Head", { 1.34, 0.1, 1.34 }, { 0, 0.15, 0 }, "Fabric", c.linen),
+		-- A chisel tucked through the band on the right, blade up.
+		Kit.box("Head", { 0.1, 0.54, 0.1 }, { 0.7, 0.42, -0.3 }, "Metal", c.ironDark, { 0, 0, -18 }),
+		Kit.wedge("Head", { 0.24, 0.14, 0.09 }, { 0.78, 0.7, -0.3 }, "Metal", c.ironWorn, { 0, 0, -18 }),
+		-- Linen wound round the jaw and nape, closing the neck under the brim.
+		Kit.box("Head", { 1.32, 0.64, 1.32 }, { 0, -0.28, 0.02 }, "Fabric", c.linen),
+		-- The dust-white veil hung from the brim over the face.
+		Kit.box("Head", { 1.1, 0.75, 0.07 }, { 0, -0.32, -0.72 }, "Fabric", dust, { 3, 0, 0 }),
+	},
+}
+
+return look
