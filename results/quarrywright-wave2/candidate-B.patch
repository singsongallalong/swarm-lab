+--!strict
+-- The quarrywright boots (zone armour, the QuarrywrightBoots base): dust-white
+-- boots to the knee, wound round with linen and cuffed in dark leather, with a
+-- dust-pale toe cap over a stone-grey foot. A chisel is tucked through the
+-- right shin's linen, so the tools follow the set everywhere.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The quarry's tones (see QuarrywrightHelm): the dust and the pale stone
+-- beneath it.
+local stone = { 138, 142, 144 }
+local dust = { 188, 188, 180 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightBoots",
+	slot = "Boots",
+	parts = {
+		-- The boot shaft, dust-white, with a dark leather cuff at the knee.
+		Kit.box("LowerLeg", { 1.08, 0.94, 1.08 }, { 0, -0.08, 0 }, "Fabric", dust),
+		Kit.box("LowerLeg", { 1.14, 0.16, 1.14 }, { 0, 0.4, 0 }, "Leather", c.leatherDark),
+		-- Linen wound round the shin, the band askew.
+		Kit.box("LowerLeg", { 1.12, 0.14, 1.12 }, { 0, -0.3, 0 }, "Fabric", c.linen, { 0, 0, -4 }),
+		-- The stone-grey foot, with a dust-white toe cap over it.
+		Kit.box("Foot", { 1.06, 0.34, 1.14 }, { 0, 0.02, -0.03 }, "Leather", stone),
+		Kit.wedge("Foot", { 1.06, 0.26, 0.34 }, { 0, 0.03, -0.42 }, "Leather", dust),
+		-- A chisel tucked through the right shin's linen, blade up.
+		Kit.box("LowerLeg", { 0.06, 0.38, 0.06 }, { 0.58, -0.02, 0.16 }, "Metal", c.ironDark, nil, "Right"),
+		Kit.wedge("LowerLeg", { 0.16, 0.12, 0.05 }, { 0.58, 0.2, 0.16 }, "Metal", c.ironWorn, nil, "Right"),
+	},
+}
+
+return look
