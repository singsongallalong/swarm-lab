+--!strict
+-- The quarrywright chest (zone armour, the QuarrywrightChest base): the
+-- quarryman's work tunic in stone dust, white all through, under a climbing
+-- harness of dark leather and rope crossed over chest and back. Splitting
+-- wedges and chisels hang at the ribs like grave goods, and a rusted mallet
+-- off the belt pouch; one shoulder carries two stepped slabs of cut stone,
+-- the other only a linen wrap.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The quarry's tones, local to the set (see QuarrywrightHelm): the dust that
+-- cakes everything, and the pale stone grey beneath it.
+local stone = { 138, 142, 144 }
+local dust = { 188, 188, 180 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The linen underskirt showing below the tunic, hung from the thighs.
+		Kit.flaps(0.5, "Fabric", c.linen),
+		{
+			-- The tunic and its skirt, dust-white.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", dust),
+			Kit.box("LowerTorso", { 2.1, 0.44, 1.1 }, { 0, 0, 0 }, "Fabric", dust),
+			-- The dust mantle over the shoulders, a warm linen line under it.
+			Kit.box("UpperTorso", { 2.26, 0.28, 1.2 }, { 0, 0.62, 0 }, "Fabric", dust),
+			Kit.box("UpperTorso", { 2.32, 0.12, 1.24 }, { 0, 0.46, 0 }, "Fabric", c.linen),
+			-- The climbing harness: a dark leather strap and a rope crossing
+			-- over chest and back, a rope belt and an off-centre iron buckle.
+			Kit.box("UpperTorso", { 2.14, 0.15, 1.12 }, { 0, 0.08, 0 }, "Leather", c.leatherDark, { 0, 0, -30 }),
+			Kit.box("UpperTorso", { 2.12, 0.1, 1.1 }, { 0, 0.02, 0 }, "Fabric", c.rope, { 0, 0, 34 }),
+			Kit.box("LowerTorso", { 2.14, 0.16, 1.14 }, { 0, 0.04, 0 }, "Fabric", c.rope),
+			Kit.box("LowerTorso", { 0.18, 0.14, 0.08 }, { 0.3, 0.04, -0.58 }, "Metal", c.ironDark),
+			-- A chalk pouch hung from the belt at the right hip, and a rusted
+			-- mallet strapped to it so it reads as a quarry tool.
+			Kit.box("LowerTorso", { 0.3, 0.28, 0.18 }, { 0.76, -0.1, -0.5 }, "Fabric", c.linen),
+			Kit.box("LowerTorso", { 0.05, 0.34, 0.05 }, { 0.76, 0.02, -0.63 }, "Wood", c.timber),
+			Kit.box("LowerTorso", { 0.2, 0.12, 0.14 }, { 0.76, -0.16, -0.63 }, "Metal", c.rust),
+			-- Sleeves of the same tunic, and the right shoulder's two cut slabs.
+			Kit.box("UpperArm", { 1.06, 1.2, 1.06 }, { 0, 0, 0 }, "Fabric", dust),
+			Kit.box("UpperArm", { 1.28, 0.16, 1.24 }, { 0.04, 0.56, 0 }, "Metal", dust, { 0, 0, -8 }, "Right"),
+			Kit.box("UpperArm", { 1.18, 0.14, 1.16 }, { 0.02, 0.42, 0 }, "Metal", stone, { 0, 0, -5 }, "Right"),
+			-- The left arm's linen wrap instead, so the shoulders are uneven.
+			Kit.box("UpperArm", { 1.12, 0.15, 1.12 }, { 0, 0.3, 0 }, "Fabric", c.linen, { 0, 0, 7 }, "Left"),
+			-- Trophies: a splitting wedge at the right ribs, a chisel at the
+			-- left on a rope loop, its blade hanging bright.
+			Kit.wedge("UpperTorso", { 0.16, 0.46, 0.24 }, { 0.66, -0.12, -0.6 }, "Metal", c.ironDark, { 0, 90, 0 }),
+			Kit.box("UpperTorso", { 0.14, 0.1, 0.08 }, { -0.56, 0, -0.58 }, "Fabric", c.rope),
+			Kit.box("UpperTorso", { 0.08, 0.44, 0.08 }, { -0.56, -0.22, -0.57 }, "Metal", c.ironDark, { 0, 0, -6 }),
+			Kit.wedge("UpperTorso", { 0.2, 0.16, 0.08 }, { -0.58, -0.46, -0.57 }, "Metal", c.ironWorn, { 0, 0, -6 }),
+			-- Wear: a torn linen patch at the hem and a stone-grey rubbed back.
+			Kit.box("LowerTorso", { 0.46, 0.16, 0.06 }, { -0.42, -0.1, -0.56 }, "Fabric", c.linen),
+			Kit.box("UpperTorso", { 0.7, 0.5, 0.06 }, { 0.36, -0.2, 0.55 }, "Fabric", stone, { 0, 0, 6 }),
+		},
+	}),
+}
+
+return look
