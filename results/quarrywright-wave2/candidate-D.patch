@@ -0,0 +1,31 @@
+--!strict
+-- The quarrywright boots (the Quarrywright set): pale quarry-stone greaves cut
+-- square with a dust-caked band below the knee, linen wound at the ankle, a
+-- dark iron shin plate, and blocky stone boots with a scraped bright iron toe.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The quarry palette: pale stone for the body and dust white on every flat top.
+local stone = { 148, 147, 141 }
+local dust = { 178, 175, 164 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightBoots",
+	slot = "Boots",
+	parts = {
+		-- The greave, squared, a dust band at the knee.
+		Kit.box("LowerLeg", { 1.08, 1.0, 1.08 }, { 0, -0.1, 0 }, "Metal", stone),
+		Kit.box("LowerLeg", { 1.14, 0.16, 1.14 }, { 0, 0.46, 0 }, "Fabric", dust),
+		-- Linen wound at the ankle.
+		Kit.box("LowerLeg", { 1.12, 0.18, 1.12 }, { 0, -0.5, 0 }, "Fabric", c.linen, { 0, 0, -4 }),
+		-- The iron shin plate.
+		Kit.box("LowerLeg", { 0.76, 0.54, 0.1 }, { 0, -0.04, -0.57 }, "Metal", c.ironDark, { -4, 0, 0 }),
+		-- The boot, blocky, its sole on the ground, and its iron toe.
+		Kit.box("Foot", { 1.1, 0.4, 1.24 }, { 0, 0.05, -0.04 }, "Metal", stone),
+		Kit.box("Foot", { 1.06, 0.3, 0.26 }, { 0, 0, -0.66 }, "Metal", c.ironWorn),
+	},
+}
+
+return look
diff --git a/src/shared/data/armourLooks/QuarrywrightChest.luau b/src/shared/data/armourLooks/QuarrywrightChest.luau
new file mode 100644
index 00000000..65b31caf
--- /dev/null
+++ b/src/shared/data/armourLooks/QuarrywrightChest.luau
@@ -0,0 +1,73 @@
+--!strict
+-- The quarrywright chest (the Quarrywright set): a cuirass of pale quarry
+-- stone with a dust-white apron down the front, square pauldrons with the
+-- quarryman's iron wedges still driven into the dust on top, a dark iron belt
+-- and linen waist wrap, skirt flaps of dusted cloth, a mason's chisel hung at
+-- the right thigh and a bone skull hung from the left over a dark niche.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The quarry palette: pale stone for the body, dust white on every flat top,
+-- and rusted iron where it was worked.
+local stone = { 148, 147, 141 }
+local dust = { 178, 175, 164 }
+
+-- The skull hung from the belt at the left thigh: a bone cranium and jaw over
+-- a dark iron niche on the dust flap, on a linen cord, so the set's charnel
+-- side swings with the leg and reads pale against the dark.
+local function hungSkull(): { ArmourLookTypes.ArmourPart }
+	return {
+		Kit.box("UpperLeg", { 0.42, 0.44, 0.06 }, { 0.4, 0.44, -0.605 }, "Metal", c.ironDark, nil, "Left"),
+		{
+			on = "UpperLeg",
+			side = "Left",
+			shape = "Ball",
+			size = { 0.36, 0.36, 0.3 },
+			at = { 0.4, 0.44, -0.68 },
+			material = "Marble",
+			color = c.bone,
+		},
+		Kit.box("UpperLeg", { 0.22, 0.12, 0.14 }, { 0.4, 0.24, -0.68 }, "Marble", c.bone, nil, "Left"),
+		Kit.box("UpperLeg", { 0.06, 0.34, 0.06 }, { 0.4, 0.66, -0.64 }, "Fabric", c.linen, { 0, 0, 4 }, "Left"),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Skirt flaps front and back, hung from the thighs, caked in dust.
+		Kit.flaps(0.54, "Fabric", dust),
+		{
+			-- Two cut slabs, the upper and the lower.
+			Kit.box("UpperTorso", { 2.08, 1.66, 1.08 }, { 0, 0, 0 }, "Metal", stone),
+			Kit.box("LowerTorso", { 2.1, 0.46, 1.1 }, { 0, 0, 0 }, "Metal", stone),
+			-- The dust-white apron down the front, a little off centre.
+			Kit.box("UpperTorso", { 1.62, 1.14, 0.08 }, { -0.04, 0.02, -0.56 }, "Fabric", dust, { 0, 0, 2 }),
+			-- Linen wound round the waist, a dark iron belt below it, the buckle
+			-- off centre.
+			Kit.box("LowerTorso", { 2.13, 0.2, 1.13 }, { 0, 0.17, 0 }, "Fabric", c.linen, { 0, 0, 2 }),
+			Kit.box("LowerTorso", { 2.16, 0.13, 1.16 }, { 0, 0, 0 }, "Metal", c.ironDark),
+			Kit.box("LowerTorso", { 0.28, 0.2, 0.1 }, { 0.34, 0, -0.6 }, "Metal", c.ironWorn),
+			-- A stone sleeve up the whole arm, and the pauldron block with the
+			-- quarryman's wedges left driven into its dust: one dark, one
+			-- rusting, as wedges are left in a half-split face.
+			Kit.box("UpperArm", { 1.06, 1.2, 1.06 }, { 0, 0, 0 }, "Metal", stone),
+			Kit.box("UpperArm", { 1.4, 0.5, 1.34 }, { 0.06, 0.56, 0 }, "Metal", stone, { 0, 0, -6 }),
+			Kit.box("UpperArm", { 1.26, 0.14, 1.26 }, { 0.06, 0.8, 0 }, "Fabric", dust, { 0, 0, -6 }),
+			Kit.wedge("UpperArm", { 0.16, 0.3, 0.24 }, { -0.04, 0.9, -0.2 }, "Metal", c.ironDark, { 0, 0, 10 }),
+			Kit.wedge("UpperArm", { 0.16, 0.3, 0.24 }, { 0.28, 0.9, -0.2 }, "Metal", c.rust, { 0, 0, -8 }),
+		},
+		{
+			-- The mason's chisel hung at the right thigh: dark haft and bright
+			-- cutting edge, over the front of the flap so it is seen.
+			Kit.box("UpperLeg", { 0.07, 0.44, 0.07 }, { 0.34, 0.34, -0.65 }, "Metal", c.ironDark, { 0, 0, 3 }, "Right"),
+			Kit.box("UpperLeg", { 0.13, 0.12, 0.09 }, { 0.345, 0.1, -0.65 }, "Metal", c.ironWorn, { 0, 0, 3 }, "Right"),
+		},
+		hungSkull(),
+	}),
+}
+
+return look
