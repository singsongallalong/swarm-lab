@@ -0,0 +1,44 @@
+--!strict
+-- The quarrywright helm (the Quarrywright set): the set's one piece of cold
+-- dark slate, worn like a tombstone cut from the quarry face. A closed square
+-- block, a second smaller block quarried off its crown and stepped to one
+-- side, dust settled on the new cut and a chalk line marking it, an iron eye
+-- slit and chisel nasal, and a linen dust veil at the neck.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The quarry palette: pale stone for the body, dust white on every flat top,
+-- and one cold dark slate, kept for the helm alone.
+local slate = { 60, 64, 74 }
+local slateDark = { 36, 39, 48 }
+local dust = { 178, 175, 164 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The block, closed over the whole face.
+		Kit.box("Head", { 1.36, 1.24, 1.36 }, { 0, 0, 0 }, "Metal", slate),
+		-- A smaller block quarried off the top, stepped to the right.
+		Kit.box("Head", { 0.94, 0.32, 1.04 }, { 0.05, 0.76, 0.02 }, "Metal", slate),
+		-- Dust settles on the new cut, and a chalk line runs round its base.
+		Kit.box("Head", { 1.0, 0.1, 1.1 }, { 0.05, 0.95, 0.02 }, "Fabric", dust),
+		Kit.box("Head", { 1.42, 0.07, 1.42 }, { 0, 0.6, 0 }, "Metal", dust),
+		-- The eye slit and the chisel nasal that splits it.
+		Kit.box("Head", { 0.96, 0.13, 0.08 }, { 0, -0.06, -0.69 }, "Metal", slateDark),
+		Kit.box("Head", { 0.14, 0.52, 0.1 }, { 0, -0.28, -0.72 }, "Metal", c.ironWorn),
+		-- Cheek plates, one cut on each side.
+		Kit.box("Head", { 0.1, 0.54, 0.46 }, { 0.69, -0.28, -0.2 }, "Metal", slate),
+		-- The linen dust veil hung from the back rim, over the neck.
+		Kit.box("Head", { 1.2, 0.46, 0.16 }, { 0, -0.34, 0.66 }, "Fabric", c.linen, { -12, 0, 0 }),
+		-- A saw mark chalked across the crown block's front.
+		Kit.box("Head", { 0.5, 0.06, 0.08 }, { 0.05, 0.8, -0.5 }, "Metal", dust),
+		-- A chip knocked out of the left brow, rusting in the cut.
+		Kit.box("Head", { 0.26, 0.18, 0.06 }, { -0.36, 0.3, -0.69 }, "Metal", c.rust, { 0, 0, 14 }),
+	},
+}
+
+return look
