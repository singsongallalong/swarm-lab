+--!strict
+-- The niche hood (zone armour, the Quarrywright set's helm): the quarrymen's
+-- burial hood, cut square like the niches in the terrace walls. A close
+-- chalk-pale cowl, brought in and down from the first cut so the head no longer
+-- outgrows the shoulders: a stepped top lip and keystone over the face slot,
+-- two pale jambs framing it, a cold slate shadow under the lip and linen wraps
+-- across the mouth. The jambs hang past the jaw to the shoulders.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	chalk = { 176, 178, 180 }, -- stone dust white, on lintel and lip
+	chalkShade = { 138, 141, 145 }, -- the hood's dusted pale cloth
+	quarry = { 110, 114, 120 }, -- the shadowed hood tail
+	slate = { 54, 60, 74 }, -- the one cold dark slate, the niche's shadow
+	wrap = { 158, 152, 140 }, -- the linen burial wrap across the face
+	wrapShadow = { 126, 120, 108 }, -- its shadowed lower turn
+	rust = { 104, 76, 56 }, -- the rusted iron pin
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightNicheHood",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The crown, close over the skull, and the lintel stepping out above it.
+		Kit.box("Head", { 1.34, 0.44, 1.34 }, { 0, 0.42, 0.02 }, "Fabric", c.chalkShade),
+		Kit.box("Head", { 1.44, 0.12, 1.42 }, { 0, 0.66, 0.02 }, "Fabric", c.chalk),
+		-- The niche's top lip, stepped out over the face slot, and its keystone.
+		Kit.box("Head", { 1.16, 0.14, 0.24 }, { 0, 0.22, -0.64 }, "Fabric", c.chalk),
+		Kit.box("Head", { 0.34, 0.14, 0.16 }, { 0.05, 0.36, -0.67 }, "Fabric", c.chalk, { 0, 0, 2 }),
+		-- The two jambs, framing the slot and hanging past the jaw.
+		Kit.box("Head", { 0.14, 0.86, 1.3 }, { 0.65, -0.19, 0.01 }, "Fabric", c.chalkShade),
+		Kit.box("Head", { 0.14, 0.86, 1.3 }, { -0.65, -0.19, 0.01 }, "Fabric", c.chalkShade),
+		-- The back of the hood, and its torn tail off to the left.
+		Kit.box("Head", { 1.24, 0.86, 0.14 }, { 0, -0.13, 0.64 }, "Fabric", c.chalkShade),
+		Kit.box("Head", { 0.8, 0.4, 0.12 }, { -0.08, -0.76, 0.66 }, "Fabric", c.quarry, { 10, 0, -4 }),
+		-- Linen burial wraps across the mouth, and a shadowed one under the chin.
+		Kit.box("Head", { 1.08, 0.26, 0.12 }, { 0, -0.3, -0.6 }, "Fabric", c.wrap, { 0, 0, -4 }),
+		Kit.box("Head", { 1.14, 0.16, 0.14 }, { 0, -0.51, -0.56 }, "Fabric", c.wrapShadow, { 0, 0, 2 }),
+		-- The niche's dark reveal under the lip, and the rusted pin that holds it.
+		Kit.box("Head", { 1.04, 0.07, 0.1 }, { 0, 0.1, -0.61 }, "Fabric", c.slate),
+		Kit.box("Head", { 0.09, 0.18, 0.16 }, { 0.5, 0.13, -0.68 }, "Metal", c.rust, { 0, 0, -8 }),
+	},
+}
+
+return look
