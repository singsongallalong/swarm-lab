+--!strict
+-- The quarrywright mantle (the Quarrywright set's chest): a grave shroud of
+-- pale linen dropped over a cold slate tunic, bound round with two rusted iron
+-- hoops like the bands a quarry puts round a block before it lifts it. A rope
+-- belt with an off-centre iron buckle, a quarryman's maul hung from the belt
+-- over the right thigh, and linen flaps hanging from the thighs. The broad
+-- pale shoulder line is the set's shape from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local cloth = {
+	grave = { 132, 136, 139 }, -- grave linen, cooled toward grey
+	shadow = { 100, 105, 109 }, -- a dirt shadow worked into the cloth
+	slate = { 56, 64, 78 }, -- the set's one cold dark slate
+	rope = { 94, 92, 84 }, -- grey hemp at the waist
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightMantle",
+	slot = "Chest",
+	parts = Kit.join({
+		Kit.flaps(0.55, "Fabric", cloth.grave),
+		{
+			-- The tunic under the shroud.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", cloth.slate),
+			Kit.box("LowerTorso", { 2.10, 0.44, 1.10 }, { 0, 0, 0 }, "Fabric", cloth.slate),
+			-- The shroud, slung a little askew, longer at the back with one torn
+			-- corner hanging below the hem.
+			Kit.box("UpperTorso", { 2.24, 1.18, 0.10 }, { -0.04, 0.26, -0.57 }, "Fabric", cloth.grave, { 0, 0, 2 }),
+			Kit.box("UpperTorso", { 2.24, 1.24, 0.10 }, { 0.03, 0.20, 0.57 }, "Fabric", cloth.grave, { 0, 0, -2 }),
+			Kit.box("UpperTorso", { 0.86, 0.36, 0.10 }, { 0.60, -0.36, 0.57 }, "Fabric", cloth.grave),
+			-- A standing collar, and the stone dust worked into one side of the front.
+			Kit.box("UpperTorso", { 1.16, 0.22, 1.16 }, { 0, 0.84, 0 }, "Fabric", cloth.grave),
+			Kit.box("UpperTorso", { 0.58, 0.54, 0.06 }, { -0.54, -0.02, -0.63 }, "Fabric", cloth.shadow),
+			-- The two iron hoops.
+			Kit.box("UpperTorso", { 2.26, 0.12, 1.32 }, { 0, 0.30, 0 }, "Metal", c.iron),
+			Kit.box("LowerTorso", { 2.20, 0.14, 1.26 }, { 0, 0.10, 0 }, "Metal", c.ironDark),
+			-- Rope belt below the hoop, with an off-centre scraped buckle.
+			Kit.box("LowerTorso", { 2.26, 0.10, 1.20 }, { 0, -0.06, 0 }, "Fabric", cloth.rope, { 0, 0, 3 }),
+			Kit.box("LowerTorso", { 0.24, 0.22, 0.10 }, { 0.36, 0.02, -0.61 }, "Metal", c.ironWorn),
+			-- Mantle shoulders: linen over an iron-rimmed pad, the right shod in rust.
+			Kit.box("UpperArm", { 1.30, 0.26, 1.30 }, { 0.04, 0.56, 0 }, "Fabric", cloth.grave, { 0, 0, -6 }),
+			Kit.box("UpperArm", { 1.34, 0.10, 1.34 }, { 0.04, 0.40, 0 }, "Metal", c.iron, { 0, 0, -6 }),
+			Kit.box("UpperArm", { 1.38, 0.14, 1.38 }, { 0.05, 0.68, 0 }, "Metal", c.rust, { 0, 0, -6 }, "Right"),
+			Kit.box("UpperArm", { 1.06, 1.24, 1.06 }, { 0, 0, 0 }, "Fabric", cloth.slate),
+			-- A quarryman's maul hung from the belt over the right thigh: a
+			-- leather loop, a wooden haft and a dark iron head.
+			Kit.box("UpperLeg", { 0.12, 0.22, 0.12 }, { 0.30, 0.54, -0.62 }, "Leather", c.leatherDark, nil, "Right"),
+			Kit.box("UpperLeg", { 0.09, 0.72, 0.09 }, { 0.30, 0.20, -0.66 }, "Leather", c.timber, { 0, 0, 3 }, "Right"),
+			Kit.box("UpperLeg", { 0.38, 0.30, 0.38 }, { 0.30, -0.30, -0.66 }, "Metal", c.ironDark, nil, "Right"),
+			-- A loose thread of the shroud, off centre.
+			Kit.box("UpperTorso", { 0.20, 0.28, 0.07 }, { 0.66, -0.46, -0.63 }, "Fabric", cloth.grave, { 0, 0, 7 }),
+		},
+	}),
+}
+
+return look
diff --git a/src/shared/data/armourLooks/QuarrywrightMask.luau b/src/shared/data/armourLooks/QuarrywrightMask.luau
