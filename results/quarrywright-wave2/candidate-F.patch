+--!strict
+-- The quarrywright bands (the Quarrywright set's gloves): grave linen wound
+-- from elbow to wrist, bound by a rusted iron hoop at either end. The hands
+-- are cold slate leather under a pale stone-dusted cuff, and one loose end of
+-- linen hangs from the left elbow.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local cloth = {
+	grave = { 132, 136, 139 }, -- grave linen, cooled toward grey
+	slate = { 56, 64, 78 }, -- the set's one cold dark slate
+	stone = { 126, 130, 133 }, -- a pale stone past the glove
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightBands",
+	slot = "Gloves",
+	parts = {
+		Kit.box("LowerArm", { 1.10, 1.04, 1.10 }, { 0, -0.02, 0 }, "Fabric", cloth.grave),
+		-- Iron hoop at the elbow and a darker one at the wrist.
+		Kit.box("LowerArm", { 1.16, 0.12, 1.16 }, { 0, 0.34, 0 }, "Metal", c.iron),
+		Kit.box("LowerArm", { 1.14, 0.10, 1.14 }, { 0, -0.40, 0 }, "Metal", c.ironDark),
+		-- One loose end of linen at the left elbow.
+		Kit.box("LowerArm", { 0.13, 0.36, 0.07 }, { 0.34, 0.24, 0.54 }, "Fabric", cloth.grave, { 12, 0, 0 }, "Left"),
+		-- Cold slate hands with a pale stone cuff.
+		Kit.box("Hand", { 1.06, 0.34, 1.06 }, { 0, 0.02, 0 }, "Leather", cloth.slate),
+		Kit.box("Hand", { 1.08, 0.12, 1.08 }, { 0, 0.22, 0 }, "Concrete", cloth.stone),
+	},
+}
+
+return look
