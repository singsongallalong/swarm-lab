+--!strict
+-- The quarrywright wraps (the Quarrywright set's boots): grave linen wound up
+-- the shin from ankle to knee, bound by iron hoops and dusted quarry grey up
+-- one shin, with cold slate shoes shod in iron at the toe. A loose end of
+-- linen hangs at the left ankle, and the set's dark slate keeps the foot low
+-- under the pale wrap at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local cloth = {
+	grave = { 132, 136, 139 }, -- grave linen, cooled toward grey
+	dust = { 100, 105, 108 }, -- quarry dust worked into the weave
+	slate = { 56, 64, 78 }, -- the set's one cold dark slate
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightWraps",
+	slot = "Boots",
+	parts = {
+		Kit.box("LowerLeg", { 1.10, 0.94, 1.10 }, { 0, -0.10, 0 }, "Fabric", cloth.grave),
+		-- Dust ground into the front of the right shin.
+		Kit.box("LowerLeg", { 0.38, 0.56, 0.06 }, { 0.27, -0.06, -0.575 }, "Fabric", cloth.dust, nil, "Right"),
+		-- Iron hoops below the knee and at the ankle.
+		Kit.box("LowerLeg", { 1.16, 0.12, 1.16 }, { 0, 0.30, 0 }, "Metal", c.iron),
+		Kit.box("LowerLeg", { 1.14, 0.10, 1.14 }, { 0, -0.40, 0 }, "Metal", c.ironDark),
+		-- One loose end of linen at the left ankle.
+		Kit.box("LowerLeg", { 0.14, 0.38, 0.07 }, { 0.34, 0.18, 0.54 }, "Fabric", cloth.grave, { -10, 0, 0 }, "Left"),
+		-- The shoe, its toe shod in scraped iron.
+		Kit.box("Foot", { 1.06, 0.34, 1.14 }, { 0, 0.02, -0.04 }, "Leather", cloth.slate),
+		Kit.box("Foot", { 0.86, 0.18, 0.26 }, { 0, 0.04, -0.62 }, "Metal", c.ironWorn),
+	},
+}
+
+return look
