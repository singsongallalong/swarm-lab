@@ -0,0 +1,47 @@
+--!strict
+-- The quarrywright mask (the Quarrywright set's helm): a blank death mask
+-- carved from pale quarry stone and worn over the whole head, like the
+-- effigies in the terrace niches. A flat-cut crown slab with one corner
+-- broken away to the grey stone beneath, one deep dark slate eye slit split by
+-- a chiselled nose, and a rusted iron hoop at brow and jaw. The pale squared
+-- head against the cold slate is the set's outline at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local stone = {
+	block = { 118, 122, 124 }, -- pale quarry grey, cooled toward grey
+	dust = { 150, 153, 155 }, -- stone dust white, for the crown and face
+	cut = { 92, 97, 100 }, -- the shadowed cut of the chisel
+	slate = { 56, 64, 78 }, -- the set's one cold dark slate
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightMask",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The head cut down to a block and squared off, a little larger than
+		-- the head, the way a quarry cuts a plinth.
+		Kit.box("Head", { 1.40, 1.34, 1.40 }, { 0, 0.02, 0 }, "Slate", stone.block),
+		-- The crown cut as an L so its front-right corner is broken away,
+		-- showing the grey stone of the block beneath.
+		Kit.box("Head", { 1.50, 0.18, 1.16 }, { 0, 0.62, 0.17 }, "Concrete", stone.dust),
+		Kit.box("Head", { 1.06, 0.18, 0.34 }, { -0.22, 0.62, -0.58 }, "Concrete", stone.dust),
+		-- The face, paler than the block, with its deep eye slit and mouth.
+		Kit.box("Head", { 1.26, 1.12, 0.10 }, { 0, -0.02, -0.69 }, "Concrete", stone.dust),
+		Kit.box("Head", { 1.04, 0.18, 0.10 }, { 0, 0.20, -0.75 }, "Slate", stone.slate),
+		Kit.box("Head", { 0.16, 0.72, 0.12 }, { 0, 0.02, -0.79 }, "Slate", stone.cut),
+		Kit.box("Head", { 0.40, 0.10, 0.10 }, { 0, -0.36, -0.75 }, "Slate", stone.slate),
+		-- Iron hoops standing proud of the face, and a crack chiselled down
+		-- one cheek.
+		Kit.box("Head", { 1.52, 0.12, 1.52 }, { 0, 0.40, 0 }, "Metal", c.iron),
+		Kit.box("Head", { 1.52, 0.14, 1.52 }, { 0, -0.48, 0 }, "Metal", c.ironDark),
+		Kit.box("Head", { 0.06, 0.42, 0.06 }, { -0.46, -0.16, -0.75 }, "Slate", stone.cut, { 0, 0, -12 }),
+		-- Rust eaten into the brow hoop, off centre.
+		Kit.box("Head", { 0.18, 0.08, 0.05 }, { -0.44, 0.42, -0.78 }, "Metal", c.rust),
+	},
+}
+
+return look
