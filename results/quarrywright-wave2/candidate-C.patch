+--!strict
+-- The quarrywright's helm (the Quarrywright set): a broad flat-brimmed iron
+-- overseer's helm, its wide brim and low crown capped in settled stone dust.
+-- A dark pick head crosses the crown with one point turned out, and a nasal
+-- bar splits the face under the brim. One iron cheek guard on the right and a
+-- dust-caked linen veil round the left and the nape. The pale brim reads as a
+-- wide disc from the high camera, with the pick a dark cross upon it.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local q = table.freeze({
+	dust = { 164, 164, 154 }, -- stone dust white
+	dustShade = { 138, 140, 134 }, -- pale quarry grey
+	iron = { 108, 106, 102 }, -- old iron under the dust
+	slate = { 58, 64, 72 }, -- the set's cold dark slate
+	linen = { 132, 124, 108 }, -- dust-caked linen wraps
+})
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The low iron crown, dust-caked pale on its flat top.
+		Kit.box("Head", { 1.3, 0.56, 1.3 }, { 0, 0.34, 0 }, "Metal", q.iron),
+		Kit.box("Head", { 1.06, 0.2, 1.06 }, { 0, 0.66, 0 }, "Metal", q.dust),
+		-- The broad brim: an iron rim with a wide disc of dust settled on it.
+		Kit.box("Head", { 1.94, 0.12, 1.94 }, { 0, 0.1, 0 }, "Metal", q.iron),
+		Kit.box("Head", { 1.8, 0.06, 1.8 }, { 0, 0.17, 0 }, "Metal", q.dustShade),
+		-- A dark brow band, and the pick head crossing the crown: a long bar
+		-- with one pointed end turned out, the other left blunt like an adze.
+		Kit.box("Head", { 1.36, 0.14, 1.36 }, { 0, 0.24, 0 }, "Metal", q.slate),
+		Kit.box("Head", { 1.62, 0.14, 0.2 }, { 0, 0.8, 0 }, "Metal", q.slate),
+		Kit.wedge("Head", { 0.2, 0.16, 0.36 }, { 0.86, 0.8, 0 }, "Metal", q.iron, { 0, -90, 0 }),
+		-- The nasal bar, hung off the brim over the face.
+		Kit.box("Head", { 0.14, 0.5, 0.1 }, { 0, -0.18, -0.75 }, "Metal", q.slate),
+		-- One iron cheek guard; the other side and the nape are wrapped in
+		-- a dust cloth, so only the face shows under the brim.
+		Kit.box("Head", { 0.1, 0.7, 1.06 }, { 0.68, -0.25, 0.06 }, "Metal", q.iron, { 0, 0, -3 }),
+		Kit.box("Head", { 1.36, 0.72, 0.14 }, { 0, -0.26, 0.58 }, "Fabric", q.linen),
+		Kit.box("Head", { 0.12, 0.7, 1.06 }, { -0.68, -0.25, 0.06 }, "Fabric", q.linen, { 0, 0, 4 }),
+	},
+}
+
+return look
