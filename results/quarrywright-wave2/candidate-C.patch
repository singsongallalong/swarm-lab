+--!strict
+-- The quarrywright's apron-coat (the Quarrywright set): a heavy dust-white
+-- leather coat with a broad pale apron down the front and pale sleeves, each
+-- banded once in cold slate at the elbow. A slate yoke and collar cross the
+-- shoulders, an iron pauldron sits on the right and a chalk dust pad on the
+-- left. A rusted chain belt crosses the waist, a linen grave-wrap runs down
+-- the left edge of the tabard and a crossed hammer-and-chisel badge is pinned
+-- off centre. The pale apron and sleeves carry the family's colour at the
+-- high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local q = table.freeze({
+	dust = { 164, 164, 154 }, -- stone dust white
+	dustShade = { 138, 140, 134 }, -- pale quarry grey
+	slate = { 58, 64, 72 }, -- the set's cold dark slate
+	slateDark = { 42, 47, 54 },
+	iron = { 108, 106, 102 }, -- old iron under the dust
+	linen = { 132, 124, 108 }, -- dust-caked linen wraps
+	rust = { 118, 82, 58 }, -- rusted iron
+})
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The apron's dusty tails, hung from the thighs so they swing with them.
+		Kit.flaps(0.6, "Leather", q.slate),
+		{
+			-- The coat itself, and the broad apron panel over its front.
+			Kit.box("UpperTorso", { 2.06, 1.64, 1.06 }, { 0, 0, 0 }, "Leather", q.dustShade),
+			Kit.box("LowerTorso", { 2.08, 0.44, 1.08 }, { 0, 0, 0 }, "Leather", q.dustShade),
+			Kit.box("UpperTorso", { 1.58, 1.5, 0.08 }, { 0, -0.02, -0.56 }, "Leather", q.dust),
+			Kit.box("LowerTorso", { 1.58, 0.46, 0.08 }, { 0, 0, -0.56 }, "Leather", q.dust),
+			-- The grave-wrap: a linen band down the tabard's left edge, passing
+			-- under the chain belt at the waist.
+			Kit.box("UpperTorso", { 0.17, 1.42, 0.08 }, { -0.63, -0.04, -0.64 }, "Fabric", q.linen),
+			Kit.box("LowerTorso", { 0.17, 0.46, 0.08 }, { -0.63, 0, -0.585 }, "Fabric", q.linen),
+			-- A cold slate yoke across the shoulders and a high collar over it.
+			Kit.box("UpperTorso", { 2.16, 0.2, 1.14 }, { 0, 0.72, 0 }, "Fabric", q.slate),
+			Kit.box("UpperTorso", { 0.94, 0.18, 0.94 }, { 0, 0.86, 0 }, "Fabric", q.slateDark),
+			-- Pale coat sleeves, with one slate band at each elbow.
+			Kit.box("UpperArm", { 1.06, 1.2, 1.06 }, { 0, 0, 0 }, "Leather", q.dustShade),
+			Kit.box("UpperArm", { 1.12, 0.14, 1.12 }, { 0, -0.46, 0 }, "Fabric", q.slate),
+			-- The right shoulder wears iron: one broad pauldron.
+			Kit.box("UpperArm", { 1.32, 0.26, 1.3 }, { 0.02, 0.54, 0 }, "Metal", q.iron, { 0, 0, -6 }, "Right"),
+			-- The left carries a thick pad caked in stone dust.
+			Kit.box("UpperArm", { 1.32, 0.26, 1.3 }, { 0.02, 0.52, 0 }, "Leather", q.dust, { 0, 0, -6 }, "Left"),
+			-- Belt, and the chain of rusted links slung across its front.
+			Kit.box("LowerTorso", { 2.12, 0.16, 1.12 }, { 0, 0.1, 0 }, "Leather", q.slateDark),
+			Kit.box("LowerTorso", { 0.4, 0.14, 0.1 }, { -0.66, 0.1, -0.6 }, "Metal", q.rust, { 0, 0, 8 }),
+			Kit.box("LowerTorso", { 0.4, 0.14, 0.1 }, { -0.22, 0.1, -0.6 }, "Metal", q.rust, { 0, 0, -8 }),
+			Kit.box("LowerTorso", { 0.4, 0.14, 0.1 }, { 0.22, 0.1, -0.6 }, "Metal", q.rust, { 0, 0, 8 }),
+			Kit.box("LowerTorso", { 0.4, 0.14, 0.1 }, { 0.66, 0.1, -0.6 }, "Metal", q.rust, { 0, 0, -8 }),
+			-- The badge: a hammer and a chisel crossed, pinned off centre.
+			Kit.box("UpperTorso", { 0.07, 0.42, 0.07 }, { 0.14, 0.3, -0.64 }, "Metal", q.iron, { 0, 0, -28 }),
+			Kit.box("UpperTorso", { 0.22, 0.11, 0.09 }, { 0.24, 0.46, -0.64 }, "Metal", q.iron, { 0, 0, -28 }),
