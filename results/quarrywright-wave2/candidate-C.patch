+--!strict
+-- The quarrywright's gloves (the Quarrywright set): dust-pale leather
+-- bracers under cold slate elbow cuffs, over near-black slate gloves. The
+-- right arm wears an iron band and an iron knuckle ridge, the left a linen
+-- wrist wrap and a chisel lashed to the bracer; a rust stain soaks the right
+-- cuff, so the two hands are not quite a pair.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local q = table.freeze({
+	dustShade = { 138, 140, 134 }, -- pale quarry grey
+	slate = { 58, 64, 72 }, -- the set's cold dark slate
+	slateDark = { 42, 47, 54 },
+	iron = { 108, 106, 102 }, -- old iron under the dust
+	linen = { 132, 124, 108 }, -- dust-caked linen wraps
+	rust = { 118, 82, 58 }, -- rusted iron
+})
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightGloves",
+	slot = "Gloves",
+	parts = {
+		-- Paired bracers under paired slate cuffs.
+		Kit.box("LowerArm", { 1.12, 0.9, 1.12 }, { 0, -0.08, 0 }, "Leather", q.dustShade),
+		Kit.box("LowerArm", { 1.18, 0.22, 1.18 }, { 0, 0.44, 0 }, "Fabric", q.slate),
+		-- The right arm's iron: a wrist band and a knuckle ridge.
+		Kit.box("LowerArm", { 1.14, 0.1, 1.14 }, { 0, -0.4, 0 }, "Metal", q.iron, nil, "Right"),
+		Kit.box("Hand", { 1.06, 0.36, 1.06 }, { 0, 0, 0 }, "Leather", q.slateDark),
+		Kit.box("Hand", { 0.9, 0.14, 0.3 }, { 0, 0.16, -0.38 }, "Metal", q.iron, nil, "Right"),
+		-- A rust stain soaked into the right bracer.
+		Kit.box("LowerArm", { 0.32, 0.22, 0.06 }, { 0.3, -0.1, -0.58 }, "Leather", q.rust, { 0, 0, 8 }, "Right"),
+		-- The left arm's linen: a wrist wrap, a hanging tail and a chisel.
+		Kit.box("LowerArm", { 1.16, 0.16, 1.16 }, { 0, 0.18, 0 }, "Fabric", q.linen, nil, "Left"),
+		Kit.box("LowerArm", { 0.1, 0.36, 0.08 }, { 0.6, 0.25, -0.2 }, "Fabric", q.linen, { 0, 0, -4 }, "Left"),
+		Kit.box("LowerArm", { 0.07, 0.44, 0.06 }, { 0.32, -0.05, -0.6 }, "Metal", q.iron, { 0, 0, 6 }, "Left"),
+	},
+}
+
+return look
