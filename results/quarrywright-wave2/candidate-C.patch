+--!strict
+-- The quarrywright's boots (the Quarrywright set): heavy dust-white boots
+-- with a folded pale cuff at the knee, a band of linen wound round each shin
+-- and a cold slate shin plate. The right boot is capped in rusted iron; the
+-- left has a linen tie hanging from its cuff, so the pair is worn unevenly.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local q = table.freeze({
+	dust = { 164, 164, 154 }, -- stone dust white
+	dustShade = { 138, 140, 134 }, -- pale quarry grey
+	slate = { 58, 64, 72 }, -- the set's cold dark slate
+	linen = { 132, 124, 108 }, -- dust-caked linen wraps
+	rust = { 118, 82, 58 }, -- rusted iron
+})
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "QuarrywrightBoots",
+	slot = "Boots",
+	parts = {
+		-- The tall boot, its dust cuff folded down at the knee.
+		Kit.box("LowerLeg", { 1.1, 0.92, 1.1 }, { 0, -0.1, 0 }, "Leather", q.dustShade),
+		Kit.box("LowerLeg", { 1.18, 0.22, 1.18 }, { 0, 0.4, 0 }, "Leather", q.dust),
+		-- A band of linen wound over each shin, under the slate plate.
+		Kit.box("LowerLeg", { 1.14, 0.14, 1.14 }, { 0, 0.16, 0 }, "Fabric", q.linen),
+		Kit.box("LowerLeg", { 0.84, 0.56, 0.1 }, { 0, 0.02, -0.58 }, "Metal", q.slate, { -6, 0, 0 }),
+		-- The boot; only the right one is shod with a rusted iron toe cap.
+		Kit.box("Foot", { 1.06, 0.36, 1.14 }, { 0, 0.02, -0.03 }, "Leather", q.dustShade),
+		Kit.box("Foot", { 0.8, 0.18, 0.32 }, { 0, 0.06, -0.52 }, "Metal", q.rust, nil, "Right"),
+		-- A linen tie hanging from the left cuff.
+		Kit.box("LowerLeg", { 0.12, 0.34, 0.08 }, { 0.54, 0.28, -0.2 }, "Fabric", q.linen, { 0, 0, -5 }, "Left"),
+	},
+}
+
+return look
