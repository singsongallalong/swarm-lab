+--!strict
+-- The Fortwarden coif (zone armour, the FortwardenCoif base): the garrison's
+-- padded arming coif in the town's blue, stepped and quilted at the crown, with
+-- a cream brow band, a riveted steel brow strip and nasal, a brass badge and
+-- padded cheeks and nape. Rounded and soft beside the iron bowl, so the town's
+-- own soldiers read as a different family before any detail does.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: a muted blue and a pale painted cream (bible §2), and
+-- the fort's small brass badge.
+local blue = { 54, 68, 100 }
+local blueDark = { 38, 46, 68 }
+local cream = { 166, 154, 126 }
+local brassBadge = { 146, 122, 76 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenCoif",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- A padded crown in three low steps, like a quilted arming cap.
+		Kit.box("Head", { 1.36, 0.72, 1.36 }, { 0, 0.26, 0 }, "Fabric", blue),
+		Kit.box("Head", { 1.2, 0.16, 1.2 }, { 0, 0.64, 0 }, "Fabric", blue),
+		Kit.box("Head", { 0.98, 0.1, 0.98 }, { 0, 0.75, 0 }, "Fabric", blue),
+		-- A steel brow band over a cream stripe: the garrison's soldier's edge.
+		Kit.box("Head", { 1.46, 0.16, 1.46 }, { 0, 0.09, 0 }, "Metal", c.ironWorn),
+		Kit.box("Head", { 1.42, 0.1, 1.42 }, { 0, -0.05, 0 }, "Fabric", cream),
+		-- The nasal bar under a brass boss, set on the brow band over the face.
+		Kit.box("Head", { 0.18, 0.5, 0.1 }, { 0, -0.12, -0.72 }, "Metal", c.ironWorn),
+		Kit.box("Head", { 0.3, 0.3, 0.12 }, { 0, 0.09, -0.77 }, "Metal", brassBadge),
+		-- Padded cheeks, the left sat a little lower; a pale patch on the crown.
+		Kit.box("Head", { 0.14, 0.54, 0.9 }, { 0.69, -0.3, 0 }, "Fabric", blue),
+		Kit.box("Head", { 0.14, 0.54, 0.9 }, { -0.69, -0.32, 0.02 }, "Fabric", blue, { 0, 0, -4 }),
+		Kit.box("Head", { 1.26, 0.6, 0.3 }, { 0, -0.32, 0.56 }, "Fabric", blueDark),
+		Kit.box("Head", { 0.26, 0.22, 0.06 }, { -0.4, 0.4, -0.7 }, "Fabric", c.linen, { 0, 0, 10 }),
+	},
+}
+
+return look
