+--!strict
+-- The Fortwarden boots (zone armour, the FortwardenBoots base): brown garrison
+-- boots, blue cuffs over a cream band, and a riveted steel shin plate. The right
+-- boot keeps its steel toe cap; the left is scuffed pale where it has worn
+-- through, so the pair carries the garrison's uneven wear.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: a muted blue and a pale painted cream (bible §2), and
+-- the fort's small brass badge.
+local blue = { 54, 68, 100 }
+local cream = { 166, 154, 126 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenBoots",
+	slot = "Boots",
+	parts = {
+		Kit.box("LowerLeg", { 1.08, 1.0, 1.08 }, { 0, -0.06, 0 }, "Leather", c.leather),
+		-- Blue cuff over the cream band at the knee.
+		Kit.box("LowerLeg", { 1.14, 0.2, 1.14 }, { 0, 0.44, 0 }, "Fabric", blue),
+		Kit.box("LowerLeg", { 1.12, 0.1, 1.12 }, { 0, 0.28, 0 }, "Fabric", cream),
+		-- The steel shin plate.
+		Kit.box("LowerLeg", { 0.68, 0.54, 0.1 }, { 0, -0.08, -0.57 }, "Metal", c.iron),
+		-- The boot, the right's steel toe cap and the left's pale scuff.
+		Kit.box("Foot", { 1.06, 0.36, 1.14 }, { 0, 0.02, -0.04 }, "Leather", c.leather),
+		Kit.box("Foot", { 1.12, 0.34, 0.34 }, { 0, 0.02, -0.45 }, "Metal", c.iron, nil, "Right"),
+		Kit.box("Foot", { 1.06, 0.14, 0.32 }, { 0, 0.13, -0.46 }, "Leather", c.leatherScuff, nil, "Left"),
+	},
+}
+
+return look
