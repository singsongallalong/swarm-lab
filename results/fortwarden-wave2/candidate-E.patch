+--!strict
+-- The Fortwarden pavise (zone armour, the FortwardenPavise base): the garrison's
+-- blue padded coat with a cream livery panel, a brass badge and a leather
+-- quiver-belt across the chest, a bolt case at the left hip, and a tall painted
+-- pavise strapped to the back. The pavise's cream face and blue cross fill the
+-- back, and the set reads first as the cream slab and the blue body, then as
+-- the belt, buckles and steel.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The town's heraldry: a muted blue and a pale painted cream (bible §2), and
+-- the fort's small brass badge.
+local blue = { 54, 68, 100 }
+local blueDark = { 38, 46, 68 }
+local cream = { 166, 154, 126 }
+local brassBadge = { 146, 122, 76 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenPavise",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The pavise: one flat board on the back in the town's blue, a cream
+		-- cross and a brass boss for the town's arms, seated close. The paint is
+		-- scraped through to the bare board at the lower right.
+		{
+			Kit.box("UpperTorso", { 1.56, 1.9, 0.14 }, { 0, 0.16, 0.62 }, "Fabric", blue),
+			Kit.box("UpperTorso", { 0.34, 1.9, 0.06 }, { 0, 0.16, 0.7 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 1.56, 0.34, 0.06 }, { 0, 0.34, 0.7 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 0.28, 0.28, 0.1 }, { 0, 0.34, 0.76 }, "Metal", brassBadge),
+			Kit.box("UpperTorso", { 0.46, 0.14, 0.1 }, { 0.34, -0.4, 0.69 }, "Wood", c.timber, { 0, 0, 16 }),
+		},
+		-- The padded coat: blue, with the cream livery panel and its brass badge;
+		-- a patch of pale linen sewn over a tear in the blue.
+		{
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", blue),
+			Kit.box("LowerTorso", { 2.1, 0.44, 1.1 }, { 0, 0, 0 }, "Fabric", blueDark),
+			Kit.box("UpperTorso", { 0.96, 1.52, 0.07 }, { 0, 0, -0.57 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 0.28, 1.52, 0.06 }, { 0, 0, -0.61 }, "Fabric", blue),
+			Kit.box("UpperTorso", { 0.22, 0.22, 0.08 }, { 0, 0.58, -0.65 }, "Metal", brassBadge),
+			Kit.box("UpperTorso", { 0.3, 0.26, 0.06 }, { -0.62, 0.22, -0.6 }, "Fabric", c.linen, { 0, 0, 6 }),
+		},
+		-- Belt, the quiver-belt from the right shoulder to the left hip, and the
+		-- bolt case and its pale fletchings hung at the left hip.
+		{
+			Kit.box("LowerTorso", { 2.16, 0.16, 1.16 }, { 0, 0.02, 0 }, "Leather", c.leatherDark),
+			Kit.box("LowerTorso", { 0.24, 0.18, 0.08 }, { 0.28, 0.02, -0.62 }, "Metal", brassBadge),
+			Kit.box("UpperTorso", { 0.2, 1.8, 0.08 }, { 0, 0.06, -0.66 }, "Leather", c.leather, { 0, 0, -30 }),
+			Kit.box("LowerTorso", { 0.3, 0.32, 0.22 }, { -0.58, 0.1, -0.52 }, "Leather", c.leatherDark, { 0, 0, 6 }),
+			Kit.box("LowerTorso", { 0.26, 0.14, 0.2 }, { -0.6, 0.32, -0.52 }, "Fabric", cream, { 0, 0, 6 }),
+		},
+		-- Blue padded sleeves, a blue shoulder roll each side, and a steel
+		-- spaulder only on the right.
+		{
+			Kit.box("UpperArm", { 1.06, 1.18, 1.06 }, { 0, 0, 0 }, "Fabric", blue),
+			Kit.box("UpperArm", { 1.16, 0.2, 1.16 }, { 0, 0.52, 0 }, "Fabric", blue, { 0, 0, -10 }),
+			Kit.box("UpperArm", { 1.22, 0.16, 1.22 }, { 0.03, 0.63, 0 }, "Metal", c.ironWorn, { 0, 0, -14 }, "Right"),
+		},
+		-- Blue coat tails hung from the thighs, so they swing with the legs.
+		Kit.flaps(0.7, "Fabric", blue),
+	}),
+}
+
+return look
