+--!strict
+-- The Fortwarden helm (zone armour, the Fortwarden set): the watch captain's
+-- sallet. A steel bowl whose crown is covered in the watch's blue above a cream
+-- band, so it reads heraldic from the high camera rather than as a plain steel
+-- block: a cream comb on top, a bellows visor and dark sight slit, a bevor and
+-- a long steel tail. A brass badge on the crown; one side dented and rusting.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- Town heraldry: a deep watch blue, cream trim, and a brass badge just warm
+-- enough to read against the steel.
+local blue = { 54, 74, 108 }
+local cream = { 142, 138, 126 }
+local brass = { 122, 100, 64 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The steel bowl, its crown covered blue above a cream band.
+		Kit.box("Head", { 1.36, 0.6, 1.3 }, { 0, 0.34, 0.02 }, "Metal", c.iron),
+		Kit.box("Head", { 1.4, 0.36, 1.34 }, { 0, 0.48, 0.02 }, "Fabric", blue),
+		Kit.box("Head", { 1.44, 0.1, 1.38 }, { 0, 0.23, 0.02 }, "Fabric", cream),
+		-- The sallet's long tail, angled down the back of the neck.
+		Kit.box("Head", { 1.14, 0.18, 0.72 }, { 0, 0.2, 0.78 }, "Metal", c.iron, { 14, 0, 0 }),
+		-- The bellows visor, with a raised bright brow above a dark sight slit.
+		Kit.box("Head", { 1.22, 0.34, 0.18 }, { 0, -0.04, -0.69 }, "Metal", c.iron, { -6, 0, 0 }),
+		Kit.box("Head", { 1.1, 0.08, 0.1 }, { 0, 0.11, -0.78 }, "Metal", c.ironWorn, { -6, 0, 0 }),
+		Kit.box("Head", { 1.0, 0.055, 0.06 }, { 0, -0.005, -0.79 }, "Metal", c.ironDark),
+		-- The bevor closes the chin below the visor.
+		Kit.box("Head", { 1.26, 0.28, 1.02 }, { 0, -0.3, -0.1 }, "Metal", c.ironDark),
+		-- The cream comb along the crown.
+		Kit.box("Head", { 0.24, 0.18, 0.95 }, { 0, 0.72, 0.12 }, "Fabric", cream),
+		-- The watch's brass badge on the blue crown.
+		Kit.box("Head", { 0.3, 0.2, 0.08 }, { 0, 0.4, -0.66 }, "Metal", brass),
+		-- A dent in the steel below the band, rusting.
+		Kit.box("Head", { 0.07, 0.14, 0.2 }, { -0.68, 0.12, -0.06 }, "Metal", c.rust),
+	},
+}
+
+return look
