+
+local c = Kit.colors
+
+-- Town heraldry: watch blue and cream trim.
+local blue = { 54, 74, 108 }
+local cream = { 142, 138, 126 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenBoots",
+	slot = "Boots",
+	parts = {
+		-- The brown boot, and the worn strap round the ankle.
+		Kit.box("LowerLeg", { 1.08, 0.94, 1.08 }, { 0, -0.1, 0 }, "Leather", c.leather),
+		Kit.box("LowerLeg", { 1.12, 0.08, 1.1 }, { 0, -0.04, 0 }, "Leather", c.leatherScuff),
+		-- The steel shin plate, under the blue wrap and its cream line.
+		Kit.box("LowerLeg", { 0.84, 0.58, 0.1 }, { 0, 0.0, -0.56 }, "Metal", c.iron, { -5, 0, 0 }),
+		Kit.box("LowerLeg", { 1.14, 0.16, 1.14 }, { 0, 0.4, 0 }, "Fabric", blue),
+		Kit.box("LowerLeg", { 1.19, 0.05, 1.18 }, { 0, 0.32, 0 }, "Fabric", cream),
+		-- The foot, in dark leather.
+		Kit.box("Foot", { 1.04, 0.34, 1.16 }, { 0, 0.02, -0.05 }, "Leather", c.leatherDark),
+	},
+}
+
+return look
