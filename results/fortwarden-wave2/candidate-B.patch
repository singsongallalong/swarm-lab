+--!strict
+-- The Fortwarden chest (zone armour, the Fortwarden set): the watch captain's
+-- brigandine. Town-blue cloth over hidden plates, four brass rivets flanking a
+-- cream chevron and its brass badge, a cream standing collar and a leather belt
+-- with its buckle worn off centre. Broad blue pauldron tops edged in steel
+-- carry the captain's badge on the left, so the watch reads blue from the high
+-- camera. A short blue cape hangs from the shoulders, cream-trimmed, the cream
+-- chevron repeated on its back and its hem stopping short at the right corner.
+-- Blue tassets swing from the thighs.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- Town heraldry: watch blue, its darker shade for the cape, cream trim, brass.
+local blue = { 54, 74, 108 }
+local blueDark = { 44, 60, 88 }
+local cream = { 142, 138, 126 }
+local brass = { 122, 100, 64 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The blue tassets that swing with the thighs, and the brass rivets
+		-- flanking the chevron.
+		Kit.flaps(0.5, "Fabric", blue),
+		Kit.studs("UpperTorso", { -0.72, 0.72 }, { 0.42, -0.18 }, -0.55, brass),
+		{
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", blue),
+			Kit.box("LowerTorso", { 2.12, 0.44, 1.1 }, { 0, 0, 0 }, "Fabric", blue),
+			-- The belt, its buckle worn off centre.
+			Kit.box("LowerTorso", { 2.18, 0.18, 1.16 }, { 0, -0.02, 0 }, "Leather", c.leatherDark),
+			Kit.box("LowerTorso", { 0.22, 0.14, 0.1 }, { 0.3, -0.02, -0.6 }, "Metal", brass),
+			-- A cream standing collar, and the chevron of the watch.
+			Kit.box("UpperTorso", { 1.36, 0.14, 1.08 }, { 0, 0.72, 0 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 0.82, 0.2, 0.08 }, { 0.33, 0.26, -0.56 }, "Fabric", cream, { 0, 0, 36 }),
+			Kit.box("UpperTorso", { 0.82, 0.2, 0.08 }, { -0.33, 0.26, -0.56 }, "Fabric", cream, { 0, 0, -36 }),
+			Kit.box("UpperTorso", { 0.24, 0.24, 0.1 }, { 0, 0.02, -0.6 }, "Metal", brass),
+			-- The blue sleeve under the pauldron.
+			Kit.box("UpperArm", { 1.06, 1.2, 1.06 }, { 0, 0, 0 }, "Fabric", blue),
+			-- Broad blue pauldron tops, seated on the arm and edged in steel,
+			-- the captain's badge on the left.
+			Kit.box("UpperArm", { 1.24, 0.3, 1.22 }, { 0.02, 0.5, 0 }, "Fabric", blue),
+			Kit.box("UpperArm", { 1.28, 0.08, 1.26 }, { 0.02, 0.34, 0 }, "Metal", c.ironWorn),
+			Kit.box("UpperArm", { 0.18, 0.16, 0.09 }, { 0.02, 0.5, -0.63 }, "Metal", brass, nil, "Left"),
+			-- The short blue cape, hung from the shoulders; the cream chevron
+			-- repeats on its back so the watch reads walking away, and its hem
+			-- stops short on the right, as if a corner has worn away.
+			Kit.box("UpperTorso", { 1.84, 1.42, 0.12 }, { 0, -0.08, 0.65 }, "Fabric", blueDark, { -4, 0, 0 }),
+			Kit.box("UpperTorso", { 1.9, 0.2, 0.16 }, { 0, 0.63, 0.6 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 0.82, 0.2, 0.1 }, { 0.33, 0.12, 0.71 }, "Fabric", cream, { 0, 0, 36 }),
+			Kit.box("UpperTorso", { 0.82, 0.2, 0.1 }, { -0.33, 0.12, 0.71 }, "Fabric", cream, { 0, 0, -36 }),
+			Kit.box("UpperTorso", { 1.4, 0.14, 0.08 }, { -0.24, -0.74, 0.78 }, "Fabric", cream, { -4, 0, 0 }),
+		},
+	}),
+}
+
+return look
