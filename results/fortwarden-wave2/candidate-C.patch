+--!strict
+-- The Fortwarden chest (art pass A014): the garrison's blue livery coat. A
+-- blue cloth coat over the torso, sleeves and thigh tails, with a broad cream
+-- heraldic panel crossed by a blue chevron and a brass badge. The collar,
+-- belt and back harness are brown leather; the only steel is the pair of
+-- broad pauldrons, two tiers each, that frame the blue at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local townBlue = { 54, 74, 108 }
+local cream = { 146, 142, 128 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- The coat's tails hang from the thighs, so they swing with the legs
+		-- (A14-D9) and carry the blue down the legs.
+		Kit.flaps(0.7, "Fabric", townBlue),
+		{
+			-- The blue coat, and one leather harness strap across the back.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Fabric", townBlue),
+			Kit.box("LowerTorso", { 2.1, 0.44, 1.1 }, { 0, 0, 0 }, "Fabric", townBlue),
+			Kit.box("UpperTorso", { 1.9, 0.14, 0.08 }, { 0, 0.3, 0.56 }, "Leather", c.leather),
+			-- A leather gorget with the cream collar line.
+			Kit.box("UpperTorso", { 1.3, 0.24, 1.16 }, { 0, 0.8, 0 }, "Leather", c.leatherDark),
+			Kit.box("UpperTorso", { 1.34, 0.06, 1.2 }, { 0, 0.86, 0 }, "Fabric", cream),
+			-- The broad cream panel, its blue chevron and the brass badge.
+			Kit.box("UpperTorso", { 0.9, 1.2, 0.06 }, { 0, 0.02, -0.56 }, "Fabric", cream),
+			Kit.box("UpperTorso", { 0.5, 0.16, 0.07 }, { -0.18, 0.2, -0.61 }, "Fabric", townBlue, { 0, 0, -30 }),
+			Kit.box("UpperTorso", { 0.5, 0.16, 0.07 }, { 0.18, 0.2, -0.61 }, "Fabric", townBlue, { 0, 0, 30 }),
+			Kit.box("UpperTorso", { 0.26, 0.28, 0.08 }, { 0, -0.24, -0.61 }, "Metal", c.brass),
+			-- The leather belt, its brass buckle worn off centre.
+			Kit.box("LowerTorso", { 2.12, 0.18, 1.12 }, { 0, 0.08, 0 }, "Leather", c.leatherDark),
+			Kit.box("LowerTorso", { 0.28, 0.24, 0.08 }, { 0.17, 0.08, -0.58 }, "Metal", c.brass),
+			-- Blue sleeves under the steel pauldrons.
+			Kit.box("UpperArm", { 1.06, 1.22, 1.06 }, { 0, -0.06, 0 }, "Fabric", townBlue),
+			-- Steel pauldrons, two broad tiers each.
+			Kit.box("UpperArm", { 1.3, 0.26, 1.28 }, { 0, 0.62, 0 }, "Metal", c.iron, { 0, 0, 8 }),
+			Kit.box("UpperArm", { 1.18, 0.2, 1.18 }, { 0, 0.4, 0 }, "Metal", c.ironDark, { 0, 0, 8 }),
+		},
+	}),
+}
+
+return look
