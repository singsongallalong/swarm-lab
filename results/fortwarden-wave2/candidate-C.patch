+--!strict
+-- The Fortwarden helm (art pass A014): the fort garrison's great helm, a
+-- flat-topped steel barrel with a proud visor, a mail tail and a brass badge
+-- set off centre on the brow. Its keep crest is the set's mark from the high
+-- camera: a blue-enamelled battlement band around the crown, and three broad
+-- cream crenels above it cut out against the moon.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The garrison's own colours (art bible §2, muted and worn): town blue enamel
+-- at the accent's limits, and a dusty heraldic cream.
+local townBlue = { 54, 74, 108 }
+local cream = { 146, 142, 128 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- One steel barrel over the whole head, flat-topped for the crest.
+		Kit.box("Head", { 1.36, 1.1, 1.36 }, { 0, 0.02, 0 }, "Metal", c.iron),
+		-- The blue battlement band, proud of the crown.
+		Kit.box("Head", { 1.4, 0.22, 1.4 }, { 0, 0.66, 0 }, "Metal", townBlue),
+		-- A dark rim round the jaw, below the visor.
+		Kit.box("Head", { 1.44, 0.14, 1.44 }, { 0, -0.5, 0 }, "Metal", c.ironDark),
+		-- The visor, proud of the barrel, with its eye slit above.
+		Kit.box("Head", { 1.24, 0.44, 0.14 }, { 0, -0.2, -0.66 }, "Metal", c.iron),
+		Kit.box("Head", { 0.96, 0.1, 0.06 }, { 0, -0.02, -0.75 }, "Metal", c.ironDark),
+		-- The brass badge of the garrison, worn off centre.
+		Kit.box("Head", { 0.26, 0.28, 0.08 }, { -0.2, 0.3, -0.7 }, "Metal", c.brass),
+		-- A mail tail at the back of the neck.
+		Kit.box("Head", { 1.32, 0.36, 0.34 }, { 0, -0.5, 0.53 }, "Metal", c.mail),
+		-- The keep crest: blue comb, three broad cream crenels.
+		Kit.box("Head", { 0.2, 0.36, 1.3 }, { 0, 0.9, 0 }, "Metal", townBlue),
+		Kit.box("Head", { 0.6, 0.28, 0.36 }, { 0, 1.14, -0.46 }, "Metal", cream),
+		Kit.box("Head", { 0.6, 0.28, 0.36 }, { 0, 1.14, 0 }, "Metal", cream),
+		Kit.box("Head", { 0.6, 0.28, 0.36 }, { 0, 1.14, 0.46 }, "Metal", cream),
+	},
+}
+
+return look
