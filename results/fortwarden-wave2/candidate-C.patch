+--!strict
+-- The Fortwarden boots (art pass A014): brown leather boots for the fort's
+-- garrison. A blue cloth knee band over a cream line, a cream stripe down the
+-- shin, a brass stud at the right knee and a pale leather scuff up the right
+-- shin: the tower knight's legs in the livery's blue, cream and brass.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local townBlue = { 54, 74, 108 }
+local cream = { 146, 142, 128 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FortwardenBoots",
+	slot = "Boots",
+	parts = {
+		-- The boot, the blue knee band and its cream line.
+		Kit.box("LowerLeg", { 1.08, 0.94, 1.08 }, { 0, -0.1, 0 }, "Leather", c.leather),
+		Kit.box("LowerLeg", { 1.16, 0.26, 1.16 }, { 0, 0.44, 0 }, "Fabric", townBlue),
+		Kit.box("LowerLeg", { 1.12, 0.06, 1.12 }, { 0, 0.29, 0 }, "Fabric", cream),
+		-- A cream stripe down the shin to the leather foot.
+		Kit.box("LowerLeg", { 0.16, 0.6, 0.1 }, { 0, -0.15, -0.54 }, "Fabric", cream),
+		Kit.box("Foot", { 1.06, 0.38, 1.2 }, { 0, 0, -0.05 }, "Leather", c.leatherDark),
+		-- A brass stud at the right knee only, and a pale scuff up the right
+		-- shin (A14-D6 asymmetry).
+		Kit.box("LowerLeg", { 0.14, 0.14, 0.1 }, { 0.3, 0.44, -0.56 }, "Metal", c.brass, nil, "Right"),
+		Kit.box(
+			"LowerLeg",
+			{ 0.22, 0.18, 0.06 },
+			{ 0.2, -0.18, -0.55 },
+			"Leather",
+			c.leatherScuff,
+			{ 0, 0, -14 },
+			"Right"
+		),
+	},
+}
+
+return look
