+		-- The long veil down the back, and its violet hem behind it.
+		Kit.box("Head", { 1.10, 1.62, 0.09 }, { 0, -0.09, 0.72 }, "Fabric", c.slate),
+		Kit.box("Head", { 1.14, 0.12, 0.06 }, { 0, -0.87, 0.77 }, "Fabric", c.violet),
