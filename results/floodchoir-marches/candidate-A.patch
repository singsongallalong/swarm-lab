+--!strict
+-- The Floodchoir helm (the Drowned Parish's gown set): the bell-ringer's
+-- hood. Black cloth over the crown, open at the face and low over the head,
+-- with a wedge rising gently to the back so the shape reads as cloth rather
+-- than a steeple; rope frames the face above a stained-glass brooch with a
+-- candle's heart. A pale slate veil falls from the crown down the back to a
+-- violet hem. Hides the wearer's hair.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	black = { 40, 41, 48 }, -- the vestment's cloth, near-black with a blue cast
+	blackSoft = { 56, 58, 66 }, -- the hood's raised ridge
+	slate = { 94, 100, 110 }, -- the veil, pale in the moon
+	rope = { 120, 108, 88 }, -- rope trim round the face
+	violet = { 82, 66, 102 }, -- stained glass at the brooch and the veil's hem
+	amber = { 156, 130, 84 }, -- the candle's lit heart
+}
