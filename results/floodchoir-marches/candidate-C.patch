+--!strict
+-- The Floodchoir hem (the Drowned Parish's gown set, boots): the skirt steps
+-- out at the knee into a wide tier and again at the shin into the widest tier
+-- of all, each one deeper as well as wider, so the gown falls as a bell and
+-- not a column. The front hem is banded in stained violet and the back in
+-- stained crimson, over pointed black mourning shoes.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	black = { 26, 25, 31 },
+	blackSoft = { 42, 40, 48 },
+	crimson = { 92, 46, 52 },
+	violet = { 76, 60, 100 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FloodchoirHem",
+	slot = "Boots",
+	parts = {
+		-- The first tier, from just above the knee to the mid-shin.
+		Kit.box("LowerLeg", { 1.80, 0.56, 0.07 }, { 0.40, 0.34, -1.00 }, "Fabric", c.black),
+		Kit.box("LowerLeg", { 1.80, 0.56, 0.07 }, { 0.40, 0.34, 1.00 }, "Fabric", c.black),
+		Kit.box("LowerLeg", { 0.07, 0.56, 2.00 }, { 1.23, 0.34, 0 }, "Fabric", c.blackSoft),
+		Kit.box("LowerLeg", { 1.80, 0.06, 2.00 }, { 0.40, 0.59, 0 }, "Fabric", c.black),
+		-- The second and widest tier, from the mid-shin to the ankle.
+		Kit.box("LowerLeg", { 2.20, 0.70, 0.07 }, { 0.60, -0.25, -1.30 }, "Fabric", c.black),
+		Kit.box("LowerLeg", { 2.20, 0.70, 0.07 }, { 0.60, -0.25, 1.30 }, "Fabric", c.black),
+		Kit.box("LowerLeg", { 0.07, 0.70, 2.60 }, { 1.65, -0.25, 0 }, "Fabric", c.blackSoft),
+		Kit.box("LowerLeg", { 2.20, 0.06, 2.60 }, { 0.60, 0.07, 0 }, "Fabric", c.black),
+		-- The hem: violet glass at the front, crimson glass behind, where the
+		-- high camera sees it.
+		Kit.box("LowerLeg", { 2.22, 0.22, 0.06 }, { 0.60, -0.49, -1.35 }, "SmoothPlastic", c.violet),
+		Kit.box("LowerLeg", { 2.22, 0.22, 0.06 }, { 0.60, -0.49, 1.35 }, "SmoothPlastic", c.crimson),
+		-- A pointed black mourning shoe.
+		Kit.box("Foot", { 1.08, 0.62, 1.16 }, { 0, 0.01, -0.02 }, "Leather", c.black),
+		Kit.wedge("Foot", { 0.62, 0.32, 0.36 }, { 0, -0.13, -0.68 }, "Leather", c.blackSoft),
+	},
+}
+
+return look
