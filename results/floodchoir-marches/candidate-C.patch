+--!strict
+-- The Floodchoir dress (the Drowned Parish's gown set, chest): a plain black
+-- choir bodice with a high collar edged in stained crimson, a warm lace jabot
+-- under an amber pin, a violet-framed stained-glass reliquary down the front
+-- and a broad violet sash at the narrow waist. The skirt begins to flare at
+-- the hip and steps wider again below the knee, carried on by the hem slot.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	black = { 26, 25, 31 },
+	blackSoft = { 42, 40, 48 },
+	lace = { 104, 98, 88 },
+	crimson = { 92, 46, 52 },
+	violet = { 76, 60, 100 },
+	wax = { 180, 156, 112 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FloodchoirDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice covers the whole upper torso and the top of the waist,
+		-- close and plain, with the collar ringed at its top in crimson.
+		Kit.box("UpperTorso", { 2.06, 1.64, 1.06 }, { 0, 0, 0 }, "Fabric", c.black),
+		Kit.box("UpperTorso", { 1.44, 0.30, 1.30 }, { 0, 0.68, 0.02 }, "Fabric", c.black),
+		Kit.box("UpperTorso", { 1.50, 0.14, 1.36 }, { 0, 0.795, 0.02 }, "SmoothPlastic", c.crimson),
+		-- A warm lace jabot at the throat under a bead of candle amber.
+		Kit.box("UpperTorso", { 0.46, 0.30, 0.05 }, { 0, 0.36, -0.56 }, "Fabric", c.lace),
+		Kit.box("UpperTorso", { 0.16, 0.16, 0.06 }, { 0, 0.40, -0.60 }, "SmoothPlastic", c.wax, { 0, 0, 45 }),
+		-- The reliquary: a stained-glass window down the front, violet framing
+		-- the crimson light.
+		Kit.box("UpperTorso", { 0.78, 0.92, 0.04 }, { 0, -0.16, -0.552 }, "SmoothPlastic", c.violet),
+		Kit.box("UpperTorso", { 0.60, 0.78, 0.045 }, { 0, -0.16, -0.556 }, "SmoothPlastic", c.crimson),
+		-- One broad violet sash at the waist, the narrow point between the
+		-- bodice and the skirt.
+		Kit.box("LowerTorso", { 2.10, 0.34, 1.10 }, { 0, 0.13, 0 }, "Fabric", c.violet),
+		-- A black shelf across the hips, so the wide skirt's mouth never
+		-- shows the floor through the gap round the waist.
+		Kit.box("LowerTorso", { 2.90, 0.05, 1.80 }, { 0, -0.17, 0 }, "Fabric", c.black),
+		-- A gathered black bustle at the back, to swell the skirt low.
+		Kit.box("LowerTorso", { 1.60, 0.36, 0.40 }, { 0, 0.0, 0.61 }, "Fabric", c.blackSoft),
+		-- The upper sleeves stay close to the arm; the sleeve look flares
+		-- below the elbow.
+		Kit.box("UpperArm", { 1.04, 1.22, 1.04 }, { 0, 0, 0 }, "Fabric", c.black),
+		-- The first skirt tier, hung from each thigh, already wider than the
+		-- waist and meeting into one skirt standing. The hem steps it out
+		-- again at the knee and once more at the shin.
+		Kit.box("UpperLeg", { 1.45, 1.42, 0.07 }, { 0.225, 0.09, -0.90 }, "Fabric", c.black),
+		Kit.box("UpperLeg", { 1.45, 1.42, 0.07 }, { 0.225, 0.09, 0.90 }, "Fabric", c.black),
+		Kit.box("UpperLeg", { 0.07, 1.42, 1.80 }, { 0.895, 0.09, 0 }, "Fabric", c.blackSoft),
+	},
+}
