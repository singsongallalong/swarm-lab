diff --git a/src/shared/data/armourLooks/FloodchoirVeil.luau b/src/shared/data/armourLooks/FloodchoirVeil.luau
new file mode 100644
index 0000000..d781d3a
--- /dev/null
+++ b/src/shared/data/armourLooks/FloodchoirVeil.luau
@@ -0,0 +1,65 @@
+--!strict
+-- The Floodchoir veil (the Drowned Parish's gown set, helm): a soft black
+-- mourning cap of cloth over the head, caught into a small peak with a point
+-- at the top, five short candles standing round the crown in amber wax (no
+-- flames, wax only), and a long black lace veil falling from the back of the
+-- cap to the waist, its hem lined in stained violet.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	black = { 26, 25, 31 },
+	blackSoft = { 42, 40, 48 },
+	violet = { 76, 60, 100 },
+	wax = { 180, 156, 112 },
+	waxPale = { 204, 184, 142 },
+}
+
+-- A short candle standing on the cap's crown: a cylinder based at the cap's
+-- top, so the ring reads as wax columns, not studs.
+local function candle(
+	x: number,
+	z: number,
+	height: number,
+	color: { number },
+	turn: { number }?
+): ArmourLookTypes.ArmourPart
+	return {
+		on = "Head",
+		shape = "Cylinder",
+		size = { 0.14, height, 0.14 },
+		at = { x, 0.61 + height / 2, z },
+		turn = turn,
+		material = "SmoothPlastic",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FloodchoirVeil",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The cap: black cloth drawn over the crown of the head, caught into
+		-- a soft peak and a small point, no brim and no hard rim.
+		Kit.box("Head", { 1.34, 0.54, 1.36 }, { 0, 0.34, 0.02 }, "Fabric", c.black),
+		Kit.box("Head", { 0.80, 0.24, 0.88 }, { 0, 0.70, 0.04 }, "Fabric", c.blackSoft),
+		Kit.box("Head", { 0.16, 0.24, 0.16 }, { 0, 0.92, 0.04 }, "Fabric", c.blackSoft),
+		-- The five short candles ringing the peak, one pale, one leaning.
+		candle(0.58, 0, 0.30, c.wax),
+		candle(0.179, 0.552, 0.24, c.wax),
+		candle(-0.469, 0.341, 0.34, c.waxPale),
+		candle(-0.469, -0.341, 0.20, c.wax),
+		candle(0.179, -0.552, 0.28, c.wax, { 0, 0, 8 }),
+		-- Wax run down the cap's front and pooled at its edge.
+		Kit.box("Head", { 0.08, 0.30, 0.06 }, { 0.58, 0.40, -0.68 }, "SmoothPlastic", c.wax),
+		Kit.box("Head", { 0.26, 0.04, 0.20 }, { 0.48, 0.63, -0.30 }, "SmoothPlastic", c.wax),
+		-- The veil: two long falls of black lace from the back of the cap,
+		-- widening as they drop to the waist, the hem lined in violet.
+		Kit.box("Head", { 1.26, 0.85, 0.05 }, { 0, -0.20, 0.73 }, "Fabric", c.blackSoft, { -7, 0, 0 }),
+		Kit.box("Head", { 1.40, 0.75, 0.05 }, { 0, -0.95, 0.86 }, "Fabric", c.blackSoft, { -12, 0, 0 }),
+		Kit.box("Head", { 1.44, 0.20, 0.045 }, { 0, -1.235, 0.95 }, "SmoothPlastic", c.violet, { -12, 0, 0 }),
+	},
+}
+
+return look
