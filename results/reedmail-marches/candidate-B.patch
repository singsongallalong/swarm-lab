+--!strict
+-- The reedmail dress (the Reedmail set's chest): a fitted fen-green cuirass
+-- banded in bog iron with a pale bone trim, cinched low by a black belt with a
+-- bone buckle. Below it a short green peplum opens into a full tiered battle
+-- skirt of reed-straw plates, band over band and swinging from the thighs; the
+-- skirt carries on down the shins in the boots to a bone hem. The waist is the
+-- narrowest line; the skirt is the widest.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The fen's own palette: bog iron, fen green, reed straw, bone and black water.
+local IRON = { 80, 88, 94 }
+local IRON_DARK = { 46, 52, 58 }
+local REED = { 118, 106, 68 }
+local GREEN = { 60, 84, 62 }
+local GREEN_DEEP = { 48, 68, 50 }
+local BONE = { 166, 156, 130 }
+local BLACK_WATER = { 36, 38, 36 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailDress",
+	slot = "Chest",
+	parts = {
+		-- The green cuirass under the iron: two laced bands, a bone cord between.
+		Kit.box("UpperTorso", { 2.05, 1.64, 1.05 }, { 0, 0, 0 }, "Fabric", GREEN),
+		Kit.box("UpperTorso", { 2.12, 0.36, 1.14 }, { 0, 0.52, 0 }, "Metal", IRON),
+		Kit.box("UpperTorso", { 2.07, 0.36, 1.1 }, { 0, 0.09, 0 }, "Metal", IRON_DARK),
+		Kit.box("UpperTorso", { 2.1, 0.08, 1.16 }, { 0, 0.305, 0 }, "Fabric", BONE),
+		-- A pale V at the neckline, and the collar edged in bone over the green.
+		Kit.box("UpperTorso", { 0.06, 0.3, 0.04 }, { -0.14, 0.58, -0.585 }, "Fabric", BONE, { 0, 0, 28 }),
+		Kit.box("UpperTorso", { 0.06, 0.3, 0.04 }, { 0.14, 0.58, -0.585 }, "Fabric", BONE, { 0, 0, -28 }),
+		Kit.box("UpperTorso", { 1.26, 0.18, 1.08 }, { 0, 0.76, 0 }, "Fabric", GREEN),
+		Kit.box("UpperTorso", { 1.28, 0.05, 1.1 }, { 0, 0.855, 0 }, "Fabric", BONE),
+		-- The waist: a black belt with a bone buckle, a reed cord above it.
+		Kit.box("LowerTorso", { 2.03, 0.4, 1.03 }, { 0, 0, 0 }, "Metal", IRON),
+		Kit.box("LowerTorso", { 2.04, 0.16, 1.04 }, { 0, 0.03, 0 }, "Leather", BLACK_WATER),
+		Kit.box("LowerTorso", { 2.06, 0.05, 1.06 }, { 0, 0.135, 0 }, "Fabric", REED),
+		Kit.box("LowerTorso", { 0.26, 0.24, 0.08 }, { 0.04, 0.03, -0.55 }, "Metal", BONE, { 0, 0, 45 }),
+		-- A reed bow at the small of the back, its two loops unevenly tied.
+		Kit.box("LowerTorso", { 0.42, 0.18, 0.09 }, { -0.22, 0.05, 0.57 }, "Fabric", REED, { 0, 0, -22 }),
+		Kit.box("LowerTorso", { 0.36, 0.2, 0.09 }, { 0.2, 0.03, 0.57 }, "Fabric", REED, { 0, 0, 16 }),
+		Kit.box("LowerTorso", { 0.16, 0.16, 0.12 }, { 0, 0.04, 0.59 }, "Metal", BONE),
+		-- The upper sleeve, close to the arm, a reed cord at the elbow.
+		Kit.box("UpperArm", { 1.02, 1.2, 1.02 }, { 0, 0, 0 }, "Fabric", GREEN_DEEP),
+		Kit.box("UpperArm", { 1.04, 0.06, 1.04 }, { 0, -0.5, 0 }, "Fabric", REED),
+		-- The green peplum, the under-skirt the reed plates hang over.
+		Kit.box("UpperLeg", { 0.96, 0.46, 0.08 }, { 0.03, 0.52, -0.6 }, "Fabric", GREEN, { 12, 0, 0 }),
+		Kit.box("UpperLeg", { 0.96, 0.46, 0.08 }, { 0.03, 0.52, 0.6 }, "Fabric", GREEN, { -12, 0, 0 }),
+		Kit.box("UpperLeg", { 0.08, 0.46, 1.18 }, { 0.61, 0.52, 0 }, "Fabric", GREEN, { 0, 0, 12 }),
+		-- The skirt's thigh tier: three bands of reed-straw plate, each wider and
+		-- deeper than the one above, written on each thigh so both move as one.
+		Kit.box("UpperLeg", { 1.35, 0.42, 1.2 }, { 0, 0.37, 0 }, "Fabric", REED, nil, "Right"),
+		Kit.box("UpperLeg", { 1.35, 0.42, 1.2 }, { 0, 0.35, -0.03 }, "Fabric", REED, nil, "Left"),
+		Kit.box("UpperLeg", { 1.7, 0.42, 1.55 }, { 0, 0.01, 0 }, "Fabric", REED, nil, "Right"),
+		Kit.box("UpperLeg", { 1.7, 0.42, 1.55 }, { 0, -0.01, -0.03 }, "Fabric", REED, nil, "Left"),
+		Kit.box("UpperLeg", { 2.05, 0.44, 1.9 }, { 0, -0.35, 0 }, "Fabric", REED, nil, "Right"),
+		Kit.box("UpperLeg", { 2.05, 0.44, 1.9 }, { 0, -0.37, -0.03 }, "Fabric", REED, nil, "Left"),
+		-- Fen water soaked dark into the left of the skirt, low down.
+		Kit.box("UpperLeg", { 0.5, 0.5, 0.03 }, { 0.35, -0.05, -0.82 }, "Fabric", GREEN_DEEP, nil, "Left"),
+	},
+}
+
+return look
