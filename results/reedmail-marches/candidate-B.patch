+		Kit.box("Head", { 1.36, 0.04, 0.1 }, { 0, 0.155, -0.64 }, "Metal", IRON_EDGE),
+		Kit.box("Head", { 0.2, 0.2, 0.08 }, { 0.12, 0.01, -0.67 }, "Fabric", BONE, { 0, 0, 45 }),
+		-- The low comb along the crown, and the bone socket of the spike.
+		Kit.box("Head", { 0.12, 0.14, 1.05 }, { 0, 0.72, 0.02 }, "Metal", IRON),
+		Kit.box("Head", { 0.3, 0.14, 0.3 }, { 0, 0.68, 0.16 }, "Metal", BONE),
+		-- A green veil at the nape and down either side of the face.
+		Kit.box("Head", { 1.16, 0.62, 0.06 }, { 0, -0.16, 0.66 }, "Fabric", GREEN, { 6, 0, 0 }),
+		Kit.box("Head", { 0.06, 0.42, 0.62 }, { 0.6, -0.12, 0.04 }, "Fabric", GREEN),
+		Kit.box("Head", { 0.06, 0.42, 0.62 }, { -0.6, -0.12, 0.04 }, "Fabric", GREEN),
+		-- The single reed spike, its fall down the back and its bone tip.
+		Kit.box("Head", { 0.22, 0.95, 0.14 }, { 0, 0.95, 0.3 }, "Fabric", REED, { 16, 0, 0 }),
+		Kit.box("Head", { 0.18, 0.7, 0.1 }, { 0, 0.3, 0.82 }, "Fabric", REED, { -30, 0, 0 }),
+		Kit.box("Head", { 0.15, 0.16, 0.11 }, { 0, 1.44, 0.445 }, "Metal", BONE, { 16, 0, 0 }),
+		-- One reed tassel to one side.
+		Kit.box("Head", { 0.07, 0.36, 0.07 }, { 0.5, -0.08, 0.71 }, "Fabric", REED),
+	},
+}
+
+return look
