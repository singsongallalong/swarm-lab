+		-- The hem panels, longer at the front and back than at the sides, edged in
+		-- bone and hung clear of the boot below.
+		Kit.box("LowerLeg", { 2.35, 0.2, 0.1 }, { 0.675, -0.46, -0.66 }, "Fabric", fen.blackWater),
+		Kit.box("LowerLeg", { 2.35, 0.2, 0.1 }, { 0.675, -0.46, 0.66 }, "Fabric", fen.blackWater),
+		Kit.box("LowerLeg", { 2.35, 0.06, 0.04 }, { 0.675, -0.54, -0.72 }, "Fabric", fen.bone),
+		Kit.box("LowerLeg", { 2.35, 0.06, 0.04 }, { 0.675, -0.54, 0.72 }, "Fabric", fen.bone),
+		-- The boot below: an iron cuff over the black boot, to the ankle.
+		Kit.box("LowerLeg", { 1.12, 0.12, 1.16 }, { 0, -0.46, 0 }, "Metal", fen.bogIron),
+		Kit.box("LowerLeg", { 1.08, 0.16, 1.1 }, { 0, -0.56, 0 }, "Leather", fen.blackWater),
+		-- The foot, black water under a bog-iron toe.
+		Kit.box("Foot", { 1.1, 0.38, 1.16 }, { 0, 0, -0.02 }, "Leather", fen.blackWater),
+		Kit.box("Foot", { 0.92, 0.16, 0.3 }, { 0, 0.04, -0.64 }, "Metal", fen.bogIron),
+	},
+}
+
+return look
