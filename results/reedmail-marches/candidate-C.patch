+--!strict
+-- The reedmail hood (the Reedmail set's helm, the Fen): a soft hood of woven
+-- reed straw drawn close to the head, bound at the brow with a fen-green
+-- fillet and lined in green at the face, its cheeks framed green. A spray of
+-- pale reed stalks rises from the crown and a willow-leaf brooch of scraped
+-- iron pins the hood at the jaw. Narrow at the ear and tall above it, so the
+-- headpiece reads from the high camera as a headdress, not a helmet.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local fen = {
+	bogIronWorn = { 162, 170, 160 },
+	green = { 78, 104, 76 },
+	greenDark = { 52, 72, 54 },
+	straw = { 164, 146, 94 },
+	strawPale = { 188, 170, 112 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The hood: a close straw crown over the brow, a longer fall down the back.
+		Kit.box("Head", { 1.3, 0.62, 1.3 }, { 0, 0.32, 0.02 }, "Fabric", fen.straw),
+		Kit.box("Head", { 1.22, 0.66, 0.5 }, { 0, -0.26, 0.4 }, "Fabric", fen.straw),
+		-- The green fillet at the brow, and the green lining of the face opening.
+		Kit.box("Head", { 1.36, 0.14, 1.36 }, { 0, 0.04, 0.02 }, "Fabric", fen.green),
+		Kit.box("Head", { 1.14, 0.1, 0.08 }, { 0, -0.02, -0.62 }, "Fabric", fen.greenDark),
+		-- The hood's cheeks, framing the face, a little off on the left.
+		Kit.box("Head", { 0.12, 0.7, 0.16 }, { -0.6, -0.24, -0.38 }, "Fabric", fen.green, { 0, 0, -6 }),
+		Kit.box("Head", { 0.12, 0.7, 0.16 }, { 0.6, -0.24, -0.38 }, "Fabric", fen.green, { 0, 0, 7 }),
+		-- The reed spray: a green knot and three pale stalks rising up and back.
+		Kit.box("Head", { 0.26, 0.16, 0.26 }, { 0, 0.64, 0.3 }, "Fabric", fen.greenDark),
+		Kit.box("Head", { 0.07, 0.75, 0.07 }, { -0.16, 1.0, 0.28 }, "Fabric", fen.strawPale, { -10, 0, -8 }),
+		Kit.box("Head", { 0.07, 0.88, 0.07 }, { 0.02, 1.06, 0.28 }, "Fabric", fen.strawPale, { -12, 0, 2 }),
+		Kit.box("Head", { 0.07, 0.64, 0.07 }, { 0.19, 0.94, 0.28 }, "Fabric", fen.strawPale, { -8, 0, 9 }),
+		-- The willow-leaf brooch, pinning the hood at the right jaw.
+		Kit.box("Head", { 0.09, 0.3, 0.06 }, { 0.64, -0.44, -0.5 }, "Metal", fen.bogIronWorn, { 0, 0, 26 }),
+		Kit.box("Head", { 0.07, 0.18, 0.05 }, { 0.58, -0.52, -0.5 }, "Metal", fen.bogIronWorn, { 0, 0, -30 }),
+		Kit.box("Head", { 0.06, 0.06, 0.09 }, { 0.62, -0.38, -0.52 }, "Fabric", fen.straw),
+	},
+}
+
+return look
