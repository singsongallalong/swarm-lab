+--!strict
+-- The reedmail gown's bodice and upper skirt (the Reedmail set's chest, the
+-- Fen): a fitted fen-green leather corset under a bog-iron stomacher laced
+-- with reed cord, a sweetheart neckline inside a short standing collar, and a
+-- black-water belt cinching the waist over a green bustle. The upper sleeves
+-- are no wider than the arm itself, so nothing stands past the shoulder line.
+-- Below the belt the skirt hangs from each thigh in banded tiers that step a
+-- little wider at each fall, straw alternating with bog iron, so the fen reads
+-- in the plates rather than in one haystack tone.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local fen = {
+	bogIron = { 100, 110, 110 },
+	bogIronWorn = { 162, 170, 160 },
+	green = { 78, 104, 76 },
+	greenDark = { 52, 72, 54 },
+	straw = { 164, 146, 94 },
+	blackWater = { 38, 46, 44 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The corset, and the iron stomacher laced down the front.
+			Kit.box("UpperTorso", { 2.08, 1.62, 1.08 }, { 0, 0, 0 }, "Leather", fen.green),
+			Kit.box("UpperTorso", { 0.96, 1.48, 0.1 }, { 0, -0.02, -0.56 }, "Metal", fen.bogIron),
+			-- The collar, its scraped iron edge, and a sweetheart neckline below it.
+			Kit.box("UpperTorso", { 1.12, 0.22, 1.12 }, { 0, 0.76, 0 }, "Fabric", fen.greenDark),
+			Kit.box("UpperTorso", { 1.16, 0.05, 1.16 }, { 0, 0.89, 0 }, "Metal", fen.bogIronWorn),
+			Kit.box("UpperTorso", { 0.56, 0.08, 0.06 }, { -0.3, 0.56, -0.65 }, "Fabric", fen.straw, { 0, 0, 15 }),
+			Kit.box("UpperTorso", { 0.56, 0.08, 0.06 }, { 0.3, 0.56, -0.65 }, "Fabric", fen.straw, { 0, 0, -15 }),
+			-- The corset's point, dipping over the belt.
+			Kit.box("UpperTorso", { 0.44, 0.1, 0.1 }, { -0.1, -0.66, -0.62 }, "Leather", fen.green, { 0, 0, -18 }),
+			Kit.box("UpperTorso", { 0.44, 0.1, 0.1 }, { 0.1, -0.66, -0.62 }, "Leather", fen.green, { 0, 0, 18 }),
+		},
+		{
+			Kit.box("UpperTorso", { 0.74, 0.07, 0.06 }, { 0, 0.34, -0.63 }, "Fabric", fen.straw, { 0, 0, 24 }),
+			Kit.box("UpperTorso", { 0.74, 0.07, 0.06 }, { 0, 0.12, -0.63 }, "Fabric", fen.straw, { 0, 0, -24 }),
+			Kit.box("UpperTorso", { 0.74, 0.07, 0.06 }, { 0, -0.12, -0.63 }, "Fabric", fen.straw, { 0, 0, 24 }),
+			Kit.box("UpperTorso", { 0.74, 0.07, 0.06 }, { 0, -0.34, -0.63 }, "Fabric", fen.straw, { 0, 0, -24 }),
+		},
+		{
+			-- The waist: a black-water belt, a reed cord over it, an off-centre buckle.
+			Kit.box("LowerTorso", { 2.14, 0.4, 1.14 }, { 0, 0, 0 }, "Leather", fen.blackWater),
+			Kit.box("LowerTorso", { 2.18, 0.08, 1.18 }, { 0, -0.1, 0 }, "Fabric", fen.straw),
+			Kit.box("LowerTorso", { 0.22, 0.22, 0.1 }, { 0.4, -0.04, -0.62 }, "Metal", fen.bogIronWorn),
+			-- A small bustle behind, high on the hips, tied with reed cord.
+			Kit.box("LowerTorso", { 1.4, 0.3, 0.3 }, { 0, 0.02, 0.72 }, "Leather", fen.green),
+			Kit.box("LowerTorso", { 1.44, 0.06, 0.1 }, { 0, -0.04, 0.86 }, "Fabric", fen.straw),
+		},
+		{
+			-- The upper arm stays at the arm's own width; nothing stands past it.
+			Kit.box("UpperArm", { 1.04, 1.2, 1.04 }, { 0, 0, 0 }, "Leather", fen.green),
+		},
+		{
+			-- The upper skirt: four banded tiers hung from each thigh, stepping
+			-- out a little at each fall, straw and bog iron by turns.
+			Kit.box("UpperLeg", { 1.1, 0.3, 1.2 }, { 0.05, 0.48, 0 }, "Fabric", fen.straw),
+			Kit.box("UpperLeg", { 1.35, 0.3, 1.22 }, { 0.175, 0.18, 0 }, "Metal", fen.bogIron),
+			Kit.box("UpperLeg", { 1.6, 0.3, 1.24 }, { 0.3, -0.12, 0 }, "Fabric", fen.straw),
+			Kit.box("UpperLeg", { 1.85, 0.31, 1.26 }, { 0.425, -0.425, 0 }, "Metal", fen.bogIron),
+			-- The second and third tiers hang a little lower at the front and back
+			-- than at the sides, so their edges fall instead of step.
+			Kit.box("UpperLeg", { 1.35, 0.2, 0.06 }, { 0.175, -0.01, -0.63 }, "Metal", fen.bogIron, { 24, 0, 0 }),
+			Kit.box("UpperLeg", { 1.35, 0.2, 0.06 }, { 0.175, -0.01, 0.63 }, "Metal", fen.bogIron, { -24, 0, 0 }),
+			Kit.box("UpperLeg", { 1.6, 0.2, 0.06 }, { 0.3, -0.31, -0.64 }, "Fabric", fen.straw, { 24, 0, 0 }),
+			Kit.box("UpperLeg", { 1.6, 0.2, 0.06 }, { 0.3, -0.31, 0.64 }, "Fabric", fen.straw, { -24, 0, 0 }),
+		},
+		-- Iron studs along the lamellar tier.
+		Kit.studs("UpperLeg", { -0.25, 0.11, 0.47 }, { 0.18 }, -0.64, fen.bogIronWorn),
+	}),
+}
+
+return look
