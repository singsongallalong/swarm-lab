+	slot = "Boots",
+	parts = {
+		-- The skirt's lower tiers on each shin: straw, then the wet hem.
+		Kit.box("LowerLeg", { 2.1, 0.6, 1.28 }, { 0.55, 0.32, 0 }, "Fabric", fen.straw),
+		Kit.box("LowerLeg", { 2.1, 0.2, 0.06 }, { 0.55, -0.02, -0.66 }, "Fabric", fen.straw, { 24, 0, 0 }),
+		Kit.box("LowerLeg", { 2.1, 0.2, 0.06 }, { 0.55, -0.02, 0.66 }, "Fabric", fen.straw, { -24, 0, 0 }),
