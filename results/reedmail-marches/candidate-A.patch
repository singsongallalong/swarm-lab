@@ -0,0 +1,95 @@
+--!strict
+-- The eel-scale dress (zone armour, the Reedmail set's chest): a dark fitted
+-- bodice of eel scale over black water, laced up the front and back with straw
+-- and banded at the bust, a pale straw sash at the waist over an eel-scale
+-- belt with a bog-iron clasp, a stepped bustle behind, and the upper skirt of
+-- two fen-green scale rows hung from the thighs so the legs stride inside it.
+-- Each row steps wider and deeper, carries a pale straw edge, and the boots
+-- carry the rows on below the knee.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The fen's scale: lifted to a mid fen green so the skirt reads at night and
+-- from the high camera, with a darker row between and pale straw edging. The
+-- cuirass stays dark, so the pale waist band and the flare below it read.
+local fen = { 80, 100, 84 }
+local fenDark = { 58, 78, 66 }
+local eel = { 52, 70, 60 }
+local eelDark = { 36, 50, 42 }
+local eelPale = { 104, 124, 104 }
+local straw = { 116, 110, 82 }
+
+-- One row of the skirt: a front plate, a back plate and the outer plate that
+-- joins them, set out to `width` and `depth`, and a pale edge along the row's
+-- top. Each row below steps wider and deeper, so the skirt flares from the
+-- waist to the hem; the front and back plates meet their twins at the centre
+-- line, so standing the two legs make one full skirt. Hung from the thighs so
+-- it strides with the legs.
+local function row(
+	width: number,
+	depth: number,
+	top: number,
+	bottom: number,
+	material: string,
+	color: { number },
+	edge: { number }
+): { ArmourLookTypes.ArmourPart }
+	local height = top - bottom
+	local y = (top + bottom) / 2
+	-- A thigh's frame is centred on the leg, half a stud from the body's
+	-- centre line; the plates are set an inner edge on that line.
+	return {
+		Kit.box("UpperLeg", { width, height, 0.07 }, { width / 2 - 0.5, y, -depth }, material, color),
+		Kit.box("UpperLeg", { width, height, 0.07 }, { width / 2 - 0.5, y, depth }, material, color),
+		Kit.box("UpperLeg", { 0.07, height, depth * 2 }, { width - 0.5, y, 0 }, material, color),
+		-- The pale edge stands a little proud of the row's top, so it reads as
+		-- a line between the rows and as a lit ledge from above.
+		Kit.box("UpperLeg", { width, 0.08, depth * 2 }, { width / 2 - 0.5, top + 0.005, 0 }, "Fabric", edge),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The dark cuirass, a scale bust plate, and two scale rows.
+			Kit.box("UpperTorso", { 2.02, 1.62, 1.02 }, { 0, 0, 0 }, "Leather", eelDark),
+			Kit.box("UpperTorso", { 1.98, 0.5, 1.06 }, { 0, 0.38, 0 }, "Leather", eel),
+			Kit.box("UpperTorso", { 2.04, 0.14, 1.06 }, { 0, 0.08, 0 }, "Leather", eelPale),
+			Kit.box("UpperTorso", { 2.05, 0.12, 1.07 }, { 0, -0.12, 0 }, "Leather", eel),
+			-- The courtly standing collar, and a pale scale drop at the throat.
+			Kit.box("UpperTorso", { 1.4, 0.2, 1.4 }, { 0, 0.8, 0 }, "Fabric", c.reed),
+			Kit.box("UpperTorso", { 0.16, 0.2, 0.05 }, { 0, 0.68, -0.72 }, "Leather", eelPale),
+			-- The straw lacing crossed over the stomacher, front and back, and
+			-- knotted where it crosses at the front.
+			Kit.box("UpperTorso", { 0.06, 1.05, 0.06 }, { 0, -0.06, -0.55 }, "Fabric", straw, { 0, 0, 28 }),
+			Kit.box("UpperTorso", { 0.06, 1.05, 0.06 }, { 0, -0.06, -0.55 }, "Fabric", straw, { 0, 0, -28 }),
+			Kit.box("UpperTorso", { 0.1, 0.1, 0.07 }, { 0, -0.06, -0.58 }, "Fabric", c.reed),
+			Kit.box("UpperTorso", { 0.06, 1.05, 0.06 }, { 0, -0.06, 0.55 }, "Fabric", straw, { 0, 0, 28 }),
+			Kit.box("UpperTorso", { 0.06, 1.05, 0.06 }, { 0, -0.06, 0.55 }, "Fabric", straw, { 0, 0, -28 }),
+			-- The waist: a dark cincher, a pale straw sash over an eel-scale
+			-- belt, a bog-iron clasp and a straw point hanging at the front.
+			Kit.box("LowerTorso", { 2.02, 0.4, 1.02 }, { 0, 0, 0 }, "Leather", eelDark),
+			Kit.box("LowerTorso", { 2.04, 0.2, 1.06 }, { 0, 0.1, 0 }, "Fabric", straw),
+			Kit.box("LowerTorso", { 2.04, 0.1, 1.06 }, { 0, -0.06, 0 }, "Leather", eel),
+			Kit.box("LowerTorso", { 0.22, 0.22, 0.08 }, { 0, 0.08, -0.55 }, "Metal", c.ironWorn),
+			Kit.box("LowerTorso", { 0.28, 0.28, 0.05 }, { 0, -0.13, -0.63 }, "Fabric", straw, { 0, 0, 45 }),
+			-- The bustle, in two steps, standing out behind the sash.
+			Kit.box("LowerTorso", { 1.66, 0.26, 0.3 }, { 0, 0.07, 0.68 }, "Fabric", eel),
+			Kit.box("LowerTorso", { 1.9, 0.2, 0.36 }, { 0, -0.09, 0.64 }, "Fabric", eelDark),
+			-- The upper sleeves stay close to the arm and cap its shoulder,
+			-- tied with a reed cord.
+			Kit.box("UpperArm", { 1.02, 1.2, 1.02 }, { 0, 0, 0 }, "Fabric", eelDark),
+			Kit.box("UpperArm", { 1.04, 0.1, 1.04 }, { 0, 0.54, 0 }, "Fabric", c.reed),
+		},
+		-- Two rows of fen-green scale on each thigh, stepping wider and deeper
+		-- as they fall, each edged in straw.
+		row(1.28, 0.56, 0.75, 0.03, "Leather", fenDark, straw),
+		row(1.66, 0.76, 0.12, -0.54, "Leather", fen, straw),
+	}),
+}
+
+return look
