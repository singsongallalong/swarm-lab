+-- The eel-scale sleeves (zone armour, the Reedmail set's gloves): the gown's
+-- forearm, a fen-green bell below the elbow edged in straw and drawn in to a
+-- straw cuff at the wrist, with a pale scale plate down the outside and a
+-- dark wet glove. The sleeve stays close to the arm, so the shoulder line is
+-- the arm's own; the volume is all at the forearm.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The fen's scale, as on the dress, with the pale straw edging; the cuirass
+-- and the sleeve's upper part (on the dress) stay dark.
+local fen = { 80, 100, 84 }
+local fenDark = { 58, 78, 66 }
+local eelDark = { 36, 50, 42 }
+local eelPale = { 104, 124, 104 }
+local straw = { 116, 110, 82 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The fen-green bell at the elbow, its pale straw edge, and the sleeve
+		-- drawn in dark towards the wrist.
+		Kit.box("LowerArm", { 1.16, 0.44, 1.16 }, { 0, 0.31, 0 }, "Fabric", fen),
+		Kit.box("LowerArm", { 1.18, 0.1, 1.18 }, { 0, 0.12, 0 }, "Fabric", straw),
+		Kit.box("LowerArm", { 1.06, 0.68, 1.06 }, { 0, -0.16, 0 }, "Fabric", eelDark),
+		-- The straw cuff at the wrist and the scale point hanging from it.
+		Kit.box("LowerArm", { 1.08, 0.12, 1.08 }, { 0, -0.44, 0 }, "Fabric", straw),
+		Kit.box("LowerArm", { 0.12, 0.26, 0.06 }, { 0.42, -0.46, -0.58 }, "Leather", fenDark, { 0, 0, -8 }),
+		-- A pale moonlit scale plate down the outside of the forearm.
+		Kit.box("LowerArm", { 0.07, 0.52, 0.34 }, { 0.54, 0.02, 0 }, "Leather", eelPale, { 0, 0, 3 }),
+		-- The dark wet glove.
+		Kit.box("Hand", { 1.06, 0.34, 1.06 }, { 0, 0, 0 }, "Leather", c.bogWet),
+	},
+}
+
+return look
