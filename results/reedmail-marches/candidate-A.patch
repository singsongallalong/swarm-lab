+--!strict
+-- The eel-scale hem (zone armour, the Reedmail set's boots): the gown's lower
+-- skirt, two more fen-green rows carried on the shins from below the knee and
+-- stepping wider and deeper than the dress's. The bottom row is the hem, cut
+-- back to just past the row above and lifted to the boot tops, with a pale
+-- straw edge on every row and a straw band along its own bottom; the black
+-- boots show beneath it.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The fen's scale, as on the dress, with the pale straw edging; the boots
+-- beneath are black water.
+local fen = { 80, 100, 84 }
+local fenDark = { 58, 78, 66 }
+local straw = { 116, 110, 82 }
+
+-- One row of the skirt: a front plate, a back plate and the outer plate that
+-- joins them, set out to `width` and `depth`, and a pale edge along the row's
+-- top. Each row steps wider and deeper than the one above it, and each leg's
+-- plates meet their twins at the centre line, so standing the two legs make
+-- one full skirt.
+local function row(
+	width: number,
+	depth: number,
+	top: number,
+	bottom: number,
+	material: string,
+	color: { number },
+	edge: { number }
+): { ArmourLookTypes.ArmourPart }
+	local height = top - bottom
+	local y = (top + bottom) / 2
+	-- A shin's frame is centred on the leg, half a stud from the body's centre
+	-- line; the plates are set an inner edge on that line.
+	return {
+		Kit.box("LowerLeg", { width, height, 0.07 }, { width / 2 - 0.5, y, -depth }, material, color),
+		Kit.box("LowerLeg", { width, height, 0.07 }, { width / 2 - 0.5, y, depth }, material, color),
+		Kit.box("LowerLeg", { 0.07, height, depth * 2 }, { width - 0.5, y, 0 }, material, color),
+		-- The pale edge stands a little proud of the row's top, so it reads as
+		-- a line between the rows and as a lit ledge from above.
+		Kit.box("LowerLeg", { width, 0.08, depth * 2 }, { width / 2 - 0.5, top + 0.005, 0 }, "Fabric", edge),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailHem",
+	slot = "Boots",
+	parts = Kit.join({
+		-- The two rows below the knee, both deeper than the dress's, the hem
+		-- row just past the row above and lifted clear of the ground.
+		row(2.02, 0.96, 0.64, -0.06, "Leather", fenDark, straw),
+		row(2.28, 1.14, -0.02, -0.3, "Leather", fen, straw),
+		{
+			-- The straw band round the hem's bottom edge, front, back and side.
+			Kit.box("LowerLeg", { 2.36, 0.12, 0.06 }, { 0.68, -0.28, -1.19 }, "Fabric", straw),
+			Kit.box("LowerLeg", { 2.36, 0.12, 0.06 }, { 0.68, -0.28, 1.19 }, "Fabric", straw),
+			Kit.box("LowerLeg", { 0.05, 0.12, 2.36 }, { 1.84, -0.28, 0 }, "Fabric", straw),
+			-- The tall black-water boot shaft showing below the lifted hem, and
+			-- the shoe beneath it.
+			Kit.box("LowerLeg", { 1.06, 0.4, 1.06 }, { 0, -0.4, 0 }, "Leather", c.bogWet),
+			Kit.box("Foot", { 1.08, 0.34, 1.16 }, { 0, 0.04, -0.06 }, "Leather", c.bogWet),
+		},
+	}),
+}
+
+return look
