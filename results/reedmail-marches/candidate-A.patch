+--!strict
+-- The reed circlet (zone armour, the Reedmail set's helm): a bog-iron band
+-- worn high on the brow with a scraped, moonlit rim and a reed cord bound
+-- under it, a green eel-scale drop at the forehead, a scale drop at each
+-- temple, a short scale veil down the nape and a fan of three reed plumes
+-- swept up and back. It leaves the hair loose: a circlet, not a helm.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The fen's scale, lifted so the veil reads apart from the dark cuirass, and a
+-- pale moonlit edge; the plumes and the veil's hem take the reed straw.
+local fenDark = { 58, 78, 66 }
+local eelDark = { 36, 50, 42 }
+local eelPale = { 104, 124, 104 }
+local straw = { 116, 110, 82 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ReedmailHelm",
+	slot = "Helm",
+	parts = {
+		-- The band, high on the brow, and its scraped edge catching the moon.
+		Kit.box("Head", { 1.3, 0.1, 1.3 }, { 0, 0.32, 0 }, "Metal", c.ironDark),
+		Kit.box("Head", { 1.32, 0.035, 1.32 }, { 0, 0.385, 0 }, "Metal", c.ironWorn),
+		-- A reed cord bound under the band.
+		Kit.box("Head", { 1.33, 0.05, 1.33 }, { 0, 0.24, 0 }, "Fabric", c.reed),
+		-- The eel-scale drop at the brow, hung from a pale bone bead.
+		Kit.box("Head", { 0.24, 0.3, 0.1 }, { 0, 0.14, -0.66 }, "Leather", eelPale),
+		Kit.box("Head", { 0.12, 0.08, 0.08 }, { 0, 0.31, -0.68 }, "Metal", c.fenBone),
+		-- One scale drop at each temple, the left one longer.
+		Kit.box("Head", { 0.05, 0.24, 0.07 }, { 0.62, 0.19, -0.22 }, "Leather", eelPale),
+		Kit.box("Head", { 0.05, 0.34, 0.07 }, { -0.62, 0.14, -0.22 }, "Leather", eelDark),
+		-- A scale veil down the nape, hemmed in straw.
+		Kit.box("Head", { 0.94, 0.82, 0.06 }, { 0, -0.12, 0.64 }, "Leather", fenDark),
+		Kit.box("Head", { 0.94, 0.06, 0.06 }, { 0, -0.52, 0.64 }, "Fabric", straw),
+		-- The plumes: three reed blades bound together at the back of the band
+		-- and fanned up and back, so the height is at the head and never the
+		-- ears. They stand close to upright and fan wide, so they still read
+		-- from the high camera rather than foreshortening to nothing.
+		Kit.box("Head", { 0.26, 0.2, 0.22 }, { 0, 0.45, 0.66 }, "Fabric", c.reed, { 12, 0, 0 }),
+		Kit.box("Head", { 0.22, 0.95, 0.12 }, { 0, 0.81, 0.8 }, "Fabric", straw, { 12, 0, 0 }),
+		Kit.box("Head", { 0.16, 0.78, 0.1 }, { 0.24, 0.74, 0.8 }, "Fabric", straw, { 18, 0, -22 }),
+		Kit.box("Head", { 0.14, 0.68, 0.1 }, { -0.24, 0.69, 0.78 }, "Fabric", straw, { 20, 0, 24 }),
+		-- A bog-iron tip on the tallest plume, scraped bright.
+		Kit.box("Head", { 0.14, 0.18, 0.1 }, { 0, 1.22, 0.89 }, "Metal", c.ironWorn, { 12, 0, 0 }),
+	},
+}
+
+return look
