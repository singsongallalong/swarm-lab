diff --git a/src/shared/data/armourLooks/BasaltplateCuirass.luau b/src/shared/data/armourLooks/BasaltplateCuirass.luau
new file mode 100644
index 0000000..a6fc081
--- /dev/null
+++ b/src/shared/data/armourLooks/BasaltplateCuirass.luau
@@ -0,0 +1,76 @@
+--!strict
+-- The basaltplate cuirass (zone armour, the Basaltplate set): the forge-priests'
+-- chest, slabs of Aor'lan basalt over black iron. One broad raised breast slab
+-- above a magma seam, a back slab split the same way, a heavy iron collar and
+-- belt with an off-centre buckle, crag pauldrons on every shoulder with a
+-- stepped basalt shard broken off the right, basalt tassets hanging from the
+-- thighs, and a censer hanging from the collar on a short rusted chain. Broad,
+-- black and red-seamed from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local basalt = { 46, 46, 53 }
+local basaltDark = { 31, 31, 38 }
+local basaltLight = { 66, 66, 75 }
+local magma = { 112, 44, 34 }
+local magmaHot = { 128, 52, 40 }
+
+-- The censer is the one round piece in the set: a ball thurible.
+local function ball(
+	on: ArmourLookTypes.BodyPart,
+	size: { number },
+	at: { number },
+	material: string,
+	color: { number }
+): ArmourLookTypes.ArmourPart
+	return { on = on, shape = "Ball", size = size, at = at, material = material, color = color }
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateCuirass",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Broken basalt tassets, hung from the thighs so they swing with them.
+		Kit.flaps(0.55, "Basalt", basaltDark),
+		{
+			-- The cuirass: a dark core under one broad raised breast slab; the
+			-- magma seam runs in the step beneath it.
+			Kit.box("UpperTorso", { 2.08, 1.62, 1.08 }, { 0, 0, 0 }, "Basalt", basalt),
+			Kit.box("UpperTorso", { 1.96, 0.6, 0.1 }, { 0, 0.34, -0.58 }, "Basalt", basaltLight),
+			Kit.box("UpperTorso", { 1.9, 0.18, 0.12 }, { 0, -0.05, -0.58 }, "Metal", magma),
+			-- The same split across the back.
+			Kit.box("UpperTorso", { 1.72, 0.72, 0.1 }, { 0, 0.28, 0.58 }, "Basalt", basaltLight),
+			Kit.box("UpperTorso", { 1.62, 0.14, 0.11 }, { 0, -0.14, 0.62 }, "Metal", magma),
+			-- Iron at the throat and the waist, with a scraped buckle off centre.
+			Kit.box("UpperTorso", { 1.46, 0.2, 1.46 }, { 0, 0.74, 0 }, "Metal", c.iron),
+			Kit.box("LowerTorso", { 2.1, 0.46, 1.1 }, { 0, 0, 0 }, "Basalt", basalt),
+			Kit.box("LowerTorso", { 2.14, 0.2, 1.14 }, { 0, 0.1, 0 }, "Metal", c.ironDark),
+			Kit.box("LowerTorso", { 2.16, 0.07, 1.16 }, { 0, -0.02, 0 }, "Metal", magma),
+			Kit.box("LowerTorso", { 0.32, 0.26, 0.12 }, { 0.24, 0.1, -0.6 }, "Metal", c.ironWorn),
+			-- The censer: two links of chain, one of them rusted, and the thurible.
+			Kit.box("UpperTorso", { 0.1, 0.2, 0.1 }, { 0, 0.6, -0.78 }, "Metal", c.iron, { 0, 0, 18 }),
+			Kit.box("UpperTorso", { 0.08, 0.16, 0.08 }, { 0, 0.44, -0.8 }, "Metal", c.rust, { 0, 0, -16 }),
+			ball("UpperTorso", { 0.4, 0.4, 0.4 }, { 0, 0.2, -0.82 }, "Metal", c.iron),
+			Kit.box("UpperTorso", { 0.26, 0.07, 0.12 }, { 0, 0.2, -1.0 }, "Metal", magmaHot),
+			-- Shoulders: a broad crag slab, a red seam under it, the arm sleeved
+			-- in basalt. The right pauldron carries a stepped basalt shard.
+			Kit.box("UpperArm", { 1.44, 0.22, 1.44 }, { 0.05, 0.64, 0 }, "Basalt", basaltLight, { 0, 0, -8 }),
+			Kit.box("UpperArm", { 1.38, 0.16, 1.38 }, { 0.05, 0.53, 0 }, "Metal", magma, { 0, 0, -8 }),
+			Kit.box("UpperArm", { 1.1, 1.16, 1.1 }, { 0, -0.06, 0 }, "Basalt", basalt),
+			Kit.wedge("UpperArm", { 0.72, 0.4, 1.0 }, { 0.46, 0.78, -0.06 }, "Basalt", basalt, { 0, 0, -24 }, "Right"),
+			Kit.wedge(
+				"UpperArm",
+				{ 0.44, 0.34, 0.7 },
+				{ 0.6, 0.95, -0.16 },
+				"Basalt",
+				basaltLight,
+				{ 0, 0, -38 },
+				"Right"
+			),
+		},
+	}),
+}
+
+return look
