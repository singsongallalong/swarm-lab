+--!strict
+-- The basaltplate hood (zone armour, the Basaltplate set): the forge-priests'
+-- helm cut from Aor'lan's own body. A hooded cowl of dark basalt slabs with a
+-- peak swept back off the crown, a thin magma seam where the crown slab meets
+-- the bowl, and a deep black face behind an iron brow, nasal and mask. The
+-- peak gives the head its outline from the high camera; the red eye-slit and
+-- crown seam are the set's only colour up there.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local basalt = { 46, 46, 53 }
+local basaltDark = { 31, 31, 38 }
+local magma = { 112, 44, 34 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateHood",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl of the hood, and the tall peak drawn back over it.
+		Kit.box("Head", { 1.46, 1.2, 1.46 }, { 0, 0.02, 0 }, "Basalt", basalt),
+		Kit.wedge("Head", { 1.2, 0.68, 1.34 }, { 0, 0.86, -0.04 }, "Basalt", basalt),
+		-- The seam between them: a broad red ring at the crown, seen from above.
+		Kit.box("Head", { 1.48, 0.12, 1.48 }, { 0, 0.58, 0 }, "Metal", magma),
+		-- Iron brow-band and the moonlit cap on the peak's tip.
+		Kit.box("Head", { 1.5, 0.18, 1.5 }, { 0, 0.4, 0 }, "Metal", c.iron),
+		Kit.box("Head", { 0.24, 0.12, 0.28 }, { 0, 1.21, 0.56 }, "Metal", c.ironWorn),
+		-- A deep dark face, an iron mask below, a magma slit at the eye.
+		Kit.box("Head", { 1.0, 0.8, 0.1 }, { 0, -0.1, -0.72 }, "Basalt", basaltDark),
+		Kit.box("Head", { 1.12, 0.46, 0.12 }, { 0, -0.38, -0.77 }, "Metal", c.ironDark),
+		Kit.box("Head", { 0.66, 0.12, 0.1 }, { 0, -0.03, -0.8 }, "Metal", magma),
+		Kit.box("Head", { 0.1, 0.52, 0.08 }, { 0, -0.1, -0.81 }, "Metal", c.ironWorn),
+		-- One cheek plate; the other side was lost to the mountain.
+		Kit.box("Head", { 0.18, 0.7, 0.38 }, { 0.56, -0.2, -0.55 }, "Metal", c.iron),
+		-- The mantle at the nape, hanging lower on the left.
+		Kit.box("Head", { 1.34, 0.72, 0.44 }, { 0, -0.36, 0.55 }, "Basalt", basaltDark, { 0, 0, -4 }),
+	},
+}
+
+return look
