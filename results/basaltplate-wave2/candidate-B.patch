+--!strict
+-- The basalt greaves (Basaltplate set): black basalt shins under a thick pale
+-- slab cuff at the knee, with a raised shin plate and a magma seam burning
+-- below the cuff. The foot is a black iron sabaton with a bright, jutting toe.
+-- The thick cuff ties the boots to the set's stacked basalt slabs and gives
+-- them a heavy, flat silhouette from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local basalt = { 42, 42, 50 }
+local basaltFace = { 58, 59, 70 }
+local magma = { 124, 52, 40 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateBoots",
+	slot = "Boots",
+	parts = {
+		Kit.box("LowerLeg", { 1.12, 1.16, 1.12 }, { 0, -0.02, 0 }, "Slate", basalt),
+		Kit.box("LowerLeg", { 1.26, 0.24, 1.26 }, { 0, 0.54, 0 }, "Slate", basaltFace),
+		Kit.box("LowerLeg", { 0.64, 0.78, 0.10 }, { 0, -0.10, -0.60 }, "Slate", basaltFace, { -6, 0, 0 }),
+		Kit.box("LowerLeg", { 1.18, 0.05, 1.18 }, { 0, 0.38, 0 }, "Metal", magma),
+		Kit.box("Foot", { 1.10, 0.38, 1.16 }, { 0, 0.01, -0.02 }, "Metal", c.ironDark),
+		Kit.box("Foot", { 0.82, 0.24, 0.26 }, { 0, 0, -0.60 }, "Metal", c.ironWorn),
+	},
+}
+
+return look
diff --git a/src/shared/data/armourLooks/BasaltplateChest.luau b/src/shared/data/armourLooks/BasaltplateChest.luau
