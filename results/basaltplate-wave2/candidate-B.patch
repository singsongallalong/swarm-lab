@@ -0,0 +1,53 @@
+--!strict
+-- The basalt cuirass (Basaltplate set): a broad breastplate cut from the
+-- mountain. Black basalt slabs over iron, with magma-red seams in every
+-- joint, a branching crack across the breastplate and one down the back.
+-- Each shoulder is a stepped rock ledge: a pale base slab, then two dark
+-- slabs with red seams burning between them, the right shoulder one step
+-- higher. A heavy iron belt with a red rim and basalt tassets on the thighs.
+-- From the high camera the stacked ledges make the shoulder line and the red
+-- joints read as seams between plates rather than trim.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local basalt = { 42, 42, 50 }
+local basaltFace = { 58, 59, 70 }
+local magma = { 124, 52, 40 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateChest",
+	slot = "Chest",
+	parts = Kit.join({
+		Kit.flaps(0.55, "Slate", basalt),
+		{
+			-- The cuirass: one black slab over the torso, a pale top shelf
+			-- across the shoulders, a breastplate and a back plate.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Slate", basalt),
+			Kit.box("UpperTorso", { 2.14, 0.14, 1.14 }, { 0, 0.77, 0 }, "Slate", basaltFace),
+			Kit.box("UpperTorso", { 1.76, 1.06, 0.10 }, { 0, 0.10, -0.58 }, "Slate", basaltFace),
+			Kit.box("UpperTorso", { 1.50, 1.18, 0.10 }, { 0, 0.08, 0.58 }, "Slate", basaltFace),
+			-- A branching crack across the breastplate.
+			Kit.box("UpperTorso", { 0.08, 0.60, 0.06 }, { 0.10, 0.34, -0.65 }, "Metal", magma, { 0, 0, 7 }),
+			Kit.box("UpperTorso", { 0.06, 0.42, 0.06 }, { 0.30, 0.02, -0.65 }, "Metal", magma, { 0, 0, -24 }),
+			Kit.box("UpperTorso", { 0.06, 0.36, 0.06 }, { -0.04, -0.22, -0.65 }, "Metal", magma, { 0, 0, -10 }),
+			Kit.box("UpperTorso", { 0.07, 0.50, 0.06 }, { -0.18, 0.10, 0.65 }, "Metal", magma, { 0, 0, 12 }),
+			-- The belt: an iron band with a red rim above it.
+			Kit.box("LowerTorso", { 2.16, 0.46, 1.16 }, { 0, -0.01, 0 }, "Metal", c.iron),
+			Kit.box("LowerTorso", { 2.20, 0.05, 1.20 }, { 0, 0.22, 0 }, "Metal", magma),
+			-- The shoulders: a basalt sleeve under a stepped rock ledge.
+			Kit.box("UpperArm", { 1.08, 1.24, 1.08 }, { 0, 0, 0 }, "Slate", basalt),
+			Kit.box("UpperArm", { 1.28, 0.16, 1.28 }, { 0, 0.60, 0 }, "Slate", basaltFace),
+			Kit.box("UpperArm", { 1.10, 0.05, 1.10 }, { 0, 0.70, 0 }, "Metal", magma),
+			Kit.box("UpperArm", { 1.04, 0.20, 1.04 }, { 0.05, 0.82, -0.03 }, "Slate", basalt, { 0, 14, 0 }),
+			Kit.box("UpperArm", { 0.92, 0.05, 0.92 }, { 0.06, 0.945, -0.04 }, "Metal", magma, { 0, 14, 0 }),
+			Kit.box("UpperArm", { 0.82, 0.18, 0.82 }, { 0.08, 1.06, -0.05 }, "Slate", basalt, { 0, 14, 0 }),
+			Kit.wedge("UpperArm", { 0.86, 0.12, 0.86 }, { 0.08, 1.21, -0.05 }, "Slate", basaltFace, { 0, 14, 0 }),
+			-- The right shoulder carries one broken slab more.
+			Kit.box("UpperArm", { 0.46, 0.14, 0.46 }, { 0.16, 1.32, -0.04 }, "Slate", basalt, { 0, 20, 0 }, "Right"),
+		},
+	}),
+}
+
+return look
