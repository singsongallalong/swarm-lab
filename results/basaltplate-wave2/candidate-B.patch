+--!strict
+-- The basalt crown (Basaltplate set): a squat helm cut from columnar stone.
+-- Two stepped drums of near-black basalt with a magma seam burning over the
+-- iron rim and a flat moonlit cap, no peak. The face is sealed by a dark
+-- basalt visor with one red slit, flanked by iron cheek plates, and a red
+-- crack runs up the stone above the left brow. The helm stays low so the
+-- stepped pauldrons own the silhouette from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local basalt = { 42, 42, 50 }
+local basaltFace = { 58, 59, 70 }
+local magma = { 124, 52, 40 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The crown: two squat drums, capped flat.
+		Kit.box("Head", { 1.36, 0.48, 1.36 }, { 0, 0.30, 0 }, "Slate", basalt),
+		Kit.box("Head", { 1.22, 0.22, 1.22 }, { 0, 0.63, 0 }, "Slate", basalt),
+		Kit.box("Head", { 1.08, 0.08, 1.08 }, { 0, 0.78, 0 }, "Slate", basaltFace),
+		-- The magma seam over the iron rim.
+		Kit.box("Head", { 1.42, 0.07, 1.42 }, { 0, 0.03, 0 }, "Metal", magma),
+		Kit.box("Head", { 1.46, 0.16, 1.46 }, { 0, -0.08, 0 }, "Metal", c.ironDark),
+		-- The sealed face: a dark basalt visor with one red slit.
+		Kit.box("Head", { 1.24, 0.54, 0.24 }, { 0, -0.39, -0.60 }, "Slate", basalt),
+		Kit.box("Head", { 0.70, 0.06, 0.05 }, { 0, -0.24, -0.73 }, "Metal", magma),
+		-- Iron cheek plates closing the whole side, and the neck guard.
+		Kit.box("Head", { 0.10, 0.68, 1.00 }, { 0.72, -0.32, -0.10 }, "Metal", c.iron),
+		Kit.box("Head", { 0.10, 0.68, 1.00 }, { -0.72, -0.32, -0.10 }, "Metal", c.iron),
+		Kit.box("Head", { 1.28, 0.54, 0.40 }, { 0, -0.39, 0.54 }, "Metal", c.ironDark),
+		-- A crack in the stone, red at its root.
+		Kit.box("Head", { 0.07, 0.38, 0.05 }, { -0.30, 0.22, -0.695 }, "Metal", magma, { 0, 0, -8 }),
+	},
+}
+
+return look
