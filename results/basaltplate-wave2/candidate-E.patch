@@ -0,0 +1,59 @@
+--!strict
+-- The basaltplate chest (Aor'lan Mountain): a black basalt cuirass cut in
+-- slabs, iron-bound at the neck and waist, with boulder pauldrons stacked in
+-- three chipped tiers and one small echo shard off the right shoulder. A red
+-- sash is knotted at the hip and its tail swings from the left thigh; magma
+-- runs in cracks across the slab faces, never as a rim around them. The
+-- pauldrons make the outline wide and heavy from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local basalt = { 46, 44, 50 }
+local basaltDark = { 32, 31, 36 }
+local basaltEdge = { 78, 76, 84 }
+local magma = { 134, 46, 36 }
+local sashRed = { 118, 40, 34 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Skirt flaps of basalt, hung from the thighs.
+		Kit.flaps(0.52, "Basalt", basaltDark),
+		{
+			-- The cuirass: a black slab shell with darker chest and belly
+			-- plates and a heavy iron belt.
+			Kit.box("UpperTorso", { 2.14, 1.62, 1.06 }, { 0, 0, 0 }, "Basalt", basalt),
+			Kit.box("UpperTorso", { 1.9, 0.94, 0.14 }, { 0, 0.24, -0.56 }, "Basalt", basaltDark),
+			Kit.box("UpperTorso", { 1.54, 0.44, 0.1 }, { 0, -0.4, -0.6 }, "Basalt", basaltDark),
+			Kit.box("UpperTorso", { 1.02, 0.22, 1.02 }, { 0, 0.84, 0 }, "Metal", c.ironDark),
+			Kit.box("LowerTorso", { 2.18, 0.46, 1.12 }, { 0, 0.02, 0 }, "Metal", c.ironDark),
+			-- The red sash, slung a little askew, and its tail down the left
+			-- thigh so it swings with the leg.
+			Kit.box("LowerTorso", { 2.24, 0.26, 1.18 }, { 0, -0.16, 0 }, "Fabric", sashRed, { 0, 0, 3 }),
+			Kit.box("UpperLeg", { 0.22, 0.58, 0.1 }, { 0.44, 0.44, -0.56 }, "Fabric", sashRed, { 6, 0, 0 }, "Left"),
+			-- Magma in the seams: down the chest, across it, across the belly,
+			-- and down the right flank only, so the cracks are not a matched
+			-- pair.
+			Kit.box("UpperTorso", { 0.06, 1.0, 0.06 }, { 0, 0.16, -0.66 }, "SmoothPlastic", magma),
+			Kit.box("UpperTorso", { 1.16, 0.06, 0.06 }, { 0.06, 0.48, -0.65 }, "SmoothPlastic", magma, { 0, 0, 14 }),
+			Kit.box("UpperTorso", { 0.8, 0.05, 0.06 }, { -0.12, -0.38, -0.68 }, "SmoothPlastic", magma, { 0, 0, -9 }),
+			Kit.box("UpperTorso", { 0.06, 0.78, 0.06 }, { 1.06, 0, -0.2 }, "SmoothPlastic", magma),
+			-- A slab across the back.
+			Kit.box("UpperTorso", { 1.74, 1.2, 0.1 }, { 0, 0.1, 0.56 }, "Basalt", basaltDark),
+			-- A black sleeve under the boulder pauldrons, so no bare arm shows.
+			Kit.box("UpperArm", { 1.08, 1.22, 1.08 }, { 0, 0, 0 }, "Basalt", basalt),
+			-- Boulder pauldrons: three chipped tiers over each shoulder, and one
+			-- small echo shard rising from the right, shorter than the helm's
+			-- horns so they stay the dominant line.
+			Kit.box("UpperArm", { 1.34, 0.44, 1.32 }, { 0.02, 0.5, 0 }, "Basalt", basalt),
+			Kit.box("UpperArm", { 1.1, 0.4, 1.08 }, { 0.1, 0.78, 0.02 }, "Basalt", basaltDark, { 0, 0, -8 }),
+			Kit.box("UpperArm", { 0.66, 0.3, 0.7 }, { 0.22, 1.02, 0 }, "Basalt", basaltEdge, { 0, 0, -16 }),
+			Kit.box("UpperArm", { 0.18, 0.4, 0.18 }, { 0.36, 1.32, 0.02 }, "Basalt", basalt, { 0, 0, -20 }, "Right"),
+		},
+	}),
+}
+
+return look
