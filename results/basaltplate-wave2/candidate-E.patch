+--!strict
+-- The basaltplate boots (Aor'lan Mountain): black basalt greaves under an iron
+-- knee cop, a broad dark ridge up the shin, and long sabatons with scraped pale
+-- toe caps. A magma seam rings the shin below the knee, so the legs read as
+-- two short red bands under a heavy black base at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local basalt = { 46, 44, 50 }
+local basaltDark = { 32, 31, 36 }
+local magma = { 134, 46, 36 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateBoots",
+	slot = "Boots",
+	parts = {
+		-- A slab greave, an iron knee cop, and the red seam where they meet.
+		Kit.box("LowerLeg", { 1.14, 0.82, 1.14 }, { 0, -0.14, 0 }, "Basalt", basalt),
+		Kit.box("LowerLeg", { 1.22, 0.26, 1.22 }, { 0, 0.43, 0 }, "Metal", c.ironDark),
+		Kit.box("LowerLeg", { 1.24, 0.07, 1.24 }, { 0, 0.28, 0 }, "SmoothPlastic", magma),
+		-- A broad dark ridge of stone up the shin.
+		Kit.box("LowerLeg", { 0.46, 0.66, 0.12 }, { 0, -0.14, -0.59 }, "Basalt", basaltDark),
+		-- The long sabaton and its scraped pale toe cap.
+		Kit.box("Foot", { 1.12, 0.38, 1.26 }, { 0, 0, -0.08 }, "Basalt", basaltDark),
+		Kit.box("Foot", { 0.98, 0.12, 0.34 }, { 0, 0.14, -0.64 }, "Metal", c.ironWorn),
+	},
+}
+
+return look
diff --git a/src/shared/data/armourLooks/BasaltplateChest.luau b/src/shared/data/armourLooks/BasaltplateChest.luau
