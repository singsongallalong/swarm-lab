+--!strict
+-- The basaltplate helm (Aor'lan Mountain, cut from the mountain's own body):
+-- a black basalt barbute with a stepped crown and an iron rim. Two dark
+-- faceted horns of basalt lean out and up, each breaking from the helm through
+-- a thin magma seam, so the head's outline reads first from the high camera
+-- and the red at the roots reads second.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The mountain's own palette: basalt black with a cold cast, darker under the
+-- crown, and the magma that runs between the plates.
+local basalt = { 46, 44, 50 }
+local basaltDark = { 32, 31, 36 }
+local magma = { 134, 46, 36 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl, stepped to a wide low crown set a little askew.
+		Kit.box("Head", { 1.4, 0.86, 1.4 }, { 0, 0.1, 0 }, "Basalt", basalt),
+		Kit.box("Head", { 1.32, 0.24, 1.32 }, { 0, 0.63, 0 }, "Basalt", basaltDark, { 0, 1, 0 }),
+		-- The iron rim under the bowl.
+		Kit.box("Head", { 1.46, 0.12, 1.46 }, { 0, -0.3, 0 }, "Metal", c.ironDark),
+		-- A full visor plate, wide enough to cover the head, with one red slit.
+		Kit.box("Head", { 1.26, 0.68, 0.16 }, { 0, -0.28, -0.68 }, "Basalt", basaltDark),
+		Kit.box("Head", { 0.9, 0.07, 0.06 }, { 0, -0.12, -0.78 }, "SmoothPlastic", magma),
+		-- Cheek plates and a neck guard over the nape.
+		Kit.box("Head", { 0.1, 0.62, 0.62 }, { 0.74, -0.29, -0.22 }, "Basalt", basalt),
+		Kit.box("Head", { 1.34, 0.5, 0.42 }, { 0, -0.4, 0.54 }, "Metal", c.ironDark),
+		-- Two dark faceted horns, stepped and leaning out, each with a magma
+		-- seam at its root where it breaks from the helm.
+		Kit.box("Head", { 0.4, 0.5, 0.4 }, { 0.56, 0.62, -0.02 }, "Basalt", basalt, { 0, 0, -30 }),
+		Kit.box("Head", { 0.48, 0.06, 0.48 }, { 0.66, 0.8, -0.02 }, "SmoothPlastic", magma, { 0, 0, -30 }),
+		Kit.box("Head", { 0.28, 0.58, 0.28 }, { 0.89, 1.02, -0.02 }, "Basalt", basaltDark, { 0, 0, -42 }),
+		Kit.box("Head", { 0.16, 0.46, 0.16 }, { 1.16, 1.36, -0.02 }, "Basalt", basalt, { 0, 0, -56 }),
+	},
+}
+
+return look
