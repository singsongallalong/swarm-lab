+			Kit.box("LowerTorso", { 2.12, 0.42, 1.08 }, { 0, 0, 0 }, "Basalt", basalt),
+			Kit.box("UpperArm", { 1.12, 1.24, 1.12 }, { 0, 0, 0 }, "Basalt", basalt),
+			-- Three slab plates down the front, thick seams of magma between them.
+			Kit.box("UpperTorso", { 0.66, 1.2, 0.12 }, { -0.62, 0.02, -0.56 }, "Basalt", basaltPlate),
+			Kit.box("UpperTorso", { 0.58, 1.24, 0.14 }, { 0, 0.02, -0.555 }, "Basalt", basaltPlate),
+			Kit.box("UpperTorso", { 0.66, 1.2, 0.12 }, { 0.62, 0.02, -0.56 }, "Basalt", basaltPlate),
+			Kit.box("UpperTorso", { 0.12, 1.18, 0.2 }, { -0.29, 0.02, -0.56 }, "SmoothPlastic", magma),
+			Kit.box("UpperTorso", { 0.12, 1.18, 0.2 }, { 0.29, 0.02, -0.56 }, "SmoothPlastic", magma),
+			-- An iron band across the top of the plates.
+			Kit.box("UpperTorso", { 1.98, 0.16, 0.14 }, { 0, 0.6, -0.55 }, "Metal", c.ironDark),
+			-- The back, plainer.
+			Kit.box("UpperTorso", { 1.7, 1.1, 0.11 }, { 0, 0.1, 0.56 }, "Basalt", basaltPlate),
+			-- Belt and buckle, off centre.
+			Kit.box("LowerTorso", { 2.18, 0.18, 1.14 }, { 0, 0.04, 0 }, "Metal", c.ironDark),
+			Kit.box("LowerTorso", { 2.18, 0.06, 1.14 }, { 0, 0.14, 0 }, "SmoothPlastic", magma),
+			Kit.box("LowerTorso", { 0.26, 0.2, 0.1 }, { 0.34, 0.04, -0.6 }, "Metal", c.ironWorn),
+			-- The right pauldron: two stepped iron slabs, a red strip on top.
+			Kit.box("UpperArm", { 1.32, 0.24, 1.3 }, { 0.04, 0.44, 0 }, "Metal", c.ironDark, { 0, 0, -10 }, "Right"),
+			Kit.box("UpperArm", { 1.14, 0.18, 1.14 }, { 0.09, 0.6, 0 }, "Metal", c.iron, { 0, 0, -10 }, "Right"),
+			Kit.box(
+				"UpperArm",
+				{ 1, 0.05, 0.1 },
+				{ 0.09, 0.695, -0.42 },
+				"SmoothPlastic",
+				magma,
+				{ 0, 0, -10 },
+				"Right"
+			),
+			-- The one outcrop: a raw basalt crag breaking out of the pauldron,
+			-- with a magma seam where the rock meets the iron.
+			Kit.box("UpperArm", { 0.9, 0.66, 0.8 }, { 0.04, 0.9, 0 }, "Basalt", basaltRock, { 0, 16, 12 }, "Right"),
+			Kit.box(
+				"UpperArm",
+				{ 0.26, 0.9, 0.3 },
+				{ -0.16, 1.34, 0.04 },
+				"Basalt",
+				basaltRock,
+				{ 0, 12, -18 },
+				"Right"
+			),
+			Kit.box(
+				"UpperArm",
+				{ 0.32, 0.66, 0.36 },
+				{ 0.3, 1.14, -0.16 },
+				"Basalt",
+				basaltDark,
+				{ 0, -14, 22 },
+				"Right"
+			),
+			Kit.box(
+				"UpperArm",
+				{ 0.24, 0.44, 0.28 },
+				{ 0.04, 1.16, 0.3 },
+				"Basalt",
+				basaltRock,
