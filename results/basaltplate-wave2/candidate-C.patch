+		Kit.box("LowerLeg", { 0.86, 0.68, 0.1 }, { 0, -0.04, -0.57 }, "Basalt", basaltPlate, { -4, 0, 0 }),
+		Kit.box("LowerLeg", { 1.18, 0.18, 1.18 }, { 0, 0.54, 0 }, "Metal", c.ironDark),
+		Kit.box("LowerLeg", { 1.2, 0.08, 1.2 }, { 0, 0.44, 0 }, "SmoothPlastic", magma),
