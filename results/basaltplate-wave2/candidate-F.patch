+--!strict
+-- The basaltplate helm (zone armour, the BasaltplateHelm base): the mountain's
+-- own head. A heavy black iron brow ledge juts out over a bright red eye slit,
+-- and the casque steps inward above it: a wide slab crown, a magma seam, then a
+-- smaller slab cap, so the helm reads as a stepped stone crown rather than a
+-- bucket. A cooling crack, a chipped corner and a heavy jaw and neck guard keep
+-- it cut from rock. No round form anywhere: the helm is all slabs.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 44, 44, 52 },
+	basaltFace = { 66, 66, 76 },
+	basaltDark = { 30, 30, 37 },
+	basaltEdge = { 124, 126, 136 },
+	magma = { 150, 40, 38 },
+	magmaDim = { 106, 30, 30 },
+	visor = { 170, 44, 42 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The wide casque, the red slit, then the stepped-down crown and cap.
+		Kit.box("Head", { 1.34, 0.62, 1.34 }, { 0, 0.26, 0 }, "Basalt", c.basalt),
+		Kit.box("Head", { 1.44, 0.16, 1.44 }, { 0, -0.08, 0 }, "SmoothPlastic", c.visor),
+		Kit.box("Head", { 1.24, 0.1, 1.24 }, { 0, 0.62, 0 }, "SmoothPlastic", c.magma),
+		Kit.box("Head", { 1.08, 0.24, 1.08 }, { 0, 0.78, 0 }, "Basalt", c.basaltFace),
+		-- The black iron brow ledge jutting over the slit, and the jaw below it.
+		Kit.box("Head", { 1.5, 0.18, 0.36 }, { 0, 0.06, -0.8 }, "Metal", Kit.colors.ironDark),
+		Kit.box("Head", { 1.34, 0.74, 1.28 }, { 0, -0.51, -0.03 }, "Basalt", c.basaltDark),
+		Kit.box("Head", { 1.06, 0.22, 0.18 }, { 0, -0.63, -0.64 }, "Basalt", c.basaltFace),
+		-- The stepped neck guard at the back, rising to the eye seam and falling
+		-- to meet the cuirass, so no neck shows between the helm's plates.
+		Kit.box("Head", { 1.28, 0.72, 0.28 }, { 0, -0.52, 0.66 }, "Basalt", c.basaltDark),
+		-- A cooling crack up the front of the crown, off centre, and one behind.
+		Kit.box("Head", { 0.09, 0.5, 0.06 }, { 0.18, 0.28, -0.68 }, "SmoothPlastic", c.magmaDim, { 0, 0, 3 }),
+		Kit.box("Head", { 0.09, 0.5, 0.06 }, { -0.2, 0.28, 0.68 }, "SmoothPlastic", c.magmaDim, { 0, 0, -3 }),
+		-- A corner chipped off the crown, its pale face catching the moon.
+		Kit.box("Head", { 0.34, 0.12, 0.08 }, { -0.4, 0.46, -0.68 }, "Basalt", c.basaltEdge, { 0, 0, -14 }),
+	},
+}
+
+return look
