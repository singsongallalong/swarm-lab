+--!strict
+-- The basaltplate boots (zone armour, the BasaltplateBoots base): the mountain's
+-- feet. Squared basalt greaves with a blocky knee cop above a magma seam,
+-- banded in black iron at the ankle, and broad squared sabatons with a stepped
+-- toe. One greave is chipped pale. The boots are all slabs, like the rest of
+-- the set, so they read as stone at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 44, 44, 52 },
+	basaltFace = { 66, 66, 76 },
+	basaltDark = { 30, 30, 37 },
+	basaltEdge = { 124, 126, 136 },
+	magma = { 150, 40, 38 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateBoots",
+	slot = "Boots",
+	parts = {
+		-- The greave, its knee cop and the magma seam between them.
+		Kit.box("LowerLeg", { 1.1, 1.2, 1.1 }, { 0, 0, 0 }, "Basalt", c.basalt),
+		Kit.box("LowerLeg", { 0.9, 0.26, 0.5 }, { 0, 0.45, -0.28 }, "Basalt", c.basaltDark),
+		Kit.box("LowerLeg", { 1.14, 0.1, 1.14 }, { 0, 0.3, 0 }, "SmoothPlastic", c.magma),
+		Kit.box("LowerLeg", { 1.14, 0.14, 1.14 }, { 0, -0.38, 0 }, "Metal", Kit.colors.ironDark),
+		-- The squared sabaton and its stepped toe.
+		Kit.box("Foot", { 1.12, 0.46, 1.34 }, { 0, -0.02, -0.07 }, "Basalt", c.basaltDark),
+		Kit.box("Foot", { 0.94, 0.22, 0.3 }, { 0, 0.12, -0.64 }, "Basalt", c.basaltFace),
+		-- A chipped patch on the left greave.
+		Kit.box("LowerLeg", { 0.06, 0.32, 0.42 }, { 0.63, -0.02, 0.12 }, "Basalt", c.basaltEdge, nil, "Left"),
+	},
+}
+
+return look
