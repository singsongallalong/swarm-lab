+		Kit.box("Hand", { 1.08, 0.5, 1.08 }, { 0, 0, 0 }, "Basalt", c.basaltDark),
+		Kit.box("Hand", { 1, 0.22, 0.3 }, { 0, 0.15, -0.45 }, "Basalt", c.basaltFace),
