+--!strict
+-- The basaltplate cuirass (zone armour, the BasaltplateChest base): the
+-- mountain's torso in stacked slab plates. Bands of basalt front and back are
+-- bedded on magma seams over a dark underlayer, the back split by a seam down
+-- the spine, and a black iron belt cinches it with its buckle off centre. The
+-- shoulders are the set's silhouette: a broad slab base and a cap knocked
+-- askew over a magma ring, so the outline reads as broad stone shoulders and
+-- looks cut from rock rather than stacked. Slab tassets hang from the thighs
+-- and swing with them; one carries an extra plate, and the left pauldron is
+-- chipped pale.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 44, 44, 52 },
+	basaltFace = { 66, 66, 76 },
+	basaltDark = { 30, 30, 37 },
+	basaltEdge = { 124, 126, 136 },
+	magma = { 150, 40, 38 },
+	magmaDim = { 106, 30, 30 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BasaltplateChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Slab tassets on the thighs, so they swing with a stride (A14-D9).
+		Kit.flaps(0.62, "Basalt", c.basalt),
+		{
+			-- The body under the plates, and the waist beneath it.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Basalt", c.basaltDark),
+			Kit.box("LowerTorso", { 2.08, 0.62, 1.08 }, { 0, 0, 0 }, "Basalt", c.basaltDark),
+			-- Two deep slab bands down the front, bedded on two magma seams.
+			Kit.box("UpperTorso", { 1.86, 0.48, 0.12 }, { 0, 0.5, -0.55 }, "Basalt", c.basaltFace),
+			Kit.box("UpperTorso", { 1.86, 0.62, 0.12 }, { 0, -0.11, -0.55 }, "Basalt", c.basalt),
+			Kit.box("UpperTorso", { 1.7, 0.1, 0.06 }, { 0, 0.23, -0.56 }, "SmoothPlastic", c.magma),
+			Kit.box("UpperTorso", { 1.7, 0.1, 0.06 }, { 0, -0.455, -0.56 }, "SmoothPlastic", c.magmaDim),
+			-- The same bands behind, with a seam running down the spine.
+			Kit.box("UpperTorso", { 1.86, 0.48, 0.12 }, { 0, 0.5, 0.55 }, "Basalt", c.basaltFace),
+			Kit.box("UpperTorso", { 1.86, 0.62, 0.12 }, { 0, -0.11, 0.55 }, "Basalt", c.basalt),
+			Kit.box("UpperTorso", { 1.7, 0.1, 0.06 }, { 0, 0.23, 0.56 }, "SmoothPlastic", c.magma),
+			Kit.box("UpperTorso", { 1.7, 0.1, 0.06 }, { 0, -0.455, 0.56 }, "SmoothPlastic", c.magmaDim),
+			Kit.box("UpperTorso", { 0.09, 1.2, 0.05 }, { 0, 0, 0.575 }, "SmoothPlastic", c.magmaDim),
+			-- The black iron belt, a seam beneath it, and an off-centre buckle.
+			Kit.box("LowerTorso", { 2.1, 0.22, 1.1 }, { 0, 0.16, 0 }, "Metal", Kit.colors.ironDark),
+			Kit.box("LowerTorso", { 2.08, 0.09, 1.08 }, { 0, 0.02, 0 }, "SmoothPlastic", c.magmaDim),
+			Kit.box("LowerTorso", { 0.28, 0.24, 0.1 }, { -0.3, 0.16, -0.56 }, "Metal", Kit.colors.ironWorn),
+			-- The shoulder: a broad base, a magma ring, and a cap knocked askew
+			-- on each side so the slabs sit like broken rock, not stacked crates.
+			Kit.box("UpperArm", { 1.34, 1.16, 1.34 }, { 0.03, -0.02, 0 }, "Basalt", c.basalt),
+			Kit.box("UpperArm", { 1.26, 0.1, 1.26 }, { 0.03, 0.55, 0 }, "SmoothPlastic", c.magma),
+			Kit.box(
+				"UpperArm",
+				{ 1.14, 0.22, 1.14 },
+				{ 0.12, 0.69, 0.06 },
+				"Basalt",
+				c.basaltFace,
+				{ 5, 0, 0 },
+				"Right"
+			),
+			Kit.box("UpperArm", { 1.1, 0.2, 1.1 }, { 0, 0.66, -0.05 }, "Basalt", c.basalt, { -4, 0, 0 }, "Left"),
+			-- The left pauldron took the blow: a pale chipped face, one side only.
+			Kit.box("UpperArm", { 0.08, 0.36, 0.44 }, { 0.7, 0.26, 0.06 }, "Basalt", c.basaltEdge, nil, "Left"),
+			-- An extra slab over the right tasset, for an uneven hem.
+			Kit.box(
+				"UpperLeg",
+				{ 0.5, 0.26, 0.1 },
+				{ 0.08, 0.56, -0.62 },
+				"Basalt",
+				c.basaltFace,
+				{ 4, 0, 0 },
+				"Right"
+			),
+		},
+	}),
+}
+
+return look
