+		Kit.box("Head", { 1.56, 0.16, 1.52 }, { 0, 0.62, 0.04 }, "Metal", barrow.bronzeWorn),
+		-- The barrow-king ridge: bone, running front to back along the crown.
+		Kit.box("Head", { 0.24, 0.34, 1.3 }, { 0, 0.87, 0.04 }, "Marble", c.bone),
+		-- Four worn bronze points at the rim's corners, the crown's teeth.
+		Kit.box("Head", { 0.14, 0.26, 0.14 }, { -0.6, 0.77, -0.55 }, "Metal", barrow.bronzeWorn, { 0, 0, 8 }),
+		Kit.box("Head", { 0.14, 0.26, 0.14 }, { 0.6, 0.77, -0.55 }, "Metal", barrow.bronzeWorn, { 0, 0, -8 }),
+		Kit.box("Head", { 0.14, 0.26, 0.14 }, { -0.6, 0.77, 0.6 }, "Metal", barrow.bronzeWorn, { 0, 0, 8 }),
+		Kit.box("Head", { 0.14, 0.26, 0.14 }, { 0.6, 0.77, 0.6 }, "Metal", barrow.bronzeWorn, { 0, 0, -8 }),
+		-- The bone death-mask with its dark visor slot.
+		Kit.box("Head", { 1.18, 0.9, 0.08 }, { 0, -0.1, -0.62 }, "Marble", c.bone),
+		Kit.box("Head", { 1.06, 0.12, 0.05 }, { 0, 0.12, -0.665 }, "Fabric", barrow.mould),
+		-- A bronze neck guard behind.
+		Kit.box("Head", { 1.32, 0.54, 0.16 }, { 0, -0.3, 0.68 }, "Metal", barrow.bronzeDark),
+		-- Moss creeping over the bronze: a brow patch, a cheek drip, a crown patch.
+		Kit.box("Head", { 0.34, 0.2, 0.06 }, { -0.42, 0.46, -0.635 }, "Fabric", barrow.moss, { 0, 0, 10 }),
