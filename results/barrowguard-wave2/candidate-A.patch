+--!strict
+-- The Barrowguard boots (Barrowguard): mould-black leather under a broad
+-- tarnished bronze shin plate, a moss wrap at the knee and a bronze band at
+-- the ankle. The right boot's toe is bronze-capped; the left is splinted with
+-- bone where the grave broke it. Bronze-shod and green-banded where the
+-- leather boots are plain brown and the studded boots oxblood.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The Barrowguard palette: tarnished bronze, grave-moss green, mould-black
+-- leather and bone, dulled for the night preset.
+local barrow = {
+	bronze = { 124, 100, 62 },
+	bronzeDark = { 84, 68, 44 },
+	moss = { 72, 88, 56 },
+	mould = { 40, 38, 34 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardBoots",
+	slot = "Boots",
+	parts = {
+		-- The boot, bound at the knee and at the ankle.
+		Kit.box("LowerLeg", { 1.08, 1.0, 1.08 }, { 0, -0.06, 0 }, "Leather", barrow.mould),
+		Kit.box("LowerLeg", { 1.11, 0.22, 1.11 }, { 0, 0.46, 0 }, "Fabric", barrow.moss, { 0, 0, 6 }),
+		Kit.box("LowerLeg", { 1.11, 0.14, 1.11 }, { 0, -0.3, 0 }, "Metal", barrow.bronzeDark, { 0, 0, -5 }),
+		-- The broad bronze shin plate, and the bone splint on the left shin.
+		Kit.box("LowerLeg", { 0.84, 0.72, 0.1 }, { 0, 0.02, -0.57 }, "Metal", barrow.bronze, { -5, 0, 0 }),
+		Kit.box("LowerLeg", { 0.12, 0.34, 0.1 }, { 0.3, -0.08, -0.61 }, "Marble", c.bone, { 0, 0, 10 }, "Left"),
+		-- The foot, bronze-capped on the right only.
