+			Kit.box("UpperTorso", { 0.52, 0.1, 0.06 }, { -0.42, 0.18, -0.67 }, "Metal", c.bronzeWorn, { 0, 0, 12 }),
+			-- The moss-grown fur mantle, seated close on the shoulders.
+			Kit.box("UpperTorso", { 2.3, 0.36, 1.3 }, { 0, 0.7, 0.04 }, "Fabric", c.moss),
+			Kit.box("UpperTorso", { 2.14, 0.24, 1.22 }, { 0, 0.48, 0.06 }, "Fabric", c.mossDark),
+			-- A raised fur collar behind the neck.
+			Kit.box("UpperTorso", { 1.5, 0.34, 0.42 }, { 0, 0.96, 0.34 }, "Fabric", c.mossDark),
