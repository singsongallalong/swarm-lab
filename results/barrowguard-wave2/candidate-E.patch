+--!strict
+-- The barrowguard helm (Broken Barrows set): a tall tarnished-bronze nasal
+-- helm dug out of a barrow, with a pale bone crown ridge and brow band, deep
+-- cheek plates and a short mail aventail. The brow is brought low and dark so
+-- the eye slit is narrow. Moss has taken the left brow; a scrape on the right
+-- of the bowl catches the moon from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	bronze = { 106, 96, 58 },
+	bronzeDark = { 68, 64, 44 },
+	bronzeWorn = { 170, 146, 94 },
+	mailBronze = { 86, 80, 52 },
+	moss = { 72, 84, 50 },
+	bone = Kit.colors.bone,
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		Kit.box("Head", { 1.34, 0.68, 1.34 }, { 0, 0.3, 0 }, "Metal", c.bronze),
+		Kit.box("Head", { 1.04, 0.3, 1.06 }, { 0, 0.72, 0 }, "Metal", c.bronze),
+		-- The crown ridge: pale bone, the one regal line seen from above.
+		Kit.box("Head", { 0.2, 0.3, 1.3 }, { 0, 0.92, 0 }, "Marble", c.bone),
+		-- A deep dark brow, brought low over the eyes, over the bone brow band.
+		Kit.box("Head", { 1.44, 0.28, 1.44 }, { 0, -0.08, 0 }, "Metal", c.bronzeDark),
+		Kit.box("Head", { 0.9, 0.1, 0.08 }, { 0, 0.04, -0.72 }, "Marble", c.bone),
+		-- The bronze nasal over the face.
+		Kit.box("Head", { 0.16, 0.56, 0.1 }, { 0, -0.24, -0.73 }, "Metal", c.bronzeWorn),
+		-- Deep cheek plates on both sides; Head pieces do not mirror.
+		Kit.box("Head", { 0.36, 0.52, 0.52 }, { 0.58, -0.3, -0.24 }, "Metal", c.bronze),
+		Kit.box("Head", { 0.34, 0.48, 0.48 }, { -0.58, -0.32, -0.24 }, "Metal", c.bronze),
+		-- The aventail at the back of the neck.
+		Kit.box("Head", { 1.38, 0.54, 0.48 }, { 0, -0.3, 0.48 }, "Metal", c.mailBronze),
+		-- Moss in the left brow, and a scrape on the right of the bowl.
+		Kit.box("Head", { 0.32, 0.16, 0.36 }, { -0.44, 0.1, -0.58 }, "Fabric", c.moss),
+		Kit.box("Head", { 0.3, 0.12, 0.06 }, { 0.36, 0.26, -0.68 }, "Metal", c.bronzeWorn, { 0, 0, -12 }),
+	},
+}
+
+return look
