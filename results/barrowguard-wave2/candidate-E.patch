+--!strict
+-- The barrowguard gauntlets (Broken Barrows set): mould-black leather
+-- bracers and gloves cased in dark tarnished bronze. One thick bronze cuff
+-- at each elbow, a bronze ridge down the left forearm for the set's
+-- asymmetry, moss twisted round the wrists and a pale bone knuckle plate.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	bronze = { 106, 96, 58 },
+	moss = { 72, 84, 50 },
+	mould = { 42, 42, 36 },
+	bone = Kit.colors.bone,
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardGauntlets",
+	slot = "Gloves",
+	parts = {
+		Kit.box("LowerArm", { 1.1, 0.9, 1.1 }, { 0, -0.06, 0 }, "Leather", c.mould),
+		-- One thick bronze cuff at the elbow, read from above as a band.
+		Kit.box("LowerArm", { 1.18, 0.36, 1.18 }, { 0, 0.32, 0 }, "Metal", c.bronze),
+		-- A bronze ridge down the outside of the left forearm.
+		Kit.box("LowerArm", { 0.14, 0.54, 0.4 }, { -0.57, -0.14, 0 }, "Metal", c.bronze, nil, "Left"),
+		-- Moss twisted round the wrist.
+		Kit.box("LowerArm", { 1.18, 0.16, 1.18 }, { 0, -0.36, 0 }, "Fabric", c.moss, { 0, 0, 4 }),
+		-- The glove and a bone knuckle plate.
+		Kit.box("Hand", { 1.06, 0.38, 1.06 }, { 0, 0, 0 }, "Leather", c.mould),
+		Kit.box("Hand", { 0.76, 0.22, 0.12 }, { 0, 0.02, -0.55 }, "Marble", c.bone),
+	},
+}
+
+return look
