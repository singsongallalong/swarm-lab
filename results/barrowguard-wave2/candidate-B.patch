+		Kit.box("LowerLeg", { 1.14, 0.18, 1.14 }, { 0, 0.34, 0 }, "Fabric", c.moss),
+		-- A broad bronze shin plate.
+		Kit.box("LowerLeg", { 0.72, 0.62, 0.16 }, { 0, -0.02, -0.54 }, "Metal", c.bronze),
+		-- The foot, with a bronze toe cap worn bright.
+		Kit.box("Foot", { 1.06, 0.36, 1.14 }, { 0, 0.02, -0.04 }, "Leather", c.mould),
+		Kit.box("Foot", { 0.98, 0.18, 0.22 }, { 0, 0.02, -0.56 }, "Metal", c.bronzeWorn),
+		-- Moss up the right shin; a bone toggle hung at the left ankle.
