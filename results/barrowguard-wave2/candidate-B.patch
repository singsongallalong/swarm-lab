+--!strict
+-- The barrowguard chest (zone armour, the BarrowguardChest base): the grave
+-- armour of the old barrow king's guard. Mould-black mail and leather under
+-- grave-moss cloth, plated over with tarnished bronze: stepped pauldrons on
+-- both shoulders, a gorget at the throat, a broad breastplate pinned by a
+-- diamond brooch, and a gilded belt with grave-goods hung off it. The bronze
+-- plates catch the moon; the bone brooch and studs keep the grave-goods read.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	mail = { 52, 58, 52 },
+	mould = { 42, 44, 40 },
+	moss = { 74, 88, 60 },
+	bronze = { 100, 84, 54 },
+	bronzeWorn = { 136, 110, 68 },
+	bone = { 154, 144, 118 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Mail tails hung from the thighs, so they swing with the legs.
+		Kit.flaps(0.55, "Metal", c.mail),
+		{
+			-- The hauberk under the plates.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Metal", c.mail),
+			Kit.box("LowerTorso", { 2.1, 0.44, 1.1 }, { 0, 0, 0 }, "Metal", c.mail),
+			-- The grave-moss surcoat, front and back.
+			Kit.box("UpperTorso", { 1.14, 1.5, 0.06 }, { 0, -0.02, -0.56 }, "Fabric", c.moss),
+			Kit.box("UpperTorso", { 1.14, 1.3, 0.06 }, { 0, -0.1, 0.56 }, "Fabric", c.moss),
+			-- Mould-black sleeves under stepped bronze pauldrons, the top
+			-- plate scraped bright so the shoulders read from the high camera.
+			Kit.box("UpperArm", { 1.12, 1.28, 1.12 }, { 0, 0, 0 }, "Leather", c.mould),
+			Kit.box("UpperArm", { 1.3, 0.2, 1.28 }, { 0, 0.6, 0 }, "Metal", c.bronzeWorn),
+			Kit.box("UpperArm", { 1.22, 0.16, 1.2 }, { 0, 0.42, 0 }, "Metal", c.bronze),
+			-- The bronze gorget at the throat, with a bone stud.
+			Kit.box("UpperTorso", { 1.5, 0.24, 1.2 }, { 0, 0.72, 0 }, "Metal", c.bronzeWorn),
+			Kit.box("UpperTorso", { 0.2, 0.16, 0.1 }, { 0.36, 0.72, -0.62 }, "Marble", c.bone),
+			-- The bronze breastplate and the great diamond brooch on it.
+			Kit.box("UpperTorso", { 0.92, 0.76, 0.12 }, { 0, 0.04, -0.6 }, "Metal", c.bronze),
+			Kit.box("UpperTorso", { 0.3, 0.3, 0.1 }, { 0, 0.3, -0.68 }, "Metal", c.bronzeWorn, { 0, 0, 45 }),
+			Kit.box("UpperTorso", { 0.18, 0.18, 0.06 }, { 0, 0.3, -0.74 }, "Marble", c.bone, { 0, 0, 45 }),
+			-- The gilded belt, its buckle, and grave-goods hung off it.
+			Kit.box("LowerTorso", { 2.14, 0.18, 1.14 }, { 0, 0.1, 0 }, "Metal", c.bronzeWorn),
+			Kit.box("LowerTorso", { 0.38, 0.26, 0.1 }, { 0.06, 0.08, -0.6 }, "Metal", c.bronze),
+			Kit.box("LowerTorso", { 0.16, 0.12, 0.06 }, { 0.06, 0.08, -0.66 }, "Marble", c.bone),
+			Kit.box("LowerTorso", { 0.12, 0.3, 0.08 }, { 0.36, -0.1, -0.58 }, "Marble", c.bone),
+			Kit.box("LowerTorso", { 0.18, 0.18, 0.08 }, { -0.36, -0.06, -0.58 }, "Metal", c.bronze, { 0, 0, 45 }),
+		},
+	}),
+}
