+--!strict
+-- The barrowguard helm (zone armour, the BarrowguardHelm base): the crown-helm
+-- of the old barrow king's guard, dug up still faintly regal. A mould-black
+-- leather bowl under a broad tarnished bronze crown band, its four posts tall
+-- and uneven, two broken long ago, each capped with bone or verdigris. The
+-- face is closed: a bone jaw guard and a bronze nasal over the mouth, so the
+-- helm reads as the dead guard's face, not the avatar's, and a moss veil hangs
+-- at the back of the neck.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	mould = { 42, 44, 40 },
+	bronze = { 100, 84, 54 },
+	bronzeWorn = { 136, 110, 68 },
+	bone = { 154, 144, 118 },
+	moss = { 74, 88, 60 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl, down to the eye line.
+		Kit.box("Head", { 1.3, 0.7, 1.3 }, { 0, 0.26, 0 }, "Leather", c.mould),
+		-- The broad bronze crown band, and its four uneven posts.
+		Kit.box("Head", { 1.34, 0.12, 1.34 }, { 0, 0.64, 0 }, "Metal", c.bronzeWorn),
+		Kit.box("Head", { 0.16, 0.52, 0.16 }, { 0.54, 0.94, -0.54 }, "Metal", c.bronze),
+		Kit.box("Head", { 0.16, 0.44, 0.16 }, { -0.54, 0.9, -0.54 }, "Metal", c.bronze),
+		Kit.box("Head", { 0.16, 0.34, 0.16 }, { 0.54, 0.85, 0.54 }, "Metal", c.bronze),
+		Kit.box("Head", { 0.16, 0.22, 0.16 }, { -0.54, 0.79, 0.54 }, "Metal", c.bronze),
+		-- A bone or verdigris point on every post.
+		Kit.box("Head", { 0.12, 0.14, 0.12 }, { 0.54, 1.27, -0.54 }, "Marble", c.bone),
+		Kit.box("Head", { 0.12, 0.14, 0.12 }, { -0.54, 1.19, -0.54 }, "Marble", c.bone),
+		Kit.box("Head", { 0.12, 0.14, 0.12 }, { 0.54, 1.09, 0.54 }, "Fabric", c.moss),
+		Kit.box("Head", { 0.12, 0.14, 0.12 }, { -0.54, 0.97, 0.54 }, "Fabric", c.moss),
+		-- The bone jaw guard and the bronze nasal over it.
+		Kit.box("Head", { 1.24, 0.52, 0.12 }, { 0, -0.35, -0.58 }, "Marble", c.bone),
+		Kit.box("Head", { 0.12, 0.5, 0.08 }, { -0.02, -0.2, -0.66 }, "Metal", c.bronze, { 0, 0, 4 }),
+		-- The grave-moss veil at the back of the neck.
+		Kit.box("Head", { 1.18, 0.44, 0.14 }, { 0, -0.3, 0.58 }, "Fabric", c.moss, { 8, 0, 0 }),
+	},
+}
+
+return look
