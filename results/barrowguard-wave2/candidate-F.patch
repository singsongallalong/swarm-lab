+--!strict
+-- The barrowguard chest (Barrowguard set): a mould-black leather cuirass bound
+-- in tarnished bronze under a mantle of grave-moss fur gone green and heavy.
+-- The moss yoke and two-tone pauldrons - fur on the right, layered tarnished
+-- bronze on the left - broaden the shoulders; a bold bronze breastplate, spine
+-- and belt carry the metal with no thin banding to blur at the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local bronze = { 102, 88, 54 }
+local bronzeTarnish = { 80, 86, 52 }
+local moss = { 74, 86, 46 }
+local mossDark = { 52, 62, 36 }
+local mould = { 46, 46, 40 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Moss-dark cloth tails hung from the thighs, stopping short of the knee.
+		Kit.flaps(0.55, "Fabric", mossDark),
+		{
+			-- The mould-black cuirass and its girdle.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Leather", mould),
+			Kit.box("LowerTorso", { 2.12, 0.44, 1.12 }, { 0, 0, 0 }, "Leather", mould),
+			-- Bold bronze: a broad breastplate, a spine down the back and a belt.
+			Kit.box("UpperTorso", { 1.6, 1.0, 0.12 }, { 0, 0.06, -0.58 }, "Metal", bronze),
+			Kit.box("UpperTorso", { 0.42, 1.15, 0.12 }, { 0, 0.02, 0.57 }, "Metal", bronze),
+			Kit.box("LowerTorso", { 2.16, 0.22, 1.16 }, { 0, 0.02, 0 }, "Metal", bronze),
+			-- The bone buckle, off centre.
+			Kit.box("LowerTorso", { 0.34, 0.24, 0.1 }, { 0.34, 0.02, -0.6 }, "Marble", c.bone),
+			-- The mantle: a moss yoke over both shoulders, a front lip, a high
+			-- collar rising behind the head and a torn drape on the left breast.
+			Kit.box("UpperTorso", { 2.36, 0.26, 1.3 }, { 0, 0.68, 0.02 }, "Fabric", moss),
+			Kit.box("UpperTorso", { 1.9, 0.22, 0.16 }, { 0, 0.54, -0.56 }, "Fabric", moss),
+			Kit.box("UpperTorso", { 1.6, 0.4, 0.3 }, { 0, 0.9, 0.42 }, "Fabric", moss),
+			Kit.box("UpperTorso", { 0.42, 0.6, 0.14 }, { -0.68, 0.28, -0.56 }, "Fabric", mossDark, { 0, 0, -6 }),
+			-- The pauldrons: a two-tone fur mound on the right, two bold bronze
+			-- plates on the left.
+			Kit.box("UpperArm", { 1.34, 0.4, 1.34 }, { 0.02, 0.5, 0 }, "Fabric", moss, { 0, 0, -8 }, "Right"),
+			Kit.box("UpperArm", { 1.38, 0.22, 1.38 }, { 0.02, 0.32, 0 }, "Fabric", mossDark, { 0, 0, -6 }, "Right"),
+			Kit.box("UpperArm", { 1.28, 0.26, 1.28 }, { 0, 0.54, 0 }, "Metal", bronzeTarnish, { 0, 0, 6 }, "Left"),
+			Kit.box("UpperArm", { 1.32, 0.22, 1.32 }, { 0, 0.3, 0 }, "Metal", bronze, { 0, 0, 4 }, "Left"),
+			-- Mould-black sleeves and one bold bronze arm ring a side.
+			Kit.box("UpperArm", { 1.08, 1.24, 1.08 }, { 0, 0, 0 }, "Leather", mould),
+			Kit.box("UpperArm", { 1.16, 0.22, 1.16 }, { 0, -0.24, 0 }, "Metal", bronze),
+			-- Moss creeping over the back where the mantle rotted through.
+			Kit.box("UpperTorso", { 0.5, 0.32, 0.1 }, { 0.5, 0.34, 0.56 }, "Fabric", moss, { 0, 0, 7 }),
+			-- A bone clasp at the collar, off centre.
+			Kit.box("UpperTorso", { 0.24, 0.12, 0.12 }, { 0.18, 0.66, -0.6 }, "Marble", c.bone),
+		},
+	}),
+}
+
+return look
