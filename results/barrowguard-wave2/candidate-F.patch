+--!strict
+-- The barrowguard helm (Barrowguard set): a mould-black leather cowl closed by a
+-- black face mask, under a tarnished bronze crown. A tall bronze crest runs
+-- front to back over the crown and two bronze cheek-wings sweep up past the
+-- temples, so the helm reads bronze and winged from the high camera; only the
+-- bronze nasal and a grave-moss tail at the nape break the dark.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local bronze = { 102, 88, 54 }
+local bronzeTarnish = { 80, 86, 52 }
+local bronzeWorn = { 146, 122, 76 }
+local mould = { 46, 46, 40 }
+local mouldDark = { 34, 34, 30 }
+local mossDark = { 52, 62, 36 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "BarrowguardHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The cowl and the closed lower guard: no eye shows, only the bronze nasal.
+		Kit.box("Head", { 1.34, 0.86, 1.34 }, { 0, 0.22, 0 }, "Leather", mould),
+		Kit.box("Head", { 1.32, 0.62, 1.32 }, { 0, -0.31, 0 }, "Leather", mouldDark),
+		Kit.box("Head", { 0.16, 0.52, 0.12 }, { 0, -0.3, -0.73 }, "Metal", bronzeWorn),
+		-- The crown: a broad rim low over the brow, a dark cap and a tall crest.
+		Kit.box("Head", { 1.46, 0.2, 1.46 }, { 0, 0, 0 }, "Metal", bronze),
+		Kit.box("Head", { 1.06, 0.14, 1.06 }, { 0, 0.7, 0 }, "Metal", bronzeTarnish),
+		Kit.box("Head", { 0.24, 0.46, 1.12 }, { 0, 0.9, 0.02 }, "Metal", bronze),
+		-- The cheek-wings: a broad plate up each side, then a swept bronze blade.
+		Kit.box("Head", { 0.4, 0.75, 0.1 }, { 0.78, 0.18, -0.42 }, "Metal", bronzeTarnish, { 0, 0, -16 }),
+		Kit.box("Head", { 0.46, 0.38, 0.1 }, { 1.02, 0.56, -0.36 }, "Metal", bronze, { 0, 0, -50 }),
+		Kit.box("Head", { 0.4, 0.75, 0.1 }, { -0.78, 0.18, -0.42 }, "Metal", bronzeTarnish, { 0, 0, 16 }),
+		Kit.box("Head", { 0.46, 0.38, 0.1 }, { -1.02, 0.56, -0.36 }, "Metal", bronze, { 0, 0, 50 }),
+		-- The nape tail, gone green where the grave moss took the cloth.
+		Kit.box("Head", { 1.26, 0.5, 0.3 }, { 0, -0.28, 0.72 }, "Fabric", mossDark),
+	},
+}
+
+return look
