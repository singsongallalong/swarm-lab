+		Kit.box("LowerLeg", { 1.16, 0.18, 1.16 }, { 0, 0.4, 0 }, "Fabric", moss),
+		-- The bronze shin plate and its scraped ridge.
+		Kit.box("LowerLeg", { 0.8, 0.62, 0.12 }, { 0, -0.06, -0.57 }, "Metal", bronze),
+		Kit.box("LowerLeg", { 0.12, 0.6, 0.08 }, { 0, -0.06, -0.64 }, "Metal", bronzeWorn),
+		-- The foot and its bronze toe cap.
