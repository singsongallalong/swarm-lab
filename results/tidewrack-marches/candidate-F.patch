+		Kit.box("UpperTorso", { 0.3, 1.4, 0.12 }, { 0.66, 0.03, -0.52 }, "Fabric", drift, { 0, 0, 6 }),
+		Kit.box("UpperTorso", { 0.3, 1.4, 0.12 }, { -0.66, 0.03, -0.52 }, "Fabric", drift, { 0, 0, -6 }),
