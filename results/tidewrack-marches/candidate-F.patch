@@ -0,0 +1,103 @@
+--!strict
+-- The tidewrack tricorne (Tidewrack set, the helm): a driftwood-brown crown
+-- under a brim cocked in a raised triangular rim, so it reads as a hat from
+-- the high camera and not as a helmet; a tarnished brass band and buckle, and
+-- a salt-white plume swept up and back off the right of the crown, tied in
+-- teal. The plume is the set's pale mark on the skyline.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+type ArmourPart = ArmourLookTypes.ArmourPart
+
+local salt = { 172, 164, 146 }
+local saltDim = { 142, 134, 118 }
+local drift = { 120, 104, 84 }
+local driftDark = { 62, 53, 43 }
+local driftPale = { 146, 128, 104 }
+local brass = Kit.colors.brass
+local teal = { 68, 104, 100 }
+
+-- The three panels of a cocked brim in plan: a point to the front, two corners
+-- to the back. `scale` shrinks the triangle toward the crown.
+local FRONT = 0.88
+local BACK = 0.62
+local SIDE = 0.84
+local DEPTH = 0.4
+
+-- The three panels of the brim, and the same triangle stood on edge as a rim,
+-- which is what gives the hat its cocked points.
+local function brim(scale: number, y: number, thick: number, color: { number }): { ArmourPart }
+	local front, back, side = FRONT * scale, BACK * scale, SIDE * scale
+	local length = math.sqrt(side * side + (front + back) * (front + back))
+	local yaw = math.deg(math.atan2(front + back, side))
+	local depth = DEPTH * scale
+	return {
+		Kit.box("Head", { length, thick, depth }, { -side / 2, y, (back - front) / 2 }, "Fabric", color, { 0, yaw, 0 }),
+		Kit.box("Head", { length, thick, depth }, { side / 2, y, (back - front) / 2 }, "Fabric", color, { 0, -yaw, 0 }),
+		Kit.box("Head", { 2 * side, thick, depth }, { 0, y, back }, "Fabric", color),
+	}
+end
+
+local function rim(scale: number, y: number, height: number, color: { number }): { ArmourPart }
+	local front, back, side = FRONT * scale, BACK * scale, SIDE * scale
+	local length = math.sqrt(side * side + (front + back) * (front + back))
+	local radians = math.atan2(front + back, side)
+	local yaw = math.deg(radians)
+	local reach = DEPTH * scale / 2
+	local outX, outZ = math.sin(radians) * reach, math.cos(radians) * reach
+	return {
+		Kit.box(
+			"Head",
+			{ length, height, 0.08 },
+			{ -side / 2 - outX, y, (back - front) / 2 - outZ },
+			"Fabric",
+			color,
+			{ 0, yaw, 0 }
+		),
+		Kit.box(
+			"Head",
+			{ length, height, 0.08 },
+			{ side / 2 + outX, y, (back - front) / 2 - outZ },
+			"Fabric",
+			color,
+			{ 0, -yaw, 0 }
+		),
+		Kit.box("Head", { 2 * side, height, 0.08 }, { 0, y, back + reach }, "Fabric", color),
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = Kit.join({
+		-- A salt-white scarf wrapped round the head under the hat, open at the face.
+		{
+			Kit.box("Head", { 1.24, 1.0, 0.14 }, { 0, 0, 0.63 }, "Fabric", salt),
+			Kit.box("Head", { 0.14, 1.0, 0.94 }, { 0.63, 0, 0.14 }, "Fabric", salt),
+			Kit.box("Head", { 0.14, 1.0, 0.94 }, { -0.63, 0, 0.14 }, "Fabric", salt),
+		},
+		-- The tall crown, stepped to a flat top.
+		{
+			Kit.box("Head", { 1.04, 0.6, 1.04 }, { 0, 0.62, 0 }, "Fabric", drift),
+			Kit.box("Head", { 0.94, 0.1, 0.94 }, { 0, 0.95, 0 }, "Fabric", driftPale),
+		},
+		-- The brim, and its rim cocked up into three points.
+		brim(1, 0.56, 0.1, driftDark),
+		rim(1, 0.71, 0.3, drift),
+		-- The tarnished brass band and its buckle at the front.
+		{
+			Kit.box("Head", { 1.1, 0.1, 1.1 }, { 0, 0.4, 0 }, "Metal", brass),
+			Kit.box("Head", { 0.16, 0.14, 0.08 }, { 0, 0.4, -0.56 }, "Metal", brass),
+		},
+		-- The plume, up and back off the right of the crown, tied in teal.
+		{
+			Kit.box("Head", { 0.3, 0.78, 0.24 }, { 0.5, 0.98, 0.18 }, "Fabric", salt, { 24, 0, -12 }),
+			Kit.box("Head", { 0.22, 0.56, 0.2 }, { 0.64, 0.88, 0.22 }, "Fabric", saltDim, { 18, 0, -30 }),
+			Kit.box("Head", { 0.16, 0.4, 0.16 }, { 0.4, 0.96, 0.24 }, "Fabric", salt, { 28, 0, 4 }),
+			Kit.box("Head", { 0.36, 0.16, 0.24 }, { 0.46, 0.62, 0.14 }, "Fabric", teal, { 0, 0, -10 }),
+		},
+	}),
+}
+
+return look
