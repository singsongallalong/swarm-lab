+-- body's centre line when standing: a panel `width` wide set out by
+-- (width - 1) / 2, written for the right and mirrored onto the left.
+local function panel(
+	width: number,
+	height: number,
+	y: number,
+	z: number,
+	material: string,
+	color: { number },
+	turn: { number }
+): ArmourPart
+	return Kit.box("LowerLeg", { width, height, 0.08 }, { (width - 1) / 2, y, z }, material, color, turn)
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackHem",
+	slot = "Boots",
+	parts = {
+		-- The underskirt on the shins, a tier wider than the thigh's.
+		panel(1.32, 1.16, 0.02, -0.56, "Fabric", salt, { 8, 0, 0 }),
+		panel(1.32, 1.16, 0.02, 0.56, "Fabric", saltDim, { -4, 0, 0 }),
+		Kit.box("LowerLeg", { 0.08, 1.16, 1.28 }, { 0.78, 0.02, 0.02 }, "Fabric", saltDim),
+		-- A ruffle at the knee, closing the join with the thigh's skirt, and the
+		-- flounced hem at the ankle, both bound in teal.
+		panel(1.4, 0.24, 0.56, -0.62, "Fabric", salt, { 12, 0, 0 }),
+		panel(1.5, 0.24, -0.48, -0.64, "Fabric", salt, { 14, 0, 0 }),
+		Kit.box("LowerLeg", { 1.56, 0.1, 0.08 }, { 0.28, -0.53, -0.7 }, "Fabric", teal, { 14, 0, 0 }),
+		-- The coat's back skirt, one continuous driftwood panel behind it.
+		Kit.box("LowerLeg", { 1.5, 1.16, 0.1 }, { 0.25, 0.02, 0.615 }, "Fabric", driftLight),
+		Kit.box("LowerLeg", { 1.56, 0.12, 0.08 }, { 0.28, -0.48, 0.67 }, "Fabric", teal),
+		-- A wet-sand shoe and its tarnished brass buckle.
+		Kit.box("Foot", { 1.12, 0.4, 1.34 }, { 0, 0, -0.1 }, "Leather", sand),
+		Kit.box("Foot", { 0.26, 0.18, 0.08 }, { 0.06, 0.14, -0.68 }, "Metal", brass),
+	},
+}
+
+return look
