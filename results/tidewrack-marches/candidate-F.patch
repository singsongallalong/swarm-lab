+-- fitted waist over a long underskirt that widens toward the shins. The
+-- driftwood coat's back skirt hangs behind as one continuous flared panel,
+-- open at the front; its tails carry on down the shins in the Hem.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+type ArmourPart = ArmourLookTypes.ArmourPart
+
+local salt = { 172, 164, 146 }
+local saltDim = { 142, 134, 118 }
