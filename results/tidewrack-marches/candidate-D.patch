+--!strict
+-- The tidewrack hem (the Tidewrack gown's boots): the skirt carried down the
+-- shins as two salt flounces. Each ends in a thin driftwood flange that
+-- overhangs the flounce below, with a brass edge on the upper one and the
+-- Naga's teal on the hem, so the tiers read as draped fabric. The hem is raised
+-- to the lower shin, showing a salt stocking with a brass ankle ring and a
+-- driftwood slipper with a brass toe.
+
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's palette: salt-white sailcloth, driftwood, tarnished brass, and the
+-- Naga's teal kept to the hem's edge.
+local salt = { 182, 184, 171 }
+local drift = { 118, 104, 82 }
+local brass = { 150, 120, 70 }
+local teal = { 64, 106, 100 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackHem",
+	slot = "Boots",
+	parts = {
+		-- The upper flounce: its top tucks under the thigh tier's flange, and its
+		-- own flange overhangs the lower flounce.
+		Kit.box("LowerLeg", { 1.0, 0.52, 1.05 }, { 0, 0.42, 0 }, "Fabric", salt),
+		Kit.box("LowerLeg", { 1.5, 0.08, 1.55 }, { 0.25, 0.12, 0 }, "Wood", drift),
+		Kit.box("LowerLeg", { 1.54, 0.03, 1.59 }, { 0.27, 0.085, 0 }, "Metal", brass),
+		-- The lower flounce, tucked under the flange above, ending in the hem
+		-- flange and its thin teal edge.
+		Kit.box("LowerLeg", { 1.35, 0.31, 1.4 }, { 0.175, -0.055, 0 }, "Fabric", salt),
+		Kit.box("LowerLeg", { 2.1, 0.09, 2.15 }, { 0.55, -0.25, 0 }, "Wood", drift),
+		Kit.box("LowerLeg", { 2.14, 0.035, 2.19 }, { 0.57, -0.31, 0 }, "Fabric", teal),
+		-- The lower leg: a salt stocking under a brass ankle ring.
+		Kit.box("LowerLeg", { 1.02, 0.32, 1.02 }, { 0.01, -0.44, 0 }, "Fabric", salt),
+		Kit.box("LowerLeg", { 1.06, 0.06, 1.06 }, { 0.03, -0.54, 0 }, "Metal", brass),
+		-- The slipper: driftwood, with a brass toe cap.
+		Kit.box("Foot", { 1.04, 0.32, 1.18 }, { 0, 0.02, -0.06 }, "Leather", drift),
+		Kit.box("Foot", { 0.66, 0.14, 0.14 }, { 0, 0.02, -0.66 }, "Metal", brass),
+	},
+}
+
+return look
