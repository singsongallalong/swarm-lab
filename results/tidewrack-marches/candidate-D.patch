+--!strict
+-- The tidewrack helm (the Tidewrack gown's headpiece): a salt-white sailcloth
+-- snood and veil gathered at the crown, crowned with a comb of salvaged brass
+-- that rises and sweeps back, and a pale shell at the brow. Nothing sits wide
+-- at the ear: the height and the fall are at the back, where the veil hangs.
+
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: salt-white sailcloth, driftwood, tarnished brass, and the
+-- Naga's teal kept to one thin ribbon.
+local salt = { 182, 184, 171 }
+local drift = { 118, 104, 82 }
+local brass = { 150, 120, 70 }
+local teal = { 64, 106, 100 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The snood, drawn close over the crown, and the driftwood band that
+		-- gathers it at the brow.
+		Kit.box("Head", { 1.28, 0.5, 1.28 }, { 0, 0.42, 0 }, "Fabric", salt),
+		Kit.box("Head", { 1.3, 0.1, 1.3 }, { 0, 0.16, 0 }, "Wood", drift),
+		-- The comb: one tall brass fin and two shorter teeth, all sweeping back.
+		Kit.box("Head", { 0.1, 0.88, 0.46 }, { 0, 1.0, 0.16 }, "Metal", brass, { 22, 0, 0 }),
+		Kit.box("Head", { 0.08, 0.54, 0.34 }, { 0.27, 0.82, 0.12 }, "Metal", brass, { 18, 0, 8 }),
+		Kit.box("Head", { 0.08, 0.54, 0.34 }, { -0.27, 0.82, 0.12 }, "Metal", brass, { 18, 0, -8 }),
+		-- A pale shell pinned at the brow, and a teal ribbon gathering the comb.
+		Kit.box("Head", { 0.42, 0.2, 0.12 }, { 0, 0.3, -0.63 }, "Metal", c.bone, { 0, 0, 10 }),
+		Kit.box("Head", { 1.14, 0.07, 0.1 }, { 0, 0.62, 0.66 }, "Fabric", teal),
+		-- The veil: a wide centre fall and two narrow side falls, behind the head,
+		-- weighted at the hem in driftwood so it hangs straight.
+		Kit.box("Head", { 0.95, 1.0, 0.06 }, { 0, 0.02, 0.66 }, "Fabric", salt, { 6, 0, 0 }),
+		Kit.box("Head", { 0.3, 0.9, 0.06 }, { 0.36, 0.0, 0.64 }, "Fabric", salt, { 4, 0, -6 }),
+		Kit.box("Head", { 0.3, 0.9, 0.06 }, { -0.36, 0.0, 0.64 }, "Fabric", salt, { 4, 0, 6 }),
+		Kit.box("Head", { 1.0, 0.08, 0.08 }, { 0, -0.5, 0.72 }, "Wood", drift, { 6, 0, 0 }),
+	},
+}
+
+return look
