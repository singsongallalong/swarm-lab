+--!strict
+-- The tidewrack dress (the Tidewrack gown's chest): a fitted salt sailcloth
+-- bodice with a high collar, a teal choker and a pale shell at the throat; a
+-- narrow teal sash at the waist and a small bustle behind. The skirt's first
+-- tier hangs from the thighs as a salt drum whose thin driftwood flange and
+-- brass edge overhang the shin's flounces (TidewrackHem). The back is ivory
+-- like the front, laced with rope.
+
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+-- The set's palette: salt-white sailcloth, driftwood, tarnished brass, and the
+-- Naga's teal kept to the sash and the choker.
+local salt = { 182, 184, 171 }
+local saltShade = { 148, 150, 140 }
+local drift = { 118, 104, 82 }
+local brass = { 150, 120, 70 }
+local teal = { 64, 106, 100 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice, close over the chest and over the shoulder tops.
+		Kit.box("UpperTorso", { 2.04, 1.64, 1.04 }, { 0, 0.005, 0 }, "Fabric", salt),
+		-- The high collar, the teal choker and a pale shell at the throat.
+		Kit.box("UpperTorso", { 0.86, 0.36, 0.86 }, { 0, 0.9, 0 }, "Fabric", salt),
+		Kit.box("UpperTorso", { 0.9, 0.07, 0.9 }, { 0, 0.86, 0 }, "Fabric", teal),
+		Kit.box("UpperTorso", { 0.18, 0.18, 0.1 }, { 0, 0.98, -0.47 }, "Metal", c.bone),
+		-- The back, ivory like the front, rope-laced above the small bustle.
+		Kit.box("UpperTorso", { 0.06, 1.05, 0.06 }, { 0, -0.06, 0.56 }, "Fabric", c.rope, { 0, 0, 24 }),
+		Kit.box("UpperTorso", { 0.06, 1.05, 0.06 }, { 0, -0.06, 0.56 }, "Fabric", c.rope, { 0, 0, -24 }),
+		Kit.box("UpperTorso", { 0.14, 0.12, 0.1 }, { 0, -0.52, 0.56 }, "Fabric", c.rope),
+		-- The waist: the teal sash is the whole waist's width, so it reads as the
+		-- narrowest point; a thin brass line and an off-centre buckle below it.
+		Kit.box("LowerTorso", { 2.02, 0.4, 1.02 }, { 0, 0, 0 }, "Fabric", teal),
+		Kit.box("LowerTorso", { 2.05, 0.04, 1.05 }, { 0, -0.15, 0 }, "Metal", brass),
+		Kit.box("LowerTorso", { 0.18, 0.16, 0.08 }, { 0.35, 0.02, -0.55 }, "Metal", brass),
+		-- The bustle, kept inside the lower torso so it never crosses a thigh.
+		Kit.box("LowerTorso", { 1.3, 0.32, 0.26 }, { 0, 0.02, 0.55 }, "Fabric", salt),
+		Kit.box("LowerTorso", { 1.1, 0.26, 0.2 }, { 0, -0.05, 0.66 }, "Fabric", saltShade),
+		-- Close sleeves on the upper arms, banded in driftwood above the elbow;
+		-- the flare is the gloves' work.
+		Kit.box("UpperArm", { 1.04, 1.22, 1.04 }, { 0, 0.01, 0 }, "Fabric", salt),
+		Kit.box("UpperArm", { 1.08, 0.08, 1.08 }, { 0, -0.5, 0 }, "Wood", drift),
+		-- The skirt's first tier, hung from the thighs: a salt drum ended by a
+		-- thin driftwood flange and a brass edge. The flange overhangs the shin's
+		-- flounces below, so the tiers read as draped fabric, not a plinth.
+		Kit.box("UpperLeg", { 1.05, 1.26, 1.1 }, { 0.025, 0.12, 0 }, "Fabric", salt),
+		Kit.box("UpperLeg", { 1.16, 0.08, 1.22 }, { 0.08, -0.54, 0 }, "Wood", drift),
+		Kit.box("UpperLeg", { 1.2, 0.03, 1.26 }, { 0.1, -0.585, 0 }, "Metal", brass),
+		Kit.box("UpperLeg", { 0.12, 0.62, 0.07 }, { 0.12, 0.44, -0.55 }, "Fabric", teal, { 0, 0, 8 }, "Right"),
+		Kit.box("UpperLeg", { 0.09, 0.52, 0.07 }, { 0.24, 0.48, -0.56 }, "Fabric", teal, { 0, 0, -6 }, "Right"),
+	},
+}
+
+return look
