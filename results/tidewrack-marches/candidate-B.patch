+--!strict
+-- The Tidewrack crest (zone armour, the Sunken Shelf's gown): a driftwood
+-- circlet bound in tarnished brass under a cap of bleached bone, and rising
+-- from it a fan of thick shell ridges, warm as wet sand and coral, with a
+-- blunt ridge down the crown and a salt veil behind. The fan opens only above
+-- the crown; at the ear the head stays as narrow as a head, so it still reads
+-- as a woman's.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local bone = { 204, 192, 168 } -- bleached bone, warmed toward sand
+local shell = { 194, 166, 138 } -- wet sand and coral shell
+local shellShade = { 160, 134, 112 } -- the ridges' shadowed side
+local driftwood = { 118, 104, 86 } -- sun-greyed wreck timber
+local salt = { 214, 206, 188 } -- salt-white veil
+local sand = { 170, 152, 122 } -- wet sand, the veil's under-tier
+local teal = { 74, 122, 118 } -- the Naga's teal, one bead only
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackCrest",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The circlet, its brass line, the Naga bead at the brow and the clasp
+		-- at the nape, under a low cap of bone over the crown.
+		Kit.box("Head", { 1.32, 0.18, 1.32 }, { 0, 0.22, 0 }, "Wood", driftwood),
+		Kit.box("Head", { 1.34, 0.06, 1.34 }, { 0, 0.32, 0 }, "Metal", c.brass),
+		Kit.box("Head", { 0.13, 0.16, 0.08 }, { 0, 0.22, -0.665 }, "SmoothPlastic", teal),
+		Kit.box("Head", { 0.14, 0.13, 0.08 }, { 0, 0.22, 0.665 }, "Metal", c.brass),
+		Kit.box("Head", { 1.26, 0.34, 1.26 }, { 0, 0.46, 0 }, "SmoothPlastic", bone),
+		-- The fan: a broad shell backplate and five thick ridges fanning from
+		-- it, centre tallest, the two outside each side turned out and down.
+		Kit.box("Head", { 1.2, 0.3, 0.14 }, { 0, 0.76, 0.34 }, "SmoothPlastic", shellShade, { -8, 0, 0 }),
+		Kit.box("Head", { 0.24, 0.66, 0.34 }, { 0, 0.98, 0.24 }, "SmoothPlastic", shell, { -8, 0, 0 }),
+		Kit.box("Head", { 0.22, 0.56, 0.3 }, { 0.26, 0.92, 0.26 }, "SmoothPlastic", shellShade, { 0, 0, -18 }),
+		Kit.box("Head", { 0.2, 0.46, 0.26 }, { 0.5, 0.84, 0.28 }, "SmoothPlastic", shell, { 0, 0, -36 }),
+		Kit.box("Head", { 0.22, 0.56, 0.3 }, { -0.26, 0.92, 0.26 }, "SmoothPlastic", shellShade, { 0, 0, 18 }),
+		Kit.box("Head", { 0.2, 0.46, 0.26 }, { -0.5, 0.84, 0.28 }, "SmoothPlastic", shell, { 0, 0, 36 }),
+		-- A blunt ridge down the back of the crown, for the side view.
+		Kit.box("Head", { 0.16, 0.46, 0.5 }, { 0, 0.88, 0.5 }, "SmoothPlastic", shellShade, { 26, 0, 0 }),
+		-- The salt veil in two tiers behind.
+		Kit.box("Head", { 1.04, 0.48, 0.05 }, { 0, 0.16, 0.66 }, "Fabric", salt),
+		Kit.box("Head", { 0.92, 0.28, 0.04 }, { 0, -0.2, 0.69 }, "Fabric", sand, { -8, 0, 0 }),
+	},
+}
+
+return look
