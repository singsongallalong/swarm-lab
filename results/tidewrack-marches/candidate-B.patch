+--!strict
+-- The Tidewrack sleeves (zone armour, the Sunken Shelf's gown): the gown's
+-- forearm, full where it should be. A bleached bone hoop closes the sleeve at
+-- the elbow, the wet-sand cloth narrows down the forearm and opens into a
+-- salt cuff with a thin Naga-teal lining, and a dark driftwood glove closes
+-- the hand with one brass clasp at the knuckle. Nothing flares at the shoulder.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local bone = { 204, 192, 168 } -- bleached bone
+local sand = { 170, 152, 122 } -- wet sand, the sleeve
+local salt = { 214, 206, 188 } -- salt-white cuff
+local teal = { 74, 122, 118 } -- the Naga's teal, one lining only
+local driftwoodDark = { 88, 76, 63 } -- soaked timber, the glove
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The bone hoop at the elbow, over the sleeve's top.
+		Kit.box("LowerArm", { 1.3, 0.1, 1.3 }, { 0, 0.44, 0 }, "SmoothPlastic", bone),
+		Kit.box("LowerArm", { 1.2, 0.32, 1.2 }, { 0, 0.22, 0 }, "Fabric", sand),
+		-- The forearm narrows, then the cuff opens.
+		Kit.box("LowerArm", { 1.1, 0.36, 1.1 }, { 0, -0.14, 0 }, "Fabric", sand),
+		Kit.box("LowerArm", { 1.26, 0.24, 1.26 }, { 0, -0.38, 0 }, "Fabric", salt),
+		Kit.box("LowerArm", { 1.16, 0.06, 1.16 }, { 0, -0.5, 0 }, "Fabric", teal),
+		-- The glove, and a brass clasp on its back.
+		Kit.box("Hand", { 1.1, 0.38, 1.1 }, { 0, 0, 0 }, "Leather", driftwoodDark),
+		Kit.box("Hand", { 0.1, 0.1, 0.12 }, { 0.3, 0.02, -0.56 }, "Metal", c.brass),
+	},
+}
+
+return look
