+			Kit.box("UpperTorso", { 2.08, 0.1, 1.08 }, { 0, 0.74, 0 }, "Fabric", salt),
+			Kit.box("UpperTorso", { 0.16, 0.16, 0.07 }, { 0, 0.74, -0.555 }, "SmoothPlastic", teal, { 0, 0, 45 }),
+			-- A salt bow low on the back, its tails short of the skirt.
+			Kit.box("UpperTorso", { 0.22, 0.24, 0.14 }, { 0, -0.52, 0.58 }, "Fabric", sand),
+			Kit.box("UpperTorso", { 0.5, 0.28, 0.1 }, { -0.36, -0.48, 0.59 }, "Fabric", salt, { 0, 0, 18 }),
+			Kit.box("UpperTorso", { 0.5, 0.28, 0.1 }, { 0.36, -0.48, 0.59 }, "Fabric", salt, { 0, 0, -18 }),
+			Kit.box("UpperTorso", { 0.16, 0.46, 0.06 }, { -0.12, -0.74, 0.59 }, "Fabric", salt, { 0, 0, 5 }),
+			Kit.box("UpperTorso", { 0.13, 0.36, 0.06 }, { 0.14, -0.68, 0.59 }, "Fabric", salt, { 0, 0, -6 }),
+			-- The fitted upper sleeve, close to the arm.
+			Kit.box("UpperArm", { 1.1, 1.18, 1.1 }, { 0, 0, 0 }, "Fabric", sand),
+			-- The sash: wet sand bound in salt, a brass buckle and a salt knot.
+			Kit.box("LowerTorso", { 2.1, 0.4, 1.1 }, { 0, 0, 0 }, "Fabric", sand),
+			Kit.box("LowerTorso", { 2.12, 0.08, 1.12 }, { 0, 0.14, 0 }, "Fabric", salt),
+			Kit.box("LowerTorso", { 2.12, 0.08, 1.12 }, { 0, -0.14, 0 }, "Fabric", salt),
+			Kit.box("LowerTorso", { 0.18, 0.18, 0.08 }, { 0.3, 0, -0.57 }, "Metal", c.brass, { 0, 0, 45 }),
+			Kit.box("LowerTorso", { 0.22, 0.22, 0.14 }, { -0.38, 0.01, -0.6 }, "Fabric", salt),
+		},
+		{
+			-- The hip tier: front, back and outer panels meeting at the centre.
+			Kit.box("UpperLeg", { 1.16, 0.72, 0.08 }, { 0.08, 0.42, -0.56 }, "Fabric", driftwood),
+			Kit.box("UpperLeg", { 1.16, 0.72, 0.08 }, { 0.08, 0.42, 0.56 }, "Fabric", driftwood),
+			Kit.box("UpperLeg", { 0.09, 0.78, 1.14 }, { 0.58, 0.41, 0 }, "Fabric", driftwoodDark, { 0, 0, 4 }),
+			-- The wider second tier below the hands, hooped in bone.
+			Kit.box("UpperLeg", { 1.66, 0.56, 0.08 }, { 0.33, -0.25, -0.64 }, "Fabric", driftwood),
+			Kit.box("UpperLeg", { 1.66, 0.56, 0.08 }, { 0.33, -0.25, 0.64 }, "Fabric", driftwood),
+			Kit.box("UpperLeg", { 0.09, 0.58, 1.4 }, { 0.9, -0.25, 0 }, "Fabric", driftwoodDark, { 0, 0, 8 }),
+			Kit.box("UpperLeg", { 1.64, 0.09, 0.07 }, { 0.33, -0.2, -0.695 }, "SmoothPlastic", bone),
+			Kit.box("UpperLeg", { 1.64, 0.09, 0.07 }, { 0.33, -0.2, 0.695 }, "SmoothPlastic", bone),
