+--!strict
+-- The Tidewrack hem (zone armour, the Sunken Shelf's gown): the skirt's lowest
+-- tier, carried on the shins where the thigh's panels stop at the knee. Each
+-- shin's front, back and outer panels step out far wider than the tiers above
+-- and close into a bell at the hem, with the last bleached bone hoop around
+-- them and a salt ruffle showing under the edge. Below sit dark driftwood
+-- slippers.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local bone = { 204, 192, 168 } -- bleached bone
+local driftwood = { 118, 104, 86 } -- sun-greyed wreck timber, the skirt
+local driftwoodDark = { 88, 76, 63 } -- the shadowed side panels
+local salt = { 214, 206, 188 } -- salt-white ruffle
+local sand = { 170, 152, 122 } -- wet sand, the slipper
+local sandDark = { 112, 96, 78 } -- its soaked sole and heel
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "TidewrackHem",
+	slot = "Boots",
+	parts = {
+		-- The lower skirt: far wider than the knee's tier, meeting at the centre.
+		Kit.box("LowerLeg", { 2, 1.42, 0.08 }, { 0.5, 0.07, -0.8 }, "Fabric", driftwood),
+		Kit.box("LowerLeg", { 2, 1.42, 0.08 }, { 0.5, 0.07, 0.8 }, "Fabric", driftwood),
+		Kit.box("LowerLeg", { 0.09, 1.42, 1.7 }, { 1.15, 0.07, 0 }, "Fabric", driftwoodDark, { 0, 0, 10 }),
+		-- The hem's bone hoop, in three lengths around the skirt.
+		Kit.box("LowerLeg", { 1.96, 0.09, 0.07 }, { 0.5, -0.42, -0.855 }, "SmoothPlastic", bone),
+		Kit.box("LowerLeg", { 1.96, 0.09, 0.07 }, { 0.5, -0.42, 0.855 }, "SmoothPlastic", bone),
+		Kit.box("LowerLeg", { 0.07, 0.09, 1.64 }, { 1.2, -0.42, 0 }, "SmoothPlastic", bone, { 0, 0, 10 }),
+		-- A salt ruffle under the hem, front and back.
+		Kit.box("LowerLeg", { 2.02, 0.16, 0.08 }, { 0.5, -0.6, -0.83 }, "Fabric", salt),
+		Kit.box("LowerLeg", { 2.02, 0.16, 0.08 }, { 0.5, -0.6, 0.83 }, "Fabric", salt),
+		-- The slipper, its sole and a brass heel.
+		Kit.box("Foot", { 1.06, 0.34, 1.14 }, { 0, 0, -0.06 }, "Leather", sand),
+		Kit.box("Foot", { 1.08, 0.1, 1.16 }, { 0, -0.14, -0.06 }, "Leather", sandDark),
+		Kit.box("Foot", { 1.06, 0.14, 0.18 }, { 0, -0.15, 0.43 }, "Metal", c.brass),
+	},
+}
+
+return look
