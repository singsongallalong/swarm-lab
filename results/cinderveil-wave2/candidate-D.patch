+		-- thigh and as a crack down the left, never as a ring.
+		Kit.box("UpperLeg", { 1.16, 0.55, 1.34 }, { 0.08, 0.475, 0 }, "Fabric", BASALT),
+		Kit.box("UpperLeg", { 1.38, 0.69, 1.68 }, { 0.19, -0.105, 0.03 }, "Fabric", BASALT),
+		Kit.box("UpperLeg", { 0.22, 0.06, 0.5 }, { 0.77, 0.25, 0.5 }, "SmoothPlastic", EMBER, nil, "Right"),
+		Kit.box("UpperLeg", { 0.05, 0.5, 0.05 }, { 0.45, -0.12, -0.87 }, "SmoothPlastic", EMBER, { 0, 0, 12 }, "Left"),
+	},
+}
