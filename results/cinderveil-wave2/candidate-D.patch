+local BASALT = { 78, 72, 84 }
+local ASH = { 172, 166, 168 }
+local EMBER = { 202, 62, 38 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The sleeve: slim at the elbow, deepening down the forearm to a full
+		-- cuff, with a lit edge and an ash frill at the wrist.
+		Kit.box("LowerArm", { 1.06, 0.5, 1.08 }, { 0, 0.36, 0 }, "Fabric", SLEEVE),
+		Kit.box("LowerArm", { 1.16, 0.44, 1.28 }, { 0, -0.03, 0 }, "Fabric", SLEEVE),
+		Kit.box("LowerArm", { 1.26, 0.42, 1.44 }, { 0, -0.4, 0 }, "Fabric", SLEEVE),
+		Kit.box("LowerArm", { 1.3, 0.08, 1.48 }, { 0, -0.55, 0 }, "SmoothPlastic", EMBER),
+		Kit.box("LowerArm", { 1.18, 0.14, 1.36 }, { 0, -0.65, 0 }, "Fabric", ASH),
+		-- A close basalt glove and a thin lit seam across the knuckles.
+		Kit.box("Hand", { 1.08, 0.32, 1.08 }, { 0, 0, 0 }, "Leather", BASALT),
+		Kit.box("Hand", { 0.9, 0.06, 0.06 }, { 0, 0.05, -0.53 }, "SmoothPlastic", EMBER),
+	},
+}
+
+return look
