+-- one much deeper than the upper, with a pale ash band at the knee and a broad
+-- ash frill at the floor. The red never rings the skirt: it shows in a gap at
+-- the fold on the right shin, a crack down the left and a short lit hem edge,
+-- with a close basalt shoe beneath.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The mountain's devotees: dark basalt, pale ash and magma red in the seams.
+local BASALT = { 78, 72, 84 }
+local ASH = { 172, 166, 168 }
+local EMBER = { 202, 62, 38 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilHem",
+	slot = "Boots",
+	parts = {
+		-- Two deep tiers on each shin, the hem tier much wider and deeper than
+		-- the one above, with an ash band at the knee.
+		Kit.box("LowerLeg", { 1.6, 0.77, 2.02 }, { 0.3, 0.435, -0.02 }, "Fabric", BASALT),
+		Kit.box("LowerLeg", { 1.9, 0.78, 2.52 }, { 0.45, -0.29, 0.2 }, "Fabric", BASALT),
+		Kit.box("LowerLeg", { 1.64, 0.08, 2.06 }, { 0.32, 0.79, -0.02 }, "Fabric", ASH),
+		-- The red: a sliver in the fold on the right shin, a crack down the
+		-- left front and a short lit edge on the left of the hem.
+		Kit.box("LowerLeg", { 0.28, 0.07, 0.6 }, { 1.25, 0.1, 0.55 }, "SmoothPlastic", EMBER, nil, "Right"),
+		Kit.box("LowerLeg", { 0.05, 0.5, 0.06 }, { 0.6, -0.35, -1.09 }, "SmoothPlastic", EMBER, { 0, 0, 10 }, "Left"),
+		Kit.box("LowerLeg", { 0.05, 0.35, 0.06 }, { 0.7, -0.55, 1.49 }, "SmoothPlastic", EMBER, { 0, 0, -8 }, "Right"),
+		-- A broad ash frill under the black hem, with one short lit edge.
+		Kit.box("LowerLeg", { 1.94, 0.16, 2.58 }, { 0.47, -0.76, 0.2 }, "Fabric", ASH),
+		Kit.box("LowerLeg", { 0.7, 0.06, 2.62 }, { 0.45, -0.82, 0.2 }, "SmoothPlastic", EMBER, nil, "Left"),
+		-- A close basalt shoe with a lit welt.
+		Kit.box("Foot", { 1.08, 0.3, 1.08 }, { 0, 0.005, -0.02 }, "Leather", BASALT),
+		Kit.box("Foot", { 1.1, 0.04, 1.1 }, { 0, -0.13, -0.02 }, "SmoothPlastic", EMBER),
+	},
+}
+
+return look
