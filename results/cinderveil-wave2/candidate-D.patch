+--!strict
+-- The Cinderveil dress (Aor'lan Mountain, levels 20-25): the gown's bodice and
+-- upper skirt. A fitted basalt bodice with a low ash collar and an ash placket
+-- that opens into a V from a sulphur brooch at its point, a magma sash over a
+-- pale ash belt at the narrow waist, a big magma bow at the back of the waist,
+-- and two deep skirt tiers hung from each thigh. The red does not ring the
+-- skirt: it shows in two uneven cracks, one a gap at the fold on the right
+-- thigh and one down the left. The sleeves stay close and slim.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The mountain's devotees: dark basalt, pale ash, magma red in the seams and
+-- a little sulphur where the rock burns hottest.
+local BASALT = { 78, 72, 84 }
+local SLEEVE = { 54, 50, 60 }
+local ASH = { 172, 166, 168 }
+local MAGMA = { 150, 44, 34 }
+local EMBER = { 202, 62, 38 }
+local SULPHUR = { 205, 168, 68 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice: fitted basalt, an ash placket tapering to a point with a
+		-- sulphur brooch, an ash V above it edged in magma, a low ash collar
+		-- and one magma crack down the black.
+		Kit.box("UpperTorso", { 2.08, 1.62, 1.1 }, { 0, 0, 0 }, "Fabric", BASALT),
+		Kit.box("UpperTorso", { 0.6, 0.56, 0.07 }, { 0, -0.1, -0.555 }, "Fabric", ASH),
+		Kit.box("UpperTorso", { 0.48, 0.14, 0.07 }, { -0.17, 0.28, -0.562 }, "Fabric", ASH, { 0, 0, -30 }),
+		Kit.box("UpperTorso", { 0.48, 0.14, 0.07 }, { 0.17, 0.28, -0.562 }, "Fabric", ASH, { 0, 0, 30 }),
+		Kit.box("UpperTorso", { 0.5, 0.05, 0.06 }, { -0.205, 0.34, -0.6 }, "SmoothPlastic", EMBER, { 0, 0, -30 }),
+		Kit.box("UpperTorso", { 0.5, 0.05, 0.06 }, { 0.205, 0.34, -0.6 }, "SmoothPlastic", EMBER, { 0, 0, 30 }),
+		Kit.box("UpperTorso", { 0.13, 0.13, 0.08 }, { 0, 0.16, -0.62 }, "Metal", SULPHUR, { 0, 0, 45 }),
+		Kit.box("UpperTorso", { 0.05, 0.5, 0.05 }, { 0, -0.1, -0.605 }, "SmoothPlastic", EMBER),
+		Kit.box("UpperTorso", { 0.05, 0.44, 0.05 }, { -0.55, 0.3, -0.6 }, "SmoothPlastic", EMBER, { 0, 0, 8 }),
+		Kit.box("UpperTorso", { 0.86, 0.2, 0.24 }, { 0, 0.8, 0.14 }, "Fabric", ASH),
+		Kit.box("UpperTorso", { 0.9, 0.06, 0.26 }, { 0, 0.88, 0.14 }, "SmoothPlastic", EMBER),
+		-- The upper sleeves, close to the arm and a shade darker than the
+		-- bodice, with a lit seam above the elbow.
+		Kit.box("UpperArm", { 1.08, 1.2, 1.06 }, { 0, 0, 0 }, "Fabric", SLEEVE),
+		Kit.box("UpperArm", { 1.1, 0.05, 1.08 }, { 0, -0.55, 0 }, "SmoothPlastic", EMBER),
+		-- The waist: a magma sash over a pale ash belt, the narrowest point.
+		Kit.box("LowerTorso", { 2.04, 0.4, 1.04 }, { 0, 0, 0 }, "Fabric", BASALT),
+		Kit.box("LowerTorso", { 2.06, 0.14, 1.06 }, { 0, 0.105, 0 }, "Fabric", MAGMA),
+		Kit.box("LowerTorso", { 2.08, 0.04, 1.08 }, { 0, 0.175, 0 }, "SmoothPlastic", EMBER),
+		Kit.box("LowerTorso", { 2.08, 0.08, 1.08 }, { 0, -0.03, 0 }, "Fabric", ASH),
+		-- A big magma bow at the back of the waist, its knot lit, its tails
+		-- hanging behind the skirt.
+		Kit.box("LowerTorso", { 0.46, 0.3, 0.14 }, { -0.3, 0.09, 0.58 }, "Fabric", MAGMA, { 0, 0, 16 }),
+		Kit.box("LowerTorso", { 0.46, 0.3, 0.14 }, { 0.3, 0.09, 0.58 }, "Fabric", MAGMA, { 0, 0, -16 }),
+		Kit.box("LowerTorso", { 0.18, 0.22, 0.18 }, { 0, 0.09, 0.64 }, "Fabric", EMBER),
+		Kit.box("LowerTorso", { 0.15, 0.3, 0.07 }, { -0.14, -0.05, 0.69 }, "Fabric", MAGMA, { 0, 0, 6 }),
+		Kit.box("LowerTorso", { 0.15, 0.3, 0.07 }, { 0.14, -0.05, 0.69 }, "Fabric", MAGMA, { 0, 0, -6 }),
+		-- The upper skirt on each thigh: two deep tiers, the lower one deeper
+		-- than the upper, with the inner edges at the centre so the two legs'
