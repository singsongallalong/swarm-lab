+--!strict
+-- The Cinderveil helm (Aor'lan Mountain, levels 20-25): a tiny horned bonnet
+-- of basalt cloth with a broad ash brim framing the face, a lit magma circlet
+-- above it set with a sulphur jewel, and a pale panel on the crown; two small
+-- iron horns tipped with sulphur; a magma bow on the crown and one ribbon at
+-- the cheek. It rises up and back and never wide at ear level, so the headpiece
+-- reads as a bonnet, not a helmet.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The mountain's devotees: dark basalt, pale ash, magma red in the seams and
+-- a little sulphur where the rock burns hottest.
+local BASALT = { 78, 72, 84 }
+local ASH = { 172, 166, 168 }
+local MAGMA = { 150, 44, 34 }
+local EMBER = { 202, 62, 38 }
+local SULPHUR = { 205, 168, 68 }
+
+-- A slim iron horn rising from the bonnet, tipped with sulphur.
+local function horn(size: { number }, at: { number }, turn: { number }, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "Head",
+		shape = "Cylinder",
+		size = size,
+		at = at,
+		turn = turn,
+		material = "Metal",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bonnet: a soft crown, a broad ash brim round the brow, the lit
+		-- circlet with its sulphur jewel, and a pale panel on top.
+		Kit.box("Head", { 1.26, 0.54, 1.26 }, { 0, 0.38, 0.02 }, "Fabric", BASALT),
+		Kit.box("Head", { 1.36, 0.16, 1.36 }, { 0, 0.1, 0.02 }, "Fabric", ASH),
+		Kit.box("Head", { 1.32, 0.06, 1.32 }, { 0, 0.21, 0.02 }, "SmoothPlastic", EMBER),
+		Kit.box("Head", { 0.96, 0.14, 0.96 }, { 0, 0.7, 0.02 }, "Fabric", ASH),
+		Kit.box("Head", { 0.14, 0.14, 0.1 }, { 0, 0.22, -0.67 }, "Metal", SULPHUR, { 0, 0, 45 }),
+		-- The drape at the back, falling to a lit tip at the nape.
+		Kit.box("Head", { 0.98, 0.66, 0.3 }, { 0, -0.08, 0.55 }, "Fabric", BASALT),
+		Kit.box("Head", { 0.62, 0.3, 0.16 }, { 0, -0.52, 0.58 }, "Fabric", BASALT),
+		Kit.box("Head", { 0.66, 0.06, 0.18 }, { 0, -0.65, 0.58 }, "SmoothPlastic", EMBER),
+		-- Two small iron horns, leaning out, with sulphur tips.
+		horn({ 0.17, 0.46, 0.17 }, { 0.36, 0.72, 0.06 }, { 0, 0, -18 }, BASALT),
+		horn({ 0.09, 0.14, 0.09 }, { 0.43, 0.99, 0.06 }, { 0, 0, -18 }, SULPHUR),
+		horn({ 0.17, 0.46, 0.17 }, { -0.36, 0.72, 0.06 }, { 0, 0, 18 }, BASALT),
+		horn({ 0.09, 0.14, 0.09 }, { -0.43, 0.99, 0.06 }, { 0, 0, 18 }, SULPHUR),
+		-- The magma bow on the crown's pale panel, its knot lit, and one ribbon
+		-- at the cheek for the bonnet's tie.
+		Kit.box("Head", { 0.42, 0.22, 0.22 }, { -0.21, 0.8, -0.16 }, "Fabric", MAGMA, { 0, 0, 14 }),
+		Kit.box("Head", { 0.42, 0.22, 0.22 }, { 0.21, 0.8, -0.16 }, "Fabric", MAGMA, { 0, 0, -14 }),
+		Kit.box("Head", { 0.18, 0.22, 0.2 }, { 0, 0.8, -0.12 }, "Fabric", EMBER),
+		Kit.box("Head", { 0.09, 0.46, 0.08 }, { 0.64, -0.16, -0.02 }, "Fabric", MAGMA, { 0, 0, 5 }),
+	},
+}
+
+return look
