+--!strict
+-- The Cinderveil veil (the Cinderveil set's helm): a deep ash-grey hood
+-- gathered to a point above and behind the head, open at the face, and banded
+-- by a thin pale circlet with a cinder at the brow. The long veil falls like
+-- vent smoke, its pale panels edged with a magma-red lining, one wisp adrift.
+-- Height and fall, nothing wide at the ears; a circlet, not a mask.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local SMOKE = { 80, 76, 73 }
+local ASH = { 100, 96, 92 }
+local ASH_PALE = { 124, 119, 112 }
+local SULPHUR = { 150, 134, 70 }
+local MAGMA = { 132, 48, 36 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The ash-grey hood shell: back, sides and crown, left open at the face.
+		Kit.box("Head", { 1.38, 1.16, 0.18 }, { 0, 0.02, 0.55 }, "Fabric", SMOKE),
+		Kit.box("Head", { 0.14, 1.06, 1.06 }, { 0.61, -0.02, 0.06 }, "Fabric", SMOKE),
+		Kit.box("Head", { 0.14, 1.06, 1.06 }, { -0.61, -0.02, 0.06 }, "Fabric", SMOKE),
+		Kit.box("Head", { 1.34, 0.22, 1.2 }, { 0, 0.66, 0.06 }, "Fabric", SMOKE),
+		-- The peak, stepping up and back, tipped in sulphur.
+		Kit.box("Head", { 0.84, 0.24, 0.8 }, { 0, 0.82, 0.24 }, "Fabric", SMOKE),
+		Kit.box("Head", { 0.4, 0.28, 0.36 }, { 0, 0.98, 0.38 }, "Fabric", SMOKE),
+		Kit.box("Head", { 0.42, 0.07, 0.38 }, { 0, 1.14, 0.38 }, "Fabric", SULPHUR),
+		-- A thin pale circlet across the brow, edged in sulphur.
+		Kit.box("Head", { 0.88, 0.06, 0.1 }, { 0, 0.51, -0.6 }, "Fabric", ASH_PALE),
+		Kit.box("Head", { 0.9, 0.035, 0.11 }, { 0, 0.565, -0.605 }, "Fabric", SULPHUR),
+		-- A cinder set at the brow, glowing like the mountain's cracks.
+		Kit.box("Head", { 0.15, 0.15, 0.08 }, { 0, 0.42, -0.66 }, "Neon", MAGMA, { 0, 0, 45 }),
+		-- The smoke veil: pale panels with a magma-red lining along their edges.
+		Kit.box("Head", { 1.06, 1.1, 0.06 }, { 0, -0.32, 0.7 }, "Fabric", ASH, { 8, 0, 0 }),
+		Kit.box("Head", { 1.18, 1.04, 0.04 }, { 0, -0.3, 0.65 }, "Fabric", MAGMA, { 8, 0, 0 }),
+		Kit.box("Head", { 0.78, 0.85, 0.05 }, { 0, -1.1, 0.83 }, "Fabric", ASH_PALE, { 10, 0, 0 }),
+		Kit.box("Head", { 0.8, 0.06, 0.06 }, { 0, -1.53, 0.91 }, "Fabric", SULPHUR, { 10, 0, 0 }),
+		-- One wisp drifting off to the left, so the veil is not a mirror.
+		Kit.box("Head", { 0.26, 0.62, 0.05 }, { -0.47, -0.75, 0.78 }, "Fabric", ASH, { 6, 0, -8 }),
+	},
+}
+
+return look
