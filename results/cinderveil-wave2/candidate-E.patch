+		Kit.box("LowerLeg", { 0.12, SKIRT, 1.35 }, { 1.0, SKIRT_Y, 0 }, "Fabric", SMOKE),
+		-- The right front edge wraps over in sulphur.
+		Kit.box("LowerLeg", { 0.09, SKIRT, 0.06 }, { -0.5, SKIRT_Y, -0.78 }, "Fabric", SULPHUR, { 14, 0, 0 }, "Right"),
+		-- The pale ash tuck at the knee.
+		Kit.box("LowerLeg", { 1.7, 0.14, 0.05 }, { 0.35, 0.6, -0.64 }, "Fabric", ASH, { 14, 0, 0 }),
+		-- The bold sulphur hem, proud of the cloth so its top face reads from above.
+		Kit.box("LowerLeg", { 1.72, 0.22, 0.1 }, { 0.36, -0.5, -0.91 }, "Fabric", SULPHUR, { 14, 0, 0 }),
+		Kit.box("LowerLeg", { 1.72, 0.22, 0.1 }, { 0.36, -0.5, 0.91 }, "Fabric", SULPHUR, { -14, 0, 0 }),
+		Kit.box("LowerLeg", { 0.12, 0.22, 1.72 }, { 1.12, -0.5, 0 }, "Fabric", SULPHUR),
+		-- The pale petticoat under the hem, and a dark knee side so the bare
+		-- shin never shows between the two skirt tiers.
+		Kit.box("LowerLeg", { 1.0, 0.26, 1.0 }, { 0, -0.56, 0 }, "Fabric", ASH),
+		Kit.box("LowerLeg", { 0.18, 0.36, 1.1 }, { 0.58, 0.46, 0 }, "Fabric", SMOKE),
+		-- One bold cinder seam on each grey gore.
+		Kit.box("LowerLeg", { 0.1, 0.8, 0.06 }, { 0.9, 0.0, -0.78 }, "Neon", EMBER, { 14, 0, -8 }),
+		-- The pointed slipper, low-heeled, with a sulphur strap.
