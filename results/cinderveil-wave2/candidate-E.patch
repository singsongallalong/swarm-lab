+--!strict
+-- The Cinderveil dress (the Cinderveil set's chest): a basalt-black bodice
+-- with a low ash neckline and a slim neck band, a broad magma-red sash at the
+-- waist under a pale belt, and a wide bell skirt hung from the thighs. The
+-- skirt is built in two tones: a black outer skirt with a red centre stripe
+-- running from the sash to the knee, over the pale grey underskirt that the
+-- boots carry on to the hem. The upper sleeves are close grey sleeves; all the
+-- volume is at the gloves' bell cuffs.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local BASALT = { 44, 40, 44 }
+local BASALT_DARK = { 28, 26, 30 }
+local SMOKE = { 80, 76, 73 }
+local ASH = { 100, 96, 92 }
+local SULPHUR = { 150, 134, 70 }
+local MAGMA = { 132, 48, 36 }
+local EMBER = { 172, 56, 36 }
+
+-- How far the upper skirt runs down the thigh from just above its top.
+local SKIRT = 1.3
+local SKIRT_Y = 0.75 - SKIRT / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice, its darker fitted front, and a slim neck band.
+			Kit.box("UpperTorso", { 2.08, 1.62, 1.04 }, { 0, 0.01, 0 }, "Fabric", BASALT),
+			Kit.box("UpperTorso", { 1.0, 1.04, 0.04 }, { 0, -0.12, -0.54 }, "Fabric", BASALT_DARK),
+			Kit.box("UpperTorso", { 1.26, 0.12, 1.18 }, { 0, 0.78, 0 }, "Fabric", ASH),
+			Kit.box("UpperTorso", { 1.3, 0.04, 1.22 }, { 0, 0.85, 0 }, "Fabric", SULPHUR),
+			-- A short ash sweetheart neckline, with a gold brooch at its point.
+			Kit.box("UpperTorso", { 0.09, 0.4, 0.04 }, { 0.16, 0.61, -0.555 }, "Fabric", ASH, { 0, 0, -30 }),
+			Kit.box("UpperTorso", { 0.09, 0.4, 0.04 }, { -0.16, 0.61, -0.555 }, "Fabric", ASH, { 0, 0, 30 }),
+			Kit.box("UpperTorso", { 0.16, 0.16, 0.08 }, { 0, 0.42, -0.575 }, "Metal", SULPHUR, { 0, 0, 45 }),
+			-- A bold cinder seam down the bodice, forking twice.
+			Kit.box("UpperTorso", { 0.09, 0.95, 0.04 }, { 0, 0.02, -0.575 }, "Neon", EMBER),
+			Kit.box("UpperTorso", { 0.07, 0.5, 0.04 }, { 0.19, -0.05, -0.575 }, "Neon", EMBER, { 0, 0, -22 }),
+			Kit.box("UpperTorso", { 0.06, 0.34, 0.04 }, { -0.17, 0.33, -0.575 }, "Neon", EMBER, { 0, 0, 25 }),
+			-- The bodice point over the sash.
+			Kit.box("UpperTorso", { 0.36, 0.36, 0.06 }, { 0, -0.58, -0.545 }, "Fabric", ASH, { 0, 0, 45 }),
+			-- The bustle at the back, and one ribbon tail down it.
+			Kit.box("UpperTorso", { 1.4, 0.62, 0.28 }, { 0, -0.45, 0.6 }, "Fabric", BASALT_DARK),
+			Kit.box("UpperTorso", { 1.44, 0.1, 0.3 }, { 0, -0.72, 0.6 }, "Fabric", ASH),
+			Kit.box("UpperTorso", { 0.14, 0.8, 0.04 }, { 0.55, 0.05, 0.755 }, "Fabric", ASH),
+			Kit.box("UpperTorso", { 0.16, 0.08, 0.05 }, { 0.55, -0.37, 0.755 }, "Fabric", SULPHUR),
+		},
+		{
+			-- The cinched waist: a broad magma sash under a pale belt and buckle.
+			Kit.box("LowerTorso", { 2.06, 0.4, 1.06 }, { 0, 0, 0 }, "Fabric", BASALT_DARK),
+			Kit.box("LowerTorso", { 2.12, 0.3, 1.12 }, { 0, 0.02, 0 }, "Fabric", MAGMA),
+			Kit.box("LowerTorso", { 2.14, 0.1, 1.16 }, { 0, 0.1, 0 }, "Fabric", ASH),
+			Kit.box("LowerTorso", { 0.2, 0.2, 0.08 }, { 0, 0.1, -0.6 }, "Metal", SULPHUR, { 0, 0, 45 }),
+		},
+		{
+			-- The upper sleeves: slim grey sleeves close to the arm, with a pale
+			-- band at the elbow where the gloves' bells take over.
+			Kit.box("UpperArm", { 1.02, 1.18, 1.02 }, { 0, 0.005, 0 }, "Fabric", SMOKE),
+			Kit.box("UpperArm", { 1.06, 0.1, 1.06 }, { 0, -0.5, 0 }, "Fabric", ASH),
+			Kit.box("UpperArm", { 0.05, 1.0, 0.05 }, { 0.52, 0.06, 0 }, "Fabric", SULPHUR),
+		},
+		{
+			-- The upper skirt: a black outer skirt with a red centre stripe,
+			-- flaring from the hip; the side panels close it, the right edge
+			-- wraps over in sulphur. Bold cinder seams run down the black.
+			Kit.box("UpperLeg", { 0.5, SKIRT, 0.08 }, { -0.25, SKIRT_Y, -0.64 }, "Fabric", MAGMA, { 8, 0, 0 }),
+			Kit.box("UpperLeg", { 0.9, SKIRT, 0.08 }, { 0.45, SKIRT_Y, -0.64 }, "Fabric", BASALT, { 8, 0, 0 }),
+			Kit.box("UpperLeg", { 1.4, SKIRT, 0.08 }, { 0.2, SKIRT_Y, 0.64 }, "Fabric", BASALT_DARK, { -8, 0, 0 }),
+			Kit.box("UpperLeg", { 0.1, SKIRT - 0.04, 1.15 }, { 0.7, SKIRT_Y, 0 }, "Fabric", BASALT_DARK, { 0, 0, 9 }),
+			Kit.box(
+				"UpperLeg",
+				{ 0.09, SKIRT, 0.06 },
+				{ -0.5, SKIRT_Y, -0.71 },
+				"Fabric",
+				SULPHUR,
+				{ 8, 0, 0 },
+				"Right"
+			),
+			Kit.box("UpperLeg", { 0.09, 0.9, 0.06 }, { 0.5, SKIRT_Y + 0.1, -0.675 }, "Neon", EMBER, { 8, 0, -8 }),
+			Kit.box("UpperLeg", { 0.07, 0.4, 0.06 }, { 0.36, SKIRT_Y - 0.3, -0.73 }, "Neon", EMBER, { 8, 0, 16 }),
+		},
+	}),
+}
+
+return look
