+--!strict
+-- The Cinderveil dress (Aor'lan Mountain, the mountain gown's set): a fitted
+-- basalt bodice with a magma crack up it and a bright ash sash at the waist,
+-- over a long bell of basalt columns. A glowing magma underskirt fills the
+-- skirt, showing wide between the columns and in a band down the centre, so
+-- the skirt is one closed, flaring gown rather than open panels.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Basalt black and its lit step, ash grey, the magma red of the mountain's
+-- cracks, and a little sulphur yellow.
+local basalt = { 48, 46, 58 }
+local basaltMid = { 84, 80, 102 }
+local ash = { 164, 158, 148 }
+local magma = { 186, 56, 34 }
+local sulphur = { 210, 180, 80 }
+
+-- The upper skirt runs from just under the sash to just above the knee.
+local SKIRT_TOP = 0.8
+local SKIRT_BOTTOM = -0.58
+local SKIRT = SKIRT_TOP - SKIRT_BOTTOM
+local SKIRT_Y = (SKIRT_TOP + SKIRT_BOTTOM) / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice, close over the ribs: a lit panel down the front, an ash
+		-- V at the neckline, and the magma crack splitting up it.
+		Kit.box("UpperTorso", { 2.12, 1.68, 1.1 }, { 0, 0, 0 }, "Fabric", basalt),
+		Kit.box("UpperTorso", { 1.16, 1.28, 0.06 }, { 0, 0.02, -0.56 }, "Fabric", basaltMid),
+		Kit.box("UpperTorso", { 0.34, 0.05, 0.05 }, { 0.16, 0.56, -0.57 }, "Fabric", ash, { 0, 0, -25 }),
+		Kit.box("UpperTorso", { 0.06, 1.08, 0.05 }, { -0.2, 0.02, -0.57 }, "Fabric", magma, { 0, 0, -7 }),
+		Kit.box("UpperTorso", { 0.05, 0.42, 0.05 }, { -0.02, 0.26, -0.57 }, "Fabric", magma, { 0, 0, 38 }),
+		-- The waist: basalt under a bright ash sash, a magma seam below it and
+		-- one sulphur stud.
+		Kit.box("LowerTorso", { 2.08, 0.4, 1.08 }, { 0, 0, 0 }, "Fabric", basalt),
+		Kit.box("LowerTorso", { 2.16, 0.18, 1.16 }, { 0, 0.06, 0 }, "Fabric", ash),
+		Kit.box("LowerTorso", { 2.17, 0.06, 1.17 }, { 0, -0.06, 0 }, "Fabric", magma),
+		Kit.box("LowerTorso", { 0.18, 0.18, 0.08 }, { 0.3, 0.06, -0.59 }, "Slate", sulphur),
+		-- The upper sleeves stay close to the arm, a magma seam at the elbow.
+		Kit.box("UpperArm", { 1.04, 1.3, 1.04 }, { 0, -0.01, 0 }, "Fabric", basalt),
+		Kit.box("UpperArm", { 1.06, 0.05, 1.06 }, { 0, -0.57, 0 }, "Fabric", magma),
+		-- The upper skirt: three basalt columns on each face of a leg, a corner
+		-- column at each edge, all flaring from the hip, over a magma core that
+		-- closes the skirt and shows in every gap and down the centre.
+		Kit.box("UpperLeg", { 0.28, SKIRT, 0.14 }, { -0.3, SKIRT_Y, -0.6 }, "Fabric", basalt, { 8, 0, 0 }),
+		Kit.box("UpperLeg", { 0.28, SKIRT, 0.14 }, { 0.06, SKIRT_Y, -0.6 }, "Fabric", basalt, { 8, 0, 0 }),
+		Kit.box("UpperLeg", { 0.28, SKIRT, 0.14 }, { 0.42, SKIRT_Y, -0.6 }, "Fabric", basalt, { 8, 0, 0 }),
+		Kit.box("UpperLeg", { 0.28, SKIRT, 0.14 }, { -0.3, SKIRT_Y, 0.6 }, "Fabric", basalt, { -8, 0, 0 }),
+		Kit.box("UpperLeg", { 0.28, SKIRT, 0.14 }, { 0.06, SKIRT_Y, 0.6 }, "Fabric", basalt, { -8, 0, 0 }),
+		Kit.box("UpperLeg", { 0.28, SKIRT, 0.14 }, { 0.42, SKIRT_Y, 0.6 }, "Fabric", basalt, { -8, 0, 0 }),
+		Kit.box("UpperLeg", { 0.14, SKIRT, 1.0 }, { 0.63, SKIRT_Y, 0 }, "Fabric", basalt, { 0, 0, 11 }),
+		Kit.box("UpperLeg", { 0.32, SKIRT, 0.32 }, { 0.5, SKIRT_Y, -0.5 }, "Slate", basaltMid, { 8, 0, 11 }),
+		Kit.box("UpperLeg", { 0.32, SKIRT, 0.32 }, { 0.5, SKIRT_Y, 0.5 }, "Slate", basaltMid, { -8, 0, 11 }),
