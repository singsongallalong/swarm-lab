+--!strict
+-- The Cinderveil helm (Aor'lan Mountain, the mountain gown's set): a slender
+-- obsidian circlet on the brow, its edges ash and magma, and from it a thin
+-- crest of blades rising over the head and back. A dark veil falls behind.
+-- All of it goes up and back, never wide at the ear.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's palette: basalt black and its lit edge, ash grey, the magma red
+-- of the mountain's cracks, and a little sulphur yellow.
+local obsidian = { 48, 46, 58 }
+local obsidianLit = { 84, 80, 104 }
+local ash = { 164, 158, 148 }
+local magma = { 186, 56, 34 }
+local sulphur = { 210, 180, 80 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CinderveilHelm",
+	slot = "Helm",
+	parts = {
+		-- A thin circlet at the brow: an ash edge above, a magma seam below,
+		-- and one sulphur bead off centre.
+		Kit.box("Head", { 1.3, 0.12, 1.3 }, { 0, 0.24, 0 }, "Slate", obsidian),
+		Kit.box("Head", { 1.32, 0.035, 1.32 }, { 0, 0.31, 0 }, "Slate", ash),
+		Kit.box("Head", { 1.31, 0.04, 1.31 }, { 0, 0.17, 0 }, "Slate", magma),
+		Kit.box("Head", { 0.12, 0.12, 0.07 }, { 0.06, 0.24, -0.66 }, "Slate", sulphur),
+		-- A narrow band over the crown of the head, and the crest rising from
+		-- it: one tall blade between finer ones, tipped with sulphur.
+		Kit.box("Head", { 0.16, 0.07, 1.24 }, { 0, 0.62, 0 }, "Slate", obsidianLit),
+		Kit.box("Head", { 0.14, 0.9, 0.5 }, { 0, 1.08, 0.05 }, "Slate", obsidianLit, { 6, 0, 0 }),
+		Kit.box("Head", { 0.16, 0.5, 0.06 }, { 0, 1.05, -0.19 }, "Slate", magma, { 6, 0, 0 }),
+		Kit.box("Head", { 0.08, 0.48, 0.4 }, { 0.22, 0.84, 0.08 }, "Slate", obsidian, { 4, 0, -6 }),
+		Kit.box("Head", { 0.06, 0.3, 0.3 }, { 0.38, 0.75, 0.08 }, "Slate", obsidianLit, { 2, 0, -10 }),
+		Kit.box("Head", { 0.1, 0.1, 0.12 }, { 0, 1.55, 0.13 }, "Slate", sulphur),
+		-- The veil, falling behind the head with a magma hem.
+		Kit.box("Head", { 1.14, 1.2, 0.05 }, { 0, -0.3, 0.66 }, "Fabric", { 0, 255, 0 }),
+		Kit.box("Head", { 1.15, 0.05, 0.06 }, { 0, -0.9, 0.66 }, "Fabric", { 0, 0, 255 }),
+	},
+}
+
+return look
