diff --git a/src/shared/systems/features/WasteGlassStrike.luau b/src/shared/systems/features/WasteGlassStrike.luau
new file mode 100644
index 00000000..be6b857b
--- /dev/null
+++ b/src/shared/systems/features/WasteGlassStrike.luau
@@ -0,0 +1,887 @@
+--!strict
+-- A map feature for the Wasteland: where a bolt of the Labyrinth gate's storm came
+-- down. The dunes are fused to a floor of muted violet glass, one tall spire or a dark
+-- pit marks the point of impact, a frozen splash of shattered spires stands thrown up
+-- on the side the bolt came from, the ash is scorched dark in rays, and the storm's
+-- charge still crawls over the glass. The Wasteland has glass thickets and glass
+-- crusts; it has nothing that fell out of the sky.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology first,
+-- then look). The first draws choose the structure, the rest only dress it:
+--   1. the strike: a single bolt, a twin strike of two overlapping craters, a gouge
+--      ploughed through the dunes, or a ringed crater with a raised glass ridge inside;
+--   2. the frozen splash: two or three big tilted clusters, one broad fan, or a cluster
+--      and a comet tail, always massed on the bolt's side; the road's side is left open;
+--   3. the heart: one tall fused spire, a dark scorched pit, or a dark rift;
+--   4. the rim: intact, breached, shattered into arcs, or slumped into a walkable ramp;
+--   5. then the footprint's size, the crater's stretch and turn, the road's way in and
+--      out, and the scorch rays.
+-- The bowl floor is one flat sheet of glass with a short ramp up to the rim, so the
+-- road's pale line across it is the only line on it (critique: "make the glass one
+-- sheet"). Everything stands on the wasteland's own glass (waste_glass_* sculpts and a
+-- new burst of shards); the crawling sparks are a new set piece.
+local FeatureDress = require("../FeatureDress")
+local Grid = require("../Grid")
+local MapFeature = require("../MapFeature")
+local Noise = require("../Noise")
+
+type Point = { x: number, z: number }
+type Gap = { a: number, h: number }
+
+-- One crater's frame: its centre, its stretch and turn, its flank, and how deep its
+-- flat floor sits below the rim.
+type Crater = {
+	cx: number,
+	cz: number,
+	cos: number,
+	sin: number,
+	rx: number,
+	rz: number,
+	minAxis: number,
+	rimW: number,
+	depth: number,
+	lipW: number, -- cells of ramp from the rim down to the floor
+	floorR: number, -- cells from the centre out to the flat floor's edge
+}
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+-- Radians between two angles, 0..pi.
+local function apart(a: number, b: number): number
+	return math.abs((a - b + math.pi) % (2 * math.pi) - math.pi)
+end
+
+local FORMS = { "bolt", "twin", "gouge", "ringed" }
+local SPLASHES = { "pair", "trio", "fan", "comet" }
+local HEARTS = { "spire", "pit", "rift" }
+local RIMS = { "intact", "breached", "shattered", "slumped" }
+
+-- Ground is a surface only, inside the bible's limits (saturation 0.50, value
+-- 0.40). The fused glass takes Ice, the rift's heat CrackedLava, the raised bank Rock
+-- and the burnt pit and ash Asphalt: none of them is a material the wasteland tileset
+-- already colours (Sand, Limestone, Ground, Basalt, and the wall backing's Slate).
+local GLASS = { material = "Ice", color = { 80, 62, 100 } }
+local CRACK = { material = "CrackedLava", color = { 54, 38, 68 } }
+local RIM = { material = "Rock", color = { 62, 56, 70 } }
+local SCORCH = { material = "Asphalt", color = { 28, 26, 30 } }
+-- The storm's violet, bright on purpose: it is light, not surface (bible B2).
+local VIOLET = { 186, 130, 255 }
+
+local function newCrater(
+	cx: number,
+	cz: number,
+	radius: number,
+	stretch: number,
+	turn: number,
+	rimW: number,
+	depth: number,
+	floorR: number
+): Crater
+	local rx, rz = radius * stretch, radius / stretch
+	local minAxis = math.min(rx, rz)
+	return {
+		cx = cx,
+		cz = cz,
+		cos = math.cos(turn),
+		sin = math.sin(turn),
+		rx = rx,
+		rz = rz,
+		minAxis = minAxis,
+		rimW = rimW,
+		depth = depth,
+		lipW = math.max(0.1, minAxis - floorR),
+		floorR = floorR,
+	}
+end
+
+-- Signed distance from a crater's rim in cells: negative inside the bowl.
+local function craterDist(c: Crater, x: number, z: number): number
+	local dx, dz = x - c.cx, z - c.cz
+	local lx, lz = dx * c.cos + dz * c.sin, -dx * c.sin + dz * c.cos
+	local u = math.sqrt((lx / c.rx) ^ 2 + (lz / c.rz) ^ 2)
+	return (u - 1) * c.minAxis
+end
+
+-- How far along the crater's long axis a cell sits, in its own turned cells.
+local function alongAxis(c: Crater, x: number, z: number): number
+	return (x - c.cx) * c.cos + (z - c.cz) * c.sin
+end
+
+local function craterAngle(c: Crater, x: number, z: number): number
+	return math.atan2(z - c.cz, x - c.cx)
+end
+
+-- The bowl's height at `dist` from the rim: 0 at the rim, a short ramp down, then one
+-- flat floor at -depth, so the glass shows as a single sheet.
+local function bowlHeight(c: Crater, dist: number): number
+	if dist >= 0 then
+		return 0
+	end
+	local inset = -dist
+	if inset >= c.lipW then
+		return -c.depth
+	end
+	return -c.depth * (inset / c.lipW)
+end
+
+-- A point `extra` cells outside the rim along world angle `a` (fractional cells).
+local function rimPoint(c: Crater, a: number, extra: number): Point
+	local ux, uz = math.cos(a), math.sin(a)
+	local lx, lz = ux * c.cos + uz * c.sin, -ux * c.sin + uz * c.cos
+	local u = math.sqrt((lx / c.rx) ^ 2 + (lz / c.rz) ^ 2)
+	local k = (c.minAxis + extra) / (u * c.minAxis)
+	return { x = c.cx + ux * k, z = c.cz + uz * k }
+end
+
+local function inGap(a: number, gaps: { Gap }): boolean
+	for _, g in gaps do
+		if apart(a, g.a) < g.h then
+			return true
+		end
+	end
+	return false
+end
+
+-- A coordinate on the quarter-cell grid: landmarks sit on readable fractions, so a
+-- stamped point is exactly its own position plus the footprint's offset.
+local function quarter(v: number): number
+	return math.floor(v * 4 + 0.5) / 4
+end
+
+-- A point within `w` cells of a broken line.
+local function nearLine(px: number, pz: number, points: { Point }, w: number): boolean
+	for k = 2, #points do
+		local a, b = points[k - 1], points[k]
+		local vx, vz = b.x - a.x, b.z - a.z
+		local len = vx * vx + vz * vz
+		local t = if len > 1e-9 then math.clamp(((px - a.x) * vx + (pz - a.z) * vz) / len, 0, 1) else 0
+		local qx, qz = a.x + vx * t, a.z + vz * t
+		if (px - qx) ^ 2 + (pz - qz) ^ 2 < w * w then
+			return true
+		end
+	end
+	return false
+end
+
+local feature: MapFeature.Feature = {
+	name = "WasteGlassStrike",
+	about = "Where a bolt of the Labyrinth gate's storm struck the dunes: a flat sheet of fused violet glass in a crater, with one tall spire or a dark pit at the point of impact, its shattered spires thrown up in a frozen splash on the bolt's side, the ash scorched dark in rays and the storm's charge still crawling on the glass.",
+	tileset = "wasteland",
+	scale = "medium",
+	role = "crossing",
+	mood = { "storm-struck", "glassy", "shattered", "violet", "unearthly" },
+	cells = {
+		-- The crater floor: one sheet of fused glass, a few crusts still floating in it.
+		glass = {
+			ground = GLASS,
+			lift = 0.2,
+			clear = true,
+			props = { { sculpt = "waste_glass_crust", every = 30, scale = { 0.2, 0.45 }, sink = 0.2 } },
+		},
+		-- The point of impact: a burnt pit in the glass, its heat still glowing violet.
+		pit = {
+			ground = SCORCH,
+			clear = true,
+			glow = { color = VIOLET, range = 13, brightness = 1.4, every = 5, height = 0.3 },
+		},
+		-- The rift: the same heat left open along a seam, glowing along its length.
+		crack = {
+			ground = CRACK,
+			clear = true,
+			glow = { color = VIOLET, range = 12, brightness = 1.6, every = 3, height = 0.3 },
+		},
+		-- The bank thrown up round the bowl: ash fused to a clean glassy crust.
+		rim = { ground = RIM, clear = true },
+		-- The ash scorched by the bolt: a dark halo and the rays thrown out over it.
+		scorch = {
+			ground = SCORCH,
+			lift = 0.2,
+			clear = true,
+			props = { { sculpt = "waste_glass_bead", every = 8, scale = { 0.3, 0.6 }, sink = 0.15 } },
+		},
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-4: the structure, first, so the seeds differ in kind and not only in detail.
+		local form = FORMS[whole(rng, 1, #FORMS)]
+		local splash = SPLASHES[whole(rng, 1, #SPLASHES)]
+		local heart = HEARTS[whole(rng, 1, #HEARTS)]
+		local rimState = RIMS[whole(rng, 1, #RIMS)]
+
+		-- 5: the frame: how big the whole is, where it sits, how deep it goes.
+		local w, d = whole(rng, 28, 32), whole(rng, 28, 32)
+		local rimW = between(rng, 1.4, 1.9)
+		local stretch = if form == "gouge"
+			then between(rng, 1.35, 1.55)
+			elseif form == "bolt" then between(rng, 0.82, 1.2)
+			else between(rng, 0.9, 1.1)
+		local wide = math.max(stretch, 1 / stretch)
+		local half = math.min(w, d) / 2 - 0.75
+		local maxR = (half - rimW - 1.5) / wide
+		local R = between(rng, 6.4, math.max(6.5, math.min(9.8, maxR)))
+		local turn = between(rng, 0, math.pi)
+		local minAxis = R / wide
+		local floorR = math.max(3.2, math.min(minAxis - 1.8, minAxis * between(rng, 0.5, 0.66)))
+		local depth = between(rng, 2.8, math.min(7.0, (minAxis - floorR) * 1.7))
+		-- Near the middle of the footprint, so the game camera over the middle sees the
+		-- point of impact (critique: "so the game camera sees where the bolt landed").
+		local cx = (w + 1) / 2 + between(rng, -0.75, 0.75)
+		local cz = (d + 1) / 2 + between(rng, -0.75, 0.75)
+		local craters: { Crater } = { newCrater(cx, cz, R, stretch, turn, rimW, depth, floorR) }
+		local main = craters[1]
+
+		-- The road's way, and the side the heart is passed on.
+		local inAt = between(rng, 0, 2 * math.pi)
+		local outAt = inAt + math.pi + between(rng, -0.45, 0.45)
+		local side = if rng:NextNumber() < 0.5 then 1 else -1
+		local passAngle = inAt + side * math.pi / 2
+
+		-- A twin strike: a second bowl thrown out on the side away from the road's pass.
+		if form == "twin" then
+			local s2 = between(rng, 0.9, 1.1)
+			local wide2 = math.max(s2, 1 / s2)
+			local R2max = (math.min(w, d) / 2 - rimW - 1.8) / wide2
+			local R2 = math.min(R * between(rng, 0.5, 0.7), R2max)
+			local a2 = passAngle + math.pi + between(rng, -0.5, 0.5)
+			local reach = math.min(R * between(rng, 0.86, 1.0) + R2 * between(rng, 0.4, 0.62), R + R2 - 1.6)
+			local need2 = R2 * wide2 + rimW + 1.8
+			local x2 = math.clamp(cx + math.cos(a2) * reach, need2, w + 1 - need2)
+			local z2 = math.clamp(cz + math.sin(a2) * reach, need2, d + 1 - need2)
+			local dx, dz = x2 - cx, z2 - cz
+			local got = math.sqrt(dx * dx + dz * dz)
+			local most = R + R2 - 1.6
+			if got > most and got > 1e-6 then
+				x2 = cx + dx / got * most
+				z2 = cz + dz / got * most
+			end
+			x2 = math.clamp(x2, need2, w + 1 - need2)
+			z2 = math.clamp(z2, need2, d + 1 - need2)
+			local minAxis2 = R2 / wide2
+			local floorR2 = math.max(2.6, minAxis2 * between(rng, 0.5, 0.66))
+			table.insert(
+				craters,
+				newCrater(
+					x2,
+					z2,
+					R2,
+					s2,
+					between(rng, 0, math.pi),
+					rimW * 0.9,
+					depth * between(rng, 0.65, 0.9),
+					floorR2
+				)
+			)
+		end
+
+		-- Gaps through each rim: the road's two, then what the rim's state adds.
+		local gapHalf = between(rng, 1.1, 1.7) / (R + rimW / 2)
+		local gaps: { { Gap } } = { { { a = inAt, h = gapHalf }, { a = outAt, h = gapHalf } } }
+		for k = 2, #craters do
+			gaps[k] = {}
+			for _ = 1, whole(rng, 0, 2) do
+				table.insert(
+					gaps[k],
+					{ a = between(rng, 0, 2 * math.pi), h = between(rng, 0.9, 1.6) / (craters[k].minAxis + rimW) }
+				)
+			end
+		end
+		local slumpA, slumpH = 0, 0
+		if rimState == "breached" then
+			for _ = 1, whole(rng, 1, 2) do
+				local a = between(rng, 0, 2 * math.pi)
+				if apart(a, inAt) > 0.7 and apart(a, outAt) > 0.7 then
+					table.insert(gaps[1], { a = a, h = between(rng, 1.0, 1.7) / (R + rimW / 2) })
+				end
+			end
+		elseif rimState == "shattered" then
+			-- Wide breaks that split the bank into standing arcs of glassy crust.
+			for _ = 1, whole(rng, 2, 4) do
+				local a = between(rng, 0, 2 * math.pi)
+				if apart(a, inAt) > 0.55 and apart(a, outAt) > 0.55 then
+					table.insert(gaps[1], { a = a, h = between(rng, 2.0, 3.4) / (R + rimW / 2) })
+				end
+			end
+		elseif rimState == "slumped" then
+			slumpA = between(rng, 0, 2 * math.pi)
+			for _ = 1, 2 do
+				if apart(slumpA, inAt) < 0.9 then
+					slumpA += 2.4
+				end
+				if apart(slumpA, outAt) < 0.9 then
+					slumpA += 2.4
+				end
+			end
+			slumpH = between(rng, 0.55, 0.85)
+		end
+
+		-- The ringed form: a low broken ridge of glass standing on the flat floor.
+		local ringR, ringW, ringGapA, ringGapH = 0, 0, 0, 0
+		if form == "ringed" then
+			ringR = floorR * between(rng, 0.55, 0.75)
+			ringW = between(rng, 0.8, 1.0)
+			ringGapA = between(rng, 0, 2 * math.pi)
+			ringGapH = between(rng, 0.3, 0.5)
+		end
+
+		-- The heart's reach, and how far out the road passes it.
+		local heartR = 0
+		local riftLen = 0
+		if heart == "pit" then
+			heartR = math.min(between(rng, 1.0, 1.9), floorR - 1.4)
+		elseif heart == "rift" then
+			riftLen = math.min(between(rng, 1.8, 3.0), floorR - 1.2)
+		end
+		local heartClear = if heart == "spire" then 2.4 elseif heart == "pit" then heartR + 1.4 else riftLen + 1.2
+		local ringOuter = if form == "ringed" then ringR + ringW / 2 + 0.8 else 0
+		local passR = math.min(math.max(heartClear, ringOuter, 2.2), floorR + 0.6)
+
+		-- The scorch rays thrown out of the strike: each runs as far toward its own
+		-- side of the footprint as there is room for, so they read as long spokes.
+		local function borderReach(a: number): number
+			local c, s = math.cos(a), math.sin(a)
+			local tx = if c > 1e-6 then (w + 0.5 - cx) / c elseif c < -1e-6 then (0.5 - cx) / c else math.huge
+			local tz = if s > 1e-6 then (d + 0.5 - cz) / s elseif s < -1e-6 then (0.5 - cz) / s else math.huge
+			return math.min(tx, tz)
+		end
+		local rayCount = whole(rng, 4, 7)
+		local rayBase = between(rng, 0, 2 * math.pi)
+		local rays: { { a: number, h: number, outer: number } } = {}
+		for k = 1, rayCount do
+			local a = rayBase + (k - 1) * between(rng, 0.24, 0.5) + between(rng, -0.16, 0.16)
+			table.insert(rays, {
+				a = a,
+				h = between(rng, 0.16, 0.34),
+				outer = math.min(main.minAxis + rimW + between(rng, 6.0, 12.0), borderReach(a) - 0.6),
+			})
+		end
+		local halo = between(rng, 0.4, 0.9)
+
+		-- From here the draws only dress it: a noise field for the bank's crest and
+		-- the ragged edges of the scorch, the bank's height, the splash.
+		local field = Noise.field(rng)
+		local phase = between(rng, 0, 2 * math.pi)
+		local bankTop = between(rng, 2.6, 4.2)
+
+		local walk: { boolean } = table.create(w * d, true)
+		local heights: { number } = table.create(w * d, 0)
+		local kinds: { [number]: string } = {}
+		local lifts: { [number]: number } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+
+		-- The bank's crest: a ridge across its width, uneven round the ring, with
+		-- long low stretches and occasional high teeth.
+		local function rimLift(cr: Crater, x: number, z: number, dist: number, top: number): number
+			local a = craterAngle(cr, x, z)
+			local across = math.clamp(dist / cr.rimW, 0, 1)
+			local crest = 0.55 + 0.45 * math.sin(math.pi * across)
+			local wobble = 0.55
+				+ 0.45 * (0.5 + 0.5 * Noise.sample(field, math.cos(a) * 2.7 + phase, math.sin(a) * 2.7 - phase))
+			local tooth = 0.75 + 0.35 * (0.5 + 0.5 * math.sin(5 * a + phase * 0.7))
+			return math.clamp(math.floor(top * crest * wobble * tooth * 2 + 0.5) / 2, 1.0, 7.5)
+		end
+
+		-- The inner ridge of a ringed strike, standing on the flat floor.
+		local function ridgeLift(x: number, z: number): number
+			local wob = 0.5 + 0.5 * Noise.sample(field, x * 0.7 + 5.5, z * 0.7 - 3.3)
+			return math.floor((2.2 + 1.4 * wob) * 2 + 0.5) / 2
+		end
+
+		-- Phase one: the bowls, their banks and the inner ridge.
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				local dists: { number } = {}
+				local dmin = math.huge
+				for k, cr in craters do
+					dists[k] = craterDist(cr, x, z)
+					dmin = math.min(dmin, dists[k])
+				end
+				if dmin < 0 then
+					-- Inside a bowl: one flat sheet of glass, down a short ramp from the rim.
+					local h = 0
+					for k, cr in craters do
+						h = math.min(h, bowlHeight(cr, dists[k]))
+					end
+					heights[i] = h
+					kinds[i] = "glass"
+					if form == "ringed" then
+						local dx, dz = x - main.cx, z - main.cz
+						local rc = math.sqrt(dx * dx + dz * dz)
+						if math.abs(rc - ringR) < ringW / 2 and apart(craterAngle(main, x, z), ringGapA) > ringGapH then
+							walk[i] = false
+							kinds[i] = "rim"
+							lifts[i] = ridgeLift(x, z)
+						end
+					end
+				else
+					-- Outside every bowl: on a bank, through a breach, or on the ash.
+					local rimmed = false
+					for k, cr in craters do
+						local dist = dists[k]
+						if dist < cr.rimW then
+							-- A gouge is open at its ends: no bank across the plough's mouth.
+							local along = true
+							if form == "gouge" and k == 1 then
+								along = math.abs(alongAxis(main, x, z)) < main.rx * 0.86
+							end
+							if along then
+								local a = craterAngle(cr, x, z)
+								if inGap(a, gaps[k]) then
+									-- A breach is floored with glass, level with the ash.
+									kinds[i] = "glass"
+									lifts[i] = 0.2
+									heights[i] = 0
+								elseif k == 1 and slumpH > 0 and apart(a, slumpA) < slumpH then
+									-- The bank slumped into a low walkable ramp down into the bowl.
+									kinds[i] = "rim"
+									lifts[i] = 0.2
+									heights[i] = -0.6 * math.min(1, dist / cr.rimW)
+								else
+									walk[i] = false
+									kinds[i] = "rim"
+									lifts[i] = rimLift(cr, x, z, dist, if k == 1 then bankTop else bankTop * 0.85)
+								end
+								rimmed = true
+								break
+							end
+						end
+					end
+					if not rimmed then
+						heights[i] = 0
+						-- The scorch: a dark halo at the bank's foot, and rays thrown out.
+						local dx, dz = x - cx, z - cz
+						local rr = math.sqrt(dx * dx + dz * dz)
+						local a = if rr > 1e-6 then math.atan2(dz, dx) else 0
+						local jag = Noise.sample(field, x * 0.31 + 13.7, z * 0.31 - 6.1) * 0.06
+						local scorch = dmin
+							< rimW + halo * (0.75 + 0.25 * Noise.sample(field, x * 0.5 - 2.1, z * 0.5 + 8.4))
+						if not scorch then
+							for _, r in rays do
+								if rr < r.outer and apart(a, r.a) < r.h + jag then
+									scorch = true
+									break
+								end
+							end
+						end
+						if scorch then
+							kinds[i] = "scorch"
+							lifts[i] = 0.2
+						end
+					end
+				end
+			end
+		end
+
+		-- Phase two: the heart. A pit burns a hole at the point of impact; a rift opens
+		-- a short seam of it across the floor. The spire heart is stood in phase three.
+		local riftPoints: { Point } = {}
+		if heart == "pit" then
+			for z = 1, d do
+				for x = 1, w do
+					local dx, dz = x - cx, z - cz
+					local i = at(x, z)
+					if walk[i] and dx * dx + dz * dz < heartR * heartR and craterDist(main, x, z) < -0.1 then
+						walk[i] = false
+						kinds[i] = "pit"
+						lifts[i] = nil
+						heights[i] = -depth - 2.8
+					end
+				end
+			end
+		elseif heart == "rift" then
+			local ra = between(rng, 0, math.pi)
+			for s = -1, 1, 2 do
+				table.insert(riftPoints, {
+					x = cx + math.cos(ra) * riftLen * s + between(rng, -0.4, 0.4),
+					z = cz + math.sin(ra) * riftLen * s + between(rng, -0.4, 0.4),
+				})
+			end
+			for z = 1, d do
+				for x = 1, w do
+					local i = at(x, z)
+					if walk[i] and craterDist(main, x, z) < -0.1 and nearLine(x, z, riftPoints, 0.55) then
+						walk[i] = false
+						kinds[i] = "crack"
+						lifts[i] = nil
+						heights[i] = -depth - 2.2
+					end
+				end
+			end
+		end
+
+		-- Where a map's road joins the footprint, straight out from `a`.
+		local function border(a: number): Point
+			local c, s = math.cos(a), math.sin(a)
+			local tx = if c > 1e-6 then (w - cx) / c elseif c < -1e-6 then (1 - cx) / c else math.huge
+			local tz = if s > 1e-6 then (d - cz) / s elseif s < -1e-6 then (1 - cz) / s else math.huge
+			local t = math.min(tx, tz)
+			local x = math.clamp(math.floor(cx + c * t + 0.5), 1, w)
+			local z = math.clamp(math.floor(cz + s * t + 0.5), 1, d)
+			if tx <= tz then
+				x = if c > 0 then w else 1
+			else
+				z = if s > 0 then d else 1
+			end
+			return { x = x, z = z }
+		end
+		local function ringAt(a: number, rr: number): Point
+			return { x = cx + math.cos(a) * rr, z = cz + math.sin(a) * rr }
+		end
+
+		-- Phase three: the frozen splash, massed on the bolt's side, and the heart.
+		local marks: { FeatureDress.Landmark } = {}
+		local effects: { FeatureDress.Effect } = {}
+		local outSegments = {
+			{ border(inAt), rimPoint(main, inAt, main.rimW + 2.0) },
+			{ border(outAt), rimPoint(main, outAt, main.rimW + 2.0) },
+		}
+		local function onRoadOut(x: number, z: number): boolean
+			for _, seg in outSegments do
+				if nearLine(x, z, seg, 1.0) then
+					return true
+				end
+			end
+			return false
+		end
+		local function openGround(x: number, z: number): boolean
+			if x < 0.6 or z < 0.6 or x > w + 0.4 or z > d + 0.4 then
+				return false
+			end
+			local gx, gz = math.floor(x + 0.5), math.floor(z + 0.5)
+			if gx < 1 or gx > w or gz < 1 or gz > d or not walk[at(gx, gz)] then
+				return false
+			end
+			for _, cr in craters do
+				local dist = craterDist(cr, x, z)
+				if dist >= -0.01 and dist < cr.rimW + 0.25 then
+					return false
+				end
+			end
+			return true
+		end
+		local function addSplashAt(x: number, z: number, scale: number)
+			x, z = quarter(x), quarter(z)
+			if not openGround(x, z) or onRoadOut(x, z) then
+				return false
+			end
+			table.insert(marks, {
+				sculpt = "waste_glass_splash",
+				x = x,
+				z = z,
+				yaw = between(rng, 0, 360),
+				scale = scale,
+				sink = 0.25,
+				solid = true,
+			})
+			return true
+		end
+		local function addNeedle(x: number, z: number, scale: number, outward: number?)
+			x, z = quarter(x), quarter(z)
+			if not openGround(x, z) or onRoadOut(x, z) then
+				return false
+			end
+			local yaw = if outward ~= nil then -math.deg(outward) else between(rng, 0, 360)
+			table.insert(marks, {
+				sculpt = "waste_glass_needle",
+				x = x,
+				z = z,
+				yaw = yaw,
+				scale = scale,
+				sink = 0.2,
+				solid = true,
+			})
+			return true
+		end
+
+		-- The bolt threw its splash one way: big tilted clusters on that side of the
+		-- rim, the road's side left open, so the bowl stays the subject.
+		local splashA = passAngle + math.pi + between(rng, -0.3, 0.3)
+		local function addCluster(a: number, big: number)
+			-- The burst at the rim's inner lip, leaning over the glass.
+			local rr = main.minAxis - between(rng, 0.4, 1.0)
+			addSplashAt(cx + math.cos(a) * rr, cz + math.sin(a) * rr, big)
+			-- Its mate at the rim's outer foot, so the mass straddles the bank.
+			local p = rimPoint(main, a + between(rng, -0.08, 0.08), main.rimW + between(rng, 0.15, 0.9))
+			addSplashAt(p.x, p.z, big * between(rng, 0.65, 0.85))
+			-- And a splinter thrown clear of it.
+			local q = rimPoint(main, a + between(rng, -0.18, 0.18), main.rimW + between(rng, 0.6, 1.6))
+			addNeedle(q.x, q.z, between(rng, 0.35, 0.6), a)
+		end
+
+		if splash == "pair" then
+			local off = between(rng, 0.3, 0.55)
+			addCluster(splashA - off, between(rng, 1.05, 1.4))
+			addCluster(splashA + off, between(rng, 1.05, 1.45))
+		elseif splash == "trio" then
+			for _, k in { -1, 0, 1 } do
+				addCluster(splashA + k * between(rng, 0.38, 0.55), between(rng, 1.0, 1.45))
+			end
+		elseif splash == "fan" then
+			local count = whole(rng, 4, 6)
+			local spread = between(rng, 0.55, 0.9)
+			for k = 1, count do
+				local a = splashA + (2 * (k - 1) / (count - 1) - 1) * spread + between(rng, -0.06, 0.06)
+				local rr = main.minAxis - between(rng, 0.4, 1.0)
+				addSplashAt(cx + math.cos(a) * rr, cz + math.sin(a) * rr, between(rng, 0.95, 1.4))
+			end
+			for _ = 1, whole(rng, 2, 4) do
+				local a = splashA + between(rng, -spread, spread)
+				local p = rimPoint(main, a, main.rimW + between(rng, 0.2, 1.2))
+				addNeedle(p.x, p.z, between(rng, 0.3, 0.55), a)
+			end
+		else
+			-- A cluster with a tail of shards strewn downwind of it, thinning as it goes.
+			addCluster(splashA, between(rng, 1.05, 1.4))
+			local count = whole(rng, 5, 8)
+			for k = 1, count do
+				local t = (k - 1) / (count - 1)
+				local a = splashA + between(rng, -0.16, 0.16) * (0.5 + t)
+				local p = rimPoint(main, a, main.rimW + 0.6 + 5.5 * t)
+				if t < 0.4 and rng:NextNumber() < 0.5 then
+					addSplashAt(p.x, p.z, between(rng, 0.7, 1.0))
+				else
+					addNeedle(p.x, p.z, between(rng, 0.35, 0.65) * (1 - 0.3 * t), a)
+				end
+			end
+		end
+		if form == "twin" then
+			-- The second bowl's far rim takes a burst too: the bolt's side.
+			local a2 = math.atan2(craters[2].cz - cz, craters[2].cx - cx)
+			local p = rimPoint(craters[2], a2, craters[2].rimW + between(rng, 0.2, 0.9))
+			addSplashAt(p.x, p.z, between(rng, 0.9, 1.2))
+		end
+
+		-- A few lone needles on the glass, for the scale of the place.
+		for _ = 1, whole(rng, 3, 5) do
+			local a = splashA + between(rng, -0.9, 0.9)
+			local rr = between(rng, floorR * 0.45, main.minAxis - 1.0)
+			addNeedle(cx + math.cos(a) * rr, cz + math.sin(a) * rr, between(rng, 0.45, 0.9), a)
+		end
+
+		if heart == "spire" then
+			table.insert(marks, {
+				sculpt = "waste_glass_core",
+				x = quarter(cx),
+				z = quarter(cz),
+				yaw = between(rng, 0, 360),
+				scale = between(rng, 0.85, 1.05),
+				sink = 0.35,
+				solid = true,
+			})
+			for _ = 1, whole(rng, 2, 4) do
+				local a = between(rng, 0, 2 * math.pi)
+				local rr = between(rng, 1.6, 2.6)
+				addNeedle(cx + math.cos(a) * rr, cz + math.sin(a) * rr, between(rng, 0.4, 0.7), a)
+			end
+		elseif heart == "pit" then
+			for _ = 1, whole(rng, 3, 5) do
+				local a = between(rng, 0, 2 * math.pi)
+				local rr = heartR + between(rng, 0.3, 0.9)
+				addNeedle(cx + math.cos(a) * rr, cz + math.sin(a) * rr, between(rng, 0.4, 0.75), a)
+			end
+		else
+			for _ = 1, whole(rng, 3, 5) do
+				local k = if rng:NextNumber() < 0.5 then 1 else 2
+				local p = riftPoints[k]
+				local a = math.atan2(p.z - cz, p.x - cx)
+				addNeedle(p.x + between(rng, -0.6, 0.6), p.z + between(rng, -0.6, 0.6), between(rng, 0.4, 0.75), a)
+			end
+		end
+
+		-- The storm's charge still crawling over the glass at the point of impact.
+		local function effect(x: number, z: number, lift: number)
+			table.insert(effects, { recipe = "waste_glass_crawl", x = x, z = z, lift = lift })
+		end
+		if heart == "spire" then
+			effect(cx, cz, 0.7)
+		elseif heart == "pit" then
+			effect(cx, cz, 0.4)
+		elseif #riftPoints >= 2 then
+			effect(riftPoints[1].x, riftPoints[1].z, 0.4)
+			effect(riftPoints[2].x, riftPoints[2].z, 0.4)
+		end
+
+		-- Phase four: the road. In through one breach, round the heart on the pass
+		-- side, and out through the other.
+		local road: { Point } = { border(inAt) }
+		table.insert(road, rimPoint(main, inAt, main.rimW + 1.6))
+		table.insert(road, rimPoint(main, inAt, main.rimW * 0.5))
+		table.insert(road, ringAt(inAt, math.min(passR + 1.0, main.minAxis - 0.6)))
+		local sweep = math.pi + ((outAt - inAt - math.pi) * side)
+		for k = 1, 4 do
+			table.insert(road, ringAt(inAt + side * sweep * k / 5, passR))
+		end
+		table.insert(road, ringAt(outAt, math.min(passR + 1.0, main.minAxis - 0.6)))
+		table.insert(road, rimPoint(main, outAt, main.rimW * 0.5))
+		table.insert(road, rimPoint(main, outAt, main.rimW + 1.6))
+		table.insert(road, border(outAt))
+
+		local function nearestWalkable(p: Point): Point
+			local gx, gz = math.floor(p.x + 0.5), math.floor(p.z + 0.5)
+			if gx >= 1 and gx <= w and gz >= 1 and gz <= d and walk[at(gx, gz)] then
+				return p
+			end
+			for ring = 1, 8 do
+				for k = 0, 7 do
+					local a = k * math.pi / 4
