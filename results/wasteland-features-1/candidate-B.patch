diff --git a/src/shared/systems/features/WasteColossusHand.luau b/src/shared/systems/features/WasteColossusHand.luau
new file mode 100644
index 00000000..27cc62db
--- /dev/null
+++ b/src/shared/systems/features/WasteColossusHand.luau
@@ -0,0 +1,908 @@
+--!strict
+-- The colossus's hand on the Wasteland (docs/guides/map-features.md): the open
+-- hand of a fallen giant statue, as big as a house, rising out of the glass-ash
+-- palm-up. The palm is a raised court of fused violet glass, the one bright
+-- place in the ash; four tapering stone fingers and a low thumb stand round it,
+-- each with two joints, curling in over the palm, violet glass grown from the
+-- knuckle out over the finger; a dune of wind-packed ash is banked against the
+-- wrist, and the wrist rises out of it as one broad ramp. The road climbs the
+-- dune onto the wrist, crosses the palm and leaves through a gate between two
+-- fingers.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology
+-- first, then look). The first draws choose the structure, the rest only dress
+-- it:
+--   1. the gesture: a shelter (the fingers long and curled in round a deep
+--      palm), splayed (the fingers open and low, the palm shallow), broken (a
+--      finger sheared to a stump and another gone, its segment left in the
+--      ash), or a claw (the fingers short and driven down, their tips in the
+--      ash);
+--   2. the palm's heart: a lens of brighter glass, bare fused glass, an ash
+--      drift, or a cracked rise;
+--   3. the wrist: a high dune banked over it, a low dune split round a way
+--      through, or a dune banked to one side;
+--   4. the footprint, the palm's size and set, the hand's turn, the fingers'
+--      spread and length, and which gaps between them are gates;
+--   5. then the fingers' heights, the glass on them and the road's way.
+-- Everything stands on the Wasteland's own kit (waste_* sculpts, the plasma and
+-- ashwind themes), plus two sculpts and one set piece of its own.
+local FeatureDress = require("../FeatureDress")
+local Grid = require("../Grid")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+
+-- A finger's or thumb's ridge: its spine sampled in world cells, how thick it
+-- is (cells), and its height from the root up over the knuckle and down to the
+-- tip (studs over the ash plain).
+type Spine = {
+	samples: { { x: number, z: number, t: number } },
+	width: number, -- at the root, cells
+	taper: number, -- the share of the width the tip loses
+	rootTop: number,
+	crest: number,
+	tip: number,
+	knuckle: Point,
+	thumb: boolean,
+}
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local function pick<T>(rng: Random, list: { T }): T
+	return list[whole(rng, 1, #list)]
+end
+
+local function sign(v: number): number
+	return if v < 0 then -1 elseif v > 0 then 1 else 0
+end
+
+-- Half studs, so a floor and its steps draw as a few clean runs, not a tiled sheet.
+local function halfStuds(v: number): number
+	return math.floor(v * 2 + 0.5) / 2
+end
+
+-- Radians between two angles, 0..pi.
+local function apart(a: number, b: number): number
+	return math.abs((a - b + math.pi) % (2 * math.pi) - math.pi)
+end
+
+local function distanceToSegment(px: number, pz: number, a: Point, b: Point): number
+	local vx, vz = b.x - a.x, b.z - a.z
+	local len2 = vx * vx + vz * vz
+	local t = if len2 > 0 then math.clamp(((px - a.x) * vx + (pz - a.z) * vz) / len2, 0, 1) else 0
+	local qx, qz = a.x + vx * t, a.z + vz * t
+	return math.sqrt((px - qx) ^ 2 + (pz - qz) ^ 2)
+end
+
+local STEP = 2 -- Terrain.terraces.maxStep: the most walkable neighbours may differ.
+local RAMP = 6 -- cells the palm's foot takes to reach the ash plain.
+
+-- Surfaces inside the art bible's limits (saturation 0.50, value 0.40), one
+-- colour per terrain material: the palm's fused violet glass and the glass
+-- grown over the knuckles in Ice, the glass pooled in the palm's cup in the
+-- free Glacier (a brighter violet), the statue's stone in the Wasteland's own
+-- basalt, and the wind-packed ash of the dune in Sandstone. Light and effects
+-- may be bright.
+local PALM_GROUND = { material = "Ice", color = { 64, 50, 86 } }
+local STONE_GROUND = { material = "Basalt", color = { 50, 48, 56 } }
+local GLASS_GROUND = { material = "Glacier", color = { 72, 56, 96 } }
+local DUNE_GROUND = { material = "Sandstone", color = { 88, 86, 94 } }
+-- The storm's violet in the glass: a light, so it may be bright.
+local VIOLET = { 168, 132, 255 }
+
+local feature: MapFeature.Feature = {
+	name = "WasteColossusHand",
+	about = "The open hand of a fallen colossus, as big as a house, rising out of the ash palm-up: a raised palm of fused violet glass ringed by tapering stone fingers, glass grown from their knuckles out, and a dune banked against its wrist.",
+	tileset = "wasteland",
+	scale = "medium",
+	role = "centrepiece",
+	mood = { "colossal", "fallen", "sheltered", "glass-grown", "ancient" },
+	cells = {
+		-- The feature's own clearing in the ash: no look of its own (the
+		-- Wasteland's ground shows), only its quiet props kept off it, so the
+		-- hand stands alone instead of among the map's glass and giant bones.
+		apron = { clear = true },
+		-- The statue's palm: the ash fused to violet glass under the storm, so the
+		-- hand's cup is the one bright place in the ash.
+		palm = {
+			ground = PALM_GROUND,
+			lift = 0.25,
+			clear = true,
+			props = {
+				{ sculpt = "waste_glass_crust", every = 20, scale = { 0.35, 0.6 }, sink = 0.25 },
+			} :: { FeatureDress.CellProp },
+		},
+		-- The risen ridges of the fingers: dark stone, its planes catching the moon.
+		finger = {
+			ground = STONE_GROUND,
+			clear = true,
+			props = {
+				{ sculpt = "waste_glass_low", every = 11, scale = { 0.4, 0.75 }, sink = 0.35 },
+			} :: { FeatureDress.CellProp },
+		},
+		-- Fused violet glass grown from the knuckle out over the finger, catching
+		-- its own cold light.
+		knuckle = {
+			ground = PALM_GROUND,
+			lift = 0.4,
+			clear = true,
+			glow = { color = VIOLET, range = 16, brightness = 1.3, every = 11, height = 1.5 },
+			props = {
+				{ sculpt = "waste_glass_low", every = 3, scale = { 0.5, 0.85 }, sink = 0.2 },
+			} :: { FeatureDress.CellProp },
+		},
+		-- The lens of glass pooled in the palm's cup, brighter than the palm round it.
+		glass = {
+			ground = GLASS_GROUND,
+			lift = 0.25,
+			clear = true,
+			glow = { color = VIOLET, range = 16, brightness = 1.2, every = 9, height = 1.0 },
+			props = {
+				{ sculpt = "waste_glass_crust", every = 4, scale = { 0.5, 0.9 }, sink = 0.15 },
+			} :: { FeatureDress.CellProp },
+		},
+		-- Ash banked and wind-packed against the wrist.
+		dune = {
+			ground = DUNE_GROUND,
+			lift = 0.2,
+			clear = true,
+			props = {
+				{ sculpt = "waste_glass_low", every = 16, scale = { 0.3, 0.6 }, sink = 0.4 },
+			} :: { FeatureDress.CellProp },
+		},
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-3: the structure, first.
+		local gesture = pick(rng, { "shelter", "splayed", "broken", "claw" })
+		local heart = pick(rng, { "lens", "bare", "drift", "cracked" })
+		local wrist = pick(rng, { "high", "split", "side" })
+
+		-- 4: the footprint and the hand's pose.
+		local w, d = whole(rng, 30, 32), whole(rng, 30, 32)
+		local cx = (w + 1) / 2 + between(rng, -0.8, 0.8)
+		local cz = (d + 1) / 2 + between(rng, -0.8, 0.8)
+		local turn = between(rng, 0, 2 * math.pi)
+		local stretch = between(rng, 0.9, 1.1)
+		local palmR = between(rng, 4.8, 6.0)
+		local palmH = between(rng, 4.6, 7.2)
+		local dish = between(rng, 0.9, 1.7)
+		local spread = between(rng, 1.1, 1.45)
+		local fingerLen = between(rng, 5.8, 7.8)
+		local wobA, wobB = between(rng, 0, 2 * math.pi), between(rng, 0, 2 * math.pi)
+
+		local ax, az = math.cos(turn), math.sin(turn)
+		local bx, bz = -az, ax
+		local function localOf(x: number, z: number): (number, number)
+			local dx, dz = x - cx, z - cz
+			return dx * ax + dz * az, dx * bx + dz * bz
+		end
+		local function worldOf(u: number, v: number): Point
+			return { x = cx + u * ax + v * bx, z = cz + u * az + v * bz }
+		end
+		-- The palm's rim as a radius by local angle: an oval of `palmR`, uneven
+		-- like a worn stone.
+		local function rimAt(a: number): number
+			local c, s = math.cos(a), math.sin(a)
+			local k = math.sqrt((c / stretch) ^ 2 + (s * stretch) ^ 2)
+			return palmR * (1 + 0.05 * math.sin(3 * a + wobA) + 0.025 * math.sin(5 * a + wobB)) / k
+		end
+		-- How far the footprint reaches from the palm's middle along a world angle.
+		local function roomAt(a: number): number
+			local c, s = math.cos(a), math.sin(a)
+			local tx = if c > 1e-6 then (w - cx) / c elseif c < -1e-6 then (1 - cx) / c else math.huge
+			local tz = if s > 1e-6 then (d - cz) / s elseif s < -1e-6 then (1 - cz) / s else math.huge
+			return math.min(tx, tz)
+		end
+		-- The ground's level at a local point: the cupped palm inside the rim, a
+		-- ramp down to the ash plain outside it.
+		local function groundLevel(u: number, v: number): number
+			local r = math.sqrt(u * u + v * v)
+			local a = math.atan2(v, u)
+			local rim = rimAt(a)
+			if r <= rim then
+				-- The palm's cup: its heart a step lower than its rim.
+				return palmH - (if r < rim * 0.58 then dish else 0)
+			end
+			-- The ash falls away from the palm's foot in a few terraces, each a
+			-- clean ring rather than a tiled slope.
+			local steps = math.max(2, math.ceil(palmH / 2))
+			local k = math.floor(math.clamp((r - rim) / RAMP, 0, 0.999) * steps)
+			local h = palmH - (palmH / steps) * (k + 1)
+			return math.max(0, math.floor(h * 2) / 2)
+		end
+		local function clampLen(a: number, want: number): number
+			local room = roomAt(turn + a) - rimAt(a) - 2.2
+			return math.clamp(want, 1.2, math.max(1.2, room))
+		end
+
+		-- The fingers: four round the far rim, then the thumb out to one side.
+		local FINGER_COUNT = 4
+		local fingerAngles: { number } = {}
+		for k = 1, FINGER_COUNT do
+			fingerAngles[k] = -spread + 2 * spread * (k - 1) / (FINGER_COUNT - 1) + between(rng, -0.05, 0.05)
+		end
+		-- A broken hand: one finger sheared to a stump, one gone with its
+		-- segment left in the ash.
+		local missing, stump = 0, 0
+		if gesture == "broken" then
+			missing = whole(rng, 1, FINGER_COUNT)
+			stump = missing % FINGER_COUNT + 1
+		end
+
+		-- The spine of one finger: out from the rim, then two joints turning it
+		-- in toward the palm, sampled every half segment for the raster. It
+		-- tapers from the root to the tip.
+		local function makeSpine(
+			a: number,
+			len: number,
+			width: number,
+			crest: number,
+			tip: number,
+			bend: number,
+			rootTop: number,
+			thumb: boolean,
+			taper: number
+		): Spine
+			local rim = rimAt(a)
+			local u = (rim - 0.55) * math.cos(a)
+			local v = (rim - 0.55) * math.sin(a)
+			local travelled = 0
+			local samples: { { x: number, z: number, t: number } } = {}
+			local function add(uu: number, vv: number, t: number)
+				local p = worldOf(uu, vv)
+				table.insert(samples, { x = p.x, z = p.z, t = t })
+			end
+			add(u, v, 0)
+			-- The first segment stands straight out of the palm; the second and
+			-- third turn at the knuckle and the second joint.
+			local shares = { 0.3, 0.34, 0.36 }
+			local turns = { 0, 0.45, 1 }
+			for si = 1, #shares do
+				local segLen = len * shares[si]
+				local ang = a + bend * turns[si]
+				local cu, su = math.cos(ang), math.sin(ang)
+				for ss = 1, 2 do
+					local f = segLen * ss / 2
+					add(u + cu * f, v + su * f, math.clamp((travelled + f) / len, 0, 1))
+				end
+				u += cu * segLen
+				v += su * segLen
+				travelled += segLen
+			end
+			local knuckle = samples[1]
+			for _, s in samples do
+				if math.abs(s.t - 0.45) < math.abs(knuckle.t - 0.45) then
+					knuckle = s
+				end
+			end
+			return {
+				samples = samples,
+				width = width,
+				taper = taper,
+				rootTop = rootTop,
+				crest = crest,
+				tip = tip,
+				knuckle = { x = knuckle.x, z = knuckle.z },
+				thumb = thumb,
+			}
+		end
+
+		-- The ridge's width at `t`: thick at the root, tapering to the tip.
+		local function spineWidth(s: Spine, t: number): number
+			return s.width * (1 - s.taper * t)
+		end
+
+		-- Its top: up over the knuckle, a saddle, a second joint, then down to
+		-- the tip, so a finger reads as two segments from the side.
+		local function spineHeight(s: Spine, t: number): number
+			if t < 0.4 then
+				local q = t / 0.4
+				return s.rootTop + (s.crest - s.rootTop) * (q * q * (3 - 2 * q))
+			elseif t < 0.56 then
+				local q = (t - 0.4) / 0.16
+				return s.crest + (s.crest * 0.8 - s.crest) * q
+			elseif t < 0.76 then
+				local q = (t - 0.56) / 0.2
+				return s.crest * 0.8 + (s.crest * 0.95 - s.crest * 0.8) * (q * q * (3 - 2 * q))
+			end
+			local q = (t - 0.76) / 0.24
+			return s.crest * 0.95 + (s.tip - s.crest * 0.95) * q
+		end
+
+		local spines: { Spine } = {}
+		for k = 1, FINGER_COUNT do
+			if k ~= missing then
+				local a = fingerAngles[k]
+				local crest, tip, len, width
+				if gesture == "shelter" then
+					crest = between(rng, 18, 29)
+					tip = crest * between(rng, 0.6, 0.8)
+					len = fingerLen * between(rng, 0.98, 1.1)
+					width = between(rng, 1.45, 1.75)
+				elseif gesture == "splayed" then
+					crest = between(rng, 15, 23)
+					tip = crest * between(rng, 0.36, 0.52)
+					len = fingerLen * between(rng, 1.0, 1.14)
+					width = between(rng, 1.35, 1.6)
+				elseif gesture == "claw" then
+					crest = between(rng, 10, 16)
+					tip = between(rng, 2.2, 4.2)
+					len = fingerLen * between(rng, 0.82, 0.98)
+					width = between(rng, 1.55, 1.85)
+				else
+					crest = between(rng, 16, 26)
+					tip = crest * between(rng, 0.45, 0.65)
+					len = fingerLen * between(rng, 0.92, 1.06)
+					width = between(rng, 1.45, 1.7)
+				end
+				local rootTop = palmH + between(rng, 0.8, 1.8)
+				if k == stump then
+					len = between(rng, 1.8, 2.8)
+					width = between(rng, 1.6, 1.9)
+					crest = math.max(rootTop + 1.4, between(rng, 6.5, 10.5))
+					tip = between(rng, 5, 8)
+				end
+				crest = math.max(crest, rootTop + 2)
+				local conv = if math.abs(a) < 0.1 then (if rng:NextNumber() < 0.5 then 1 else -1) else -sign(a)
