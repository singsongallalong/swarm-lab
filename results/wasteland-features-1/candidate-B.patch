+					local dx, dz = x - root.x, z - root.z
+					if dx * dx + dz * dz <= 1.5 then
+						walk[i] = false
+						kinds[i] = "finger"
+						lifts[i] = math.max(lifts[i] or 0, stubRise - heights[i])
+					end
+				end
+			end
+		end
+
+		-- A cracked rise across the palm: the statue's stone split and lifted.
