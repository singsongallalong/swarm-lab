+			for x = 1, w do
+				local i = at(x, z)
+				if walk[i] then
+					continue
+				end
+				local u, v = localOf(x, z)
+				local r = math.sqrt(u * u + v * v)
+				local ang = math.atan2(v, u)
+				local rim = rimAt(ang)
+				local core = false
+				for _, gate in gates do
+					core = core or apart(ang, gate.a) < gate.half * 0.72
+				end
