+		end
+
+		for z = 1, d do
+			for x = 1, w do
+				local i = at(x, z)
+				local u, v = localOf(x, z)
+				local r = math.sqrt(u * u + v * v)
+				local ang = math.atan2(v, u)
+				local rim = rimAt(ang)
+				local foot = groundLevel(u, v)
+				heights[i] = foot
+				-- The feature's own clearing: every cell of it keeps the map's
+				-- quiet props off, so the hand stands alone in the ash.
+				kinds[i] = "apron"
+				if r <= rim then
+					-- The palm's floor: fused violet glass, the one bright place.
+					kinds[i] = "palm"
+				elseif r - rim <= 3.4 and apart(ang, math.pi) < 0.85 then
+					-- The wrist: one broad ramp of the statue's stone rising out of
+					-- the dune, in two low shelves, the way in.
+					local shelf = if r - rim <= 1.6 then palmH - 1.2 else palmH - 2.3
+					heights[i] = math.max(foot, halfStuds(shelf))
+					kinds[i] = "palm"
+				end
+				-- The dune of ash heaped against the wrist, walkable on the way in.
+				if walk[i] then
+					local dh = math.floor(duneAt(u, v) / 2) * 2
+					if dh > heights[i] + 0.05 then
+						heights[i] = dh
+						kinds[i] = "dune"
+					end
+				end
+				-- The palm's heart.
+				if r <= rim then
+					if heart == "lens" then
+						local lr = math.sqrt((u - lensU) ^ 2 + (v - lensV) ^ 2)
+						if lr < lensR then
