+					if walk[i] and distanceToSegment(x, z, crackFrom, crackTo) <= crackWidth then
+						walk[i] = false
+						kinds[i] = "finger"
+						lifts[i] = math.max(lifts[i] or 0, palmH + crackRise - heights[i])
+					end
+				end
+			end
+		end
+
+		-- Walkable ground must join up: a pocket cut off by a ridge becomes
+		-- fallen stone rather than a hole in the hand.
+		local g = Grid.new(w, d, Grid.WALL)
+		for i, ok in walk do
+			g.cells[i] = if ok then Grid.FLOOR else Grid.WALL
+		end
+		local regions = Grid.regions(g)
+		if #regions > 1 then
+			local biggest, best = 1, 0
+			for k, region in regions do
+				if #region > best then
+					biggest, best = k, #region
+				end
+			end
+			for k, region in regions do
+				if k ~= biggest then
+					for _, i in region do
+						walk[i] = false
+						kinds[i] = "finger"
+						lifts[i] = 1.5
+					end
+				end
+			end
+		end
+
+		-- Never leave two walkable cells more than a step apart: ease the higher
+		-- of a pair down until every slope is walkable.
+		for _ = 1, 16 do
+			local changed = false
+			for z = 1, d do
+				for x = 1, w do
+					local i = at(x, z)
+					if not walk[i] then
+						continue
+					end
+					local cap = math.huge
+					for _, nb in Grid.NEIGHBOURS do
+						local nx, nz = x + nb[1], z + nb[2]
+						if inBounds(nx, nz) then
+							local j = at(nx, nz)
+							if walk[j] then
+								cap = math.min(cap, heights[j] + STEP * 0.999)
+							end
+						end
+					end
+					if cap < heights[i] then
+						heights[i] = cap
+						changed = true
+					end
+				end
+			end
+			if not changed then
+				break
+			end
+		end
+		-- Ground on a half-stud grid: floors and steps draw as a few clean runs.
+		for i, ok in walk do
+			if ok then
+				heights[i] = math.floor(heights[i] * 2) / 2
+			end
+		end
+
+		-- The road: in off the border, over the dune onto the wrist, across the
+		-- palm and out through the first gate between two fingers.
+		local function borderAt(a: number): Point
+			local x, z = cx, cz
+			for _ = 1, 400 do
+				local nx, nz = x + math.cos(a) * 0.25, z + math.sin(a) * 0.25
+				if nx < 1 or nx > w or nz < 1 or nz > d then
+					break
+				end
+				x, z = nx, nz
+			end
+			local ix = math.clamp(math.floor(x + 0.5), 1, w)
+			local iz = math.clamp(math.floor(z + 0.5), 1, d)
+			local toW, toE, toN, toS = ix - 1, w - ix, iz - 1, d - iz
+			local least = math.min(toW, toE, toN, toS)
+			if least == toW then
+				return { x = 1, z = iz }
+			elseif least == toE then
+				return { x = w, z = iz }
+			elseif least == toN then
+				return { x = ix, z = 1 }
+			end
