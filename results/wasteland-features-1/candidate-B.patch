+					spines,
+					makeSpine(a, len, width, crest, tip, bend, rootTop, false, between(rng, 0.4, 0.55))
+				)
+			end
+		end
+		-- The thumb, out to one side of the palm and clearly lower than the
+		-- fingers, so it reads as a thumb and not a fifth finger.
+		local thumbA = (if rng:NextNumber() < 0.5 then 1 else -1) * between(rng, 1.55, 2.05)
