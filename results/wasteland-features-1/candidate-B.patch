+		end
+		local entryA = math.pi - wristSide * 0.4 + between(rng, -0.25, 0.25)
+		local exitA = gates[1].a + between(rng, -0.08, 0.08)
+		local entryV = if wrist == "side" then -wristSide * 1.4 else between(rng, -0.6, 0.6)
+		local road: { Point } = { borderAt(turn + entryA) }
+		table.insert(road, worldOf(-(long + 3.2), entryV))
+		table.insert(road, worldOf(-(long + 0.7), entryV * 0.5))
+		table.insert(road, worldOf(-(long - 1.2), 0))
+		local exitRim = rimAt(exitA)
+		table.insert(
+			road,
+			worldOf(between(rng, -1.4, -0.2) * math.cos(exitA), between(rng, -1.4, -0.2) * math.sin(exitA))
+		)
+		table.insert(
+			road,
+			worldOf((exitRim + fingerLen * 0.55) * math.cos(exitA), (exitRim + fingerLen * 0.55) * math.sin(exitA))
+		)
+		table.insert(
+			road,
+			worldOf((exitRim + fingerLen + 2.2) * math.cos(exitA), (exitRim + fingerLen + 2.2) * math.sin(exitA))
+		)
+		table.insert(road, borderAt(turn + exitA))
+		-- Keep every road point on walkable ground: nudge one that fell on a
+		-- wall to the nearest walkable cell.
+		for _, p in road do
+			local ipx, ipz = math.floor(p.x + 0.5), math.floor(p.z + 0.5)
+			local ok = inBounds(ipx, ipz) and walk[at(ipx, ipz)]
+			if not ok then
+				local best, bestD = nil, math.huge
+				for oz = -3, 3 do
