+		local thumbCrest = math.max(thumbRootTop + 1.6, between(rng, 8, 12))
+		local thumbLen = clampLen(thumbA, between(rng, 3.6, 5.0))
+		table.insert(
+			spines,
+			makeSpine(
+				thumbA,
+				thumbLen,
+				between(rng, 1.85, 2.2),
+				thumbCrest,
+				thumbCrest * between(rng, 0.45, 0.62),
+				-sign(thumbA) * between(rng, 0.35, 0.65),
+				thumbRootTop,
+				true,
+				between(rng, 0.3, 0.42)
+			)
+		)
+
+		-- The gates between the standing fingers: the palm's ways out besides
+		-- the wrist.
+		local present: { number } = {}
+		for k = 1, FINGER_COUNT do
+			if k ~= missing then
+				table.insert(present, k)
+			end
+		end
+		local gaps: { number } = {}
+		for k = 1, #present - 1 do
+			table.insert(gaps, (fingerAngles[present[k]] + fingerAngles[present[k + 1]]) / 2)
+		end
+		local gateCount = if gesture == "splayed" or gesture == "claw" then 2 else 1
+		local gates: { { a: number, half: number } } = {}
+		local taken: { number } = {}
+		for _ = 1, 40 do
+			if #taken >= gateCount or #gaps == 0 then
+				break
+			end
+			local g = whole(rng, 1, #gaps)
+			local ok = true
+			for _, p in taken do
+				ok = ok and math.abs(p - g) >= 1
+			end
+			if ok then
+				table.insert(taken, g)
+				table.insert(gates, { a = gaps[g], half = between(rng, 0.2, 0.32) })
+			end
+		end
+		if #gates == 0 then
+			table.insert(gates, { a = gaps[1] or 0, half = 0.26 })
+		end
+
+		-- The dune banked against the wrist, one or two lobes of wind-packed ash:
+		-- low enough at the wrist that the stone ramp rises out of it.
+		local long = palmR * stretch
+		local duneU = -(long + 2.2)
+		type Lobe = { u: number, v: number, ru: number, rv: number, h: number }
+		local lobes: { Lobe } = {}
+		local wristSide = 0
+		if wrist == "high" then
+			table.insert(lobes, {
+				u = duneU,
+				v = between(rng, -0.8, 0.8),
+				ru = between(rng, 2.8, 3.8),
+				rv = between(rng, 4.2, 6.2),
+				h = palmH - between(rng, 1.6, 2.8),
+			})
+		elseif wrist == "split" then
+			local off = between(rng, 2.2, 3.2)
+			local ru, rv = between(rng, 2.0, 2.8), between(rng, 2.2, 3.2)
+			table.insert(lobes, { u = duneU, v = -off, ru = ru, rv = rv, h = palmH * between(rng, 0.42, 0.6) })
+			table.insert(lobes, { u = duneU, v = off, ru = ru, rv = rv, h = palmH * between(rng, 0.42, 0.6) })
+		else
+			wristSide = if rng:NextNumber() < 0.5 then 1 else -1
+			table.insert(lobes, {
+				u = duneU,
+				v = wristSide * between(rng, 2.8, 4.0),
+				ru = between(rng, 2.4, 3.4),
+				rv = between(rng, 3.2, 4.6),
+				h = palmH - between(rng, 2.2, 3.4),
+			})
+		end
+		local function duneAt(u: number, v: number): number
+			local best = 0
+			for _, l in lobes do
+				local du, dv = (u - l.u) / l.ru, (v - l.v) / l.rv
+				local e = du * du + dv * dv
+				if e < 1 then
+					local h = l.h * 0.5 * (1 + math.cos(math.pi * math.sqrt(e)))
+					if h > best then
+						best = h
+					end
+				end
+			end
+			return best
+		end
+
+		-- The palm's heart, drawn before the cell loop.
+		local lensU, lensV, lensR, lensDrop = 0, 0, 0, 0
+		if heart == "lens" then
+			lensU, lensV = between(rng, -1.2, 1.2), between(rng, -1.2, 1.2)
+			lensR = between(rng, 1.8, 3.0)
+			lensDrop = between(rng, 0.5, 1.6)
+		end
+		local driftA, driftOff = 0, 0
+		if heart == "drift" then
+			driftA = between(rng, 0, 2 * math.pi)
+			driftOff = between(rng, -1.6, 1.6)
+		end
+		local crackFrom, crackTo, crackWidth, crackRise = nil, nil, 0, 0
+		if heart == "cracked" then
+			local ca = between(rng, 0, 2 * math.pi)
+			local outer = rimAt(ca) - 0.5
+			local innerR = between(rng, 0.8, 2.2)
+			local innerA = ca + between(rng, -0.5, 0.5)
+			crackFrom = worldOf(outer * math.cos(ca), outer * math.sin(ca))
+			crackTo = worldOf(innerR * math.cos(innerA), innerR * math.sin(innerA))
+			crackWidth = between(rng, 0.6, 0.95)
+			crackRise = between(rng, 2.5, 5.5)
+		end
+
+		-- Lay the hand out cell by cell.
+		local walk = table.create(w * d, true)
