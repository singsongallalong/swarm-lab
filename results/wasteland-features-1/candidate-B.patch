+					lifts[i] = nil
+					heights[i] = groundLevel(u, v)
+				end
+			end
+		end
+
+		-- Glass grown over the knuckles: the stone's crest turns violet and
+		-- rises a little, and the hand's own glass sits on each.
+		local knuckleCells: { { x: number, z: number, lift: number } } = {}
