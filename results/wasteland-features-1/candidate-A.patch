+			name = "coal4",
+			shape = "Block",
+			size = { 0.34, 0.2, 0.3 },
+			at = { -0.1, 0.2, -0.3 },
+			rot = { 0, -32, 0 },
+			color = 4,
+		},
+		{
+			name = "stick",
+			shape = "Block",
+			size = { 0.7, 0.16, 0.12 },
+			at = { -0.1, 0.16, 0.55 },
+			rot = { 0, 70, 0 },
+			color = 1,
+		},
+	} :: { Node },
+}
+
 -- Assemblies, recipes that are their own shape, live by area in
 -- data/assemblies (map-tools.md, "Writing an assembly").
