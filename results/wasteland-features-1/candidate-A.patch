index 00000000..52f1c5c4
--- /dev/null
+++ b/src/shared/systems/features/WasteBuriedCaravan.luau
@@ -0,0 +1,645 @@
+--!strict
+-- WasteBuriedCaravan: a caravan the dune rolled over on the Wasteland's ash.
+-- A long pale dune ridge lies along the road; its lee face is cut open around a
+-- line of wagons half swallowed in the ash, their canopy ribs and wheels and a
+-- torn canopy breaking the slope, crates spilled down toward the road, one dead
+-- lantern-hook still hanging over a banked ember, and ash pouring off the crest.
+--
+-- Its seeds differ in kind, not only in detail (fafwa, 2026-10-30: topology
+-- first, then look). The first draws choose the structure, the rest only dress it:
+--   1. the dune's massing: one unbroken bank filling to the far border, or a
+--      free ridge with walkable windward ground behind it, cut by one wind gap
+--      or two (a free ridge always has a gap, so its two sides join up);
+--   2. the road: along the lee foot from west to east (or east to west), or
+--      turning up through a wind gap and out at the far border;
+--   3. the caravan: a long train, jackknifed at the head, a scattered wreck, or
+--      two rows (one buried high on the face, one spilled low);
+--   4. the burial: deep (only rib frames and wheels break the ash), half, or
+--      shallow (wagon beds and torn canopies stand proud);
+--   5. the lee: 0-3 residual dune knobs for cover, the spill fan's reach, and
+--      the glass crust patches.
+-- Size, the ridge's bow, the crest's height and the road's own bend dress it.
+-- Everything stands on the game's own wasteland kit (waste_* sculpts and glass)
+-- and the lee's own new wreck: wagon, ribs, wheels, crate, lantern-hook.
+local FeatureDress = require("../FeatureDress")
+local MapFeature = require("../MapFeature")
+
+type Point = { x: number, z: number }
+type Wreck = { x: number, zi: number, extra: number, scale: number, ribs: boolean, tipped: boolean, expo: string }
+
+local function between(rng: Random, lo: number, hi: number): number
+	return lo + (hi - lo) * rng:NextNumber()
+end
+
+local function whole(rng: Random, lo: number, hi: number): number
+	return math.floor(between(rng, lo, hi + 1))
+end
+
+local function roundHalf(h: number): number
+	return math.floor(h * 2 + 0.5) / 2
+end
+
+local SHAPES = { "straight", "bowed", "s-bend" }
+local CARAVANS = { "train", "jackknife", "scatter", "double" }
+local EXPOSURES = { "deep", "half", "shallow" }
+
+-- How much of a wreck shows over the ground it stands on, by burial: the rest is
+-- inside the dune. Every wreck is sunk axle-deep at least; a deep one is only
+-- ribs and a wheel rim above the slope.
+local SHOW: { [string]: { wagon: { number }, ribs: { number } } } = {
+	deep = { wagon = { 0.9, 1.5 }, ribs = { 1.0, 1.6 } },
+	half = { wagon = { 1.5, 2.2 }, ribs = { 1.6, 2.3 } },
+	shallow = { wagon = { 2.2, 3.0 }, ribs = { 2.3, 3.0 } },
+}
+-- The chance a wreck has lost its whole body and only the canopy frame shows: the
+-- ribs are the main piece, a whole (or tipped) wagon the rare one.
+local RIB_CHANCE: { [string]: number } = { deep = 0.85, half = 0.7, shallow = 0.5 }
+
+-- The dune is the tileset's own ash (Sand in ASH's colour, so it reads like the
+-- ground it rises from), and the lee below it a darker packed ash in the tileset's
+-- PACKED vein (Rock is a ground the wasteland leaves free). The dark wreck then
+-- reads against the pale slope, and the one ember against the lee.
+local DUNE_GROUND = { material = "Sand", color = { 82, 80, 88 } }
+local LEE_GROUND = { material = "Rock", color = { 56, 54, 62 } }
+-- The one warm light here: the ember the dead lantern dropped in the ash.
+local EMBER = { 255, 166, 96 }
+
+local feature: MapFeature.Feature = {
+	name = "WasteBuriedCaravan",
+	about = "A caravan the dune rolled over: wagon ribs and wheels breaking from the lee face, crates spilled down the ash, one dead lantern-hook over a banked ember.",
+	tileset = "wasteland",
+	scale = "medium",
+	role = "centrepiece",
+	mood = { "buried", "wind-scoured", "wreck", "one ember" },
+	cells = {
+		-- The dune's own ash, with a rare crust of fused glass on it.
+		dune = {
+			ground = DUNE_GROUND,
+			clear = true,
+			props = { { sculpt = "waste_glass_crust", every = 40, scale = { 0.35, 0.6 }, sink = 0.7 } },
+		},
+		-- The wind-packed floor the caravan lies on.
+		lee = { ground = LEE_GROUND, clear = true },
+		-- The strip of ground behind a free ridge, kept apart from the lee.
+		windward = {
+			ground = LEE_GROUND,
+			clear = true,
+			props = { { sculpt = "waste_glass_low", every = 30, scale = { 0.3, 0.5 }, sink = 0.6 } },
+		},
+		-- A wind gap cut through the ridge: bare packed sand.
+		pass = { ground = LEE_GROUND, clear = true },
+		-- Where a wagon broke: crates tumbled out over the ash.
+		spill = {
+			ground = LEE_GROUND,
+			clear = true,
+			props = { { sculpt = "waste_crate", every = 5, scale = { 0.55, 0.8 }, sink = 0.3 } },
+		},
+		-- A patch of glass fused out of the ash, the zone's accent.
+		glass = {
+			ground = LEE_GROUND,
+			clear = true,
+			props = {
+				{ sculpt = "waste_glass_crust", every = 3, scale = { 0.35, 0.6 }, sink = 0.5 },
+				{ sculpt = "waste_glass_low", every = 5, scale = { 0.35, 0.55 }, sink = 0.6 },
+			},
+		},
+		-- The banked ember under the dead lantern: the one warm light.
+		ember = {
+			ground = LEE_GROUND,
+			clear = true,
+			glow = { color = EMBER, range = 15, brightness = 1.7, every = 1, height = 1.6 },
+		},
+	} :: { [string]: FeatureDress.CellLook },
+	generate = function(rng: Random): MapFeature.Footprint
+		-- 1-5: the structure, first.
+		local masses = whole(rng, 1, 3)
+		local shape = SHAPES[whole(rng, 1, #SHAPES)]
+		local caravan = CARAVANS[whole(rng, 1, #CARAVANS)]
+		local exposure = EXPOSURES[whole(rng, 1, #EXPOSURES)]
+		local side = if rng:NextNumber() < 0.5 then 1 else -1
+		local form = if masses > 1 and rng:NextNumber() < 0.55 then "free" else "bank"
+		local usePass = masses > 1 and rng:NextNumber() < 0.55
+		local enterWest = rng:NextNumber() < 0.5
+		local islandCount = whole(rng, 0, 3)
+		local w = whole(rng, 26, 32)
+		local d = whole(rng, 26, 32)
+
+		-- Size, the ridge's bow, the crest's height, the apron's depth.
+		local footBase = between(rng, 8, 16)
+		local footAmp = if shape == "straight" then between(rng, 0, 0.8) else between(rng, 2, 5)
+		local footWaves = if shape == "s-bend" then 2 else 1
+		local footPhase = between(rng, 0, 2 * math.pi)
+		local minFoot, maxFoot = 6, d - 9
+		local function footAt(x: number): number
+			local t = (x - 1) / (w - 1)
+			local v = footBase + footAmp * math.sin(footWaves * 2 * math.pi * t + footPhase)
+			return math.clamp(v, minFoot, maxFoot)
+		end
+		local crestBase = between(rng, 10, 17)
+		local crestAmp = between(rng, 0.5, 3)
+		local crestWaves = whole(rng, 1, 2)
+		local crestPhase = between(rng, 0, 2 * math.pi)
+		local function crestAt(x: number): number
+			local t = (x - 1) / (w - 1)
+			return crestBase + crestAmp * math.sin(crestWaves * 2 * math.pi * t + crestPhase)
+		end
+		local nearEdge = 1
+		if form == "free" then
+			nearEdge = math.min(whole(rng, 3, 6), math.max(2, math.floor(footBase) - 6))
+		end
+		-- The crest sits a few cells behind the lee foot: a short steep slip face
+		-- toward the road and a long shallow back behind it, so every seed has one
+		-- clear crest line instead of a slope of fine terraces.
+		local crestDist = whole(rng, 2, 4)
+		local farH = between(rng, 2.5, 4)
+		local footH = between(rng, 3, 4)
+
+		-- Wind gaps: cuts through the ridge that the road may take.
+		local gaps: { { number } } = {}
+		if masses == 2 then
+			local gw = whole(rng, 4, 6)
+			local centre = whole(rng, math.floor(w * 0.32), math.floor(w * 0.68))
+			table.insert(
+				gaps,
+				{ math.max(4, centre - math.floor(gw / 2)), math.min(w - 3, centre + math.ceil(gw / 2)) }
+			)
+		elseif masses == 3 then
+			local gw = whole(rng, 3, 5)
+			local c1 = whole(rng, math.floor(w * 0.20), math.floor(w * 0.34))
+			local c2 = whole(rng, math.floor(w * 0.66), math.floor(w * 0.80))
+			table.insert(gaps, { math.max(3, c1 - gw), math.min(w - 3, c1 + gw) })
+			table.insert(gaps, { math.max(3, c2 - gw), math.min(w - 3, c2 + gw) })
+		end
+		local function inGap(x: number): boolean
+			for _, g in gaps do
+				if x >= g[1] and x <= g[2] then
+					return true
+				end
+			end
+			return false
+		end
+
+		local walk = table.create(w * d, true)
+		local heights = table.create(w * d, 0)
+		local kinds: { [number]: string } = {}
+		local function at(x: number, z: number): number
+			return (z - 1) * w + x
+		end
+		-- The dune frame's z (1 at the dune-side border) as the footprint's z.
+		local function zOf(zi: number): number
+			return if side == 1 then zi else d + 1 - zi
+		end
+		local function cellAt(x: number, zi: number): number
+			return at(x, math.clamp(math.floor(zOf(zi) + 0.5), 1, d))
+		end
+
+		-- The ridge's cross-section: a foot wall, a crest, and a far edge.
+		local function duneHeight(x: number, zi: number, f: number): number
+			local dist = f - zi
+			local maxDist = f - nearEdge
+			if maxDist <= 0 then
+				return roundHalf(footH)
+			end
+			local rise = math.min(crestDist, math.max(1, maxDist - 1))
+			local crest = crestAt(x)
+			if dist <= rise then
+				return roundHalf(footH + (crest - footH) * (dist / rise) ^ 0.8)
+			end
+			local t = math.min(1, (dist - rise) / math.max(0.001, maxDist - rise))
+			return roundHalf(crest - (crest - farH) * t ^ 1.1)
+		end
+
+		-- Lay the ridge and the ground either side of it.
+		for x = 1, w do
+			local f = math.floor(footAt(x) + 0.5)
+			local gap = inGap(x)
+			for zi = 1, d do
+				local i = cellAt(x, zi)
+				if zi < nearEdge then
+					walk[i] = true
+					heights[i] = if zi >= nearEdge - 2 then 1 else 0
+					kinds[i] = "windward"
+				elseif zi <= f then
+					if gap then
+						walk[i] = true
+						heights[i] = if zi >= f - 2 then 2 elseif zi >= f - 4 then 1 else 0
+						kinds[i] = "pass"
+					else
+						walk[i] = false
+						heights[i] = duneHeight(x, zi, f)
+						kinds[i] = "dune"
+					end
+				else
+					walk[i] = true
+					heights[i] = if zi - f >= 4 then 0 elseif zi - f >= 2 then 1 else 2
+					kinds[i] = "lee"
+				end
+			end
+		end
+
+		-- The road's way, sampled before the knobs so nothing is stood in its way.
+		local offset = between(rng, 4.5, 6.5)
+		local roadPhase = between(rng, 0, 2 * math.pi)
+		local function roadZ(x: number): number
+			local v = footAt(x) + offset + 0.9 * math.sin(x / w * math.pi * 1.5 + roadPhase)
+			return math.clamp(v, footAt(x) + 3.2, d - 1.5)
+		end
+		local skeleton: { { x: number, zi: number } } = {}
+		local passGapIndex = 0
+		if usePass and #gaps > 0 then
+			passGapIndex = whole(rng, 1, #gaps)
+		end
+		local fromX = if enterWest then 1 else w
+		local toX = if enterWest then w else 1
+		if passGapIndex > 0 then
+			local gap = gaps[passGapIndex]
+			local centre = math.floor((gap[1] + gap[2]) / 2)
+			local stepX = if enterWest then 3 else -3
+			local x = fromX
+			while (enterWest and x < centre) or (not enterWest and x > centre) do
+				table.insert(skeleton, { x = x, zi = roadZ(x) })
+				x += stepX
+			end
+			table.insert(skeleton, { x = centre, zi = roadZ(centre) })
+			local z = math.floor(roadZ(centre)) - 2
+			while z > 2 do
+				table.insert(skeleton, { x = centre, zi = z })
+				z -= 3
+			end
+			table.insert(skeleton, { x = centre, zi = 1 })
+		else
+			local stepX = if enterWest then 3 else -3
+			local x = fromX
+			while (enterWest and x < w) or (not enterWest and x > 1) do
+				table.insert(skeleton, { x = x, zi = roadZ(x) })
+				x += stepX
+			end
+			table.insert(skeleton, { x = toX, zi = roadZ(toX) })
+		end
+
+		-- Residual dune knobs in the lee: the fight's cover, 0-3 of them.
+		local islands: { { x: number, zi: number, rx: number, rz: number, h: number } } = {}
+		local tries = 0
+		while #islands < islandCount and tries < 40 do
+			tries += 1
+			local x = whole(rng, 5, w - 4)
+			local rx = whole(rng, 1, 2)
+			local rz = whole(rng, 1, 2)
+			local zi = math.floor(footAt(x) + between(rng, 3.5, 6.5) + 0.5)
+			local ok = zi > footAt(x) + 2.5 and zi < d - 2
+			if inGap(x) then
+				ok = false
+			end
+			for _, g in gaps do
+				if x + rx + 1 >= g[1] and x - rx - 1 <= g[2] then
+					ok = false
+				end
+			end
+			for _, o in islands do
+				if math.abs(o.x - x) <= o.rx + rx + 2 and math.abs(o.zi - zi) <= o.rz + rz + 2 then
+					ok = false
+				end
+			end
+			for _, p in skeleton do
+				if math.abs(p.x - x) <= rx + 2 and math.abs(p.zi - zi) <= rz + 2 then
+					ok = false
+				end
+			end
+			if ok then
+				table.insert(islands, { x = x, zi = zi, rx = rx, rz = rz, h = between(rng, 2.5, 5) })
+			end
+		end
+		for _, o in islands do
+			for dx = -o.rx, o.rx do
+				for dz = -o.rz, o.rz do
+					local x, zi = o.x + dx, o.zi + dz
+					if x >= 2 and x <= w - 1 and zi >= 2 and zi <= d - 1 and not (dx == o.rx and dz == o.rz) then
+						local i = cellAt(x, zi)
+						if zi > footAt(x) + 1.5 then
+							walk[i] = false
+							heights[i] = roundHalf(o.h * (1 - 0.25 * (math.abs(dx) / o.rx + math.abs(dz) / o.rz)))
+							kinds[i] = "dune"
+						end
+					end
+				end
+			end
+		end
+
+		local function walkableAt(x: number, zi: number): boolean
+			local cx = math.clamp(math.floor(x + 0.5), 1, w)
+			local cz = math.clamp(math.floor(zOf(zi) + 0.5), 1, d)
+			return walk[at(cx, cz)] == true
+		end
+
+		-- The caravan: where each wreck lies along the foot.
+		local yawAt = function(x: number, extra: number): number
+			local dzDune = (footAt(x + 1) - footAt(x - 1)) / 2
+			local dz = if side == 1 then dzDune else -dzDune
+			return math.deg(math.atan2(-dz, 1)) + extra
+		end
+		local wrecks: { Wreck } = {}
+		local count = if caravan == "double" then whole(rng, 5, 6) else whole(rng, 4, 6)
+		local firstX = between(rng, 6, 9)
+		local lastX = w - between(rng, 5, 7)
+		local function clearOfGaps(x: number): boolean
+			for _, g in gaps do
+				if x >= g[1] - 2.5 and x <= g[2] + 2.5 then
+					return false
+				end
+			end
+			return true
+		end
+		for k = 1, count do
+			local x = if count > 1 then firstX + (lastX - firstX) * (k - 1) / (count - 1) else (firstX + lastX) / 2
+			local attempt = 0
+			while (x < 3 or x > w - 2 or not clearOfGaps(x)) and attempt < 12 do
+				x += between(rng, -2, 2)
+				attempt += 1
+			end
+			if x >= 3 and x <= w - 2 and clearOfGaps(x) then
+				local extra = 0
+				local zOff
+				local expo = if caravan == "double" and k % 2 == 1 then "deep" else exposure
+				if caravan == "jackknife" and k == 1 then
+					extra = if rng:NextNumber() < 0.5 then between(rng, 35, 70) else -between(rng, 35, 70)
+					zOff = between(rng, 2.5, 4.5)
+				elseif caravan == "scatter" then
+					extra = between(rng, -40, 40)
+					zOff = between(rng, 0.0, 3.0)
+				elseif caravan == "double" then
+					zOff = if k % 2 == 1 then between(rng, -0.8, 0.2) else between(rng, 2.2, 4.0)
+				else
+					zOff = between(rng, -0.4, 0.8)
+				end
+				local ribs = rng:NextNumber() < RIB_CHANCE[expo]
+				local tipped = not ribs and rng:NextNumber() < 0.5
+				table.insert(wrecks, {
+					x = x,
+					zi = footAt(x) + zOff,
+					extra = extra,
+					scale = between(rng, 1.0, 1.24),
+					ribs = ribs,
+					tipped = tipped,
+					expo = expo,
+				})
+			end
+		end
+		if #wrecks == 0 then
+			table.insert(wrecks, {
+				x = w / 2,
+				zi = footAt(w / 2) + 0.5,
+				extra = 0,
+				scale = 1.1,
+				ribs = false,
+				tipped = false,
+				expo = exposure,
+			})
+		end
+
+		-- Place the wrecks, and with them wheels, crates and the lantern.
+		local marks: { FeatureDress.Landmark } = {}
+		local effects: { FeatureDress.Effect } = {}
+		local function addMark(
+			sculpt: string,
+			x: number,
+			zi: number,
+			yaw: number,
+			scale: number,
+			sink: number,
+			solid: boolean
+		)
+			table.insert(marks, {
+				sculpt = sculpt,
+				x = x,
+				z = zOf(zi),
+				yaw = yaw,
+				scale = scale,
+				sink = sink,
+				solid = solid,
+			})
+		end
+		local spillSources: { { x: number, zi: number } } = {}
+		local mainWreck = wrecks[math.floor(#wrecks / 2) + 1]
+		for k, wreck in wrecks do
+			local yaw = yawAt(wreck.x, wreck.extra)
+			local height = if wreck.ribs then 3.9 elseif wreck.tipped then 5.6 else 4.8
+			local showRange = if wreck.ribs then SHOW[wreck.expo].ribs else SHOW[wreck.expo].wagon
+			local show = between(rng, showRange[1], showRange[2])
+			-- The tipped wagon is already half under the ground it was built on;
+			-- the upright ones are sunk until the wheels are buried.
+			local sink = if wreck.tipped then between(rng, 0.6, 1.2) else math.max(0, height * wreck.scale - show)
+			addMark(
+				if wreck.ribs then "waste_wagon_ribs" elseif wreck.tipped then "waste_wagon_tipped" else "waste_wagon",
+				wreck.x,
+				wreck.zi,
+				yaw,
+				wreck.scale,
+				sink,
+				true
+			)
+			if wreck.ribs then
+				-- Now and then a single wheel rim breaks the ash beside the ribs.
+				if rng:NextNumber() < 0.6 then
+					local wx = wreck.x + between(rng, -2.4, 2.4)
+					local wzi = footAt(wx) + between(rng, 1.0, 2.2)
+					if rng:NextNumber() < 0.25 then
+						addMark(
+							"waste_wheel_flat",
+							wx,
+							wzi,
+							between(rng, 0, 360),
+							between(rng, 0.6, 0.85),
+							between(rng, 0.3, 0.55),
+							false
+						)
+					else
+						addMark(
+							"waste_wheel",
+							wx,
+							wzi,
+							between(rng, 0, 360),
+							between(rng, 0.65, 0.9),
+							between(rng, 1.5, 2.2),
+							false
+						)
+					end
+				end
+			elseif rng:NextNumber() < 0.3 then
+				-- One loose wheel at a wagon's end, mostly sunk.
+				local wx = wreck.x + between(rng, -3.0, -1.8) * (if rng:NextNumber() < 0.5 then 1 else -1)
+				addMark(
+					if rng:NextNumber() < 0.4 then "waste_wheel_flat" else "waste_wheel",
+					wx,
+					footAt(wx) + between(rng, 1.0, 2.0),
+					between(rng, 0, 360),
+					between(rng, 0.7, 1.0),
+					if rng:NextNumber() < 0.5 then between(rng, 0.3, 0.6) else between(rng, 1.3, 2.0),
+					false
+				)
+			end
+			if k % 2 == 1 or #wrecks <= 2 then
+				table.insert(spillSources, { x = wreck.x + between(rng, -1.2, 1.2), zi = wreck.zi })
+			end
+		end
+
+		-- The spill fan: crates down the slope from the wrecks that broke open,
+		-- always one from the middle wagon where the fire is.
+		table.insert(spillSources, { x = mainWreck.x, zi = mainWreck.zi })
+		local spillCount = math.min(#spillSources, whole(rng, 1, 4))
+		for s = 1, spillCount do
+			local src = spillSources[s]
+			local depth = whole(rng, 3, 6)
+			for dx = -3, 3 do
+				for dz = 1, depth do
+					local reach = dz * 0.9
+					if math.abs(dx) <= reach and rng:NextNumber() < 0.72 then
+						local x = math.floor(src.x + dx + 0.5)
+						local zi = math.floor(src.zi + dz + 0.5)
+						if x >= 1 and x <= w and zi >= 1 and zi <= d and walkableAt(x, zi) then
+							local i = cellAt(x, zi)
+							if kinds[i] ~= "ember" then
+								kinds[i] = "spill"
+							end
+						end
+					end
+				end
+			end
+		end
+
+		-- Glass fused out of the ash: a few crusted patches on the lee.
+		for _ = 1, whole(rng, 1, 2) do
+			local cx = whole(rng, 4, w - 3)
+			local czi = footAt(cx) + between(rng, 1.2, 3.8)
+			local r = between(rng, 0.9, 1.7)
+			for dx = -3, 3 do
+				for dz = -2, 2 do
+					if (dx * dx + dz * dz) <= r * r and rng:NextNumber() < 0.62 then
+						local x, zi = cx + dx, math.floor(czi + dz + 0.5)
+						if x >= 1 and x <= w and zi >= 1 and zi <= d and walkableAt(x, zi) then
+							local i = cellAt(x, zi)
+							if kinds[i] == "lee" or kinds[i] == "spill" then
+								kinds[i] = "glass"
+							end
+						end
+					end
+				end
+			end
+		end
+
+		-- The one point the scene is about: the caravan's fire at the foot of the
+		-- slip face, ringed by spilled crates, its lantern-hook leaning over it and
+		-- the ash pouring off the crest directly above. Fire, hook and fall line up
+		-- on one spot to fight around.
+		local spotX = math.clamp(mainWreck.x + between(rng, 1.6, 2.8), 3, w - 3)
+		local spotZi = footAt(spotX) + between(rng, 1.2, 1.9)
+		for _ = 1, 8 do
+			if walkableAt(spotX, spotZi) then
+				break
+			end
+			spotZi += 0.6
+		end
+		addMark("waste_caravan_fire", spotX, spotZi, between(rng, 0, 360), between(rng, 1.2, 1.4), 0.15, false)
+		-- The lantern-hook leans over the fire.
+		local lanternX = math.clamp(spotX + between(rng, 1.1, 1.9), 2, w - 1)
+		local lanternZi = spotZi + between(rng, -0.3, 0.3)
+		for _ = 1, 8 do
+			if walkableAt(lanternX, lanternZi) then
+				break
+			end
+			lanternZi += 0.5
+		end
+		addMark("waste_lantern_hook", lanternX, lanternZi, between(rng, 0, 360), between(rng, 0.95, 1.1), 0, false)
+		-- The banked coals' light: one warm cell under the fire, not a row.
+		local tryZi = spotZi
+		for _ = 1, 6 do
+			local i = cellAt(spotX, tryZi)
+			if walk[i] then
+				kinds[i] = "ember"
+				break
+			end
+			tryZi += 0.6
+		end
+		-- Crates spilled in a ring around the fire.
+		local crateCount = whole(rng, 4, 5)
+		local firstA = between(rng, 0, 2 * math.pi)
+		for c = 1, crateCount do
+			local a = firstA + (c - 1) * 2 * math.pi / crateCount + between(rng, -0.2, 0.2)
+			local r = between(rng, 1.3, 2.2)
+			local cx = spotX + math.cos(a) * r
+			local czi = spotZi + math.sin(a) * r * 0.8
+			if walkableAt(cx, czi) then
+				addMark(
+					"waste_crate",
+					cx,
+					czi,
+					between(rng, 0, 360),
+					between(rng, 0.55, 0.8),
+					between(rng, 0.15, 0.4),
+					false
+				)
+			end
+		end
+		-- Ash pours off the crest above the fire.
+		local function crestRow(x: number): number
+			return math.max(nearEdge + 1, math.floor(footAt(x) - crestDist))
+		end
+		local crestX = math.clamp(spotX, 2, w - 1)
+		table.insert(effects, { recipe = "waste_ashfall", x = crestX, z = zOf(crestRow(crestX)), lift = 1 })
+		if rng:NextNumber() < 0.35 then
+			local x2 = math.clamp(spotX + between(rng, -8, 8), 2, w - 1)
+			table.insert(effects, { recipe = "waste_ashfall", x = x2, z = zOf(crestRow(x2)), lift = 1 })
+		end
+		-- The fire's own thin smoke, leaning away on the wind.
+		table.insert(effects, { recipe = "waste_caravan_smoke", x = spotX, z = zOf(spotZi), lift = 0.3 })
+
+		-- The road itself, on walkable cells; clear a cell rather than break one.
+		local road: { Point } = {}
+		for _, p in skeleton do
+			local cx = math.clamp(math.floor(p.x + 0.5), 1, w)
+			local cz = math.clamp(math.floor(zOf(p.zi) + 0.5), 1, d)
+			local i = at(cx, cz)
+			if not walk[i] then
+				walk[i] = true
+				heights[i] = 0
+				kinds[i] = "lee"
+			end
+			table.insert(road, { x = cx, z = cz })
+		end
+
+		-- The photograph: close on the fire from the lee, then down the wreck line
+		-- to the gate (the shot the first critic kept).
+		local camFromX = math.clamp(spotX - 2.6, 2.5, w - 2)
+		local camFromZ = math.min(d - 1.5, spotZi + 2.0)
+		local lineFromX = math.clamp(w * 0.10, 2, w - 6)
+		local lineFromZ = math.min(d - 1.5, footAt(lineFromX) + offset + 3.0)
+		local lineToX = math.clamp(w * 0.62, 4, w - 4)
+		local lineToZ = footAt(lineToX) + 1.0
+
+		return {
+			width = w,
+			depth = d,
+			walk = walk,
+			heights = heights,
+			kinds = kinds,
+			marks = marks,
+			effects = effects,
+			road = road,
+			cameras = {
+				{
+					name = "the fire on the lee",
+					from = { x = camFromX, z = zOf(camFromZ), lift = 3.6 },
+					to = { x = spotX, z = zOf(spotZi - 0.2), lift = 1.1 },
+					fov = 62,
+				},
+				{
+					name = "down the wreck line to the gate",
+					from = { x = lineFromX, z = zOf(lineFromZ), lift = 8 },
+					to = { x = lineToX, z = zOf(lineToZ), lift = 3.8 },
+					fov = 60,
+				},
+			},
+		}
+	end,
+}
+
+return feature
