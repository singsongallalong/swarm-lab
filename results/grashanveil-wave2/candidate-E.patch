+--!strict
+-- The Grashanveil diadem (the Grashanveil gown's helm): a sun-priestess's
+-- crown of pale ruin stone. A brow band with a gold edge, a gold sun disc in a
+-- stone halo above and behind the head, a gold drop on the forehead, and the
+-- hair's beaded falls at the back, the left one a bead short.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	stone = { 170, 162, 146 },
+	stonePale = { 196, 188, 168 },
+	gold = { 198, 160, 84 },
+	terracotta = { 160, 100, 74 },
+	terracottaDark = { 118, 72, 56 },
+}
+
+-- A disc facing the front like a coin: size is { diameter, thickness, diameter }.
+local function disc(
+	size: { number },
+	at: { number },
+	turn: { number },
+	material: string,
+	color: { number }
+): ArmourLookTypes.ArmourPart
+	return { on = "Head", shape = "Cylinder", size = size, at = at, turn = turn, material = material, color = color }
+end
+
+-- The halo leans back so the high camera sees its face, not its rim.
+local HALO = -68
+
