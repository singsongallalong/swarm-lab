+		disc({ 1.06, 0.16, 1.06 }, { 0, 0.95, 0.21 }, { HALO, 0, 0 }, "Metal", c.gold),
+		disc({ 0.26, 0.18, 0.26 }, { 0, 0.95, 0.11 }, { HALO, 0, 0 }, "Fabric", c.terracotta),
+		-- The beaded falls at the back: gold, terracotta and pale stone beads.
+		Kit.box("Head", { 0.14, 0.2, 0.14 }, { 0.46, 0.16, 0.7 }, "Fabric", c.terracottaDark),
+		Kit.box("Head", { 0.16, 0.16, 0.16 }, { 0.46, -0.02, 0.72 }, "Metal", c.gold),
+		Kit.box("Head", { 0.18, 0.18, 0.18 }, { 0.46, -0.2, 0.72 }, "Fabric", c.terracotta),
+		Kit.box("Head", { 0.14, 0.14, 0.14 }, { 0.46, -0.37, 0.72 }, "Slate", c.stonePale),
+		Kit.box("Head", { 0.14, 0.2, 0.14 }, { -0.46, 0.16, 0.7 }, "Fabric", c.terracottaDark),
