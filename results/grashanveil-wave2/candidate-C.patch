+	stoneFold = { 128, 120, 108 },
+	gold = { 190, 154, 78 },
+	terracotta = { 150, 94, 70 },
+}
+
+-- The upper skirt: from the hip to the knee, where the hem's panels take it on.
+-- It is wider than the flared hip drape above, so the gown widens all the way
+-- down; turning the panels about X flares them front and back while keeping
+-- their inner edges on the centre line, so the two legs' panels meet.
+local SKIRT_TOP = 0.75
+local SKIRT_BOTTOM = -0.5
