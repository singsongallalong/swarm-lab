+		Kit.box("UpperArm", { 1.04, 1.24, 1.04 }, { 0, 0, 0 }, "Fabric", c.stone),
+		Kit.box("UpperArm", { 1.08, 0.09, 1.08 }, { 0, 0.26, 0 }, "Metal", c.gold),
+		-- The waist: a gold sash knotted at the right hip, a step in from the
+		-- flared pale hip drape that begins just below it.
+		Kit.box("LowerTorso", { 2.04, 0.2, 1.06 }, { 0, 0.1, 0 }, "Metal", c.gold),
+		{
+			on = "LowerTorso",
+			shape = "Cylinder",
+			size = { 0.32, 0.09, 0.32 },
+			at = { 0, 0.09, -0.56 },
+			turn = { 90, 0, 0 },
+			material = "Metal",
+			color = c.gold,
+		},
+		{
+			on = "LowerTorso",
+			shape = "Cylinder",
+			size = { 0.16, 0.12, 0.16 },
+			at = { 0, 0.09, -0.59 },
+			turn = { 90, 0, 0 },
+			material = "Marble",
+			color = c.stoneLit,
+		},
+		Kit.box("LowerTorso", { 0.22, 0.18, 0.14 }, { 0.36, 0.1, -0.57 }, "Metal", c.gold, { 0, 0, 12 }),
+		Kit.box("LowerTorso", { 0.1, 0.18, 0.05 }, { 0.42, -0.06, -0.6 }, "Fabric", c.terracotta, { 0, 0, 6 }),
+		-- The hips: a snug pale band wraps the waist under the flared over-skirt,
