+		Kit.box("UpperTorso", { 2.06, 1.62, 1.06 }, { 0, 0.01, 0 }, "Fabric", c.stone),
+		Kit.box("UpperTorso", { 1.34, 0.12, 1.1 }, { 0, 0.81, 0 }, "Metal", c.gold),
