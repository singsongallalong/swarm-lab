+--!strict
+-- The Grashanveil hem (zone armour, the Grashan Ruins): the lower half of the
+-- gown's skirt, carried on the shins. Each leg's pale stone panels are far wider
+-- than the thigh's and meet at the centre, so the skirt goes on widening from
+-- the hip to a broad terracotta hem band, with thin gold seams running down to
+-- the moss at the foot and pale stone slippers beneath it, gold-strapped.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The Grashan palette: pale ruin stone, sun gold, faded terracotta, plains green.
+local c = {
+	stone = { 158, 150, 134 },
+	stoneLit = { 182, 174, 156 },
+	stoneFold = { 128, 120, 108 },
+	gold = { 190, 154, 78 },
+	terracotta = { 150, 94, 70 },
+	green = { 98, 116, 82 },
+}
+
+-- The lower skirt: from the knee, where the dress's panels stop, down to just
+-- above the ankle. Its panels are wider again than the thigh's and tilt a
+-- little outward at the bottom, keeping their inner edges on the centre line
+-- while the bell deepens toward the hem.
+local SKIRT_TOP = 0.75
+local SKIRT_BOTTOM = -0.56
+local SKIRT = SKIRT_TOP - SKIRT_BOTTOM
+local SKIRT_Y = (SKIRT_TOP + SKIRT_BOTTOM) / 2
+local TILT = 12
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "GrashanveilHem",
+	slot = "Boots",
+	parts = {
+		-- The lower skirt's pale front and back, far wider than the thigh's,
+		-- meeting at the centre and closed at the outside.
+		Kit.box("LowerLeg", { 1.8, SKIRT, 0.08 }, { 0.4, SKIRT_Y, -0.74 }, "Fabric", c.stone, { TILT, 0, 0 }),
+		Kit.box("LowerLeg", { 0.07, SKIRT, 0.03 }, { -0.465, 0.105, -0.786 }, "Metal", c.gold, { TILT, 0, 0 }),
+		Kit.box("LowerLeg", { 1.8, SKIRT, 0.08 }, { 0.4, SKIRT_Y, 0.74 }, "Fabric", c.stone, { -TILT, 0, 0 }),
+		Kit.box("LowerLeg", { 0.07, SKIRT, 0.03 }, { -0.465, 0.105, 0.786 }, "Metal", c.gold, { -TILT, 0, 0 }),
+		Kit.box("LowerLeg", { 0.08, SKIRT, 1.02 }, { 0.54, SKIRT_Y, 0 }, "Fabric", c.stoneLit, { 0, 0, 6 }),
+		-- A thin gold band at the knee, where the wide skirt steps out, and the
+		-- terracotta hem band at the bottom, both shelves the high camera sees.
+		Kit.box("LowerLeg", { 1.8, 0.12, 0.14 }, { 0.4, 0.6, -0.67 }, "Metal", c.gold, { TILT, 0, 0 }),
+		Kit.box("LowerLeg", { 2.0, 0.12, 0.14 }, { 0.5, -0.46, -0.9 }, "Fabric", c.terracotta, { TILT, 0, 0 }),
+		-- A soft fold down the front of the skirt.
+		Kit.box("LowerLeg", { 0.2, SKIRT - 0.02, 0.04 }, { 0.8, 0.106, -0.794 }, "Fabric", c.stoneFold, { TILT, 0, 0 }),
+		-- Moss creeping up one hem's edge, and the pale slipper beneath.
+		Kit.box("LowerLeg", { 0.34, 0.18, 0.06 }, { 1.1, -0.35, -0.9 }, "Fabric", c.green, { TILT, 0, 8 }, "Right"),
+		Kit.box("Foot", { 1.08, 0.32, 1.24 }, { 0, 0.01, -0.08 }, "Fabric", c.stoneFold),
+		Kit.box("Foot", { 1.12, 0.07, 1.16 }, { 0, 0.14, -0.05 }, "Metal", c.gold),
+	},
+}
+
+return look
