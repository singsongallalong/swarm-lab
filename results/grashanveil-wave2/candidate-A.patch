+--!strict
+-- The Grashanveil priestess's crown (the gown set's helm): a pale ruin-stone
+-- circlet with a gold brow band, a sun disc on a carved back plate rising up
+-- and back, five gold rays, a pinned veil down the back, and ivy with small
+-- plains flowers grown across the back of the veil. All of its height is above
+-- the crown, so from the high camera it reads as a headdress and never as a
+-- helmet.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The gown's palette: pale ruin stone under the moon, sun gold, faded
+-- terracotta, and the plains' green in the ivy.
+local stone = { 176, 166, 148 }
+local stonePale = { 200, 192, 172 }
+local gold = { 190, 150, 76 }
+local goldPale = { 212, 178, 104 }
+local terracotta = { 158, 102, 78 }
+local green = { 116, 136, 84 }
+local greenDark = { 76, 96, 58 }
+local bloom = { 218, 202, 160 }
+
+-- A sun disc standing on edge, its face to the front of the head.
+local function sunDisc(size: number, at: { number }, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "Head",
+		shape = "Cylinder",
+		size = { size, 0.09, size },
+		at = at,
+		turn = { 90, 0, 0 },
+		material = "Metal",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "GrashanveilHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The circlet, its gold brow band, the carved cap over the crown and the
+		-- plate that carries the sun.
+		Kit.box("Head", { 1.3, 0.17, 1.3 }, { 0, 0.3, 0 }, "Fabric", stone),
+		Kit.box("Head", { 1.34, 0.06, 1.34 }, { 0, 0.4, 0 }, "Metal", gold, { 0, 0, 2 }),
+		Kit.box("Head", { 1.26, 0.28, 1.26 }, { 0, 0.5, 0 }, "Fabric", stone),
+		Kit.box("Head", { 0.3, 0.56, 0.12 }, { 0, 0.66, 0.4 }, "Fabric", stonePale),
+		-- The sundisc, with five rays fanned above the crown; the left outer ray
+		-- is short and bent, so the crown looks old.
+		sunDisc(0.76, { 0, 0.98, 0.3 }, gold),
+		Kit.box("Head", { 0.11, 0.32, 0.09 }, { 0, 1.48, 0.3 }, "Metal", gold),
+		Kit.box("Head", { 0.11, 0.32, 0.09 }, { 0.287, 1.39, 0.3 }, "Metal", gold, { 0, 0, -35 }),
+		Kit.box("Head", { 0.11, 0.32, 0.09 }, { -0.287, 1.39, 0.3 }, "Metal", gold, { 0, 0, 35 }),
+		Kit.box("Head", { 0.11, 0.32, 0.09 }, { 0.47, 1.151, 0.3 }, "Metal", gold, { 0, 0, -70 }),
+		Kit.box("Head", { 0.11, 0.26, 0.09 }, { -0.47, 1.151, 0.3 }, "Metal", gold, { 0, 0, 76 }),
+		-- The veil, pinned at the back of the cap and tipped in terracotta.
+		Kit.box("Head", { 0.12, 0.12, 0.1 }, { 0, 0.34, 0.68 }, "Metal", goldPale),
+		Kit.box("Head", { 1.3, 1.0, 0.06 }, { 0, -0.1, 0.7 }, "Fabric", stonePale),
+		Kit.box("Head", { 1.32, 0.08, 0.07 }, { 0, -0.61, 0.7 }, "Fabric", terracotta),
+		-- Ivy grown across the back of the veil, with two leaves and a flower.
+		Kit.box("Head", { 0.9, 0.06, 0.06 }, { 0.05, 0.2, 0.74 }, "Fabric", greenDark, { 0, 0, 10 }),
+		Kit.box("Head", { 0.18, 0.1, 0.05 }, { -0.28, 0.19, 0.76 }, "Fabric", green, { 0, 0, 26 }),
+		Kit.box("Head", { 0.16, 0.09, 0.05 }, { 0.24, 0.25, 0.76 }, "Fabric", green, { 0, 0, -18 }),
+		Kit.box("Head", { 0.11, 0.11, 0.06 }, { -0.06, 0.13, 0.77 }, "Fabric", bloom),
+	},
+}
+
+return look
