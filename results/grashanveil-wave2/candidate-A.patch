+--!strict
+-- The Grashanveil priestess's gown, bodice and upper skirt (the gown set's
+-- chest): a fitted pale ruin-stone bodice with a gold sun on the breast and a
+-- larger one on the back, a narrow collar, a pinched sun-gold sash at the
+-- waist and a bustled bow. The skirt starts as a narrow stone tier at the hip
+-- and steps wider down the thighs, hung from the legs so it strides; dark slim
+-- sleeves keep the arms out of the pale mass. Ivy climbs the back of the
+-- bodice and one side of the skirt. The shins' panels (GrashanveilHem) carry
+-- the skirt on down.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local stone = { 176, 166, 148 }
+local stonePale = { 200, 192, 172 }
+local stoneShade = { 118, 110, 94 }
+local gold = { 190, 150, 76 }
+local goldPale = { 212, 178, 104 }
+local terracotta = { 158, 102, 78 }
+local terracottaDark = { 116, 72, 58 }
+local green = { 116, 136, 84 }
+local greenDark = { 76, 96, 58 }
+local bloom = { 218, 202, 160 }
+
+-- A sun disc standing out from the chest, its face to the front or the back.
+local function sunDisc(
+	on: ArmourLookTypes.BodyPart,
+	size: number,
+	at: { number },
+	color: { number }
+): ArmourLookTypes.ArmourPart
+	return {
+		on = on,
+		shape = "Cylinder",
+		size = { size, 0.08, size },
+		at = at,
+		turn = { 90, 0, 0 },
+		material = "Metal",
+		color = color,
+	}
+end
+
+-- The hip tier runs down from the thigh's top; the wide tier takes over
+-- overlapping it at mid-thigh and stops above the knee.
+local TIER_A = 0.5
+local TIER_A_Y = 0.75 - TIER_A / 2
+local TIER_B_TOP = 0.35
+local TIER_B = 1.01
+local TIER_B_Y = TIER_B_TOP - TIER_B / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "GrashanveilDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice, its gold plackets and the sun on the breast.
+		Kit.box("UpperTorso", { 2.06, 1.64, 1.06 }, { 0, 0, 0 }, "Fabric", stone),
+		Kit.box("UpperTorso", { 0.14, 1.12, 0.04 }, { 0, -0.12, -0.55 }, "Metal", gold),
+		Kit.box("UpperTorso", { 0.14, 1.1, 0.04 }, { 0, -0.12, 0.55 }, "Metal", gold),
+		sunDisc("UpperTorso", 0.72, { 0, 0.24, -0.56 }, terracotta),
+		sunDisc("UpperTorso", 0.5, { 0, 0.24, -0.6 }, goldPale),
+		-- The larger sun on the back, for the high camera.
+		sunDisc("UpperTorso", 0.7, { 0, 0.2, 0.56 }, terracotta),
+		sunDisc("UpperTorso", 0.52, { 0, 0.2, 0.6 }, goldPale),
+		-- The collar, and the bodice's point over the sash.
+		Kit.box("UpperTorso", { 0.74, 0.16, 0.74 }, { 0, 0.85, 0 }, "Fabric", stonePale),
+		Kit.box("UpperTorso", { 0.78, 0.05, 0.78 }, { 0, 0.94, 0 }, "Metal", gold),
+		Kit.box("UpperTorso", { 0.46, 0.46, 0.06 }, { 0, -0.52, -0.55 }, "Fabric", terracottaDark, { 0, 0, 45 }),
+		-- Ivy up the back of the bodice.
+		Kit.box("UpperTorso", { 0.07, 0.8, 0.05 }, { -0.62, -0.2, 0.56 }, "Fabric", greenDark, { 0, 0, -14 }),
+		Kit.box("UpperTorso", { 0.2, 0.12, 0.05 }, { -0.73, -0.05, 0.58 }, "Fabric", green, { 0, 0, 30 }),
+		Kit.box("UpperTorso", { 0.12, 0.12, 0.06 }, { -0.7, -0.3, 0.59 }, "Fabric", bloom),
+		-- The waist: the fitted stone bodice under a pinched gold sash, with a
+		-- terracotta cord below and a terracotta sun buckle.
+		Kit.box("LowerTorso", { 2.04, 0.42, 1.04 }, { 0, 0, 0 }, "Fabric", stone),
+		Kit.box("LowerTorso", { 2.02, 0.3, 1.06 }, { 0, 0.02, 0 }, "Metal", gold),
+		Kit.box("LowerTorso", { 2.06, 0.06, 1.08 }, { 0, -0.16, 0 }, "Fabric", terracotta),
+		sunDisc("LowerTorso", 0.3, { 0, 0.02, -0.57 }, terracotta),
+		-- The bustle and its bow at the back.
+		Kit.box("LowerTorso", { 1.5, 0.34, 0.26 }, { 0, 0, 0.62 }, "Fabric", stonePale),
+		Kit.box("LowerTorso", { 0.36, 0.16, 0.1 }, { 0.26, 0.04, 0.76 }, "Fabric", terracotta, { 0, 0, 18 }),
+		Kit.box("LowerTorso", { 0.36, 0.16, 0.1 }, { -0.26, 0.04, 0.76 }, "Fabric", terracotta, { 0, 0, -18 }),
+		Kit.box("LowerTorso", { 0.16, 0.16, 0.1 }, { 0, 0.04, 0.78 }, "Metal", gold),
+		-- The slim dark upper sleeves, with a gold band at the elbow.
+		Kit.box("UpperArm", { 1.08, 1.2, 1.08 }, { 0, 0, 0 }, "Fabric", stoneShade),
+		Kit.box("UpperArm", { 1.12, 0.1, 1.12 }, { 0, -0.52, 0 }, "Metal", gold),
+		-- One ribbon from the bow, hung from the right thigh.
+		Kit.box("UpperLeg", { 0.12, 0.7, 0.05 }, { 0.18, 0.4, 0.7 }, "Fabric", terracotta, { 0, 0, 3 }, "Right"),
+		-- The narrow hip tier, stepped out over the wide tier below.
+		Kit.box("UpperLeg", { 1.15, TIER_A, 0.09 }, { 0.075, TIER_A_Y, -0.66 }, "Fabric", stone, { 4, 0, 0 }),
+		Kit.box("UpperLeg", { 1.15, TIER_A, 0.09 }, { 0.075, TIER_A_Y, 0.66 }, "Fabric", stone, { -4, 0, 0 }),
+		Kit.box("UpperLeg", { 0.09, TIER_A, 1.42 }, { 0.605, TIER_A_Y, 0 }, "Fabric", stone),
+		-- The wide upper skirt: a panel front, back and outside on each thigh.
+		Kit.box("UpperLeg", { 1.7, TIER_B, 0.09 }, { 0.35, TIER_B_Y, -0.62 }, "Fabric", stone, { 4, 0, 0 }),
+		Kit.box("UpperLeg", { 1.7, TIER_B, 0.09 }, { 0.35, TIER_B_Y, 0.62 }, "Fabric", stone, { -4, 0, 0 }),
+		Kit.box("UpperLeg", { 0.09, TIER_B, 1.34 }, { 1.155, TIER_B_Y, 0 }, "Fabric", stone),
+		-- Ivy up the right side of the skirt, right side only.
+		Kit.box("UpperLeg", { 0.05, 0.6, 0.07 }, { 1.22, 0.0, 0 }, "Fabric", greenDark, { 0, 0, 6 }, "Right"),
+		Kit.box("UpperLeg", { 0.05, 0.13, 0.22 }, { 1.24, 0.15, -0.12 }, "Fabric", green, { 18, 0, 0 }, "Right"),
+		Kit.box("UpperLeg", { 0.06, 0.12, 0.12 }, { 1.25, -0.18, 0.08 }, "Fabric", bloom, nil, "Right"),
+	},
+}
+
+return look
