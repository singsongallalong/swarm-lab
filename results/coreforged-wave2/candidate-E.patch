+--!strict
+-- The coreforged helm (the Coreforged set): a sleek basalt-black great helm
+-- under a three-point ember-gold crown, with one great magma gem set in the
+-- brow. The crown's points and the gem are the set's signature above the
+-- shoulders; below, a gold nasal splits the black faceplate.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local basalt = { 40, 36, 46 }
+local basaltDark = { 24, 22, 30 }
+local gold = { 142, 104, 54 }
+local goldBright = { 196, 152, 84 }
+local ember = { 255, 92, 28 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl, and the gold circlet that crowns it.
+		Kit.box("Head", { 1.34, 0.72, 1.34 }, { 0, 0.3, 0 }, "Metal", basalt),
+		Kit.box("Head", { 1.4, 0.14, 1.4 }, { 0, 0.16, 0 }, "Metal", gold),
+		-- One great gem on the brow, glowing.
+		Kit.box("Head", { 0.4, 0.44, 0.18 }, { 0, 0.18, -0.72 }, "Neon", ember),
+		-- The black faceplate and the gold nasal down it.
+		Kit.box("Head", { 1.22, 0.62, 0.24 }, { 0, -0.31, -0.6 }, "Metal", basaltDark),
+		Kit.box("Head", { 0.12, 0.52, 0.1 }, { 0, -0.28, -0.75 }, "Metal", goldBright),
+		-- Cheek plates and the plate tail at the nape.
+		Kit.box("Head", { 0.09, 0.56, 0.8 }, { 0.69, -0.3, -0.1 }, "Metal", basalt),
+		Kit.box("Head", { 0.09, 0.56, 0.8 }, { -0.69, -0.3, -0.1 }, "Metal", basalt),
+		Kit.box("Head", { 1.34, 0.44, 0.42 }, { 0, -0.24, 0.55 }, "Metal", basaltDark),
+		-- The crown: two horns and a centre point, set a little differently
+		-- so it is not stamped.
+		Kit.box("Head", { 0.16, 0.66, 0.16 }, { 0.58, 0.82, 0.04 }, "Metal", goldBright, { 0, 0, -28 }),
+		Kit.box("Head", { 0.16, 0.58, 0.16 }, { -0.58, 0.78, 0.04 }, "Metal", goldBright, { 0, 0, 22 }),
+		Kit.box("Head", { 0.18, 0.62, 0.18 }, { 0, 0.92, -0.02 }, "Metal", goldBright),
+	},
+}
+
+return look
