+		Kit.box("LowerLeg", { 1.1, 0.92, 1.1 }, { 0, -0.1, 0 }, "Metal", basalt),
+		Kit.box("LowerLeg", { 1.2, 0.18, 1.2 }, { 0, 0.38, 0 }, "Metal", gold),
+		Kit.box("LowerLeg", { 0.22, 0.7, 0.14 }, { 0, -0.14, -0.55 }, "Metal", basaltEdge),
