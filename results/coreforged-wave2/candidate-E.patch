+-- top so the shoulders read as two lines of fire from the high camera. The
+-- long cape is gold-lined: a mantle down the back with a gold yoke and hem,
+-- and long gold-hemmed tails hung from the thighs so they swing with the legs.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local basalt = { 40, 36, 46 }
+local basaltDark = { 24, 22, 30 }
+local gold = { 142, 104, 54 }
