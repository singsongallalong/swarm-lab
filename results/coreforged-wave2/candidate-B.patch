+local Kit = require("./Kit")
+
+local basalt = { 45, 41, 49 }
+local basaltEdge = { 74, 67, 78 }
+local basaltDark = { 26, 24, 30 }
+local emberGold = { 168, 122, 58 }
+local ember = { 186, 78, 34 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedGloves",
+	slot = "Gloves",
+	parts = {
+		-- The bracer, its wide flared cuff and the gold rim at the elbow.
+		Kit.box("LowerArm", { 1.12, 1.02, 1.12 }, { 0, -0.08, 0 }, "Metal", basalt),
+		Kit.box("LowerArm", { 1.26, 0.26, 1.26 }, { 0, 0.46, 0 }, "Metal", basaltEdge),
+		Kit.box("LowerArm", { 1.3, 0.08, 1.3 }, { 0, 0.57, 0 }, "Metal", emberGold),
+		-- The bold ember seam down the outside of the forearm.
+		Kit.box("LowerArm", { 0.12, 0.66, 0.09 }, { 0.56, -0.1, 0 }, "Metal", ember),
+		-- The gauntlet hand and its gold knuckle ridge.
+		Kit.box("Hand", { 1.08, 0.42, 1.08 }, { 0, 0, 0 }, "Metal", basaltDark),
+		Kit.box("Hand", { 1, 0.1, 0.3 }, { 0, 0.14, -0.42 }, "Metal", emberGold),
+	},
+}
+
+return look
