@@ -0,0 +1,32 @@
+--!strict
+-- The Coreforged boots (the Coreforged set's boots): black basalt greaves
+-- with a raised shin plate and a gold band below the knee, and plated
+-- sabatons with a gold band across the toe. One ember crack and one knee cop
+-- sit on the right leg only, so the pair is never a mirrored stamp. The two
+-- gold bands read from the high camera as warm rings down each leg.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local basalt = { 45, 41, 49 }
+local basaltEdge = { 74, 67, 78 }
+local emberGold = { 168, 122, 58 }
+local ember = { 186, 78, 34 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedBoots",
+	slot = "Boots",
+	parts = {
+		-- The greave, its raised shin plate and the gold band below the knee.
+		Kit.box("LowerLeg", { 1.12, 1.12, 1.12 }, { 0, -0.02, 0 }, "Metal", basalt),
+		Kit.box("LowerLeg", { 0.76, 0.8, 0.12 }, { 0, -0.12, -0.56 }, "Metal", basaltEdge),
+		Kit.box("LowerLeg", { 1.18, 0.16, 1.18 }, { 0, 0.48, 0 }, "Metal", emberGold),
+		-- The right knee cop and the one ember crack, up the right shin only.
+		Kit.box("LowerLeg", { 0.56, 0.28, 0.16 }, { 0, 0.48, -0.56 }, "Metal", basaltEdge, nil, "Right"),
+		Kit.box("LowerLeg", { 0.14, 0.62, 0.07 }, { 0.22, -0.12, -0.63 }, "Metal", ember, { 0, 0, 14 }, "Right"),
+		-- The sabaton and the gold band across the toe.
+		Kit.box("Foot", { 1.1, 0.36, 1.3 }, { 0, 0, -0.08 }, "Metal", basalt),
+		Kit.box("Foot", { 1, 0.08, 0.09 }, { 0, 0.15, -0.6 }, "Metal", emberGold),
+	},
+}
+
+return look
diff --git a/src/shared/data/armourLooks/CoreforgedChest.luau b/src/shared/data/armourLooks/CoreforgedChest.luau
new file mode 100644
index 0000000..eaff037
--- /dev/null
+++ b/src/shared/data/armourLooks/CoreforgedChest.luau
@@ -0,0 +1,59 @@
+--!strict
+-- The Coreforged chest (the Coreforged set's chest): a black basalt cuirass
+-- rising into a gorget, a molten heart in a gold medallion, and one bold ember
+-- crack splitting the plate from the heart to the upper right. The pauldrons
+-- are narrower than the iron family's slabs, tilted up and crested with a gold
+-- ridge bar, so the shoulders step and catch the high camera. A gold belt
+-- and spine carry the gold around the back.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local basalt = { 45, 41, 49 }
+local basaltEdge = { 74, 67, 78 }
+local basaltDark = { 26, 24, 30 }
+local emberGold = { 168, 122, 58 }
+local emberDeep = { 106, 74, 38 }
+local ember = { 186, 78, 34 }
+local molten = { 255, 108, 30 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedChest",
+	slot = "Chest",
+	parts = Kit.join({
+		-- Skirt flaps hung from the thighs, so they swing with the legs.
+		Kit.flaps(0.62, "Metal", basalt),
+		{
+			-- The cuirass: a tall breastplate rising into a gorget above a
+			-- darker waist plate, so no bare torso shows at throat or waist.
+			Kit.box("UpperTorso", { 2.12, 1.66, 1.12 }, { 0, 0.22, 0 }, "Metal", basalt),
+			Kit.box("LowerTorso", { 2.08, 0.72, 1.08 }, { 0, 0.12, 0 }, "Metal", basaltDark),
+			-- The gold medallion and the molten heart set into it.
+			Kit.box("UpperTorso", { 0.72, 0.72, 0.12 }, { 0, 0.32, -0.61 }, "Metal", emberGold),
+			{
+				on = "UpperTorso",
+				shape = "Ball",
+				size = { 0.36, 0.36, 0.36 },
+				at = { 0, 0.32, -0.62 },
+				material = "Neon",
+				color = molten,
+			},
+			-- One bold crack from behind the medallion to the upper right.
+			Kit.box("UpperTorso", { 0.2, 1, 0.09 }, { 0.38, 0.55, -0.58 }, "Metal", ember, { 0, 0, -32 }),
+			-- The gold belt and its dark buckle, a little off centre.
+			Kit.box("LowerTorso", { 2.16, 0.16, 1.16 }, { 0, 0.08, 0 }, "Metal", emberGold),
+			Kit.box("LowerTorso", { 0.42, 0.24, 0.11 }, { 0.06, 0.06, -0.61 }, "Metal", emberDeep),
+			-- A gold spine and one bold crack down the back plate.
+			Kit.box("UpperTorso", { 0.2, 1.4, 0.1 }, { 0, 0.28, 0.575 }, "Metal", emberGold),
+			Kit.box("UpperTorso", { 0.16, 0.75, 0.09 }, { 0.34, 0.02, 0.585 }, "Metal", ember, { 0, 0, -28 }),
+			-- The arm: a dark sleeve under a narrow pauldron tilted up into a
+			-- gold-crested ridge, with one shard on the right shoulder.
+			Kit.box("UpperArm", { 1.12, 1.28, 1.12 }, { 0, 0, 0 }, "Metal", basaltDark),
+			Kit.box("UpperArm", { 1.2, 0.32, 1.24 }, { 0.04, 0.48, 0 }, "Metal", basalt, { 0, 0, 12 }),
+			Kit.box("UpperArm", { 0.22, 0.16, 1.06 }, { 0.42, 0.75, 0 }, "Metal", emberGold, { 0, 0, 12 }),
+			Kit.box("UpperArm", { 1.24, 0.09, 1.28 }, { 0.04, 0.31, 0 }, "Metal", emberGold, { 0, 0, 12 }),
+			Kit.box("UpperArm", { 0.24, 0.56, 0.28 }, { 0.5, 0.82, 0.28 }, "Metal", basaltEdge, { 0, 0, -18 }, "Right"),
+		},
+	}),
+}
+
+return look
