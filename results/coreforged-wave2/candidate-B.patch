@@ -0,0 +1,40 @@
+--!strict
+-- The Coreforged helm (the Coreforged set's helm): a black basalt great-helm
+-- crowned with an ember-gold crown plate, two gold shards and a tall molten
+-- central crest that burns above the dome, so the outline reads from the ARPG
+-- camera as a crowned silhouette with a coal at its tip. A gold circlet and
+-- nasal frame the molten eye slit, and a dark nape guard closes the neck.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's own palette: basalt black plate, ember gold, and molten light.
+local basalt = { 45, 41, 49 }
+local basaltDark = { 26, 24, 30 }
+local emberGold = { 168, 122, 58 }
+local molten = { 255, 108, 30 } -- Neon only: the fire inside
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl and the jaw mask, stepped so the brow reads in profile.
+		Kit.box("Head", { 1.36, 0.9, 1.36 }, { 0, 0.2, 0 }, "Metal", basalt),
+		Kit.box("Head", { 1.32, 0.56, 1.32 }, { 0, -0.32, 0 }, "Metal", basaltDark),
+		-- The circlet at the seam, and the crown plate on the dome.
+		Kit.box("Head", { 1.42, 0.16, 1.42 }, { 0, -0.06, 0 }, "Metal", emberGold),
+		Kit.box("Head", { 1, 0.12, 1 }, { 0, 0.67, 0 }, "Metal", emberGold),
+		-- The molten crest and its two gold shards, the crown's outline.
+		Kit.wedge("Head", { 0.28, 0.18, 1.05 }, { 0, 0.9, -0.08 }, "Neon", molten, { -90, 0, 0 }),
+		Kit.wedge("Head", { 0.3, 0.16, 0.78 }, { 0.44, 0.76, -0.04 }, "Metal", emberGold, { -90, 0, 0 }),
+		Kit.wedge("Head", { 0.3, 0.16, 0.66 }, { -0.44, 0.72, -0.04 }, "Metal", emberGold, { -90, 0, 0 }),
+		-- A dark visor band holding the molten slit, split by the nasal bar.
+		Kit.box("Head", { 1.2, 0.2, 0.12 }, { 0, 0.02, -0.66 }, "Metal", basaltDark),
+		Kit.box("Head", { 0.96, 0.07, 0.06 }, { 0, 0.02, -0.71 }, "Neon", molten),
+		Kit.box("Head", { 0.14, 0.52, 0.1 }, { 0, -0.3, -0.69 }, "Metal", emberGold),
+		-- A dark nape guard against the collar.
+		Kit.box("Head", { 1.3, 0.3, 0.5 }, { 0, -0.44, 0.5 }, "Metal", basalt),
+	},
+}
+
+return look
