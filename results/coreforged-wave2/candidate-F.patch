@@ -0,0 +1,33 @@
+--!strict
+-- The coreforged boots: a basalt greave under a knee cop and a gold knee band,
+-- split by one deep molten crack up the shin, over a heavy sabaton with a
+-- jutting toe. The right greave carries a broken outer flange, pale at the
+-- shear. The gold band and the crack read before any plate detail.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local basalt = { 44, 40, 42 }
+local basaltDark = { 28, 26, 29 }
+local basaltEdge = { 78, 70, 68 }
+local gold = { 138, 102, 52 }
+local molten = { 255, 104, 28 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedBoots",
+	slot = "Boots",
+	parts = {
+		-- The greave, the knee cop above it and the gold band beneath the knee.
+		Kit.box("LowerLeg", { 1.12, 1.2, 1.12 }, { 0, 0, 0 }, "Metal", basalt),
+		Kit.box("LowerLeg", { 1.22, 0.3, 1.22 }, { 0, 0.48, 0 }, "Metal", basaltEdge, { 0, 0, -3 }),
+		Kit.box("LowerLeg", { 1.18, 0.09, 1.18 }, { 0, 0.34, 0 }, "Metal", gold),
+		-- The one deep crack up the shin.
+		Kit.box("LowerLeg", { 0.07, 0.54, 0.08 }, { 0.1, -0.12, -0.63 }, "Neon", molten),
+		-- The sabaton, and its jutting toe cap.
+		Kit.box("Foot", { 1.08, 0.38, 1.16 }, { 0, 0.03, -0.06 }, "Metal", basaltDark),
+		Kit.box("Foot", { 0.92, 0.26, 0.34 }, { 0, 0.02, -0.6 }, "Metal", basaltEdge, { -8, 0, 0 }),
+		-- A broken flange on the right greave only.
+		Kit.box("LowerLeg", { 0.16, 0.3, 0.24 }, { 0.58, 0.12, 0.18 }, "Metal", basaltEdge, { 0, 0, -16 }, "Right"),
+	},
+}
+
+return look
diff --git a/src/shared/data/armourLooks/CoreforgedChest.luau b/src/shared/data/armourLooks/CoreforgedChest.luau
