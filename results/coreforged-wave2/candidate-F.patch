@@ -0,0 +1,67 @@
+--!strict
+-- The coreforged chest: a cuirass of basalt poured in overlapping shelves,
+-- like a lava flow frozen on the body, split by one wide molten seam. Ember
+-- gold edges the collar, the shoulder shelves and the belt; the upper arms are
+-- plated black under horned pauldrons, and the right side carries the broken
+-- spur and a thin seam down the back. The shoulders are the silhouette.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local basalt = { 44, 40, 42 }
+local basaltDark = { 28, 26, 29 }
+local basaltEdge = { 78, 70, 68 }
+local basaltWarm = { 58, 42, 40 }
+local gold = { 138, 102, 52 }
+local goldBright = { 182, 134, 66 }
+local molten = { 255, 104, 28 }
+local magmaDeep = { 198, 68, 26 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedChest",
+	slot = "Chest",
+	parts = Kit.join({
+		Kit.flaps(0.58, "Metal", basaltDark),
+		{
+			-- The cuirass and the girdle below it.
+			Kit.box("UpperTorso", { 2.12, 1.66, 1.12 }, { 0, 0.01, 0 }, "Metal", basalt),
+			Kit.box("LowerTorso", { 2.14, 0.46, 1.12 }, { 0, 0, 0 }, "Metal", basaltDark),
+			-- Three shelves of cooled flow down the front, each overhanging the next.
+			Kit.box("UpperTorso", { 1.96, 0.34, 0.14 }, { 0, 0.5, -0.58 }, "Metal", basaltEdge, { -10, 0, 0 }),
+			Kit.box("UpperTorso", { 1.98, 0.38, 0.14 }, { 0, 0.16, -0.6 }, "Metal", basalt, { -7, 0, 0 }),
+			Kit.box("UpperTorso", { 1.72, 0.34, 0.14 }, { 0, -0.28, -0.6 }, "Metal", basaltWarm, { -5, 0, 0 }),
+			-- The one deep seam, wide enough to read from above, and a thin crack off it.
+			Kit.box("UpperTorso", { 0.18, 1.16, 0.08 }, { 0, 0.08, -0.67 }, "Neon", molten, { 0, 0, 4 }),
+			Kit.box(
+				"UpperTorso",
+				{ 0.06, 0.44, 0.07 },
+				{ 0.34, 0.3, -0.66 },
+				"SmoothPlastic",
+				magmaDeep,
+				{ 0, 0, -32 }
+			),
+			-- A high collar, gold-capped behind the neck.
+			Kit.box("UpperTorso", { 1.46, 0.3, 0.38 }, { 0, 0.84, 0.16 }, "Metal", basaltDark),
+			Kit.box("UpperTorso", { 1.5, 0.09, 0.44 }, { 0, 1.01, 0.14 }, "Metal", gold),
+			-- The great shoulder shelves, horned: a black main shelf with a gold
+			-- lip on its front edge, over a plated black upper arm. The right horn
+			-- is the taller, the left one a shorter point.
+			Kit.box("UpperArm", { 1.3, 0.46, 1.24 }, { 0.12, 0.52, 0 }, "Metal", basalt, { 0, 0, -26 }),
+			Kit.box("UpperArm", { 1.24, 0.1, 0.14 }, { 0.12, 0.7, -0.59 }, "Metal", gold, { 0, 0, -26 }),
+			Kit.box("UpperArm", { 1.12, 1.2, 1.12 }, { 0, 0, 0 }, "Metal", basaltDark),
+			Kit.box("UpperArm", { 0.26, 0.46, 0.32 }, { 0.66, 0.72, 0 }, "Metal", basaltEdge, { 0, 0, -22 }, "Right"),
+			Kit.box("UpperArm", { 0.18, 0.32, 0.26 }, { 0.62, 0.64, 0 }, "Metal", basaltEdge, { 0, 0, -18 }, "Left"),
+			-- The gold belt and its buckle.
+			Kit.box("LowerTorso", { 2.2, 0.2, 1.18 }, { 0, 0.1, 0 }, "Metal", gold),
+			Kit.box("LowerTorso", { 0.36, 0.28, 0.12 }, { 0, 0.1, -0.63 }, "Metal", goldBright),
+			-- The back: a spine ridge and a thin seam.
+			Kit.box("UpperTorso", { 0.3, 1.34, 0.14 }, { 0, 0.04, 0.6 }, "Metal", basaltEdge),
+			Kit.box("UpperTorso", { 0.07, 1.08, 0.08 }, { 0.14, 0.02, 0.69 }, "SmoothPlastic", magmaDeep, { 0, 0, 3 }),
+			-- A last shelf under the breastplate.
+			Kit.box("UpperTorso", { 1.2, 0.24, 0.12 }, { 0, 0.68, -0.6 }, "Metal", basalt, { -14, 0, 0 }),
+			-- The lower apron over the belt.
+			Kit.box("LowerTorso", { 1.5, 0.3, 0.14 }, { 0, -0.08, -0.62 }, "Metal", basalt, { -12, 0, 0 }),
+		},
+	}),
+}
+
+return look
