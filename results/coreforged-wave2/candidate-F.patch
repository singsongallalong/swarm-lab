@@ -0,0 +1,45 @@
+--!strict
+-- The coreforged helm: a crown of cooled basalt, its bowl and jagged spires
+-- split by one molten crack down the face. The tallest spire is scraped pale
+-- where the crust cooled; the brow and the ridge between the spires are ember
+-- gold, and a broken spur on the right shows ash. The near-black plate reads
+-- apart from iron's grey at the high camera, and the crown is its silhouette.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local basalt = { 44, 40, 42 }
+local basaltDark = { 28, 26, 29 }
+local basaltEdge = { 78, 70, 68 }
+local ash = { 104, 96, 90 }
+local gold = { 138, 102, 52 }
+local molten = { 255, 104, 28 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The cooled crust of the bowl.
+		Kit.box("Head", { 1.36, 0.7, 1.36 }, { 0, 0.27, 0 }, "Metal", basalt),
+		-- A heavy rim of older, darker rock round the brow and temples.
+		Kit.box("Head", { 1.42, 0.16, 1.42 }, { 0, -0.02, 0 }, "Metal", basaltDark),
+		-- The gold brow, the crown's band.
+		Kit.box("Head", { 1.18, 0.16, 0.26 }, { 0, 0.06, -0.61 }, "Metal", gold),
+		-- The face mask, with the one deep crack down its centre.
+		Kit.box("Head", { 1.02, 0.6, 0.16 }, { 0, -0.29, -0.55 }, "Metal", basaltDark),
+		Kit.box("Head", { 0.08, 0.5, 0.08 }, { 0, -0.26, -0.64 }, "Neon", molten),
+		-- A cheek plate flaring like a flow frozen over the jaw.
+		Kit.box("Head", { 0.2, 0.5, 0.64 }, { 0.59, -0.23, -0.16 }, "Metal", basalt),
+		-- The crown: a tall pale central spire and one lower, the left broken away.
+		Kit.box("Head", { 0.36, 0.74, 0.48 }, { 0, 0.91, 0.02 }, "Metal", basaltEdge),
+		Kit.box("Head", { 0.26, 0.56, 0.4 }, { 0.46, 0.8, 0.02 }, "Metal", basalt, { 0, 0, -12 }),
+		-- The gold ridge of the crown, running front to back between the spires.
+		Kit.box("Head", { 0.18, 0.28, 1.02 }, { 0, 0.69, 0.04 }, "Metal", gold),
+		-- The right spur sheared away, pale ash at the break.
+		Kit.box("Head", { 0.18, 0.3, 0.26 }, { 0.65, 0.67, 0.08 }, "Metal", ash, { 0, 0, -24 }),
+		-- A dark plate tail at the nape.
+		Kit.box("Head", { 1.18, 0.46, 0.32 }, { 0, -0.32, 0.47 }, "Metal", basaltDark),
+	},
+}
+
+return look
