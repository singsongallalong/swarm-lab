+--!strict
+-- The vent lord's cuirass (Coreforged, the Aor'lan Core's epic plate): a
+-- broad black basalt cuirass whose two mismatched breastplates are split by a
+-- glowing seam, a gold gorget at the throat and tasset flaps below. Each arm
+-- is sleeved in black plate to a stepped pauldron carrying a tall vent
+-- chimney, its mouth hot inside a gold lip, and a molten seam across the
+-- shoulder top; a seam runs down each upper arm and one down the back beside
+-- the gold spine. At the high camera the chimneys flanking the helm and the
+-- gold trim carry it, with heat on every face.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 27, 25, 30 },
+	basaltDark = { 15, 14, 18 },
+	basaltEdge = { 48, 44, 48 },
+	molten = { 255, 94, 26 },
+	emberGold = { 190, 136, 56 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedChest",
+	slot = "Chest",
+	parts = Kit.join({
+		Kit.flaps(0.58, "Metal", c.basalt),
+		{
+			-- The cuirass shell over the whole torso.
+			Kit.box("UpperTorso", { 2.08, 1.64, 1.08 }, { 0, 0, 0 }, "Metal", c.basalt),
+			-- Two basalt breastplates, mismatched and canted, split by the Core's seam.
+			Kit.box("UpperTorso", { 0.94, 1.18, 0.12 }, { 0.48, 0.08, -0.57 }, "Metal", c.basalt, { 0, 0, -3 }),
+			Kit.box("UpperTorso", { 0.96, 1.14, 0.12 }, { -0.47, 0.1, -0.57 }, "Metal", c.basalt, { 0, 0, 3 }),
+			Kit.box("UpperTorso", { 0.07, 1.06, 0.1 }, { 0.01, 0.04, -0.65 }, "Neon", c.molten, { 0, 0, 4 }),
+			-- A gold gorget at the throat and a gold spine down the back.
+			Kit.box("UpperTorso", { 1, 0.12, 0.14 }, { 0, 0.7, -0.56 }, "Metal", c.emberGold),
+			Kit.box("UpperTorso", { 0.18, 1.1, 0.1 }, { 0, 0.08, 0.56 }, "Metal", c.emberGold),
+			-- The Core splits the back too, just off the spine.
+			Kit.box("UpperTorso", { 0.07, 0.86, 0.1 }, { 0.34, 0.1, 0.56 }, "Neon", c.molten, { 0, 0, -6 }),
+			-- Black plate sleeves, under stepped pauldrons.
+			Kit.box("UpperArm", { 1.08, 1.2, 1.08 }, { 0, 0, 0 }, "Metal", c.basalt),
+			Kit.box("UpperArm", { 1.38, 0.52, 1.38 }, { 0.06, 0.44, 0 }, "Metal", c.basalt, { 0, 0, -10 }),
+			Kit.box("UpperArm", { 1.16, 0.16, 1.16 }, { 0.08, 0.72, 0 }, "Metal", c.basaltEdge, { 0, 0, -10 }),
+			Kit.box("UpperArm", { 0.08, 0.06, 0.72 }, { 0.515, 0.745, 0 }, "Neon", c.molten, { 0, 0, -10 }),
+			-- Each pauldron carries a tall vent chimney, hot at the throat.
+			Kit.box("UpperArm", { 0.34, 0.72, 0.34 }, { 0.24, 1.04, 0.02 }, "Metal", c.basaltDark),
+			Kit.box("UpperArm", { 0.48, 0.1, 0.48 }, { 0.24, 1.44, 0.02 }, "Metal", c.emberGold),
+			Kit.box("UpperArm", { 0.26, 0.06, 0.26 }, { 0.24, 1.5, 0.02 }, "Metal", c.molten),
+			-- The seam runs on down each upper arm, hot in the dark.
+			Kit.box("UpperArm", { 0.08, 0.5, 0.08 }, { 0.53, -0.08, 0 }, "Neon", c.molten),
+			-- A broad belt over the whole waist, and its buckle.
+			Kit.box("LowerTorso", { 2.16, 0.42, 1.14 }, { 0, 0, 0 }, "Metal", c.basaltDark),
+			Kit.box("LowerTorso", { 0.34, 0.22, 0.1 }, { 0, 0.06, -0.6 }, "Metal", c.emberGold),
+		},
+	}),
+}
+
+return look
