+--!strict
+-- The vent lord's gauntlets (Coreforged, the Aor'lan Core's epic plate): close
+-- black plate bracers flaring to an elbow cuff, a molten seam down the outside
+-- of each forearm and a plated hand with a gold knuckle ridge. The right cuff
+-- is gold, the left scuffed bare, so the pair never reads stamped. At the high
+-- camera the forearm seam and the gold cuff are the line; the plate is
+-- near-black around them.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 27, 25, 30 },
+	basaltDark = { 15, 14, 18 },
+	basaltEdge = { 48, 44, 48 },
+	molten = { 255, 94, 26 },
+	emberGold = { 190, 136, 56 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedGloves",
+	slot = "Gloves",
+	parts = {
+		-- A black plate bracer up the forearm, flaring to the elbow.
+		Kit.box("LowerArm", { 1.14, 0.92, 1.14 }, { 0, -0.02, 0 }, "Metal", c.basalt),
+		Kit.box("LowerArm", { 1.34, 0.24, 1.34 }, { 0, 0.38, 0 }, "Metal", c.basaltDark),
+		-- One gold cuff, one scuffed: the pair is not a matched cast.
+		Kit.box("LowerArm", { 1.38, 0.08, 1.38 }, { 0, 0.52, 0 }, "Metal", c.emberGold, nil, "Right"),
+		Kit.box("LowerArm", { 1.38, 0.08, 1.38 }, { 0, 0.52, 0 }, "Metal", c.basaltEdge, nil, "Left"),
+		-- The molten seam down the outside of each forearm.
+		Kit.box("LowerArm", { 0.08, 0.68, 0.08 }, { 0.55, -0.14, 0 }, "Neon", c.molten),
+		-- A plated hand with a gold knuckle ridge.
+		Kit.box("Hand", { 1.1, 0.5, 1.14 }, { 0, 0, -0.02 }, "Metal", c.basaltDark),
+		Kit.box("Hand", { 0.9, 0.12, 0.16 }, { 0, 0.17, -0.56 }, "Metal", c.emberGold),
+	},
+}
+
+return look
