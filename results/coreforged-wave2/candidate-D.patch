+--!strict
+-- The vent crown (Coreforged, the Aor'lan Core's epic plate): a tall close
+-- helm of black basalt split by a molten visor slit. Above the gold circlet
+-- the crown stacks into a vent chimney, its hot mouth ringed in gold, and one
+-- gold crown spike leans off the right so the crown never reads stamped. At
+-- the high camera the tall stack and the gold band are the outline; up close
+-- the visor burns behind a gold nasal.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 27, 25, 30 },
+	basaltDark = { 15, 14, 18 },
+	molten = { 255, 94, 26 },
+	emberGold = { 190, 136, 56 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The bowl: a close basalt shell over the skull.
+		Kit.box("Head", { 1.34, 0.72, 1.34 }, { 0, 0.28, 0 }, "Metal", c.basalt),
+		-- A hammered jaw guard, split by a gold nasal ridge.
+		Kit.box("Head", { 1.02, 0.52, 0.32 }, { 0, -0.2, -0.53 }, "Metal", c.basaltDark),
+		Kit.box("Head", { 0.16, 0.56, 0.12 }, { 0, -0.14, -0.7 }, "Metal", c.emberGold),
+		-- The molten gaze behind the nasal.
+		Kit.box("Head", { 0.7, 0.09, 0.08 }, { 0, 0.22, -0.68 }, "Neon", c.molten),
+		-- The gold circlet and the stepped crown above it.
+		Kit.box("Head", { 1.42, 0.14, 1.42 }, { 0, 0.67, 0 }, "Metal", c.emberGold),
+		Kit.box("Head", { 1.02, 0.24, 1.02 }, { 0, 0.83, 0 }, "Metal", c.basaltDark),
+		-- The vent stack, capped in gold, its mouth a hot square from above.
+		Kit.box("Head", { 0.44, 0.5, 0.44 }, { 0, 1.05, 0 }, "Metal", c.basalt),
+		Kit.box("Head", { 0.6, 0.12, 0.6 }, { 0, 1.36, 0 }, "Metal", c.emberGold),
+		Kit.box("Head", { 0.34, 0.06, 0.34 }, { 0, 1.43, 0 }, "Metal", c.molten),
+		-- One gold crown spike, leaned, so the crown never reads stamped.
+		Kit.box("Head", { 0.16, 0.46, 0.16 }, { 0.52, 0.9, 0.06 }, "Metal", c.emberGold, { 0, 0, -10 }),
+		-- A plate tail over the back of the neck.
+		Kit.box("Head", { 1.3, 0.4, 0.46 }, { 0, -0.28, 0.46 }, "Metal", c.basaltDark),
+	},
+}
+
+return look
