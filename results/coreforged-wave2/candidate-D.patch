+--!strict
+-- The vent lord's greaves (Coreforged, the Aor'lan Core's epic plate): tall
+-- black basalt greaves with a raised shin plate, a gold band at the ankle and
+-- one gold knee horn on the right. A hot crack runs up the right shin plate,
+-- the only heat on the leg. At the high camera the gold knee and ankle bands
+-- break the black into a leg-shaped outline.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	basalt = { 27, 25, 30 },
+	basaltDark = { 15, 14, 18 },
+	basaltEdge = { 48, 44, 48 },
+	molten = { 255, 94, 26 },
+	emberGold = { 190, 136, 56 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "CoreforgedBoots",
+	slot = "Boots",
+	parts = {
+		-- The greave, a knee cop and a raised shin plate.
+		Kit.box("LowerLeg", { 1.12, 1, 1.12 }, { 0, -0.06, 0 }, "Metal", c.basalt),
+		Kit.box("LowerLeg", { 1.2, 0.26, 1.2 }, { 0, 0.46, 0 }, "Metal", c.basaltDark),
+		Kit.box("LowerLeg", { 0.72, 0.6, 0.12 }, { 0, -0.02, -0.58 }, "Metal", c.basaltEdge),
+		-- One gold knee horn, on the right only.
+		Kit.box("LowerLeg", { 0.18, 0.34, 0.18 }, { 0.34, 0.68, -0.18 }, "Metal", c.emberGold, { 0, 0, -10 }, "Right"),
+		-- A hot crack up the right shin plate.
+		Kit.box("LowerLeg", { 0.07, 0.46, 0.08 }, { 0.16, -0.04, -0.65 }, "Metal", c.molten, { 0, 0, 8 }, "Right"),
+		-- A gold band at the ankle.
+		Kit.box("LowerLeg", { 1.16, 0.09, 1.16 }, { 0, -0.5, 0 }, "Metal", c.emberGold),
+		-- The plated sabaton.
+		Kit.box("Foot", { 1.1, 0.44, 1.16 }, { 0, 0, -0.04 }, "Metal", c.basaltDark),
+	},
+}
+
+return look
