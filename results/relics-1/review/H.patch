index 00000000..915c38cb
--- /dev/null
+++ b/src/shared/systems/Relics.luau
@@ -0,0 +1,209 @@
+--!strict
+-- Relics (RelicTypes; docs/design/endgame-power.md section 2, a proposal): the pure core.
+-- Grades roll by weight, copies feed ranks and turn to dust past a grade's cap, and a
+-- loadout gathers its slotted relics' rank-scaled modifiers plus the synergy over their
+-- ranks. Pure: no Roblox API, randomness only from the rng it is given.
+local RelicTypes = require("../RelicTypes")
+local SkillTypes = require("../SkillTypes")
+
+type Grade = RelicTypes.Grade
+type Owned = RelicTypes.Owned
+type Collection = RelicTypes.Collection
+type AddResult = RelicTypes.AddResult
+type Slots = RelicTypes.Slots
+type RelicDef = RelicTypes.RelicDef
+type RelicEffect = RelicTypes.RelicEffect
+type Modifier = SkillTypes.Modifier
+
+local GRADES = RelicTypes.GRADES
+local MAX_RANK = RelicTypes.MAX_RANK
+local COPIES = RelicTypes.COPIES
+local AWAKEN_RANK = RelicTypes.AWAKEN_RANK
+local SLOTS = RelicTypes.SLOTS
+local DUST_PER_SPARE = RelicTypes.DUST_PER_SPARE
+local DUST_COST = RelicTypes.DUST_COST
+local SYNERGY_STEP = RelicTypes.SYNERGY_STEP
+local SYNERGY_RANKS = RelicTypes.SYNERGY_RANKS
+local SYNERGY_BEND = RelicTypes.SYNERGY_BEND
+local SYNERGY_SOURCE = RelicTypes.SYNERGY_SOURCE
+
+-- The highest rank any grade reaches; a relic's modifiers stop growing there.
+local MAX_MODIFIER_RANK = MAX_RANK.Exalted
+
+local Relics = {}
+
+-- GRADES runs lowest to highest, so a bigger place is a better grade.
+local GRADE_PLACE: { [Grade]: number } = {}
+for place, grade in GRADES do
+	GRADE_PLACE[grade] = place
+end
+
+-- One effect's modifier at a rank: ordinary effects count from rank 1, awakened ones from
+-- AWAKEN_RANK. Tags and conditions are copied so the row is never written back into.
+local function effectModifier(def: RelicDef, effect: RelicEffect, rank: number, awakened: boolean): Modifier
+	local firstRank = if awakened then AWAKEN_RANK else 1
+	local modifier: Modifier = {
+		stat = effect.stat,
+		kind = effect.kind,
+		value = effect.base + effect.perRank * (rank - firstRank),
+		source = "Relic: " .. def.title,
+	}
+	if effect.tags then
+		modifier.tags = table.clone(effect.tags)
+	end
+	if effect.conditions then
+		local conditions: { SkillTypes.Condition } = {}
+		for index, condition in effect.conditions do
+			conditions[index] = table.clone(condition)
+		end
+		modifier.conditions = conditions
+	end
+	return modifier
+end
+
+-- One rng draw times the total weight, walked lowest grade first; a grade with no weight
+-- is never rolled.
+function Relics.rollGrade(weights: { [Grade]: number }, rng: Random): Grade
+	local total = 0
+	for _, grade in GRADES do
+		total += weights[grade] or 0
+	end
+	local roll = rng:NextNumber() * total
+	local walked = 0
+	local lastWeighted: Grade? = nil
+	for _, grade in GRADES do
+		local weight = weights[grade] or 0
+		if weight > 0 then
+			walked += weight
+			lastWeighted = grade
+			if roll < walked then
+				return grade
+			end
+		end
+	end
+	-- Only weights that are all zero reach here; nothing has a chance, so take the lowest.
+	return lastWeighted or GRADES[1]
+end
+
+function Relics.newCollection(): Collection
+	return { relics = {}, dust = 0 }
+end
+
+function Relics.addCopy(c: Collection, name: string, grade: Grade): AddResult
+	local owned = c.relics[name]
+	if not owned then
+		c.relics[name] = { grade = grade, rank = 1, spare = 0 }
+		return { kind = "new", upgraded = false, rank = 1, dust = 0 }
+	end
+
+	-- A better grade raises the cap; it never resets the rank or the spare already fed.
+	local upgraded = GRADE_PLACE[grade] > GRADE_PLACE[owned.grade]
+	if upgraded then
+		owned.grade = grade
+	end
+
+	if owned.rank >= MAX_RANK[owned.grade] then
+		c.dust += DUST_PER_SPARE
+		return { kind = "dust", upgraded = upgraded, rank = owned.rank, dust = DUST_PER_SPARE }
+	end
+
+	owned.spare += 1
+	if owned.spare >= COPIES[owned.rank + 1] then
+		-- One rank at a time: the spare count starts over for the next rank's step.
+		owned.spare = 0
+		owned.rank += 1
+		return { kind = "rank", upgraded = upgraded, rank = owned.rank, dust = 0 }
+	end
+	return { kind = "progress", upgraded = upgraded, rank = owned.rank, dust = 0 }
+end
+
+function Relics.copiesToMax(o: Owned): number
+	local needed = 0
+	for rank = o.rank + 1, MAX_RANK[o.grade] do
+		needed += COPIES[rank]
+	end
+	return needed
+end
+
+function Relics.buyCopy(c: Collection, name: string): (boolean, AddResult?)
+	local owned = c.relics[name]
+	if not owned or owned.rank >= MAX_RANK[owned.grade] or c.dust < DUST_COST then
+		return false, nil
+	end
+	c.dust -= DUST_COST
+	return true, Relics.addCopy(c, name, "Lesser")
+end
+
+function Relics.modifiers(def: RelicDef, rank: number): { Modifier }
+	local mods: { Modifier } = {}
+	if rank < 1 then
+		return mods
+	end
+	local capped = math.min(rank, MAX_MODIFIER_RANK)
+	for _, effect in def.effects do
+		table.insert(mods, effectModifier(def, effect, capped, false))
+	end
+	if capped >= AWAKEN_RANK then
+		for _, effect in def.awakened do
+			table.insert(mods, effectModifier(def, effect, capped, true))
+		end
+	end
+	return mods
+end
+
+function Relics.slot(slots: Slots, index: number, name: string, c: Collection): (boolean, string?)
+	if index % 1 ~= 0 or index < 1 or index > SLOTS then
+		return false, string.format("slot must be a whole number from 1 to %d", SLOTS)
+	end
+	if not c.relics[name] then
+		return false, string.format("%s is not owned", name)
+	end
+	for other, held in slots do
+		if held == name and other ~= index then
+			return false, string.format("%s already sits in slot %d", name, other)
+		end
+	end
+	slots[index] = name
+	return true, nil
+end
+
+function Relics.unslot(slots: Slots, index: number): ()
+	slots[index] = nil
+end
+
+function Relics.synergy(totalRanks: number): number
+	if totalRanks <= 0 then
+		return 0
+	end
+	local steps = math.floor(totalRanks / SYNERGY_RANKS)
+	local bendStep = math.floor(SYNERGY_BEND / SYNERGY_RANKS)
+	local belowBend = math.min(steps, bendStep)
+	local pastBend = math.max(steps - bendStep, 0)
+	return belowBend * SYNERGY_STEP + pastBend * SYNERGY_STEP / 2
+end
+
+function Relics.loadout(slots: Slots, c: Collection, defs: { [string]: RelicDef }): { Modifier }
+	local mods: { Modifier } = {}
+	local totalRanks = 0
+	for index = 1, SLOTS do
+		local name = slots[index]
+		if name then
+			local owned = c.relics[name]
+			local def = defs[name]
+			if owned and def then
+				totalRanks += owned.rank
+				for _, modifier in Relics.modifiers(def, owned.rank) do
+					table.insert(mods, modifier)
+				end
+			end
+		end
+	end
+	local bonus = Relics.synergy(totalRanks)
+	if bonus > 0 then
+		table.insert(mods, { stat = "Damage", kind = "increased", value = bonus, source = SYNERGY_SOURCE })
+		table.insert(mods, { stat = "MaxLife", kind = "increased", value = bonus, source = SYNERGY_SOURCE })
+	end
+	return mods
+end
+
+return Relics
