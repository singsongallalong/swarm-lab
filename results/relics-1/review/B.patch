diff --git a/src/shared/systems/Relics.luau b/src/shared/systems/Relics.luau
new file mode 100644
index 00000000..155505cf
--- /dev/null
+++ b/src/shared/systems/Relics.luau
@@ -0,0 +1,199 @@
+--!strict
+-- Relics, the pure core (RelicTypes; docs/design/endgame-power.md section 2, a
+-- proposal): the account's collection of grades, ranks, spare copies and dust,
+-- a character's four slots, and the modifiers a relic lends its bearer at its
+-- rank. No Roblox API; randomness only from the rng it is given.
+local RelicTypes = require("../RelicTypes")
+local SkillTypes = require("../SkillTypes")
+
+-- Where a grade sits in GRADES (lowest first), so "higher" is a bigger level.
+local function gradeLevel(grade: RelicTypes.Grade): number
+	for level, g in RelicTypes.GRADES do
+		if g == grade then
+			return level
+		end
+	end
+	return 0
+end
+
+local function rollGrade(weights: { [RelicTypes.Grade]: number }, rng: Random): RelicTypes.Grade
+	-- One draw in [0, 1) over the total weight, walked lowest grade first, so
+	-- a grade with no weight (missing or 0) can never come up.
+	local total = 0
+	for _, grade in RelicTypes.GRADES do
+		total += weights[grade] or 0
+	end
+	local roll = rng:NextNumber() * total
+	for _, grade in RelicTypes.GRADES do
+		roll -= weights[grade] or 0
+		if roll < 0 then
+			return grade
+		end
+	end
+	-- No grade carried weight; nothing can be said to be rolled, so the
+	-- lowest is the fallback.
+	return RelicTypes.GRADES[1]
+end
+
+local function newCollection(): RelicTypes.Collection
+	return { relics = {}, dust = 0 }
+end
+
+local function addCopy(c: RelicTypes.Collection, name: string, grade: RelicTypes.Grade): RelicTypes.AddResult
+	local owned = c.relics[name]
+	if not owned then
+		c.relics[name] = { grade = grade, rank = 1, spare = 0 }
+		return { kind = "new", upgraded = false, rank = 1, dust = 0 }
+	end
+
+	-- A higher grade first replaces the held one, keeping rank and spare; the
+	-- copy then feeds the (possibly new) grade as usual.
+	local upgraded = false
+	if gradeLevel(grade) > gradeLevel(owned.grade) then
+		owned.grade = grade
+		upgraded = true
+	end
+
+	if owned.rank >= RelicTypes.MAX_RANK[owned.grade] then
+		c.dust += RelicTypes.DUST_PER_SPARE
+		return { kind = "dust", upgraded = upgraded, rank = owned.rank, dust = RelicTypes.DUST_PER_SPARE }
+	end
+
+	owned.spare += 1
+	if owned.spare >= RelicTypes.COPIES[owned.rank + 1] then
+		owned.rank += 1
+		owned.spare = 0
+		return { kind = "rank", upgraded = upgraded, rank = owned.rank, dust = 0 }
+	end
+	return { kind = "progress", upgraded = upgraded, rank = owned.rank, dust = 0 }
+end
+
+local function copiesToMax(o: RelicTypes.Owned): number
+	local needed = 0
+	for rank = o.rank, RelicTypes.MAX_RANK[o.grade] - 1 do
+		needed += RelicTypes.COPIES[rank + 1]
+	end
+	-- Spare copies already count toward the next rank; never below 0 (at the
+	-- cap, or with more spare than needed).
+	return math.max(needed - o.spare, 0)
+end
+
+local function buyCopy(c: RelicTypes.Collection, name: string): (boolean, RelicTypes.AddResult?)
+	local owned = c.relics[name]
+	if not owned then
+		return false, nil
+	end
+	if owned.rank >= RelicTypes.MAX_RANK[owned.grade] then
+		return false, nil
+	end
+	if c.dust < RelicTypes.DUST_COST then
+		return false, nil
+	end
+	c.dust -= RelicTypes.DUST_COST
+	return true, addCopy(c, name, "Lesser")
+end
+
+local function modifiers(def: RelicTypes.RelicDef, rank: number): { SkillTypes.Modifier }
+	local mods: { SkillTypes.Modifier } = {}
+	if rank < 1 then
+		return mods
+	end
+	local r = math.min(rank, 10)
+
+	local function add(list: { RelicTypes.RelicEffect }, startRank: number)
+		for _, e in list do
+			local mod: SkillTypes.Modifier = {
+				stat = e.stat,
+				kind = e.kind,
+				value = e.base + e.perRank * (r - startRank),
+				source = "Relic: " .. def.title,
+			}
+			-- Copied, never shared, so nothing can reach back into the def.
+			if e.tags then
+				mod.tags = table.clone(e.tags)
+			end
+			if e.conditions then
+				mod.conditions = table.clone(e.conditions)
+			end
+			table.insert(mods, mod)
+		end
+	end
+
+	add(def.effects, 1)
+	if r >= RelicTypes.AWAKEN_RANK then
+		add(def.awakened, RelicTypes.AWAKEN_RANK)
+	end
+	return mods
+end
+
+local function slot(slots: RelicTypes.Slots, index: number, name: string, c: RelicTypes.Collection): (boolean, string?)
+	if index < 1 or index > RelicTypes.SLOTS or math.floor(index) ~= index then
+		return false, "slot " .. tostring(index) .. " is out of range"
+	end
+	if not c.relics[name] then
+		return false, name .. " is not owned"
+	end
+	if slots[index] == name then
+		return true
+	end
+	for _, slotted in slots do
+		if slotted == name then
+			return false, name .. " is already slotted"
+		end
+	end
+	slots[index] = name
+	return true
+end
+
+local function unslot(slots: RelicTypes.Slots, index: number)
+	slots[index] = nil
+end
+
+local function synergy(totalRanks: number): number
+	-- Full steps up to the bend, then half steps: synergy(20) = 0.05,
+	-- synergy(24) = 0.055.
+	local steps = math.floor(math.min(totalRanks, RelicTypes.SYNERGY_BEND) / RelicTypes.SYNERGY_RANKS)
+		+ math.floor(math.max(totalRanks - RelicTypes.SYNERGY_BEND, 0) / RelicTypes.SYNERGY_RANKS) / 2
+	return steps * RelicTypes.SYNERGY_STEP
+end
+
+local function loadout(
+	slots: RelicTypes.Slots,
+	c: RelicTypes.Collection,
+	defs: { [string]: RelicTypes.RelicDef }
+): { SkillTypes.Modifier }
+	local mods: { SkillTypes.Modifier } = {}
+	local totalRanks = 0
+	for index = 1, RelicTypes.SLOTS do
+		local name = slots[index]
+		if name then
+			local owned = c.relics[name]
+			local def = defs[name]
+			if owned and def then
+				for _, mod in modifiers(def, owned.rank) do
+					table.insert(mods, mod)
+				end
+				totalRanks += owned.rank
+			end
+		end
+	end
+	local value = synergy(totalRanks)
+	if value > 0 then
+		table.insert(mods, { stat = "Damage", kind = "increased", value = value, source = RelicTypes.SYNERGY_SOURCE })
+		table.insert(mods, { stat = "MaxLife", kind = "increased", value = value, source = RelicTypes.SYNERGY_SOURCE })
+	end
+	return mods
+end
+
+return table.freeze({
+	rollGrade = rollGrade,
+	newCollection = newCollection,
+	addCopy = addCopy,
+	copiesToMax = copiesToMax,
+	buyCopy = buyCopy,
+	modifiers = modifiers,
+	slot = slot,
+	unslot = unslot,
+	synergy = synergy,
+	loadout = loadout,
+})
