diff --git a/src/shared/data/outdoorTilesets/Brinewrack.luau b/src/shared/data/outdoorTilesets/Brinewrack.luau
new file mode 100644
index 0000000..53559c5
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Brinewrack.luau
@@ -0,0 +1,300 @@
+--!strict
+-- Brinewrack, the drowned coast (Brinewrack's look, from the field's pieces):
+-- a fishing country that went under the sea and whose tide never fully went
+-- out. Field's dressing, repainted and thinned for a shore: wet slate-grey
+-- shingle for the heath, a pale cobbled sea road, black silt in the ruins,
+-- black rock cliffs and skerries, and the dead thickets become a wrack line of
+-- grey-brown driftwood. Its one accent (bible B8) is a cold sea-green, in the
+-- kelp, in the pale tide-pools and in the phosphorescence the set pieces draw
+-- along the waterline. Its landmarks are the dead lighthouse on its shingle and
+-- the bleached ribs of a great wreck in a hollow (B11), both read from the high
+-- camera. Under the silver-blue `mood` preset, as cold as the moor is grim: the
+-- only warm light is what someone still tends, the road's lanterns, a shrine's
+-- lamp and a brazier left burning in the ruins (B2).
+local Field = require("./Field")
+local LightingPresets = require("../LightingPresets")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Wet coast ground by terrain material, as Field paints its living ground:
+-- Terrain keeps one colour per material, so every look on a material moves
+-- together (OutdoorTilesets.spec). Ground grows no blades, so the shingle
+-- keeps the low props legible.
+local SEA: { [string]: { number } } = {
+	Ground = { 54, 58, 62 }, -- wet slate-grey shingle
+	Mud = { 38, 42, 46 }, -- black silt under the waterline, the ruins' floor
+	Basalt = { 46, 51, 55 }, -- wet black rock
+	LeafyGrass = { 50, 56, 54 }, -- the seaweed margin the land climbs on, past the rim
+	Slate = { 17, 19, 20 }, -- the sea in the abyss
+}
+
+local function washed(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = SEA[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- The generated cliff, outcrop and boulder meshes take Basalt's texture, which
+-- lifts them: at this paint they stay black rock and keep their facets (A005,
+-- C49). Bleached driftwood for the meshes of the wrack line.
+local ROCK = { 50, 56, 58 }
+local DRIFTWOOD = { 78, 72, 62 }
+-- Warm light is rare and means someone (B2): the road's lanterns and the
+-- shrine's lamp. Saturated on purpose (B8).
+local FLAME = { 255, 168, 88 }
+local LANTERN_FLICKER: OutdoorTypes.Pulse = { style = "flicker", depth = 0.12, period = 1.3 }
+local LANTERN_CAGE = 0.9
+
+local function rocked(pieces: { OutdoorTypes.PieceLook }): { OutdoorTypes.PieceLook }
+	local out = table.clone(pieces)
+	for i, piece in out do
+		out[i] = with(piece, { color = ROCK })
+	end
+	return out
+end
+
+-- The road's lamp, and the same at each threshold: a driftwood post with the
+-- lantern hanging under its chain.
+local LAMP: OutdoorTypes.PieceLook = {
+	name = "LampPost",
+	size = Sculpts.brinewrack_lamppost.size,
+	sculpt = "brinewrack_lamppost",
+	light = {
+		color = FLAME,
+		range = 20,
+		brightness = 1.5,
+		height = (Sculpts.brinewrack_lamppost.arm :: number)
+			- (Sculpts.brinewrack_lamppost.drop :: number)
+			- LANTERN_CAGE * 1.3 / 2,
+		reach = Sculpts.brinewrack_lamppost.reach,
+		cage = LANTERN_CAGE,
+		pulse = LANTERN_FLICKER,
+	},
+}
+
+local props = table.clone(Field.props)
+-- The heath's clumps: kelp and wrack in the zone's cold sea-green, the one
+-- accent (B8) strewn where the tide left it.
+props.heather = with(props.heather, {
+	pieces = { { name = "Wrack", size = Sculpts.brinewrack_wrack.size, sculpt = "brinewrack_wrack" } },
+	perHundredCells = 4,
+})
+-- The drowned village's footings: broken stone stumps out on the shingle.
+local stumps: OutdoorTypes.PropSet = {
+	pieces = { { name = "CottageStumps", size = Sculpts.brinewrack_stumps.size, sculpt = "brinewrack_stumps" } },
+	perHundredCells = 1.2,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.8, 1.5 },
+	sink = 0.6,
+}
+props.stumps = table.freeze(stumps)
+-- Spars and ribs half buried in the shingle, well out of the road's way.
+local spars: OutdoorTypes.PropSet = {
+	pieces = { { name = "Driftwood", size = Sculpts.brinewrack_driftwood.size, sculpt = "brinewrack_driftwood" } },
+	perHundredCells = 0.45,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.8, 1.4 },
+	sink = 0.8,
+}
+props.spars = table.freeze(spars)
+-- The great wreck (B11): the bleached ribs of a hull half sunk in the shingle,
+-- one a map, clear of the road so it pulls the eye across the coast.
+local wreck: OutdoorTypes.PropSet = {
+	pieces = { { name = "SunkenWreck", size = Sculpts.brinewrack_wreck.size, sculpt = "brinewrack_wreck" } },
+	perHundredCells = 0,
+	count = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 220,
+	clearance = 4,
+	scale = { 0.95, 1.1 },
+	sink = 1.4,
+}
+props.wreck = table.freeze(wreck)
+-- The dead lighthouse (B11): the coast's own silhouette, a pale broken tower
+-- with its lamp still burning sea-green at the top, the one cold light that
+-- draws the eye across the water. Quiet, so it stands off the fights.
+local lighthouse: OutdoorTypes.PropSet = {
+	pieces = {
+		{
+			name = "DeadLighthouse",
+			size = Sculpts.brinewrack_lighthouse.size,
+			sculpt = "brinewrack_lighthouse",
+			light = {
+				color = { 96, 208, 168 },
+				range = 50,
+				brightness = 1.2,
+				height = (Sculpts.brinewrack_lighthouse.size :: { number })[2] * 0.78,
+				ember = 1.4,
+				cage = 2,
+				pulse = { style = "breathe", depth = 0.28, period = 9 },
+			},
+		},
+	},
+	perHundredCells = 0,
+	count = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 240,
+	clearance = 5,
+	quiet = true,
+	scale = { 1, 1.05 },
+	sink = 0.5,
+}
+props.lighthouse = table.freeze(lighthouse)
+-- The shore's landmarks are its own; the moor's watchtower and stone circles
+-- stay behind the seam.
+props.watchtower = nil
+props.stone_circles = nil
+-- Fewer, farther lanterns than the field's: an empty coast keeps few lamps.
+props.lanterns = with(props.lanterns, { pieces = { LAMP }, spacing = 130 })
+-- The road's places: a drowned well and a weathered cross, not the field's hay.
+props.waysides = with(props.waysides, {
+	pieces = {
+		{ name = "Well", size = Sculpts.field_well.size, sculpt = "field_well" },
+		{ name = "WaysideCross", size = Sculpts.brinewrack_cross.size, sculpt = "brinewrack_cross" },
+	},
+	count = 4,
+})
+-- Fewer grave lanterns and braziers: light is rarer than on the moor.
+props.candles = with(props.candles, { perHundredCells = 5 })
+props.embers = with(props.embers, { perHundredCells = 1.5 })
+-- The boulders in the coast's black rock.
+props.boulders = with(props.boulders, { pieces = rocked(props.boulders.pieces) })
+
+local brinewrack = table.clone(Field) :: OutdoorTypes.OutdoorTileset
+brinewrack.name = "brinewrack"
+brinewrack.palette = "wet slate-grey shingle and black rock, grey-brown driftwood bleached to bone, "
+	.. "pale green-grey tide-pools, cold sea-green phosphorescence as the one accent, "
+	.. "desaturated, matte, no highlights"
+brinewrack.lighting = "mood"
+brinewrack.props = table.freeze(props)
+-- Thicker and greener than the field's, a cold sea haze at ankle height (B9).
+brinewrack.groundMist = with(Field.groundMist, {
+	color = { 92, 108, 106 },
+	perHundredCells = 0.55,
+	spacing = 44,
+	size = 30,
+	transparency = 0.85,
+})
+-- The ground by material: shingle, the old sea road, black silt in the ruins.
+brinewrack.ground = with(Field.ground, {
+	heath = { material = "Ground", color = SEA.Ground },
+	road = { material = "Cobblestone", color = { 62, 67, 71 } },
+	ruin = { material = "Mud", color = SEA.Mud },
+})
+
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Field.edges :: any)
+-- The rim cliffs and the rock islands: black rock, wet and cold.
+edges["cliff"] = with(edges["cliff"], { pieces = rocked(edges["cliff"].pieces) })
+-- The dead thicket becomes the wrack line: low bleached driftwood in place of
+-- the moor's tall black trees, so the coast stays open to the sea.
+local wrackLine = table.clone(edges["thicket"].pieces)
+for i, piece in wrackLine do
+	if piece.sculpt then
+		wrackLine[i] = with(piece, {
+			name = "Driftwood",
+			size = Sculpts.brinewrack_driftwood.size,
+			sculpt = "brinewrack_driftwood",
+			weight = 0.7,
+		})
+	else
+		wrackLine[i] = with(piece, { color = DRIFTWOOD })
+	end
+end
+edges["thicket"] = with(edges["thicket"], { pieces = wrackLine, scale = { 1.2, 2 }, spacing = 6 })
+-- Dry-stone cottage walls along the walk, not the town's kept curtain.
+edges["ruin_wall"] = with(edges["ruin_wall"], { run = "moor_field_wall" })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = washed(edge.ground) })
+	end
+end
+brinewrack.edges = table.freeze(edges) :: any
+-- The rock islands inside the heath.
+local outcrop = with(Field.outcrop, { pieces = rocked(Field.outcrop.pieces) })
+if Field.outcrop.ground then
+	outcrop = with(outcrop, { ground = washed(Field.outcrop.ground) })
+end
+brinewrack.outcrop = outcrop
+local bluffRock = Field.bluff and Field.bluff.rock
+if Field.bluff and bluffRock then
+	brinewrack.bluff = with(Field.bluff, { rock = washed(bluffRock) })
+end
+-- The Low Moor's standing water becomes the coast's tide-pools: a pale sheet
+-- over black silt, with stepping stones across (the sea leaves them proud).
+if Field.pools then
+	brinewrack.pools = with(Field.pools, {
+		sheet = { name = "TidePool", size = Sculpts.brinewrack_tide.size, sculpt = "brinewrack_tide" },
+		bed = washed(Field.pools.bed),
+		causeway = {
+			stones = {
+				{ name = "SteppingStone", size = { 2.6, 0.8, 3.6 }, material = "Slate", color = { 84, 90, 90 } },
+				{ name = "SteppingStone", size = { 3.2, 0.8, 2.8 }, material = "Slate", color = { 76, 82, 84 } },
+				{ name = "SteppingStone", size = { 2.2, 0.9, 3 }, material = "Slate", color = { 90, 92, 90 } },
+			},
+			step = 3,
+			sink = 0.35,
+		},
+	})
+end
+-- Out past the rim the coast drops to the sea: black water under layered
+-- haze, no hills, so the map reads as a last edge of land in open water.
+brinewrack.beyond = with(Field.beyond, {
+	ground = washed(Field.beyond.ground),
+	rock = washed(Field.beyond.rock),
+	abyss = washed(Field.beyond.abyss),
+	reach = 14,
+	maxRise = 16,
+	abyssDepth = 120,
+	mist = with(Field.beyond.mist, {
+		color = (LightingPresets.mood.atmosphere :: any).color,
+		transparency = 0.4,
+		depth = 26,
+		layers = 3,
+		spacing = 9,
+	}),
+})
+-- The field's landmarks in the coast's own: the great wreck in the hollow, the
+-- dead lighthouse standing on the crag past the seam, its beacons either side.
+local baseLandmarks = Field.landmarks
+if baseLandmarks then
+	local landmarks = table.clone(baseLandmarks)
+	landmarks.bones = { name = "SunkenWreck", size = Sculpts.brinewrack_wreck.size, sculpt = "brinewrack_wreck" }
+	landmarks.fort = {
+		name = "DeadLighthouse",
+		size = Sculpts.brinewrack_lighthouse.size,
+		sculpt = "brinewrack_lighthouse",
+	}
+	-- The Labyrinth's gate is the first field's own.
+	landmarks.labyrinthGate = nil
+	landmarks.rock = washed(baseLandmarks.rock)
+	landmarks.headland = washed(baseLandmarks.headland)
+	landmarks.barricade = "field_seam_barricade"
+	landmarks.paddock = "moor_field_wall"
+	landmarks.seamArch = { name = "SeamArch", size = Sculpts.town_gate_arch.size, sculpt = "town_gate_arch" }
+	landmarks.seamLamp = LAMP
+	brinewrack.landmarks = table.freeze(landmarks)
+end
+-- Each threshold between reaches (A012 step 2b): the road's lanterns and a
+-- marker stone with the coast's sea-green rag, so a way on reads the same.
+brinewrack.thresholds = table.freeze({
+	lamp = LAMP,
+	marker = {
+		name = "ThresholdMarker",
+		size = Sculpts.brinewrack_marker.size,
+		sculpt = "brinewrack_marker",
+		solid = true,
+	},
+})
+-- No town on the shore, and nobody left to light a window.
+brinewrack.town = nil
+brinewrack.litWindows = nil
+brinewrack.kits = nil
+
+return table.freeze(brinewrack)
