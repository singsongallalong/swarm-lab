diff --git a/src/shared/data/outdoorTilesets/Brinewrack.luau b/src/shared/data/outdoorTilesets/Brinewrack.luau
new file mode 100644
index 0000000..11aed6d
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Brinewrack.luau
@@ -0,0 +1,319 @@
+--!strict
+-- Brinewrack, the drowned coast: a fishing country that went under the sea,
+-- its tide never fully out. Wet slate shingle and black rock, grey-brown
+-- driftwood, the bleached ribs of wrecked hulls, pale tide-pools with a cold
+-- sea-green sheen -- the zone's one muted accent (bible B8), unlike the
+-- Ashfields' violet or the Moonwell's silver-teal. The landmark is the dead
+-- lighthouse on the headland, a tower alone against the sky, with the great
+-- wreck's ribs lying in a hollow below it (B11). Derived from the moor the way
+-- Field derives from it: clone, then repaint every ground by terrain material
+-- and dress the rims and the shore for the coast.
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Wet shingle and black rock by terrain material, as Field paints its living
+-- ground: Terrain keeps one colour per material, so every look on a material
+-- moves together (OutdoorTilesets.spec).
+local SHINGLE: { [string]: { number } } = {
+	Grass = { 57, 63, 67 }, -- thin salt-grass over wet slate shingle; Roblox's blades take it
+	Ground = { 60, 63, 66 }, -- wet shingle
+	LeafyGrass = { 43, 47, 50 }, -- the darker banks under the walls
+	Mud = { 38, 40, 43 }, -- black wet mud under the ruins
+	Basalt = { 45, 48, 52 }, -- black rock
+}
+
+local function wet(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = SHINGLE[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- Black rock kept two thirds up the value range: untextured, anything darker
+-- loses its facets and reads as a flat black shape (the moor's lesson). The
+-- darker one is the far headland's fire brazier.
+local ROCK = { 54, 58, 62 }
+local ROCK_DARK = { 46, 50, 54 }
+-- Grey-brown driftwood: the thicket's dead trees silvered by salt, so they
+-- read as wrack rather than as woods.
+local DRIFT = { 60, 57, 52 }
+
+-- Mesh pieces take the coast's paint; sculpts carry their own colours.
+local function painted(pieces: { OutdoorTypes.PieceLook }, color: { number }): { OutdoorTypes.PieceLook }
+	local out = table.clone(pieces)
+	for i, piece in out do
+		if piece.mesh then
+			out[i] = with(piece, { color = color })
+		end
+	end
+	return out
+end
+
+-- The cliff rim in black rock: the moor's generated faces, repainted, and
+-- further apart so the coast keeps its bare stretches.
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+edges["cliff"] = with(edges["cliff"], {
+	pieces = painted(edges["cliff"].pieces, ROCK),
+	spacing = 8,
+})
+-- Dead trees along the thicket rims, silvered to driftwood, and now and then a
+-- sculpted snag: a wind-scoured headland keeps few, and bent.
+local trees = table.clone(edges["thicket"].pieces)
+for i, piece in trees do
+	if piece.sculpt then
+		trees[i] = with(piece, {
+			sculpt = "brinewrack_driftwood",
+			name = "DriftwoodSnag",
+			size = Sculpts.brinewrack_driftwood.size,
+			weight = 0.5,
+		})
+	else
+		trees[i] = with(piece, { color = DRIFT })
+	end
+end
+edges["thicket"] = with(edges["thicket"], { pieces = trees, spacing = 9, scale = { 1.2, 1.9 } })
+-- The old dry-stone walls of the drowned fields stay as the moor builds them;
+-- only their footing is repainted with every other edge's.
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = wet(edge.ground) })
+	end
+end
+
+-- The road lamp: the moor's crooked post and its warm lantern, far apart on a
+-- coast where few still light the way (bible B2: warm light is rare).
+local ROAD_LAMP = Moor.props.lanterns.pieces[1]
+
+-- The coast's props. No moor reaches' watchtower or stone circle: the headland
+-- has its own landmarks (B11).
+local props: { [string]: OutdoorTypes.PropSet } = {
+	-- Thin salt-grass in place of heather, sparse over the bare shingle.
+	heather = with(Moor.props.heather, {
+		pieces = {
+			{ name = "SaltGrass", size = Sculpts.brinewrack_sea_grass.size, sculpt = "brinewrack_sea_grass" },
+		},
+		perHundredCells = 3.5,
+		scale = { 0.85, 1.15 },
+	}),
+	headstones = Moor.props.headstones,
+	candles = Moor.props.candles,
+	lanterns = with(Moor.props.lanterns, { spacing = 120 }),
+	embers = Moor.props.embers,
+	-- Black rock out on the shingle: visible stone, so it is solid.
+	boulders = {
+		pieces = {
+			{
+				name = "BlackBoulder",
+				size = Sculpts.brinewrack_boulder.size,
+				sculpt = "brinewrack_boulder",
+				solid = true,
+			},
+		},
+		perHundredCells = 1,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		scale = { 0.6, 1.3 },
+		sink = 0.8,
+	},
+	-- A boarded cave mouth at the foot of a cliff: a way in kept shut for
+	-- later, as the moor's is.
+	caves = {
+		pieces = { { name = "CaveMouth", size = Sculpts.moor_cave.size, sculpt = "moor_cave" } },
+		perHundredCells = 0,
+		count = 1,
+		on = { "cliffside" :: OutdoorTypes.PropGround },
+		backToCliff = true,
+		scale = { 1, 1.15 },
+		sink = 0.3,
+	},
+	-- The wrack line: snags of driftwood cast up over the shingle, clear of
+	-- the road and the fights.
+	driftwood = {
+		pieces = {
+			{ name = "DriftwoodSnag", size = Sculpts.brinewrack_driftwood.size, sculpt = "brinewrack_driftwood" },
+		},
+		perHundredCells = 0,
+		count = 9,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		spacing = 60,
+		quiet = true,
+		scale = { 0.8, 1.4 },
+		sink = 0.4,
+	},
+	-- The hulls that came in with the tide: bleached ribs along the shore,
+	-- well clear of the way.
+	wrecks = {
+		pieces = {
+			{ name = "WreckRibs", size = Sculpts.brinewrack_wreck_ribs.size, sculpt = "brinewrack_wreck_ribs" },
+		},
+		perHundredCells = 0,
+		count = 2,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		spacing = 160,
+		clearance = 4,
+		quiet = true,
+		scale = { 0.9, 1.1 },
+		sink = 0.6,
+	},
+	-- Black stacks standing out of the heath where the rock comes through:
+	-- tall silhouettes to steer by from above. One a map, at least.
+	stacks = {
+		pieces = { { name = "SeaStack", size = Sculpts.brinewrack_stack.size, sculpt = "brinewrack_stack" } },
+		perHundredCells = 0,
+		count = 3,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		spacing = 120,
+		clearance = 4,
+		quiet = true,
+		least = 1,
+		scale = { 0.8, 1.2 },
+		sink = 0.8,
+	},
+	-- The headland's dead lighthouse: the zone's landmark (B11). One a map,
+	-- clear of the road and every site, tall enough to show over everything.
+	-- Not quiet: a landmark the map's dressing must place, like the moor's
+	-- watchtower, so it is always there to steer by.
+	lighthouse = {
+		pieces = {
+			{ name = "Lighthouse", size = Sculpts.brinewrack_lighthouse.size, sculpt = "brinewrack_lighthouse" },
+		},
+		perHundredCells = 0,
+		count = 1,
+		on = { "heath" :: OutdoorTypes.PropGround },
+		clearance = 4,
+		scale = { 1, 1 },
+		sink = 0.8,
+	},
+}
+
+local brinewrack = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+brinewrack.name = "brinewrack"
+brinewrack.palette = "wet slate-grey shingle, black blue-grey basalt, grey-brown driftwood, "
+	.. "bleached bone-pale wreck timber, pale tide-pools with a cold sea-green sheen, desaturated, matte, no highlights"
+-- The moonlit night the moor keeps (B1-B3): silver-blue moonlight, warm lamps,
+-- low mist. Not the field's warmer night, nor the Ashfields' smoky one.
+brinewrack.lighting = "mood"
+brinewrack.props = table.freeze(props)
+-- Sea fog: heavier and greyer than the moor's, hanging over the shingle as it
+-- does over cold water (B9).
+brinewrack.groundMist = with(Moor.groundMist, {
+	color = { 132, 144, 140 },
+	perHundredCells = 0.6,
+	spacing = 48,
+	size = 28,
+	transparency = 0.85,
+})
+
+-- Wet shingle, black mud under the ruins, and a road of pale wet cobbles that
+-- reads as the way on from above (the Ashfields learnt the same).
+brinewrack.ground = with(Moor.ground, {
+	heath = wet(Moor.ground.heath),
+	ruin = wet(Moor.ground.ruin),
+	road = { material = "Cobblestone", color = { 76, 78, 80 } },
+})
+brinewrack.edges = table.freeze(edges) :: any
+brinewrack.outcrop = with(Moor.outcrop, {
+	pieces = painted(Moor.outcrop.pieces, ROCK),
+	ground = wet(Moor.outcrop.ground),
+	spacing = 6,
+})
+-- Sea cliffs: more bare rock than walled shelf, so fewer retaining walls and
+-- the ledges themselves are black basalt.
+local bluffRock = Moor.bluff and Moor.bluff.rock
+if bluffRock then
+	brinewrack.bluff = with(Moor.bluff, {
+		rock = wet(bluffRock),
