diff --git a/src/shared/data/outdoorTilesets/Brinewrack.luau b/src/shared/data/outdoorTilesets/Brinewrack.luau
new file mode 100644
index 0000000..09862d2
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Brinewrack.luau
@@ -0,0 +1,305 @@
+--!strict
+-- Brinewrack, the drowned coast: a fishing country that went under the sea,
+-- its tide never fully out. Wet slate-grey shingle and black rock, grey-brown
+-- driftwood, the bleached ribs of wrecked hulls lying on the shingle like the
+-- ribs of dead beasts, pale tide-pools, and the dead lighthouse on its
+-- headland. One muted accent (bible B8): the cold sea-green of phosphorescence
+-- in kelp, quite unlike the Ashfields' violet or the Moonwell's silver-teal.
+-- Derived from the field's tileset the way Field2 is, so it costs what a field
+-- costs: the same pieces, every ground repainted by terrain material, the
+-- field's warm town and living green put out, and the rim thickets turned into
+-- banks of wrecks.
+local Field = require("./Field")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- The coast by terrain material, as Field paints its living ground: Terrain
+-- keeps one colour per material, so every look on a material keeps one colour
+-- here too (OutdoorTilesets.spec). Wet shingle, black rock, wet black sand
+-- under the wrack, the salt-meadow margin behind the rim, and the sea-black of
+-- the drowned deep past every drop.
+local SEA: { [string]: { number } } = {
+	Grass = { 58, 63, 63 }, -- wet slate shingle; Roblox's blades take it
+	Ground = { 56, 58, 58 },
+	LeafyGrass = { 46, 51, 51 }, -- the salt-meadow margin under the rim walls
+	Mud = { 40, 42, 42 }, -- wet black sand under the wrack
+	Basalt = { 46, 50, 54 }, -- black rock
+	Slate = { 18, 20, 22 }, -- the drowned deep, and the abyss past the rim
+	Cobblestone = { 62, 65, 68 }, -- the village's wet paved way, pale enough to read
+}
+
+local function sea(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = SEA[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- The cliffs and outcrops are generated meshes painted, not textured: dark
+-- black rock, but not so dark their facets go (Moor's lesson).
+local ROCK = { 54, 57, 62 }
+
+local function painted(pieces: { OutdoorTypes.PieceLook }): { OutdoorTypes.PieceLook }
+	local out = table.clone(pieces)
+	for i, piece in pieces do
+		out[i] = with(piece, { color = ROCK })
+	end
+	return table.freeze(out)
+end
+
+-- Lamps and flames stay the game's saturated amber (bible B3): the one warmth
+-- on the coast, and always a pool someone lit.
+local WARM = { 255, 168, 88 }
+local LAMPPOST = Sculpts.brinewrack_lamppost
+local LANTERN_CAGE = 0.9
+local LANTERN: OutdoorTypes.PieceLook = {
+	name = "DriftwoodLamp",
+	size = LAMPPOST.size,
+	sculpt = "brinewrack_lamppost",
+	light = {
+		color = WARM,
+		range = 20,
+		brightness = 1.5,
+		-- Under the chain: the cage's middle hangs half its height below it.
+		height = (LAMPPOST.arm :: number) - (LAMPPOST.drop :: number) - LANTERN_CAGE * 1.3 / 2,
+		reach = LAMPPOST.reach,
+		cage = LANTERN_CAGE,
+		pulse = { style = "flicker", depth = 0.12, period = 1.3 },
+	},
+}
+
+local props: { [string]: OutdoorTypes.PropSet } = {}
+for name, set in Field.props do
+	-- The moor's HighMoor furniture has no place on a coast: the drowned
+	-- lighthouse is this tileset's one tower.
+	if name ~= "watchtower" and name ~= "stone_circles" then
+		props[name] = set
+	end
+end
+-- The heather becomes wrack: dark kelp clumps washed up the shingle, a few
+-- pale sea-green tips among them (the coast's accent, scattered by the tide).
+props.heather = with(props.heather, {
+	perHundredCells = 4,
+	pieces = { { name = "Wrack", size = Sculpts.brinewrack_wrack.size, sculpt = "brinewrack_wrack" } },
+})
+-- Lonelier than the field's road: long dark walks between the lamps.
+props.lanterns = with(props.lanterns, { pieces = { LANTERN }, spacing = 120 })
+-- A drowned village's waysides: its well and its cross, no hay out here.
+props.waysides = with(props.waysides, {
+	pieces = {
+		{ name = "Well", size = Sculpts.field_well.size, sculpt = "field_well" },
+		{ name = "WaysideCross", size = Sculpts.field_cross.size, sculpt = "field_cross" },
+	},
+	count = 3,
+})
+-- The boulders are painted meshes like the cliffs: the same black rock.
+props.boulders = with(props.boulders, { pieces = painted(props.boulders.pieces) })
+-- The wreck graveyard (the direction): hulls lie everywhere on the shingle
+-- like the ribs of dead beasts. A few big ones out on the open heath, well
+-- clear of the road and the fights, quiet so they never stand in a pack.
+local wrecks: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "WreckRibs", size = Sculpts.brinewrack_wreck_ribs.size, sculpt = "brinewrack_wreck_ribs" },
+		{
+			name = "WreckFrame",
+			size = Sculpts.brinewrack_wreck_arch.size,
+			sculpt = "brinewrack_wreck_arch",
+			weight = 0.6,
+		},
+	},
+	perHundredCells = 0,
+	count = 6,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 80,
+	clearance = 3,
+	quiet = true,
+	scale = { 0.75, 1.35 },
+	sink = 0.9,
+}
+props.wrecks = table.freeze(wrecks)
+-- Driftwood: low silvered heaps of it all along the shingle, the tide's own
+-- litter, turned grey-brown by salt.
+local driftwood: OutdoorTypes.PropSet = {
+	pieces = { { name = "Driftwood", size = Sculpts.brinewrack_driftwood.size, sculpt = "brinewrack_driftwood" } },
+	perHundredCells = 1.2,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 40,
+	scale = { 0.8, 1.4 },
+	sink = 0.4,
+}
+props.driftwood = table.freeze(driftwood)
+-- The landmark (B11): one dead lighthouse on its headland, far off, a pale
+-- tower over the dark shingle. A last lamp burns for nobody in its lantern
+-- room (B7), the one warm point on the whole coast, so the eye finds it from
+-- across the map.
+local lighthouse: OutdoorTypes.PropSet = {
+	pieces = {
+		{
+			name = "DrownedLighthouse",
+			size = Sculpts.brinewrack_lighthouse.size,
+			sculpt = "brinewrack_lighthouse",
+			light = {
+				color = { 255, 150, 78 },
+				range = 36,
+				brightness = 1.4,
+				height = 30,
+				cage = 2.8,
+				ember = 0.8,
+				pulse = { style = "breathe", depth = 0.18, period = 5 },
+			},
+		},
+	},
+	perHundredCells = 0,
+	count = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 200,
+	clearance = 6,
+	scale = { 1, 1.05 },
+	sink = 0.5,
+}
+props.lighthouse = table.freeze(lighthouse)
+
+local brinewrack = table.clone(Field) :: OutdoorTypes.OutdoorTileset
+brinewrack.name = "brinewrack"
+brinewrack.palette = "wet slate-grey shingle, black basalt rock, grey-brown driftwood, bleached wreck ribs, "
+	.. "pale sea-green tide-pools, desaturated, matte, no highlights"
+-- The moor's cold silver-blue night, not the field's warm one: a drowned coast
+-- under a faint moon.
+brinewrack.lighting = "mood"
+brinewrack.props = table.freeze(props)
+-- Sea fog: heavier than the field's, but wide and few, so the phone pays for
+-- few sheets (data/PerfBudget). A cold sea-green hint in it, the accent's
+-- light caught in the haze.
+brinewrack.groundMist = with(Field.groundMist, {
+	color = { 112, 128, 132 },
+	perHundredCells = 0.5,
+	spacing = 46,
+	size = 28,
+	transparency = 0.85,
+})
+
+-- The old paved road out of the drowned village, wet and pale enough to read
+-- as the way on from above.
+brinewrack.ground = with(Field.ground, {
+	heath = sea(Field.ground.heath),
+	ruin = sea(Field.ground.ruin),
+	road = sea(Field.ground.road),
+})
+
+-- The rim thickets become banks of wrecks: broken hull frames and ribcages
+-- leaning along every edge, the same bleached timber as the wrecks out on the
+-- shingle, so the coast's edge is a wall of dead ships seen from above.
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Field.edges :: any)
+edges["thicket"] = with(edges["thicket"], {
+	pieces = {
+		{ name = "WreckRibs", size = Sculpts.brinewrack_wreck_ribs.size, sculpt = "brinewrack_wreck_ribs" },
+		{
+			name = "WreckFrame",
+			size = Sculpts.brinewrack_wreck_arch.size,
+			sculpt = "brinewrack_wreck_arch",
+			weight = 0.7,
+		},
+		{ name = "Driftwood", size = Sculpts.brinewrack_driftwood.size, sculpt = "brinewrack_driftwood", weight = 0.8 },
+	},
+	spacing = 12,
+	scale = { 1, 1.5 },
+	sink = 1,
+})
+edges["cliff"] = with(edges["cliff"], { pieces = painted(edges["cliff"].pieces) })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = sea(edge.ground) })
+	end
+end
+brinewrack.edges = table.freeze(edges) :: any
+
+-- The rock islands inside the heath: the same black rock as the cliffs.
+local outcrop: OutdoorTypes.EdgeLook = with(Field.outcrop, { pieces = painted(Field.outcrop.pieces) })
+local outcropGround = Field.outcrop.ground
+if outcropGround then
+	outcrop = with(outcrop, { ground = sea(outcropGround) })
+end
+brinewrack.outcrop = outcrop
+
+-- Standing water in the hollows: pale tide-pools left by a tide that never
+-- went out, on the same wet black sand as the ruins.
+local pools = assert(Field.pools, "the field has pools")
+brinewrack.pools = with(pools, {
+	sheet = { name = "TidePool", size = Sculpts.brinewrack_tide_pool.size, sculpt = "brinewrack_tide_pool" },
+	bed = sea(pools.bed),
+})
+
+-- The bluffs' wall backing is the cliffs' black rock, not the moor's slate,
+-- so Slate keeps one colour: the sea-black of the abyss.
+local bluff = assert(Field.bluff, "the field has bluffs")
+brinewrack.bluff = with(bluff, {
+	backing = { material = "Basalt", color = SEA.Basalt },
+	rock = sea(assert(bluff.rock, "the field's bluff has rock")),
+})
+
+-- Past the rim: shingle banks rising a little, then open black sea under two
+-- sheets of fog. No hills, so the water runs to the horizon the way a coast's
+-- does; the abyss and its mist are what stop the map floating.
+brinewrack.beyond = with(Field.beyond, {
+	ground = sea(Field.beyond.ground),
+	rock = sea(Field.beyond.rock),
+	abyss = sea(Field.beyond.abyss),
+	abyssDepth = 110,
+	mist = { color = { 56, 68, 72 }, transparency = 0.42, depth = 26, layers = 2, spacing = 12 },
+})
+
+-- A drowned village's map ends: the way on is marked by the old stone gate, its
+-- marker stone wearing a rag of kelp-green (the accent), not the moor's
+-- oxblood.
+local thresholds = assert(Field.thresholds, "the field has thresholds")
+brinewrack.thresholds = with(thresholds, {
+	lamp = LANTERN,
+	marker = {
+		name = "TideMarker",
+		size = Sculpts.brinewrack_marker.size,
+		sculpt = "brinewrack_marker",
+		solid = true,
+	},
+})
+
+-- The ruins keep a few doors lit (B2: a light that means someone, or
+-- something, is there) - fewer than the field's, and only in the manor.
+local litWindows = assert(Field.litWindows, "the field has lit windows")
+brinewrack.litWindows = with(litWindows, { kinds = { "manor" }, count = 1, chance = 0.4 })
+brinewrack.wallLights = with(Field.wallLights, { chance = 0.35 })
+
+-- No town out here, and no timber homes: a drowned fishing village's stone.
+brinewrack.town = nil
+brinewrack.kits = nil
+
+-- The coast's landmarks (B11): the great wreck in place of the giants' bones,
+-- the drowned lighthouse on its headland in place of the fort, and the
+-- headland's own grass and rock repainted with the rest.
+local landmarks = assert(Field.landmarks, "the field has landmarks")
+local coastLandmarks = table.clone(landmarks) :: OutdoorTypes.LandmarkLook
+coastLandmarks.bones = {
+	name = "GreatWreck",
+	size = Sculpts.brinewrack_wreck_ribs.size,
+	sculpt = "brinewrack_wreck_ribs",
+}
+coastLandmarks.fort = {
+	name = "DrownedLighthouse",
+	size = Sculpts.brinewrack_lighthouse.size,
+	sculpt = "brinewrack_lighthouse",
+	solid = true,
+}
+coastLandmarks.rock = sea(landmarks.rock)
+coastLandmarks.headland = sea(landmarks.headland)
+-- The seam's lamps are the coast's own driftwood posts, not the moor's.
+coastLandmarks.seamLamp = LANTERN
+-- The Labyrinth's gate belongs to the Ashfields' road, not this shore.
+coastLandmarks.labyrinthGate = nil
+brinewrack.landmarks = table.freeze(coastLandmarks)
+
+return table.freeze(brinewrack)
