+})
+
+-- The cold itself, placed by the map: the breathing glow on every ice sheet,
+-- and snow drifting low across the road (systems/TilesetPieces). Few and far
+-- apart, one on screen at a time.
+local setPieces: { OutdoorTypes.TilesetPiece } = {
+	{ recipe = "rimeholt_underice", along = "pieces", on = "prop:ice", every = 24, count = 3, lift = 0.2 },
+	{ recipe = "rimeholt_drift", along = "road", every = 220, count = 2, lift = 0.6 },
+}
+
+local rimeholt: OutdoorTypes.OutdoorTileset = with(Moor, {
+	name = "rimeholt",
+	lighting = "mood",
+	palette = "blue-grey snow over dark frozen earth, black pines rimed pale, grey granite, "
+		.. "a pale ice-blue with a touch of green as the one accent, warm amber hill-fires, "
+		.. "desaturated, matte, no highlights",
+	ground = { heath = SNOW, road = ROAD, ruin = FROZEN_EARTH },
+	edges = table.freeze(edges),
+	outcrop = with(Moor.outcrop, {
+		pieces = rock(Moor.outcrop.pieces),
+		spacing = 5,
+		scale = { 0.5, 0.9 },
+		sink = 1.5,
+		ground = GRANITE,
+	}),
+	props = table.freeze(props),
+	ends = ends,
+	thresholds = thresholds,
