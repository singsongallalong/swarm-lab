diff --git a/src/shared/data/outdoorTilesets/Rimeholt.luau b/src/shared/data/outdoorTilesets/Rimeholt.luau
new file mode 100644
index 00000000..6e222deb
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Rimeholt.luau
@@ -0,0 +1,380 @@
+--!strict
+-- Rimeholt, the frozen highland (the frozen lake direction): a night highland
+-- of blue-grey snow under the moor's faint moon, dark frozen earth under the
+-- ruins, black pines rimed pale along the thicket edges and grey granite in
+-- the cliffs. A hill-folk's barrows and standing stones lie under the old
+-- snow beside tarns that never thaw: the pools are sheets of pale ice, and
+-- the rings of runestones stand on their shores. The one warmth is the last
+-- hill-fires' amber, in iron braziers along the road and at every threshold
+-- (B2-B3). Its accent (B8) is a pale ice-blue with a touch of green, like
+-- light inside old ice: the ice sheets, the runes cut into the stones, the
+-- fell grass's frosted tips and the rag on each marker, and the light that
+-- breathes under the ice (set piece `rimeholt_underice`). The landmarks are
+-- the ring of runestones on the lake's shore and the great barrow out past
+-- the way on (B11). The moor's layout dressed as a highland, a concept place.
+local LightingPresets = require("../LightingPresets")
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Ground by terrain material, as the moor paints its own: Terrain keeps one
+-- colour per material, so every look on a material moves together
+-- (OutdoorTilesets.spec). Every ground is repainted, and none of the moor's
+-- living earth is left.
+-- Snow is never white (the bible's value cap): blue-grey, a shade under the
+-- large-surface limit, so the black pines and granite stand on it.
+local SNOW: OutdoorTypes.GroundLook = { material = "Snow", color = { 78, 83, 89 } }
+-- The old road, dark setts kicking through the snow, so the way on reads as a
+-- dark line across the highland from the game camera.
+local ROAD: OutdoorTypes.GroundLook = { material = "Cobblestone", color = { 56, 60, 68 } }
+-- Under the ruins and the barrows: frozen earth, near-neutral and low.
+local FROZEN_EARTH: OutdoorTypes.GroundLook = { material = "Ground", color = { 44, 46, 52 } }
+-- The frozen muck under the pines and along the old walls.
+local FROST_MUD: OutdoorTypes.GroundLook = { material = "Mud", color = { 38, 38, 43 } }
+-- Grey granite: the cliffs, outcrops, terrace faces and the abyss's plateau.
+local GRANITE: OutdoorTypes.GroundLook = { material = "Basalt", color = { 50, 54, 62 } }
+-- The bed under the ice sheets, in the accent's cold key: dark, so the ice
+-- reads pale over it.
+local ICE_BED: OutdoorTypes.GroundLook = { material = "Ice", color = { 60, 72, 74 } }
+-- The land climbing away behind the rim: old ice, a shade darker than the
+-- walkable snow, so the map's ground still stands out against the hills.
+local GLACIER: OutdoorTypes.GroundLook = { material = "Glacier", color = { 64, 72, 78 } }
+local ABYSS: OutdoorTypes.GroundLook = { material = "Slate", color = { 18, 20, 22 } }
+
+-- The moor's cliff meshes take Basalt's pale texture, so they are painted the
+-- highland's cold grey (as the moor paints its own).
+local COLD_ROCK = { 60, 64, 72 }
+
+local function rock(pieces: { OutdoorTypes.PieceLook }): { OutdoorTypes.PieceLook }
+	local out = {}
+	for i, piece in pieces do
+		out[i] = if piece.mesh then with(piece, { color = COLD_ROCK }) else piece
+	end
+	return out
+end
+
+-- A hill-fire in an iron brazier: the last warm light on the highland, and
+-- the only warmth (B2-B3). Saturated on purpose, the flames' colour the set
+-- may not use (B8). No cage: the coals show as an ember under a small flame,
+-- and a flicker, because a fire breathes unevenly.
+local FIRE_LIGHT: OutdoorTypes.LightLook = {
+	color = { 255, 168, 88 },
+	range = 20,
+	brightness = 1.4,
+	height = 3.9,
+	ember = 0.9,
+	flame = 3,
+	pulse = { style = "flicker", depth = 0.2, period = 1.6 },
+}
+local FIRE: OutdoorTypes.PieceLook = {
+	name = "HillFire",
+	size = Sculpts.rimeholt_hillfire.size,
+	sculpt = "rimeholt_hillfire",
+	light = FIRE_LIGHT,
+}
+-- A banked fire inside a ruin, one a ruin at most and shadowed (data/PerfBudget
+-- affords only a few shadow lights): someone, or something, was here lately.
+local RUIN_FIRE: OutdoorTypes.PieceLook = {
+	name = "RuinFire",
+	size = Sculpts.rimeholt_hillfire.size,
+	sculpt = "rimeholt_hillfire",
+	light = {
+		color = { 255, 168, 88 },
+		range = 22,
+		brightness = 1.3,
+		height = 3.9,
+		ember = 0.8,
+		flame = 4,
+		shadows = true,
+		pulse = { style = "flicker", depth = 0.25, period = 1.8 },
+	},
+}
+
+-- The moor's edges and props by name: their own types make every key optional.
+local MOOR_EDGES: { [string]: OutdoorTypes.EdgeLook } = Moor.edges :: any
+local MOOR_PROPS: { [string]: OutdoorTypes.PropSet } = Moor.props :: any
+
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(MOOR_EDGES)
+-- The rim: the moor's basalt crags, a little taller and colder, their feet in
+-- snow. The highland's edge is a granite scarp, not a bank of turf.
+edges.cliff = with(MOOR_EDGES.cliff, {
+	pieces = rock(MOOR_EDGES.cliff.pieces),
+	spacing = 7,
+	scale = { 1.2, 1.7 },
+	sink = 4,
+	ground = GRANITE,
+})
+-- Where the moor had dead thickets, black pines rimed pale (the zone's
+-- silhouette from above): a sculpt tree, merged into one part a tree, so a
+-- whole rim's worth costs what a thicket costs.
+edges.thicket = with(MOOR_EDGES.thicket, {
+	pieces = {
+		{ name = "RimedPine", size = Sculpts.rimeholt_pine.size, sculpt = "rimeholt_pine" },
+		{
+			name = "RimedPineSnapped",
+			size = Sculpts.rimeholt_pine_snapped.size,
+			sculpt = "rimeholt_pine_snapped",
+			weight = 0.3,
+		},
+	},
+	spacing = 7,
+	scale = { 1.2, 1.8 },
+	sink = 0.6,
+	ground = FROST_MUD,
+})
+-- The old field walls stay: the hill-folk built them, and the snow has kept
+-- their lines. Their strip of trodden ground is the frozen muck.
+edges.ruin_wall = with(MOOR_EDGES.ruin_wall, { ground = FROST_MUD })
+
+local props: { [string]: OutdoorTypes.PropSet } = table.clone(MOOR_PROPS)
+-- Frost-bitten fell grass where the moor had heather: sparse clumps through
+-- the snow, one part each (merged), breaking up the flat white.
+props.heather = with(MOOR_PROPS.heather, {
+	pieces = { { name = "FellGrass", size = Sculpts.rimeholt_fell_grass.size, sculpt = "rimeholt_fell_grass" } },
+	perHundredCells = 3.5,
+	scale = { 0.9, 1.3 },
+	sink = 0.3,
+})
+-- Cold granite boulders, the moor's dark heaps gone grey-blue in the snow.
+props.boulders = with(MOOR_PROPS.boulders, {
+	pieces = {
+		{
+			name = "ColdBoulder",
+			size = Sculpts.rimeholt_boulder.size,
+			sculpt = "rimeholt_boulder",
+			solid = true,
+		},
+	},
+	perHundredCells = 1,
+	scale = { 0.7, 1.3 },
+	sink = 0.7,
+})
+-- The road's lamps are iron braziers: the last hill-fires, few and far apart,
+-- amber pools to walk between (B2: warm light is rare and means someone).
+props.lanterns = with(MOOR_PROPS.lanterns, {
+	pieces = { FIRE },
+	perHundredCells = 1.6,
+	spacing = 100,
+	faceRoad = false,
+	scale = { 0.9, 1.1 },
+	sink = 0.2,
+})
+-- A banked fire in a ruin, where someone sheltered from the cold.
+props.embers = with(MOOR_PROPS.embers, { pieces = { RUIN_FIRE }, perHundredCells = 1.5 })
+-- Fewer graves than the moor's: the highland buried its dead in barrows.
+props.headstones = with(MOOR_PROPS.headstones, { perHundredCells = 24 })
+props.candles = with(MOOR_PROPS.candles, { perHundredCells = 6 })
+-- The moor's High Moor landmarks belong to the moor: the highland steers by
+-- its own (the runestone rings and the barrows).
+local looseProps: any = props
+looseProps.watchtower = nil
+looseProps.stone_circles = nil
+looseProps.caves = nil
+
+-- The landmark the eye finds across the snow (B11): a ring of tall runestones
+-- on the lake's shore, a few of them still holding the accent's cold blue in
+-- their cut runes. Two a map, clear of the road and the walls.
+props.runestones = table.freeze({
+	pieces = {
+		{ name = "RunestoneRing", size = Sculpts.rimeholt_runestones.size, sculpt = "rimeholt_runestones" },
+	},
+	perHundredCells = 0,
+	count = 2,
+	spacing = 140,
+	clearance = 4,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	-- A little larger than the High Moor's stone circle, so the ring reads as
+	-- a landmark from the game camera and not as a ring of posts.
+	scale = { 1.1, 1.3 },
+	sink = 0.4,
+} :: OutdoorTypes.PropSet)
+-- The hill-folk's great barrow: a grey stone vault half sunk in the snow, its
+-- iron door shut. One a map, out on the open heath, well clear of the road.
+props.barrow = table.freeze({
+	pieces = {
+		{
+			name = "GreatBarrow",
+			size = Sculpts.rimeholt_barrow.size,
+			sculpt = "rimeholt_barrow",
+		},
+	},
+	perHundredCells = 0,
+	count = 1,
+	clearance = 6,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	-- Big: a mound a player sees across the heath, not a shed in the snow.
+	scale = { 1.6, 1.8 },
+	sink = 1,
+} :: OutdoorTypes.PropSet)
+-- The lake itself, in pieces: broad tarns of old ice lying in the heath, kept
+-- off the road, the walls and the sites. The set piece `rimeholt_underice` is
+-- placed on each (systems/TilesetPieces), so the cold light breathes under
+-- every one.
+props.ice = table.freeze({
+	pieces = { { name = "IceSheet", size = Sculpts.rimeholt_ice.size, sculpt = "rimeholt_ice" } },
+	perHundredCells = 0,
+	count = 3,
+	spacing = 110,
+	clearance = 3,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	-- Lake-sized: a tarn thirty-five to fifty studs across, so the ice reads
+	-- as water lying in the highland's hollows rather than a puddle.
+	scale = { 1.4, 2.2 },
+	sink = 0.1,
+} :: OutdoorTypes.PropSet)
+
+-- The frozen lake in the hollows: the pools system's sheet is old ice, its
+-- bed the dark water beneath, its crossing a line of flat stones (the ice is
+-- thinnest over the old ford, and the stones show where it will hold).
+local pools = {
+	sheet = { name = "LakeIce", size = Sculpts.rimeholt_ice.size, sculpt = "rimeholt_ice" },
+	bed = ICE_BED,
+	causeway = {
+		stones = {
+			{ name = "IceStep", size = { 2.4, 0.8, 3.4 }, material = "Slate", color = { 54, 60, 68 } },
+			{ name = "IceStep", size = { 3.0, 0.8, 2.6 }, material = "Slate", color = { 50, 56, 64 } },
+			{ name = "IceStep", size = { 2.0, 0.9, 2.8 }, material = "Slate", color = { 58, 62, 70 } },
+		},
+		step = 3,
+		sink = 0.35,
+	},
+}
+
+-- The map's two ends: the arrival's ring is the zone's runestones round a
+-- faint cold pool, its lamp a hill-fire; the way on opens under the moor's
+-- stone arch, its sheet a dim slate until the boss falls, then the ice's own
