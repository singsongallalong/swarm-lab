+-- A barrow vault at the back of the graveyard, its iron door facing the gate.
+local graveyard = {
+	run = "graveyard_railing",
+	gateWidth = 5,
+	inset = 1,
+	crypt = { name = "BarrowVault", size = Sculpts.rimeholt_barrow.size, sculpt = "rimeholt_barrow" },
+}
+
+-- Past every edge the highland climbs away in old ice, with snow hills round
+-- it so the map never shows as a slab over the abyss; and far past the way on
+-- the great barrow stands on its rock pad, on the skyline from the road every
+-- seed (B11).
+local beyond = with(Moor.beyond, {
