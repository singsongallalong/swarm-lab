+	-- moor's: the wind takes it (B9).
+	groundMist = with(Moor.groundMist, {
+		color = { 152, 162, 182 },
+		perHundredCells = 0.7,
+		spacing = 46,
+		transparency = 0.84,
+	}),
+	bluff = with(Moor.bluff :: any, { backing = GRANITE, rock = GRANITE }),
+	beyond = beyond,
+	setPieces = setPieces,
+})
+
+return rimeholt
