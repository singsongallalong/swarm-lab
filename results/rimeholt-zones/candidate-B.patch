diff --git a/src/shared/data/outdoorTilesets/Rimeholt.luau b/src/shared/data/outdoorTilesets/Rimeholt.luau
new file mode 100644
index 0000000..edc9a92
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Rimeholt.luau
@@ -0,0 +1,340 @@
+--!strict
+-- Rimeholt: a frozen highland at night, where the hill-kings' barrows and
+-- runestones lie under old snow beside water that never thaws. Field's
+-- dressing repainted cold: blue-grey snow over dark frozen earth, black pines
+-- along the rims, grey granite for the barrows and standing stones, one muted
+-- ice-blue accent and the last hill-fires' amber on the road. Its landmark is
+-- the runestone ring and the great barrow; its effect is snow drifting low
+-- across the field (data/SetPieces).
+local Field = require("./Field")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Frozen ground by terrain material, as Field2 paints its ash: Terrain keeps
+-- one colour per material, so every look on a material moves together. The
+-- heath is Snow, not Grass: Roblox grows blades only on Grass, and blades
+-- through snow read as a blue lawn (they also bury anything set on it). Snow
+-- is blue-grey, never white: values stay under the bible's 35% cap.
+local FROZEN: { [string]: { number } } = {
+	Grass = { 72, 79, 87 }, -- the old heath's material, kept for any look still on it
+	Snow = { 72, 79, 87 },
+	LeafyGrass = { 54, 60, 66 }, -- the rising land, darker than the walkable snow
+	Ground = { 60, 56, 54 }, -- dark frozen earth
+	Mud = { 46, 43, 42 }, -- the trodden floor of sites
+	Basalt = { 58, 62, 70 }, -- grey granite cliffs
+	Slate = { 72, 76, 82 },
+}
+
+local function frozen(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = FROZEN[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- A dark packed way through the snow, so the road reads from the game camera.
+local ROAD: OutdoorTypes.GroundLook = { material = "Cobblestone", color = { 66, 70, 76 } }
+-- Under the ice sheet: pale, so the lake glows faintly cold through it.
+local ICE_BED: OutdoorTypes.GroundLook = { material = "Ice", color = { 78, 92, 96 } }
+
+-- Black pines rimed pale: the moor's dead-tree meshes painted blue-black for
+-- the mass, a third of them rimed pale, and the frost-sculpt's thin branch
+-- mixed under them for the ragged skyline. The rims and the open snow share
+-- the list.
+local PINES: { OutdoorTypes.PieceLook } = {
+	{
+		name = "RimePineDark",
+		size = { 7, 8.5, 6.3 },
+		mesh = "rbxassetid://135311611772489",
+		material = "Wood",
+		color = { 30, 34, 38 },
+	},
+	{
+		name = "RimePineTallDark",
+		size = { 7, 10, 4.5 },
+		mesh = "rbxassetid://138056933645574",
+		material = "Wood",
+		color = { 30, 34, 38 },
+	},
+	{
+		name = "RimePineRimed",
+		size = { 7, 10, 4.5 },
+		mesh = "rbxassetid://138056933645574",
+		material = "Wood",
+		color = { 74, 80, 84 },
+		weight = 0.35,
+	},
+	{ name = "RimePineTwig", size = Sculpts.rimeholt_pine.size, sculpt = "rimeholt_pine", weight = 0.3 },
+	{
+		name = "RimePineSnapped",
+		size = Sculpts.rimeholt_pine_snapped.size,
+		sculpt = "rimeholt_pine_snapped",
+		weight = 0.2,
+	},
+}
+
+-- A warm hill-fire's lantern, as the moor's road lamp: the zone's only warmth
+-- against the cold (B2–B3), and the accent's opposite.
+local props = table.clone(Field.props)
+-- Dead sedge standing through the snow in place of living gorse.
+props.heather = with(props.heather, {
+	pieces = { { name = "Sedge", size = Sculpts.rimeholt_sedge.size, sculpt = "rimeholt_sedge" } },
+	perHundredCells = 3,
+})
+-- Pointed granite headstones, the hill-kings' slabs, among the barrows.
+props.headstones = with(props.headstones, {
+	pieces = { { name = "RimeHeadstone", size = Sculpts.rimeholt_headstone.size, sculpt = "rimeholt_headstone" } },
+})
+-- Sparse amber lamps along the road: a hill-folk's last fires.
+props.lanterns = with(props.lanterns, { spacing = 90 })
+-- A lone broken tower of grey granite to steer by, allowed in either reach.
+props.watchtower = with(props.watchtower, { reaches = { "HighMoor", "LowMoor" } })
+-- The runestone rings replace the moor's stone circles: taller, and a
+-- landmark from across the snow (B11).
+props.stone_circles = with(props.stone_circles, {
+	pieces = {
+		{ name = "RunestoneRing", size = Sculpts.rimeholt_runestone_ring.size, sculpt = "rimeholt_runestone_ring" },
+	},
+	-- On any open heath, not only the moor's HighMoor: the ring is this
+	-- zone's landmark (B11), and a map it can't stand on loses it.
+	reaches = nil,
+	count = 2,
+	clearance = 3,
+	spacing = 140,
+})
+-- No farms on the highland: the roadside keeps only the old cross and a
+-- shrine whose lamp is the warm stop between lantern pools.
+props.waysides = with(props.waysides, {
+	pieces = {
+		{ name = "RimeCross", size = Sculpts.rimeholt_cross.size, sculpt = "rimeholt_cross" },
+		{ name = "RimeShrine", size = Sculpts.rimeholt_shrine.size, sculpt = "rimeholt_shrine" },
+	},
+	count = 3,
+})
+local ROAD_LIGHT = assert(props.lanterns.pieces[1].light, "the road lamp has a light")
+local SHRINE_LAMP: OutdoorTypes.LightLook = {
+	color = ROAD_LIGHT.color,
+	range = 14,
+	brightness = 1.2,
+	height = 4.1,
+	cage = 0.5,
+	pulse = ROAD_LIGHT.pulse,
+}
+props.shrine = with(props.shrine, {
+	pieces = {
+		{ name = "RimeShrine", size = Sculpts.rimeholt_shrine.size, sculpt = "rimeholt_shrine", light = SHRINE_LAMP },
+	},
+	count = 1,
+	least = 1,
+})
+
+-- The barrow field: low mounds of grey granite and frozen turf across the
+-- open snow, off the road and the fights. Their own lamps are none; the cold
+-- glow comes from a set piece (tileset setPieces).
+local barrows: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "Barrow", size = Sculpts.rimeholt_barrow.size, sculpt = "rimeholt_barrow" },
+		{
+			name = "BarrowLow",
+			size = Sculpts.rimeholt_barrow_low.size,
