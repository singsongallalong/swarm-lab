diff --git a/src/shared/data/outdoorTilesets/Rimeholt.luau b/src/shared/data/outdoorTilesets/Rimeholt.luau
new file mode 100644
index 0000000..b0babb4
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Rimeholt.luau
@@ -0,0 +1,290 @@
+--!strict
+-- Rimeholt: a frozen highland under old snow, its rimed pine wood standing
+-- over the barrows and runestones of a hill-folk, beside a lake that never
+-- thaws. Derived from the moor the way the Ashfields derive from the field:
+-- the moor's pieces, edges and layout, repainted by terrain material and
+-- re-dressed, so it costs what the moor costs and works over any generated
+-- layout. Palette: blue-grey old snow (never white: the bible caps value),
+-- dark frozen earth, near-black pines rimed pale grey, grey granite, and one
+-- muted accent (B8), pale ice-blue with a touch of green, the colour of light
+-- inside old ice. The only warmth is the amber of the last hill-fires, at the
+-- road's lanterns and the braziers in the ruins (B2-B3).
+local LightingPresets = require("../LightingPresets")
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Ground by terrain material, as the moor paints its living ground: Terrain
+-- keeps one colour per material, so every look on a material moves together
+-- (OutdoorTilesets.spec). Snow is blue-grey and the earth under it dark and
+-- frozen; nothing here is white, and every colour stays under the bible's
+-- large-surface caps.
+local RIME: { [string]: { number } } = {
+	Grass = { 72, 79, 88 }, -- old snow, the heath under the pines
+	Ground = { 56, 51, 46 }, -- the trodden road, frozen dark
+	LeafyGrass = { 56, 61, 70 }, -- drifted margins out past the rims
+	Mud = { 44, 42, 40 }, -- frozen earth under the wood and in the ruins
+	Basalt = { 54, 57, 64 }, -- grey granite
+	Slate = { 18, 20, 24 }, -- the abyss under the mist
+}
+
+local function rimed(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = RIME[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- The accent lit (a portal sheet and a light, which may burn brighter than a
+-- surface): the pale ice-blue with a touch of green that the sculpts' rags and
+-- the set pieces carry.
+local ICE_LIGHT = { 150, 196, 200 }
+
+local props = table.clone(Moor.props)
+-- Where the moor grows heather, the wood's frozen undergrowth: low dark
+-- clumps rimed pale at the tips, dark enough to speckle the snow from the high
+-- camera rather than vanish into it.
+props.heather = with(props.heather, {
+	pieces = { { name = "FrostScrub", size = Sculpts.rimeholt_frostscrub.size, sculpt = "rimeholt_frostscrub" } },
+	perHundredCells = 4,
+})
+-- The wood itself: black pines rimed pale, scattered over the open snow
+-- between the thickets along the rims, so the high camera reads a wood and not
+-- a lawn. Soft dressing, so a player walks through them (only stone is solid).
+local PINE_PIECES: { OutdoorTypes.PieceLook } = {
+	{ name = "RimePine", size = Sculpts.rimeholt_pine.size, sculpt = "rimeholt_pine" },
+	{ name = "RimePineBent", size = Sculpts.rimeholt_pine_bent.size, sculpt = "rimeholt_pine_bent", weight = 0.6 },
+	{
+		name = "RimePineSnapped",
+		size = Sculpts.rimeholt_pine_snapped.size,
+		sculpt = "rimeholt_pine_snapped",
+		weight = 0.25,
+	},
+}
+local pines: OutdoorTypes.PropSet = {
+	pieces = PINE_PIECES,
+	perHundredCells = 2.2,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	-- A wood's trunks keep their distance, so the pines spread over the map
+	-- instead of clumping where the dice fell.
+	spacing = 20,
+	scale = { 1.1, 1.7 },
+	sink = 0.4,
+}
+props.pines = table.freeze(pines)
+-- The hill-folk's barrows (B11): long mounds of frozen earth patched with
+-- snow out on the open heath, and one or two stone doors standing half sunk.
+-- Quiet, so none stands in a fight or across the road.
+local barrows: OutdoorTypes.PropSet = {
+	pieces = { { name = "Barrow", size = Sculpts.rimeholt_barrow.size, sculpt = "rimeholt_barrow" } },
+	perHundredCells = 0,
+	count = 4,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 90,
+	clearance = 3,
+	quiet = true,
+	scale = { 0.9, 1.2 },
+	sink = 0.6,
+}
+props.barrows = table.freeze(barrows)
+local barrowDoors: OutdoorTypes.PropSet = {
+	pieces = { { name = "BarrowDoor", size = Sculpts.rimeholt_barrow_door.size, sculpt = "rimeholt_barrow_door" } },
+	perHundredCells = 0,
+	count = 2,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 120,
+	clearance = 3,
+	quiet = true,
+	scale = { 0.9, 1.1 },
+	sink = 0.4,
+}
+props.barrowDoors = table.freeze(barrowDoors)
+-- The ring of runestones in its glade: the landmark a player crosses the wood
+-- to reach (B11). A pair at most, far apart, each clear of the road.
+local runestones: OutdoorTypes.PropSet = {
+	pieces = { { name = "Runestones", size = Sculpts.rimeholt_runestones.size, sculpt = "rimeholt_runestones" } },
+	perHundredCells = 0,
+	count = 2,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 150,
+	clearance = 5,
+	quiet = true,
+	scale = { 0.9, 1.1 },
+	sink = 0.5,
+}
+-- The moor's own landmark set, re-dressed: the group stays `prop:stone_circles`
+-- so the same dressing finds it (dresspreview's landmark views included).
+props.stone_circles = table.freeze(runestones)
+-- The hill-fort's broken tower on the skyline: one a map, standing on the open
+-- snow well clear of the road, so it pulls a player across the wood from the
+-- arrival (B11).
+local fortTower: OutdoorTypes.PropSet = {
+	pieces = { { name = "FortTower", size = Sculpts.rimeholt_fort_tower.size, sculpt = "rimeholt_fort_tower" } },
+	perHundredCells = 0,
+	count = 1,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	clearance = 6,
+	quiet = true,
+	scale = { 1, 1.05 },
+	sink = 0.8,
+}
+-- The moor's watchtower set, re-dressed: the group stays `prop:watchtower`, so
+-- the same dressing and previews find it.
+props.watchtower = table.freeze(fortTower)
+-- Lone rune-stones down the ways, each with an ice-blue rag, so the ring isn't
+-- the only sign of the hill-folk a player passes.
+local standingStones: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "StandingStone", size = Sculpts.rimeholt_standing_stone.size, sculpt = "rimeholt_standing_stone" },
+	},
+	perHundredCells = 0,
+	count = 5,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 70,
+	clearance = 1,
+	quiet = true,
+	scale = { 0.8, 1.1 },
+	sink = 0.4,
+}
+props.standingStones = table.freeze(standingStones)
+-- Grey granite boulders with a rime of snow, in place of the moor's basalt.
+props.boulders = with(props.boulders, {
+	pieces = {
+		{ name = "RimeBoulder", size = Sculpts.rimeholt_boulder.size, sculpt = "rimeholt_boulder", solid = true },
+	},
+	perHundredCells = 1,
+})
+-- The last hill-fires: fewer road lanterns than the moor, a long walk apart.
+props.lanterns = with(props.lanterns, { spacing = 90 })
+-- The ruins' braziers keep their amber, a shade fewer than the moor's.
+props.embers = with(props.embers, { perHundredCells = 1.5 })
+
+local rimeholt = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+rimeholt.name = "rimeholt"
+rimeholt.palette = "blue-grey old snow, dark frozen earth, near-black pines rimed pale grey, "
+	.. "grey granite, pale ice-blue with a touch of green as the only accent, desaturated, matte, no highlights"
+rimeholt.lighting = "mood"
+rimeholt.props = table.freeze(props)
+
+-- Old snow on the heath, frozen earth on the road and the ruin floors: the
+-- moor's own ground shapes, every colour repainted.
+rimeholt.ground = with(Moor.ground, {
+	heath = rimed(Moor.ground.heath),
+	road = { material = "Ground", color = RIME.Ground },
+	ruin = rimed(Moor.ground.ruin),
+})
+
+-- The thickets are the pine wood's wall: black pines along every rim, their
+-- crowns run together, so the wood closes the map at its edges.
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+edges["thicket"] = with(edges["thicket"], {
+	pieces = PINE_PIECES,
+	spacing = 5,
+	scale = { 1.8, 2.8 },
+	sink = 0.6,
+})
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = rimed(edge.ground) })
+	end
+end
+rimeholt.edges = table.freeze(edges) :: any
+if Moor.outcrop.ground then
+	rimeholt.outcrop = with(Moor.outcrop, { ground = rimed(Moor.outcrop.ground) })
+end
+local bluffRock = Moor.bluff and Moor.bluff.rock
+if bluffRock then
+	rimeholt.bluff = with(Moor.bluff :: any, {
+		rock = rimed(bluffRock),
+		-- The wall's rubble core between stones: grey granite, not the moor's
+		-- warmer slate.
+		backing = { material = "Slate", color = { 60, 62, 68 } },
+	})
+end
+-- The lake that never thaws: a pale, faintly green ice sheet over the moor's
+-- hollows, on the same frozen earth as the ruin floors, its causeway of
+-- stepping stones kept.
+if Moor.pools then
+	rimeholt.pools = with(Moor.pools, {
+		sheet = { name = "IceSheet", size = Sculpts.rimeholt_ice.size, sculpt = "rimeholt_ice" },
+		bed = rimed(Moor.pools.bed),
+	})
+end
+
+-- The map's arrival is the ring of runestones round a cold pool; the way on
+-- opens under the moor's arch, its sheet a dim slate until the boss falls and
+-- then the pale ice-blue of the accent lit.
+local moorEnds = assert(Moor.ends, "the moor has ends")
+rimeholt.ends = with(moorEnds, {
+	arrival = with(moorEnds.arrival, {
+		ring = { name = "Runestones", size = Sculpts.rimeholt_runestones.size, sculpt = "rimeholt_runestones" },
+		-- Dark and see-through, as the moor's is: Neon brightens its colour, and
+		-- a paler one reads as a white disc from the game camera (C32).
+		pool = { radius = 4, color = { 40, 62, 78 }, transparency = 0.6 },
+	}),
+	exit = with(moorEnds.exit, {
+		sheet = with(moorEnds.exit.sheet, {
+			dim = { 44, 52, 60 },
+			lit = ICE_LIGHT,
+			light = { color = { 130, 176, 190 }, range = 24, brightness = 2 },
+		}),
+	}),
+})
+-- A rune-stone with an ice-blue rag at each cleft's mouth, in place of the
+-- moor's oxblood marker: a way on reads the same as it does on the moor.
+local moorThresholds = assert(Moor.thresholds, "the moor has thresholds")
+rimeholt.thresholds = with(moorThresholds, {
+	marker = {
+		name = "ThresholdStone",
+		size = Sculpts.rimeholt_standing_stone.size,
+		sculpt = "rimeholt_standing_stone",
+		solid = true,
+	},
+})
+
+-- Land climbing away behind the pines and hills running on past every edge,
+-- so the map never shows as a slab over the abyss; the mist takes the mood
+-- preset's haze colour, so it melts into the distance.
+rimeholt.beyond = with(Moor.beyond, {
+	ground = rimed(Moor.beyond.ground),
+	rock = rimed(Moor.beyond.rock),
+	mist = with(Moor.beyond.mist, { color = (LightingPresets.mood.atmosphere :: any).color }),
+	hills = table.freeze({ reach = 70, chunk = 10, height = table.freeze({ 12, 26 }), lane = 4, laneReach = 12 }),
+})
+-- Low mist at ankle height (B9), blue-grey and a little colder than the moor's.
+rimeholt.groundMist = with(Moor.groundMist, {
+	color = { 138, 150, 166 },
+	perHundredCells = 0.7,
+	spacing = 44,
+	size = 26,
+	transparency = 0.84,
+})
+-- Pale ice motes drifting over the snow: the accent in the air, sparse enough
+-- for the phone's emitter budget (data/PerfBudget).
+rimeholt.mana = table.freeze({
+	color = { 140, 184, 190 },
+	perHundredCells = 0.06,
+	spacing = 80,
+	height = 2.5,
+	size = 0.6,
+	speed = 2.5,
+	rate = 3,
+})
+
+-- The zone's signature cold, placed by the map's own build (systems/
+-- TilesetPieces): a thin ice-blue mist threading between the pines and along
+-- the pine wall, and a cold glow rising off every runestone ring.
+local setPieces: { OutdoorTypes.TilesetPiece } = {
+	{ recipe = "rimeholt_coldmist", along = "pieces", on = "prop:pines", every = 55, count = 8, lift = 1.5 },
+	{ recipe = "rimeholt_coldmist", along = "pieces", on = "edge:thicket", every = 80, count = 4, lift = 2 },
+	{ recipe = "rimeholt_runeglow", along = "pieces", on = "prop:stone_circles", every = 45, count = 2, lift = 1 },
+}
+rimeholt.setPieces = table.freeze(setPieces)
+
+return table.freeze(rimeholt)
