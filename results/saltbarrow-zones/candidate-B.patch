diff --git a/src/shared/data/outdoorTilesets/Saltbarrow.luau b/src/shared/data/outdoorTilesets/Saltbarrow.luau
new file mode 100644
index 0000000..0768919
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Saltbarrow.luau
@@ -0,0 +1,265 @@
+--!strict
+-- Saltbarrow: the bed of a dead inland sea. Something enormous died here and
+-- the kings of a vanished people were buried in its bones, so the look is a
+-- pale salt pan, grey-beige dust and cracked mud under a colossal ribcage,
+-- with dark basalt crags standing out of it and one dusty ochre accent (B8)
+-- on the threshold stones and in the tombs' glow. Derived from Field the way
+-- Field2 is: the field's pieces and rules, repainted. Field's living green
+-- and warm earth are its own alone, so every ground here is salt; the old
+-- paved road runs on, cracked and darker than the pan so it reads from the
+-- game camera. The landmark is the colossus in its hollow (B11), with tombs
+-- set among its ribs, and the wind's low dust is the area's set piece.
+local Field = require("./Field")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Salt ground by terrain material, as Field paints its living ground: Terrain
+-- keeps one colour per material, so every look on a material moves together.
+-- The pan sits at the top of the bible's value range: it is the brightest
+-- large surface in the game, and still a moonlit grey, never white.
+local SALT: { [string]: { number } } = {
+	Grass = { 88, 85, 78 }, -- the salt crust, which Roblox's grass blades take
+	Ground = { 78, 73, 63 }, -- wind-drifted dust
+	LeafyGrass = { 70, 66, 58 }, -- the banks climbing away past the rim
+	Mud = { 66, 61, 53 }, -- cracked dry mud under the ruins and along the rim
+	Basalt = { 54, 55, 60 }, -- the skirt of the dark outcrops
+}
+
+local function salted(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = SALT[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- Dark basalt: the outcrops, rim crags and boulders that stand out of the
+-- pale flats, colder and darker than the moor's own rock.
+local BASALT_ROCK = { 54, 55, 60 }
+-- The dead shore's trees, bleached white as bone: the same paint as the
+-- snapped sculpt, so meshes and sculpts stay one colour (the moor's rule).
+local BLEACHED = Sculpts.saltbarrow_dead_tree.colors[1]
+
+local function repainted(pieces: { OutdoorTypes.PieceLook }, color: { number }): { OutdoorTypes.PieceLook }
+	local out = table.clone(pieces)
+	for i, piece in out do
+		out[i] = with(piece, { color = color })
+	end
+	return table.freeze(out)
+end
+
+local props = table.clone(Field.props)
+-- Salt scrub: a few bleached clumps on a flat that is empty by design, so
+-- fewer than the field's gorse. Still above the 2–3 stud grass blades.
+props.heather = with(props.heather, {
+	perHundredCells = 2,
+	pieces = { { name = "SaltScrub", size = Sculpts.saltbarrow_scrub.size, sculpt = "saltbarrow_scrub" } },
+})
+-- A lonelier road than the field's: farther between the lantern pools.
+props.lanterns = with(props.lanterns, { spacing = 120 })
+-- The waysides of a dead land: the well a caravan watered at, and the cross
+-- that marked the way. No haystack out here.
+props.waysides = with(props.waysides, {
+	pieces = {
+		{ name = "Well", size = Sculpts.field_well.size, sculpt = "field_well" },
+		{ name = "WaysideCross", size = Sculpts.field_cross.size, sculpt = "field_cross" },
+	},
+	count = 3,
+})
+-- The graves of the kings' people, in bleached stone.
+props.headstones = with(props.headstones, {
+	perHundredCells = 26,
+	pieces = {
+		{ name = "Gravestone", size = Sculpts.saltbarrow_gravestone.size, sculpt = "saltbarrow_gravestone" },
+		{
+			name = "GravestoneBroken",
+			size = Sculpts.saltbarrow_gravestone_broken.size,
+			sculpt = "saltbarrow_gravestone_broken",
+			weight = 0.6,
+		},
+	},
+})
+-- The moor's boulder mesh in dark basalt, with a basalt column among them now
+-- and then: the outcrops the flats break on. Both are stone you can see, so
+-- both are solid (the spec's own rule).
+local boulders = table.clone(props.boulders)
+local boulderPieces = table.clone(boulders.pieces)
+for i, piece in boulderPieces do
+	boulderPieces[i] = with(piece, { color = BASALT_ROCK })
+end
+table.insert(boulderPieces, {
+	name = "BasaltColumn",
+	size = Sculpts.saltbarrow_column.size,
+	sculpt = "saltbarrow_column",
+	solid = true,
+	weight = 0.7,
+})
+boulders.pieces = table.freeze(boulderPieces)
+props.boulders = table.freeze(boulders)
+
+-- The landmark (B11): one colossal ribcage half sunk in the salt, its ribs
+-- three times a man's height, to pull players across the flats from the high
+-- camera. Quiet, so it never stands on the road or in a pack's ground.
+local colossus: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "Colossus", size = Sculpts.saltbarrow_colossus.size, sculpt = "saltbarrow_colossus" },
+	},
+	perHundredCells = 0,
+	count = 1,
+	spacing = 220,
+	clearance = 6,
+	quiet = true,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 1, 1.1 },
+	sink = 2,
+}
+props.colossus = table.freeze(colossus)
+-- Ribs half buried out on the open pan, so the flat itself is bone strewn.
+local ribs: OutdoorTypes.PropSet = {
+	pieces = { { name = "Ribs", size = Sculpts.saltbarrow_ribs.size, sculpt = "saltbarrow_ribs" } },
+	perHundredCells = 0,
+	count = 3,
+	spacing = 130,
+	clearance = 3,
+	quiet = true,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.9, 1.3 },
+	sink = 1.2,
+}
+props.ribs = table.freeze(ribs)
+-- The kings' tombs, cut into the bone: a few vaults out on the heath.
+local tombs: OutdoorTypes.PropSet = {
+	pieces = { { name = "Tomb", size = Sculpts.saltbarrow_tomb.size, sculpt = "saltbarrow_tomb" } },
+	perHundredCells = 0,
+	count = 2,
+	spacing = 140,
+	clearance = 4,
+	quiet = true,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.9, 1.1 },
+	sink = 0.6,
+}
+props.tombs = table.freeze(tombs)
+
+local saltbarrow = table.clone(Field) :: OutdoorTypes.OutdoorTileset
+saltbarrow.name = "saltbarrow"
+saltbarrow.palette = "pale salt crust, grey-beige dust, cracked dry mud, sun-bleached bone, "
+	.. "dark basalt, one dusty ochre accent, desaturated, matte, no highlights"
+saltbarrow.lighting = "mood"
+saltbarrow.props = table.freeze(props)
+
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Field.edges :: any)
+edges["cliff"] = with(edges["cliff"], { pieces = repainted(edges["cliff"].pieces, BASALT_ROCK) })
+-- The dead shore (the thicket's edge): the trees that grew here died when
+-- the sea did, and bleached white as bone. Meshes stay meshes, a part apiece,
+-- so the rim costs what the moor's did.
+local trees = table.clone(edges["thicket"].pieces)
+for i, piece in trees do
+	if piece.sculpt then
+		trees[i] = with(piece, {
+			sculpt = "saltbarrow_dead_tree",
+			name = "SaltDeadTree",
+			size = Sculpts.saltbarrow_dead_tree.size,
+			weight = 0.4,
+		})
+	else
+		trees[i] = with(piece, { color = BLEACHED })
+	end
+end
+edges["thicket"] = with(edges["thicket"], { pieces = trees, spacing = 8, scale = { 2.4, 3.6 } })
+-- The old dry-stone walls of the vanished people, not the town's curtain wall.
+edges["ruin_wall"] = with(edges["ruin_wall"], { run = "moor_field_wall" })
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = salted(edge.ground) })
+	end
+end
+saltbarrow.edges = table.freeze(edges) :: any
+
+-- The salt pan, the trodden mud of the ruins, and the old paved road cracked
+-- and dust-filled: darker than the pan, or it vanished into it from above.
+saltbarrow.ground = with(Field.ground, {
+	heath = salted(Field.ground.heath),
+	ruin = salted(Field.ground.ruin),
+	road = { material = "Cobblestone", color = { 74, 70, 62 } },
+})
+if Field.outcrop.ground then
+	saltbarrow.outcrop = with(Field.outcrop, {
+		ground = salted(Field.outcrop.ground),
+		pieces = repainted(Field.outcrop.pieces, BASALT_ROCK),
+	})
+end
+local bluffRock = Field.bluff and Field.bluff.rock
+if bluffRock then
+	saltbarrow.bluff = with(Field.bluff, {
+		rock = salted(bluffRock),
+		-- The rubble core between the stones, the rock face's own dark.
+		backing = { material = "Slate", color = { 56, 56, 60 } },
+	})
+end
+if Field.pools then
+	-- Brine in the hollows: the sheet stays near-black, its bed is dry mud.
+	saltbarrow.pools = with(Field.pools, { bed = salted(Field.pools.bed) })
+end
+-- Closed all round: pale banks climb away behind the rim, hills run on past
+-- the map's own into the haze, and the abyss under it keeps its mist.
+saltbarrow.beyond = with(Field.beyond, {
+	ground = salted(Field.beyond.ground),
+	rock = salted(Field.beyond.rock),
+	hills = table.freeze({ reach = 70, chunk = 10, height = table.freeze({ 12, 26 }), lane = 4, laneReach = 12 }),
+	mist = with(Field.beyond.mist, { color = { 100, 104, 118 } }),
+})
+-- Low mist over the pan: pale, broad and thin, so the flats read as a sea of
+-- mist and the bone rises out of it.
+saltbarrow.groundMist = with(Field.groundMist, {
+	color = { 158, 162, 174 },
+	perHundredCells = 0.4,
+	spacing = 48,
+	size = 30,
+	transparency = 0.87,
+})
+
+-- No town out on the salt; the manor's ruin still keeps a lit window.
+saltbarrow.town = nil
+saltbarrow.kits = nil
+saltbarrow.litWindows = with(Field.litWindows :: any, { kinds = { "manor" }, count = 1, chance = 0.4 })
+saltbarrow.wallLights = with(Field.wallLights, { chance = 0.35 })
