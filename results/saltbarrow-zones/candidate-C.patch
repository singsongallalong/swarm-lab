diff --git a/src/shared/data/outdoorTilesets/Saltbarrow.luau b/src/shared/data/outdoorTilesets/Saltbarrow.luau
new file mode 100644
index 0000000..51f327e
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Saltbarrow.luau
@@ -0,0 +1,358 @@
+--!strict
+-- Saltbarrow, the bed of a dead inland sea (the swarm's brief): a salt desert
+-- at night under the mood preset, its ground pale salt crust and grey-beige
+-- dust, cracked dry mud where the water went, dark basalt rims and outcrops,
+-- and the vanished kings' tomb road running across it. Derived from the moor
+-- the way Field2 derives from Field: clone, then repaint and restyle. Its one
+-- muted accent (bible B8) is a dusty ochre, on the tombs' doors, the threshold
+-- rag and the tomb-light: quite unlike the Ashfields' violet or the Moonwell's
+-- teal. Pale bone and dark basalt carry the mass; the salt pan is the colour.
+local Field = require("./Field")
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Ground by terrain material, as Field2 repaints the Ashfields: Terrain keeps
+-- one colour per material, so every look on a material moves together. Pale
+-- and near-neutral, inside the bible's large-surface caps (B8).
+local SALT: { [string]: { number } } = {
+	Grass = { 89, 87, 82 }, -- salt crust where blades grow, a hair paler
+	Ground = { 89, 87, 82 }, -- the open pan: pale grey-beige salt crust
+	LeafyGrass = { 64, 62, 57 }, -- the darker dust climbing away under the cliffs
+	Mud = { 66, 61, 54 }, -- cracked dry mud of the sea bed and the ruin floors
+	Basalt = { 52, 54, 60 }, -- the dark outcrops and rims
+}
+
+local function salted(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = SALT[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- Dark basalt, painted near the top of the bible's value range so its facets
+-- still read (the moor's lesson, C49): the rim cliffs and the boulders.
+local BASALT_ROCK = { 58, 60, 66 }
+-- Lamp flames: saturated on purpose, the only warm light (B2–B3).
+local FLAME = { 255, 168, 88 }
+local LANTERN_FLICKER: OutdoorTypes.Pulse = { style = "flicker", depth = 0.12, period = 1.3 }
+
+-- The tomb road's lamps: sparse, so the salt between them stays dark (B2:
+-- warm light is rare and always means something). The light hangs under the
+-- post's chain, as the moor's road lanterns do.
+local LAMPPOST = Sculpts.saltbarrow_lantern_post
+local LANTERN_CAGE = 0.9
+local TOMB_LAMP: OutdoorTypes.PieceLook = {
+	name = "TombLamp",
+	size = LAMPPOST.size,
+	sculpt = "saltbarrow_lantern_post",
+	light = {
+		color = FLAME,
+		range = 20,
+		brightness = 1.5,
+		height = (LAMPPOST.arm :: number) - (LAMPPOST.drop :: number) - LANTERN_CAGE * 1.3 / 2,
+		reach = LAMPPOST.reach,
+		cage = LANTERN_CAGE,
+		pulse = LANTERN_FLICKER,
+	},
+}
+-- The arrival's lamp is dimmer: a party lands a few studs from it (C38).
+local ARRIVAL_LAMP: OutdoorTypes.PieceLook = with(TOMB_LAMP, {
+	light = with(TOMB_LAMP.light :: OutdoorTypes.LightLook, { brightness = 0.8 }),
+})
+
+local props = table.clone(Moor.props)
+-- Sparse, dry scrub in place of the heather: pale brittle tufts, the last
+-- colour a dull ochre seed head, the one warm note out on the flats.
+props.heather = with(props.heather, {
+	pieces = { { name = "SaltTuft", size = Sculpts.saltbarrow_salt_tuft.size, sculpt = "saltbarrow_salt_tuft" } },
+	perHundredCells = 3,
+})
+-- The lesser graves along the road: leaning salt-stone slabs, some broken.
+props.headstones = with(props.headstones, {
+	pieces = {
+		{ name = "SaltGrave", size = Sculpts.saltbarrow_grave.size, sculpt = "saltbarrow_grave" },
+		{ name = "SaltGraveSlab", size = Sculpts.saltbarrow_grave_slab.size, sculpt = "saltbarrow_grave_slab" },
+	},
+	perHundredCells = 26,
+})
+-- Amber grave lanterns on pale stone stakes: someone still tends the dead.
+local graveLantern = with(Moor.props.candles.pieces[1], { material = "Slate", color = { 90, 88, 82 } })
+props.candles = with(props.candles, { pieces = { graveLantern }, perHundredCells = 6 })
+-- The tomb road's lamps, farther apart than the field's: a long dark walk
+-- with a pool of amber light ahead.
+props.lanterns = with(props.lanterns, { pieces = { TOMB_LAMP }, perHundredCells = 2, spacing = 85 })
+-- A brazier in a ruin, its stone bleached pale.
+local brazier = with(Moor.props.embers.pieces[1], { color = { 92, 90, 84 } })
+props.embers = with(props.embers, { pieces = { brazier } })
+-- Dark basalt boulders: the same mesh, painted the rim's colour.
+local boulders = table.clone(props.boulders.pieces)
+for i, piece in boulders do
+	boulders[i] = with(piece, { color = BASALT_ROCK })
+end
+props.boulders = with(props.boulders, { pieces = boulders })
+-- The kings' broken tower and their ring of standing stones out on the
+-- flats: the moor's High Moor landmarks, restyled for every seed.
+props.watchtower = table.freeze({
+	pieces = { { name = "KingsTower", size = Sculpts.saltbarrow_watchtower.size, sculpt = "saltbarrow_watchtower" } },
+	perHundredCells = 0,
+	count = 1,
+	clearance = 4,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 0.95, 1.05 },
+	sink = 0.5,
+})
+props.stone_circles = table.freeze({
+	pieces = { { name = "KingsRing", size = Sculpts.saltbarrow_waystones.size, sculpt = "saltbarrow_waystones" } },
+	perHundredCells = 0,
+	count = 2,
+	spacing = 120,
+	clearance = 4,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	scale = { 1.3, 1.7 },
+	sink = 0.4,
+})
+-- A tomb mouth barred shut at the foot of a rim cliff (A012 step 6): the
+-- kings' way in, kept shut for later.
+props.caves = table.freeze({
+	pieces = { { name = "TombMouth", size = Sculpts.saltbarrow_tomb_mouth.size, sculpt = "saltbarrow_tomb_mouth" } },
+	perHundredCells = 0,
+	count = 1,
+	on = { "cliffside" :: OutdoorTypes.PropGround },
+	backToCliff = true,
+	scale = { 1, 1.15 },
+	sink = 0.3,
+})
+-- The tomb road's colonnade: broken pillars set back beside the way, quiet so
+-- none stands where a pack waits or in the road itself.
+local columns: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "BrokenColumn", size = Sculpts.saltbarrow_broken_column.size, sculpt = "saltbarrow_broken_column" },
+	},
+	perHundredCells = 0,
+	count = 12,
+	on = { "roadside" :: OutdoorTypes.PropGround },
+	spacing = 36,
+	quiet = true,
+	scale = { 0.9, 1.5 },
+	sink = 0.35,
+}
+props.columns = table.freeze(columns)
+-- Lesser tombs out on the open flats, between the graves and the road.
+local tombs: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "LesserTomb", size = Sculpts.saltbarrow_tomb.size, sculpt = "saltbarrow_tomb" },
+	},
+	perHundredCells = 0,
+	count = 3,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 150,
+	clearance = 4,
+	quiet = true,
+	scale = { 0.8, 1.1 },
+	sink = 0.4,
+}
+props.tombs = table.freeze(tombs)
+-- What the sea left: ribcages bleached white, half sunk in the salt.
+local bones: OutdoorTypes.PropSet = {
+	pieces = { { name = "SaltBones", size = Sculpts.saltbarrow_bones.size, sculpt = "saltbarrow_bones" } },
+	perHundredCells = 0,
+	count = 3,
+	on = { "heath" :: OutdoorTypes.PropGround },
+	spacing = 120,
+	quiet = true,
+	scale = { 0.85, 1.25 },
+	sink = 0.7,
+}
+props.bones = table.freeze(bones)
+
+local saltbarrow = table.clone(Moor) :: OutdoorTypes.OutdoorTileset
+saltbarrow.name = "saltbarrow"
+saltbarrow.palette = "pale salt crust and grey-beige dust, cracked dry mud, sun-bleached bone, "
+	.. "dark basalt outcrops, one dusty ochre at the tombs, desaturated, matte, no highlights"
+saltbarrow.lighting = "mood"
+saltbarrow.props = table.freeze(props)
+-- A flat, bladeless pan: the salt bed has no grass to hide the graves in, and
+-- the road reads as a dark causeway across the pale dust from the high camera.
+saltbarrow.ground = with(Moor.ground, {
+	heath = { material = "Ground", color = { 89, 87, 82 } },
+	road = { material = "Cobblestone", color = { 64, 62, 58 } },
+	ruin = salted(Moor.ground.ruin),
+})
+
+-- Edges. Basalt cliffs repaint to the salt's dark rock; the thicket becomes a
+-- forest of pale salt spires; ruin sites are ringed by the tomb road's broken
+-- columns instead of old field walls, so every ruin reads as a colonnade.
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+local cliffs = table.clone(edges["cliff"].pieces)
+for i, piece in cliffs do
+	cliffs[i] = with(piece, { color = BASALT_ROCK })
+end
+edges["cliff"] = with(edges["cliff"], { pieces = cliffs, spacing = 8 })
+edges["thicket"] = with(edges["thicket"], {
+	pieces = { { name = "SaltSpire", size = Sculpts.saltbarrow_salt_spire.size, sculpt = "saltbarrow_salt_spire" } },
+	spacing = 6,
+	scale = { 1.4, 2.2 },
+	sink = 0.6,
+})
+edges["ruin_wall"] = {
+	pieces = {
+		{
+			name = "BrokenColumn",
+			size = Sculpts.saltbarrow_broken_column.size,
+			sculpt = "saltbarrow_broken_column",
+			solid = true,
+		},
+	},
+	spacing = 7,
+	scale = { 1, 1.5 },
+	sink = 0.5,
+	alongEdge = true,
+	ground = salted(Moor.edges["ruin_wall"].ground :: OutdoorTypes.GroundLook),
+}
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = salted(edge.ground) })
+	end
+end
+saltbarrow.edges = table.freeze(edges) :: any
+
+local outcropPieces = table.clone(Moor.outcrop.pieces)
+for i, piece in outcropPieces do
+	outcropPieces[i] = with(piece, { color = BASALT_ROCK })
+end
+if Moor.outcrop.ground then
+	saltbarrow.outcrop = with(Moor.outcrop, { pieces = outcropPieces, ground = salted(Moor.outcrop.ground) })
+end
+local bluffRock = Moor.bluff and Moor.bluff.rock
+if bluffRock then
+	saltbarrow.bluff = with(Moor.bluff, {
+		rock = salted(bluffRock),
+		backing = { material = "Slate", color = { 62, 60, 56 } },
+	})
+end
+if Moor.pools then
+	-- The dead sea's last brine: a dark sheet on a bed of the salt pan's mud.
+	saltbarrow.pools = with(Moor.pools, { bed = salted(Moor.pools.bed) })
+end
+
+-- Low dust haze, warmer than the moor's blue mist, thinner than the field's.
+saltbarrow.groundMist = with(Moor.groundMist, {
+	color = { 168, 160, 144 },
+	perHundredCells = 0.5,
+	spacing = 48,
+	height = 1.2,
+	size = 28,
+	transparency = 0.86,
+})
+
+-- Closed all round, as Field2 closes the Ashfields: rising salt and dark
+-- basalt hills past every rim, the road running on as a lane through them,
+-- and dust-grey mist in the abyss.
+saltbarrow.beyond = with(Moor.beyond, {
+	reach = 40,
+	hills = table.freeze({ reach = 60, chunk = 10, height = table.freeze({ 14, 30 }), lane = 4, laneReach = 12 }),
+	ground = salted(Moor.beyond.ground),
+	rock = salted(Moor.beyond.rock),
+	mist = with(Moor.beyond.mist, { color = { 96, 92, 84 } }),
+})
+
+-- The field's own beacon and fort serve as the next section's skyline past the
+-- seam: nothing of Saltbarrow's own out there. Its landmark is the king, a
+-- colossal ribcage half sunk in the salt (B11), with the tomb road's arches
+-- and ochre-rag markers at every threshold.
+local fieldLandmarks = assert(Field.landmarks, "the field has landmarks")
+local landmarks: OutdoorTypes.LandmarkLook = {
+	bones = { name = "KingsBones", size = Sculpts.saltbarrow_king_bones.size, sculpt = "saltbarrow_king_bones" },
+	fort = fieldLandmarks.fort,
+	fire = fieldLandmarks.fire,
+	rock = salted({ material = "Basalt", color = { 52, 54, 62 } }),
+	barricade = fieldLandmarks.barricade,
+	seamArch = {
+		name = "TombGate",
+		size = Sculpts.saltbarrow_bone_arch.size,
+		sculpt = "saltbarrow_bone_arch",
+		solid = true,
+	},
+	seamLamp = TOMB_LAMP,
+	paddock = fieldLandmarks.paddock,
+	headland = salted({ material = "LeafyGrass", color = { 50, 53, 45 } }),
+}
+saltbarrow.landmarks = table.freeze(landmarks)
+
+-- The map's two ends in the kings' bone stone. The arrival pool is a faint
+-- ochre shimmer, dark and see-through so it never reads as a white disc
+-- (C32); the way on's sheet burns the zone's ochre once the map is cleared.
+saltbarrow.ends = table.freeze({
+	arrival = {
+		ring = { name = "KingsWaystones", size = Sculpts.saltbarrow_waystones.size, sculpt = "saltbarrow_waystones" },
+		lamp = ARRIVAL_LAMP,
+		pool = { radius = 4, color = { 56, 42, 26 }, transparency = 0.6 },
+	},
+	exit = {
+		arch = { name = "KingsArch", size = Sculpts.saltbarrow_exit_arch.size, sculpt = "saltbarrow_exit_arch" },
+		sheet = {
+			width = 5.6,
+			height = 9.4,
+			dim = { 52, 48, 42 },
+			lit = { 200, 156, 96 },
+			transparency = 0.25,
+			light = { color = { 220, 170, 100 }, range = 24, brightness = 2 },
+		},
+	},
+	offMap = {
+		name = "TombGate",
+		size = Sculpts.saltbarrow_bone_arch.size,
+		sculpt = "saltbarrow_bone_arch",
+		solid = true,
+	},
+})
+
+-- Each threshold between reaches: the tomb road's lamp, and a standing stone
+-- with the zone's ochre rag (B8), so a way on reads the same every time.
+saltbarrow.thresholds = table.freeze({
+	lamp = TOMB_LAMP,
+	marker = {
+		name = "TombMarker",
+		size = Sculpts.saltbarrow_marker.size,
+		sculpt = "saltbarrow_marker",
+		solid = true,
+	},
+	gates = {
+		LowMoor = {
+			name = "TombGate",
+			size = Sculpts.saltbarrow_bone_arch.size,
+			sculpt = "saltbarrow_bone_arch",
+			solid = true,
+		},
+	},
+})
+
+-- Every graveyard is a lesser tomb road of its own, its back wall the royal
+-- vault: the ochre door breathes a low light over the graves.
+local graveyardCrypt: OutdoorTypes.PieceLook = {
+	name = "KingsTomb",
+	size = Sculpts.saltbarrow_king_tomb.size,
+	sculpt = "saltbarrow_king_tomb",
+	light = {
+		color = { 255, 170, 96 },
+		range = 18,
+		brightness = 1,
+		height = 3.2,
+		ember = 0.5,
+		pulse = { style = "breathe", depth = 0.12, period = 4 },
+	},
+}
+if Moor.graveyard then
+	saltbarrow.graveyard = with(Moor.graveyard :: any, { crypt = graveyardCrypt, gateWidth = 6 })
+end
+-- Fewer lit ruin doors than the moor's: the salt keeps its dark.
+saltbarrow.wallLights = with(Moor.wallLights, { chance = 0.35 })
+
+return table.freeze(saltbarrow)
