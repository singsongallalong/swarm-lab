diff --git a/src/shared/data/outdoorTilesets/Saltbarrow.luau b/src/shared/data/outdoorTilesets/Saltbarrow.luau
new file mode 100644
index 0000000..b636942
--- /dev/null
+++ b/src/shared/data/outdoorTilesets/Saltbarrow.luau
@@ -0,0 +1,380 @@
+--!strict
+-- Saltbarrow, the dry bed of a dead inland sea (Saltbarrow brief): a pale
+-- salt crust cracked into plates, grey-beige dust, dark basalt islands and
+-- the bleached bones of something enormous half buried in the flats, with a
+-- lone watchtower on the rim and the kings' tombs cut into the bones. Its
+-- one muted accent is a dusty ochre (bible B8), carried on the saltbush seed
+-- heads and the tombs' doors; it is warmer and paler than the Ashfields'
+-- grey ash and keeps none of its violet.
+--
+-- Derived from the Moor the way Field2 is derived from Field: the same
+-- generated layouts, repainted by terrain material (Terrain keeps one colour
+-- per material), thinned props and a dust haze. Its night is the mood
+-- preset's silver-blue over standing stone, the way the moor's is.
+local LightingPresets = require("../LightingPresets")
+local Moor = require("./Moor")
+local OutdoorTypes = require("../../OutdoorTypes")
+local Sculpts = require("../Sculpts")
+
+local function with<T>(base: T, changes: { [string]: any }): T
+	local out = table.clone(base :: any)
+	for key, value in changes do
+		out[key] = value
+	end
+	return table.freeze(out) :: any
+end
+
+-- Salt ground by terrain material: Terrain keeps one colour per material, so
+-- every look on a material moves together (OutdoorTilesets.spec). The salt
+-- crust sits at the bible's value ceiling for a large surface, desaturated;
+-- the rising land and the sites step darker, and the basalt islands stay
+-- near-neutral so the ochre accent is the only hue on the basin.
+local SALT: { [string]: { number } } = {
+	Sand = { 88, 87, 84 }, -- the salt plain: pale grey crust
+	Ground = { 78, 77, 73 }, -- the rising land past the rim, a shade darker
+	Cobblestone = { 72, 70, 64 }, -- the old sea-floor road, cracked into plates
+	Mud = { 58, 55, 50 }, -- the trodden mud of the sites and the pool beds
+	Basalt = { 48, 50, 56 }, -- the basalt islands, cliffs and outcrops
+	Slate = { 20, 21, 24 }, -- the abyss under the mist
+}
+
+local function salted(look: OutdoorTypes.GroundLook): OutdoorTypes.GroundLook
+	local color = SALT[look.material]
+	return if color then with(look, { color = color }) else look
+end
+
+-- The rim cliffs and the basalt islands: the moor's generated meshes, painted
+-- dark basalt. Untextured pieces sit near the top of the bible's value range,
+-- or they lose their facets and read as flat black shapes (A005's captures).
+local BASALT_ROCK = { 58, 60, 65 }
+-- The dead trees at the old shoreline, bleached to the colour of the salt.
+local BLEACHED_WOOD = { 80, 76, 68 }
+
+local cliffPieces: { OutdoorTypes.PieceLook } = {}
+for i, piece in (Moor.edges :: any)["cliff"].pieces do
+	cliffPieces[i] = with(piece, { color = BASALT_ROCK })
+end
+-- A stranded forest of pale trunks where the sea died, in place of the
+-- moor's black thickets; the snapped sculpt stump stays out (it is the
+-- moor's dark wood, not this shore's bone-white).
+local treePieces: { OutdoorTypes.PieceLook } = {}
+for _, piece in (Moor.edges :: any)["thicket"].pieces do
+	if piece.mesh then
+		table.insert(treePieces, with(piece, { color = BLEACHED_WOOD }))
+	end
+end
+local CLIFF_PIECES = table.freeze(cliffPieces)
+local TREE_PIECES = table.freeze(treePieces)
+
+local edges: { [string]: OutdoorTypes.EdgeLook } = table.clone(Moor.edges :: any)
+edges["cliff"] = with(edges["cliff"], { pieces = CLIFF_PIECES })
+edges["thicket"] = with(edges["thicket"], {
+	pieces = TREE_PIECES,
+	-- The old shoreline is thinner than the moor's wood: a few trunks, farther apart.
+	spacing = 9,
+	scale = { 1.5, 2.3 },
+})
+for kind, edge in edges do
+	if edge.ground then
+		edges[kind] = with(edge, { ground = salted(edge.ground) })
+	end
+end
+
+local props = table.clone(Moor.props)
+-- Saltbush: the flats' only cover, dry pale clumps with a sparse ochre seed
+-- head, so the zone's one accent is scattered across the heath (B8).
+props.heather = with(props.heather, {
+	pieces = {
+		{ name = "Saltbush", size = Sculpts.saltbarrow_saltbush.size, sculpt = "saltbarrow_saltbush" },
+	},
+	perHundredCells = 4,
+	scale = { 0.9, 1.3 },
+	sink = 0.3,
+})
+-- The kings' gravestones, bone-slab and leaning.
+props.headstones = with(props.headstones, {
+	pieces = {
+		{ name = "SaltHeadstone", size = Sculpts.saltbarrow_headstone.size, sculpt = "saltbarrow_headstone" },
+		{
+			name = "SaltHeadstoneBroken",
+			size = Sculpts.saltbarrow_headstone_broken.size,
+			sculpt = "saltbarrow_headstone_broken",
+			weight = 0.7,
+		},
+	},
+	perHundredCells = 26,
+})
+-- The grave lanterns' stakes in the salt's own dead timber.
+props.candles = with(props.candles, {
+	pieces = { with(props.candles.pieces[1], { color = { 72, 64, 52 } }) },
+})
+
+-- Lamps along the old road: a bleached timber post and a hanging lantern,
+-- the only warm light out on the salt (B2-B3). Its light sits under the
+-- chain, as the moor's does; the arrival's is dimmer, since a party lands
+-- beside it (C38).
+local LAMP_POST = Sculpts.saltbarrow_lamppost
+local LANTERN_CAGE = 0.9
+local function lampPost(brightness: number): OutdoorTypes.PieceLook
+	return {
+		name = "SaltLampPost",
+		size = LAMP_POST.size,
+		sculpt = "saltbarrow_lamppost",
+		light = {
+			color = { 255, 168, 88 },
+			range = 20,
+			brightness = brightness,
+			height = (LAMP_POST.arm :: number) - (LAMP_POST.drop :: number) - LANTERN_CAGE * 1.3 / 2,
+			reach = LAMP_POST.reach,
+			cage = LANTERN_CAGE,
+			pulse = { style = "flicker", depth = 0.12, period = 1.3 },
+		},
+	}
+end
+local ROAD_LAMP = lampPost(1.6)
+local ARRIVAL_LAMP = lampPost(0.8)
+props.lanterns = with(props.lanterns, { pieces = { ROAD_LAMP }, spacing = 90 })
+-- The brazier in a ruin, its slate warmed to the salt's own grey.
+props.embers = with(props.embers, {
+	pieces = { with(props.embers.pieces[1], { color = { 72, 68, 60 } }) },
+})
+props.boulders = with(props.boulders, {
+	pieces = {
+		{
+			name = "SaltBoulder",
+			solid = true,
+			size = Sculpts.saltbarrow_boulder.size,
+			sculpt = "saltbarrow_boulder",
+		},
+	},
+	perHundredCells = 1.2,
+	scale = { 0.7, 1.3 },
+	sink = 0.8,
+})
+-- A ring of standing stones of the vanished kings, out on the bare salt.
+local boneCircle: OutdoorTypes.PropSet = {
+	pieces = {
+		{ name = "SaltStoneRing", size = Sculpts.saltbarrow_waystones.size, sculpt = "saltbarrow_waystones" },
+	},
+	perHundredCells = 0,
+	count = 2,
+	spacing = 150,
+	clearance = 4,
