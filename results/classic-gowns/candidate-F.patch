+-- The Classic sleeves (the ClassicSleeves look): the clockwork gown's gloves.
+-- A black bell sleeve that stays close at the elbow and widens in three tiers
+-- down the forearm into a crimson cuff ringed with bone lace, with crimson
+-- gloves and a thin brass wrist band below it. The flare is all at the
+-- forearm, never at the shoulder, so the figure keeps its narrow line.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local black = { 24, 22, 28 }
+local crimson = { 112, 34, 40 }
+local crimsonDeep = { 80, 26, 32 }
+local brass = { 140, 112, 62 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The elbow band the dress's crimson elbow band meets, then the bell.
+		Kit.box("LowerArm", { 1.14, 0.18, 1.14 }, { 0, 0.46, 0 }, "Fabric", black),
+		Kit.box("LowerArm", { 1.3, 0.1, 1.3 }, { 0, 0.34, 0 }, "Fabric", crimson),
+		Kit.box("LowerArm", { 1.26, 0.32, 1.28 }, { 0.02, 0.18, 0 }, "Fabric", black),
+		Kit.box("LowerArm", { 1.4, 0.3, 1.44 }, { 0.08, -0.05, 0 }, "Fabric", crimsonDeep),
+		-- The cuff: crimson with a bone lace edge, hanging over the wrist.
+		Kit.box("LowerArm", { 1.5, 0.3, 1.54 }, { 0.14, -0.29, 0 }, "Fabric", crimson),
+		Kit.box("LowerArm", { 1.54, 0.08, 1.58 }, { 0.16, -0.45, 0 }, "Fabric", c.bone),
+		-- The crimson glove, with a brass band at the wrist and a gear on the back.
+		Kit.box("Hand", { 1.06, 0.32, 1.06 }, { 0, 0, 0 }, "Fabric", crimson),
+		Kit.box("Hand", { 1.08, 0.06, 1.08 }, { 0, 0.14, 0 }, "Metal", brass),
+		{
+			on = "Hand",
+			shape = "Cylinder",
+			size = { 0.2, 0.05, 0.2 },
+			at = { 0, 0, -0.55 },
+			turn = { 90, 0, 0 },
+			material = "Metal",
+			color = brass,
+		},
+	},
+}
+
+return look
