+--!strict
+-- The Classic dress (the ClassicDress look): the clockwork gown's chest. A
+-- deep black fitted bodice with a crimson neckline and a bone lace collar,
+-- laced down the front in crimson, a crimson bow at the throat, and a
+-- crimson sash at the waist whose centre is a brass clock face: the toy clock
+-- of the headdress grown into the gown. The upper skirt hangs from each thigh
+-- in tiers, a crimson tier under a bone lace edge and a black outer tier with
+-- a thin crimson stripe, so the two legs' panels meet into one full skirt
+-- standing and part as they stride. A brass key hangs at the right hip, and
+-- small bone gear teeth line the lace.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local black = { 24, 22, 28 }
+local blackCloth = { 36, 33, 40 }
+local crimson = { 112, 34, 40 }
+local crimsonDeep = { 80, 26, 32 }
+local brass = { 140, 112, 62 }
+
+-- A disc on `on`: the waist clock's case and face, and the key's ring.
+-- `size` is { diameter, length, diameter }, as a Cylinder's.
+local function disc(
+	on: ArmourLookTypes.BodyPart,
+	size: { number },
+	at: { number },
+	color: { number },
+	turn: { number }?
+): ArmourLookTypes.ArmourPart
+	return {
+		on = on,
+		shape = "Cylinder",
+		size = size,
+		at = at,
+		turn = turn,
+		material = "Metal",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice, a crimson neckline and the bone lace collar under it.
+			Kit.box("UpperTorso", { 2.08, 1.62, 1.06 }, { 0, 0, 0 }, "Fabric", black),
+			Kit.box("UpperTorso", { 1.32, 0.16, 1.18 }, { 0, 0.74, 0 }, "Fabric", crimson),
+			Kit.box("UpperTorso", { 1.4, 0.07, 1.26 }, { 0, 0.65, 0 }, "Fabric", c.bone),
+			-- The front laced up in crimson: the placket and three crossed laces.
+			Kit.box("UpperTorso", { 0.34, 1.05, 0.06 }, { 0, 0.08, -0.545 }, "Fabric", crimson),
+			Kit.box("UpperTorso", { 0.56, 0.055, 0.03 }, { 0, 0.45, -0.585 }, "Fabric", black, { 0, 0, 24 }),
+			Kit.box("UpperTorso", { 0.56, 0.055, 0.03 }, { 0, 0.22, -0.585 }, "Fabric", black, { 0, 0, -24 }),
+			Kit.box("UpperTorso", { 0.56, 0.055, 0.03 }, { 0, -0.01, -0.585 }, "Fabric", black, { 0, 0, 24 }),
+			-- The crimson bow at the throat, below the collar.
+			Kit.box("UpperTorso", { 0.28, 0.18, 0.1 }, { -0.16, 0.58, -0.58 }, "Fabric", crimson, { 0, 0, 14 }),
+			Kit.box("UpperTorso", { 0.28, 0.18, 0.1 }, { 0.16, 0.58, -0.58 }, "Fabric", crimson, { 0, 0, -14 }),
+			Kit.box("UpperTorso", { 0.14, 0.16, 0.12 }, { 0, 0.58, -0.61 }, "Fabric", crimsonDeep),
+			-- The upper sleeve, close to the arm, and a crimson band at the elbow.
+			Kit.box("UpperArm", { 1.08, 1.24, 1.08 }, { 0, 0, 0 }, "Fabric", black),
+			Kit.box("UpperArm", { 1.12, 0.16, 1.12 }, { 0, -0.54, 0 }, "Fabric", crimson),
+			-- The waist: a fitted black underbodice under a crimson sash.
+			Kit.box("LowerTorso", { 2.08, 0.4, 1.06 }, { 0, 0, 0 }, "Fabric", black),
+			Kit.box("LowerTorso", { 2.12, 0.2, 1.1 }, { 0, 0.08, 0 }, "Fabric", crimson),
+			-- The big waist bow, its centre the clock face: loops and two tails.
+			Kit.box("LowerTorso", { 0.52, 0.26, 0.18 }, { -0.35, 0.08, -0.62 }, "Fabric", crimson, { 0, 0, 16 }),
+			Kit.box("LowerTorso", { 0.52, 0.26, 0.18 }, { 0.35, 0.08, -0.62 }, "Fabric", crimson, { 0, 0, -16 }),
+			Kit.box("LowerTorso", { 0.15, 0.26, 0.06 }, { -0.16, -0.055, -0.62 }, "Fabric", crimsonDeep, { 0, 0, 9 }),
+			Kit.box("LowerTorso", { 0.15, 0.26, 0.06 }, { 0.16, -0.055, -0.62 }, "Fabric", crimsonDeep, { 0, 0, -9 }),
+			disc("LowerTorso", { 0.34, 0.08, 0.34 }, { 0, 0.06, -0.66 }, brass, { 90, 0, 0 }),
+			disc("LowerTorso", { 0.27, 0.03, 0.27 }, { 0, 0.06, -0.71 }, c.bone, { 90, 0, 0 }),
+			Kit.box("LowerTorso", { 0.035, 0.16, 0.02 }, { 0, 0.09, -0.73 }, "Fabric", black),
+			Kit.box("LowerTorso", { 0.1, 0.035, 0.02 }, { 0.035, 0.06, -0.73 }, "Fabric", black),
+			-- The upper skirt, hung from each thigh: a crimson tier, a bone lace
+			-- edge, a black tier with a crimson stripe, and a wider black tier
+			-- stopping above the knee.
+			Kit.box("UpperLeg", { 1.2, 0.34, 1.26 }, { 0.1, 0.55, 0 }, "Fabric", crimson),
+			Kit.box("UpperLeg", { 1.28, 0.1, 1.34 }, { 0.14, 0.31, 0 }, "Fabric", c.bone),
+			Kit.box("UpperLeg", { 1.5, 0.56, 1.5 }, { 0.25, 0, 0 }, "Fabric", blackCloth),
+			Kit.box("UpperLeg", { 1.52, 0.07, 1.52 }, { 0.26, 0.11, 0 }, "Fabric", crimson),
+			Kit.box("UpperLeg", { 1.85, 0.3, 1.75 }, { 0.425, -0.42, 0 }, "Fabric", blackCloth),
+			-- Bone gear teeth hanging from the lace edge.
+			Kit.box("UpperLeg", { 0.16, 0.14, 0.1 }, { -0.35, 0.2, -0.78 }, "Fabric", c.bone),
+			Kit.box("UpperLeg", { 0.16, 0.14, 0.1 }, { 0.05, 0.2, -0.78 }, "Fabric", c.bone),
+			Kit.box("UpperLeg", { 0.16, 0.14, 0.1 }, { 0.45, 0.2, -0.78 }, "Fabric", c.bone),
+			-- The brass key at the right hip: a ribbon, a ring, a shaft and a bit.
+			Kit.box("UpperLeg", { 0.08, 0.18, 0.04 }, { 0.72, 0.22, -0.78 }, "Fabric", crimsonDeep, nil, "Right"),
+			{
+				on = "UpperLeg",
+				side = "Right",
+				shape = "Cylinder",
+				size = { 0.16, 0.05, 0.16 },
+				at = { 0.72, 0.1, -0.8 },
+				turn = { 90, 0, 0 },
+				material = "Metal",
+				color = brass,
+			},
+			Kit.box("UpperLeg", { 0.05, 0.2, 0.04 }, { 0.72, -0.02, -0.8 }, "Metal", brass, nil, "Right"),
+			Kit.box("UpperLeg", { 0.12, 0.06, 0.04 }, { 0.78, -0.11, -0.8 }, "Metal", brass, nil, "Right"),
+		},
+	}),
+}
+
+return look
