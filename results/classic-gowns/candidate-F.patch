+--!strict
+-- The Classic headdress (the ClassicHeaddress look): the clockwork gown's
+-- helm. A bone lace rim under a crimson band across the crown, a big crimson
+-- bow at the right with a tiny brass clock pinned to it and its tails down
+-- that side, and a flat brass gear at the other end of the band. The clock is
+-- the toy one on the fan drawing, grown into the waist's clock-face bow; it
+-- sits up on the crown so the high camera reads a red-and-brass headpiece
+-- before the face. Hair and hats are hidden under it.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local black = { 24, 22, 28 }
+local crimson = { 112, 34, 40 }
+local crimsonDeep = { 80, 26, 32 }
+local brass = { 140, 112, 62 }
+
+-- A brass disc on the Head: the clock's case and face, and a gear lying flat
+-- on the band. `turn` as in ArmourPart, so a disc can face forward or up.
+local function disc(size: { number }, at: { number }, color: { number }, turn: { number }?): ArmourLookTypes.ArmourPart
+	return {
+		on = "Head",
+		shape = "Cylinder",
+		size = size,
+		at = at,
+		turn = turn,
+		material = "Metal",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicHeaddress",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The band across the crown: a bone lace rim peeking under crimson.
+		Kit.box("Head", { 1.34, 0.08, 0.64 }, { 0, 0.6, 0 }, "Fabric", c.bone),
+		Kit.box("Head", { 1.26, 0.1, 0.56 }, { 0, 0.66, 0 }, "Fabric", crimson),
+		-- The big bow at the right, its loops swept either side of the knot.
+		Kit.box("Head", { 0.4, 0.22, 0.32 }, { 0.42, 0.74, -0.22 }, "Fabric", crimson, { 0, 26, 0 }),
+		Kit.box("Head", { 0.4, 0.22, 0.32 }, { 0.42, 0.74, 0.22 }, "Fabric", crimson, { 0, -26, 0 }),
+		Kit.box("Head", { 0.2, 0.22, 0.2 }, { 0.42, 0.73, 0 }, "Fabric", crimsonDeep),
+		-- Its two tails down the right side of the head.
+		Kit.box("Head", { 0.12, 0.46, 0.1 }, { 0.6, 0.44, 0.1 }, "Fabric", crimsonDeep, { 0, 0, -8 }),
+		Kit.box("Head", { 0.12, 0.38, 0.1 }, { 0.54, 0.5, 0.26 }, "Fabric", crimsonDeep, { 0, 0, 8 }),
+		-- The toy clock on the knot: brass case, bone face, black hands, face up
+		-- so it reads from the high camera.
+		disc({ 0.3, 0.07, 0.3 }, { 0.42, 0.855, 0 }, brass, nil),
+		disc({ 0.24, 0.03, 0.24 }, { 0.42, 0.895, 0 }, c.bone, nil),
+		Kit.box("Head", { 0.035, 0.02, 0.13 }, { 0.42, 0.915, -0.03 }, "Fabric", black),
+		Kit.box("Head", { 0.1, 0.02, 0.035 }, { 0.47, 0.915, 0 }, "Fabric", black),
+		-- A flat brass gear at the other end of the band, for asymmetry.
+		disc({ 0.2, 0.05, 0.2 }, { -0.42, 0.73, 0 }, brass, nil),
+	},
+}
+
+return look
