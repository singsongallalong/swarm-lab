+--!strict
+-- The classic gown's sleeves (the ClassicSleeves base): the inverted gothic
+-- lolita set's gloves. The dress's crimson bell sleeve widens from the elbow
+-- and hangs to the wrist in three round steps, its mouth edged first in bone
+-- lace and then in black lace, with a close black glove showing below. All the
+-- volume is at the forearm, so the upper arm stays close to the body.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local black = { 20, 18, 22 }
+local cream = { 204, 190, 160 }
+local crimson = { 132, 32, 40 }
+local lace = { 40, 36, 42 }
+
+-- A step of the bell: a cylinder standing on its Y axis, centred on the forearm.
+local function bell(diameter: number, height: number, y: number, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "LowerArm",
+		shape = "Cylinder",
+		size = { diameter, height, diameter },
+		at = { 0, y, 0 },
+		material = "Fabric",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The elbow is square, so it covers the arm's corners; the flare below is round.
+		Kit.box("LowerArm", { 1.16, 0.26, 1.16 }, { 0, 0.415, 0 }, "Fabric", crimson),
+		bell(1.5, 0.34, 0.19, crimson),
+		bell(1.56, 0.36, -0.13, crimson),
+		bell(1.62, 0.06, -0.33, cream),
+		bell(1.68, 0.16, -0.45, lace),
+		Kit.box("Hand", { 1.12, 0.36, 1.12 }, { 0, 0, 0 }, "Leather", black),
+	},
+}
+
+return look
