+--!strict
+-- The classic gown's headdress (the ClassicHeaddress base): the inverted
+-- gothic lolita set's helm. A black lace band round the crown of the blocky
+-- head with a bone lace edge across the brow, a large black bow set high on
+-- one side above the ear line, trailing ribbon ends at the back, and a small
+-- brass clock pinned to the bow. The height sits over the crown, never out at
+-- the ears, so the head reads as a headdress and not a helmet.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local black = { 20, 18, 22 }
+local brass = { 152, 118, 66 }
+local cream = { 204, 190, 160 }
+local lace = { 40, 36, 42 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicHeaddress",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The lace band: four strips round the crown, proud of each face.
+		Kit.box("Head", { 1.3, 0.16, 0.08 }, { 0, 0.5, -0.64 }, "Fabric", lace),
+		Kit.box("Head", { 1.3, 0.16, 0.08 }, { 0, 0.5, 0.64 }, "Fabric", lace),
+		Kit.box("Head", { 0.08, 0.16, 1.3 }, { 0.64, 0.5, 0 }, "Fabric", lace),
+		Kit.box("Head", { 0.08, 0.16, 1.3 }, { -0.64, 0.5, 0 }, "Fabric", lace),
+		-- The bone lace edge showing under the band across the brow.
+		Kit.box("Head", { 1.32, 0.06, 0.06 }, { 0, 0.39, -0.65 }, "Fabric", cream),
+		-- The big bow, set high on the right of the crown and rising well above it.
+		Kit.box("Head", { 0.26, 0.26, 0.2 }, { 0.52, 0.68, -0.02 }, "Fabric", black),
+		Kit.box("Head", { 0.48, 0.36, 0.16 }, { 0.84, 0.84, -0.02 }, "Fabric", black, { 0, 0, 30 }),
+		Kit.box("Head", { 0.38, 0.3, 0.16 }, { 0.24, 0.84, -0.02 }, "Fabric", black, { 0, 0, -40 }),
+		-- The ribbon ends, trailing back from the knot.
+		Kit.box("Head", { 0.1, 0.36, 0.08 }, { 0.5, 0.46, 0.36 }, "Fabric", black, { 18, 0, -10 }),
+		Kit.box("Head", { 0.08, 0.3, 0.07 }, { 0.62, 0.48, 0.32 }, "Fabric", black, { 14, 0, -16 }),
+		-- The tiny clock pinned to the front of the bow: a brass case and a pale face.
+		Kit.box("Head", { 0.22, 0.22, 0.08 }, { 0.46, 0.6, -0.16 }, "Metal", brass),
+		Kit.box("Head", { 0.14, 0.14, 0.1 }, { 0.46, 0.6, -0.18 }, "SmoothPlastic", cream),
+	},
+}
+
+return look
