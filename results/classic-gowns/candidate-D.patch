+--!strict
+-- The classic gown's dress (the ClassicDress base): the inverted gothic
+-- lolita set's chest, the piece the whole gown hangs off. A deep crimson
+-- bodice laced down the front in black, a black lace ruff and a small black
+-- bow at the throat, a black sash at the waist under a big black bow, close
+-- crimson sleeves cuffed in black at the elbow, and the skirt's upper tiers
+-- hung from the thighs so they swing with each leg. The tiers are round drums,
+-- each a little wider than the one above, so standing they meet into one
+-- fitted waist flaring to a full skirt.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local black = { 20, 18, 22 }
+local cream = { 204, 190, 160 }
+local crimson = { 132, 32, 40 }
+local lace = { 40, 36, 42 }
+
+-- A tier of the skirt: a cylinder standing on its Y axis, centred on the thigh.
+local function drum(diameter: number, height: number, y: number, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "UpperLeg",
+		shape = "Cylinder",
+		size = { diameter, height, diameter },
+		at = { 0, y, 0 },
+		material = "Fabric",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicDress",
+	slot = "Chest",
+	parts = {
+		-- The fitted bodice, and the black band that pinches the ribcage in.
+		Kit.box("UpperTorso", { 2.08, 1.62, 1.06 }, { 0, 0, 0 }, "Fabric", crimson),
+		Kit.box("UpperTorso", { 2.12, 0.18, 1.1 }, { 0, -0.68, 0 }, "Fabric", black),
+		-- Black lacing down the front, bar over bar.
+		Kit.box("UpperTorso", { 0.62, 0.1, 0.06 }, { 0, 0.28, -0.56 }, "Fabric", black, { 0, 0, 16 }),
+		Kit.box("UpperTorso", { 0.62, 0.1, 0.06 }, { 0, 0.06, -0.56 }, "Fabric", black, { 0, 0, -16 }),
+		Kit.box("UpperTorso", { 0.62, 0.1, 0.06 }, { 0, -0.16, -0.56 }, "Fabric", black, { 0, 0, 16 }),
+		Kit.box("UpperTorso", { 0.62, 0.1, 0.06 }, { 0, -0.38, -0.56 }, "Fabric", black, { 0, 0, -16 }),
+		-- The lace ruff round the neck, edged in bone lace, with a bow below.
+		Kit.box("UpperTorso", { 1.78, 0.16, 1.0 }, { 0, 0.74, 0 }, "Fabric", lace),
+		Kit.box("UpperTorso", { 1.82, 0.06, 1.04 }, { 0, 0.84, 0 }, "Fabric", cream),
+		Kit.box("UpperTorso", { 0.2, 0.18, 0.14 }, { 0, 0.58, -0.58 }, "Fabric", black),
+		Kit.box("UpperTorso", { 0.34, 0.2, 0.12 }, { 0.23, 0.6, -0.56 }, "Fabric", black, { 0, 0, 14 }),
+		Kit.box("UpperTorso", { 0.34, 0.2, 0.12 }, { -0.23, 0.6, -0.56 }, "Fabric", black, { 0, 0, -14 }),
+		Kit.box("UpperTorso", { 0.1, 0.22, 0.08 }, { 0.09, 0.4, -0.57 }, "Fabric", black, { 0, 0, 6 }),
+		Kit.box("UpperTorso", { 0.1, 0.22, 0.08 }, { -0.09, 0.4, -0.57 }, "Fabric", black, { 0, 0, -6 }),
+		-- The waist: a crimson wrap, a narrow black sash, and the big black bow.
+		Kit.box("LowerTorso", { 2.06, 0.42, 1.06 }, { 0, 0, 0 }, "Fabric", crimson),
+		Kit.box("LowerTorso", { 2.1, 0.1, 1.1 }, { 0, 0.15, 0 }, "Fabric", black),
+		Kit.box("LowerTorso", { 0.3, 0.28, 0.18 }, { 0, -0.08, -0.68 }, "Fabric", black),
+		Kit.box("LowerTorso", { 0.58, 0.38, 0.16 }, { 0.4, -0.05, -0.66 }, "Fabric", black, { 0, 0, 16 }),
+		Kit.box("LowerTorso", { 0.58, 0.38, 0.16 }, { -0.4, -0.05, -0.66 }, "Fabric", black, { 0, 0, -16 }),
+		Kit.box("LowerTorso", { 0.16, 0.26, 0.1 }, { 0.17, -0.15, -0.68 }, "Fabric", black, { 0, 0, 8 }),
+		Kit.box("LowerTorso", { 0.16, 0.26, 0.1 }, { -0.17, -0.15, -0.68 }, "Fabric", black, { 0, 0, -8 }),
