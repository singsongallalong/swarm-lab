+-- drums, each wider than the one above, so the two legs' tiers meet into one
+-- full bell standing still: a bone lace edge at the knee, the crimson outer
+-- tier with its thin black stripe, and the black ruffle at the very bottom.
+-- Below it, dark stockings, a pale frill round each ankle, and black shoes.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local black = { 20, 18, 22 }
+local cream = { 204, 190, 160 }
+local crimson = { 132, 32, 40 }
+local lace = { 40, 36, 42 }
+local stocking = { 46, 40, 50 }
+
+-- A tier of the skirt: a cylinder standing on its Y axis, centred on the shin.
+local function drum(diameter: number, height: number, y: number, color: { number }): ArmourLookTypes.ArmourPart
+	return {
+		on = "LowerLeg",
+		shape = "Cylinder",
+		size = { diameter, height, diameter },
+		at = { 0, y, 0 },
+		material = "Fabric",
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "ClassicHem",
+	slot = "Boots",
+	parts = {
+		-- The skirt carried down the shins: bone lace, crimson tiers, black stripe, black ruffle.
+		drum(1.84, 0.16, 0.765, cream),
+		drum(2, 0.42, 0.535, crimson),
+		drum(2.24, 0.36, 0.225, crimson),
+		drum(2.32, 0.14, 0.175, lace),
+		drum(2.5, 0.14, -0.025, lace),
+		-- Dark stockings, a pale ankle frill, and a plain black shoe.
+		Kit.box("LowerLeg", { 1.1, 0.54, 1.1 }, { 0, -0.305, 0 }, "Fabric", stocking),
+		drum(1.5, 0.14, -0.525, cream),
+		Kit.box("Foot", { 1.08, 0.34, 1.24 }, { 0, 0.02, -0.08 }, "Leather", black),
+	},
+}
+
+return look
