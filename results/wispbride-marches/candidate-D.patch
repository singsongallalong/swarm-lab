+--!strict
+-- The fen bride's veil (WispbrideHelm): a pale mist veil drawn over the crown
+-- and down the back, open at the face, held by a low willow-green circlet at
+-- the brow with a cold wisp-blue point. Willow strands hang from the circlet
+-- at the temples and behind in uneven lengths, so the head reads as a lost
+-- bride of the marsh rather than a traveller in a hat.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Pale mist above, willow grey-green for the circlet and strands, and the
+-- wisps' cold blue only at the point and the veil's hem.
+local mist = { 172, 180, 186 }
+local mistPale = { 200, 205, 208 }
+local mistDeep = { 124, 136, 146 }
+local willow = { 90, 112, 88 }
+local wisp = { 150, 200, 212 }
+local wispDim = { 104, 152, 170 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "WispbrideHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The veil over the crown, drawn forward over the brow so no hair shows.
+		Kit.box("Head", { 1.34, 0.38, 1.36 }, { 0, 0.44, 0.03 }, "Fabric", mistPale),
+		-- A low circlet at the brow: a thin green ring round the veil, clear of the ears.
+		{
+			on = "Head",
+			shape = "Cylinder",
+			size = { 1.42, 0.09, 1.42 },
+			at = { 0, 0.27, 0.02 },
+			material = "Fabric",
+			color = willow,
+		},
+		-- The wisp point at the brow, rising over the circlet.
+		Kit.box("Head", { 0.1, 0.22, 0.06 }, { 0, 0.4, -0.68 }, "Fabric", wisp),
+		-- The long veil down the back, widening and cooling as it falls.
+		Kit.box("Head", { 1.2, 1.35, 0.06 }, { 0, -0.28, 0.66 }, "Fabric", mist, { 4, 0, 0 }),
+		Kit.box("Head", { 1.34, 0.5, 0.05 }, { 0, -1.0, 0.7 }, "Fabric", mistDeep, { 2, 0, 0 }),
+		Kit.box("Head", { 1.36, 0.06, 0.06 }, { 0, -1.28, 0.72 }, "Fabric", wispDim),
+		-- Side veils framing the face, hung outside the head's width.
+		Kit.box("Head", { 0.2, 0.86, 0.1 }, { 0.66, -0.06, -0.5 }, "Fabric", mistPale, { 0, 0, -4 }),
+		Kit.box("Head", { 0.2, 0.8, 0.1 }, { -0.66, -0.1, -0.5 }, "Fabric", mistPale, { 0, 0, 4 }),
+		-- Willow strands from the circlet, uneven, at the temples and behind.
+		Kit.box("Head", { 0.05, 0.95, 0.05 }, { 0.66, -0.18, -0.28 }, "Fabric", willow, { 0, 0, -3 }),
+		Kit.box("Head", { 0.05, 0.85, 0.05 }, { -0.66, -0.14, -0.3 }, "Fabric", willow, { 0, 0, 3 }),
+		Kit.box("Head", { 0.05, 1.1, 0.05 }, { 0.6, -0.24, 0.42 }, "Fabric", willow, { 0, 0, -2 }),
+		Kit.box("Head", { 0.05, 0.9, 0.05 }, { -0.62, -0.2, 0.4 }, "Fabric", willow, { 0, 0, 2 }),
+		-- A willow leaf pinned at one side of the circlet.
+		Kit.wedge("Head", { 0.3, 0.1, 0.08 }, { 0.58, 0.28, -0.5 }, "Fabric", willow, { 0, 0, 10 }),
+	},
+}
+
+return look
