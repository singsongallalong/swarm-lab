+		Kit.box("LowerLeg", { 0.12, 0.3, 0.08 }, { 0.88, -0.23, -0.69 }, "Fabric", straw, { 0, 0, -3 }),
+		Kit.box("LowerLeg", { 0.16, 0.44, 0.08 }, { 0.3, -0.3, 0.72 }, "Fabric", willow, { 0, 0, 2 }),
+		Kit.box("LowerLeg", { 0.14, 0.34, 0.08 }, { 0.8, -0.25, 0.7 }, "Fabric", mistPale, { 0, 0, -2 }),
+		-- A cold blue line at the waterline.
+		Kit.box("LowerLeg", { 1.44, 0.04, 1.44 }, { 0.18, -0.76, 0 }, "Fabric", wisp),
