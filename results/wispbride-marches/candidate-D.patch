+--!strict
+-- The fen bride's sleeves (WispbrideSleeves): pale mist sleeves that stay
+-- close down the forearm and flare into a willow-green bell cuff at the
+-- elbow, ringed with a cold blue thread, then gather to a black-water wrist
+-- over dark gloves. A willow strand and a reed tassel hang from the cuff,
+-- so the volume sits at the forearm and never at the shoulder.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Pale mist for the cloth, willow grey-green for the bell, black water at the
+-- wrist, reed straw for the tassel and the wisps' cold blue on the cuff rim.
+local mist = { 172, 180, 186 }
+local mistPale = { 200, 205, 208 }
+local mistDeep = { 124, 136, 146 }
+local willow = { 90, 112, 88 }
+local straw = { 134, 124, 94 }
+local wisp = { 150, 200, 212 }
+local water = { 24, 30, 38 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "WispbrideSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The sleeve, close to the forearm.
+		Kit.box("LowerArm", { 1.06, 1.04, 1.06 }, { 0, -0.02, 0 }, "Fabric", mistPale),
+		-- The bell cuff at the elbow: a willow-green flare and a pale lip.
+		Kit.box("LowerArm", { 1.46, 0.36, 1.46 }, { 0, 0.38, 0 }, "Fabric", willow),
+		Kit.box("LowerArm", { 1.24, 0.16, 1.24 }, { 0, 0.56, 0 }, "Fabric", mist),
+		Kit.box("LowerArm", { 1.48, 0.05, 1.48 }, { 0, 0.2, 0 }, "Fabric", wisp),
+		-- The wrist, gathered in black water.
+		Kit.box("LowerArm", { 1.1, 0.14, 1.1 }, { 0, -0.34, 0 }, "Fabric", water),
+		-- A dark glove below it.
+		Kit.box("Hand", { 1.06, 0.34, 1.06 }, { 0, 0, 0 }, "Fabric", mistDeep),
+		-- A willow strand and a reed tassel hanging from the cuff edge.
+		Kit.box("LowerArm", { 0.05, 0.5, 0.05 }, { 0.55, 0.02, -0.4 }, "Fabric", willow, { 0, 0, 4 }),
+		Kit.box("LowerArm", { 0.06, 0.2, 0.06 }, { 0.3, 0.13, -0.66 }, "Fabric", straw),
+	},
+}
+
+return look
