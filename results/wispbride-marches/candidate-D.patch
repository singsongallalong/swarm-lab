+--!strict
+-- The fen bride's bodice (WispbrideDress): a fitted pale bodice laced with
+-- woven reeds down the front, a high open collar framing the face and a cold
+-- blue line at the throat. At the waist a black-water sash is knotted off
+-- centre, and willow-green overstrips hang from it over a pale underskirt
+-- that hugs the hips, so the gown widens from the waist down and never at
+-- the shoulders.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- Pale mist, willow grey-green for the overskirt, black water for the sash,
+-- dry reed straw for the lacing and the wisps' cold blue on the small lines.
+local mist = { 172, 180, 186 }
+local mistPale = { 200, 205, 208 }
+local willow = { 90, 112, 88 }
+local straw = { 134, 124, 94 }
+local wisp = { 150, 200, 212 }
+local wispDim = { 104, 152, 170 }
+local water = { 24, 30, 38 }
+
+-- How far the underskirt runs down the thigh from just above its top,
+-- stopping short of the knee so a striding leg's shin clears it.
+local SKIRT = 1.1
+local SKIRT_Y = 0.75 - SKIRT / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "WispbrideDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice, fitted to the torso and soft over the bust.
+		Kit.box("UpperTorso", { 2.04, 1.62, 1.06 }, { 0, 0, 0 }, "Fabric", mist),
+		Kit.box("UpperTorso", { 0.62, 0.46, 0.14 }, { 0.33, 0.18, -0.55 }, "Fabric", mistPale),
+		Kit.box("UpperTorso", { 0.62, 0.46, 0.14 }, { -0.33, 0.18, -0.55 }, "Fabric", mistPale),
+		-- A cold pale-blue trim at the neckline, and a blue line on the collar's edge.
+		Kit.box("UpperTorso", { 0.86, 0.07, 0.06 }, { 0, 0.66, -0.57 }, "Fabric", wisp),
+		Kit.box("UpperTorso", { 1.0, 0.04, 0.12 }, { 0, 1.0, -0.44 }, "Fabric", wisp),
+		-- A high open collar: four standing panels in a ring, so the face reads
+		-- through it from the high camera rather than over a slab.
+		Kit.box("UpperTorso", { 1.08, 0.44, 0.1 }, { 0, 0.88, 0.42 }, "Fabric", mistPale),
+		Kit.box("UpperTorso", { 0.98, 0.34, 0.1 }, { 0, 0.85, -0.44 }, "Fabric", mistPale),
+		Kit.box("UpperTorso", { 0.1, 0.4, 0.88 }, { 0.49, 0.88, 0 }, "Fabric", mistPale),
+		Kit.box("UpperTorso", { 0.1, 0.4, 0.88 }, { -0.49, 0.88, 0 }, "Fabric", mistPale),
+		-- Reed lacing: two crossed pairs down the bodice front.
+		Kit.box("UpperTorso", { 0.07, 0.64, 0.06 }, { 0, 0.26, -0.59 }, "Fabric", straw, { 0, 0, 32 }),
+		Kit.box("UpperTorso", { 0.07, 0.64, 0.06 }, { 0, 0.26, -0.59 }, "Fabric", straw, { 0, 0, -32 }),
+		Kit.box("UpperTorso", { 0.07, 0.6, 0.06 }, { 0, -0.08, -0.59 }, "Fabric", straw, { 0, 0, 32 }),
+		Kit.box("UpperTorso", { 0.07, 0.6, 0.06 }, { 0, -0.08, -0.59 }, "Fabric", straw, { 0, 0, -32 }),
+		-- The waist: a black-water sash, knotted off centre, with a blue line above it.
+		Kit.box("LowerTorso", { 2.1, 0.3, 1.08 }, { 0, 0.02, 0 }, "Fabric", water),
+		Kit.box("LowerTorso", { 0.2, 0.16, 0.12 }, { 0.46, 0, -0.6 }, "Fabric", water),
+		Kit.box("LowerTorso", { 2.08, 0.04, 1.06 }, { 0, 0.19, 0 }, "Fabric", wispDim),
+		-- The sleeves' upper part, close to the arm and over its top so no bare
+		-- shoulder shows, with a willow band on the upper arm.
+		Kit.box("UpperArm", { 1.04, 1.2, 1.04 }, { 0, 0, 0 }, "Fabric", mist),
+		Kit.box("UpperArm", { 1.06, 0.1, 1.06 }, { 0, 0.44, 0 }, "Fabric", willow),
+		-- The pale underskirt, hugging the hips: front, back and outer panels.
+		Kit.box("UpperLeg", { 1.14, SKIRT, 0.1 }, { 0.05, SKIRT_Y, -0.54 }, "Fabric", mist, { 3, 0, 0 }),
+		Kit.box("UpperLeg", { 1.14, SKIRT, 0.1 }, { 0.05, SKIRT_Y, 0.54 }, "Fabric", mist, { -3, 0, 0 }),
+		Kit.box("UpperLeg", { 0.12, SKIRT, 1.12 }, { 0.52, SKIRT_Y, 0 }, "Fabric", mist, { 0, 0, 4 }),
+		-- Willow-green overskirt strips hanging from the sash, uneven in length.
+		Kit.box("UpperLeg", { 0.2, 0.9, 0.08 }, { 0.1, SKIRT_Y + 0.02, -0.61 }, "Fabric", willow, { 2, 0, 0 }),
+		Kit.box("UpperLeg", { 0.16, 1.05, 0.08 }, { 0.52, SKIRT_Y - 0.03, -0.6 }, "Fabric", willow),
+		Kit.box("UpperLeg", { 0.2, 0.85, 0.08 }, { 0.1, SKIRT_Y + 0.04, 0.61 }, "Fabric", willow, { -2, 0, 0 }),
+		Kit.box("UpperLeg", { 0.16, 1, 0.08 }, { 0.52, SKIRT_Y - 0.01, 0.6 }, "Fabric", willow),
+		-- The sash's ends, hanging on the right hip.
+		Kit.box("UpperLeg", { 0.06, 0.55, 0.06 }, { 0.02, 0.45, -0.67 }, "Fabric", water, { 0, 0, 7 }, "Right"),
+		Kit.box("UpperLeg", { 0.06, 0.45, 0.06 }, { 0.12, 0.5, -0.67 }, "Fabric", water, { 0, 0, -6 }, "Right"),
+	},
+}
+
+return look
