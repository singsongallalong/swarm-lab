+--!strict
+-- The wispbride's hem (the Wispbride boots): the lower half of the gown's skirt,
+-- carried on the shins from the knee down. The sage front panel of the dress
+-- continues straight on, then steps wider into a broad sage hem tier, so the
+-- skirt is broader than the hips from front, side and back. The dark back panel
+-- and its hanging strands carry on above the tier, and wet black shoes show
+-- their toes below it.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	mist = { 130, 138, 142 },
+	sage = { 106, 122, 106 },
+	willowDark = { 64, 80, 68 },
+	water = { 30, 36, 40 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "WispbrideHem",
+	slot = "Boots",
+	parts = {
+		-- The sage front, wider than the dress's at the knee, and its sage sides.
+		Kit.box("LowerLeg", { 1.5, 1.2, 0.06 }, { 0.1, 0.08, -0.56 }, "Fabric", c.sage, { 3, 0, 0 }, "Right"),
+		Kit.box("LowerLeg", { 1.5, 1.2, 0.06 }, { 0.1, 0.08, -0.58 }, "Fabric", c.sage, { 3, 0, 0 }, "Left"),
+		Kit.box("LowerLeg", { 0.06, 1.2, 1.12 }, { 0.82, 0.08, 0 }, "Fabric", c.sage),
+		-- The dark back panel, continued from the dress.
+		Kit.box("LowerLeg", { 1.32, 1.2, 0.06 }, { 0.1, 0.08, 0.56 }, "Fabric", c.water, { -4, 0, 0 }, "Right"),
+		Kit.box("LowerLeg", { 1.32, 1.2, 0.06 }, { 0.1, 0.08, 0.58 }, "Fabric", c.water, { -4, 0, 0 }, "Left"),
+		-- The broad hem tier that makes the skirt wider than the hips, stepped out
+		-- from the panels above it.
+		Kit.box("LowerLeg", { 1.9, 0.3, 1.5 }, { 0.1, -0.34, 0 }, "Fabric", c.sage, nil, "Right"),
+		Kit.box("LowerLeg", { 1.9, 0.3, 1.5 }, { 0.1, -0.34, 0.02 }, "Fabric", c.sage, nil, "Left"),
+		-- The pale strand lines continued, and two strands hanging over the dark
+		-- back above the tier.
+		Kit.box("LowerLeg", { 0.12, 0.82, 0.04 }, { -0.2, 0.25, -0.63 }, "Fabric", c.mist, { 3, 0, 0 }),
+		Kit.box("LowerLeg", { 0.12, 0.8, 0.04 }, { 0.45, 0.26, -0.63 }, "Fabric", c.willowDark, { 3, 0, 0 }),
+		Kit.box("LowerLeg", { 0.18, 1.0, 0.05 }, { -0.34, 0.12, 0.7 }, "Fabric", c.mist, { -14, 0, 0 }),
+		Kit.box("LowerLeg", { 0.16, 0.9, 0.05 }, { 0, 0.14, 0.72 }, "Fabric", c.willowDark, { -14, 0, 0 }),
+		-- Wet black shoes, their toes a little past the hem.
+		Kit.box("Foot", { 1.08, 0.36, 1.4 }, { 0, 0, -0.08 }, "Leather", c.water),
+	},
+}
+
+return look
