+--!strict
+-- The wispbride's crown (the Wispbride helm): a drowned bride's veil of pale
+-- mist-grey cloth over the crown, falling long down the back, under a crown of
+-- bare willow twigs that arch up and back with two cold wisp-blue dewdrops at
+-- their tips. Everything stays narrow at the ear and rises at the head, so the
+-- silhouette reads as a bride, not a helm.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	mist = { 130, 138, 142 },
+	mistLight = { 158, 166, 170 },
+	mistDark = { 96, 106, 112 },
+	willowDark = { 64, 80, 68 },
+	bark = { 76, 60, 46 },
+	barkDark = { 52, 42, 34 },
+	wisp = { 132, 172, 198 },
+	wispDim = { 92, 126, 148 },
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "WispbrideCrown",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- The veil: a cloth cap over the crown, a dark band at the brow, and a
+		-- long panel down the back with a cold edge at its hem.
+		Kit.box("Head", { 1.3, 0.46, 1.3 }, { 0, 0.37, 0.02 }, "Fabric", c.mist),
+		Kit.box("Head", { 1.32, 0.08, 1.32 }, { 0, 0.14, 0.02 }, "Fabric", c.willowDark),
+		Kit.box("Head", { 1.16, 1.5, 0.08 }, { 0, -0.42, 0.63 }, "Fabric", c.mist),
+		Kit.box("Head", { 1.18, 0.1, 0.1 }, { 0, -1.12, 0.63 }, "Fabric", c.wispDim),
+		-- Two thin strands of the veil framing the back, one paler than the other.
+		Kit.box("Head", { 0.1, 1.4, 0.1 }, { 0.62, -0.35, 0.62 }, "Fabric", c.mistLight),
+		Kit.box("Head", { 0.1, 1.4, 0.1 }, { -0.62, -0.35, 0.62 }, "Fabric", c.mistDark),
+		-- Bare willow twigs rooted in the crown, arching up and back, the outer
+		-- pair darker and splayed no wider than the head.
+		Kit.box("Head", { 0.06, 0.95, 0.06 }, { 0, 1.02, 0.24 }, "Wood", c.bark, { 12, 0, 0 }),
+		Kit.box("Head", { 0.055, 0.8, 0.055 }, { 0.2, 0.95, 0.2 }, "Wood", c.bark, { 12, 0, -12 }),
+		Kit.box("Head", { 0.055, 0.8, 0.055 }, { -0.2, 0.95, 0.2 }, "Wood", c.bark, { 12, 0, 12 }),
+		Kit.box("Head", { 0.05, 0.6, 0.05 }, { 0.38, 0.85, 0.12 }, "Wood", c.barkDark, { 18, 0, -22 }),
+		Kit.box("Head", { 0.05, 0.6, 0.05 }, { -0.38, 0.85, 0.12 }, "Wood", c.barkDark, { 18, 0, 22 }),
+		-- A cold dewdrop hanging at each outer twig's tip.
+		Kit.box("Head", { 0.09, 0.12, 0.09 }, { 0.5, 1.14, 0.22 }, "SmoothPlastic", c.wisp),
+		Kit.box("Head", { 0.09, 0.12, 0.09 }, { -0.5, 1.14, 0.22 }, "SmoothPlastic", c.wisp),
+	},
+}
+
+return look
