+--!strict
+-- The wispbride's dress (the Wispbride chest): a pale mist bodice with a dark V
+-- neckline, a willow stomacher and a narrow black-water sash with one cold
+-- wisp-blue clasp at the waist. Below it the gown closes into one continuous
+-- sage panel across the front, from the waist over both thighs, with pale strand
+-- lines pressed into it and a dark back panel of hanging strands kept behind.
+-- The skirt hangs from the thighs and the hem's skirt (Boots) carries it on at
+-- the knee, stepping wider. The sleeve above the elbow stays close to the arm.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = {
+	mist = { 130, 138, 142 },
+	sage = { 106, 122, 106 },
+	willow = { 94, 112, 96 },
+	willowDark = { 64, 80, 68 },
+	bark = { 76, 60, 46 },
+	barkDark = { 52, 42, 34 },
+	water = { 30, 36, 40 },
+	wisp = { 132, 172, 198 },
+}
+
+local bodice: { ArmourLookTypes.ArmourPart } = {
+	-- The fitted bodice, its dark V neckline and a pale drop at the throat.
+	Kit.box("UpperTorso", { 2.04, 1.68, 1.06 }, { 0, 0, 0 }, "Fabric", c.mist),
+	Kit.box("UpperTorso", { 0.3, 0.07, 0.04 }, { 0.2, 0.675, -0.545 }, "Fabric", c.willowDark, { 0, 0, -40 }),
+	Kit.box("UpperTorso", { 0.3, 0.07, 0.04 }, { -0.2, 0.675, -0.545 }, "Fabric", c.willowDark, { 0, 0, 40 }),
+	Kit.box("UpperTorso", { 0.1, 0.16, 0.06 }, { 0, 0.57, -0.58 }, "Fabric", c.mist),
+	-- The stomacher down the front, cross-laced in bark cord.
+	Kit.box("UpperTorso", { 0.64, 1.12, 0.05 }, { 0, -0.1, -0.545 }, "Fabric", c.willow),
+	Kit.box("UpperTorso", { 0.5, 0.045, 0.04 }, { 0, 0.06, -0.585 }, "Fabric", c.barkDark, { 0, 0, 25 }),
+	Kit.box("UpperTorso", { 0.5, 0.045, 0.04 }, { 0, 0.06, -0.585 }, "Fabric", c.barkDark, { 0, 0, -25 }),
+	-- The sleeve's upper part, kept close to the arm, with a willow band at the
+	-- elbow where the hanging sleeve is taken up below (Gloves).
+	Kit.box("UpperArm", { 1.06, 1.24, 1.06 }, { 0, 0.02, 0 }, "Fabric", c.mist),
+	Kit.box("UpperArm", { 1.08, 0.14, 1.08 }, { 0, -0.5, 0 }, "Fabric", c.willowDark),
+}
+
+local waist: { ArmourLookTypes.ArmourPart } = {
+	-- A pale lower bodice under one narrow black-water sash, with a single cold
+	-- wisp clasp at the front and a sage bow at the small of the back.
+	Kit.box("LowerTorso", { 2.04, 0.38, 1.06 }, { 0, 0, 0 }, "Fabric", c.mist),
+	Kit.box("LowerTorso", { 2.08, 0.18, 1.12 }, { 0, 0.04, 0 }, "Fabric", c.water),
+	Kit.box("LowerTorso", { 0.14, 0.14, 0.08 }, { 0, 0.04, -0.59 }, "SmoothPlastic", c.wisp, { 0, 0, 45 }),
+	Kit.box("LowerTorso", { 0.2, 0.16, 0.14 }, { 0, 0.06, 0.55 }, "Fabric", c.willow),
+	Kit.box("LowerTorso", { 0.46, 0.2, 0.08 }, { 0.28, 0.1, 0.57 }, "Fabric", c.willow, { 0, 0, -18 }),
+	Kit.box("LowerTorso", { 0.46, 0.2, 0.08 }, { -0.28, 0.1, 0.57 }, "Fabric", c.willow, { 0, 0, 18 }),
+}
+
+local skirt: { ArmourLookTypes.ArmourPart } = {
+	-- The front, closed: one broad sage panel per thigh, overlapped at the centre
+	-- (the left laid a shade prouder so the join has no seam to split).
+	Kit.box("UpperLeg", { 1.3, 1.33, 0.06 }, { 0.1, 0.085, -0.55 }, "Fabric", c.sage, { 3, 0, 0 }, "Right"),
+	Kit.box("UpperLeg", { 1.3, 1.33, 0.06 }, { 0.1, 0.085, -0.57 }, "Fabric", c.sage, { 3, 0, 0 }, "Left"),
+	-- The broad sage sides, meeting the front and back at their edges.
+	Kit.box("UpperLeg", { 0.06, 1.3, 1.12 }, { 0.72, 0.1, 0 }, "Fabric", c.sage),
+	-- The dark back panel, the left laid prouder like the front.
+	Kit.box("UpperLeg", { 1.3, 1.3, 0.06 }, { 0.1, 0.1, 0.55 }, "Fabric", c.water, { -6, 0, 0 }, "Right"),
+	Kit.box("UpperLeg", { 1.3, 1.3, 0.06 }, { 0.1, 0.1, 0.57 }, "Fabric", c.water, { -6, 0, 0 }, "Left"),
