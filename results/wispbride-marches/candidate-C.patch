+	Kit.box("UpperLeg", { 0.14, 1.22, 0.05 }, { -0.29, 0.25, 0.645 }, "Fabric", c.willowDark, { -6, 0, 0 }),
+}
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "WispbrideDress",
+	slot = "Chest",
+	parts = Kit.join({ bodice, waist, skirt }),
+}
+
+return look
