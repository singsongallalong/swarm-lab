+			Kit.box("UpperTorso", { 0.09, 0.7, 0.06 }, { 0.15, 0.36, -0.55 }, "Fabric", colours.ivory, { 0, 0, -25 }),
+			Kit.box("UpperTorso", { 0.09, 0.7, 0.06 }, { -0.15, 0.36, -0.55 }, "Fabric", colours.ivory, { 0, 0, 25 }),
+		},
+		{
+			-- The single wine waist seam, its amber gem, and the bow behind.
+			Kit.box("LowerTorso", { 2.02, 0.4, 1.02 }, { 0, 0, 0 }, "Fabric", colours.gold),
+			Kit.box("LowerTorso", { 2.06, 0.34, 1.06 }, { 0, 0, 0 }, "Fabric", colours.wine),
+			Kit.box("LowerTorso", { 0.24, 0.18, 0.08 }, { 0, 0.02, -0.57 }, "Neon", colours.amber),
+			Kit.box("LowerTorso", { 0.4, 0.28, 0.1 }, { 0.28, 0.04, 0.58 }, "Fabric", colours.wine, { 0, 0, 12 }),
+			Kit.box("LowerTorso", { 0.4, 0.28, 0.1 }, { -0.28, 0.04, 0.58 }, "Fabric", colours.wine, { 0, 0, -12 }),
+			Kit.box("LowerTorso", { 0.16, 0.16, 0.12 }, { 0.04, 0.04, 0.6 }, "Metal", colours.gold),
+		},
+		{
+			-- A sleeve skin-tight to the upper arm: no cap, no band.
+			Kit.box("UpperArm", { 1.02, 1.24, 1.02 }, { 0, 0, 0 }, "Fabric", colours.wine),
+		},
+		{
+			-- The upper skirt: five thin gold facets around each thigh, so the
+			-- shape is a bell rather than a board, over a dark underskirt.
+			Kit.box("UpperLeg", { 1.04, 1.16, 1.04 }, { 0, 0.02, 0 }, "Fabric", colours.shade),
+			Kit.box("UpperLeg", { 1.15, 1.15, 0.06 }, { 0, 0.025, -0.6 }, "Fabric", colours.gold, { 12, 0, 0 }),
+			Kit.box("UpperLeg", { 1.15, 1.15, 0.06 }, { 0, 0.025, 0.6 }, "Fabric", colours.gold, { -12, 0, 0 }),
+			Kit.box("UpperLeg", { 1.0, 1.15, 0.06 }, { 0.67, 0.025, -0.42 }, "Fabric", colours.gold, { 10, 45, 0 }),
