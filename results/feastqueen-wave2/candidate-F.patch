@@ -0,0 +1,166 @@
+--!strict
+-- The Feastqueen's dress (the Feastqueen feast set): a bright gold bodice
+-- with an ivory stomacher laced in wine, a wine sash under a gold sun belt,
+-- a slim gold sleeve on each upper arm, and the gown's upper skirt hung in
+-- four flared panels from each thigh. A wide sun-disc collar rings the neck:
+-- a bright ivory disc, a wine inner ring and six gold rays, all inside the
+-- shoulder line, so it frames the head without broadening the figure. Between
+-- the ivory pleats a wine underlayer shows, and the side panels fall in deep
+-- gold, so the skirt reads gold, wine and ivory from the high camera.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's palette: the feast's bright candle gold, its deep shadow gold and
+-- paler edge, the court's wine, warm ivory, and candle amber at the belt.
+local gold = { 212, 166, 68 }
+local goldDeep = { 148, 104, 40 }
+local goldPale = { 244, 208, 116 }
+local wine = { 122, 38, 50 }
+local ivory = { 236, 224, 196 }
+local amber = { 255, 190, 86 }
+
+local FLARE = 12
+local SKIRT_TOP = 0.75
+local SKIRT_LENGTH = 1.31
+local R_TOP = 0.55
+local FRONT_A = math.rad(FLARE)
+local FRONT_R = R_TOP + math.sin(FRONT_A) * SKIRT_LENGTH / 2
+local FRONT_Y = SKIRT_TOP - math.cos(FRONT_A) * SKIRT_LENGTH / 2
+
+-- The turn that stands a panel at `azimuth` around the thigh (0 = front) and
+-- flares its hem outward. Rotations compose as CFrame.Angles(x, y, z), so the
+-- yaw is folded through X and Z to keep the flare radial.
+local function turnAt(azimuth: number, flare: number): { number }
+	local th = math.rad(-azimuth)
+	local a = math.rad(flare)
+	return {
+		math.deg(math.atan2(math.sin(a), math.cos(th) * math.cos(a))),
+		math.deg(math.asin(math.sin(th) * math.cos(a))),
+		math.deg(math.atan2(-math.sin(th) * math.sin(a), math.cos(th))),
+	}
+end
+
+-- One flared skirt panel hung from the thigh, in `color`.
+local function panel(azimuth: number, width: number, color: { number }): ArmourLookTypes.ArmourPart
+	local a = math.rad(FLARE)
+	local az = math.rad(azimuth)
+	local radius = R_TOP + math.sin(a) * SKIRT_LENGTH / 2
+	return Kit.box("UpperLeg", { width, SKIRT_LENGTH, 0.06 }, {
+		radius * math.sin(az),
+		SKIRT_TOP - math.cos(a) * SKIRT_LENGTH / 2,
+		-radius * math.cos(az),
+	}, "Fabric", color, turnAt(azimuth, FLARE))
+end
+
+-- A piece on the front panel, `down` its length and `proud` off its face.
+local function frontPiece(
+	x: number,
+	width: number,
+	height: number,
+	down: number,
+	proud: number,
+	material: string,
+	color: { number },
+	turnZ: number?,
+	side: ArmourLookTypes.Side?
+): ArmourLookTypes.ArmourPart
+	return Kit.box("UpperLeg", { width, height, 0.04 }, {
+		x,
+		FRONT_Y - math.cos(FRONT_A) * down + math.sin(FRONT_A) * proud,
+		-FRONT_R - math.sin(FRONT_A) * down - math.cos(FRONT_A) * proud,
+	}, material, color, { FLARE, 0, turnZ or 0 }, side)
+end
+
+-- A disc lying flat around the neck, like a sun platter.
+local function collar(
+	diameter: number,
+	thickness: number,
+	y: number,
+	material: string,
+	color: { number }
+): ArmourLookTypes.ArmourPart
+	return {
+		on = "UpperTorso",
+		shape = "Cylinder",
+		size = { diameter, thickness, diameter },
+		at = { 0, y, 0 },
+		material = material,
+		color = color,
+	}
+end
+
+-- One ray of the collar sun, lying flat on the discs.
+local function collarRay(degrees: number): ArmourLookTypes.ArmourPart
+	local a = math.rad(degrees)
+	return Kit.box("UpperTorso", { 0.12, 0.05, 0.48 }, {
+		0.72 * math.sin(a),
+		0.92,
+		0.72 * math.cos(a),
+	}, "Metal", gold, { 0, degrees, 0 })
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FeastqueenDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The fitted bodice, its ivory stomacher and a wine lace.
+			Kit.box("UpperTorso", { 2.06, 1.64, 1.06 }, { 0, 0, 0 }, "Fabric", gold),
+			Kit.box("UpperTorso", { 0.84, 1.3, 0.06 }, { 0, -0.04, -0.555 }, "Fabric", ivory),
+			Kit.box("UpperTorso", { 0.56, 0.05, 0.05 }, { 0, 0.18, -0.59 }, "Fabric", wine),
+			-- A wine V at the neckline.
+			Kit.box("UpperTorso", { 0.64, 0.09, 0.05 }, { 0.33, 0.6, -0.565 }, "Fabric", wine, { 0, 0, -22 }),
+			Kit.box("UpperTorso", { 0.64, 0.09, 0.05 }, { -0.33, 0.6, -0.565 }, "Fabric", wine, { 0, 0, 22 }),
+			-- A wine panel at the back.
+			Kit.box("UpperTorso", { 0.72, 1.0, 0.05 }, { 0, 0.02, 0.55 }, "Fabric", wine),
+		},
+		{
+			-- The sun-disc collar: bright ivory, a wine inner ring, six rays.
+			collar(1.9, 0.1, 0.84, "Fabric", ivory),
+			collar(1.44, 0.05, 0.895, "Fabric", wine),
+			collarRay(0),
+			collarRay(60),
+			collarRay(120),
+			collarRay(180),
+			collarRay(240),
+			collarRay(300),
+		},
+		{
+			-- The waist: a wine sash pinched by a gold belt with a sun buckle.
+			Kit.box("LowerTorso", { 2.1, 0.34, 1.1 }, { 0, 0.01, 0 }, "Fabric", wine),
+			Kit.box("LowerTorso", { 2.14, 0.1, 1.14 }, { 0, -0.12, 0 }, "Metal", gold),
+			{
+				on = "LowerTorso",
+				shape = "Cylinder",
+				size = { 0.3, 0.08, 0.3 },
+				at = { 0, -0.12, -0.6 },
+				turn = { 90, 0, 0 },
+				material = "Metal",
+				color = goldPale,
+			},
+			Kit.box("LowerTorso", { 0.16, 0.16, 0.06 }, { 0, -0.12, -0.65 }, "Neon", amber),
+			-- A wine bow at the back.
+			Kit.box("LowerTorso", { 0.24, 0.18, 0.14 }, { 0, 0.03, 0.58 }, "Fabric", wine),
+			Kit.box("LowerTorso", { 0.26, 0.16, 0.1 }, { 0.22, 0.06, 0.57 }, "Fabric", wine, { 0, 0, 12 }),
+			Kit.box("LowerTorso", { 0.26, 0.16, 0.1 }, { -0.22, 0.06, 0.57 }, "Fabric", wine, { 0, 0, -12 }),
+		},
+		{
+			-- A slim gold sleeve, snug over the shoulder top.
+			Kit.box("UpperArm", { 1.06, 1.18, 1.06 }, { 0, 0, 0 }, "Fabric", gold),
+		},
+		{
+			-- The upper skirt: four panels a leg, bright front and back, the
+			-- sides in deep gold, the wine underlayer showing between pleats.
+			panel(0, 1.3, gold),
+			panel(60, 0.92, goldDeep),
+			panel(120, 0.92, goldDeep),
+			panel(180, 1.3, gold),
+			frontPiece(-0.3, 0.16, 1.22, 0, 0.05, "Fabric", ivory),
+			frontPiece(0.32, 0.16, 1.22, 0, 0.05, "Fabric", ivory),
+			frontPiece(0.01, 0.4, 1.22, 0, 0.04, "Fabric", wine),
+			frontPiece(0, 1.28, 0.12, 0.59, 0.05, "Metal", goldPale),
+		},
+	}),
+}
+
+return look
