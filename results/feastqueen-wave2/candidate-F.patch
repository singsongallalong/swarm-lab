+--!strict
+-- The Feastqueen's sleeves (the Feastqueen feast set): a slim gold sleeve on
+-- the upper arm, then a small round bell on the forearm, stepping from wine
+-- at the elbow through two gold tiers to a narrow ivory cuff at the wrist.
+-- Keeping the cuff close to the arm leaves the shoulder line the narrowest
+-- part of the figure and stops the sleeve reading as a frill from above.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's palette: the feast's bright candle gold, the court's wine and
+-- warm ivory.
+local gold = { 212, 166, 68 }
+local wine = { 122, 38, 50 }
+local ivory = { 236, 224, 196 }
+
+-- A round tier of the sleeve, running down the forearm.
+local function tier(
+	diameter: number,
+	length: number,
+	y: number,
+	material: string,
+	color: { number }
+): ArmourLookTypes.ArmourPart
+	return {
+		on = "LowerArm",
+		shape = "Cylinder",
+		size = { diameter, length, diameter },
+		at = { 0, y, 0 },
+		material = material,
+		color = color,
+	}
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FeastqueenSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The small sleeve bell: wine at the elbow, two gold tiers, ivory cuff.
+		tier(1.1, 0.1, 0.47, "Fabric", wine),
+		tier(1.14, 0.5, 0.2, "Fabric", gold),
+		tier(1.2, 0.55, -0.26, "Fabric", gold),
+		tier(1.24, 0.12, -0.49, "Fabric", ivory),
+		-- The gold glove.
+		Kit.box("Hand", { 1.06, 0.32, 1.06 }, { 0, 0, 0 }, "Fabric", gold),
+	},
+}
+
+return look
