@@ -0,0 +1,73 @@
+--!strict
+-- The Feastqueen's crown (the Feastqueen feast set): a bright gold circlet
+-- with an ivory band, a wine-backed sun disc on the brow with an amber eye,
+-- and five pale-gold rays rising from it. The rays go up and out above the
+-- head, never wide at the ear, so from the high camera the headpiece reads as
+-- a crown of candlelight before any detail does.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's palette: the feast's bright candle gold and its paler edge, the
+-- court's wine, warm ivory, and the candle amber kept for the glowing eye.
+local gold = { 212, 166, 68 }
+local goldPale = { 244, 208, 116 }
+local wine = { 122, 38, 50 }
+local ivory = { 236, 224, 196 }
+local amber = { 255, 190, 86 }
+
+local PIVOT_Y = 0.42
+local PIVOT_Z = -0.62
+
+-- A disc stood upright on the face of the head, facing front or back.
+local function disc(
+	diameter: number,
+	thickness: number,
+	at: { number },
+	material: string,
+	color: { number }
+): ArmourLookTypes.ArmourPart
+	return {
+		on = "Head",
+		shape = "Cylinder",
+		size = { diameter, thickness, diameter },
+		at = at,
+		turn = { 90, 0, 0 },
+		material = material,
+		color = color,
+	}
+end
+
+-- One ray of the sun fan: `degrees` off upright, its root at the brow disc.
+local function ray(degrees: number): ArmourLookTypes.ArmourPart
+	local a = math.rad(degrees)
+	return Kit.box("Head", { 0.11, 0.72, 0.07 }, {
+		math.sin(a) * 0.36,
+		PIVOT_Y + math.cos(a) * 0.36,
+		PIVOT_Z,
+	}, "Metal", goldPale, { 0, 0, -degrees })
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FeastqueenHelm",
+	slot = "Helm",
+	parts = {
+		-- The circlet and its warm ivory lining.
+		Kit.box("Head", { 1.3, 0.14, 1.3 }, { 0, 0.36, 0 }, "Metal", gold),
+		Kit.box("Head", { 1.24, 0.08, 1.24 }, { 0, 0.26, 0 }, "Fabric", ivory),
+		-- The sun at the brow: wine behind, bright gold in front, an amber eye.
+		disc(0.62, 0.05, { 0, 0.42, -0.635 }, "Fabric", wine),
+		disc(0.5, 0.07, { 0, 0.42, -0.675 }, "Metal", gold),
+		Kit.box("Head", { 0.16, 0.16, 0.06 }, { 0, 0.42, -0.72 }, "Neon", amber),
+		-- Five rays of the sun, fanned above the brow.
+		ray(0),
+		ray(25),
+		ray(-25),
+		ray(50),
+		ray(-50),
+		-- The two ivory ribbons that hang from the circlet behind the head.
+		Kit.box("Head", { 0.1, 0.6, 0.05 }, { 0.34, 0.08, 0.64 }, "Fabric", ivory, { 0, 0, 8 }),
+		Kit.box("Head", { 0.1, 0.6, 0.05 }, { -0.34, 0.08, 0.64 }, "Fabric", ivory, { 0, 0, -8 }),
+	},
+}
+
+return look
