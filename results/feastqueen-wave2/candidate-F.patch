@@ -0,0 +1,124 @@
+--!strict
+-- The Feastqueen's hem (the Feastqueen feast set): the gown's lower skirt,
+-- carried on from the knee in five widely flared gold panels a leg that open
+-- into a broad bell, with an ivory hem band all round, ivory pleats down the
+-- front and the wine underlayer showing between them. A pale gold garter
+-- closes the knee, and the shoes are gold with a point. One thin amber seam
+-- glows above the hem on the right, and on the left a shade-black stain
+-- creeps up from the floor where the feast's dream has begun to sour.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+-- The set's palette: the feast's bright candle gold and its paler edge, the
+-- court's wine, warm ivory, the shade creeping in at the hem, and amber.
+local gold = { 212, 166, 68 }
+local goldPale = { 244, 208, 116 }
+local wine = { 122, 38, 50 }
+local ivory = { 236, 224, 196 }
+local shade = { 30, 26, 30 }
+local amber = { 255, 190, 86 }
+
+local FLARE = 26
+local SKIRT_TOP = 0.6
+local SKIRT_LENGTH = 1.24
+local R_TOP = 0.55
+local HEM_HEIGHT = 0.16
+local HEM_THICK = 0.06
+local FRONT_A = math.rad(FLARE)
+local FRONT_R = R_TOP + math.sin(FRONT_A) * SKIRT_LENGTH / 2
+local FRONT_Y = SKIRT_TOP - math.cos(FRONT_A) * SKIRT_LENGTH / 2
+
+-- The turn that stands a panel at `azimuth` around the shin (0 = front) and
+-- flares its hem outward; rotations compose as CFrame.Angles(x, y, z).
+local function turnAt(azimuth: number, flare: number): { number }
+	local th = math.rad(-azimuth)
+	local a = math.rad(flare)
+	return {
+		math.deg(math.atan2(math.sin(a), math.cos(th) * math.cos(a))),
+		math.deg(math.asin(math.sin(th) * math.cos(a))),
+		math.deg(math.atan2(-math.sin(th) * math.sin(a), math.cos(th))),
+	}
+end
+
+-- One flared panel of the lower skirt, hung from the shin.
+local function panel(azimuth: number, width: number): ArmourLookTypes.ArmourPart
+	local a = math.rad(FLARE)
+	local az = math.rad(azimuth)
+	local radius = R_TOP + math.sin(a) * SKIRT_LENGTH / 2
+	return Kit.box("LowerLeg", { width, SKIRT_LENGTH, 0.06 }, {
+		radius * math.sin(az),
+		SKIRT_TOP - math.cos(a) * SKIRT_LENGTH / 2,
+		-radius * math.cos(az),
+	}, "Fabric", gold, turnAt(azimuth, FLARE))
+end
+
+-- The ivory band across the bottom of the panel at `azimuth`, proud of it.
+local function hemBand(azimuth: number, width: number): ArmourLookTypes.ArmourPart
+	local a = math.rad(FLARE)
+	local az = math.rad(azimuth)
+	local radius = R_TOP + math.sin(a) * SKIRT_LENGTH / 2
+	local down = SKIRT_LENGTH / 2 - HEM_HEIGHT / 2 - 0.01
+	local proud = 0.03 + HEM_THICK / 2
+	local ux, uy, uz = -math.sin(az) * math.sin(a), math.cos(a), math.cos(az) * math.sin(a)
+	local nx, ny, nz = math.sin(az) * math.cos(a), math.sin(a), -math.cos(az) * math.cos(a)
+	return Kit.box("LowerLeg", { width, HEM_HEIGHT, HEM_THICK }, {
+		radius * math.sin(az) - ux * down + nx * proud,
+		SKIRT_TOP - math.cos(a) * SKIRT_LENGTH / 2 - uy * down + ny * proud,
+		-radius * math.cos(az) - uz * down + nz * proud,
+	}, "Fabric", ivory, turnAt(azimuth, FLARE))
+end
+
+-- A piece on the front panel, `down` its length and `proud` off its face.
+local function frontPiece(
+	x: number,
+	width: number,
+	height: number,
+	down: number,
+	proud: number,
+	material: string,
+	color: { number },
+	turnZ: number?,
+	side: ArmourLookTypes.Side?
+): ArmourLookTypes.ArmourPart
+	return Kit.box("LowerLeg", { width, height, 0.04 }, {
+		x,
+		FRONT_Y - math.cos(FRONT_A) * down + math.sin(FRONT_A) * proud,
+		-FRONT_R - math.sin(FRONT_A) * down - math.cos(FRONT_A) * proud,
+	}, material, color, { FLARE, 0, turnZ or 0 }, side)
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FeastqueenHem",
+	slot = "Boots",
+	parts = Kit.join({
+		{
+			-- The lower skirt: five broad panels a leg, meeting at the centre
+			-- and closing the sides.
+			panel(0, 1.34),
+			panel(60, 0.98),
+			panel(90, 0.98),
+			panel(120, 0.98),
+			panel(180, 1.34),
+			-- The ivory hem carried all round, ivory pleats down the front with
+			-- the wine underlayer between them, the amber seam and the creep.
+			hemBand(0, 1.36),
+			hemBand(60, 1.0),
+			hemBand(90, 1.0),
+			hemBand(120, 1.0),
+			hemBand(180, 1.36),
+			frontPiece(-0.3, 0.16, 1.06, 0, 0.05, "Fabric", ivory),
+			frontPiece(0.32, 0.16, 1.06, 0, 0.05, "Fabric", ivory),
+			frontPiece(0.01, 0.4, 1.06, 0, 0.04, "Fabric", wine),
+			frontPiece(0.16, 0.5, 0.06, 0.42, 0.06, "Neon", amber, 0, "Right"),
+			frontPiece(-0.5, 0.1, 0.36, 0.42, 0.05, "Fabric", shade, -10, "Left"),
+		},
+		{
+			-- The garter that closes the knee, and the shoes.
+			Kit.box("LowerLeg", { 1.18, 0.22, 1.18 }, { 0, 0.54, 0 }, "Metal", goldPale),
+			Kit.box("Foot", { 1.06, 0.3, 1.12 }, { 0, 0.02, -0.04 }, "Fabric", gold),
+			Kit.box("Foot", { 0.3, 0.16, 0.3 }, { 0, -0.02, -0.6 }, "Fabric", goldPale),
+		},
+	}),
+}
+
+return look
