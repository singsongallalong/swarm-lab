+		Kit.box("Head", { 1.34, 0.18, 1.34 }, { 0, 0.28, 0 }, "Metal", gold),
+		-- The crown wall above the brow, open in the middle so the cap shows.
+		Kit.box("Head", { 1.04, 0.5, 0.12 }, { 0, 0.66, -0.56 }, "Metal", gold),
+		Kit.box("Head", { 1.04, 0.5, 0.12 }, { 0, 0.66, 0.56 }, "Metal", gold),
+		Kit.box("Head", { 0.12, 0.5, 1 }, { 0.56, 0.66, 0 }, "Metal", gold),
+		Kit.box("Head", { 0.12, 0.5, 1 }, { -0.56, 0.66, 0 }, "Metal", gold),
+		-- The spires: two short at the front corners, two taller behind, and a
+		-- tall back crest that rakes a little backwards.
+		Kit.box("Head", { 0.13, 0.44, 0.13 }, { 0.47, 1.06, -0.47 }, "Metal", goldBright),
+		Kit.box("Head", { 0.13, 0.44, 0.13 }, { -0.47, 1.06, -0.47 }, "Metal", goldBright),
+		Kit.box("Head", { 0.15, 0.62, 0.15 }, { 0.47, 1.15, 0.47 }, "Metal", goldBright),
+		Kit.box("Head", { 0.15, 0.62, 0.15 }, { -0.47, 1.15, 0.47 }, "Metal", goldBright),
+		Kit.box("Head", { 0.22, 0.9, 0.16 }, { 0, 1.3, 0.56 }, "Metal", goldBright, { 6, 0, 0 }),
+		-- The point over the brow, and the gem beneath it.
+		Kit.box("Head", { 0.16, 0.4, 0.12 }, { 0, 1.1, -0.56 }, "Metal", gold),
+		Kit.box("Head", { 0.16, 0.16, 0.1 }, { 0, 0.28, -0.68 }, "Neon", amber),
