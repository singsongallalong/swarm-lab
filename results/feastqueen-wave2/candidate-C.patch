+--!strict
+-- The Feastqueen's dress (the FeastqueenDress of the Grashan Feast set): a
+-- wine velvet bodice over an ivory chemise, a gold stomacher and collar, and
+-- a gold belt drawing in the waist under the bow at the small of the back.
+-- The upper skirt hangs from the thighs and starts the bell at the hip: wine
+-- panels with a gold band down the centre front and back, over dark wine side
+-- panels. The upper arms stay close and shadowed, leaving the volume and the
+-- colour to the sleeves' bells.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local gold = { 196, 148, 58 }
+local goldBright = { 232, 192, 104 }
+local wine = { 112, 26, 36 }
+local wineDark = { 76, 18, 28 }
+local wineLight = { 142, 42, 50 }
+local ivory = { 216, 202, 174 }
+local amber = { 255, 178, 76 }
+
+-- How far the upper skirt runs down the thigh from just above its top.
+local SKIRT = 1.18
+local SKIRT_Y = 0.75 - SKIRT / 2
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "FeastqueenDress",
+	slot = "Chest",
+	parts = {
+		-- The bodice, the ivory chemise at the neckline and the gold collar.
+		Kit.box("UpperTorso", { 2.12, 1.62, 1.1 }, { 0, 0, 0 }, "Fabric", wine),
+		Kit.box("UpperTorso", { 1.44, 0.2, 1.14 }, { 0, 0.7, 0 }, "Fabric", ivory),
+		Kit.box("UpperTorso", { 1.12, 0.14, 1.16 }, { 0, 0.83, 0 }, "Metal", goldBright),
+		-- The ivory front panel and the gold stomacher laid over it.
+		Kit.box("UpperTorso", { 0.74, 1.42, 0.05 }, { 0, -0.02, -0.568 }, "Fabric", ivory),
+		Kit.box("UpperTorso", { 0.5, 1.3, 0.05 }, { 0, -0.02, -0.598 }, "Metal", gold),
+		Kit.box("UpperTorso", { 0.16, 0.16, 0.08 }, { 0, 0.52, -0.63 }, "Neon", amber),
+		-- A gold panel down the back, and the bow at the small of it.
+		Kit.box("UpperTorso", { 0.5, 1.3, 0.05 }, { 0, -0.02, 0.568 }, "Metal", gold),
+		Kit.box("UpperTorso", { 0.44, 0.2, 0.14 }, { 0.25, -0.54, 0.61 }, "Fabric", wineLight, { 0, 0, 20 }),
+		Kit.box("UpperTorso", { 0.44, 0.2, 0.14 }, { -0.25, -0.54, 0.61 }, "Fabric", wineLight, { 0, 0, -20 }),
+		Kit.box("UpperTorso", { 0.18, 0.2, 0.18 }, { 0, -0.54, 0.64 }, "Metal", gold),
+		-- The waist: wine, stepped in under the bodice so the gold belt is the
+		-- narrowest line of the figure.
+		Kit.box("LowerTorso", { 2.02, 0.42, 1.02 }, { 0, 0, 0 }, "Fabric", wine),
+		Kit.box("LowerTorso", { 2.06, 0.2, 1.06 }, { 0, 0.02, 0 }, "Metal", gold),
+		Kit.box("LowerTorso", { 0.32, 0.32, 0.07 }, { 0, 0.02, -0.56 }, "Metal", goldBright, { 0, 0, 45 }),
+		-- The upper arms: a close shadowed sleeve, slim at the shoulder.
+		Kit.box("UpperArm", { 1.02, 1.24, 1.02 }, { 0, 0, 0 }, "Fabric", wineDark),
+		-- The upper skirt: it starts the bell at the hip, wine panels wide out
+		-- from the body centre with a gold band down the front and back.
+		Kit.box("UpperLeg", { 1.2, SKIRT, 0.1 }, { 0.1, SKIRT_Y, -0.72 }, "Fabric", wine),
+		Kit.box("UpperLeg", { 0.28, SKIRT - 0.02, 0.06 }, { -0.36, SKIRT_Y, -0.785 }, "Metal", gold),
+		Kit.box("UpperLeg", { 1.2, SKIRT, 0.1 }, { 0.1, SKIRT_Y, 0.72 }, "Fabric", wine),
+		Kit.box("UpperLeg", { 0.28, SKIRT - 0.02, 0.06 }, { -0.36, SKIRT_Y, 0.785 }, "Metal", gold),
+		Kit.box("UpperLeg", { 0.1, SKIRT, 1.44 }, { 0.75, SKIRT_Y, 0 }, "Fabric", wineDark),
+	},
+}
+
+return look
