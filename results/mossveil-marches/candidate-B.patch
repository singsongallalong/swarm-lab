+--!strict
+-- The bog orchid gown's sleeves (the Mossveil gloves): the forearms fall into
+-- a slim round stepped bell of moss cloth, frilled out from a narrow elbow
+-- band to a lichen-edged cuff, with a petal drooping over the back of each
+-- hand and close black gloves. All of the volume sits low at the forearm and
+-- stays close to the arm, so the shoulder line above it reads narrow.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local black = { 22, 24, 21 }
+local moss = { 58, 76, 50 }
+local mossDark = { 40, 54, 36 }
+local lichen = { 152, 160, 92 }
+
+-- A cloth ring, round from the high camera.
+local function bell(size: { number }, at: { number }, color: { number }): ArmourLookTypes.ArmourPart
+	return { on = "LowerArm", shape = "Cylinder", size = size, at = at, material = "Fabric", color = color }
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "MossveilSleeves",
+	slot = "Gloves",
+	parts = {
+		-- The bell, stepping out from the elbow band to the cuff.
+		bell({ 1.08, 0.14, 1.08 }, { 0, 0.5, 0 }, mossDark),
+		bell({ 1.14, 0.34, 1.14 }, { 0, 0.28, 0 }, moss),
+		bell({ 1.22, 0.42, 1.22 }, { 0, -0.12, 0 }, moss),
+		bell({ 1.32, 0.16, 1.32 }, { 0, -0.46, 0 }, mossDark),
+		bell({ 1.36, 0.08, 1.36 }, { 0, -0.57, 0 }, lichen),
+		-- The petal that droops over the back of the hand.
+		Kit.box("LowerArm", { 0.32, 0.5, 0.1 }, { 0.42, -0.76, 0.3 }, "Fabric", moss, { 0, 0, 12 }),
+		-- Close black gloves.
+		Kit.box("Hand", { 1.06, 0.42, 1.06 }, { 0, 0, 0 }, "Fabric", black),
+	},
+}
+
+return look
