+--!strict
+-- The mossveil helm (the Mossveil gown's headpiece): the forest's own crown.
+-- A two-tier moss bonnet under a black lace brim, a lichen fringe over the
+-- brow, gill plates laying back at the nape, and a lichen crest ruffle under a
+-- pale ruin-bone fan of five blades and a lichen veil. It rises and lays back
+-- from the head, so the high camera reads bone, lichen and a hanging veil,
+-- never a helmet's width at the ears.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local moss = { 52, 70, 46 } -- deep moss green, the gown's body colour
+local mossLight = { 74, 96, 58 } -- lit moss, the frills' upper tone
+local lichen = { 130, 132, 80 } -- sickly lichen yellow-green, the accent
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "MossveilHelm",
+	slot = "Helm",
+	hidesHair = true,
+	parts = {
+		-- A two-tier moss bonnet under a black lace brim.
+		Kit.box("Head", { 1.26, 0.44, 1.26 }, { 0, 0.4, 0 }, "Fabric", moss),
+		Kit.box("Head", { 1, 0.3, 0.9 }, { 0, 0.66, 0.16 }, "Fabric", mossLight),
+		Kit.box("Head", { 1.32, 0.14, 1.32 }, { 0, 0.12, 0 }, "Fabric", c.bogWet),
+		-- A lichen fringe falls over the brow.
+		Kit.box("Head", { 0.9, 0.2, 0.08 }, { 0, 0.02, -0.68 }, "Fabric", lichen, { 8, 0, 0 }),
+		-- Gills at the back of the bonnet, each laying further back than the last.
+		Kit.box("Head", { 1.16, 0.14, 0.5 }, { 0, 0.42, 0.55 }, "Fabric", mossLight, { -18, 0, 0 }),
+		Kit.box("Head", { 0.98, 0.12, 0.44 }, { 0, 0.56, 0.66 }, "Fabric", lichen, { -30, 0, 0 }),
+		-- The crest: a lichen ruffle at the bonnet's crown and a pale bone fan of
+		-- five blades rising and spreading from it.
+		Kit.box("Head", { 1, 0.12, 0.36 }, { 0, 0.82, 0.24 }, "Fabric", lichen, { -14, 0, 0 }),
+		Kit.box("Head", { 0.16, 0.9, 0.12 }, { 0, 0.98, 0.22 }, "Fabric", c.bone, { 12, 0, 0 }),
+		Kit.box("Head", { 0.14, 0.72, 0.11 }, { 0.17, 0.9, 0.24 }, "Fabric", c.bone, { 18, 0, -8 }),
+		Kit.box("Head", { 0.14, 0.72, 0.11 }, { -0.17, 0.9, 0.24 }, "Fabric", c.bone, { 18, 0, 8 }),
+		Kit.box("Head", { 0.12, 0.52, 0.1 }, { 0.32, 0.8, 0.26 }, "Fabric", c.bone, { 26, 0, -16 }),
+		Kit.box("Head", { 0.12, 0.52, 0.1 }, { -0.32, 0.8, 0.26 }, "Fabric", c.bone, { 26, 0, 16 }),
+		-- The lichen veil, in two lengths, falling away from the neck.
+		Kit.box("Head", { 0.9, 0.6, 0.1 }, { 0, 0, 0.66 }, "Fabric", lichen, { -6, 0, 0 }),
+		Kit.box("Head", { 0.78, 0.6, 0.06 }, { 0, -0.55, 0.72 }, "Fabric", mossLight, { -4, 0, 0 }),
+	},
+}
+
+return look
