+--!strict
+-- The mossveil hem (the Mossveil gown's boots): the skirt's lower half,
+-- carried on the shins so it strides with each leg and meets the thigh's tiers
+-- above the knee. Deep moss tiers keep widening all round, and the last two are
+-- the lichen yellow-green ruffled hem, which falls to just above the floor and
+-- hides the near-black shoes: the skirt covers the legs from front, side and
+-- above, with no trouser gap and no feet showing beneath. A torn moss tab hangs
+-- over the lichen on the right, so the hem is not perfectly clean.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local moss = { 52, 70, 46 }
+local lichen = { 130, 132, 80 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "MossveilHem",
+	slot = "Boots",
+	parts = {
+		-- The shin tiers: two in deep moss, then the lichen hem's two ruffles.
+		-- Each tier's inner face lies on the body's centre line, so the two
+		-- legs' tiers meet and read as one continuous skirt.
+		Kit.box("LowerLeg", { 1.85, 0.62, 1.7 }, { 0.425, 0.39, 0 }, "Fabric", moss),
+		Kit.box("LowerLeg", { 2.15, 0.57, 1.95 }, { 0.575, -0.135, 0 }, "Fabric", moss),
+		Kit.box("LowerLeg", { 2.3, 0.32, 2.1 }, { 0.65, -0.44, 0 }, "Fabric", lichen),
+		Kit.box("LowerLeg", { 2.42, 0.22, 2.25 }, { 0.71, -0.61, 0 }, "Fabric", lichen),
+		-- A torn moss tab hanging over the lichen hem on the right.
+		Kit.box("LowerLeg", { 0.7, 0.22, 0.08 }, { 1.1, -0.62, -1.16 }, "Fabric", moss, { 10, 0, 0 }, "Right"),
+		-- Near-black shoes under the hem.
+		Kit.box("Foot", { 1.06, 0.32, 1.2 }, { 0, 0.01, -0.04 }, "Leather", c.bogWet),
+	},
+}
+
+return look
