@@ -0,0 +1,54 @@
+--!strict
+-- The mossveil dress (the Mossveil gown's chest): a deep moss court gown, in
+-- one deliberate order of colour. A fitted moss bodice to the neck with bone
+-- trims at the neckline and a pale diamond, a moss-dark corset laced in bone,
+-- and a bone belt at the waist. Below it the skirt starts: three moss tiers on
+-- each thigh, each set so its inner face lies on the body's centre line, so
+-- standing the two legs' tiers meet and read as one continuous skirt that
+-- flares from the waist rather than as two leg panels.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+local c = Kit.colors
+
+local moss = { 52, 70, 46 }
+local mossDark = { 34, 46, 32 }
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "MossveilDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice, fitted to the neck and shaped at the bust.
+			Kit.box("UpperTorso", { 2.06, 1.62, 1.06 }, { 0, 0.01, 0 }, "Fabric", moss),
+			Kit.box("UpperTorso", { 1.4, 0.34, 0.18 }, { 0, 0.12, -0.54 }, "Fabric", moss),
+			-- Bone trims at the neckline: a band across the chest and a diamond.
+			Kit.box("UpperTorso", { 1.84, 0.09, 1.08 }, { 0, 0.7, 0 }, "Fabric", c.bone),
+			Kit.box("UpperTorso", { 0.16, 0.24, 0.06 }, { 0, 0.52, -0.54 }, "Fabric", c.bone, { 0, 0, 45 }),
+			-- A moss-dark corset laced in bone down the front.
+			Kit.box("UpperTorso", { 0.78, 1, 0.08 }, { 0, -0.24, -0.56 }, "Fabric", mossDark),
+			Kit.box("UpperTorso", { 0.36, 0.04, 0.04 }, { 0, -0.6, -0.62 }, "Fabric", c.bone, { 0, 0, 22 }),
+			Kit.box("UpperTorso", { 0.36, 0.04, 0.04 }, { 0, -0.38, -0.62 }, "Fabric", c.bone, { 0, 0, -22 }),
+			Kit.box("UpperTorso", { 0.36, 0.04, 0.04 }, { 0, -0.16, -0.62 }, "Fabric", c.bone, { 0, 0, 22 }),
+			Kit.box("UpperTorso", { 0.36, 0.04, 0.04 }, { 0, 0.06, -0.62 }, "Fabric", c.bone, { 0, 0, -22 }),
+			-- The waist: a moss-dark band under a bone belt and buckle.
+			Kit.box("LowerTorso", { 2.02, 0.4, 1.02 }, { 0, 0, 0 }, "Fabric", mossDark),
+			Kit.box("LowerTorso", { 2.06, 0.1, 1.06 }, { 0, -0.04, 0 }, "Fabric", c.bone),
+			Kit.box("LowerTorso", { 0.2, 0.14, 0.06 }, { 0, -0.04, -0.56 }, "Fabric", c.bone),
+			-- A small moss-dark bustle behind, above the hip.
+			Kit.box("LowerTorso", { 1.2, 0.28, 0.26 }, { 0, 0.02, 0.58 }, "Fabric", mossDark, { -10, 0, 0 }),
+			-- Slim moss sleeves, close to the arm so nothing widens the shoulder.
+			Kit.box("UpperArm", { 1.06, 1.24, 1.06 }, { 0, 0, 0 }, "Fabric", moss),
+		},
+		{
+			-- The skirt's thigh tiers. Each is written for one leg but set so its
+			-- inner face lies on the body's centre line: the two legs' tiers meet
+			-- there and standing read as one skirt, not as two panels.
+			Kit.box("UpperLeg", { 1.08, 0.45, 1.1 }, { 0.04, 0.525, 0 }, "Fabric", moss),
+			Kit.box("UpperLeg", { 1.2, 0.65, 1.25 }, { 0.1, 0.025, 0 }, "Fabric", moss),
+			Kit.box("UpperLeg", { 1.5, 0.35, 1.45 }, { 0.25, -0.425, 0 }, "Fabric", moss),
+		},
+	}),
+}
+
+return look
