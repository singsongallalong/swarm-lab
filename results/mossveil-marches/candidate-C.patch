+		Kit.box("Foot", { 0.18, 0.14, 1.8 }, { 1.22, 0.1, 0 }, "Fabric", c.lichen, { 0, 0, 12 }),
+		Kit.box("Foot", { 2.44, 0.14, 0.18 }, { 0, 0.1, 0.9 }, "Fabric", c.lichen, { -4, 0, 0 }),
+		-- The lower tier, a wider and deeper pale bone step at the floor.
+		Kit.box("Foot", { 2.64, 0.22, 0.26 }, { 0, -0.05, -1.03 }, "Fabric", c.bone, { 4, 0, 0 }),
+		Kit.box("Foot", { 0.26, 0.22, 2.06 }, { 1.33, -0.05, 0 }, "Fabric", c.bone, { 0, 0, 12 }),
