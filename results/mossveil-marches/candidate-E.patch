+local mossPale = { 88, 104, 62 }
+local lichen = { 124, 134, 78 }
+local black = { 32, 34, 31 }
+
+-- One tier of the skirt on a shin: `w` is half the skirt's full width there,
+-- and `z` how far the front and back panels stand off the leg.
+local function tier(
+	y: number,
+	h: number,
+	w: number,
+	z: number,
+	lean: number,
+	out: number,
+	colour: { number }
+): { ArmourPart }
+	local cx = w / 2 - 0.5
+	local depth = 2 * z + 0.1
+	return {
+		Kit.box("LowerLeg", { w, h, 0.09 }, { cx, y, -z }, "Fabric", colour, { lean, 0, 0 }),
+		Kit.box("LowerLeg", { w, h, 0.09 }, { cx, y, z }, "Fabric", colour, { -lean, 0, 0 }),
+		Kit.box("LowerLeg", { 0.09, h, depth }, { w - 0.545, y, 0 }, "Fabric", colour, { 0, 0, out }),
+	}
+end
+
+-- A thin ruffle lip at a tier's hem: a band round the leg whose top face
+-- reads as a ring of colour from the high camera.
+local function lip(y: number, w: number, d: number, colour: { number }): ArmourPart
+	return Kit.box("LowerLeg", { w, 0.06, d }, { w / 2 - 0.5, y, 0 }, "Fabric", colour)
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "MossveilHem",
+	slot = "Boots",
+	parts = Kit.join({
+		tier(0.31, 0.62, 1.66, 0.94, 6, 8, moss),
+		{ lip(-0.01, 1.72, 2.08, mossPale) },
+		tier(-0.24, 0.55, 2.06, 1.14, 8, 10, mossDark),
+		{ lip(-0.52, 2.12, 2.5, lichen) },
+		{
+			-- The bone petticoat showing under the lichen hem.
