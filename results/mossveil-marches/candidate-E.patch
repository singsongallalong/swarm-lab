+--!strict
+-- The moss court's gown, chest (zone armour, the Fetid Forest): a black
+-- fitted bodice laced in lichen over a moss stomacher, a pale ruffled collar,
+-- a great moss-pale bow with ribbons, close moss sleeves banded at the elbow,
+-- and a bright lichen waist band between a moss sash and the moss hip frill.
+-- Below, two flaring tiers of moss green on the thighs, each ended with a thin
+-- pale ruffle lip, deepening as well as widening so the skirt stands out in
+-- every view. Every tier is a front, a back and an outer panel whose inner
+-- edge sits on the body's centre line, so the legs' tiers meet as one skirt
+-- standing and part as they stride.
+local ArmourLookTypes = require("../../ArmourLookTypes")
+local Kit = require("./Kit")
+
+type ArmourPart = ArmourLookTypes.ArmourPart
+
+local moss = { 66, 82, 52 }
+local mossPale = { 88, 104, 62 }
+local lichen = { 124, 134, 78 }
+local black = { 32, 34, 31 }
+
+-- One tier of the skirt on a thigh: `w` is half the skirt's full width there,
+-- and `z` how far the front and back panels stand off the leg. Both grow with
+-- each tier, so the skirt bells in depth as well as width.
+local function tier(
+	y: number,
+	h: number,
+	w: number,
+	z: number,
+	lean: number,
+	out: number,
+	colour: { number }
+): { ArmourPart }
+	local cx = w / 2 - 0.5
+	local depth = 2 * z + 0.1
+	return {
+		Kit.box("UpperLeg", { w, h, 0.09 }, { cx, y, -z }, "Fabric", colour, { lean, 0, 0 }),
+		Kit.box("UpperLeg", { w, h, 0.09 }, { cx, y, z }, "Fabric", colour, { -lean, 0, 0 }),
+		Kit.box("UpperLeg", { 0.09, h, depth }, { w - 0.545, y, 0 }, "Fabric", colour, { 0, 0, out }),
+	}
+end
+
+-- A thin ruffle lip at a tier's hem: a band round the leg whose top face
+-- reads as a ring of colour from the high camera.
+local function lip(y: number, w: number, d: number, colour: { number }): ArmourPart
+	return Kit.box("UpperLeg", { w, 0.06, d }, { w / 2 - 0.5, y, 0 }, "Fabric", colour)
+end
+
+local look: ArmourLookTypes.ArmourLook = {
+	name = "MossveilDress",
+	slot = "Chest",
+	parts = Kit.join({
+		{
+			-- The bodice, fitted black over a moss stomacher, laced in lichen.
+			Kit.box("UpperTorso", { 2.06, 1.66, 1.06 }, { 0, 0, 0 }, "Fabric", black),
+			Kit.box("UpperTorso", { 0.6, 1.2, 0.07 }, { 0, -0.05, -0.54 }, "Fabric", moss),
+			Kit.box("UpperTorso", { 0.74, 0.06, 0.07 }, { 0, 0.42, -0.59 }, "Fabric", lichen),
+			Kit.box("UpperTorso", { 0.74, 0.06, 0.07 }, { 0, 0.2, -0.59 }, "Fabric", lichen),
+			Kit.box("UpperTorso", { 0.74, 0.06, 0.07 }, { 0, -0.02, -0.59 }, "Fabric", lichen),
+			-- The pale neckline band and the high collar showing round the head.
+			Kit.box("UpperTorso", { 1.8, 0.08, 1.08 }, { 0, 0.66, 0 }, "Fabric", mossPale),
+			Kit.box("UpperTorso", { 1.28, 0.18, 1.24 }, { 0, 0.77, 0 }, "Fabric", black),
+			Kit.box("UpperTorso", { 1.34, 0.12, 1.3 }, { 0, 0.88, 0 }, "Fabric", mossPale),
+			-- The great bow, and the bustle behind it.
+			Kit.box("UpperTorso", { 0.58, 0.34, 0.16 }, { 0.44, -0.32, -0.56 }, "Fabric", mossPale, { 0, 0, 14 }),
+			Kit.box("UpperTorso", { 0.58, 0.34, 0.16 }, { -0.44, -0.32, -0.56 }, "Fabric", mossPale, { 0, 0, -14 }),
+			Kit.box("UpperTorso", { 0.24, 0.24, 0.18 }, { 0, -0.32, -0.59 }, "Fabric", lichen),
+			Kit.box("UpperTorso", { 1.38, 0.36, 0.26 }, { 0, -0.6, 0.56 }, "Fabric", moss),
+			-- The waist: a bright lichen band between a moss sash and the hip frill.
+			Kit.box("LowerTorso", { 2.02, 0.42, 1.02 }, { 0, 0, 0 }, "Fabric", black),
+			Kit.box("LowerTorso", { 2.14, 0.2, 1.14 }, { 0, 0.04, 0 }, "Fabric", lichen),
+			Kit.box("LowerTorso", { 2.12, 0.07, 1.12 }, { 0, 0.165, 0 }, "Fabric", moss),
+			Kit.box("LowerTorso", { 2.4, 0.17, 1.42 }, { 0, -0.11, 0 }, "Fabric", moss),
+			-- Close moss sleeves to the arm, pale band and lichen cord at the elbow.
+			Kit.box("UpperArm", { 1.06, 1.24, 1.06 }, { 0, 0, 0 }, "Fabric", moss),
+			Kit.box("UpperArm", { 1.14, 0.18, 1.14 }, { 0, -0.5, 0 }, "Fabric", mossPale),
+			Kit.box("UpperArm", { 1.16, 0.05, 1.16 }, { 0, -0.6, 0 }, "Fabric", lichen),
+		},
+		tier(0.42, 0.62, 1.08, 0.58, 4, 5, moss),
+		{ lip(0.09, 1.16, 1.36, mossPale) },
+		tier(-0.25, 0.62, 1.34, 0.74, 6, 7, moss),
+		{ lip(-0.55, 1.42, 1.68, lichen) },
+		{
+			-- The bow's ribbons down the skirt's front, one either side of centre.
+			Kit.box("UpperLeg", { 0.18, 0.48, 0.06 }, { -0.32, 0.38, -0.68 }, "Fabric", mossPale, { 2, 0, 0 }),
+		},
+	}),
+}
+
+return look
