+			-- Black shoes with a moss ribbon across the instep.
+			Kit.box("Foot", { 1.06, 0.3, 1.3 }, { 0, 0, -0.12 }, "Leather", black),
+			Kit.box("Foot", { 1.1, 0.05, 1.12 }, { 0, 0.11, 0.02 }, "Fabric", moss),
+		},
+	}),
+}
+
+return look
